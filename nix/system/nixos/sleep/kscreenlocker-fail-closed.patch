     m_daemon->lock(calledFromDBus() ? EstablishLock::Immediate : EstablishLock::Delayed);
+}
+
+bool Interface::requireRootCaller()
+{
+    if (!calledFromDBus()) {
+        return false;
+    }
+    auto *bus = connection().interface();
+    if (!bus || !message().service().startsWith(QLatin1Char(':'))) {
+        sendErrorReply(QDBusError::AccessDenied, QStringLiteral("A root D-Bus sender is required"));
+        return false;
+    }
+    const QDBusReply<uint> uid = bus->serviceUid(message().service());
+    if (!uid.isValid() || uid.value() != 0) {
+        sendErrorReply(QDBusError::AccessDenied, QStringLiteral("A root D-Bus sender is required"));
+        return false;
+    }
+    return true;
+}
+
+QString Interface::LockFromRoot()
+{
+    if (!requireRootCaller()) {
+        return {};
+    }
+    if (!KAuthorized::authorizeAction(QStringLiteral("lock_screen"))) {
+        sendErrorReply(QDBusError::AccessDenied, QStringLiteral("Screen locking is not authorized"));
+        return {};
+    }
+    return m_daemon->lockFromRoot();
+}
+
+bool Interface::IsRootLockCurrent(const QString &token)
+{
+    return requireRootCaller() && m_daemon->isRootLockCurrent(token);
+}
+
+void Interface::UnlockFromRoot(const QString &token)
+{
+    if (!requireRootCaller()) {
+        return;
+    }
+    if (!m_daemon->unlockFromRoot(token)) {
+        sendErrorReply(QDBusError::AccessDenied, QStringLiteral("The root lock generation is no longer current"));
+    }
 }
 
