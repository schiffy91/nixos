+# XKB includes may refer to nested symbols, custom models and locale aliases.
+# Copy the complete data trees rather than maintaining a language-specific list.
+for directory in "$X11_DIRECTORY/xkb" "$X11_DIRECTORY/locale"; do
+    if [[ -d "$PLYMOUTH_SYSROOT$directory" ]]; then
+        inst_recur "$directory"
     fi
+done
+
+# Libinput needs its device quirks even when running before the real root mounts.
+if [[ -n "$PLYMOUTH_LIBINPUT_DATA_DIR" && -d "$PLYMOUTH_SYSROOT$PLYMOUTH_LIBINPUT_DATA_DIR" ]]; then
+    inst_recur "$PLYMOUTH_LIBINPUT_DATA_DIR"
 fi
+if [[ -d "$PLYMOUTH_SYSROOT/etc/libinput" ]]; then
+    inst_recur /etc/libinput
+fi
+for configuration in /etc/vconsole.conf /etc/locale.conf; do
+    if [[ -f "$PLYMOUTH_SYSROOT$configuration" ]]; then
+        inst "$configuration" "$INITRDDIR"
+    fi
+done
 
 if [ -z "$PLYMOUTH_THEME_NAME" ]; then
     echo "No default plymouth plugin is set" >&2
diff --git a/tests/test-populate-initrd.sh b/tests/test-populate-initrd.sh
index 900193da..c32221c9 100644
--- a/tests/test-populate-initrd.sh
+++ b/tests/test-populate-initrd.sh
@@ -88,14 +88,15 @@ run_populate_initrd()
         PLYMOUTH_DAEMON_PATH=/usr/sbin/plymouthd \
         PLYMOUTH_CLIENT_PATH=/usr/bin/plymouth \
         PLYMOUTH_DRM_ESCROW_PATH=/usr/libexec/plymouth/plymouthd-fd-escrow \
+        PLYMOUTH_LIBINPUT_DATA_DIR=/usr/share/libinput \
         SYSTEMD_UNIT_DIR=/not-present \
                 "$populate_initrd" \
                 --targetdir "$1" \
-                --x11-directory /not-present
+                --x11-directory /usr/share/X11
 }
 
 echo 'TAP version 13'
-echo '1..2'
+echo '1..3'
 
 run_populate_initrd "$initrd_directory"
 
@@ -132,3 +133,28 @@ else
         echo 'not ok 2 - rewrite overridden theme configuration'
         exit 1
 fi
+
+# The source exists only in the sysroot; host data must not decide whether it
+# gets installed. Include nested XKB files and compose locale aliases.
+input_paths=(
+        /usr/share/X11/xkb/symbols/vendor/custom
+        /usr/share/X11/locale/compose.dir
+        /usr/share/X11/locale/locale.alias
+        /usr/share/X11/locale/en_US.UTF-8/Compose
+        /usr/share/libinput/50-system-test.quirks
+        /etc/libinput/local-overrides.quirks
+        /etc/vconsole.conf
+        /etc/locale.conf
+)
+for input_path in "${input_paths[@]}"; do
+        mkdir -p "$sysroot${input_path%/*}"
+        printf '%s\n' "$input_path" > "$sysroot$input_path"
+done
+run_populate_initrd "$test_directory/initrd-input"
+for input_path in "${input_paths[@]}"; do
+        if ! cmp "$sysroot$input_path" "$test_directory/initrd-input$input_path"; then
+                echo "not ok 3 - input runtime data: missing or changed $input_path"
+                exit 1
+        fi
+done
+echo 'ok 3 - input runtime data from sysroot'
