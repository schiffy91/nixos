From 9fe873d1d5f79762bd33aedbadf84bf671d63b4b Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <Alexander.Schiffhauer@gmail.com>
Date: Fri, 6 Nov 2026 17:40:15 -0800
Subject: [PATCH 11/12] initrd: Include complete XKB, compose and touchscreen
 runtime data

Honor the sysroot when finding input data. Preserve nested keyboard symbols, compose aliases and libinput quirks, along with locale and keyboard configuration. Extend the populate-initrd fixture to verify files are taken from the target sysroot.
---
 scripts/meson.build                 |  1 +
 scripts/plymouth-populate-initrd.in | 65 +++++++++--------------------
 tests/test-populate-initrd.sh       | 30 ++++++++++++-
 3 files changed, 48 insertions(+), 48 deletions(-)

diff --git a/scripts/meson.build b/scripts/meson.build
index 0fd635b3..976cee23 100644
--- a/scripts/meson.build
+++ b/scripts/meson.build
@@ -20,6 +20,7 @@ configure_file(
     'PLYMOUTH_POLICY_DIR': plymouth_policy_dir,
     'PLYMOUTH_CLIENT_DIR': get_option('prefix') / get_option('bindir'),
     'PLYMOUTH_DAEMON_DIR': get_option('prefix') / get_option('sbindir'),
+    'PLYMOUTH_LIBINPUT_DATA_DIR': touchscreen_enabled ? libinput_dep.get_variable(pkgconfig: 'prefix') / 'share/libinput' : '',
     'SYSTEMD_UNIT_DIR': get_option('systemd-integration')? systemd_unit_dir : '',
     'RELEASE_FILE': get_option('release-file'),
   },
diff --git a/scripts/plymouth-populate-initrd.in b/scripts/plymouth-populate-initrd.in
index ee094b1b..85784f18 100755
--- a/scripts/plymouth-populate-initrd.in
+++ b/scripts/plymouth-populate-initrd.in
@@ -25,6 +25,7 @@
 [ -z "$PLYMOUTH_CLIENT_PATH" ] && PLYMOUTH_CLIENT_PATH="@PLYMOUTH_CLIENT_DIR@/plymouth"
 [ -z "$PLYMOUTH_DRM_ESCROW_PATH" ] && PLYMOUTH_DRM_ESCROW_PATH="@PLYMOUTH_LIBEXECDIR@/plymouth/plymouthd-fd-escrow"
 [ -z "$SYSTEMD_UNIT_DIR" ] && SYSTEMD_UNIT_DIR="@SYSTEMD_UNIT_DIR@"
+[ -z "$PLYMOUTH_LIBINPUT_DATA_DIR" ] && PLYMOUTH_LIBINPUT_DATA_DIR="@PLYMOUTH_LIBINPUT_DATA_DIR@"
 
 # Generic substring function.  If $2 is in $1, return 0.
 strstr() { [ "${1#*$2*}" != "$1" ]; }
@@ -492,54 +493,26 @@ inst @RELEASE_FILE@ $INITRDDIR
 inst ${PLYMOUTH_POLICYDIR}/plymouthd.defaults $INITRDDIR
 inst ${PLYMOUTH_CONFDIR}/plymouthd.conf $INITRDDIR
 
