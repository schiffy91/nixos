+/* ply-keyboard-layout.h - XKB input for on-screen keyboards
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef PLY_KEYBOARD_LAYOUT_H
+#define PLY_KEYBOARD_LAYOUT_H
+
+#include <stdbool.h>
+#include <xkbcommon/xkbcommon.h>
+
+#include "ply-buffer.h"
+
+typedef struct _ply_keyboard_layout ply_keyboard_layout_t;
+
+#ifndef PLY_HIDE_FUNCTION_DECLARATIONS
+ply_keyboard_layout_t *ply_keyboard_layout_new (struct xkb_keymap *keymap,
+                                                const char        *locale);
+void ply_keyboard_layout_free (ply_keyboard_layout_t *layout);
+/* Keycodes and groups refer to the supplied keymap, never a private US map. */
+void ply_keyboard_layout_key (ply_keyboard_layout_t *layout,
+                              xkb_keycode_t          keycode,
+                              enum xkb_key_direction direction,
+                              ply_buffer_t          *output);
+char *ply_keyboard_layout_get_label (ply_keyboard_layout_t *layout,
+                                     xkb_keycode_t          keycode);
+struct xkb_state *ply_keyboard_layout_get_state (ply_keyboard_layout_t *layout);
+void ply_keyboard_layout_reset_compose (ply_keyboard_layout_t *layout);
+bool ply_keyboard_layout_set_group (ply_keyboard_layout_t *layout,
+                                    xkb_layout_index_t     group);
+#endif
+
+#endif /* PLY_KEYBOARD_LAYOUT_H */
diff --git a/src/libply-splash-core/ply-keyboard.c b/src/libply-splash-core/ply-keyboard.c
index d3fb83bb..877fb79e 100644
--- a/src/libply-splash-core/ply-keyboard.c
+++ b/src/libply-splash-core/ply-keyboard.c
@@ -93,6 +93,7 @@ struct _ply_keyboard
         ply_keyboard_provider_t      provider;
 
         ply_buffer_t                *line_buffer;
+        struct xkb_keymap           *keymap;
 
         ply_list_t                  *keyboard_input_handler_list;
         ply_list_t                  *backspace_handler_list;
@@ -254,6 +255,50 @@ process_keyboard_input (ply_keyboard_t *keyboard,
         }
 }
 
+bool
+ply_keyboard_input (ply_keyboard_t *keyboard,
+                    const char     *text,
+                    size_t          size)
+{
+        mbstate_t state = { 0 };
+        size_t offset, length;
+        wchar_t character;
+
+        if (!keyboard->is_active || text == NULL)
+                return false;
+
+        /* Validate the whole input before changing the password buffer. */
+        for (offset = 0; offset < size; offset += length) {
+                length = mbrtowc (&character, text + offset, size - offset, &state);
+                if (length == (size_t) -1 || length == (size_t) -2 || length == 0)
+                        return false;
+        }
+
+        memset (&state, 0, sizeof(state));
+        for (offset = 0; offset < size; offset += length) {
+                length = mbrtowc (&character, text + offset, size - offset, &state);
+                process_keyboard_input (keyboard, text + offset, length);
+        }
+
+        return true;
+}
+
+void
+ply_keyboard_set_keymap (ply_keyboard_t    *keyboard,
+                         struct xkb_keymap *keymap)
+{
+        struct xkb_keymap *old_keymap = keyboard->keymap;
+
+        keyboard->keymap = keymap != NULL ? xkb_keymap_ref (keymap) : NULL;
+        xkb_keymap_unref (old_keymap);
+}
+
+struct xkb_keymap *
+ply_keyboard_get_keymap (ply_keyboard_t *keyboard)
+{
+        return keyboard->keymap;
+}
+
 static void
 on_key_event (ply_keyboard_t *keyboard,
               ply_buffer_t   *buffer)
@@ -508,6 +553,7 @@ ply_keyboard_free (ply_keyboard_t *keyboard)
         ply_keyboard_stop_watching_for_input (keyboard);
 
         ply_buffer_free (keyboard->line_buffer);
+        xkb_keymap_unref (keyboard->keymap);
 
         if (keyboard->provider_type == PLY_KEYBOARD_PROVIDER_TYPE_RENDERER) {
                 free (keyboard->provider.if_renderer);
