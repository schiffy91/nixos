+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "ply-test.h"
+
+#include <fcntl.h>
+#include <locale.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "ply-keyboard.h"
+#include "ply-terminal.h"
+
+typedef struct
+{
+        char    *line;
+        unsigned inputs;
+        unsigned backspaces;
+        unsigned submissions;
+} input_state_t;
+
+static void
+on_input (void       *data,
+          const char *text,
+          size_t      length)
+{
+        input_state_t *state = data;
+
+        state->inputs++;
+}
+
+static void
+on_backspace (void *data)
+{
+        input_state_t *state = data;
+
+        state->backspaces++;
+}
+
+static void
+on_enter (void       *data,
+          const char *line)
+{
+        input_state_t *state = data;
+
+        free (state->line);
+        state->line = strdup (line);
+        state->submissions++;
+}
+
+static bool
+test_software_input_uses_existing_password_handlers (void)
+{
+        ply_terminal_t *terminal;
+        ply_keyboard_t *keyboard;
+        input_state_t state = { 0 };
+        int fd;
+
+        PLY_TEST_ASSERT (setlocale (LC_CTYPE, "C.UTF-8") != NULL);
+        fd = posix_openpt (O_RDWR | O_NOCTTY | O_CLOEXEC);
+        PLY_TEST_ASSERT (fd >= 0);
+        PLY_TEST_ASSERT (grantpt (fd) == 0 && unlockpt (fd) == 0);
+        terminal = ply_terminal_new (ptsname (fd), NULL);
+        PLY_TEST_ASSERT (ply_terminal_open (terminal));
+        keyboard = ply_keyboard_new_for_terminal (terminal);
+        ply_keyboard_add_input_handler (keyboard, on_input, &state);
+        ply_keyboard_add_backspace_handler (keyboard, on_backspace, &state);
+        ply_keyboard_add_enter_handler (keyboard, on_enter, &state);
+
+        PLY_TEST_ASSERT (!ply_keyboard_input (keyboard, "inactive", 8));
+        PLY_TEST_ASSERT (ply_keyboard_watch_for_input (keyboard));
+        PLY_TEST_ASSERT (ply_keyboard_input (keyboard, "éä", strlen ("éä")));
+        PLY_TEST_ASSERT (state.inputs == 2);
+        /* Reject the entire batch: even the valid prefix must not be typed. */
+        PLY_TEST_ASSERT (!ply_keyboard_input (keyboard, "x\xc3", 2));
+        PLY_TEST_ASSERT (!ply_keyboard_input (keyboard, "x\0y", 3));
+        PLY_TEST_ASSERT (!ply_keyboard_input (keyboard, "\xc0\xaf", 2));
+        PLY_TEST_ASSERT (state.inputs == 2);
+        PLY_TEST_ASSERT (ply_keyboard_input (keyboard, "\177\n", 2));
+        PLY_TEST_ASSERT (state.backspaces == 1);
+        PLY_TEST_ASSERT (state.submissions == 1);
+        PLY_TEST_ASSERT (strcmp (state.line, "é") == 0);
+
+        /* Submission clears the existing line buffer before the retry. */
+        PLY_TEST_ASSERT (ply_keyboard_input (keyboard, "z\n", 2));
+        PLY_TEST_ASSERT (state.submissions == 2);
+        PLY_TEST_ASSERT (strcmp (state.line, "z") == 0);
+        ply_keyboard_stop_watching_for_input (keyboard);
+        PLY_TEST_ASSERT (!ply_keyboard_input (keyboard, "late\n", 5));
+        PLY_TEST_ASSERT (state.submissions == 2);
+
+        ply_keyboard_remove_input_handler (keyboard, on_input);
+        ply_keyboard_remove_backspace_handler (keyboard, on_backspace);
+        ply_keyboard_remove_enter_handler (keyboard, on_enter);
+        ply_keyboard_free (keyboard);
+        ply_terminal_free (terminal);
+        close (fd);
+        free (state.line);
+        return true;
+}
+
+static bool
+test_keyboard_retains_configured_keymap (void)
+{
+        struct xkb_context *context;
+        struct xkb_keymap *keymap;
+        struct xkb_rule_names names = { .layout = "de,fr", .options = "" };
+        ply_keyboard_t *keyboard;
+
+        context = xkb_context_new (XKB_CONTEXT_NO_FLAGS);
+        PLY_TEST_ASSERT (context != NULL);
+        keymap = xkb_keymap_new_from_names (context, &names, XKB_KEYMAP_COMPILE_NO_FLAGS);
+        PLY_TEST_ASSERT (keymap != NULL);
+        keyboard = ply_keyboard_new_for_terminal (NULL);
+        PLY_TEST_ASSERT (ply_keyboard_get_keymap (keyboard) == NULL);
+        ply_keyboard_set_keymap (keyboard, keymap);
+        PLY_TEST_ASSERT (ply_keyboard_get_keymap (keyboard) == keymap);
+        ply_keyboard_set_keymap (keyboard, keymap);
+        xkb_keymap_unref (keymap);
+        PLY_TEST_ASSERT (xkb_keymap_num_layouts (ply_keyboard_get_keymap (keyboard)) == 2);
+        ply_keyboard_set_keymap (keyboard, NULL);
+        PLY_TEST_ASSERT (ply_keyboard_get_keymap (keyboard) == NULL);
+        ply_keyboard_free (keyboard);
+        xkb_context_unref (context);
+        return true;
+}
+
+static const ply_test_case_t test_cases[] = {
+        PLY_TEST_CASE (test_software_input_uses_existing_password_handlers),
+        PLY_TEST_CASE (test_keyboard_retains_configured_keymap)
+};
+
+PLY_TEST_MAIN (test_cases)
