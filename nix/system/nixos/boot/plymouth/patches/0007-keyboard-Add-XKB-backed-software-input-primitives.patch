diff --git a/src/libply-splash-core/ply-keyboard-layout.c b/src/libply-splash-core/ply-keyboard-layout.c
new file mode 100644
index 00000000..902a8057
--- /dev/null
+++ b/src/libply-splash-core/ply-keyboard-layout.c
@@ -0,0 +1,193 @@
+/* ply-keyboard-layout.c - XKB input for on-screen keyboards
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "ply-keyboard-layout.h"
+
+#include <stdlib.h>
+#include <string.h>
+#include <xkbcommon/xkbcommon-compose.h>
+#include <xkbcommon/xkbcommon-keysyms.h>
+
+struct _ply_keyboard_layout
+{
+        struct xkb_state         *state;
+        struct xkb_compose_state *compose;
+};
+
+ply_keyboard_layout_t *
+ply_keyboard_layout_new (struct xkb_keymap *keymap,
+                         const char        *locale)
+{
+        ply_keyboard_layout_t *layout;
+        struct xkb_context *context;
+        struct xkb_compose_table *table;
+
+        if (keymap == NULL || locale == NULL)
+                return NULL;
+
+        layout = calloc (1, sizeof(*layout));
+        if (layout == NULL)
+                return NULL;
+
+        layout->state = xkb_state_new (keymap);
+        if (layout->state == NULL) {
+                free (layout);
+                return NULL;
+        }
+
+        context = xkb_context_new (XKB_CONTEXT_NO_FLAGS);
+        if (context != NULL) {
+                table = xkb_compose_table_new_from_locale (context, locale, XKB_COMPOSE_COMPILE_NO_FLAGS);
+                if (table != NULL) {
+                        layout->compose = xkb_compose_state_new (table, XKB_COMPOSE_STATE_NO_FLAGS);
+                        xkb_compose_table_unref (table);
+                }
+                xkb_context_unref (context);
+        }
+
+        return layout;
+}
+
+void
+ply_keyboard_layout_free (ply_keyboard_layout_t *layout)
+{
+        if (layout == NULL)
+                return;
+
+        xkb_compose_state_unref (layout->compose);
+        xkb_state_unref (layout->state);
+        free (layout);
+}
+
+static void
+append_composed_text (ply_keyboard_layout_t *layout,
+                      ply_buffer_t          *output)
+{
+        int length;
+        char *text;
+
+        length = xkb_compose_state_get_utf8 (layout->compose, NULL, 0);
+        if (length <= 0)
+                return;
+
+        text = malloc (length + 1);
+        if (text == NULL)
+                return;
+
+        xkb_compose_state_get_utf8 (layout->compose, text, length + 1);
+        ply_buffer_append_bytes (output, text, length);
+        explicit_bzero (text, length);
+        free (text);
+}
+
+void
+ply_keyboard_layout_key (ply_keyboard_layout_t *layout,
+                         xkb_keycode_t          keycode,
+                         enum xkb_key_direction direction,
+                         ply_buffer_t          *output)
+{
+        xkb_keysym_t symbol;
+        int length;
+        char *text;
+
+        symbol = xkb_state_key_get_one_sym (layout->state, keycode);
+        xkb_state_update_key (layout->state, keycode, direction);
+        if (direction == XKB_KEY_UP)
+                return;
+
+        if (layout->compose != NULL && symbol != XKB_KEY_NoSymbol &&
+            xkb_compose_state_feed (layout->compose, symbol) == XKB_COMPOSE_FEED_ACCEPTED) {
+                switch (xkb_compose_state_get_status (layout->compose)) {
+                case XKB_COMPOSE_COMPOSING:
+                        return;
+                case XKB_COMPOSE_COMPOSED:
+                        append_composed_text (layout, output);
+                        xkb_compose_state_reset (layout->compose);
+                        return;
+                case XKB_COMPOSE_CANCELLED:
+                        xkb_compose_state_reset (layout->compose);
+                        return;
+                case XKB_COMPOSE_NOTHING:
+                        break;
+                }
+        }
+
+        switch (symbol) {
+        case XKB_KEY_BackSpace:
+                ply_buffer_append_bytes (output, "\177", 1);
+                return;
+        case XKB_KEY_Return:
+        case XKB_KEY_KP_Enter:
+                ply_buffer_append_bytes (output, "\n", 1);
+                return;
+        default:
+                break;
+        }
+
+        length = xkb_state_key_get_utf8 (layout->state, keycode, NULL, 0);
+        if (length <= 0)
+                return;
+
+        text = malloc (length + 1);
+        if (text == NULL)
+                return;
+
+        xkb_state_key_get_utf8 (layout->state, keycode, text, length + 1);
+        ply_buffer_append_bytes (output, text, length);
+        explicit_bzero (text, length);
+        free (text);
+}
+
+char *
+ply_keyboard_layout_get_label (ply_keyboard_layout_t *layout,
+                               xkb_keycode_t          keycode)
+{
+        xkb_keysym_t symbol;
+        char text[128];
+        int length;
+
+        symbol = xkb_state_key_get_one_sym (layout->state, keycode);
+        length = xkb_keysym_to_utf8 (symbol, text, sizeof(text));
+        if (length > 1 && (unsigned char) text[0] >= 0x20 && text[0] != 0x7f)
+                return strdup (text);
+
+        /* Dead keys have no standalone UTF-8 value. Use their XKB name until
+         * the widget supplies a presentation label, never emit this name. */
+        if (xkb_keysym_get_name (symbol, text, sizeof(text)) > 0)
+                return strdup (text);
+
+        return strdup ("");
+}
+
+struct xkb_state *
+ply_keyboard_layout_get_state (ply_keyboard_layout_t *layout)
+{
+        return layout->state;
+}
+
+void
+ply_keyboard_layout_reset_compose (ply_keyboard_layout_t *layout)
+{
+        if (layout->compose != NULL)
+                xkb_compose_state_reset (layout->compose);
+}
+
+bool
+ply_keyboard_layout_set_group (ply_keyboard_layout_t *layout,
+                               xkb_layout_index_t     group)
+{
+        struct xkb_keymap *keymap;
+        xkb_mod_mask_t depressed, latched, locked;
+
+        keymap = xkb_state_get_keymap (layout->state);
+        if (group >= xkb_keymap_num_layouts (keymap))
+                return false;
+
+        depressed = xkb_state_serialize_mods (layout->state, XKB_STATE_MODS_DEPRESSED);
+        latched = xkb_state_serialize_mods (layout->state, XKB_STATE_MODS_LATCHED);
+        locked = xkb_state_serialize_mods (layout->state, XKB_STATE_MODS_LOCKED);
+        xkb_state_update_mask (layout->state, depressed, latched, locked, 0, 0, group);
+        ply_keyboard_layout_reset_compose (layout);
+        return true;
+}
