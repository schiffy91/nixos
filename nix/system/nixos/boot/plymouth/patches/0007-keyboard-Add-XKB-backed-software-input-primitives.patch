diff --git a/tests/test-keyboard-layout.c b/tests/test-keyboard-layout.c
new file mode 100644
index 00000000..bccd0d7d
--- /dev/null
+++ b/tests/test-keyboard-layout.c
@@ -0,0 +1,217 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "ply-test.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "ply-keyboard-layout.h"
+
+typedef struct
+{
+        struct xkb_context    *context;
+        struct xkb_keymap     *keymap;
+        ply_keyboard_layout_t *layout;
+        ply_buffer_t          *output;
+} fixture_t;
+
+static bool
+fixture_init (fixture_t  *fixture,
+              const char *layouts,
+              const char *variants)
+{
+        struct xkb_rule_names names = {
+                .rules   = "evdev",
+                .model   = "pc105",
+                .layout  = layouts,
+                .variant = variants,
+                .options = ""
+        };
+
+        memset (fixture, 0, sizeof(*fixture));
+        fixture->context = xkb_context_new (XKB_CONTEXT_NO_FLAGS);
+        PLY_TEST_ASSERT (fixture->context != NULL);
+        fixture->keymap = xkb_keymap_new_from_names (fixture->context, &names, XKB_KEYMAP_COMPILE_NO_FLAGS);
+        PLY_TEST_ASSERT (fixture->keymap != NULL);
+        fixture->layout = ply_keyboard_layout_new (fixture->keymap, "en_US.UTF-8");
+        PLY_TEST_ASSERT (fixture->layout != NULL);
+        fixture->output = ply_buffer_new ();
+        return true;
+}
+
+static void
+fixture_clear (fixture_t *fixture)
+{
+        ply_buffer_free (fixture->output);
+        ply_keyboard_layout_free (fixture->layout);
+        xkb_keymap_unref (fixture->keymap);
+        xkb_context_unref (fixture->context);
+}
+
+static void
+key (fixture_t             *fixture,
+     const char            *name,
+     enum xkb_key_direction direction)
+{
+        xkb_keycode_t keycode = xkb_keymap_key_by_name (fixture->keymap, name);
+
+        ply_keyboard_layout_key (fixture->layout, keycode, direction, fixture->output);
+}
+
+static void
+tap (fixture_t  *fixture,
+     const char *name)
+{
+        key (fixture, name, XKB_KEY_DOWN);
+        key (fixture, name, XKB_KEY_UP);
+}
+
+static bool
+output_is (fixture_t  *fixture,
+           const char *expected)
+{
+        PLY_TEST_ASSERT (ply_buffer_get_size (fixture->output) == strlen (expected));
+        PLY_TEST_ASSERT (memcmp (ply_buffer_get_bytes (fixture->output), expected, strlen (expected)) == 0);
+        ply_buffer_clear (fixture->output);
+        return true;
+}
+
+static bool
+label_is (fixture_t  *fixture,
+          const char *name,
+          const char *expected)
+{
+        char *label = ply_keyboard_layout_get_label (fixture->layout,
+                                                     xkb_keymap_key_by_name (fixture->keymap, name));
+        bool matches = label != NULL && strcmp (label, expected) == 0;
+
+        free (label);
+        PLY_TEST_ASSERT (matches);
+        return true;
+}
+
+static bool
+test_us_modifiers_and_control_keys (void)
+{
+        fixture_t fixture;
+
+        PLY_TEST_ASSERT (fixture_init (&fixture, "us", ""));
+        PLY_TEST_ASSERT (label_is (&fixture, "AC01", "a"));
+        tap (&fixture, "AC01");
+        key (&fixture, "LFSH", XKB_KEY_DOWN);
+        PLY_TEST_ASSERT (label_is (&fixture, "AC01", "A"));
+        tap (&fixture, "AC01");
+        tap (&fixture, "AE01");
+        key (&fixture, "LFSH", XKB_KEY_UP);
+        tap (&fixture, "CAPS");
+        tap (&fixture, "AC01");
+        tap (&fixture, "AE01");
+        key (&fixture, "LFSH", XKB_KEY_DOWN);
+        tap (&fixture, "AC01");
+        key (&fixture, "LFSH", XKB_KEY_UP);
+        tap (&fixture, "SPCE");
+        tap (&fixture, "BKSP");
+        tap (&fixture, "RTRN");
+        PLY_TEST_ASSERT (output_is (&fixture, "aA!A1a \177\n"));
+        fixture_clear (&fixture);
+        return true;
+}
+
+static bool
+test_german_characters_and_altgr (void)
+{
+        fixture_t fixture;
+
+        PLY_TEST_ASSERT (fixture_init (&fixture, "de", ""));
+        PLY_TEST_ASSERT (label_is (&fixture, "AD06", "z"));
+        PLY_TEST_ASSERT (label_is (&fixture, "AC11", "ä"));
+        tap (&fixture, "AD06");
+        tap (&fixture, "AB01");
+        tap (&fixture, "AC11");
+        key (&fixture, "LFSH", XKB_KEY_DOWN);
+        tap (&fixture, "AC11");
+        key (&fixture, "LFSH", XKB_KEY_UP);
+        key (&fixture, "RALT", XKB_KEY_DOWN);
+        PLY_TEST_ASSERT (label_is (&fixture, "AD01", "@"));
+        tap (&fixture, "AD01");
+        key (&fixture, "RALT", XKB_KEY_UP);
+        PLY_TEST_ASSERT (output_is (&fixture, "zyäÄ@"));
+        fixture_clear (&fixture);
+        return true;
+}
+
+static bool
+test_french_characters_and_compose (void)
+{
+        fixture_t fixture;
+
+        PLY_TEST_ASSERT (fixture_init (&fixture, "fr", ""));
+        PLY_TEST_ASSERT (label_is (&fixture, "AD01", "a"));
+        PLY_TEST_ASSERT (label_is (&fixture, "AE02", "é"));
+        tap (&fixture, "AD01");
+        tap (&fixture, "AE02");
+        key (&fixture, "RALT", XKB_KEY_DOWN);
+        tap (&fixture, "AD03");
+        key (&fixture, "RALT", XKB_KEY_UP);
+        PLY_TEST_ASSERT (output_is (&fixture, "aé€"));
+        tap (&fixture, "AD11");
+        PLY_TEST_ASSERT (output_is (&fixture, ""));
+        tap (&fixture, "AD03");
+        tap (&fixture, "AD03");
+        PLY_TEST_ASSERT (output_is (&fixture, "êe"));
+        fixture_clear (&fixture);
+        return true;
+}
+
+static bool
+test_groups_and_retry_clear_pending_compose (void)
+{
+        fixture_t fixture;
+
+        PLY_TEST_ASSERT (fixture_init (&fixture, "us,de,fr", ""));
+        tap (&fixture, "AD01");
+        PLY_TEST_ASSERT (ply_keyboard_layout_set_group (fixture.layout, 1));
+        tap (&fixture, "AD06");
+        tap (&fixture, "AE12");
+        tap (&fixture, "AD03");
+        PLY_TEST_ASSERT (output_is (&fixture, "qzé"));
+        tap (&fixture, "AE12");
+        ply_keyboard_layout_reset_compose (fixture.layout);
+        tap (&fixture, "AD03");
+        PLY_TEST_ASSERT (output_is (&fixture, "e"));
+        tap (&fixture, "AE12");
+        PLY_TEST_ASSERT (ply_keyboard_layout_set_group (fixture.layout, 2));
+        tap (&fixture, "AD01");
+        PLY_TEST_ASSERT (output_is (&fixture, "a"));
+        PLY_TEST_ASSERT (!ply_keyboard_layout_set_group (fixture.layout, 3));
+        PLY_TEST_ASSERT (label_is (&fixture, "AD01", "a"));
+        fixture_clear (&fixture);
+        return true;
+}
+
+static bool
+test_variant_and_cancelled_compose (void)
+{
+        fixture_t fixture;
+
+        PLY_TEST_ASSERT (fixture_init (&fixture, "us", "intl"));
+        tap (&fixture, "AC11");
+        tap (&fixture, "AD03");
+        PLY_TEST_ASSERT (output_is (&fixture, "é"));
+        tap (&fixture, "AC11");
+        tap (&fixture, "BKSP");
+        tap (&fixture, "AD03");
+        PLY_TEST_ASSERT (output_is (&fixture, "e"));
+        fixture_clear (&fixture);
+        return true;
+}
+
+static const ply_test_case_t test_cases[] = {
+        PLY_TEST_CASE (test_us_modifiers_and_control_keys),
+        PLY_TEST_CASE (test_german_characters_and_altgr),
+        PLY_TEST_CASE (test_french_characters_and_compose),
+        PLY_TEST_CASE (test_groups_and_retry_clear_pending_compose),
+        PLY_TEST_CASE (test_variant_and_cancelled_compose)
+};
+
+PLY_TEST_MAIN (test_cases)
