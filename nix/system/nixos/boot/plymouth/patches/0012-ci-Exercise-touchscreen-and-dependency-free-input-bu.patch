From 350c29698a987bc0b3fe26e4c08134af1b421910 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <Alexander.Schiffhauer@gmail.com>
Date: Fri, 6 Nov 2026 17:36:24 -0800
Subject: [PATCH 12/12] ci: Exercise touchscreen and dependency-free input
 builds

---
 .gitlab-ci.yml | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
index f1f97c40..fb23edb2 100644
--- a/.gitlab-ci.yml
+++ b/.gitlab-ci.yml
@@ -19,12 +19,19 @@ fedora-x86_64:
   stage: build
   image: 'registry.fedoraproject.org/fedora:37'
   before_script:
-    - dnf install -y cpio gcc gtk3-devel git libpng-devel gettext-devel libxslt docbook-style-xsl cairo-devel systemd-devel systemd-udev kernel-headers libdrm-devel pango-devel make ShellCheck uncrustify patchutils meson binutils-gold xkeyboard-config-devel libevdev-devel
+    - dnf install -y cpio gcc gtk3-devel git libpng-devel gettext-devel libxslt docbook-style-xsl cairo-devel systemd-devel systemd-udev kernel-headers libdrm-devel pango-devel make ShellCheck uncrustify patchutils meson binutils-gold xkeyboard-config-devel libxkbcommon-devel libevdev-devel libinput-devel
     - alternatives --set ld /usr/bin/ld.gold
   <<: [ *check-format, *meson-build ]
   only:
     - merge_requests
 
+fedora-without-touchscreen-x86_64:
+  extends: fedora-x86_64
+  script:
+    - meson setup _build-no-touchscreen -Dtouchscreen=disabled -Dudev=disabled
+    - meson compile -C _build-no-touchscreen
+    - meson test -C _build-no-touchscreen --print-errorlogs
+
 fedora-sanitizers-x86_64:
   extends: fedora-x86_64
   script:
@@ -78,7 +85,7 @@ debian-unstable-x86_64:
   image: debian:unstable
   before_script:
     - apt-get update -qq
-    - apt-get install -y -qq -o APT::Immediate-Configure=false --no-install-recommends bc build-essential cpio docbook-xsl gcc gettext git libdrm-dev libgtk-3-dev libpango1.0-dev libpng-dev libudev-dev make pkg-config systemd-dev libsystemd-dev udev xsltproc shellcheck uncrustify patchutils meson xkb-data libevdev-dev
+    - apt-get install -y -qq -o APT::Immediate-Configure=false --no-install-recommends bc build-essential cpio docbook-xsl gcc gettext git libdrm-dev libgtk-3-dev libpango1.0-dev libpng-dev libudev-dev make pkg-config systemd-dev libsystemd-dev udev xsltproc shellcheck uncrustify patchutils meson xkb-data libevdev-dev libinput-dev
   <<: *meson-build
   only:
     - merge_requests
-- 
2.56.0

