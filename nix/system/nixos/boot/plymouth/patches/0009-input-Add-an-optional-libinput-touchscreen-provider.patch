 conf.set('PLY_ENABLE_SYSTEMD_INTEGRATION', get_option('systemd-integration'))
 conf.set('PLY_ENABLE_TRACING', get_option('tracing'))
 conf.set_quoted('PLYMOUTH_RUNTIME_DIR', plymouth_runtime_dir)
