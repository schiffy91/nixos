 static void
+set_keyboard (ply_boot_splash_plugin_t *plugin, ply_keyboard_t *keyboard)
+{
+        ply_osk_set_keyboard (plugin->osk, keyboard);
+}
+
+static void
+unset_keyboard (ply_boot_splash_plugin_t *plugin, ply_keyboard_t *keyboard)
+{
+        ply_osk_set_keyboard (plugin->osk, NULL);
+}
+
+static void
+osk_changed (void *data)
+{
+        ply_boot_splash_plugin_t *plugin = data;
+        if (!plugin->is_visible || plugin->state != PLY_BOOT_SPLASH_DISPLAY_PASSWORD_ENTRY)
+                return;
+        pause_views (plugin);
+        bool visible = ply_osk_visible (plugin->osk);
+        if (visible != plugin->osk_was_visible) {
+                hide_prompt (plugin);
+                show_prompt (plugin, plugin->osk_prompt, NULL, plugin->osk_bullets);
+                plugin->osk_was_visible = visible;
+        }
+        redraw_views (plugin);
+        process_needed_redraws (plugin);
+        unpause_views (plugin);
+}
