From 5cde2bc1760f2d82f9120f85d2da94089c000d46 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Fri, 22 May 2026 14:22:56 -0700
Subject: [PATCH] winewayland.drv: Handle fully zero-alpha layered surfaces

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/winewayland.drv/window_surface.c | 94 ++++++++++++++++++++++-----
 1 file changed, 79 insertions(+), 15 deletions(-)

diff --git a/dlls/winewayland.drv/window_surface.c b/dlls/winewayland.drv/window_surface.c
index fc5fef3..9287fb6 100644
--- a/dlls/winewayland.drv/window_surface.c
+++ b/dlls/winewayland.drv/window_surface.c
@@ -48,6 +48,13 @@ struct wayland_window_surface
     BOOL layered;
 };
 
+enum zero_alpha_fixup
+{
+    ZERO_ALPHA_FIXUP_NONE,
+    ZERO_ALPHA_FIXUP_NONBLACK,
+    ZERO_ALPHA_FIXUP_OPAQUE,
+};
+
 static struct wayland_window_surface *wayland_window_surface_cast(
     struct window_surface *window_surface)
 {
@@ -240,20 +247,74 @@ RGNDATA *get_region_data(HRGN region)
     return data;
 }
 
-static UINT32 apply_alpha_bits(UINT32 pixel, UINT alpha_bits, BOOL fixup_zero_alpha)
+static UINT32 apply_alpha_bits(UINT32 pixel, UINT alpha_bits, enum zero_alpha_fixup zero_alpha_fixup)
 {
     if (alpha_bits != (UINT)-1) return (pixel & 0x00ffffff) | alpha_bits;
-    if (fixup_zero_alpha && !(pixel & 0xff000000) && (pixel & 0x00ffffff))
-        return pixel | 0xff000000;
+    if (!(pixel & 0xff000000))
+    {
+        if (zero_alpha_fixup == ZERO_ALPHA_FIXUP_OPAQUE) return pixel | 0xff000000;
+        if (zero_alpha_fixup == ZERO_ALPHA_FIXUP_NONBLACK && (pixel & 0x00ffffff))
+            return pixel | 0xff000000;
+    }
     return pixel;
 }
 
+static enum zero_alpha_fixup get_zero_alpha_fixup(const char *src_pixels, RECT *src_rect,
+                                                  HRGN region)
+{
+    static const int bpp = WINEWAYLAND_BYTES_PER_PIXEL;
+    RGNDATA *rgndata = get_region_data(region);
+    enum zero_alpha_fixup ret = ZERO_ALPHA_FIXUP_NONE;
+    RECT *rgn_rect, *rgn_rect_end;
+    int src_stride;
+    BOOL has_alpha = FALSE, has_rgb = FALSE;
+
+    if (!rgndata) return ret;
+
+    src_stride = (src_rect->right - src_rect->left) * bpp;
+    rgn_rect = (RECT *)rgndata->Buffer;
+    rgn_rect_end = rgn_rect + rgndata->rdh.nCount;
+
+    for (; rgn_rect < rgn_rect_end; rgn_rect++)
+    {
+        const UINT32 *src;
+        int x, y, width, height;
+        RECT rc;
+
+        if (!intersect_rect(&rc, rgn_rect, src_rect)) continue;
+
+        src = (const UINT32 *)(src_pixels + (rc.top - src_rect->top) * src_stride +
+                               (rc.left - src_rect->left) * bpp);
+        width = rc.right - rc.left;
+        height = rc.bottom - rc.top;
+
+        for (y = 0; y < height; y++)
+        {
+            for (x = 0; x < width; x++)
+            {
+                UINT32 pixel = src[x];
+
+                if (pixel & 0xff000000) has_alpha = TRUE;
+                else if (pixel & 0x00ffffff) has_rgb = TRUE;
+                if (has_alpha && has_rgb) goto done;
+            }
+            src = (const UINT32 *)((const char *)src + src_stride);
+        }
+    }
+
+done:
+    if (has_rgb) ret = ZERO_ALPHA_FIXUP_NONBLACK;
+    free(rgndata);
+    return ret;
+}
+
 /**********************************************************************
  *          copy_pixel_region
  */
 static void copy_pixel_region(const char *src_pixels, RECT *src_rect,
                               char *dst_pixels, RECT *dst_rect,
-                              HRGN region, UINT alpha_bits, BOOL fixup_zero_alpha)
+                              HRGN region, UINT alpha_bits,
+                              enum zero_alpha_fixup zero_alpha_fixup)
 {
     static const int bpp = WINEWAYLAND_BYTES_PER_PIXEL;
     RGNDATA *rgndata = get_region_data(region);
@@ -289,21 +350,21 @@ static void copy_pixel_region(const char *src_pixels, RECT *src_rect,
         /* Fast path for full width rectangles. */
         if (width * bpp == src_stride && src_stride == dst_stride)
         {
-            if (alpha_bits != (UINT)-1 || fixup_zero_alpha)
+            if (alpha_bits != (UINT)-1 || zero_alpha_fixup != ZERO_ALPHA_FIXUP_NONE)
             {
                 for (x = 0; x < height * width; ++x)
-                    ((UINT32 *)dst)[x] = apply_alpha_bits(((UINT32 *)src)[x], alpha_bits, fixup_zero_alpha);
+                    ((UINT32 *)dst)[x] = apply_alpha_bits(((UINT32 *)src)[x], alpha_bits, zero_alpha_fixup);
             }
             else memcpy(dst, src, height * width * 4);
             continue;
         }
 
-        if (alpha_bits != (UINT)-1 || fixup_zero_alpha)
+        if (alpha_bits != (UINT)-1 || zero_alpha_fixup != ZERO_ALPHA_FIXUP_NONE)
         {
             for (y = 0; y < height; y++)
             {
                 for (x = 0; x < width; ++x)
-                    ((UINT32 *)dst)[x] = apply_alpha_bits(((UINT32 *)src)[x], alpha_bits, fixup_zero_alpha);
+                    ((UINT32 *)dst)[x] = apply_alpha_bits(((UINT32 *)src)[x], alpha_bits, zero_alpha_fixup);
                 src += src_stride;
                 dst += dst_stride;
             }
@@ -328,11 +389,11 @@ static void copy_pixel_region(const char *src_pixels, RECT *src_rect,
 static void wayland_shm_buffer_copy_data(struct wayland_shm_buffer *buffer,
                                          const char *bits, RECT *rect,
                                          HRGN region, UINT alpha_bits,
-                                         BOOL fixup_zero_alpha)
+                                         enum zero_alpha_fixup zero_alpha_fixup)
 {
     RECT buffer_rect = {0, 0, buffer->width, buffer->height};
     TRACE("buffer=%p bits=%p rect=%s\n", buffer, bits, wine_dbgstr_rect(rect));
-    copy_pixel_region(bits, rect, buffer->map_data, &buffer_rect, region, alpha_bits, fixup_zero_alpha);
+    copy_pixel_region(bits, rect, buffer->map_data, &buffer_rect, region, alpha_bits, zero_alpha_fixup);
 }
 
 static void wayland_shm_buffer_copy(struct wayland_shm_buffer *src,
@@ -344,7 +405,8 @@ static void wayland_shm_buffer_copy(struct wayland_shm_buffer *src,
     UINT alpha_bits = src->format == WL_SHM_FORMAT_XRGB8888 &&
                       dst->format == WL_SHM_FORMAT_ARGB8888 ? 0xff000000 : (UINT)-1;
     TRACE("src=%p dst=%p\n", src, dst);
-    copy_pixel_region(src->map_data, &src_rect, dst->map_data, &dst_rect, region, alpha_bits, FALSE);
+    copy_pixel_region(src->map_data, &src_rect, dst->map_data, &dst_rect, region,
+                      alpha_bits, ZERO_ALPHA_FIXUP_NONE);
 }
 
 /**********************************************************************
@@ -389,7 +451,7 @@ static BOOL wayland_window_surface_flush(struct window_surface *window_surface,
     HRGN surface_damage_region = NULL;
     HRGN copy_from_window_region;
     UINT alpha_bits = (UINT)-1;
-    BOOL fixup_zero_alpha = FALSE;
+    enum zero_alpha_fixup zero_alpha_fixup = ZERO_ALPHA_FIXUP_NONE;
     uint32_t buffer_format;
 
     surface_damage_region = NtGdiCreateRectRgn(rect->left + dirty->left, rect->top + dirty->top,
@@ -414,7 +476,6 @@ static BOOL wayland_window_surface_flush(struct window_surface *window_surface,
                 alpha_bits = ~(colors[0] | colors[1] | colors[2]);
             }
         }
-        else if (color_info->bmiHeader.biBitCount == 32) fixup_zero_alpha = TRUE;
     }
 
     buffer_format = (shape_bits || wws->layered) ? WL_SHM_FORMAT_ARGB8888 : WL_SHM_FORMAT_XRGB8888;
@@ -468,8 +529,11 @@ static BOOL wayland_window_surface_flush(struct window_surface *window_surface,
         copy_from_window_region = shm_buffer->damage_region;
     }
 
-    wayland_shm_buffer_copy_data(shm_buffer, color_bits, &surface_rect, copy_from_window_region,
-                                 alpha_bits, fixup_zero_alpha);
+    if (wws->layered && window_surface->alpha_mask && color_info->bmiHeader.biBitCount == 32)
+        zero_alpha_fixup = get_zero_alpha_fixup(color_bits, &surface_rect, copy_from_window_region);
+
+    wayland_shm_buffer_copy_data(shm_buffer, color_bits, &surface_rect,
+                                 copy_from_window_region, alpha_bits, zero_alpha_fixup);
     if (shape_bits) wayland_shm_buffer_copy_shape(shm_buffer, rect, shape_info, shape_bits);
 
     NtGdiSetRectRgn(shm_buffer->damage_region, 0, 0, 0, 0);
-- 
2.54.0

