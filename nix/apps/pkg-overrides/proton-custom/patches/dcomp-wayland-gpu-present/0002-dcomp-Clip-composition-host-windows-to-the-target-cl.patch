From d657d9b7f745aefc6bcef8b5dce4aa40b0a64ee6 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Thu, 21 May 2026 02:51:51 -0700
Subject: [PATCH] dcomp: Clip composition host windows to the target client
 area

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index 3d9b7b5..c3bcbc1 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -705,6 +705,36 @@ static BOOL dcomp_refresh_swapchain_desc(struct dcomp_visual *v)
     return TRUE;
 }
 
+static void dcomp_clip_rect_to_client(HWND hwnd, int x, int y, UINT *width, UINT *height)
+{
+    RECT client;
+    int max_width, max_height;
+
+    if (!GetClientRect(hwnd, &client)) return;
+
+    max_width = client.right - x;
+    max_height = client.bottom - y;
+    if (max_width <= 0 || max_height <= 0)
+    {
+        TRACE("composition host outside target client rect hwnd=%p pos=(%d,%d) client=%ldx%ld\n",
+              hwnd, x, y, client.right - client.left, client.bottom - client.top);
+        *width = 0;
+        *height = 0;
+        return;
+    }
+
+    if (*width > (UINT)max_width || *height > (UINT)max_height)
+    {
+        UINT old_width = *width, old_height = *height;
+
+        if (*width > (UINT)max_width) *width = max_width;
+        if (*height > (UINT)max_height) *height = max_height;
+        TRACE("clipped composition host from %ux%u to %ux%u for hwnd %p client=%ldx%ld pos=(%d,%d)\n",
+              old_width, old_height, *width, *height, hwnd,
+              client.right - client.left, client.bottom - client.top, x, y);
+    }
+}
+
 static void dcomp_bind_visual(struct dcomp_target *t, struct dcomp_visual *v,
                               const struct dcomp_placement *parent_placement)
 {
@@ -747,6 +777,8 @@ static void dcomp_bind_visual(struct dcomp_target *t, struct dcomp_visual *v,
             height = bottom > y ? bottom - y : 0;
         }
 
+        dcomp_clip_rect_to_client(t->hwnd, x, y, &width, &height);
+
         if (width && height && dcomp_register_host_class())
         {
             if (!v->host_hwnd || v->host_parent != t->hwnd)
-- 
2.54.0

