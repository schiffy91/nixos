+    class void repair(Contract contract) {
+        ModsSpecBed bed = ModsSpecBed();
+        string title = "0004000000033600";
+        ModsSpecTree.write(bed.source("fixture-textures/" + title + "/tex.png"), "texture");
+        string place = bed.textures(title);
+        FileSystem.mkdirp(PathTools.dirname(place));
+        FileSystem.symlink("/missing/old-card/texture-pack", place);
+        contract.contains(bed.lines(bed.install()), "shadowed", "normal launches leave unrecorded broken links alone");
+        string before = ModsSpecTree.snapshot(bed.library);
+        SemuModInstallReport report = SemuModInstaller.repair(bed.bed.fixture.plan, bed.emulator);
+        contract.expect(report.notice.isEmpty() && FileSystem.readText(PathTools.join(place, "tex.png")).equals("texture"), "explicit repair reconnects a declared mod even if its old manifest was lost");
+        string history = PathTools.join(bed.state, "semu-mod-repairs.tsv");
+        string original = FileSystem.readText(history);
+        contract.contains(original, "/missing/old-card/texture-pack", "repair records the previous link target");
+        SemuModInstaller.repair(bed.bed.fixture.plan, bed.emulator);
+        contract.expect(FileSystem.readText(history).equals(original) && ModsSpecTree.snapshot(bed.library).equals(before), "repair is idempotent and leaves library files unchanged");
+        string foreign = PathTools.join(bed.bed.fixture.scratch, "foreign");
+        FileSystem.mkdirp(foreign);
+        unlink(place);
+        FileSystem.symlink(foreign, place);
+        SemuModInstaller.repair(bed.bed.fixture.plan, bed.emulator);
+        contract.expect(FileSystem.readLink(place).equals(foreign), "repair never replaces a working foreign link");
+    }
+
+    class void portable(Contract contract) {
+        Fixture fixture = Fixture("linux-desktop");
+        string root = PathTools.join(fixture.scratch, "old-user/card");
+        string state = PathTools.join(root, "state/azahar");
+        string place = PathTools.join(state, "load/mods/title");
+        string source = PathTools.join(root, "mods/title");
+        ModsSpecTree.write(PathTools.join(source, "code.ips"), "PATCH-test-EOF");
+        FileSystem.mkdirp(PathTools.dirname(place));
+        FileSystem.symlink(source, place);
+        ModsSpecTree.write(PathTools.join(state, "semu-mods.tsv"), SemuModRecord("link", "fixture", place, source).line() + "\n");
+
+        string moved = PathTools.join(fixture.scratch, "different-user/card");
+        FileSystem.mkdirp(PathTools.dirname(moved));
+        contract.expect(rename(root, moved) == 0, "move a card containing legacy absolute links and ownership records");
+        state = PathTools.join(moved, "state/azahar");
+        place = PathTools.join(state, "load/mods/title");
+        source = PathTools.join(moved, "mods/title");
+        SemuModManifest manifest = SemuModManifest.read(state);
+        contract.expect(!FileSystem.exists(place) && manifest.ownsLink(state, place), "the old record recognizes its broken link after the mount changes");
+        string outcome = SemuModInstaller.place(state, place, source, manifest.ownsLink(state, place));
+        contract.expect(outcome.startsWith("installed") && FileSystem.readText(PathTools.join(place, "code.ips")).equals("PATCH-test-EOF"), "reconcile repairs the moved mod without changing its files");
+        contract.expect(!PathTools.isAbsolute(FileSystem.readLink(place)), "the repaired link is relative to its directory");
+        manifest.replace("link", "fixture", [SemuModRecord("link", "fixture", place, FileSystem.readLink(place))]);
+        contract.expect(manifest.write(state) && !FileSystem.readText(manifest.path).contains(moved), "new ownership records contain no mount prefix");
+
+        string again = PathTools.join(fixture.scratch, "another-mount");
+        contract.expect(rename(moved, again) == 0, "move the card again with portable records and links");
+        state = PathTools.join(again, "state/azahar");
+        place = PathTools.join(state, "load/mods/title");
+        contract.expect(FileSystem.readText(PathTools.join(place, "code.ips")).equals("PATCH-test-EOF"), "the mod works immediately after another mount change");
+        manifest = SemuModManifest.read(state);
+        contract.expect(manifest.owns(place), "ownership survives another mount change");
+        SemuModRecord record = manifest.records.get(0);
+        contract.expect(SemuPaths.removeOwnedLink(state, record.path, record.target), "portable records can still remove their own links");
+        contract.expect(FileSystem.readText(PathTools.join(again, "mods/title/code.ips")).equals("PATCH-test-EOF"), "removing the link leaves the library untouched");
+
+        FileSystem.symlink("/unrelated/missing-mod", place);
+        contract.expect(!SemuModManifest(PathTools.join(state, "semu-mods.tsv"), SemuModRecord("link", "fixture", "/old/state/azahar/load/mods/title", "/old/mods/title").line()).ownsLink(state, place), "a matching suffix alone cannot adopt another owner's link");
+    }
