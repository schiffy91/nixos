index 0000000..38c7530
--- /dev/null
+++ b/src/web_auth.cpp
@@ -0,0 +1,359 @@
+/**
+ * @file src/web_auth.cpp
+ * @brief Verification of OpenSSH SSHSIG login challenges and browser sessions.
+ */
+
+// standard includes
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <stdexcept>
+
+// lib includes
+#include <openssl/bn.h>
+#include <openssl/core_names.h>
+#include <openssl/crypto.h>
+#include <openssl/evp.h>
+#include <openssl/param_build.h>
+#include <openssl/rand.h>
+
+// local includes
+#include "web_auth.h"
+
+namespace web_auth {
+  namespace {
+    constexpr size_t max_entries = 128;  ///< Bound each unauthenticated and authenticated token store.
+    constexpr size_t max_signature_size = 16384;  ///< Bound all untrusted SSH wire-format parsing.
+
+    /** @brief Read the length-prefixed strings specified by RFC 4251 and PROTOCOL.sshsig. */
+    class reader_t {
+    public:
+      /** @brief Construct a reader over bounded, untrusted bytes. */
+      explicit reader_t(std::string_view bytes):
+          bytes(bytes) {}
+
+      /** @brief Consume an unsigned network-order 32-bit integer. */
+      uint32_t integer() {
+        if (bytes.size() < 4) {
+          throw std::invalid_argument("Truncated SSH integer");
+        }
+        uint32_t value = 0;
+        for (unsigned char byte : bytes.substr(0, 4)) {
+          value = (value << 8) | byte;
+        }
+        bytes.remove_prefix(4);
+        return value;
+      }
+
+      /** @brief Consume a length-prefixed SSH string, rejecting out-of-bounds lengths. */
+      std::string_view string() {
+        const auto size = integer();
+        if (size > bytes.size()) {
+          throw std::invalid_argument("Truncated SSH string");
+        }
+        const auto result = bytes.substr(0, size);
+        bytes.remove_prefix(size);
+        return result;
+      }
+
+      /** @brief Require complete consumption, rejecting ambiguous trailing bytes. */
+      void finish() const {
+        if (!bytes.empty()) {
+          throw std::invalid_argument("Trailing SSH data");
+        }
+      }
+
+    private:
+      std::string_view bytes;  ///< Remaining bytes, always a view into the caller's bounded input.
+    };
+
+    /** @brief Decode canonical, padded base64 without accepting punctuation or extra padding. */
+    std::string decode_base64(std::string_view text) {
+      if (text.empty() || text.size() > max_signature_size || text.size() % 4) {
+        throw std::invalid_argument("Invalid base64 length");
+      }
+      const auto padding = text.ends_with("==") ? 2 : text.ends_with('=') ? 1 :
+                                                                            0;
+      if (!std::ranges::all_of(text.substr(0, text.size() - padding), [](unsigned char ch) {
+            return (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '+' || ch == '/';
+          })) {
+        throw std::invalid_argument("Invalid base64 alphabet");
+      }
+      std::string decoded(text.size() / 4 * 3, '\0');
+      const auto size = EVP_DecodeBlock(reinterpret_cast<unsigned char *>(decoded.data()), reinterpret_cast<const unsigned char *>(text.data()), text.size());
+      if (size < padding) {
+        throw std::invalid_argument("Invalid base64");
+      }
+      decoded.resize(size - padding);
+      std::string canonical(text.size() + 1, '\0');
+      const auto written = EVP_EncodeBlock(reinterpret_cast<unsigned char *>(canonical.data()), reinterpret_cast<const unsigned char *>(decoded.data()), decoded.size());
+      canonical.resize(written);
+      if (canonical != text) {
+        throw std::invalid_argument("Noncanonical base64");
+      }
+      return decoded;
+    }
+
+    /** @brief Read a plain OpenSSH public-key line; authorized_keys options and certificates are not accepted. */
+    std::string key_blob(std::string_view line) {
+      const auto separator = line.find_first_of(" \t");
+      const auto type = line.substr(0, separator);
+      if (separator == std::string_view::npos || (type != "ssh-ed25519" && type != "ssh-rsa")) {
+        throw std::invalid_argument("Unsupported SSH public key");
+      }
+      line.remove_prefix(separator);
+      const auto start = line.find_first_not_of(" \t");
+      if (start == std::string_view::npos) {
+        throw std::invalid_argument("Missing SSH public key");
+      }
+      line.remove_prefix(start);
+      const auto blob = decode_base64(line.substr(0, line.find_first_of(" \t\r\n")));
+      reader_t reader(blob);
+      if (reader.string() != type) {
+        throw std::invalid_argument("SSH key type mismatch");
+      }
+      return blob;
+    }
+
+    /** @brief Check a binary key against the current configured public-key list. */
+    bool authorized(std::string_view key, std::span<const std::string> keys) {
+      for (const auto &entry : keys) {
+        try {
+          if (key_blob(entry) == key) {
+            return true;
+          }
+        } catch (const std::invalid_argument &) {
+          // An invalid configured entry cannot authorize a login.
+        }
+      }
+      return false;
+    }
+
+    /** @brief Append an SSH wire-format string to a signature payload. */
+    void append_string(std::string &out, std::string_view value) {
+      const auto size = static_cast<uint32_t>(value.size());
+      for (int shift = 24; shift >= 0; shift -= 8) {
+        out += static_cast<char>(size >> shift);
+      }
+      out += value;
+    }
+
+    using key_ptr = std::unique_ptr<EVP_PKEY, decltype(&EVP_PKEY_free)>;  ///< OpenSSL public-key ownership.
+
+    /** @brief Decode an Ed25519 or RSA SSH public key using OpenSSL's public-key import API. */
+    key_ptr public_key(std::string_view blob) {
+      reader_t reader(blob);
+      const auto type = reader.string();
+      if (type == "ssh-ed25519") {
+        const auto key = reader.string();
+        reader.finish();
+        if (key.size() != 32) {
+          throw std::invalid_argument("Invalid Ed25519 public key");
+        }
+        return {EVP_PKEY_new_raw_public_key(EVP_PKEY_ED25519, nullptr, reinterpret_cast<const unsigned char *>(key.data()), key.size()), EVP_PKEY_free};
+      }
+      if (type != "ssh-rsa") {
+        throw std::invalid_argument("Unsupported SSH key algorithm");
+      }
+      const auto exponent = reader.string();
+      const auto modulus = reader.string();
+      reader.finish();
+      const auto positive = [](std::string_view value) {
+        return !value.empty() && !(static_cast<unsigned char>(value.front()) & 0x80) && (value.front() != '\0' || (value.size() > 1 && (static_cast<unsigned char>(value[1]) & 0x80)));
+      };
+      if (!positive(exponent) || !positive(modulus) || modulus.size() < 256 || modulus.size() > 1025 || exponent.size() > 8) {
+        throw std::invalid_argument("Invalid RSA public key");
+      }
+      std::unique_ptr<BIGNUM, decltype(&BN_free)> e(BN_bin2bn(reinterpret_cast<const unsigned char *>(exponent.data()), exponent.size(), nullptr), BN_free);
+      std::unique_ptr<BIGNUM, decltype(&BN_free)> n(BN_bin2bn(reinterpret_cast<const unsigned char *>(modulus.data()), modulus.size(), nullptr), BN_free);
+      std::unique_ptr<OSSL_PARAM_BLD, decltype(&OSSL_PARAM_BLD_free)> builder(OSSL_PARAM_BLD_new(), OSSL_PARAM_BLD_free);
+      if (!e || !n || BN_num_bits(n.get()) < 2048 || BN_num_bits(n.get()) > 8192 || !builder || !OSSL_PARAM_BLD_push_BN(builder.get(), OSSL_PKEY_PARAM_RSA_E, e.get()) || !OSSL_PARAM_BLD_push_BN(builder.get(), OSSL_PKEY_PARAM_RSA_N, n.get())) {
+        throw std::invalid_argument("Invalid RSA parameters");
+      }
+      std::unique_ptr<OSSL_PARAM, decltype(&OSSL_PARAM_free)> parameters(OSSL_PARAM_BLD_to_param(builder.get()), OSSL_PARAM_free);
+      std::unique_ptr<EVP_PKEY_CTX, decltype(&EVP_PKEY_CTX_free)> context(EVP_PKEY_CTX_new_from_name(nullptr, "RSA", nullptr), EVP_PKEY_CTX_free);
+      EVP_PKEY *key = nullptr;
+      if (!parameters || !context || EVP_PKEY_fromdata_init(context.get()) <= 0 || EVP_PKEY_fromdata(context.get(), &key, EVP_PKEY_PUBLIC_KEY, parameters.get()) <= 0) {
+        EVP_PKEY_free(key);
+        throw std::invalid_argument("Invalid RSA key");
+      }
+      return {key, EVP_PKEY_free};
+    }
+
+    /** @brief Generate a 256-bit opaque token, failing closed if the OS random source fails. */
+    std::string token() {
+      std::array<unsigned char, 32> bytes;
+      if (RAND_bytes(bytes.data(), bytes.size()) != 1) {
+        throw std::runtime_error("Cannot generate Web UI login token");
+      }
+      constexpr std::string_view alphabet = "0123456789abcdef";
+      std::string result;
+      result.reserve(bytes.size() * 2);
+      for (const auto byte : bytes) {
+        result += alphabet[byte >> 4];
+        result += alphabet[byte & 15];
+      }
+      return result;
+    }
+  }  // namespace
+
+  std::optional<std::string> verify_signature(std::string_view signature, std::string_view message, std::span<const std::string> allowed_keys) {
+    try {
+      constexpr std::string_view begin = "-----BEGIN SSH SIGNATURE-----";
+      constexpr std::string_view end = "-----END SSH SIGNATURE-----";
+      if (signature.size() > max_signature_size || !signature.starts_with(begin)) {
+        return std::nullopt;
+      }
+      signature.remove_prefix(begin.size());
+      const auto end_position = signature.find(end);
+      if (end_position == std::string_view::npos || signature.substr(end_position + end.size()).find_first_not_of("\r\n") != std::string_view::npos) {
+        return std::nullopt;
+      }
+      std::string encoded(signature.substr(0, end_position));
+      std::erase_if(encoded, [](char ch) {
+        return ch == '\r' || ch == '\n';
+      });
+      const auto blob = decode_base64(encoded);
+      if (!blob.starts_with("SSHSIG")) {
+        return std::nullopt;
+      }
+      reader_t reader(std::string_view(blob).substr(6));
+      if (reader.integer() != 1) {
+        return std::nullopt;
+      }
+      const auto key_blob = reader.string();
+      const auto purpose = reader.string();
+      const auto reserved = reader.string();
+      const auto hash_algorithm = reader.string();
+      const auto signature_blob = reader.string();
+      reader.finish();
+      if (purpose != signature_namespace || !reserved.empty() || (hash_algorithm != "sha256" && hash_algorithm != "sha512") || !authorized(key_blob, allowed_keys)) {
+        return std::nullopt;
+      }
+      reader_t signature_reader(signature_blob);
+      const auto algorithm = signature_reader.string();
+      const auto signed_bytes = signature_reader.string();
+      signature_reader.finish();
+      const auto key = public_key(key_blob);
+      const EVP_MD *signature_hash = nullptr;
+      if (!key) {
+        return std::nullopt;
+      }
+      if (EVP_PKEY_is_a(key.get(), "ED25519")) {
+        if (algorithm != "ssh-ed25519") {
+          return std::nullopt;
+        }
+      } else if (algorithm == "rsa-sha2-512") {
+        signature_hash = EVP_sha512();
+      } else if (algorithm == "rsa-sha2-256") {
+        signature_hash = EVP_sha256();
+      } else {
+        return std::nullopt;
+      }
+      std::array<unsigned char, EVP_MAX_MD_SIZE> hash;
+      unsigned int hash_size = 0;
+      if (EVP_Digest(message.data(), message.size(), hash.data(), &hash_size, hash_algorithm == "sha512" ? EVP_sha512() : EVP_sha256(), nullptr) != 1) {
+        return std::nullopt;
+      }
+      std::string payload = "SSHSIG";
+      append_string(payload, purpose);
+      append_string(payload, reserved);
+      append_string(payload, hash_algorithm);
+      append_string(payload, std::string_view(reinterpret_cast<const char *>(hash.data()), hash_size));
+      std::unique_ptr<EVP_MD_CTX, decltype(&EVP_MD_CTX_free)> context(EVP_MD_CTX_new(), EVP_MD_CTX_free);
+      if (!context || EVP_DigestVerifyInit(context.get(), nullptr, signature_hash, nullptr, key.get()) != 1 || EVP_DigestVerify(context.get(), reinterpret_cast<const unsigned char *>(signed_bytes.data()), signed_bytes.size(), reinterpret_cast<const unsigned char *>(payload.data()), payload.size()) != 1) {
+        return std::nullopt;
+      }
+      return std::string(key_blob);
+    } catch (const std::invalid_argument &) {
+      return std::nullopt;
+    }
+  }
+
+  void sessions_t::expire(clock::time_point now) {
+    for (auto *entries : {&challenges, &sessions}) {
+      std::erase_if(*entries, [now](const auto &entry) {
+        return entry.second.expires <= now;
+      });
+    }
+  }
+
+  std::string sessions_t::message(std::string_view challenge, std::string_view origin) {
+    return "Sunshine Web UI login\nOrigin: " + std::string(origin) + "\nChallenge: " + std::string(challenge) + "\n";
+  }
+
+  std::optional<sessions_t::challenge_t> sessions_t::begin(const std::string &origin, clock::time_point now) {
+    std::scoped_lock lock(mutex);
+    expire(now);
+    if (challenges.size() >= max_entries) {
+      return std::nullopt;
+    }
+    challenge_t value {token(), token()};
+    challenges.emplace(value.id, entry_t {origin, value.binding, {}, now + challenge_lifetime});
+    return value;
+  }
+
+  std::optional<std::string> sessions_t::describe(const std::string &challenge, const std::string &origin, clock::time_point now) {
+    std::scoped_lock lock(mutex);
+    expire(now);
+    const auto entry = challenges.find(challenge);
+    if (entry == challenges.end() || entry->second.origin != origin || !entry->second.key.empty()) {
+      return std::nullopt;
+    }
+    return message(challenge, origin);
+  }
+
+  bool sessions_t::complete(const std::string &challenge, std::string_view signature, const std::string &origin, std::span<const std::string> keys, clock::time_point now) {
+    std::scoped_lock lock(mutex);
+    expire(now);
+    const auto entry = challenges.find(challenge);
+    if (entry == challenges.end() || entry->second.origin != origin || !entry->second.key.empty()) {
+      return false;
+    }
+    const auto key = verify_signature(signature, message(challenge, origin), keys);
+    if (!key) {
+      return false;
+    }
+    entry->second.key = *key;
+    return true;
+  }
+
+  std::optional<std::string> sessions_t::exchange(const std::string &challenge, const std::string &binding, const std::string &origin, std::span<const std::string> keys, clock::time_point now) {
+    std::scoped_lock lock(mutex);
+    expire(now);
+    const auto entry = challenges.find(challenge);
+    if (entry == challenges.end() || entry->second.origin != origin || (entry->second.binding.size() != binding.size() || CRYPTO_memcmp(entry->second.binding.data(), binding.data(), binding.size()) != 0) || !authorized(entry->second.key, keys) || sessions.size() >= max_entries) {
+      return std::nullopt;
+    }
+    auto value = token();
+    sessions.emplace(value, entry_t {origin, {}, entry->second.key, now + session_lifetime});
+    challenges.erase(entry);
+    return value;
+  }
+
+  bool sessions_t::authenticate(const std::string &session, const std::string &origin, std::span<const std::string> keys, clock::time_point now) {
+    std::scoped_lock lock(mutex);
+    expire(now);
+    const auto entry = sessions.find(session);
+    if (entry == sessions.end() || entry->second.origin != origin) {
+      return false;
+    }
+    if (!authorized(entry->second.key, keys)) {
+      sessions.erase(entry);
+      return false;
+    }
+    return true;
+  }
+
+  void sessions_t::revoke(const std::string &session) {
+    std::scoped_lock lock(mutex);
+    sessions.erase(session);
+  }
+
+  void sessions_t::clear() {
+    std::scoped_lock lock(mutex);
+    challenges.clear();
+    sessions.clear();
+  }
+}  // namespace web_auth
