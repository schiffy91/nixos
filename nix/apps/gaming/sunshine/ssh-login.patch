+/**
+ * @file src/web_auth_http.h
+ * @brief HTTPS adapters for SSH-key Web UI authentication.
+ */
+#pragma once
+
+// local includes
+#include "confighttp.h"
+
+namespace web_auth_http {
+  /** @brief Authenticate a browser cookie, including same-origin checks on modifying requests. */
+  bool authenticated(const confighttp::req_https_t &request);
+  /** @brief Read the browser session identifier for CSRF token isolation. */
+  std::string session_id(const confighttp::req_https_t &request);
+  /** @brief Start a login bound to this browser through a secret HTTP-only cookie. */
+  void begin(const confighttp::resp_https_t &response, const confighttp::req_https_t &request);
+  /** @brief Describe a pending browser challenge to the signing helper. */
+  void challenge(const confighttp::resp_https_t &response, const confighttp::req_https_t &request);
+  /** @brief Verify an SSH signature and approve the browser that requested the challenge. */
+  void complete(const confighttp::resp_https_t &response, const confighttp::req_https_t &request);
+  /** @brief Exchange the approved, browser-bound challenge for a secure, HTTP-only session cookie. */
+  void exchange(const confighttp::resp_https_t &response, const confighttp::req_https_t &request);
+  /** @brief Revoke the current browser session and clear its cookie. */
+  void logout(const confighttp::resp_https_t &response, const confighttp::req_https_t &request);
+  /** @brief Revoke all SSH login state after account credentials change. */
+  void clear();
+}  // namespace web_auth_http
