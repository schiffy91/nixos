+++ b/src/web_auth.h
@@ -0,0 +1,79 @@
+/**
+ * @file src/web_auth.h
+ * @brief SSH signatures and short-lived Web UI authentication sessions.
+ */
+#pragma once
+
+// standard includes
+#include <chrono>
+#include <mutex>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+
+namespace web_auth {
+  inline constexpr std::string_view signature_namespace = "sunshine-web-login";  ///< OpenSSH signature purpose, distinct from SSH login and Git signatures.
+  inline constexpr std::chrono::seconds challenge_lifetime {120};  ///< Maximum time to approve a browser login.
+  inline constexpr std::chrono::hours session_lifetime {1};  ///< Absolute lifetime of an authenticated browser session.
+
+  /**
+   * @brief Verify an armored OpenSSH SSHSIG against configured Ed25519 or RSA public keys.
+   * @param signature Armored signature produced by ssh-keygen -Y sign.
+   * @param message Exact login challenge signed by the client.
+   * @param allowed_keys Public keys in OpenSSH public-key format, without authorized_keys options.
+   * @return The verified binary public key, or no value for an invalid or unauthorized signature.
+   */
+  std::optional<std::string> verify_signature(std::string_view signature, std::string_view message, std::span<const std::string> allowed_keys);
+
+  /**
+   * @brief In-memory, bounded, one-use, browser-bound login challenges.
+   *
+   * Sessions are bound to the HTTPS origin and the signing key. Removing that key
+   * from the configured list revokes its sessions on their next use.
+   */
+  class sessions_t {
+  public:
+    using clock = std::chrono::steady_clock;  ///< Monotonic deadlines unaffected by wall-clock adjustments.
+
+    /** @brief Public challenge identifier and the private binding kept only in a browser cookie. */
+    struct challenge_t {
+      std::string id;  ///< Public identifier passed to the signing helper.
+      std::string binding;  ///< Secret proving which browser requested the login.
+    };
+
+    /** @brief Create a short-lived challenge for the requested HTTPS origin. */
+    std::optional<challenge_t> begin(const std::string &origin, clock::time_point now = clock::now());
+    /** @brief Return the exact, domain-separated message that the client signs. */
+    static std::string message(std::string_view challenge, std::string_view origin);
+    /** @brief Retrieve the exact message for a pending public challenge identifier. */
+    std::optional<std::string> describe(const std::string &challenge, const std::string &origin, clock::time_point now = clock::now());
+    /** @brief Authorize a pending browser challenge after verifying its one-use SSH signature. */
+    bool complete(const std::string &challenge, std::string_view signature, const std::string &origin, std::span<const std::string> keys, clock::time_point now = clock::now());
+    /** @brief Issue a session only to the browser that requested the approved challenge. */
+    std::optional<std::string> exchange(const std::string &challenge, const std::string &binding, const std::string &origin, std::span<const std::string> keys, clock::time_point now = clock::now());
+    /** @brief Check a session's origin, expiry, and current public-key authorization. */
+    bool authenticate(const std::string &session, const std::string &origin, std::span<const std::string> keys, clock::time_point now = clock::now());
+    /** @brief Revoke a browser session. */
+    void revoke(const std::string &session);
+    /** @brief Revoke all sessions and outstanding logins after an account credential change. */
+    void clear();
+
+  private:
+    /** @brief A pending login or authenticated session and its absolute expiration. */
+    struct entry_t {
+      std::string origin;  ///< Exact HTTPS origin that requested the challenge.
+      std::string binding;  ///< Secret cookie binding for a pending browser challenge.
+      std::string key;  ///< Verified binary OpenSSH public key; empty until verification.
+      clock::time_point expires;  ///< Absolute expiration measured with the monotonic clock.
+    };
+
+    using entries_t = std::unordered_map<std::string, entry_t>;  ///< Secret random tokens mapped to their authorization state.
+    /** @brief Remove expired entries before enforcing bounded storage. */
+    void expire(clock::time_point now);
+    std::mutex mutex;  ///< Serializes consumption so concurrent replays cannot succeed.
+    entries_t challenges;  ///< Outstanding challenges awaiting signatures.
+    entries_t sessions;  ///< Authenticated browser sessions.
+  };
+}  // namespace web_auth
