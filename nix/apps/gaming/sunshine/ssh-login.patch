index 0000000..c81dcc8
--- /dev/null
+++ b/src/web_auth_http.cpp
@@ -0,0 +1,212 @@
+/**
+ * @file src/web_auth_http.cpp
+ * @brief HTTPS endpoints for optional SSH-key Web UI login.
+ */
+
+// standard includes
+#include <algorithm>
+#include <optional>
+
+// lib includes
+#include <boost/algorithm/string.hpp>
+#include <nlohmann/json.hpp>
+
+// local includes
+#include "config.h"
+#include "httpcommon.h"
+#include "network.h"
+#include "web_auth.h"
+#include "web_auth_http.h"
+
+namespace web_auth_http {
+  namespace {
+    web_auth::sessions_t sessions;  ///< Process-local login state; restart invalidates every token.
+    constexpr std::string_view cookie_name = "__Host-sunshine-session";  ///< Host-only cookie prevents sibling-domain cookie injection.
+
+    /** @brief Build the canonical HTTPS origin without accepting URL delimiters or duplicate Host headers. */
+    std::optional<std::string> origin(const confighttp::req_https_t &request) {
+      const auto host = request->header.find("Host");
+      if (host == request->header.end() || request->header.count("Host") != 1 || host->second.empty() || host->second.size() > 260 || !std::ranges::all_of(host->second, [](unsigned char ch) {
+            return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '.' || ch == '-' || ch == ':' || ch == '[' || ch == ']';
+          })) {
+        return std::nullopt;
+      }
+      auto authority = boost::algorithm::to_lower_copy(host->second);
+      if (authority.ends_with(":443")) {
+        authority.resize(authority.size() - 4);
+      }
+      return "https://" + authority;
+    }
+
+    /** @brief Require the browser's exact origin; CLI-only endpoints may omit Origin. */
+    bool same_origin(const confighttp::req_https_t &request, const std::string &expected, bool browser) {
+      const auto source = request->header.find("Origin");
+      return source == request->header.end() ? !browser : request->header.count("Origin") == 1 && source->second == expected;
+    }
+
+    /** @brief Apply the existing Web UI network restriction to unauthenticated SSH endpoints. */
+    bool allowed(const confighttp::resp_https_t &response, const confighttp::req_https_t &request, bool browser) {
+      const auto address = net::addr_to_normalized_string(request->remote_endpoint().address());
+      const auto expected = origin(request);
+      if (net::from_address(address) > http::origin_web_ui_allowed || !expected || !same_origin(request, *expected, browser)) {
+        response->write(SimpleWeb::StatusCode::client_error_forbidden);
+        return false;
+      }
+      if (config::sunshine.web_ui_ssh_keys.empty()) {
+        response->write(SimpleWeb::StatusCode::client_error_not_found);
+        return false;
+      }
+      return confighttp::check_content_type(response, request, "application/json");
+    }
+
+    /** @brief Read a bounded JSON object without logging authentication material. */
+    nlohmann::json body(const confighttp::req_https_t &request) {
+      if (request->content.size() > 20000) {
+        throw std::invalid_argument("Login request is too large");
+      }
+      const auto result = nlohmann::json::parse(request->content.string());
+      if (!result.is_object()) {
+        throw std::invalid_argument("Expected a JSON object");
+      }
+      return result;
+    }
+
+    /** @brief Return authentication data with cache prevention and framing protection. */
+    void respond(const confighttp::resp_https_t &response, const nlohmann::json &data, const std::string &cookie = {}) {
+      SimpleWeb::CaseInsensitiveMultimap headers {
+        {"Content-Type", "application/json"},
+        {"Cache-Control", "no-store"},
+        {"X-Frame-Options", "DENY"},
+        {"Content-Security-Policy", "frame-ancestors 'none'"}
+      };
+      if (!cookie.empty()) {
+        headers.emplace("Set-Cookie", cookie);
+      }
+      response->write(data.dump(), headers);
+    }
+
+    /** @brief Reject failed login attempts without issuing a Basic-auth browser prompt. */
+    void reject(const confighttp::resp_https_t &response) {
+      response->write(SimpleWeb::StatusCode::client_error_forbidden, "Login invalid or expired", {{"Cache-Control", "no-store"}});
+    }
+  }  // namespace
+
+  /** @brief Read one unambiguous opaque cookie without accepting duplicate names. */
+  static std::string read_cookie(const confighttp::req_https_t &request, std::string_view name) {
+    std::string result;
+    const auto [begin, end] = request->header.equal_range("Cookie");
+    for (auto header = begin; header != end; ++header) {
+      std::string_view remaining(header->second);
+      while (!remaining.empty()) {
+        const auto separator = remaining.find(';');
+        auto part = remaining.substr(0, separator);
+        const auto start = part.find_first_not_of(" \t");
+        if (start != std::string_view::npos) {
+          part.remove_prefix(start);
+          if (part.starts_with(name) && part.size() > name.size() && part[name.size()] == '=') {
+            const auto value = part.substr(name.size() + 1);
+            if (!result.empty() || value.size() != 64 || !std::ranges::all_of(value, [](char ch) {
+                  return (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f');
+                })) {
+              return {};
+            }
+            result = value;
+          }
+        }
+        if (separator == std::string_view::npos) {
+          break;
+        }
+        remaining.remove_prefix(separator + 1);
+      }
+    }
+    return result;
+  }
+
+  std::string session_id(const confighttp::req_https_t &request) {
+    return read_cookie(request, cookie_name);
+  }
+
+  bool authenticated(const confighttp::req_https_t &request) {
+    const auto expected = origin(request);
+    const auto id = session_id(request);
+    const bool modifying = request->method != "GET" && request->method != "HEAD";
+    return expected && !id.empty() && same_origin(request, *expected, modifying) && sessions.authenticate(id, *expected, config::sunshine.web_ui_ssh_keys);
+  }
+
+  void begin(const confighttp::resp_https_t &response, const confighttp::req_https_t &request) {
+    if (!allowed(response, request, true)) {
+      return;
+    }
+    const auto value = sessions.begin(*origin(request));
+    if (!value) {
+      response->write(SimpleWeb::StatusCode::client_error_too_many_requests);
+      return;
+    }
+    respond(response, {{"challenge", value->id}, {"expires_in", web_auth::challenge_lifetime.count()}}, "__Host-sunshine-login=" + value->binding + "; Path=/; Secure; HttpOnly; SameSite=Strict; Max-Age=120");
+  }
+
+  void challenge(const confighttp::resp_https_t &response, const confighttp::req_https_t &request) {
+    if (!allowed(response, request, false)) {
+      return;
+    }
+    try {
+      const auto id = body(request).at("challenge").get<std::string>();
+      const auto value = sessions.describe(id, *origin(request));
+      if (value) {
+        respond(response, {{"challenge", id}, {"namespace", web_auth::signature_namespace}, {"message", *value}});
+        return;
+      }
+    } catch (const std::exception &) {
+      // Malformed and unknown challenges have the same response.
+    }
+    reject(response);
+  }
+
+  void complete(const confighttp::resp_https_t &response, const confighttp::req_https_t &request) {
+    if (!allowed(response, request, false)) {
+      return;
+    }
+    try {
+      const auto input = body(request);
+      const auto value = sessions.complete(input.at("challenge").get<std::string>(), input.at("signature").get<std::string>(), *origin(request), config::sunshine.web_ui_ssh_keys);
+      if (value) {
+        respond(response, {{"status", true}});
+        return;
+      }
+    } catch (const std::exception &) {
+      // Treat malformed and invalid proof requests identically.
+    }
+    reject(response);
+  }
+
+  void exchange(const confighttp::resp_https_t &response, const confighttp::req_https_t &request) {
+    if (!allowed(response, request, true)) {
+      return;
+    }
+    try {
+      const auto input = body(request);
+      const auto value = sessions.exchange(input.at("challenge").get<std::string>(), read_cookie(request, "__Host-sunshine-login"), *origin(request), config::sunshine.web_ui_ssh_keys);
+      if (value) {
+        respond(response, {{"status", true}}, std::string(cookie_name) + "=" + *value + "; Path=/; Secure; HttpOnly; SameSite=Strict; Max-Age=3600");
+        return;
+      }
+    } catch (const std::exception &) {
+      // Never put cookies or parse exceptions into logs or responses.
+    }
+    response->write(SimpleWeb::StatusCode::success_accepted, "Login not ready", {{"Cache-Control", "no-store"}});
+  }
+
+  void logout(const confighttp::resp_https_t &response, const confighttp::req_https_t &request) {
+    const auto expected = origin(request);
+    if (!expected || !same_origin(request, *expected, true)) {
+      reject(response);
+      return;
+    }
+    sessions.revoke(session_id(request));
+    respond(response, {{"status", true}}, std::string(cookie_name) + "=; Path=/; Secure; HttpOnly; SameSite=Strict; Max-Age=0");
+  }
+
+  void clear() {
+    sessions.clear();
+  }
+}  // namespace web_auth_http
