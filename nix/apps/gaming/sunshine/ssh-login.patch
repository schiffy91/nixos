diff --git a/src_assets/common/assets/web/SshLogin.vue b/src_assets/common/assets/web/SshLogin.vue
new file mode 100644
index 0000000..f1757ec
--- /dev/null
+++ b/src_assets/common/assets/web/SshLogin.vue
@@ -0,0 +1,98 @@
+<template>
+  <main class="container py-5">
+    <div class="card mx-auto" style="max-width: 48rem">
+      <div class="card-body">
+        <h1 class="h3">{{ $t("ssh_login.title") }}</h1>
+        <p>{{ $t("ssh_login.description") }}</p>
+        <div v-if="failed" class="alert alert-danger" role="alert">
+          {{ $t("ssh_login.failed") }}
+        </div>
+        <template v-if="challenge">
+          <p>{{ $t("ssh_login.command") }}</p>
+          <pre
+            class="p-3 bg-body-tertiary text-wrap"
+          ><code>{{ command }}</code></pre>
+          <p role="status">{{ $t("ssh_login.waiting") }}</p>
+        </template>
+        <button v-else class="btn btn-primary" :disabled="busy" @click="begin">
+          {{ $t("ssh_login.start") }}
+        </button>
+      </div>
+    </div>
+  </main>
+</template>
+
+<script setup>
+import { computed, onUnmounted, ref } from "vue";
+
+const challenge = ref("");
+const busy = ref(false);
+const failed = ref(false);
+let timer;
+let expires;
+let active = true;
+const shellQuote = (value) => "'" + value.replaceAll("'", "'\"'\"'") + "'";
+const command = computed(
+  () =>
+    `python3 sunshine-ssh-login.py ${shellQuote(globalThis.location.origin)} --challenge ${challenge.value} -i /path/to/key.pub`,
+);
+
+async function post(path, body) {
+  return fetch(path, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    credentials: "same-origin",
+    body: JSON.stringify(body),
+  });
+}
+
+function fail() {
+  failed.value = true;
+  challenge.value = "";
+}
+
+async function poll() {
+  try {
+    if (!active) return;
+    if (Date.now() >= expires) return fail();
+    const response = await post("/api/ssh/exchange", {
+      challenge: challenge.value,
+    });
+    if (!active) return;
+    if (response.status === 200) {
+      globalThis.location.replace("/");
+    } else if (response.status === 202) {
+      timer = globalThis.setTimeout(poll, 1500);
+    } else {
+      fail();
+    }
+  } catch {
+    fail();
+  }
+}
+
+async function begin() {
+  busy.value = true;
+  failed.value = false;
+  try {
+    const response = await post("/api/ssh/begin", {});
+    if (!response.ok) throw new Error("Login unavailable");
+    const data = await response.json();
+    if (!active) return;
+    if (!/^[0-9a-f]{64}$/.test(data.challenge) || data.expires_in !== 120)
+      throw new Error("Invalid challenge");
+    challenge.value = data.challenge;
+    expires = Date.now() + data.expires_in * 1000;
+    timer = globalThis.setTimeout(poll, 1500);
+  } catch {
+    fail();
+  } finally {
+    busy.value = false;
+  }
+}
+
+onUnmounted(() => {
+  active = false;
+  globalThis.clearTimeout(timer);
+});
+</script>
