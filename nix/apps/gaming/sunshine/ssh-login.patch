diff --git a/tools/sunshine-ssh-login.py b/tools/sunshine-ssh-login.py
new file mode 100644
index 0000000..367f424
--- /dev/null
+++ b/tools/sunshine-ssh-login.py
@@ -0,0 +1,163 @@
+#!/usr/bin/env python3
+"""Authenticate Sunshine's Web UI with an OpenSSH public key and SSH agent."""
+
+import argparse
+import hashlib
+import http.client
+import json
+import pathlib
+import re
+import ssl
+import subprocess
+import sys
+import urllib.parse
+
+NAMESPACE = "sunshine-web-login"
+
+
+class SunshineClient:
+    """Make HTTPS requests with optional exact leaf certificate pinning."""
+
+    def __init__(self, url, certificate=None):
+        """Validate the destination before requesting an agent signature."""
+        parsed = urllib.parse.urlsplit(url)
+        if (
+            parsed.scheme != "https"
+            or not parsed.hostname
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.path not in ("", "/")
+            or parsed.query
+            or parsed.fragment
+        ):
+            raise ValueError(
+                "Use an HTTPS origin, for example https://deck:47990"
+            )
+        host = parsed.hostname
+        authority = f"[{host}]" if ":" in host else host
+        port = parsed.port or 443
+        if port != 443:
+            authority += f":{port}"
+        self.origin = f"https://{authority}"
+        self.pin = None
+        context = ssl.create_default_context()
+        if certificate:
+            pem = pathlib.Path(certificate).read_text(encoding="ascii")
+            self.pin = hashlib.sha256(ssl.PEM_cert_to_DER_cert(pem)).digest()
+            # The leaf pin identifies the server, regardless of its hostname.
+            context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
+            context.check_hostname = False
+            context.verify_mode = ssl.CERT_NONE
+        self.connection = http.client.HTTPSConnection(
+            host, port, context=context, timeout=15
+        )
+
+    def post(self, path, data):
+        """Validate the TLS server before sending any login data."""
+        self.connection.connect()
+        try:
+            if self.pin is not None:
+                peer = self.connection.sock.getpeercert(binary_form=True)
+                if hashlib.sha256(peer).digest() != self.pin:
+                    raise ssl.SSLError(
+                        "Sunshine certificate does not match "
+                        "the supplied certificate"
+                    )
+            self.connection.request(
+                "POST",
+                path,
+                body=json.dumps(data),
+                headers={"Content-Type": "application/json"},
+            )
+            response = self.connection.getresponse()
+            body = response.read(20001)
+            if response.status != 200:
+                raise ValueError(
+                    "Sunshine refused the login request "
+                    f"(HTTP {response.status})"
+                )
+            if len(body) > 20000:
+                raise ValueError(
+                    "Sunshine returned an oversized login response"
+                )
+            return json.loads(body)
+        finally:
+            self.connection.close()
+
+
+def login(client, public_key, identifier):
+    """Sign only the expected namespace and destination-bound message."""
+    challenge = client.post("/api/ssh/challenge", {"challenge": identifier})
+    if (
+        not isinstance(identifier, str)
+        or not re.fullmatch(r"[0-9a-f]{64}", identifier)
+        or challenge.get("challenge") != identifier
+    ):
+        raise ValueError("Invalid Sunshine challenge")
+    message = (
+        f"Sunshine Web UI login\nOrigin: {client.origin}\n"
+        f"Challenge: {identifier}\n"
+    )
+    if (
+        challenge.get("namespace") != NAMESPACE
+        or challenge.get("message") != message
+    ):
+        raise ValueError(
+            "Sunshine returned a challenge "
+            "for a different destination or purpose"
+        )
+    print(
+        f"Approve signing in to {client.origin} with your SSH key.",
+        file=sys.stderr,
+    )
+    signed = subprocess.run(
+        ["ssh-keygen", "-Y", "sign", "-n", NAMESPACE, "-f", str(public_key)],
+        input=message.encode("utf-8"),
+        stdout=subprocess.PIPE,
+        check=True,
+    )
+    result = client.post(
+        "/api/ssh/complete",
+        {"challenge": identifier, "signature": signed.stdout.decode("ascii")},
+    )
+    if result.get("status") is not True:
+        raise ValueError("Sunshine did not approve the browser login")
+    print(
+        "Login approved. Return to the browser that requested it.",
+        file=sys.stderr,
+    )
+
+
+def main():
+    """Approve a browser login without exposing the SSH private key."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("url", help="Sunshine HTTPS origin")
+    parser.add_argument(
+        "-i",
+        "--identity",
+        required=True,
+        type=pathlib.Path,
+        help="OpenSSH public-key file for your SSH agent",
+    )
+    parser.add_argument(
+        "--certificate",
+        type=pathlib.Path,
+        help="Sunshine's exact PEM certificate from a trusted channel",
+    )
+    parser.add_argument(
+        "--challenge",
+        required=True,
+        help="Public challenge identifier shown by Sunshine in your browser",
+    )
+    args = parser.parse_args()
+    try:
+        client = SunshineClient(args.url, args.certificate)
+        login(client, args.identity, args.challenge)
+    except (ValueError, OSError, subprocess.CalledProcessError) as error:
+        print(f"SSH login failed: {error}", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
