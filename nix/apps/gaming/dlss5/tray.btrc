import Library.Tray;
import Library.Platform;

int main() {
    var iconPath = Environment.get("DLSS5_TRAY_ICON", "");
    var tray = SystemTray("DLSS 5");
    if (!iconPath.isEmpty()) {
        tray.icon(iconPath);
    }
    tray.tip("DLSS 5 neural rendering")
        .checkItem("Neural rendering", "dlss5ctl toggle", "dlss5ctl status")
        .checkItem("Style: Default", "dlss5ctl style 0", "dlss5ctl style-is 0")
        .checkItem("Style: Natural", "dlss5ctl style 1", "dlss5ctl style-is 1")
        .checkItem("Style: Cinematic", "dlss5ctl style 2", "dlss5ctl style-is 2")
        .item("Helper log", "dlss5ctl log")
        .item("Quit tray", TraySignal.quit());

    try {
        tray.show();
    } catch (string error) {  // headless session or no StatusNotifierWatcher
        print("dlss5-tray: no native tray available (" + error + ").");
        return 0;
    }
    tray.run();
    return 0;
}
