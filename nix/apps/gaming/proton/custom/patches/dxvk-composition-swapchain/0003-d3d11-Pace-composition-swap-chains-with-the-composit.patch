From 4a1ebb980a355f0a4cbe0fac23752aa6f3889590 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Tue, 25 Aug 2026 23:49:17 -0700
Subject: [PATCH 3/8] [d3d11] Pace composition swap chains with the compositor

Composition swap chains are compositor content rather than direct game
output. Applications tend to present such surfaces with a sync interval
of zero, which makes DXVK pick an immediate present mode for the host
window. The desktop compositor then samples whichever frame happens to
be current while it composites the parent window, which shows up as
flicker in transient UI surfaces.

Clamp the sync interval of any swap chain bound to a composition target
to at least one so that presentation is paced by the compositor. This
applies to child host windows and to top-level targets alike, since
both are composited. Unbound composition swap chains and regular
windowed swap chains keep the requested interval.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 src/d3d11/d3d11_swapchain.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index c05a23e..1d6949c 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -434,6 +434,18 @@ namespace dxvk {
 
 
   HRESULT D3D11SwapChain::PresentImage(UINT SyncInterval) {
+    HWND compositionTarget = nullptr;
+
+    {
+      std::lock_guard<dxvk::mutex> lock(m_compositionLock);
+      compositionTarget = m_compositionTarget;
+    }
+
+    // Composition targets are compositor content and
+    // must not bypass the compositor's own pacing
+    if (compositionTarget)
+      SyncInterval = std::max(SyncInterval, 1u);
+
     // Flush pending rendering commands before
     auto immediateContext = m_parent->GetContext();
     auto immediateContextLock = immediateContext->LockContext();
