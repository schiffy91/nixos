From fc77b7515bb8bee466878e1c1ca753b940f65a35 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Tue, 25 Aug 2026 23:51:02 -0700
Subject: [PATCH 7/8] [d3d11] Replay composition content after target binds

Applications can present a composition swap chain before dcomp commits
the visual tree that binds it to a host window, and static surfaces may
never present again afterwards. The bind then leaves DXVK with a fresh
WSI target that nothing populates, and the host window stays black.
The same gap opens when dcomp destroys and recreates a host window
while the application is idle.

Remember whether the application has attempted a present, and when a
target is bound to a swap chain that has, present the most recently
presented frame into the new target right away. The rotation after a
present moves that frame into the last back buffer, so the replay reads
from there and skips the rotation, which leaves the buffer that the
application draws into untouched.

The replay runs on the thread that binds the target, i.e. Wine's dcomp
commit thread, and goes through the regular present path: it flushes
the immediate context in the middle of whatever frame the application
is building, bumps the frame id, and signals the frame latency fence
for that frame. Swap chains with a frame latency waitable object are
left alone, since the extra present would release their semaphore once
more than the application expects.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 src/d3d11/d3d11_swapchain.cpp | 41 +++++++++++++++++++++++++++++------
 src/d3d11/d3d11_swapchain.h   |  5 +++--
 2 files changed, 37 insertions(+), 9 deletions(-)

diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index d017c72..77a006c 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -310,7 +310,7 @@ namespace dxvk {
     }
 
     try {
-      hr = PresentImage(SyncInterval);
+      hr = PresentImage(SyncInterval, false);
     } catch (const DxvkError& e) {
       Logger::err(e.message());
       hr = E_FAIL;
@@ -400,14 +400,17 @@ namespace dxvk {
           HWND                      hTarget,
           HWND                      hDispatch) {
     HWND previousTarget = nullptr;
+    bool replay = false;
 
     {
       std::lock_guard<dxvk::mutex> lock(m_compositionLock);
       previousTarget = std::exchange(m_compositionTarget, hTarget);
       m_compositionChildTarget = hTarget && hTarget != hDispatch;
 
-      if (hTarget != previousTarget)
+      if (hTarget != previousTarget) {
         m_compositionTargetShown = false;
+        replay = hTarget && m_compositionPresented && !m_frameLatencyEvent;
+      }
     }
 
     if (hTarget == previousTarget)
@@ -421,11 +424,29 @@ namespace dxvk {
     m_presenter->destroyResources();
 
     ResizeCompositionTarget(m_desc.Width, m_desc.Height);
+
+    // Applications may not present again after the bind, so
+    // put the last presented frame into the new target now
+    if (replay) {
+      HRESULT hr = S_OK;
+
+      try {
+        hr = PresentImage(1, true);
+      } catch (const DxvkError& e) {
+        Logger::err(e.message());
+        hr = E_FAIL;
+      }
+
+      SyncFrameLatency();
+
+      if (FAILED(hr))
+        Logger::warn(str::format("D3D11SwapChain::SetCompositionTarget: Replay failed, hr = ", hr));
+    }
   }
 
 
-  Rc<DxvkImageView> D3D11SwapChain::GetBackBufferView() {
-    Rc<DxvkImage> image = GetCommonTexture(m_backBuffers[0].ptr())->GetImage();
+  Rc<DxvkImageView> D3D11SwapChain::GetBackBufferView(uint32_t BufferId) {
+    Rc<DxvkImage> image = GetCommonTexture(m_backBuffers[BufferId].ptr())->GetImage();
 
     DxvkImageViewKey key;
     key.viewType = VK_IMAGE_VIEW_TYPE_2D;
@@ -441,17 +462,23 @@ namespace dxvk {
   }
 
 
-  HRESULT D3D11SwapChain::PresentImage(UINT SyncInterval) {
+  HRESULT D3D11SwapChain::PresentImage(UINT SyncInterval, bool Replay) {
     HWND compositionTarget = nullptr;
     bool showCompositionTarget = false;
 
     {
       std::lock_guard<dxvk::mutex> lock(m_compositionLock);
+      m_compositionPresented = true;
       compositionTarget = m_compositionTarget;
       showCompositionTarget = m_compositionChildTarget && !m_compositionTargetShown;
       m_compositionTargetShown |= showCompositionTarget;
     }
 
+    // Replays re-present the last presented frame, which the
+    // rotation below moves to the last back buffer, and leave
+    // the buffer the application draws into alone
+    uint32_t sourceBuffer = Replay ? m_backBuffers.size() - 1u : 0u;
+
 #ifdef _WIN32
     // Child hosts are created hidden and shown once there is a frame
     // to present. The host window belongs to the compositor's thread,
@@ -510,7 +537,7 @@ namespace dxvk {
       cDevice         = m_device,
       cBlitter        = m_blitter,
       cBackBuffer     = backBuffer->createView(viewInfo),
-      cSwapImage      = GetBackBufferView(),
+      cSwapImage      = GetBackBufferView(sourceBuffer),
       cSync           = sync,
       cPresenter      = m_presenter,
       cLatency        = m_latency,
@@ -542,7 +569,7 @@ namespace dxvk {
 
     // Composition clients may only repaint damaged regions
     // of the next frame, so it has to start out as this one
-    if (m_backBuffers.size() > 1u)
+    if (m_backBuffers.size() > 1u && !Replay)
       RotateBackBuffers(immediateContext, compositionTarget != nullptr);
 
     immediateContext->FlushCsChunk();
diff --git a/src/d3d11/d3d11_swapchain.h b/src/d3d11/d3d11_swapchain.h
index 2e5fac2..eeaae91 100644
--- a/src/d3d11/d3d11_swapchain.h
+++ b/src/d3d11/d3d11_swapchain.h
@@ -167,12 +167,13 @@ namespace dxvk {
     HWND                      m_compositionTarget = nullptr;
     bool                      m_compositionChildTarget = false;
     bool                      m_compositionTargetShown = false;
+    bool                      m_compositionPresented = false;
 
     Rc<hud::HudLatencyItem>   m_latencyHud;
 
-    Rc<DxvkImageView> GetBackBufferView();
+    Rc<DxvkImageView> GetBackBufferView(uint32_t BufferId);
 
-    HRESULT PresentImage(UINT SyncInterval);
+    HRESULT PresentImage(UINT SyncInterval, bool Replay);
 
     void RotateBackBuffers(D3D11ImmediateContext* ctx, bool preserveContents);
 
-- 
