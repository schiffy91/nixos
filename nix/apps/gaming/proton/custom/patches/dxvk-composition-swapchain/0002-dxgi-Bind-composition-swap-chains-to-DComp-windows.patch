diff --git a/src/dxgi/dxgi_interfaces.h b/src/dxgi/dxgi_interfaces.h
index 0eaf992b..39bf472b 100644
--- a/src/dxgi/dxgi_interfaces.h
+++ b/src/dxgi/dxgi_interfaces.h
@@ -62,6 +62,9 @@ IDXGIVkSurfaceFactory : public IUnknown {
           VkInstance                Instance,
           VkPhysicalDevice          Adapter,
           VkSurfaceKHR*             pSurface) = 0;
+
+  virtual void STDMETHODCALLTYPE SetWindow(
+          HWND                      hWnd) = 0;
 };
 
 
@@ -154,6 +157,29 @@ IDXGIVkSwapChain3 : public IDXGIVkSwapChain2 {
 };
 
 
+/**
+ * \brief Private composition swap chain interface
+ *
+ * Exposed by swap chains created for DirectComposition.
+ * Wine's dcomp implementation uses it to bind the swap
+ * chain to the window that hosts its visual, so that
+ * DXVK presents through its regular WSI path.
+ *
+ * The target is the window to present to, the dispatch
+ * window is the top-level window that owns the visual
+ * tree. Both are equal if the swap chain covers that
+ * window itself. A null target unbinds the swap chain.
+ *
+ * The IID and vtable layout are shared with Wine.
+ */
+MIDL_INTERFACE("4765d18a-eba0-40bd-a730-7f5f3d915c1f")
+IDXGIVkCompositionSwapChain : public IUnknown {
+  virtual void STDMETHODCALLTYPE SetCompositionTarget(
+          HWND                      hTarget,
+          HWND                      hDispatch) = 0;
+};
+
+
 /**
  * \brief Private DXGI presenter factory
  */
@@ -491,4 +517,5 @@ __CRT_UUID_DECL(IDXGIVkSwapChain1,         0x785326d4,0xb77b,0x4826,0xae,0x70,0x
 __CRT_UUID_DECL(IDXGIVkSwapChain2,         0xaed91093,0xe02e,0x458c,0xbd,0xef,0xa9,0x7d,0xa1,0xa7,0xe6,0xd2);
 __CRT_UUID_DECL(IDXGIVkSwapChain3,         0xfa25651a,0xae62,0x4ddd,0x90,0x86,0x29,0xea,0x31,0x44,0x82,0x0a);
 __CRT_UUID_DECL(IDXGIVkSwapChainFactory,   0xe7d6c3ca,0x23a0,0x4e08,0x9f,0x2f,0xea,0x52,0x31,0xdf,0x66,0x33);
+__CRT_UUID_DECL(IDXGIVkCompositionSwapChain, 0x4765d18a,0xeba0,0x40bd,0xa7,0x30,0x7f,0x5f,0x3d,0x91,0x5c,0x1f);
 #endif
