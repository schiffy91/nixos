diff --git a/dxvk.conf b/dxvk.conf
index 1c58703a..d6203df4 100644
--- a/dxvk.conf
+++ b/dxvk.conf
@@ -18,15 +18,16 @@
 # dxgi.enableHDR = True
 
 
-# Expose support for dcomp swap chains with a dummy window.
+# Expose support for DirectComposition swap chains.
 #
-# This is not a valid implementation of DirectComposition swapchains,
-# however some games may rely on this functionality to be present while
-# others may require swap chain creation to fail.
+# Composition swap chains present to a hidden dummy window until the
+# DirectComposition implementation binds them to the window that hosts
+# their visual. Some games rely on this functionality to be present
+# while others may require swap chain creation to fail.
 #
 # Supported values: True, False
 
-# dxgi.enableDummyCompositionSwapchain = False
+# dxgi.enableDummyCompositionSwapchain = True
 
 
 # Allows the Vulkan driver to opt-in to exclusive full-screen mode on
diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index 40d264d8..43da54c9 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -59,12 +59,44 @@ namespace dxvk {
   }
 
 
+  D3D11CompositionSwapChain::D3D11CompositionSwapChain(
+          D3D11SwapChain*           pParent)
+  : m_parent(pParent) {
+
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D11CompositionSwapChain::QueryInterface(
+          REFIID                    riid,
+          void**                    ppvObject) {
+    return m_parent->QueryInterface(riid, ppvObject);
+  }
+
+
+  ULONG STDMETHODCALLTYPE D3D11CompositionSwapChain::AddRef() {
+    return m_parent->AddRef();
+  }
+
+
+  ULONG STDMETHODCALLTYPE D3D11CompositionSwapChain::Release() {
+    return m_parent->Release();
+  }
+
+
+  void STDMETHODCALLTYPE D3D11CompositionSwapChain::SetCompositionTarget(
+          HWND                      hTarget,
+          HWND                      hDispatch) {
+    m_parent->SetCompositionTarget(hTarget, hDispatch);
+  }
+
+
   D3D11SwapChain::D3D11SwapChain(
           D3D11DXGIDevice*        pContainer,
           D3D11Device*            pDevice,
           IDXGIVkSurfaceFactory*  pSurfaceFactory,
     const DXGI_SWAP_CHAIN_DESC1*  pDesc)
   : m_dxgiDevice(pContainer),
+    m_composition(this),
     m_parent(pDevice),
     m_surfaceFactory(pSurfaceFactory),
     m_desc(*pDesc),
@@ -107,6 +139,11 @@ namespace dxvk {
       return S_OK;
     }
 
+    if (riid == __uuidof(IDXGIVkCompositionSwapChain)) {
+      *ppvObject = ref(&m_composition);
+      return S_OK;
+    }
+
     if (logQueryInterfaceError(__uuidof(IDXGIVkSwapChain), riid)) {
       Logger::warn("D3D11SwapChain::QueryInterface: Unknown interface query");
       Logger::warn(str::format(riid));
@@ -383,6 +420,28 @@ namespace dxvk {
   }
 
 
+  void D3D11SwapChain::SetCompositionTarget(
+          HWND                      hTarget,
+          HWND                      hDispatch) {
+    HWND previousTarget = nullptr;
+
+    {
+      std::lock_guard<dxvk::mutex> lock(m_compositionLock);
+      previousTarget = std::exchange(m_compositionTarget, hTarget);
+    }
+
+    if (hTarget == previousTarget)
+      return;
+
+    // Retarget the surface factory before destroying the current
+    // surface so that a concurrent acquire cannot recreate it on
+    // the old window. The presenter recreates its resources on
+    // the new window during the next present.
+    m_surfaceFactory->SetWindow(hTarget);
+    m_presenter->destroyResources();
+  }
+
+
   Rc<DxvkImageView> D3D11SwapChain::GetBackBufferView() {
     Rc<DxvkImage> image = GetCommonTexture(m_backBuffers[0].ptr())->GetImage();
 
