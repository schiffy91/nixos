-    if (m_ownsWindow)
+    if (m_dummyWindow)
       DestroyDummyWindow();
   }
 
@@ -44,10 +44,21 @@ namespace dxvk {
           VkInstance                Instance,
           VkPhysicalDevice          Adapter,
           VkSurfaceKHR*             pSurface) {
+    std::lock_guard<dxvk::mutex> lock(m_mutex);
+
     return wsi::createSurface(m_window, m_vkGetInstanceProcAddr, Instance, pSurface);
   }
 
 
+  void STDMETHODCALLTYPE DxgiSurfaceFactory::SetWindow(
+          HWND                      hWnd) {
+    std::lock_guard<dxvk::mutex> lock(m_mutex);
+
+    // Present to the dummy window again while unbound
+    m_window = hWnd ? hWnd : m_dummyWindow;
+  }
+
+
   HWND DxgiSurfaceFactory::CreateDummyWindow() {
 #ifdef _WIN32
     static std::atomic<bool> s_wndClassRegistered = { false };
@@ -85,7 +96,7 @@ namespace dxvk {
 
   void DxgiSurfaceFactory::DestroyDummyWindow() {
 #ifdef _WIN32
-    DestroyWindow(m_window);
+    DestroyWindow(m_dummyWindow);
 #endif
   }
 
