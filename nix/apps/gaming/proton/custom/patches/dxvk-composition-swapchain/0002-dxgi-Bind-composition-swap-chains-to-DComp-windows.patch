+/**
+ * \brief Private composition swap chain interface
+ *
+ * Exposed by swap chains created for DirectComposition.
+ * Wine's dcomp implementation uses it to bind the swap
+ * chain to the window that hosts its visual, so that
+ * DXVK presents through its regular WSI path.
+ *
+ * The target is the window to present to, the dispatch
+ * window is the top-level window that owns the visual
+ * tree. Both are equal if the swap chain covers that
+ * window itself. A null target unbinds the swap chain.
+ *
+ * The IID and vtable layout are shared with Wine.
+ */
+MIDL_INTERFACE("4765d18a-eba0-40bd-a730-7f5f3d915c1f")
+IDXGIVkCompositionSwapChain : public IUnknown {
+  virtual void STDMETHODCALLTYPE SetCompositionTarget(
+          HWND                      hTarget,
+          HWND                      hDispatch) = 0;
+};
+
