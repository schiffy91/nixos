+
+    ULONG STDMETHODCALLTYPE AddRef();
+
+    ULONG STDMETHODCALLTYPE Release();
+
+    void STDMETHODCALLTYPE SetCompositionTarget(
+            HWND                      hTarget,
+            HWND                      hDispatch);
+
+  private:
+
+    D3D11SwapChain* m_parent;
+
+  };
 
   class D3D11SwapChain : public ComObject<IDXGIVkSwapChain3> {
     constexpr static uint32_t DefaultFrameLatency = 1;
@@ -95,6 +128,9 @@ namespace dxvk {
 
     HRESULT STDMETHODCALLTYPE SetRotation(
             DXGI_MODE_ROTATION        Rotation);
+    void SetCompositionTarget(
+            HWND                      hTarget,
+            HWND                      hDispatch);
 
   private:
 
@@ -113,6 +149,7 @@ namespace dxvk {
     };
 
     Com<D3D11DXGIDevice, false> m_dxgiDevice;
+    D3D11CompositionSwapChain m_composition;
     
     D3D11Device*              m_parent;
     Com<IDXGIVkSurfaceFactory> m_surfaceFactory;
@@ -148,6 +185,9 @@ namespace dxvk {
     DXGI_VK_FRAME_STATISTICS  m_frameStatistics = { };
 
     bool                      m_hasHud = false;
+    dxvk::mutex               m_compositionLock;
+    HWND                      m_compositionTarget = nullptr;
+
     Rc<hud::HudLatencyItem>   m_latencyHud;
 
     Rc<DxvkImageView> GetBackBufferView();
diff --git a/src/dxgi/dxgi_factory.cpp b/src/dxgi/dxgi_factory.cpp
index d89409ee..2c7fc220 100644
--- a/src/dxgi/dxgi_factory.cpp
+++ b/src/dxgi/dxgi_factory.cpp
@@ -287,11 +287,11 @@ namespace dxvk {
     InitReturnPtr(ppSwapChain);
 
     if (!m_options->enableDummyCompositionSwapchain) {
-      Logger::err("DxgiFactory::CreateSwapChainForComposition: Not implemented");
+      Logger::warn("DxgiFactory::CreateSwapChainForComposition: Disabled by configuration");
       return E_NOTIMPL;
     }
 
