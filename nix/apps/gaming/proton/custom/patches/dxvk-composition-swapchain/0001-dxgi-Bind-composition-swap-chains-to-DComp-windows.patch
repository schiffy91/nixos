+/**
+ * \brief Private DXGI composition swap chain interface
+ *
+ * Lets Wine's DirectComposition implementation bind a composition swap chain
+ * to the window that owns the visual tree. DXVK can then present the swap
+ * chain through its regular WSI path.
+ */
+MIDL_INTERFACE("4765d18a-eba0-40bd-a730-7f5f3d915c1f")
+IDXGIVkCompositionSwapChain : public IUnknown {
+  virtual void STDMETHODCALLTYPE SetCompositionTarget(
+          HWND                      hTarget,
+          HWND                      hDispatch) = 0;
+};
