     return wsi::createSurface(m_window, m_vkGetInstanceProcAddr, Instance, pSurface);
   }
 
 
+  void STDMETHODCALLTYPE DxgiSurfaceFactory::SetWindow(
+          HWND                    hWnd) {
+    std::lock_guard<dxvk::mutex> lock(m_mutex);
+
+    if (m_window == hWnd && !m_ownsWindow)
+      return;
+
+    if (m_ownsWindow)
+      DestroyDummyWindow();
+
+    m_window = hWnd;
+    m_ownsWindow = !m_window;
+
+    if (!m_window)
+      m_window = CreateDummyWindow();
+  }
+
