From 5d739d8690064be406cf4ab96f44005038377609 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Tue, 25 Aug 2026 23:50:00 -0700
Subject: [PATCH] [d3d11] Preserve composition swap chain contents

Composition swap chains still rotate their back buffers so that
GetBuffer(0) keeps returning the writable buffer that flip-model
clients expect. Some composition clients only repaint the damaged
regions of a frame, though, so the buffer that becomes writable after a
present has to start out with the contents of the frame just presented,
or stale regions from older frames flicker through.

Copy the presented image into the newly exposed back buffer after the
rotation whenever the swap chain is bound to a composition target. This
keeps the previous frame without pinning the swap chain to a single
buffer. Unbound composition swap chains and regular swap chains are not
affected.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 src/d3d11/d3d11_swapchain.cpp | 19 ++++++++++++++++---
 src/d3d11/d3d11_swapchain.h   |  2 +-
 2 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index 119b8cae..2a15ae98 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -600,8 +600,10 @@ namespace dxvk {
         cDirtyRects.size(), cDirtyRects.data(), nullptr);
     });
 
+    // Composition clients may only repaint damaged regions
+    // of the next frame, so it has to start out as this one
     if (m_backBuffers.size() > 1u)
-      RotateBackBuffers(immediateContext);
+      RotateBackBuffers(immediateContext, compositionTarget != nullptr);
 
     immediateContext->FlushCsChunk();
 
@@ -622,14 +624,15 @@ namespace dxvk {
   }
 
 
-  void D3D11SwapChain::RotateBackBuffers(D3D11ImmediateContext* ctx) {
+  void D3D11SwapChain::RotateBackBuffers(D3D11ImmediateContext* ctx, bool preserveContents) {
     small_vector<Rc<DxvkImage>, 4> images;
 
     for (uint32_t i = 0; i < m_backBuffers.size(); i++)
       images.push_back(GetCommonTexture(m_backBuffers[i].ptr())->GetImage());
 
     ctx->EmitCs([
-      cImages = std::move(images)
+      cImages = std::move(images),
+      cPreserveContents = preserveContents
     ] (DxvkContext* ctx) {
       auto allocation = cImages[0]->storage();
 
@@ -640,6 +643,16 @@ namespace dxvk {
 
       ctx->invalidateImage(cImages[cImages.size() - 1u],
         std::move(allocation), cImages[0]->info().layout);
+
+      // The presented frame now lives in the last image
+      if (cPreserveContents) {
+        VkImageSubresourceLayers layers = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+
+        ctx->copyImage(
+          cImages[0], layers, VkOffset3D { 0, 0, 0 },
+          cImages[cImages.size() - 1u], layers, VkOffset3D { 0, 0, 0 },
+          cImages[0]->mipLevelExtent(0));
+      }
     });
   }
 
diff --git a/src/d3d11/d3d11_swapchain.h b/src/d3d11/d3d11_swapchain.h
index 1ee42ead..70cee444 100644
--- a/src/d3d11/d3d11_swapchain.h
+++ b/src/d3d11/d3d11_swapchain.h
@@ -197,7 +197,7 @@ namespace dxvk {
             UINT                      SyncInterval,
       const DXGI_PRESENT_PARAMETERS*  pPresentParameters);
 
-    void RotateBackBuffers(D3D11ImmediateContext* ctx);
+    void RotateBackBuffers(D3D11ImmediateContext* ctx, bool preserveContents);
 
     void ResizeCompositionTarget(
             UINT                      Width,
