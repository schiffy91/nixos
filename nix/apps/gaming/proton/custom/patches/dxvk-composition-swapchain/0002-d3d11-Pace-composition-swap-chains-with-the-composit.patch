From 463355fa38833e6899976ec921cd309e29038e69 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Thu, 21 May 2026 12:06:31 -0700
Subject: [PATCH 02/11] d3d11: Pace composition swap chains with the compositor

DirectComposition child-host swap chains are desktop-compositor content, not
direct game surfaces. Chromium/CEF often presents those transient surfaces
with sync interval zero, which makes DXVK select immediate presentation for
the Wayland child surface. That can expose intermediate frames while the
desktop compositor is also compositing the parent Wine window, showing up as
transient flicker in Battle.net's launcher.

Keep normal game and root-window swap chains on the application's requested
interval, but make swap chains bound to child presentation hosts through the
private composition interface use compositor-paced presentation.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Signed-off-by: Alexander Schiffhauer <Alexander.Schiffhauer@gmail.com>
---
 src/d3d11/d3d11_swapchain.cpp | 11 ++++++++++-
 src/d3d11/d3d11_swapchain.h   |  2 ++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index e0ec3cb..d8056e4 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -426,6 +426,15 @@ namespace dxvk {
     Logger::debug("D3D11SwapChain::SetCompositionTarget: bound composition target");
   }
 
+  UINT D3D11SwapChain::GetCompositionSyncInterval(UINT SyncInterval) {
+    std::lock_guard<dxvk::mutex> lock(m_compositionLock);
+
+    if (m_compositionChildTarget && !SyncInterval)
+      return 1;
+
+    return SyncInterval;
+  }
+
 
   Rc<DxvkImageView> D3D11SwapChain::GetBackBufferView() {
     Rc<DxvkImage> image = GetCommonTexture(m_backBuffers[0].ptr())->GetImage();
@@ -452,7 +461,7 @@ namespace dxvk {
     immediateContext->EndFrame(m_latency);
     immediateContext->ExecuteFlush(GpuFlushType::ExplicitFlush, nullptr, true);
 
-    m_presenter->setSyncInterval(SyncInterval);
+    m_presenter->setSyncInterval(GetCompositionSyncInterval(SyncInterval));
 
     // Presentation semaphores and WSI swap chain image
     if (m_latency)
diff --git a/src/d3d11/d3d11_swapchain.h b/src/d3d11/d3d11_swapchain.h
index 715c286..c3e1bad 100644
--- a/src/d3d11/d3d11_swapchain.h
+++ b/src/d3d11/d3d11_swapchain.h
@@ -160,6 +160,8 @@ namespace dxvk {
 
     Rc<DxvkImageView> GetBackBufferView();
 
+    UINT GetCompositionSyncInterval(UINT SyncInterval);
+
     HRESULT PresentImage(UINT SyncInterval);
 
     void RotateBackBuffers(D3D11ImmediateContext* ctx);
