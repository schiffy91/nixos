From 5cc7d02db185c29d57402edc4a8fc37b54b1aaf2 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Wed, 26 Aug 2026 00:18:52 -0700
Subject: [PATCH] dcomp: Avoid redundant composition host updates.

The Wayland presentation host window only needs a Win32 region update when
the corresponding DirectComposition clip changes, and a swap chain only needs
to be retargeted when its host changes. Reapplying the same SetWindowRgn()
and SetCompositionTarget() state on every commit causes unnecessary
child-surface reconfiguration and presenter churn, which shows up as small
flickers in Chromium UI panels.

Cache the last applied clip region on the visual and the window a swap chain
was last bound to, and skip updates that would not change anything.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 46 +++++++++++++++++++++++++++++++++++----------
 1 file changed, 36 insertions(+), 10 deletions(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index 54f8c270d0e..b912a3ce1f8 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -123,6 +123,11 @@ struct dcomp_visual
     HWND host_below;
     int host_x, host_y;
     UINT host_width, host_height;
+    BOOL host_clip_valid;
+    BOOL host_has_region;
+    RECT host_clip;
+    HWND bound_target;
+    HWND bound_dispatch;
 };
 
 struct dcomp_target
@@ -602,15 +607,22 @@ static void dcomp_visual_unbind_content(struct dcomp_visual *visual)
     {
         dcomp_surface_unbind_swapchain(visual->surface);
     }
-    else if (visual->swapchain)
+    else if (visual->swapchain && visual->bound_target)
     {
         dcomp_swapchain_set_target(visual->swapchain, NULL, NULL);
+        visual->bound_target = NULL;
+        visual->bound_dispatch = NULL;
     }
 }
 
 static void dcomp_visual_bind_swapchain(struct dcomp_visual *visual, HWND target, HWND dispatch)
 {
+    if (visual->bound_target == target && visual->bound_dispatch == dispatch)
+        return;
+
     dcomp_swapchain_set_target(visual->swapchain, target, dispatch);
+    visual->bound_target = target;
+    visual->bound_dispatch = dispatch;
 }
 
 static void dcomp_visual_reset_host_state(struct dcomp_visual *visual)
@@ -621,6 +633,9 @@ static void dcomp_visual_reset_host_state(struct dcomp_visual *visual)
     visual->host_y = 0;
     visual->host_width = 0;
     visual->host_height = 0;
+    visual->host_clip_valid = FALSE;
+    visual->host_has_region = FALSE;
+    SetRectEmpty(&visual->host_clip);
 }
 
 static void dcomp_visual_teardown_host(struct dcomp_visual *visual)
@@ -1224,7 +1239,7 @@ static BOOL dcomp_visual_update_host(struct dcomp_commit *commit, struct dcomp_v
         const struct dcomp_placement *placement, UINT width, UINT height)
 {
     HWND target_hwnd = commit->target->hwnd;
-    BOOL created = FALSE, moved, restack, need_region;
+    BOOL created = FALSE, moved, restack, need_region, changed;
     HRGN region = NULL;
     UINT flags;
     RECT clip;
@@ -1287,15 +1302,26 @@ static BOOL dcomp_visual_update_host(struct dcomp_commit *commit, struct dcomp_v
     commit->host_below = visual->host_hwnd;
 
     need_region = clip.left || clip.top || clip.right != (LONG)width || clip.bottom != (LONG)height;
-    if (need_region && !(region = CreateRectRgnIndirect(&clip)))
-    {
-        WARN("Failed to create clip region %s.\n", wine_dbgstr_rect(&clip));
-    }
-    else if (!SetWindowRgn(visual->host_hwnd, region, TRUE))
+    changed = !visual->host_clip_valid || visual->host_has_region != need_region
+            || !EqualRect(&visual->host_clip, &clip);
+    if (changed)
     {
-        WARN("Failed to set clip region %s on host window %p.\n", wine_dbgstr_rect(&clip), visual->host_hwnd);
-        if (region)
-            DeleteObject(region);
+        if (need_region && !(region = CreateRectRgnIndirect(&clip)))
+        {
+            WARN("Failed to create clip region %s.\n", wine_dbgstr_rect(&clip));
+        }
+        else if (!SetWindowRgn(visual->host_hwnd, region, TRUE))
+        {
+            WARN("Failed to set clip region %s on host window %p.\n", wine_dbgstr_rect(&clip), visual->host_hwnd);
+            if (region)
+                DeleteObject(region);
+        }
+        else
+        {
+            visual->host_clip = clip;
+            visual->host_clip_valid = TRUE;
+            visual->host_has_region = need_region;
+        }
     }
 
     return TRUE;
