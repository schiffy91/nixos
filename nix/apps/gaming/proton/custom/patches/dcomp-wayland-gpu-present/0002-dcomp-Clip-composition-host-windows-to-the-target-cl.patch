From 3903b457a25d8e39f397328911f99de48b74640c Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Wed, 26 Aug 2026 00:18:52 -0700
Subject: [PATCH] dcomp: Clip composition host windows to the target client
 area.

A host window outside the client area of its target is never visible.
Shrink hosts to the part of the visual that intersects the client area and
do not create hosts for visuals that fall entirely outside of it.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index d08909d6292..a122483bda5 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -966,7 +966,7 @@ static BOOL dcomp_visual_swapchain_desc(const struct dcomp_visual *visual, DXGI_
     return visual->swapchain && SUCCEEDED(IDXGISwapChain1_GetDesc1(visual->swapchain, desc));
 }
 
-static BOOL dcomp_visual_host_rect(const struct dcomp_placement *placement,
+static BOOL dcomp_visual_host_rect(HWND hwnd, const struct dcomp_placement *placement,
         const struct dcomp_visual *visual, UINT width, UINT height, RECT *rect)
 {
     RECT clip;
@@ -982,6 +982,9 @@ static BOOL dcomp_visual_host_rect(const struct dcomp_placement *placement,
             return FALSE;
     }
 
+    if (GetClientRect(hwnd, &clip) && !IntersectRect(rect, rect, &clip))
+        return FALSE;
+
     return TRUE;
 }
 
@@ -991,7 +994,7 @@ static BOOL dcomp_visual_update_host(struct dcomp_target *target, struct dcomp_v
     HWND target_hwnd = target->hwnd;
     RECT rect;
 
-    if (!width || !height || !dcomp_visual_host_rect(placement, visual, width, height, &rect))
+    if (!width || !height || !dcomp_visual_host_rect(target_hwnd, placement, visual, width, height, &rect))
     {
         TRACE("Visual %p has no visible area on target %p.\n", visual, target_hwnd);
         dcomp_visual_teardown_host(visual);
