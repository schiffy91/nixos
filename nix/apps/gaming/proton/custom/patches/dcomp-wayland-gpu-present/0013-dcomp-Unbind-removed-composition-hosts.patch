From ee5a94442989271f9af84971ee9b7295a0eb3a9d Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Wed, 26 Aug 2026 00:18:52 -0700
Subject: [PATCH 13/19] dcomp: Unbind removed composition hosts.

Visuals removed from the tree kept their host windows and their DXVK
binding, so stale host windows remained visible after Chromium removed popup
or control visuals. Tearing hosts down from RemoveVisual() is not an option
either: Chromium rebuilds the tree with RemoveAllVisuals() and AddVisual()
every frame, and recreating every host each time flickers.

Mark the visuals reached from a target on every commit and tear down the
hosts of visuals that were not reached. Visuals presenting content are
tracked by the device for that purpose. Host windows belong to the
committing thread, so a visual released on another thread hands its window
to the next commit instead of destroying it.

Host every non-root swap-chain visual so child composition swap chains do
not fight the root swap chain for the same target window.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 112 ++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 102 insertions(+), 10 deletions(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index f1f03e3..a0dda55 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -63,7 +63,10 @@ static const WCHAR dcomp_host_class_name[] = L"WineDCompositionHost";
 static HINSTANCE dcomp_instance;
 
 /* Visuals, surfaces, surface factories and targets hold a reference on the
- * device. Targets are listed by the device while they exist. */
+ * device. Targets are listed by the device while they exist. Visuals that
+ * present content are listed by the device until a commit no longer reaches
+ * them from a target, which is when their host windows are destroyed. Host
+ * windows are created and destroyed on the committing thread only. */
 
 struct dcomp_device
 {
@@ -74,6 +77,9 @@ struct dcomp_device
     IUnknown *rendering_device;
     ID3D11Device *d3d11_device;
     struct list targets;
+    struct list hosts;
+    struct list orphaned_hosts;
+    unsigned int generation;
     LARGE_INTEGER last_frame_time;
 };
 
@@ -127,6 +133,9 @@ struct dcomp_visual
     struct list children;
     struct list child_entry;
 
+    unsigned int generation;
+    BOOL hosted;
+    struct list host_entry;
     HWND host_hwnd;
     HWND host_parent;
     HWND host_below;
@@ -151,6 +160,12 @@ struct dcomp_target
     struct dcomp_visual *root;
 };
 
+struct dcomp_orphaned_host
+{
+    struct list entry;
+    HWND hwnd;
+};
+
 /* Accumulated state of the ancestors of a visual, in target coordinates. */
 struct dcomp_placement
 {
@@ -268,6 +283,33 @@ static HRESULT dcomp_swapchain_set_target(IDXGISwapChain1 *swapchain, HWND targe
     return S_OK;
 }
 
+static void dcomp_device_orphan_host(struct dcomp_device *device, HWND hwnd)
+{
+    struct dcomp_orphaned_host *orphan;
+
+    if (!(orphan = malloc(sizeof(*orphan))))
+    {
+        DestroyWindow(hwnd);
+        return;
+    }
+
+    orphan->hwnd = hwnd;
+    list_add_tail(&device->orphaned_hosts, &orphan->entry);
+}
+
+static void dcomp_device_destroy_orphaned_hosts(struct dcomp_device *device)
+{
+    struct dcomp_orphaned_host *orphan, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(orphan, next, &device->orphaned_hosts, struct dcomp_orphaned_host, entry)
+    {
+        list_remove(&orphan->entry);
+        if (!DestroyWindow(orphan->hwnd))
+            WARN("Failed to destroy host window %p, error %lu.\n", orphan->hwnd, GetLastError());
+        free(orphan);
+    }
+}
+
 static void dcomp_surface_unbind_swapchain(struct dcomp_surface *surface)
 {
     if (!surface->target_hwnd)
@@ -774,16 +816,35 @@ static void dcomp_visual_reset_host_state(struct dcomp_visual *visual)
     SetRectEmpty(&visual->host_clip);
 }
 
-static void dcomp_visual_teardown_host(struct dcomp_visual *visual)
+/* Only the committing thread owns host windows; releasing a visual on another
+ * thread leaves the window to the next commit. */
+static void dcomp_visual_teardown_host(struct dcomp_visual *visual, BOOL defer)
 {
     if (visual->host_hwnd)
     {
         TRACE("Destroying host window %p of visual %p.\n", visual->host_hwnd, visual);
-        if (!DestroyWindow(visual->host_hwnd))
+        if (defer)
+            dcomp_device_orphan_host(visual->device, visual->host_hwnd);
+        else if (!DestroyWindow(visual->host_hwnd))
             WARN("Failed to destroy host window %p, error %lu.\n", visual->host_hwnd, GetLastError());
         visual->host_hwnd = NULL;
     }
     dcomp_visual_reset_host_state(visual);
+
+    if (visual->hosted)
+    {
+        list_remove(&visual->host_entry);
+        visual->hosted = FALSE;
+    }
+}
+
+static void dcomp_visual_track_host(struct dcomp_visual *visual)
+{
+    if (visual->hosted)
+        return;
+
+    list_add_tail(&visual->device->hosts, &visual->host_entry);
+    visual->hosted = TRUE;
 }
 
 static void dcomp_visual_unlink(struct dcomp_visual *visual)
@@ -839,7 +900,7 @@ static ULONG WINAPI visual_Release(IDCompositionVisual2 *iface)
             IDCompositionVisual2_Release(&child->IDCompositionVisual2_iface);
         }
         dcomp_visual_unbind_content(visual);
-        dcomp_visual_teardown_host(visual);
+        dcomp_visual_teardown_host(visual, TRUE);
         LeaveCriticalSection(&device->cs);
 
         if (visual->swapchain)
@@ -1343,7 +1404,7 @@ static BOOL dcomp_visual_needs_host(const struct dcomp_visual *visual, const str
         return TRUE;
     if (!dcomp_matrix_is_translation(&visual->transform))
         return TRUE;
-    return visual->parent && visual->parent->parent;
+    return !!visual->parent;
 }
 
 static BOOL dcomp_visual_host_clip(HWND hwnd, const struct dcomp_placement *placement,
@@ -1383,12 +1444,12 @@ static BOOL dcomp_visual_update_host(struct dcomp_commit *commit, struct dcomp_v
     if (!width || !height || !dcomp_visual_host_clip(target_hwnd, placement, width, height, &clip))
     {
         TRACE("Visual %p has no visible area on target %p.\n", visual, target_hwnd);
-        dcomp_visual_teardown_host(visual);
+        dcomp_visual_teardown_host(visual, FALSE);
         return FALSE;
     }
 
     if (visual->host_hwnd && visual->host_parent != target_hwnd)
-        dcomp_visual_teardown_host(visual);
+        dcomp_visual_teardown_host(visual, FALSE);
 
     if (!visual->host_hwnd)
     {
@@ -1460,6 +1521,7 @@ static BOOL dcomp_visual_update_host(struct dcomp_commit *commit, struct dcomp_v
         }
     }
 
+    dcomp_visual_track_host(visual);
     return TRUE;
 }
 
@@ -1471,6 +1533,15 @@ static void dcomp_visual_present_surface(struct dcomp_visual *visual, HWND dispa
         WARN("Failed to present surface %p of visual %p.\n", surface, visual);
 }
 
+static void dcomp_visual_mark(struct dcomp_visual *visual, unsigned int generation)
+{
+    struct dcomp_visual *child;
+
+    visual->generation = generation;
+    LIST_FOR_EACH_ENTRY(child, &visual->children, struct dcomp_visual, child_entry)
+        dcomp_visual_mark(child, generation);
+}
+
 static void dcomp_visual_bind(struct dcomp_commit *commit, struct dcomp_visual *visual,
         const struct dcomp_placement *parent_placement)
 {
@@ -1488,8 +1559,8 @@ static void dcomp_visual_bind(struct dcomp_commit *commit, struct dcomp_visual *
 
     if (!visual->surface && !visual->swapchain)
     {
-        if (visual->host_hwnd)
-            dcomp_visual_teardown_host(visual);
+        if (visual->hosted)
+            dcomp_visual_teardown_host(visual, FALSE);
     }
     else if (dcomp_visual_needs_host(visual, &placement))
     {
@@ -1506,8 +1577,9 @@ static void dcomp_visual_bind(struct dcomp_commit *commit, struct dcomp_visual *
     else
     {
         if (visual->host_hwnd)
-            dcomp_visual_teardown_host(visual);
+            dcomp_visual_teardown_host(visual, FALSE);
         dcomp_visual_bind_swapchain(visual, target->hwnd, target->hwnd);
+        dcomp_visual_track_host(visual);
     }
 
     LIST_FOR_EACH_ENTRY(child, &visual->children, struct dcomp_visual, child_entry)
@@ -1551,6 +1623,7 @@ static ULONG WINAPI device_Release(IDCompositionDesktopDevice *iface)
 
     if (!refcount)
     {
+        dcomp_device_destroy_orphaned_hosts(device);
         DeleteCriticalSection(&device->cs);
         if (device->d3d11_device)
             ID3D11Device_Release(device->d3d11_device);
@@ -1565,12 +1638,29 @@ static ULONG WINAPI device_Release(IDCompositionDesktopDevice *iface)
 static HRESULT WINAPI device_Commit(IDCompositionDesktopDevice *iface)
 {
     struct dcomp_device *device = impl_from_IDCompositionDesktopDevice(iface);
+    struct dcomp_visual *visual, *next;
     struct dcomp_target *target;
 
     TRACE("iface %p.\n", iface);
 
     EnterCriticalSection(&device->cs);
 
+    dcomp_device_destroy_orphaned_hosts(device);
+
+    /* Visuals no commit reaches any more stop presenting before anything else
+     * takes over their windows. */
+    ++device->generation;
+    LIST_FOR_EACH_ENTRY(target, &device->targets, struct dcomp_target, entry)
+    {
+        if (target->root)
+            dcomp_visual_mark(target->root, device->generation);
+    }
+    LIST_FOR_EACH_ENTRY_SAFE(visual, next, &device->hosts, struct dcomp_visual, host_entry)
+    {
+        if (visual->generation != device->generation)
+            dcomp_visual_teardown_host(visual, FALSE);
+    }
+
     LIST_FOR_EACH_ENTRY(target, &device->targets, struct dcomp_target, entry)
     {
         struct dcomp_placement placement = {0};
@@ -1878,6 +1968,8 @@ static HRESULT dcomp_device_create(IUnknown *rendering_device, REFIID iid, void
     device->refcount = 1;
     InitializeCriticalSection(&device->cs);
     list_init(&device->targets);
+    list_init(&device->hosts);
+    list_init(&device->orphaned_hosts);
 
     if (rendering_device)
     {
-- 
2.55.0

