From 0ea526064c2df7031573ea8f15749a333196c715 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Wed, 26 Aug 2026 00:18:52 -0700
Subject: [PATCH] dcomp: Present IDCompositionSurface content.

Chromium DirectComposition clients draw popup, tooltip and form-control
content into IDCompositionSurface objects. The Wayland GPU path already
binds swap-chain visuals to presentation child windows, but surfaces only
accepted BeginDraw/EndDraw and never reached a presenter.

Create a composition swap chain for each drawn surface, copy the finished
texture to the swap-chain back buffer on commit, and bind that swap chain
to the visual host window through the same DXVK composition target
interface used for swap-chain visuals.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 164 ++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 160 insertions(+), 4 deletions(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index da928775576..a8d6e9f200d 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -90,6 +90,11 @@ struct dcomp_surface
     BOOL in_draw;
     BOOL suspended;
     BOOL dirty;
+
+    IDXGISwapChain1 *swapchain;
+    UINT swapchain_width, swapchain_height;
+    HWND target_hwnd;
+    HWND dispatch_hwnd;
 };
 
 struct dcomp_visual
@@ -100,6 +105,7 @@ struct dcomp_visual
 
     IUnknown *content;
     IDXGISwapChain1 *swapchain;
+    struct dcomp_surface *surface;
     float offset_x, offset_y;
     D2D_MATRIX_3X2_F transform;
     BOOL has_clip;
@@ -145,6 +151,7 @@ struct dcomp_commit
 };
 
 static const IDCompositionVisual2Vtbl dcomp_visual_vtbl;
+static const IDCompositionSurfaceVtbl dcomp_surface_vtbl;
 
 static inline struct dcomp_device *impl_from_IDCompositionDesktopDevice(IDCompositionDesktopDevice *iface)
 {
@@ -239,6 +246,118 @@ static HRESULT dcomp_swapchain_set_target(IDXGISwapChain1 *swapchain, HWND targe
     return S_OK;
 }
 
+static void dcomp_surface_unbind_swapchain(struct dcomp_surface *surface)
+{
+    if (!surface->target_hwnd)
+        return;
+
+    dcomp_swapchain_set_target(surface->swapchain, NULL, NULL);
+    surface->target_hwnd = NULL;
+    surface->dispatch_hwnd = NULL;
+}
+
+static void dcomp_surface_reset_swapchain(struct dcomp_surface *surface)
+{
+    dcomp_surface_unbind_swapchain(surface);
+
+    if (surface->swapchain)
+        IDXGISwapChain1_Release(surface->swapchain);
+    surface->swapchain = NULL;
+    surface->swapchain_width = 0;
+    surface->swapchain_height = 0;
+    surface->dirty = TRUE;
+}
+
+static HRESULT dcomp_surface_create_swapchain(struct dcomp_surface *surface)
+{
+    DXGI_SWAP_CHAIN_DESC1 desc = {0};
+    IDXGIDevice *dxgi_device;
+    IDXGIFactory2 *factory;
+    IDXGIAdapter *adapter;
+    HRESULT hr;
+
+    desc.Width = surface->width;
+    desc.Height = surface->height;
+    desc.Format = surface->format;
+    desc.SampleDesc.Count = 1;
+    desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    desc.BufferCount = 2;
+    desc.Scaling = DXGI_SCALING_STRETCH;
+    desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+    desc.AlphaMode = surface->alpha_mode;
+
+    if (FAILED(hr = ID3D11Device_QueryInterface(surface->device->d3d11_device,
+            &IID_IDXGIDevice, (void **)&dxgi_device)))
+        return hr;
+    if (SUCCEEDED(hr = IDXGIDevice_GetAdapter(dxgi_device, &adapter)))
+    {
+        if (SUCCEEDED(hr = IDXGIAdapter_GetParent(adapter, &IID_IDXGIFactory2, (void **)&factory)))
+        {
+            hr = IDXGIFactory2_CreateSwapChainForComposition(factory, (IUnknown *)surface->device->d3d11_device,
+                    &desc, NULL, &surface->swapchain);
+            IDXGIFactory2_Release(factory);
+        }
+        IDXGIAdapter_Release(adapter);
+    }
+    IDXGIDevice_Release(dxgi_device);
+
+    if (FAILED(hr))
+    {
+        WARN("Failed to create swap chain for surface %p, hr %#lx.\n", surface, hr);
+        return hr;
+    }
+
+    surface->swapchain_width = desc.Width;
+    surface->swapchain_height = desc.Height;
+    surface->dirty = TRUE;
+
+    TRACE("Created swap chain %p for surface %p.\n", surface->swapchain, surface);
+    return S_OK;
+}
+
+static HRESULT dcomp_surface_present(struct dcomp_surface *surface, HWND target, HWND dispatch)
+{
+    ID3D11DeviceContext *context;
+    ID3D11Texture2D *backbuffer;
+    HRESULT hr;
+
+    if (surface->swapchain && (surface->swapchain_width != surface->width
+            || surface->swapchain_height != surface->height))
+        dcomp_surface_reset_swapchain(surface);
+    if (!surface->swapchain && FAILED(hr = dcomp_surface_create_swapchain(surface)))
+        return hr;
+
+    if (surface->target_hwnd != target || surface->dispatch_hwnd != dispatch)
+    {
+        dcomp_swapchain_set_target(surface->swapchain, target, dispatch);
+        surface->target_hwnd = target;
+        surface->dispatch_hwnd = dispatch;
+    }
+
+    if (!surface->texture || !surface->dirty)
+        return S_OK;
+
+    if (FAILED(hr = IDXGISwapChain1_GetBuffer(surface->swapchain, 0, &IID_ID3D11Texture2D, (void **)&backbuffer)))
+    {
+        WARN("Failed to get back buffer of surface %p, hr %#lx.\n", surface, hr);
+        return hr;
+    }
+
+    ID3D11Device_GetImmediateContext(surface->device->d3d11_device, &context);
+    ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)backbuffer, (ID3D11Resource *)surface->texture);
+    ID3D11DeviceContext_Release(context);
+    ID3D11Texture2D_Release(backbuffer);
+
+    if (FAILED(hr = IDXGISwapChain1_Present(surface->swapchain, 1, 0)))
+    {
+        WARN("Failed to present surface %p, hr %#lx.\n", surface, hr);
+        return hr;
+    }
+
+    surface->dirty = FALSE;
+    return S_OK;
+}
+
 static HRESULT dcomp_surface_create_texture(struct dcomp_surface *surface, UINT width, UINT height,
         ID3D11Texture2D **texture)
 {
@@ -308,6 +427,7 @@ static ULONG WINAPI surface_Release(IDCompositionSurface *iface)
     {
         struct dcomp_device *device = surface->device;
 
+        dcomp_surface_reset_swapchain(surface);
         if (surface->texture)
             ID3D11Texture2D_Release(surface->texture);
         free(surface);
@@ -451,8 +571,14 @@ static HRESULT dcomp_surface_create(struct dcomp_device *device, UINT width, UIN
 
 static void dcomp_visual_unbind_content(struct dcomp_visual *visual)
 {
-    if (visual->swapchain)
+    if (visual->surface)
+    {
+        dcomp_surface_unbind_swapchain(visual->surface);
+    }
+    else if (visual->swapchain)
+    {
         dcomp_swapchain_set_target(visual->swapchain, NULL, NULL);
+    }
 }
 
 static void dcomp_visual_bind_swapchain(struct dcomp_visual *visual, HWND target, HWND dispatch)
@@ -663,6 +789,7 @@ static HRESULT WINAPI visual_SetContent(IDCompositionVisual2 *iface, IUnknown *c
 {
     struct dcomp_visual *visual = impl_from_IDCompositionVisual2(iface);
     struct dcomp_device *device = visual->device;
+    IDCompositionSurface *surface;
     DXGI_SWAP_CHAIN_DESC1 desc;
 
     TRACE("iface %p, content %p.\n", iface, content);
@@ -675,6 +802,7 @@ static HRESULT WINAPI visual_SetContent(IDCompositionVisual2 *iface, IUnknown *c
     if (visual->content)
         IUnknown_Release(visual->content);
     visual->swapchain = NULL;
+    visual->surface = NULL;
 
     if ((visual->content = content))
     {
@@ -685,6 +813,15 @@ static HRESULT WINAPI visual_SetContent(IDCompositionVisual2 *iface, IUnknown *c
                 TRACE("Content of visual %p is swap chain %p, %ux%u, format %#x, alpha mode %#x.\n",
                         visual, visual->swapchain, desc.Width, desc.Height, desc.Format, desc.AlphaMode);
         }
+        else if (SUCCEEDED(IUnknown_QueryInterface(content, &IID_IDCompositionSurface, (void **)&surface)))
+        {
+            if (surface->lpVtbl == &dcomp_surface_vtbl)
+                visual->surface = impl_from_IDCompositionSurface(surface);
+            else
+                FIXME("Unsupported surface %p.\n", surface);
+            IDCompositionSurface_Release(surface);
+            TRACE("Content of visual %p is surface %p.\n", visual, visual->surface);
+        }
         else
         {
             FIXME("Unsupported content %p.\n", content);
@@ -1082,6 +1219,14 @@ static BOOL dcomp_visual_update_host(struct dcomp_commit *commit, struct dcomp_v
     return TRUE;
 }
 
+static void dcomp_visual_present_surface(struct dcomp_visual *visual, HWND dispatch)
+{
+    struct dcomp_surface *surface = visual->surface;
+
+    if (FAILED(dcomp_surface_present(surface, visual->host_hwnd, dispatch)))
+        WARN("Failed to present surface %p of visual %p.\n", surface, visual);
+}
+
 static void dcomp_visual_bind(struct dcomp_commit *commit, struct dcomp_visual *visual,
         const struct dcomp_placement *parent_placement)
 {
@@ -1093,7 +1238,13 @@ static void dcomp_visual_bind(struct dcomp_commit *commit, struct dcomp_visual *
     BOOL needs_host = FALSE;
 
     placement = dcomp_visual_placement(parent_placement, visual);
-    if (dcomp_visual_swapchain_desc(visual, &desc))
+    if (visual->surface)
+    {
+        width = visual->surface->width;
+        height = visual->surface->height;
+        needs_host = TRUE;
+    }
+    else if (dcomp_visual_swapchain_desc(visual, &desc))
     {
         width = desc.Width;
         height = desc.Height;
@@ -1104,7 +1255,7 @@ static void dcomp_visual_bind(struct dcomp_commit *commit, struct dcomp_visual *
     TRACE("visual %p, content %p, placement (%d, %d), size %ux%u, target %p.\n",
             visual, visual->content, placement.x, placement.y, width, height, target->hwnd);
 
-    if (!visual->swapchain)
+    if (!visual->surface && !visual->swapchain)
     {
         if (visual->host_hwnd)
             dcomp_visual_teardown_host(visual);
@@ -1112,7 +1263,12 @@ static void dcomp_visual_bind(struct dcomp_commit *commit, struct dcomp_visual *
     else if (needs_host)
     {
         if (!dcomp_visual_update_host(commit, visual, &placement, width, height))
-            dcomp_visual_bind_swapchain(visual, target->hwnd, target->hwnd);
+        {
+            if (visual->swapchain)
+                dcomp_visual_bind_swapchain(visual, target->hwnd, target->hwnd);
+        }
+        else if (visual->surface)
+            dcomp_visual_present_surface(visual, target->hwnd);
         else
             dcomp_visual_bind_swapchain(visual, visual->host_hwnd, target->hwnd);
     }
