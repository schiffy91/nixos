From fd4aacb24b15634c19be55fe267f4b50d6836824 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Wed, 26 Aug 2026 00:18:52 -0700
Subject: [PATCH 18/19] dcomp: Clip target parents around composition hosts.

Wine's DComp bridge represents swap-chain visuals with real child windows.
The target window still belongs to Battle.net's Qt/CEF host, and without
WS_CLIPCHILDREN that parent can repaint its black loading/background surface
over the child composition host. That leaves Chromium-rendered frames hidden
even though DXVK has a valid presenter and CEF reports the page loaded.

Set WS_CLIPCHILDREN on a target window when the target is created. This
matches the child-window emulation model: once DComp content is hosted by a
child, parent repaints must leave that rectangle to the child surface. Doing
it at creation keeps the style change, which is dispatched to the window's
thread, out of the commit lock.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index 4727671..e26ff7a 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -1554,6 +1554,7 @@ static const IDCompositionTargetVtbl dcomp_target_vtbl =
 static HRESULT dcomp_target_create(struct dcomp_device *device, HWND hwnd, BOOL topmost, struct dcomp_target **target)
 {
     struct dcomp_target *object;
+    LONG_PTR style;
 
     if (!(object = calloc(1, sizeof(*object))))
         return E_OUTOFMEMORY;
@@ -1565,6 +1566,11 @@ static HRESULT dcomp_target_create(struct dcomp_device *device, HWND hwnd, BOOL
     object->hwnd = hwnd;
     object->topmost = topmost;
 
+    /* Host windows stand in for composition layers; the target must not paint over them. */
+    style = GetWindowLongPtrW(hwnd, GWL_STYLE);
+    if (!(style & WS_CLIPCHILDREN))
+        SetWindowLongPtrW(hwnd, GWL_STYLE, style | WS_CLIPCHILDREN);
+
     EnterCriticalSection(&device->cs);
     list_add_tail(&device->targets, &object->entry);
     LeaveCriticalSection(&device->cs);
