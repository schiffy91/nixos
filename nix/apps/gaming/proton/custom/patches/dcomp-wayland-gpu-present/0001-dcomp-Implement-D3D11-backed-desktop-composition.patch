+static HRESULT WINAPI visual_SetClipObject(IDCompositionVisual2 *iface, IDCompositionClip *clip)
+{
+    FIXME("iface %p, clip %p stub!\n", iface, clip);
+
+    return S_OK;
+}
+
+static HRESULT WINAPI visual_SetClip(IDCompositionVisual2 *iface, const D2D_RECT_F *rect)
+{
+    struct dcomp_visual *visual = impl_from_IDCompositionVisual2(iface);
+
