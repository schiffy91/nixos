+static struct dcomp_placement dcomp_visual_placement(const struct dcomp_placement *parent,
+        const struct dcomp_visual *visual)
+{
+    struct dcomp_placement placement = *parent;
+
+    placement.x += round_float(visual->offset_x + visual->transform.dx);
+    placement.y += round_float(visual->offset_y + visual->transform.dy);
+    return placement;
+}
