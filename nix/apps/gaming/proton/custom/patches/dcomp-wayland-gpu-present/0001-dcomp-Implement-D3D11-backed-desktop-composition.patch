+static HRESULT WINAPI visual_AddVisual(IDCompositionVisual2 *iface, IDCompositionVisual *visual_iface,
+        BOOL insert_above, IDCompositionVisual *reference_iface)
+{
+    struct dcomp_visual *visual = impl_from_IDCompositionVisual2(iface);
+    struct dcomp_visual *child = unsafe_impl_from_IDCompositionVisual(visual_iface);
+    struct dcomp_visual *reference = unsafe_impl_from_IDCompositionVisual(reference_iface);
+    struct dcomp_visual *ancestor;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, visual %p, insert_above %#x, reference_visual %p.\n",
+            iface, visual_iface, insert_above, reference_iface);
+
+    if (!child || (reference_iface && !reference) || reference == child)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&visual->device->cs);
+
+    for (ancestor = visual; ancestor; ancestor = ancestor->parent)
+    {
+        if (ancestor == child)
+            hr = E_INVALIDARG;
+    }
+    if (reference && reference->parent != visual)
+        hr = E_INVALIDARG;
+
+    if (SUCCEEDED(hr))
+    {
+        /* A parent keeps a reference on its children. */
+        if (child->parent)
+            dcomp_visual_unlink(child);
+        else
+            IDCompositionVisual2_AddRef(&child->IDCompositionVisual2_iface);
+        child->parent = visual;
+
+        if (!reference)
+        {
+            if (insert_above)
+                list_add_tail(&visual->children, &child->child_entry);
+            else
+                list_add_head(&visual->children, &child->child_entry);
+        }
+        else if (insert_above)
+        {
+            list_add_after(&reference->child_entry, &child->child_entry);
+        }
+        else
+        {
+            list_add_before(&reference->child_entry, &child->child_entry);
+        }
+    }
+
+    LeaveCriticalSection(&visual->device->cs);
+    return hr;
+}
