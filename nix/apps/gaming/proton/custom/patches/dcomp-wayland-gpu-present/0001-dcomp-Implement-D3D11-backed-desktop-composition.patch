+static HRESULT WINAPI device_GetFrameStatistics(IDCompositionDesktopDevice *iface,
+        DCOMPOSITION_FRAME_STATISTICS *statistics)
+{
+    struct dcomp_device *device = impl_from_IDCompositionDesktopDevice(iface);
+    LARGE_INTEGER frequency, now;
+
+    TRACE("iface %p, statistics %p.\n", iface, statistics);
+
+    if (!statistics)
+        return E_POINTER;
+
+    QueryPerformanceFrequency(&frequency);
+    QueryPerformanceCounter(&now);
+
+    statistics->lastFrameTime = device->last_frame_time.QuadPart ? device->last_frame_time : now;
+    statistics->currentCompositionRate.Numerator = 60;
+    statistics->currentCompositionRate.Denominator = 1;
+    statistics->currentTime = now;
+    statistics->timeFrequency = frequency;
+    statistics->nextEstimatedFrameTime.QuadPart = now.QuadPart + frequency.QuadPart / 60;
+    return S_OK;
+}
