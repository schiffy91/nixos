+static BOOL dcomp_visual_swapchain_desc(const struct dcomp_visual *visual, DXGI_SWAP_CHAIN_DESC1 *desc)
+{
+    return visual->swapchain && SUCCEEDED(IDXGISwapChain1_GetDesc1(visual->swapchain, desc));
+}
+
+static BOOL dcomp_visual_host_rect(const struct dcomp_placement *placement,
+        const struct dcomp_visual *visual, UINT width, UINT height, RECT *rect)
+{
+    RECT clip;
+
+    SetRect(rect, placement->x, placement->y, placement->x + width, placement->y + height);
+
+    if (visual->has_clip)
+    {
+        SetRect(&clip, round_float(visual->clip.left), round_float(visual->clip.top),
+                round_float(visual->clip.right), round_float(visual->clip.bottom));
+        OffsetRect(&clip, placement->x, placement->y);
+        if (!IntersectRect(rect, rect, &clip))
+            return FALSE;
+    }
+
+    return TRUE;
+}
+
+static BOOL dcomp_visual_update_host(struct dcomp_target *target, struct dcomp_visual *visual,
+        const struct dcomp_placement *placement, UINT width, UINT height)
+{
+    HWND target_hwnd = target->hwnd;
+    RECT rect;
+
+    if (!width || !height || !dcomp_visual_host_rect(placement, visual, width, height, &rect))
+    {
+        TRACE("Visual %p has no visible area on target %p.\n", visual, target_hwnd);
+        dcomp_visual_teardown_host(visual);
+        return FALSE;
+    }
+    width = rect.right - rect.left;
+    height = rect.bottom - rect.top;
+
+    if (visual->host_hwnd && visual->host_parent != target_hwnd)
+        dcomp_visual_teardown_host(visual);
+
+    if (!visual->host_hwnd)
+    {
+        if (!(visual->host_hwnd = CreateWindowExW(WS_EX_NOACTIVATE | WS_EX_TRANSPARENT,
+                dcomp_host_class_name, NULL, WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_CLIPSIBLINGS,
+                rect.left, rect.top, width, height, target_hwnd, NULL, dcomp_instance, NULL)))
+        {
+            WARN("Failed to create host window for visual %p, error %lu.\n", visual, GetLastError());
+            return FALSE;
+        }
+        TRACE("Created host window %p for visual %p on target %p.\n", visual->host_hwnd, visual, target_hwnd);
+        visual->host_parent = target_hwnd;
+        visual->host_x = rect.left;
+        visual->host_y = rect.top;
+        visual->host_width = width;
+        visual->host_height = height;
+    }
+    else if (visual->host_x != rect.left || visual->host_y != rect.top
+            || visual->host_width != width || visual->host_height != height)
+    {
+        if (!SetWindowPos(visual->host_hwnd, HWND_TOP, rect.left, rect.top, width, height,
+                SWP_NOACTIVATE | SWP_NOOWNERZORDER | SWP_SHOWWINDOW))
+        {
+            WARN("Failed to position host window %p, error %lu.\n", visual->host_hwnd, GetLastError());
+        }
+        else
+        {
+            visual->host_x = rect.left;
+            visual->host_y = rect.top;
+            visual->host_width = width;
+            visual->host_height = height;
+        }
+    }
+
+    return TRUE;
+}
+
+static void dcomp_visual_bind(struct dcomp_target *target, struct dcomp_visual *visual,
+        const struct dcomp_placement *parent_placement)
+{
+    struct dcomp_placement placement;
+    DXGI_SWAP_CHAIN_DESC1 desc = {0};
+    struct dcomp_visual *child;
+    UINT width = 0, height = 0;
+    BOOL needs_host = FALSE;
+
+    placement = dcomp_visual_placement(parent_placement, visual);
+    if (dcomp_visual_swapchain_desc(visual, &desc))
+    {
+        width = desc.Width;
+        height = desc.Height;
+        /* Opaque content may be presented to the target window itself. */
+        needs_host = desc.AlphaMode != DXGI_ALPHA_MODE_IGNORE;
+    }
+
+    TRACE("visual %p, content %p, placement (%d, %d), size %ux%u, target %p.\n",
+            visual, visual->content, placement.x, placement.y, width, height, target->hwnd);
+
+    if (!visual->swapchain)
+    {
+        if (visual->host_hwnd)
+            dcomp_visual_teardown_host(visual);
+    }
+    else if (needs_host)
+    {
+        if (!dcomp_visual_update_host(target, visual, &placement, width, height))
+            dcomp_visual_bind_swapchain(visual, target->hwnd, target->hwnd);
+        else
+            dcomp_visual_bind_swapchain(visual, visual->host_hwnd, target->hwnd);
+    }
+    else
+    {
+        if (visual->host_hwnd)
+            dcomp_visual_teardown_host(visual);
+        dcomp_visual_bind_swapchain(visual, target->hwnd, target->hwnd);
+    }
+
+    LIST_FOR_EACH_ENTRY(child, &visual->children, struct dcomp_visual, child_entry)
+        dcomp_visual_bind(target, child, &placement);
+}
