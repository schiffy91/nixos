+static HRESULT WINAPI visual_SetTransform(IDCompositionVisual2 *iface, const D2D_MATRIX_3X2_F *matrix)
+{
+    struct dcomp_visual *visual = impl_from_IDCompositionVisual2(iface);
+
+    TRACE("iface %p, matrix %s.\n", iface, debug_d2d_matrix_3x2_f(matrix));
+
+    if (!matrix)
+        return E_INVALIDARG;
+
+    if (!dcomp_matrix_is_translation(matrix))
+    {
+        static unsigned int once;
+
+        if (!once++)
+            FIXME("Only translations are supported, ignoring the linear part of %s.\n",
+                    debug_d2d_matrix_3x2_f(matrix));
+    }
+
+    visual->transform = *matrix;
+    return S_OK;
+}
