+static HRESULT WINAPI visual_SetBitmapInterpolationMode(IDCompositionVisual2 *iface,
+        enum DCOMPOSITION_BITMAP_INTERPOLATION_MODE interpolation_mode)
+{
+    FIXME("iface %p, interpolation_mode %#x stub!\n", iface, interpolation_mode);
