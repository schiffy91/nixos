-HRESULT WINAPI DCompositionCreateDevice(IDXGIDevice *dxgi_device, REFIID iid, void **device)
+/* Private DXVK interface binding a composition swap chain to a window. The
+ * dispatch window is the composition target; a target window different from
+ * it is a child host window that DXVK shows on the first present. */
+typedef struct IDXGIVkCompositionSwapChain IDXGIVkCompositionSwapChain;
+
+struct IDXGIVkCompositionSwapChainVtbl
+{
+    HRESULT (STDMETHODCALLTYPE *QueryInterface)(IDXGIVkCompositionSwapChain *iface, REFIID iid, void **out);
+    ULONG (STDMETHODCALLTYPE *AddRef)(IDXGIVkCompositionSwapChain *iface);
+    ULONG (STDMETHODCALLTYPE *Release)(IDXGIVkCompositionSwapChain *iface);
+    void (STDMETHODCALLTYPE *SetCompositionTarget)(IDXGIVkCompositionSwapChain *iface, HWND target, HWND dispatch);
+};
+
+struct IDXGIVkCompositionSwapChain
+{
+    const struct IDXGIVkCompositionSwapChainVtbl *lpVtbl;
+};
+
+DEFINE_GUID(IID_IDXGIVkCompositionSwapChain,
+        0x4765d18a, 0xeba0, 0x40bd, 0xa7, 0x30, 0x7f, 0x5f, 0x3d, 0x91, 0x5c, 0x1f);
+
+static const WCHAR dcomp_host_class_name[] = L"WineDCompositionHost";
+static HINSTANCE dcomp_instance;
+
+/* Visuals, surfaces, surface factories and targets hold a reference on the
+ * device. Targets are listed by the device while they exist. */
+
+struct dcomp_device
+{
+    IDCompositionDesktopDevice IDCompositionDesktopDevice_iface;
+    LONG refcount;
+    CRITICAL_SECTION cs;
+
+    IUnknown *rendering_device;
+    ID3D11Device *d3d11_device;
+    struct list targets;
+    LARGE_INTEGER last_frame_time;
+};
+
+struct dcomp_surface
+{
+    IDCompositionSurface IDCompositionSurface_iface;
+    LONG refcount;
+    struct dcomp_device *device;
+
+    UINT width, height;
+    DXGI_FORMAT format;
+    DXGI_ALPHA_MODE alpha_mode;
+
+    ID3D11Texture2D *texture;
+    BOOL in_draw;
+    BOOL suspended;
+    BOOL dirty;
+};
+
+struct dcomp_visual
+{
+    IDCompositionVisual2 IDCompositionVisual2_iface;
+    LONG refcount;
+    struct dcomp_device *device;
+
+    IUnknown *content;
+    IDXGISwapChain1 *swapchain;
+    float offset_x, offset_y;
+    D2D_MATRIX_3X2_F transform;
+    BOOL has_clip;
+    D2D_RECT_F clip;
+    enum DCOMPOSITION_COMPOSITE_MODE composite_mode;
+    enum DCOMPOSITION_OPACITY_MODE opacity_mode;
+
+    struct dcomp_visual *parent;
+    struct list children;
+    struct list child_entry;
+
+    HWND host_hwnd;
+    HWND host_parent;
+    int host_x, host_y;
+    UINT host_width, host_height;
+};
+
+struct dcomp_target
+{
+    IDCompositionTarget IDCompositionTarget_iface;
+    LONG refcount;
+    struct dcomp_device *device;
+    struct list entry;
+
+    HWND hwnd;
+    BOOL topmost;
+    struct dcomp_visual *root;
+};
+
+/* Accumulated state of the ancestors of a visual, in target coordinates. */
+struct dcomp_placement
+{
+    int x, y;
+};
+
+static const IDCompositionVisual2Vtbl dcomp_visual_vtbl;
+
+static inline struct dcomp_device *impl_from_IDCompositionDesktopDevice(IDCompositionDesktopDevice *iface)
+{
+    return CONTAINING_RECORD(iface, struct dcomp_device, IDCompositionDesktopDevice_iface);
+}
+
+static inline struct dcomp_visual *impl_from_IDCompositionVisual2(IDCompositionVisual2 *iface)
 {
-    FIXME("%p, %s, %p.\n", dxgi_device, debugstr_guid(iid), device);
+    return CONTAINING_RECORD(iface, struct dcomp_visual, IDCompositionVisual2_iface);
+}
+
+static inline struct dcomp_surface *impl_from_IDCompositionSurface(IDCompositionSurface *iface)
+{
+    return CONTAINING_RECORD(iface, struct dcomp_surface, IDCompositionSurface_iface);
+}
+
+static inline struct dcomp_target *impl_from_IDCompositionTarget(IDCompositionTarget *iface)
+{
+    return CONTAINING_RECORD(iface, struct dcomp_target, IDCompositionTarget_iface);
+}
+
+static struct dcomp_visual *unsafe_impl_from_IDCompositionVisual(IDCompositionVisual *iface)
+{
+    if (!iface || iface->lpVtbl != (const IDCompositionVisualVtbl *)&dcomp_visual_vtbl)
+        return NULL;
+    return CONTAINING_RECORD(iface, struct dcomp_visual, IDCompositionVisual2_iface);
+}
+
+static const char *debug_d2d_rect_f(const D2D_RECT_F *rect)
+{
+    if (!rect)
+        return "(null)";
+    return wine_dbg_sprintf("{%.8e, %.8e, %.8e, %.8e}", rect->left, rect->top, rect->right, rect->bottom);
+}
+
+static const char *debug_d2d_matrix_3x2_f(const D2D_MATRIX_3X2_F *matrix)
+{
+    if (!matrix)
+        return "(null)";
+    return wine_dbg_sprintf("{%.8e, %.8e, %.8e, %.8e, %.8e, %.8e}",
+            matrix->m11, matrix->m12, matrix->m21, matrix->m22, matrix->dx, matrix->dy);
+}
+
+static int round_float(float value)
+{
+    if (!(value > INT_MIN / 2))
+        return INT_MIN / 2;
+    if (value > INT_MAX / 2)
+        return INT_MAX / 2;
+    return (int)(value + (value >= 0.0f ? 0.5f : -0.5f));
+}
+
+static BOOL dcomp_matrix_is_translation(const D2D_MATRIX_3X2_F *matrix)
+{
+    return matrix->m11 == 1.0f && matrix->m12 == 0.0f && matrix->m21 == 0.0f && matrix->m22 == 1.0f;
+}
+
+static LRESULT CALLBACK dcomp_host_wndproc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    return DefWindowProcW(hwnd, msg, wparam, lparam);
+}
+
+static HRESULT dcomp_swapchain_set_target(IDXGISwapChain1 *swapchain, HWND target, HWND dispatch)
+{
+    IDXGIVkCompositionSwapChain *composition;
+    HRESULT hr;
+
+    if (FAILED(hr = IDXGISwapChain1_QueryInterface(swapchain, &IID_IDXGIVkCompositionSwapChain, (void **)&composition)))
+    {
+        WARN("Swap chain %p has no composition interface, hr %#lx.\n", swapchain, hr);
+        return hr;
+    }
+
+    TRACE("swapchain %p, target %p, dispatch %p.\n", swapchain, target, dispatch);
+
+    composition->lpVtbl->SetCompositionTarget(composition, target, dispatch);
+    composition->lpVtbl->Release(composition);
+    return S_OK;
+}
+
+static HRESULT dcomp_surface_create_texture(struct dcomp_surface *surface, UINT width, UINT height,
+        ID3D11Texture2D **texture)
+{
+    D3D11_TEXTURE2D_DESC desc = {0};
+    HRESULT hr;
+
+    desc.Width = width;
+    desc.Height = height;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = surface->format;
+    desc.SampleDesc.Count = 1;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+
+    if (FAILED(hr = ID3D11Device_CreateTexture2D(surface->device->d3d11_device, &desc, NULL, texture)))
+    {
+        WARN("Failed to create %ux%u texture for surface %p, hr %#lx.\n", width, height, surface, hr);
+        return hr;
+    }
+
+    return S_OK;
+}
+
+static HRESULT dcomp_surface_query_interface(struct dcomp_surface *surface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IDCompositionSurface)
+            || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        IDCompositionSurface_AddRef(&surface->IDCompositionSurface_iface);
+        *out = &surface->IDCompositionSurface_iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static HRESULT WINAPI surface_QueryInterface(IDCompositionSurface *iface, REFIID iid, void **out)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionSurface(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    return dcomp_surface_query_interface(surface, iid, out);
+}
+
+static ULONG WINAPI surface_AddRef(IDCompositionSurface *iface)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionSurface(iface);
+    ULONG refcount = InterlockedIncrement(&surface->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", surface, refcount);
+
+    return refcount;
+}
+
+static ULONG WINAPI surface_Release(IDCompositionSurface *iface)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionSurface(iface);
+    ULONG refcount = InterlockedDecrement(&surface->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", surface, refcount);
+
+    if (!refcount)
+    {
+        struct dcomp_device *device = surface->device;
+
+        if (surface->texture)
+            ID3D11Texture2D_Release(surface->texture);
+        free(surface);
+        IDCompositionDesktopDevice_Release(&device->IDCompositionDesktopDevice_iface);
+    }
+
+    return refcount;
+}
+
+static HRESULT WINAPI surface_BeginDraw(IDCompositionSurface *iface, const RECT *rect,
+        REFIID iid, void **object, POINT *offset)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionSurface(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, rect %s, iid %s, object %p, offset %p.\n",
+            iface, wine_dbgstr_rect(rect), debugstr_guid(iid), object, offset);
+
+    if (!object)
+        return E_POINTER;
+    *object = NULL;
+
+    if (rect)
+        FIXME("Ignoring update rect %s.\n", wine_dbgstr_rect(rect));
+
+    if (surface->in_draw || surface->suspended)
+        return DCOMPOSITION_ERROR_SURFACE_BEING_RENDERED;
+
+    if (!surface->device->d3d11_device)
+    {
+        WARN("No D3D11 device available.\n");
+        return E_FAIL;
+    }
+
+    if (!IsEqualGUID(iid, &IID_ID3D11Texture2D))
+    {
+        FIXME("Unsupported iid %s.\n", debugstr_guid(iid));
+        return E_NOINTERFACE;
+    }
+
+    if (!surface->texture && FAILED(hr = dcomp_surface_create_texture(surface,
+            surface->width, surface->height, &surface->texture)))
+        return hr;
+
+    ID3D11Texture2D_AddRef(surface->texture);
+    *object = surface->texture;
+
+    surface->in_draw = TRUE;
+    if (offset)
+    {
+        offset->x = 0;
+        offset->y = 0;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI surface_EndDraw(IDCompositionSurface *iface)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionSurface(iface);
+
+    TRACE("iface %p.\n", iface);
+
+    if (!surface->in_draw)
+        return DCOMPOSITION_ERROR_SURFACE_NOT_BEING_RENDERED;
+
+    surface->in_draw = FALSE;
+    surface->dirty = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI surface_SuspendDraw(IDCompositionSurface *iface)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionSurface(iface);
+
+    TRACE("iface %p.\n", iface);
+
+    if (!surface->in_draw)
+        return DCOMPOSITION_ERROR_SURFACE_NOT_BEING_RENDERED;
+
+    surface->in_draw = FALSE;
+    surface->suspended = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI surface_ResumeDraw(IDCompositionSurface *iface)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionSurface(iface);
+
+    TRACE("iface %p.\n", iface);
+
+    if (!surface->suspended)
+        return DCOMPOSITION_ERROR_SURFACE_NOT_BEING_RENDERED;
+
+    surface->suspended = FALSE;
+    surface->in_draw = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI surface_Scroll(IDCompositionSurface *iface, const RECT *scroll,
+        const RECT *clip, int offset_x, int offset_y)
+{
+    FIXME("iface %p, scroll %s, clip %s, offset_x %d, offset_y %d stub!\n",
+            iface, wine_dbgstr_rect(scroll), wine_dbgstr_rect(clip), offset_x, offset_y);
+
+    return S_OK;
+}
+
+static const IDCompositionSurfaceVtbl dcomp_surface_vtbl =
+{
+    surface_QueryInterface,
+    surface_AddRef,
+    surface_Release,
+    surface_BeginDraw,
+    surface_EndDraw,
+    surface_SuspendDraw,
+    surface_ResumeDraw,
+    surface_Scroll,
+};
+
+static HRESULT dcomp_surface_create(struct dcomp_device *device, UINT width, UINT height,
+        DXGI_FORMAT format, DXGI_ALPHA_MODE alpha_mode, struct dcomp_surface **surface)
+{
+    struct dcomp_surface *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->IDCompositionSurface_iface.lpVtbl = &dcomp_surface_vtbl;
+    object->refcount = 1;
+    object->device = device;
+    IDCompositionDesktopDevice_AddRef(&device->IDCompositionDesktopDevice_iface);
+    object->width = width;
+    object->height = height;
+    object->format = format == DXGI_FORMAT_UNKNOWN ? DXGI_FORMAT_B8G8R8A8_UNORM : format;
+    object->alpha_mode = alpha_mode == DXGI_ALPHA_MODE_UNSPECIFIED ? DXGI_ALPHA_MODE_PREMULTIPLIED : alpha_mode;
+
+    TRACE("Created surface %p.\n", object);
+    *surface = object;
+    return S_OK;
+}
+
+static void dcomp_visual_unbind_content(struct dcomp_visual *visual)
+{
+    if (visual->swapchain)
+        dcomp_swapchain_set_target(visual->swapchain, NULL, NULL);
+}
+
+static void dcomp_visual_bind_swapchain(struct dcomp_visual *visual, HWND target, HWND dispatch)
+{
+    dcomp_swapchain_set_target(visual->swapchain, target, dispatch);
+}
+
+static void dcomp_visual_reset_host_state(struct dcomp_visual *visual)
+{
+    visual->host_parent = NULL;
+    visual->host_x = 0;
+    visual->host_y = 0;
+    visual->host_width = 0;
+    visual->host_height = 0;
+}
+
+static void dcomp_visual_teardown_host(struct dcomp_visual *visual)
+{
+    if (visual->host_hwnd)
+    {
+        TRACE("Destroying host window %p of visual %p.\n", visual->host_hwnd, visual);
+        if (!DestroyWindow(visual->host_hwnd))
+            WARN("Failed to destroy host window %p, error %lu.\n", visual->host_hwnd, GetLastError());
+        visual->host_hwnd = NULL;
+    }
+    dcomp_visual_reset_host_state(visual);
+}
+
+static void dcomp_visual_unlink(struct dcomp_visual *visual)
+{
+    list_remove(&visual->child_entry);
+    visual->parent = NULL;
+}
+
+static HRESULT WINAPI visual_QueryInterface(IDCompositionVisual2 *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IDCompositionVisual2)
+            || IsEqualGUID(iid, &IID_IDCompositionVisual)
+            || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        IDCompositionVisual2_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI visual_AddRef(IDCompositionVisual2 *iface)
+{
+    struct dcomp_visual *visual = impl_from_IDCompositionVisual2(iface);
+    ULONG refcount = InterlockedIncrement(&visual->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", visual, refcount);
+
+    return refcount;
+}
+
+static ULONG WINAPI visual_Release(IDCompositionVisual2 *iface)
+{
+    struct dcomp_visual *visual = impl_from_IDCompositionVisual2(iface);
+    ULONG refcount = InterlockedDecrement(&visual->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", visual, refcount);
+
+    if (!refcount)
+    {
+        struct dcomp_device *device = visual->device;
+        struct dcomp_visual *child, *next;
+
+        EnterCriticalSection(&device->cs);
+        LIST_FOR_EACH_ENTRY_SAFE(child, next, &visual->children, struct dcomp_visual, child_entry)
+        {
+            dcomp_visual_unlink(child);
+            IDCompositionVisual2_Release(&child->IDCompositionVisual2_iface);
+        }
+        dcomp_visual_unbind_content(visual);
+        dcomp_visual_teardown_host(visual);
+        LeaveCriticalSection(&device->cs);
+
+        if (visual->swapchain)
+            IDXGISwapChain1_Release(visual->swapchain);
+        if (visual->content)
+            IUnknown_Release(visual->content);
+        free(visual);
+        IDCompositionDesktopDevice_Release(&device->IDCompositionDesktopDevice_iface);
+    }
+
+    return refcount;
+}
