+static HRESULT dcomp_device_create(IUnknown *rendering_device, REFIID iid, void **out)
+{
+    struct dcomp_device *device;
+    HRESULT hr;
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+
+    if (!(device = calloc(1, sizeof(*device))))
+        return E_OUTOFMEMORY;
+
+    device->IDCompositionDesktopDevice_iface.lpVtbl = &dcomp_device_vtbl;
+    device->refcount = 1;
+    InitializeCriticalSection(&device->cs);
+    list_init(&device->targets);
+
+    if (rendering_device)
+    {
+        device->rendering_device = rendering_device;
+        IUnknown_AddRef(rendering_device);
+        if (FAILED(hr = IUnknown_QueryInterface(rendering_device, &IID_ID3D11Device, (void **)&device->d3d11_device)))
+        {
+            FIXME("Rendering device %p is not a D3D11 device, hr %#lx.\n", rendering_device, hr);
+            device->d3d11_device = NULL;
+        }
+    }
+
+    TRACE("Created device %p.\n", device);
+
+    hr = IDCompositionDesktopDevice_QueryInterface(&device->IDCompositionDesktopDevice_iface, iid, out);
+    IDCompositionDesktopDevice_Release(&device->IDCompositionDesktopDevice_iface);
+    return hr;
+}
