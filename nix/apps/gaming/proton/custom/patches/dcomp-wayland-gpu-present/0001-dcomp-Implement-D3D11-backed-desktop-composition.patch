+BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
+{
+    WNDCLASSW wc = {0};
+
+    TRACE("instance %p, reason %lu, reserved %p.\n", instance, reason, reserved);
+
+    switch (reason)
+    {
+        case DLL_PROCESS_ATTACH:
+            dcomp_instance = instance;
+            DisableThreadLibraryCalls(instance);
+            wc.lpfnWndProc = dcomp_host_wndproc;
+            wc.hInstance = instance;
+            wc.lpszClassName = dcomp_host_class_name;
+            if (!RegisterClassW(&wc))
+                ERR("Failed to register host window class, error %lu.\n", GetLastError());
+            break;
+
+        case DLL_PROCESS_DETACH:
+            if (!reserved)
+                UnregisterClassW(dcomp_host_class_name, instance);
+            break;
+    }
+
+    return TRUE;
+}
