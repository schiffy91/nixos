From c65078192f8fbb3e90ef1c1d439b3641785da418 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Wed, 26 Aug 2026 00:18:52 -0700
Subject: [PATCH] dcomp: Handle incremental surface draws.

Chromium uses IDCompositionSurface for popups, tooltips and form controls,
and it may redraw only a sub-rectangle of the surface. Return the requested
update offset instead of always reporting (0,0), support IDXGISurface draw
requests, and clear newly created backing textures so untouched pixels are
transparent.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 36 ++++++++++++++++++++++++++++++------
 1 file changed, 30 insertions(+), 6 deletions(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index a8d6e9f200d..0a8ac7a86f0 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -361,7 +361,10 @@ static HRESULT dcomp_surface_present(struct dcomp_surface *surface, HWND target,
 static HRESULT dcomp_surface_create_texture(struct dcomp_surface *surface, UINT width, UINT height,
         ID3D11Texture2D **texture)
 {
+    static const float transparent[4];
     D3D11_TEXTURE2D_DESC desc = {0};
+    ID3D11RenderTargetView *view;
+    ID3D11DeviceContext *context;
     HRESULT hr;
 
     desc.Width = width;
@@ -379,6 +382,16 @@ static HRESULT dcomp_surface_create_texture(struct dcomp_surface *surface, UINT
         return hr;
     }
 
+    /* Pixels the application never draws are transparent. */
+    if (SUCCEEDED(ID3D11Device_CreateRenderTargetView(surface->device->d3d11_device,
+            (ID3D11Resource *)*texture, NULL, &view)))
+    {
+        ID3D11Device_GetImmediateContext(surface->device->d3d11_device, &context);
+        ID3D11DeviceContext_ClearRenderTargetView(context, view, transparent);
+        ID3D11DeviceContext_Release(context);
+        ID3D11RenderTargetView_Release(view);
+    }
+
     return S_OK;
 }
 
@@ -441,6 +454,7 @@ static HRESULT WINAPI surface_BeginDraw(IDCompositionSurface *iface, const RECT
         REFIID iid, void **object, POINT *offset)
 {
     struct dcomp_surface *surface = impl_from_IDCompositionSurface(iface);
+    RECT update;
     HRESULT hr;
 
     TRACE("iface %p, rect %s, iid %s, object %p, offset %p.\n",
@@ -450,8 +464,18 @@ static HRESULT WINAPI surface_BeginDraw(IDCompositionSurface *iface, const RECT
         return E_POINTER;
     *object = NULL;
 
+    SetRect(&update, 0, 0, surface->width, surface->height);
     if (rect)
-        FIXME("Ignoring update rect %s.\n", wine_dbgstr_rect(rect));
+    {
+        if (rect->left < 0 || rect->top < 0 || rect->right < rect->left || rect->bottom < rect->top
+                || rect->right > (LONG)surface->width || rect->bottom > (LONG)surface->height)
+        {
+            WARN("Invalid update rect %s for %ux%u surface.\n",
+                    wine_dbgstr_rect(rect), surface->width, surface->height);
+            return E_INVALIDARG;
+        }
+        update = *rect;
+    }
 
     if (surface->in_draw || surface->suspended)
         return DCOMPOSITION_ERROR_SURFACE_BEING_RENDERED;
@@ -462,7 +486,7 @@ static HRESULT WINAPI surface_BeginDraw(IDCompositionSurface *iface, const RECT
         return E_FAIL;
     }
 
-    if (!IsEqualGUID(iid, &IID_ID3D11Texture2D))
+    if (!IsEqualGUID(iid, &IID_ID3D11Texture2D) && !IsEqualGUID(iid, &IID_IDXGISurface))
     {
         FIXME("Unsupported iid %s.\n", debugstr_guid(iid));
         return E_NOINTERFACE;
@@ -472,14 +496,14 @@ static HRESULT WINAPI surface_BeginDraw(IDCompositionSurface *iface, const RECT
             surface->width, surface->height, &surface->texture)))
         return hr;
 
-    ID3D11Texture2D_AddRef(surface->texture);
-    *object = surface->texture;
+    if (FAILED(hr = ID3D11Texture2D_QueryInterface(surface->texture, iid, object)))
+        return hr;
 
     surface->in_draw = TRUE;
     if (offset)
     {
-        offset->x = 0;
-        offset->y = 0;
+        offset->x = update.left;
+        offset->y = update.top;
     }
     return S_OK;
 }
