From 71cffcdca4023bbb3ea090934aca9487002fd23d Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Wed, 26 Aug 2026 00:18:52 -0700
Subject: [PATCH] dcomp: Do not mark composition host windows transparent.

The host window only gives DXVK a native presentation target for a
DirectComposition visual. Transparency comes from the swap chain alpha mode,
not from Win32 sibling paint ordering. WS_EX_TRANSPARENT can delay native
child window updates behind sibling paints and causes unstable overlay
ordering under Wayland, which shows up as intermittent black rectangles in
Battle.net's CEF composition surfaces.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index a122483bda5..2414997ec1f 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -1008,7 +1008,7 @@ static BOOL dcomp_visual_update_host(struct dcomp_target *target, struct dcomp_v
 
     if (!visual->host_hwnd)
     {
-        if (!(visual->host_hwnd = CreateWindowExW(WS_EX_NOACTIVATE | WS_EX_TRANSPARENT,
+        if (!(visual->host_hwnd = CreateWindowExW(WS_EX_NOACTIVATE,
                 dcomp_host_class_name, NULL, WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_CLIPSIBLINGS,
                 rect.left, rect.top, width, height, target_hwnd, NULL, dcomp_instance, NULL)))
         {
