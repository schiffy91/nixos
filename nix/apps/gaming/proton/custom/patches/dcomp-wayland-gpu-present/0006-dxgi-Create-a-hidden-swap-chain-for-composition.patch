From 847ae9e0462c408df45ac262084afef3e2932a6b Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Wed, 26 Aug 2026 00:18:52 -0700
Subject: [PATCH 06/19] dxgi: Create a hidden swap chain for composition.

CreateSwapChainForComposition() creates a swap chain without an output
window; whoever composes it presents it. Give the swap chain a message-only
window to stand in for the output window, and keep that window alive exactly
as long as the swap chain by attaching it to the swap chain's private data.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dxgi/factory.c | 96 ++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 94 insertions(+), 2 deletions(-)

diff --git a/dlls/dxgi/factory.c b/dlls/dxgi/factory.c
index ebdb42a..461845c 100644
--- a/dlls/dxgi/factory.c
+++ b/dlls/dxgi/factory.c
@@ -378,13 +378,105 @@ static void STDMETHODCALLTYPE dxgi_factory_UnregisterOcclusionStatus(IWineDXGIFa
     FIXME("iface %p, cookie %#lx stub!\n", iface, cookie);
 }
 
+/* Composition swap chains have no window of their own; they present through
+ * whatever composes them. A message-only window stands in for the output
+ * window and lives as long as the swap chain. */
+struct dxgi_composition_window
+{
+    IUnknown IUnknown_iface;
+    LONG refcount;
+    HWND window;
+};
+
+static const GUID GUID_dxgi_composition_window =
+        {0x8cf311ee, 0xf401, 0x4647, {0x86, 0x6c, 0x13, 0xa0, 0x3e, 0x08, 0x86, 0x09}};
+
+static inline struct dxgi_composition_window *impl_from_composition_window_IUnknown(IUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, struct dxgi_composition_window, IUnknown_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_composition_window_QueryInterface(IUnknown *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown))
+    {
+        IUnknown_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE dxgi_composition_window_AddRef(IUnknown *iface)
+{
+    struct dxgi_composition_window *window = impl_from_composition_window_IUnknown(iface);
+    ULONG refcount = InterlockedIncrement(&window->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", window, refcount);
+
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE dxgi_composition_window_Release(IUnknown *iface)
+{
+    struct dxgi_composition_window *window = impl_from_composition_window_IUnknown(iface);
+    ULONG refcount = InterlockedDecrement(&window->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", window, refcount);
+
+    if (!refcount)
+    {
+        /* The swap chain may be released on any thread; only the creating
+         * thread can destroy the window. */
+        if (GetWindowThreadProcessId(window->window, NULL) == GetCurrentThreadId())
+            DestroyWindow(window->window);
+        else
+            PostMessageW(window->window, WM_CLOSE, 0, 0);
+        free(window);
+    }
+
+    return refcount;
+}
+
+static const struct IUnknownVtbl dxgi_composition_window_vtbl =
+{
+    dxgi_composition_window_QueryInterface,
+    dxgi_composition_window_AddRef,
+    dxgi_composition_window_Release,
+};
+
 static HRESULT STDMETHODCALLTYPE dxgi_factory_CreateSwapChainForComposition(IWineDXGIFactory *iface,
         IUnknown *device, const DXGI_SWAP_CHAIN_DESC1 *desc, IDXGIOutput *output, IDXGISwapChain1 **swapchain)
 {
-    FIXME("iface %p, device %p, desc %p, output %p, swapchain %p stub!\n",
+    DXGI_SWAP_CHAIN_FULLSCREEN_DESC fullscreen_desc = {0};
+    struct dxgi_composition_window *window;
+    HRESULT hr;
+
+    TRACE("iface %p, device %p, desc %p, output %p, swapchain %p.\n",
             iface, device, desc, output, swapchain);
 
-    return E_NOTIMPL;
+    if (!(window = calloc(1, sizeof(*window))))
+        return E_OUTOFMEMORY;
+    window->IUnknown_iface.lpVtbl = &dxgi_composition_window_vtbl;
+    window->refcount = 1;
+    if (!(window->window = CreateWindowExW(0, L"Message", NULL, 0, 0, 0, 1, 1, HWND_MESSAGE, NULL, NULL, NULL)))
+    {
+        ERR("Failed to create window.\n");
+        free(window);
+        return E_FAIL;
+    }
+
+    fullscreen_desc.Windowed = TRUE;
+    if (SUCCEEDED(hr = dxgi_factory_CreateSwapChainForHwnd(iface, device, window->window,
+            desc, &fullscreen_desc, output, swapchain)))
+        IDXGISwapChain1_SetPrivateDataInterface(*swapchain, &GUID_dxgi_composition_window, &window->IUnknown_iface);
+    IUnknown_Release(&window->IUnknown_iface);
+    return hr;
 }
 
 static UINT STDMETHODCALLTYPE dxgi_factory_GetCreationFlags(IWineDXGIFactory *iface)
