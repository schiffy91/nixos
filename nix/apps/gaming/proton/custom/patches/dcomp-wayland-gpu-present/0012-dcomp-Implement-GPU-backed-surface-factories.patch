From 88b169c86deeac0e11547d2f415ad39c15dec763 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Wed, 26 Aug 2026 00:18:52 -0700
Subject: [PATCH 12/19] dcomp: Implement GPU-backed surface factories.

Chromium creates DirectComposition surface factories for popup and control
content. Returning E_NOTIMPL there leaves callers without a drawable
surface, which can show up as blank menu, tooltip and dialog text even when
the main swap chain is presenting correctly.

Add a minimal IDCompositionSurfaceFactory implementation that creates the
same GPU-backed IDCompositionSurface objects as the desktop device. Store the
D3D11 device on each surface so factory-created surfaces draw with the
rendering device they were created for, and accept IDXGISurface1 BeginDraw
requests in addition to IDXGISurface.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 174 ++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 161 insertions(+), 13 deletions(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index b912a3c..f1f03e3 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -82,6 +82,7 @@ struct dcomp_surface
     IDCompositionSurface IDCompositionSurface_iface;
     LONG refcount;
     struct dcomp_device *device;
+    ID3D11Device *d3d11_device;
 
     UINT width, height;
     DXGI_FORMAT format;
@@ -98,6 +99,14 @@ struct dcomp_surface
     HWND dispatch_hwnd;
 };
 
+struct dcomp_surface_factory
+{
+    IDCompositionSurfaceFactory IDCompositionSurfaceFactory_iface;
+    LONG refcount;
+    struct dcomp_device *device;
+    ID3D11Device *d3d11_device;
+};
+
 struct dcomp_visual
 {
     IDCompositionVisual2 IDCompositionVisual2_iface;
@@ -176,6 +185,11 @@ static inline struct dcomp_surface *impl_from_IDCompositionSurface(IDComposition
     return CONTAINING_RECORD(iface, struct dcomp_surface, IDCompositionSurface_iface);
 }
 
+static inline struct dcomp_surface_factory *impl_from_IDCompositionSurfaceFactory(IDCompositionSurfaceFactory *iface)
+{
+    return CONTAINING_RECORD(iface, struct dcomp_surface_factory, IDCompositionSurfaceFactory_iface);
+}
+
 static inline struct dcomp_target *impl_from_IDCompositionTarget(IDCompositionTarget *iface)
 {
     return CONTAINING_RECORD(iface, struct dcomp_target, IDCompositionTarget_iface);
@@ -294,14 +308,14 @@ static HRESULT dcomp_surface_create_swapchain(struct dcomp_surface *surface)
     desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
     desc.AlphaMode = surface->alpha_mode;
 
-    if (FAILED(hr = ID3D11Device_QueryInterface(surface->device->d3d11_device,
+    if (FAILED(hr = ID3D11Device_QueryInterface(surface->d3d11_device,
             &IID_IDXGIDevice, (void **)&dxgi_device)))
         return hr;
     if (SUCCEEDED(hr = IDXGIDevice_GetAdapter(dxgi_device, &adapter)))
     {
         if (SUCCEEDED(hr = IDXGIAdapter_GetParent(adapter, &IID_IDXGIFactory2, (void **)&factory)))
         {
-            hr = IDXGIFactory2_CreateSwapChainForComposition(factory, (IUnknown *)surface->device->d3d11_device,
+            hr = IDXGIFactory2_CreateSwapChainForComposition(factory, (IUnknown *)surface->d3d11_device,
                     &desc, NULL, &surface->swapchain);
             IDXGIFactory2_Release(factory);
         }
@@ -351,7 +365,7 @@ static HRESULT dcomp_surface_present(struct dcomp_surface *surface, HWND target,
         return hr;
     }
 
-    ID3D11Device_GetImmediateContext(surface->device->d3d11_device, &context);
+    ID3D11Device_GetImmediateContext(surface->d3d11_device, &context);
     ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)backbuffer, (ID3D11Resource *)surface->texture);
     ID3D11DeviceContext_Release(context);
     ID3D11Texture2D_Release(backbuffer);
@@ -384,17 +398,17 @@ static HRESULT dcomp_surface_create_texture(struct dcomp_surface *surface, UINT
     desc.Usage = D3D11_USAGE_DEFAULT;
     desc.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
 
-    if (FAILED(hr = ID3D11Device_CreateTexture2D(surface->device->d3d11_device, &desc, NULL, texture)))
+    if (FAILED(hr = ID3D11Device_CreateTexture2D(surface->d3d11_device, &desc, NULL, texture)))
     {
         WARN("Failed to create %ux%u texture for surface %p, hr %#lx.\n", width, height, surface, hr);
         return hr;
     }
 
     /* Pixels the application never draws are transparent. */
-    if (SUCCEEDED(ID3D11Device_CreateRenderTargetView(surface->device->d3d11_device,
+    if (SUCCEEDED(ID3D11Device_CreateRenderTargetView(surface->d3d11_device,
             (ID3D11Resource *)*texture, NULL, &view)))
     {
-        ID3D11Device_GetImmediateContext(surface->device->d3d11_device, &context);
+        ID3D11Device_GetImmediateContext(surface->d3d11_device, &context);
         ID3D11DeviceContext_ClearRenderTargetView(context, view, transparent);
         ID3D11DeviceContext_Release(context);
         ID3D11RenderTargetView_Release(view);
@@ -451,6 +465,8 @@ static ULONG WINAPI surface_Release(IDCompositionSurface *iface)
         dcomp_surface_reset_swapchain(surface);
         if (surface->texture)
             ID3D11Texture2D_Release(surface->texture);
+        if (surface->d3d11_device)
+            ID3D11Device_Release(surface->d3d11_device);
         free(surface);
         IDCompositionDesktopDevice_Release(&device->IDCompositionDesktopDevice_iface);
     }
@@ -488,13 +504,14 @@ static HRESULT WINAPI surface_BeginDraw(IDCompositionSurface *iface, const RECT
     if (surface->in_draw || surface->suspended)
         return DCOMPOSITION_ERROR_SURFACE_BEING_RENDERED;
 
-    if (!surface->device->d3d11_device)
+    if (!surface->d3d11_device)
     {
         WARN("No D3D11 device available.\n");
         return E_FAIL;
     }
 
-    if (!IsEqualGUID(iid, &IID_ID3D11Texture2D) && !IsEqualGUID(iid, &IID_IDXGISurface))
+    if (!IsEqualGUID(iid, &IID_ID3D11Texture2D) && !IsEqualGUID(iid, &IID_IDXGISurface)
+            && !IsEqualGUID(iid, &IID_IDXGISurface1))
     {
         FIXME("Unsupported iid %s.\n", debugstr_guid(iid));
         return E_NOINTERFACE;
@@ -579,8 +596,9 @@ static const IDCompositionSurfaceVtbl dcomp_surface_vtbl =
     surface_Scroll,
 };
 
-static HRESULT dcomp_surface_create(struct dcomp_device *device, UINT width, UINT height,
-        DXGI_FORMAT format, DXGI_ALPHA_MODE alpha_mode, struct dcomp_surface **surface)
+static HRESULT dcomp_surface_create(struct dcomp_device *device, ID3D11Device *d3d11_device,
+        UINT width, UINT height, DXGI_FORMAT format, DXGI_ALPHA_MODE alpha_mode,
+        struct dcomp_surface **surface)
 {
     struct dcomp_surface *object;
 
@@ -591,6 +609,8 @@ static HRESULT dcomp_surface_create(struct dcomp_device *device, UINT width, UIN
     object->refcount = 1;
     object->device = device;
     IDCompositionDesktopDevice_AddRef(&device->IDCompositionDesktopDevice_iface);
+    if ((object->d3d11_device = d3d11_device))
+        ID3D11Device_AddRef(d3d11_device);
     object->width = width;
     object->height = height;
     object->format = format == DXGI_FORMAT_UNKNOWN ? DXGI_FORMAT_B8G8R8A8_UNORM : format;
@@ -601,6 +621,122 @@ static HRESULT dcomp_surface_create(struct dcomp_device *device, UINT width, UIN
     return S_OK;
 }
 
+static HRESULT WINAPI surface_factory_QueryInterface(IDCompositionSurfaceFactory *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IDCompositionSurfaceFactory)
+            || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        IDCompositionSurfaceFactory_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI surface_factory_AddRef(IDCompositionSurfaceFactory *iface)
+{
+    struct dcomp_surface_factory *factory = impl_from_IDCompositionSurfaceFactory(iface);
+    ULONG refcount = InterlockedIncrement(&factory->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", factory, refcount);
+
+    return refcount;
+}
+
+static ULONG WINAPI surface_factory_Release(IDCompositionSurfaceFactory *iface)
+{
+    struct dcomp_surface_factory *factory = impl_from_IDCompositionSurfaceFactory(iface);
+    ULONG refcount = InterlockedDecrement(&factory->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", factory, refcount);
+
+    if (!refcount)
+    {
+        struct dcomp_device *device = factory->device;
+
+        if (factory->d3d11_device)
+            ID3D11Device_Release(factory->d3d11_device);
+        free(factory);
+        IDCompositionDesktopDevice_Release(&device->IDCompositionDesktopDevice_iface);
+    }
+
+    return refcount;
+}
+
+static HRESULT WINAPI surface_factory_CreateSurface(IDCompositionSurfaceFactory *iface, UINT width, UINT height,
+        DXGI_FORMAT format, DXGI_ALPHA_MODE alpha_mode, IDCompositionSurface **surface)
+{
+    struct dcomp_surface_factory *factory = impl_from_IDCompositionSurfaceFactory(iface);
+    struct dcomp_surface *object;
+    HRESULT hr;
+
+    TRACE("iface %p, width %u, height %u, format %#x, alpha_mode %#x, surface %p.\n",
+            iface, width, height, format, alpha_mode, surface);
+
+    if (!surface)
+        return E_POINTER;
+
+    if (FAILED(hr = dcomp_surface_create(factory->device, factory->d3d11_device,
+            width, height, format, alpha_mode, &object)))
+        return hr;
+
+    *surface = &object->IDCompositionSurface_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI surface_factory_CreateVirtualSurface(IDCompositionSurfaceFactory *iface, UINT width, UINT height,
+        DXGI_FORMAT format, DXGI_ALPHA_MODE alpha_mode, IDCompositionVirtualSurface **surface)
+{
+    FIXME("iface %p, width %u, height %u, format %#x, alpha_mode %#x, surface %p stub!\n",
+            iface, width, height, format, alpha_mode, surface);
+
+    return E_NOTIMPL;
+}
+
+static const IDCompositionSurfaceFactoryVtbl dcomp_surface_factory_vtbl =
+{
+    surface_factory_QueryInterface,
+    surface_factory_AddRef,
+    surface_factory_Release,
+    surface_factory_CreateSurface,
+    surface_factory_CreateVirtualSurface,
+};
+
+static HRESULT dcomp_surface_factory_create(struct dcomp_device *device, IUnknown *rendering_device,
+        struct dcomp_surface_factory **factory)
+{
+    struct dcomp_surface_factory *object;
+    HRESULT hr;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->IDCompositionSurfaceFactory_iface.lpVtbl = &dcomp_surface_factory_vtbl;
+    object->refcount = 1;
+    object->device = device;
+    IDCompositionDesktopDevice_AddRef(&device->IDCompositionDesktopDevice_iface);
+
+    if (!rendering_device)
+    {
+        if ((object->d3d11_device = device->d3d11_device))
+            ID3D11Device_AddRef(object->d3d11_device);
+    }
+    else if (FAILED(hr = IUnknown_QueryInterface(rendering_device, &IID_ID3D11Device, (void **)&object->d3d11_device)))
+    {
+        FIXME("Rendering device %p is not a D3D11 device, hr %#lx.\n", rendering_device, hr);
+        object->d3d11_device = NULL;
+    }
+
+    TRACE("Created surface factory %p.\n", object);
+    *factory = object;
+    return S_OK;
+}
+
 static void dcomp_visual_unbind_content(struct dcomp_visual *visual)
 {
     if (visual->surface)
@@ -1502,9 +1638,20 @@ static HRESULT WINAPI device_CreateVisual(IDCompositionDesktopDevice *iface, IDC
 static HRESULT WINAPI device_CreateSurfaceFactory(IDCompositionDesktopDevice *iface, IUnknown *rendering_device,
         IDCompositionSurfaceFactory **surface_factory)
 {
-    FIXME("iface %p, rendering_device %p, surface_factory %p stub!\n", iface, rendering_device, surface_factory);
+    struct dcomp_device *device = impl_from_IDCompositionDesktopDevice(iface);
+    struct dcomp_surface_factory *object;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, rendering_device %p, surface_factory %p.\n", iface, rendering_device, surface_factory);
+
+    if (!surface_factory)
+        return E_POINTER;
+
+    if (FAILED(hr = dcomp_surface_factory_create(device, rendering_device, &object)))
+        return hr;
+
+    *surface_factory = &object->IDCompositionSurfaceFactory_iface;
+    return S_OK;
 }
 
 static HRESULT WINAPI device_CreateSurface(IDCompositionDesktopDevice *iface, UINT width, UINT height,
@@ -1520,7 +1667,8 @@ static HRESULT WINAPI device_CreateSurface(IDCompositionDesktopDevice *iface, UI
     if (!surface)
         return E_POINTER;
 
-    if (FAILED(hr = dcomp_surface_create(device, width, height, format, alpha_mode, &object)))
+    if (FAILED(hr = dcomp_surface_create(device, device->d3d11_device,
+            width, height, format, alpha_mode, &object)))
         return hr;
 
     *surface = &object->IDCompositionSurface_iface;
-- 
