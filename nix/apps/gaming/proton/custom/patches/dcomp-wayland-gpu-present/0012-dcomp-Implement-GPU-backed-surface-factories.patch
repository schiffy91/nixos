 }
 
 static struct dcomp_surface *dcomp_surface_create(struct dcomp_device *device,
+                                                  ID3D11Device *d3d11_device,
                                                   UINT width, UINT height,
                                                   DXGI_FORMAT format, DXGI_ALPHA_MODE alpha)
 {
@@ -224,11 +238,42 @@ static struct dcomp_surface *dcomp_surface_create(struct dcomp_device *device,
     s->height = height;
     s->format = format;
     s->alpha_mode = alpha;
+    if ((s->d3d11_device = d3d11_device)) ID3D11Device_AddRef(s->d3d11_device);
     list_add_tail(&device->surfaces, &s->entry);
     TRACE("created surface %p (%ux%u fmt=%u alpha=%u)\n", s, width, height, format, alpha);
     return s;
 }
 
+static struct dcomp_surface_factory *dcomp_surface_factory_create(struct dcomp_device *device,
+                                                                  IUnknown *rendering_device)
+{
+    struct dcomp_surface_factory *factory;
+    HRESULT hr = E_NOINTERFACE;
+
+    if (!(factory = calloc(1, sizeof(*factory)))) return NULL;
+    factory->IDCompositionSurfaceFactory_iface.lpVtbl = &dcomp_surface_factory_vtbl;
+    factory->ref = 1;
+    factory->device = device;
+    IDCompositionDesktopDevice_AddRef(&device->IDCompositionDesktopDevice_iface);
+
+    if (rendering_device)
+        hr = IUnknown_QueryInterface(rendering_device, &IID_ID3D11Device,
+                                     (void **)&factory->d3d11_device);
+    else if (device->d3d11_device)
+    {
+        factory->d3d11_device = device->d3d11_device;
+        ID3D11Device_AddRef(factory->d3d11_device);
+        hr = S_OK;
+    }
+
+    if (FAILED(hr))
+        WARN("surface factory has no ID3D11Device hr=%#lx\n", hr);
+
+    TRACE("created surface factory %p device=%p d3d11=%p\n",
+          factory, device, factory->d3d11_device);
+    return factory;
+}
+
 static struct dcomp_target *dcomp_target_create(struct dcomp_device *device,
                                                 HWND hwnd, BOOL topmost)
 {
