     want_texture = IsEqualGUID(iid, &IID_ID3D11Texture2D);
-    want_dxgi_surface = IsEqualGUID(iid, &IID_IDXGISurface);
+    want_dxgi_surface = IsEqualGUID(iid, &IID_IDXGISurface) ||
+                        IsEqualGUID(iid, &IID_IDXGISurface1);
     if (!want_texture && !want_dxgi_surface)
     {
         FIXME("BeginDraw with unsupported iid %s\n", debugstr_guid(iid));
@@ -574,7 +621,7 @@ static HRESULT WINAPI surface_BeginDraw(IDCompositionSurface *iface, const RECT
         desc.Usage = D3D11_USAGE_DEFAULT;
         desc.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
         desc.MiscFlags = D3D11_RESOURCE_MISC_SHARED;       /* enable dmabuf export via DXVK interop */
-        hr = ID3D11Device_CreateTexture2D(s->device->d3d11_device, &desc, NULL, &s->draw_texture);
+        hr = ID3D11Device_CreateTexture2D(s->d3d11_device, &desc, NULL, &s->draw_texture);
         if (FAILED(hr))
         {
             ERR("CreateTexture2D %ux%u failed hr=%#lx\n", s->width, s->height, hr);
@@ -584,11 +631,11 @@ static HRESULT WINAPI surface_BeginDraw(IDCompositionSurface *iface, const RECT
     }
 
     if (created_texture &&
-        SUCCEEDED(ID3D11Device_CreateRenderTargetView(s->device->d3d11_device,
+        SUCCEEDED(ID3D11Device_CreateRenderTargetView(s->d3d11_device,
                                                       (ID3D11Resource *)s->draw_texture,
                                                       NULL, &view)))
     {
-        ID3D11Device_GetImmediateContext(s->device->d3d11_device, &context);
+        ID3D11Device_GetImmediateContext(s->d3d11_device, &context);
         ID3D11DeviceContext_ClearRenderTargetView(context, view, clear_color);
         ID3D11DeviceContext_Release(context);
         ID3D11RenderTargetView_Release(view);
@@ -644,6 +691,84 @@ static const IDCompositionSurfaceVtbl dcomp_surface_vtbl =
     surface_SuspendDraw, surface_ResumeDraw, surface_Scroll,
 };
 
+/* ----------------------- IDCompositionSurfaceFactory ----------------------- */
+
+static HRESULT WINAPI surface_factory_QueryInterface(IDCompositionSurfaceFactory *iface,
+                                                     REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) ||
+        IsEqualGUID(iid, &IID_IDCompositionSurfaceFactory))
+    {
+        IDCompositionSurfaceFactory_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    TRACE("surface factory QI %s - not supported\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI surface_factory_AddRef(IDCompositionSurfaceFactory *iface)
+{
+    struct dcomp_surface_factory *factory = impl_from_IDCompositionSurfaceFactory(iface);
+    return InterlockedIncrement(&factory->ref);
+}
+
+static ULONG WINAPI surface_factory_Release(IDCompositionSurfaceFactory *iface)
+{
+    struct dcomp_surface_factory *factory = impl_from_IDCompositionSurfaceFactory(iface);
+    ULONG r = InterlockedDecrement(&factory->ref);
+
+    if (!r)
+    {
+        if (factory->d3d11_device) ID3D11Device_Release(factory->d3d11_device);
+        IDCompositionDesktopDevice_Release(&factory->device->IDCompositionDesktopDevice_iface);
+        free(factory);
+    }
+    return r;
+}
+
+static HRESULT WINAPI surface_factory_CreateSurface(IDCompositionSurfaceFactory *iface,
+                                                    UINT width, UINT height,
+                                                    DXGI_FORMAT format,
+                                                    DXGI_ALPHA_MODE alpha,
+                                                    IDCompositionSurface **out)
+{
+    struct dcomp_surface_factory *factory = impl_from_IDCompositionSurfaceFactory(iface);
+    struct dcomp_surface *surface;
+
+    TRACE("factory=%p %ux%u fmt=%u alpha=%u\n", factory, width, height, format, alpha);
+    if (!out) return E_POINTER;
+    *out = NULL;
+
+    if (!(surface = dcomp_surface_create(factory->device, factory->d3d11_device,
+                                         width, height, format, alpha)))
+        return E_OUTOFMEMORY;
+
+    *out = &surface->IDCompositionSurface_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI surface_factory_CreateVirtualSurface(IDCompositionSurfaceFactory *iface,
+                                                           UINT width, UINT height,
+                                                           DXGI_FORMAT format,
+                                                           DXGI_ALPHA_MODE alpha,
+                                                           IDCompositionVirtualSurface **out)
+{
+    FIXME("stub factory=%p %ux%u fmt=%u alpha=%u\n", iface, width, height, format, alpha);
+    if (out) *out = NULL;
+    return E_NOTIMPL;
+}
+
+static const IDCompositionSurfaceFactoryVtbl dcomp_surface_factory_vtbl =
+{
+    surface_factory_QueryInterface,
+    surface_factory_AddRef,
+    surface_factory_Release,
+    surface_factory_CreateSurface,
+    surface_factory_CreateVirtualSurface,
+};
+
