From c70dcba8ef0bf8a9477805b5469fc2b416262758 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Wed, 26 Aug 2026 00:18:52 -0700
Subject: [PATCH] dcomp: Clip composition hosts with window regions.

DirectComposition clips a visual without changing the content origin. The
Wayland presentation bridge used the clip rectangle to move and shrink the
host window, which effectively displayed the wrong source rectangle from the
swap chain or IDCompositionSurface.

Keep the host at the visual's full content bounds and apply the target and
visual clips with SetWindowRgn() instead. Clips accumulate down the tree, so
a clip set on an ancestor visual limits its descendants as well.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/Makefile.in |  2 +-
 dlls/dcomp/device.c    | 82 +++++++++++++++++++++++++++++-------------
 2 files changed, 58 insertions(+), 26 deletions(-)

diff --git a/dlls/dcomp/Makefile.in b/dlls/dcomp/Makefile.in
index 049b0462f17..b63cd1a3ef8 100644
--- a/dlls/dcomp/Makefile.in
+++ b/dlls/dcomp/Makefile.in
@@ -1,5 +1,5 @@
 MODULE    = dcomp.dll
-IMPORTS   = dxguid uuid d3d11 dxgi user32
+IMPORTS   = dxguid uuid d3d11 dxgi user32 gdi32
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index 0a8ac7a86f0..d335e730ad1 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -28,6 +28,7 @@
 #include "windef.h"
 #include "winbase.h"
 #include "winuser.h"
+#include "wingdi.h"
 #include "objbase.h"
 #include "dxgi1_2.h"
 #include "d3d11.h"
@@ -140,6 +141,8 @@ struct dcomp_target
 struct dcomp_placement
 {
     int x, y;
+    BOOL has_clip;
+    RECT clip;
 };
 
 /* State of the walk over one target during a commit. */
@@ -1140,9 +1143,23 @@ static struct dcomp_placement dcomp_visual_placement(const struct dcomp_placemen
         const struct dcomp_visual *visual)
 {
     struct dcomp_placement placement = *parent;
+    RECT clip;
 
     placement.x += round_float(visual->offset_x + visual->transform.dx);
     placement.y += round_float(visual->offset_y + visual->transform.dy);
+
+    if (visual->has_clip)
+    {
+        SetRect(&clip, round_float(visual->clip.left), round_float(visual->clip.top),
+                round_float(visual->clip.right), round_float(visual->clip.bottom));
+        OffsetRect(&clip, placement.x, placement.y);
+        if (placement.has_clip)
+            IntersectRect(&placement.clip, &placement.clip, &clip);
+        else
+            placement.clip = clip;
+        placement.has_clip = TRUE;
+    }
+
     return placement;
 }
 
@@ -1151,24 +1168,27 @@ static BOOL dcomp_visual_swapchain_desc(const struct dcomp_visual *visual, DXGI_
     return visual->swapchain && SUCCEEDED(IDXGISwapChain1_GetDesc1(visual->swapchain, desc));
 }
 
-static BOOL dcomp_visual_host_rect(HWND hwnd, const struct dcomp_placement *placement,
-        const struct dcomp_visual *visual, UINT width, UINT height, RECT *rect)
+static BOOL dcomp_visual_host_clip(HWND hwnd, const struct dcomp_placement *placement,
+        UINT width, UINT height, RECT *clip)
 {
-    RECT clip;
+    RECT rect;
 
-    SetRect(rect, placement->x, placement->y, placement->x + width, placement->y + height);
+    SetRect(clip, 0, 0, width, height);
 
-    if (visual->has_clip)
+    if (GetClientRect(hwnd, &rect))
     {
-        SetRect(&clip, round_float(visual->clip.left), round_float(visual->clip.top),
-                round_float(visual->clip.right), round_float(visual->clip.bottom));
-        OffsetRect(&clip, placement->x, placement->y);
-        if (!IntersectRect(rect, rect, &clip))
+        OffsetRect(&rect, -placement->x, -placement->y);
+        if (!IntersectRect(clip, clip, &rect))
             return FALSE;
     }
 
-    if (GetClientRect(hwnd, &clip) && !IntersectRect(rect, rect, &clip))
-        return FALSE;
+    if (placement->has_clip)
+    {
+        rect = placement->clip;
+        OffsetRect(&rect, -placement->x, -placement->y);
+        if (!IntersectRect(clip, clip, &rect))
+            return FALSE;
+    }
 
     return TRUE;
 }
@@ -1177,18 +1197,17 @@ static BOOL dcomp_visual_update_host(struct dcomp_commit *commit, struct dcomp_v
         const struct dcomp_placement *placement, UINT width, UINT height)
 {
     HWND target_hwnd = commit->target->hwnd;
-    BOOL created = FALSE, moved, restack;
+    BOOL created = FALSE, moved, restack, need_region;
+    HRGN region = NULL;
     UINT flags;
-    RECT rect;
+    RECT clip;
 
-    if (!width || !height || !dcomp_visual_host_rect(target_hwnd, placement, visual, width, height, &rect))
+    if (!width || !height || !dcomp_visual_host_clip(target_hwnd, placement, width, height, &clip))
     {
         TRACE("Visual %p has no visible area on target %p.\n", visual, target_hwnd);
         dcomp_visual_teardown_host(visual);
         return FALSE;
     }
-    width = rect.right - rect.left;
-    height = rect.bottom - rect.top;
 
     if (visual->host_hwnd && visual->host_parent != target_hwnd)
         dcomp_visual_teardown_host(visual);
@@ -1197,15 +1216,15 @@ static BOOL dcomp_visual_update_host(struct dcomp_commit *commit, struct dcomp_v
     {
         if (!(visual->host_hwnd = CreateWindowExW(WS_EX_NOACTIVATE | WS_EX_NOREDIRECTIONBITMAP,
                 dcomp_host_class_name, NULL, WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_CLIPSIBLINGS,
-                rect.left, rect.top, width, height, target_hwnd, NULL, dcomp_instance, NULL)))
+                placement->x, placement->y, width, height, target_hwnd, NULL, dcomp_instance, NULL)))
         {
             WARN("Failed to create host window for visual %p, error %lu.\n", visual, GetLastError());
             return FALSE;
         }
         TRACE("Created host window %p for visual %p on target %p.\n", visual->host_hwnd, visual, target_hwnd);
         visual->host_parent = target_hwnd;
-        visual->host_x = rect.left;
-        visual->host_y = rect.top;
+        visual->host_x = placement->x;
+        visual->host_y = placement->y;
         visual->host_width = width;
         visual->host_height = height;
         created = TRUE;
@@ -1213,7 +1232,7 @@ static BOOL dcomp_visual_update_host(struct dcomp_commit *commit, struct dcomp_v
 
     /* Hosts are stacked in tree order. Once one of them moves in the z-order,
      * every host after it has to be placed on top again. */
-    moved = visual->host_x != rect.left || visual->host_y != rect.top
+    moved = visual->host_x != placement->x || visual->host_y != placement->y
             || visual->host_width != width || visual->host_height != height;
     restack = created || commit->restack || visual->host_below != commit->host_below;
     if (moved || restack)
@@ -1223,14 +1242,14 @@ static BOOL dcomp_visual_update_host(struct dcomp_commit *commit, struct dcomp_v
             flags |= SWP_NOMOVE | SWP_NOSIZE;
         if (!restack)
             flags |= SWP_NOZORDER;
-        if (!SetWindowPos(visual->host_hwnd, HWND_TOP, rect.left, rect.top, width, height, flags))
+        if (!SetWindowPos(visual->host_hwnd, HWND_TOP, placement->x, placement->y, width, height, flags))
         {
             WARN("Failed to position host window %p, error %lu.\n", visual->host_hwnd, GetLastError());
         }
         else
         {
-            visual->host_x = rect.left;
-            visual->host_y = rect.top;
+            visual->host_x = placement->x;
+            visual->host_y = placement->y;
             visual->host_width = width;
             visual->host_height = height;
             visual->host_below = commit->host_below;
@@ -1240,6 +1259,18 @@ static BOOL dcomp_visual_update_host(struct dcomp_commit *commit, struct dcomp_v
     }
     commit->host_below = visual->host_hwnd;
 
+    need_region = clip.left || clip.top || clip.right != (LONG)width || clip.bottom != (LONG)height;
+    if (need_region && !(region = CreateRectRgnIndirect(&clip)))
+    {
+        WARN("Failed to create clip region %s.\n", wine_dbgstr_rect(&clip));
+    }
+    else if (!SetWindowRgn(visual->host_hwnd, region, TRUE))
+    {
+        WARN("Failed to set clip region %s on host window %p.\n", wine_dbgstr_rect(&clip), visual->host_hwnd);
+        if (region)
+            DeleteObject(region);
+    }
+
     return TRUE;
 }
 
@@ -1276,8 +1307,9 @@ static void dcomp_visual_bind(struct dcomp_commit *commit, struct dcomp_visual *
         needs_host = desc.AlphaMode != DXGI_ALPHA_MODE_IGNORE;
     }
 
-    TRACE("visual %p, content %p, placement (%d, %d), size %ux%u, target %p.\n",
-            visual, visual->content, placement.x, placement.y, width, height, target->hwnd);
+    TRACE("visual %p, content %p, placement (%d, %d), size %ux%u, clip %s, target %p.\n",
+            visual, visual->content, placement.x, placement.y, width, height,
+            placement.has_clip ? wine_dbgstr_rect(&placement.clip) : "none", target->hwnd);
 
     if (!visual->surface && !visual->swapchain)
     {
