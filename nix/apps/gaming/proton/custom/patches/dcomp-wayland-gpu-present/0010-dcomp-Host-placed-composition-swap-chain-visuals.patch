From bb74e55476adaf27de469fa60ff7fd3ec688bf00 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Wed, 26 Aug 2026 00:18:52 -0700
Subject: [PATCH] dcomp: Host placed composition swap-chain visuals.

DirectComposition visual placement and stacking are independent from the
swap-chain alpha mode. Opaque child visuals still need their own
presentation target so their offset, clip and z-order are preserved.

Keep swap chains at the origin of the target on the target window itself.
That avoids replacing the main window with a child presentation surface,
while still giving CEF dialog, popup and form-control layers their own
positioned host windows.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 51 ++++++++++++++++++++++++++++-----------------
 1 file changed, 32 insertions(+), 19 deletions(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index d335e730ad1..54f8c270d0e 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -1163,9 +1163,36 @@ static struct dcomp_placement dcomp_visual_placement(const struct dcomp_placemen
     return placement;
 }
 
-static BOOL dcomp_visual_swapchain_desc(const struct dcomp_visual *visual, DXGI_SWAP_CHAIN_DESC1 *desc)
+static void dcomp_visual_content_size(const struct dcomp_visual *visual, UINT *width, UINT *height)
 {
-    return visual->swapchain && SUCCEEDED(IDXGISwapChain1_GetDesc1(visual->swapchain, desc));
+    DXGI_SWAP_CHAIN_DESC1 desc;
+
+    *width = 0;
+    *height = 0;
+
+    if (visual->surface)
+    {
+        *width = visual->surface->width;
+        *height = visual->surface->height;
+    }
+    else if (visual->swapchain && SUCCEEDED(IDXGISwapChain1_GetDesc1(visual->swapchain, &desc)))
+    {
+        *width = desc.Width;
+        *height = desc.Height;
+    }
+}
+
+/* Content at the origin of a target may be presented to the target window
+ * itself; everything else needs a child window positioned and clipped for it. */
+static BOOL dcomp_visual_needs_host(const struct dcomp_visual *visual, const struct dcomp_placement *placement)
+{
+    if (visual->surface)
+        return TRUE;
+    if (placement->x || placement->y || placement->has_clip)
+        return TRUE;
+    if (!dcomp_matrix_is_translation(&visual->transform))
+        return TRUE;
+    return visual->parent && visual->parent->parent;
 }
 
 static BOOL dcomp_visual_host_clip(HWND hwnd, const struct dcomp_placement *placement,
@@ -1287,25 +1314,11 @@ static void dcomp_visual_bind(struct dcomp_commit *commit, struct dcomp_visual *
 {
     struct dcomp_target *target = commit->target;
     struct dcomp_placement placement;
-    DXGI_SWAP_CHAIN_DESC1 desc = {0};
     struct dcomp_visual *child;
-    UINT width = 0, height = 0;
-    BOOL needs_host = FALSE;
+    UINT width, height;
 
     placement = dcomp_visual_placement(parent_placement, visual);
-    if (visual->surface)
-    {
-        width = visual->surface->width;
-        height = visual->surface->height;
-        needs_host = TRUE;
-    }
-    else if (dcomp_visual_swapchain_desc(visual, &desc))
-    {
-        width = desc.Width;
-        height = desc.Height;
-        /* Opaque content may be presented to the target window itself. */
-        needs_host = desc.AlphaMode != DXGI_ALPHA_MODE_IGNORE;
-    }
+    dcomp_visual_content_size(visual, &width, &height);
 
     TRACE("visual %p, content %p, placement (%d, %d), size %ux%u, clip %s, target %p.\n",
             visual, visual->content, placement.x, placement.y, width, height,
@@ -1316,7 +1329,7 @@ static void dcomp_visual_bind(struct dcomp_commit *commit, struct dcomp_visual *
         if (visual->host_hwnd)
             dcomp_visual_teardown_host(visual);
     }
-    else if (needs_host)
+    else if (dcomp_visual_needs_host(visual, &placement))
     {
         if (!dcomp_visual_update_host(commit, visual, &placement, width, height))
         {
