index a0dda55..0f7454d 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -86,6 +86,7 @@ struct dcomp_device
 struct dcomp_surface
 {
     IDCompositionSurface IDCompositionSurface_iface;
+    IDCompositionVirtualSurface IDCompositionVirtualSurface_iface;
     LONG refcount;
     struct dcomp_device *device;
     ID3D11Device *d3d11_device;
@@ -93,6 +94,7 @@ struct dcomp_surface
     UINT width, height;
     DXGI_FORMAT format;
     DXGI_ALPHA_MODE alpha_mode;
+    BOOL virtual_surface;
 
     ID3D11Texture2D *texture;
     BOOL in_draw;
@@ -200,6 +202,11 @@ static inline struct dcomp_surface *impl_from_IDCompositionSurface(IDComposition
     return CONTAINING_RECORD(iface, struct dcomp_surface, IDCompositionSurface_iface);
 }
 
+static inline struct dcomp_surface *impl_from_IDCompositionVirtualSurface(IDCompositionVirtualSurface *iface)
+{
+    return CONTAINING_RECORD(iface, struct dcomp_surface, IDCompositionVirtualSurface_iface);
+}
+
 static inline struct dcomp_surface_factory *impl_from_IDCompositionSurfaceFactory(IDCompositionSurfaceFactory *iface)
 {
     return CONTAINING_RECORD(iface, struct dcomp_surface_factory, IDCompositionSurfaceFactory_iface);
@@ -246,6 +253,16 @@ static BOOL dcomp_matrix_is_translation(const D2D_MATRIX_3X2_F *matrix)
     return matrix->m11 == 1.0f && matrix->m12 == 0.0f && matrix->m21 == 0.0f && matrix->m22 == 1.0f;
 }
 
+static void dcomp_box_from_rect(D3D11_BOX *box, const RECT *rect)
+{
+    box->left = rect->left;
+    box->top = rect->top;
+    box->front = 0;
+    box->right = rect->right;
+    box->bottom = rect->bottom;
+    box->back = 1;
+}
+
 static LRESULT CALLBACK dcomp_host_wndproc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
 {
     PAINTSTRUCT ps;
@@ -469,6 +486,13 @@ static HRESULT dcomp_surface_query_interface(struct dcomp_surface *surface, REFI
         return S_OK;
     }
 
+    if (surface->virtual_surface && IsEqualGUID(iid, &IID_IDCompositionVirtualSurface))
+    {
+        IDCompositionSurface_AddRef(&surface->IDCompositionSurface_iface);
+        *out = &surface->IDCompositionVirtualSurface_iface;
+        return S_OK;
+    }
+
     WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
     *out = NULL;
     return E_NOINTERFACE;
@@ -617,12 +641,70 @@ static HRESULT WINAPI surface_ResumeDraw(IDCompositionSurface *iface)
     return S_OK;
 }
 
+static BOOL dcomp_surface_scroll_rects(const struct dcomp_surface *surface, const RECT *scroll,
+        const RECT *clip, int offset_x, int offset_y, RECT *src, RECT *dst)
+{
+    RECT bounds;
+
+    SetRect(&bounds, 0, 0, surface->width, surface->height);
+    if (!IntersectRect(src, scroll ? scroll : &bounds, &bounds))
+        return FALSE;
+
+    *dst = *src;
+    OffsetRect(dst, offset_x, offset_y);
+    if (clip && !IntersectRect(dst, dst, clip))
+        return FALSE;
+    if (!IntersectRect(dst, dst, &bounds))
+        return FALSE;
+
+    *src = *dst;
+    OffsetRect(src, -offset_x, -offset_y);
+    return TRUE;
+}
+
 static HRESULT WINAPI surface_Scroll(IDCompositionSurface *iface, const RECT *scroll,
         const RECT *clip, int offset_x, int offset_y)
 {
-    FIXME("iface %p, scroll %s, clip %s, offset_x %d, offset_y %d stub!\n",
+    struct dcomp_surface *surface = impl_from_IDCompositionSurface(iface);
+    ID3D11DeviceContext *context;
+    D3D11_TEXTURE2D_DESC desc;
+    ID3D11Texture2D *copy;
+    RECT src, dst;
+    D3D11_BOX box;
+    HRESULT hr;
+
+    TRACE("iface %p, scroll %s, clip %s, offset_x %d, offset_y %d.\n",
             iface, wine_dbgstr_rect(scroll), wine_dbgstr_rect(clip), offset_x, offset_y);
 
+    if (surface->in_draw || surface->suspended)
+        return DCOMPOSITION_ERROR_SURFACE_BEING_RENDERED;
+    if (!surface->texture)
+        return S_OK;
+    if (!dcomp_surface_scroll_rects(surface, scroll, clip, offset_x, offset_y, &src, &dst))
+        return S_OK;
+
+    /* Source and destination may overlap, so copy through a temporary texture. */
+    ID3D11Texture2D_GetDesc(surface->texture, &desc);
+    desc.Width = dst.right - dst.left;
+    desc.Height = dst.bottom - dst.top;
+    desc.BindFlags = 0;
+    desc.MiscFlags = 0;
+    if (FAILED(hr = ID3D11Device_CreateTexture2D(surface->d3d11_device, &desc, NULL, &copy)))
+    {
+        WARN("Failed to create scroll texture for surface %p, hr %#lx.\n", surface, hr);
+        return hr;
+    }
+
+    dcomp_box_from_rect(&box, &src);
+    ID3D11Device_GetImmediateContext(surface->d3d11_device, &context);
+    ID3D11DeviceContext_CopySubresourceRegion(context, (ID3D11Resource *)copy, 0, 0, 0, 0,
+            (ID3D11Resource *)surface->texture, 0, &box);
+    ID3D11DeviceContext_CopySubresourceRegion(context, (ID3D11Resource *)surface->texture, 0,
+            dst.left, dst.top, 0, (ID3D11Resource *)copy, 0, NULL);
+    ID3D11DeviceContext_Release(context);
+    ID3D11Texture2D_Release(copy);
+
+    surface->dirty = TRUE;
     return S_OK;
 }
 
@@ -638,9 +720,130 @@ static const IDCompositionSurfaceVtbl dcomp_surface_vtbl =
     surface_Scroll,
 };
 
+static HRESULT WINAPI virtual_surface_QueryInterface(IDCompositionVirtualSurface *iface, REFIID iid, void **out)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    return dcomp_surface_query_interface(surface, iid, out);
+}
+
+static ULONG WINAPI virtual_surface_AddRef(IDCompositionVirtualSurface *iface)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+
+    return surface_AddRef(&surface->IDCompositionSurface_iface);
+}
+
+static ULONG WINAPI virtual_surface_Release(IDCompositionVirtualSurface *iface)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+
+    return surface_Release(&surface->IDCompositionSurface_iface);
+}
+
+static HRESULT WINAPI virtual_surface_BeginDraw(IDCompositionVirtualSurface *iface, const RECT *rect,
+        REFIID iid, void **object, POINT *offset)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+
+    return surface_BeginDraw(&surface->IDCompositionSurface_iface, rect, iid, object, offset);
+}
+
+static HRESULT WINAPI virtual_surface_EndDraw(IDCompositionVirtualSurface *iface)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+
+    return surface_EndDraw(&surface->IDCompositionSurface_iface);
+}
+
+static HRESULT WINAPI virtual_surface_SuspendDraw(IDCompositionVirtualSurface *iface)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+
+    return surface_SuspendDraw(&surface->IDCompositionSurface_iface);
+}
+
+static HRESULT WINAPI virtual_surface_ResumeDraw(IDCompositionVirtualSurface *iface)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+
+    return surface_ResumeDraw(&surface->IDCompositionSurface_iface);
+}
+
+static HRESULT WINAPI virtual_surface_Scroll(IDCompositionVirtualSurface *iface, const RECT *scroll,
+        const RECT *clip, int offset_x, int offset_y)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+
+    return surface_Scroll(&surface->IDCompositionSurface_iface, scroll, clip, offset_x, offset_y);
+}
+
+static HRESULT WINAPI virtual_surface_Resize(IDCompositionVirtualSurface *iface, UINT width, UINT height)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    ID3D11DeviceContext *context;
+    ID3D11Texture2D *texture;
+    D3D11_BOX box;
+    RECT rect;
+    HRESULT hr;
+
+    TRACE("iface %p, width %u, height %u.\n", iface, width, height);
+
+    if (!width || !height)
+        return E_INVALIDARG;
+    if (surface->in_draw || surface->suspended)
+        return DCOMPOSITION_ERROR_SURFACE_BEING_RENDERED;
+    if (surface->width == width && surface->height == height)
+        return S_OK;
+
+    if (surface->texture)
+    {
+        /* Keep the content that still fits. */
+        if (FAILED(hr = dcomp_surface_create_texture(surface, width, height, &texture)))
+            return hr;
+
+        SetRect(&rect, 0, 0, min(width, surface->width), min(height, surface->height));
+        dcomp_box_from_rect(&box, &rect);
+        ID3D11Device_GetImmediateContext(surface->d3d11_device, &context);
+        ID3D11DeviceContext_CopySubresourceRegion(context, (ID3D11Resource *)texture, 0, 0, 0, 0,
+                (ID3D11Resource *)surface->texture, 0, &box);
+        ID3D11DeviceContext_Release(context);
+        ID3D11Texture2D_Release(surface->texture);
+        surface->texture = texture;
+    }
+
+    surface->width = width;
+    surface->height = height;
+    surface->dirty = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI virtual_surface_Trim(IDCompositionVirtualSurface *iface, const RECT *rectangles, UINT count)
+{
+    TRACE("iface %p, rectangles %p, count %u.\n", iface, rectangles, count);
+
+    return S_OK;
+}
+
+static const IDCompositionVirtualSurfaceVtbl dcomp_virtual_surface_vtbl =
+{
+    virtual_surface_QueryInterface,
+    virtual_surface_AddRef,
+    virtual_surface_Release,
+    virtual_surface_BeginDraw,
+    virtual_surface_EndDraw,
+    virtual_surface_SuspendDraw,
+    virtual_surface_ResumeDraw,
+    virtual_surface_Scroll,
+    virtual_surface_Resize,
+    virtual_surface_Trim,
+};
+
