         UINT width, UINT height, DXGI_FORMAT format, DXGI_ALPHA_MODE alpha_mode,
-        struct dcomp_surface **surface)
+        BOOL virtual_surface, struct dcomp_surface **surface)
 {
     struct dcomp_surface *object;
 
@@ -648,6 +851,7 @@ static HRESULT dcomp_surface_create(struct dcomp_device *device, ID3D11Device *d
         return E_OUTOFMEMORY;
 
     object->IDCompositionSurface_iface.lpVtbl = &dcomp_surface_vtbl;
+    object->IDCompositionVirtualSurface_iface.lpVtbl = &dcomp_virtual_surface_vtbl;
     object->refcount = 1;
     object->device = device;
     IDCompositionDesktopDevice_AddRef(&device->IDCompositionDesktopDevice_iface);
@@ -657,6 +861,7 @@ static HRESULT dcomp_surface_create(struct dcomp_device *device, ID3D11Device *d
     object->height = height;
     object->format = format == DXGI_FORMAT_UNKNOWN ? DXGI_FORMAT_B8G8R8A8_UNORM : format;
     object->alpha_mode = alpha_mode == DXGI_ALPHA_MODE_UNSPECIFIED ? DXGI_ALPHA_MODE_PREMULTIPLIED : alpha_mode;
+    object->virtual_surface = virtual_surface;
 
     TRACE("Created surface %p.\n", object);
     *surface = object;
@@ -724,7 +929,7 @@ static HRESULT WINAPI surface_factory_CreateSurface(IDCompositionSurfaceFactory
         return E_POINTER;
 
     if (FAILED(hr = dcomp_surface_create(factory->device, factory->d3d11_device,
-            width, height, format, alpha_mode, &object)))
+            width, height, format, alpha_mode, FALSE, &object)))
         return hr;
 
     *surface = &object->IDCompositionSurface_iface;
@@ -734,10 +939,22 @@ static HRESULT WINAPI surface_factory_CreateSurface(IDCompositionSurfaceFactory
 static HRESULT WINAPI surface_factory_CreateVirtualSurface(IDCompositionSurfaceFactory *iface, UINT width, UINT height,
         DXGI_FORMAT format, DXGI_ALPHA_MODE alpha_mode, IDCompositionVirtualSurface **surface)
 {
