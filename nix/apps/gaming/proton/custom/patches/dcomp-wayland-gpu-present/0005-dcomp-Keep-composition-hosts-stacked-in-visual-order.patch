From ebe41a162ecaf700904af77dccab6c651d6518d0 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Wed, 26 Aug 2026 00:18:52 -0700
Subject: [PATCH] dcomp: Keep composition hosts stacked in visual order.

Host windows are created on top of their siblings and were only restacked
when their geometry changed, so reordering the visual tree left hosts in the
wrong z-order and transient popup layers could end up behind older ones.

Remember which host was placed before each host during a commit and put a
host back on top whenever that changed; every host after it in tree order
follows. Commits that do not reorder the tree do not touch the z-order, so
Wayland child surfaces are not reconfigured for nothing.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 49 ++++++++++++++++++++++++++++++++++++---------
 1 file changed, 39 insertions(+), 10 deletions(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index 1eb59583d3d..da928775576 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -113,6 +113,7 @@ struct dcomp_visual
 
     HWND host_hwnd;
     HWND host_parent;
+    HWND host_below;
     int host_x, host_y;
     UINT host_width, host_height;
 };
@@ -135,6 +136,14 @@ struct dcomp_placement
     int x, y;
 };
 
+/* State of the walk over one target during a commit. */
+struct dcomp_commit
+{
+    struct dcomp_target *target;
+    HWND host_below;
+    BOOL restack;
+};
+
 static const IDCompositionVisual2Vtbl dcomp_visual_vtbl;
 
 static inline struct dcomp_device *impl_from_IDCompositionDesktopDevice(IDCompositionDesktopDevice *iface)
@@ -454,6 +463,7 @@ static void dcomp_visual_bind_swapchain(struct dcomp_visual *visual, HWND target
 static void dcomp_visual_reset_host_state(struct dcomp_visual *visual)
 {
     visual->host_parent = NULL;
+    visual->host_below = NULL;
     visual->host_x = 0;
     visual->host_y = 0;
     visual->host_width = 0;
@@ -1002,10 +1012,12 @@ static BOOL dcomp_visual_host_rect(HWND hwnd, const struct dcomp_placement *plac
     return TRUE;
 }
 
-static BOOL dcomp_visual_update_host(struct dcomp_target *target, struct dcomp_visual *visual,
+static BOOL dcomp_visual_update_host(struct dcomp_commit *commit, struct dcomp_visual *visual,
         const struct dcomp_placement *placement, UINT width, UINT height)
 {
-    HWND target_hwnd = target->hwnd;
+    HWND target_hwnd = commit->target->hwnd;
+    BOOL created = FALSE, moved, restack;
+    UINT flags;
     RECT rect;
 
     if (!width || !height || !dcomp_visual_host_rect(target_hwnd, placement, visual, width, height, &rect))
@@ -1035,12 +1047,22 @@ static BOOL dcomp_visual_update_host(struct dcomp_target *target, struct dcomp_v
         visual->host_y = rect.top;
         visual->host_width = width;
         visual->host_height = height;
+        created = TRUE;
     }
-    else if (visual->host_x != rect.left || visual->host_y != rect.top
-            || visual->host_width != width || visual->host_height != height)
+
+    /* Hosts are stacked in tree order. Once one of them moves in the z-order,
+     * every host after it has to be placed on top again. */
+    moved = visual->host_x != rect.left || visual->host_y != rect.top
+            || visual->host_width != width || visual->host_height != height;
+    restack = created || commit->restack || visual->host_below != commit->host_below;
+    if (moved || restack)
     {
-        if (!SetWindowPos(visual->host_hwnd, HWND_TOP, rect.left, rect.top, width, height,
-                SWP_NOACTIVATE | SWP_NOOWNERZORDER | SWP_SHOWWINDOW))
+        flags = SWP_NOACTIVATE | SWP_NOOWNERZORDER | SWP_SHOWWINDOW;
+        if (!moved)
+            flags |= SWP_NOMOVE | SWP_NOSIZE;
+        if (!restack)
+            flags |= SWP_NOZORDER;
+        if (!SetWindowPos(visual->host_hwnd, HWND_TOP, rect.left, rect.top, width, height, flags))
         {
             WARN("Failed to position host window %p, error %lu.\n", visual->host_hwnd, GetLastError());
         }
@@ -1050,15 +1072,20 @@ static BOOL dcomp_visual_update_host(struct dcomp_target *target, struct dcomp_v
             visual->host_y = rect.top;
             visual->host_width = width;
             visual->host_height = height;
+            visual->host_below = commit->host_below;
         }
+        if (restack)
+            commit->restack = TRUE;
     }
+    commit->host_below = visual->host_hwnd;
 
     return TRUE;
 }
 
-static void dcomp_visual_bind(struct dcomp_target *target, struct dcomp_visual *visual,
+static void dcomp_visual_bind(struct dcomp_commit *commit, struct dcomp_visual *visual,
         const struct dcomp_placement *parent_placement)
 {
+    struct dcomp_target *target = commit->target;
     struct dcomp_placement placement;
     DXGI_SWAP_CHAIN_DESC1 desc = {0};
     struct dcomp_visual *child;
@@ -1084,7 +1111,7 @@ static void dcomp_visual_bind(struct dcomp_target *target, struct dcomp_visual *
     }
     else if (needs_host)
     {
-        if (!dcomp_visual_update_host(target, visual, &placement, width, height))
+        if (!dcomp_visual_update_host(commit, visual, &placement, width, height))
             dcomp_visual_bind_swapchain(visual, target->hwnd, target->hwnd);
         else
             dcomp_visual_bind_swapchain(visual, visual->host_hwnd, target->hwnd);
@@ -1097,7 +1124,7 @@ static void dcomp_visual_bind(struct dcomp_target *target, struct dcomp_visual *
     }
 
     LIST_FOR_EACH_ENTRY(child, &visual->children, struct dcomp_visual, child_entry)
-        dcomp_visual_bind(target, child, &placement);
+        dcomp_visual_bind(commit, child, &placement);
 }
 
 static HRESULT WINAPI device_QueryInterface(IDCompositionDesktopDevice *iface, REFIID iid, void **out)
@@ -1160,9 +1187,11 @@ static HRESULT WINAPI device_Commit(IDCompositionDesktopDevice *iface)
     LIST_FOR_EACH_ENTRY(target, &device->targets, struct dcomp_target, entry)
     {
         struct dcomp_placement placement = {0};
+        struct dcomp_commit commit = {0};
 
+        commit.target = target;
         if (target->root)
-            dcomp_visual_bind(target, target->root, &placement);
+            dcomp_visual_bind(&commit, target->root, &placement);
     }
 
     QueryPerformanceCounter(&device->last_frame_time);
