From 4077c1f9087e0905acfca0b00da81e55967e0a85 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Wed, 26 Aug 2026 00:18:52 -0700
Subject: [PATCH 04/19] dcomp: Make composition host windows presentation-only.

The host window exists only to give DXVK a native target for a composition
swap chain. It should not have its own Win32 backing contents competing with
the swap chain surface.

Use WS_EX_NOREDIRECTIONBITMAP, as DirectComposition hosts commonly do on
Windows, and consume erase and paint messages without drawing. That prevents
stale host window contents from briefly showing through while the GPU-backed
composition surface is being resized, moved or rebound.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index 2414997..1eb5958 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -195,6 +195,20 @@ static BOOL dcomp_matrix_is_translation(const D2D_MATRIX_3X2_F *matrix)
 
 static LRESULT CALLBACK dcomp_host_wndproc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
 {
+    PAINTSTRUCT ps;
+
+    switch (msg)
+    {
+        case WM_ERASEBKGND:
+            return 1;
+
+        case WM_PAINT:
+            /* The host only lends its surface to a composition swap chain. */
+            BeginPaint(hwnd, &ps);
+            EndPaint(hwnd, &ps);
+            return 0;
+    }
+
     return DefWindowProcW(hwnd, msg, wparam, lparam);
 }
 
@@ -1008,7 +1022,7 @@ static BOOL dcomp_visual_update_host(struct dcomp_target *target, struct dcomp_v
 
     if (!visual->host_hwnd)
     {
-        if (!(visual->host_hwnd = CreateWindowExW(WS_EX_NOACTIVATE,
+        if (!(visual->host_hwnd = CreateWindowExW(WS_EX_NOACTIVATE | WS_EX_NOREDIRECTIONBITMAP,
                 dcomp_host_class_name, NULL, WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_CLIPSIBLINGS,
                 rect.left, rect.top, width, height, target_hwnd, NULL, dcomp_instance, NULL)))
         {
