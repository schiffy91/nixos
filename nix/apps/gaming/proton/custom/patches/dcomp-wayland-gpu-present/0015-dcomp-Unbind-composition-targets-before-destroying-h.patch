From b4688cba14ea25c0109c57dc25e099a64a3e24af Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Wed, 26 Aug 2026 00:18:52 -0700
Subject: [PATCH] dcomp: Unbind composition targets before destroying hosts.

Composition hosts are ordinary windows used as presentation targets for
DComp swap-chain and surface content. When a host window is destroyed or
replaced, retarget the DXVK composition swap chain back to its dummy target
first so the presenter never keeps a stale Wayland surface association for
a dead window.

Also avoid falling back to the target window when a visual requires a child
host for placement, clipping or surface presentation but no valid host can
be created. Leaving the content unbound is preferable to presenting it at
the wrong location or with the wrong clipping.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index 0f7454dd1e1..03b80adc517 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -1037,6 +1037,8 @@ static void dcomp_visual_reset_host_state(struct dcomp_visual *visual)
  * thread leaves the window to the next commit. */
 static void dcomp_visual_teardown_host(struct dcomp_visual *visual, BOOL defer)
 {
+    dcomp_visual_unbind_content(visual);
+
     if (visual->host_hwnd)
     {
         TRACE("Destroying host window %p of visual %p.\n", visual->host_hwnd, visual);
@@ -1116,7 +1118,6 @@ static ULONG WINAPI visual_Release(IDCompositionVisual2 *iface)
             dcomp_visual_unlink(child);
             IDCompositionVisual2_Release(&child->IDCompositionVisual2_iface);
         }
-        dcomp_visual_unbind_content(visual);
         dcomp_visual_teardown_host(visual, TRUE);
         LeaveCriticalSection(&device->cs);
 
@@ -1782,10 +1783,7 @@ static void dcomp_visual_bind(struct dcomp_commit *commit, struct dcomp_visual *
     else if (dcomp_visual_needs_host(visual, &placement))
     {
         if (!dcomp_visual_update_host(commit, visual, &placement, width, height))
-        {
-            if (visual->swapchain)
-                dcomp_visual_bind_swapchain(visual, target->hwnd, target->hwnd);
-        }
+            dcomp_visual_unbind_content(visual);
         else if (visual->surface)
             dcomp_visual_present_surface(visual, target->hwnd);
         else
