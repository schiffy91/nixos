From efb6a66313c8c080d277c0039f18adafe38758e5 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Wed, 26 Aug 2026 00:18:52 -0700
Subject: [PATCH 19/19] dcomp: Avoid hosts for unplaced child swapchains.

Battle.net's login tree wraps the real swap-chain content in a first-level
child visual with identity placement, no clip and no transform. Hosting that
visual in a Win32 child window is not useful, and on native Wayland the
child window is not a managed surface. DXVK can present to it successfully
while KWin and the user still see the black parent window.

Keep child host windows for actual placed, clipped, surface-backed or nested
composition layers, but bind unplaced first-level swap-chain wrappers
directly to the DComp target window. Only the first such visual in tree
order gets the target window; later siblings would fight it for the same
surface and get hosts instead.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index e26ff7a..f11b3b6 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -184,6 +184,7 @@ struct dcomp_commit
     struct dcomp_target *target;
     HWND host_below;
     BOOL restack;
+    BOOL direct_bound;
 };
 
 static const IDCompositionVisual2Vtbl dcomp_visual_vtbl;
@@ -1633,7 +1634,7 @@ static BOOL dcomp_visual_needs_host(const struct dcomp_visual *visual, const str
         return TRUE;
     if (!dcomp_matrix_is_translation(&visual->transform))
         return TRUE;
-    return !!visual->parent;
+    return visual->parent && visual->parent->parent;
 }
 
 static BOOL dcomp_visual_host_clip(HWND hwnd, const struct dcomp_placement *placement,
@@ -1798,7 +1799,7 @@ static void dcomp_visual_bind(struct dcomp_commit *commit, struct dcomp_visual *
         if (visual->hosted)
             dcomp_visual_teardown_host(visual, FALSE);
     }
-    else if (dcomp_visual_needs_host(visual, &placement))
+    else if (dcomp_visual_needs_host(visual, &placement) || commit->direct_bound)
     {
         if (!dcomp_visual_update_host(commit, visual, &placement, width, height))
             dcomp_visual_unbind_content(visual);
@@ -1809,10 +1810,12 @@ static void dcomp_visual_bind(struct dcomp_commit *commit, struct dcomp_visual *
     }
     else
     {
+        /* Only one swap chain can own the target window; later siblings get hosts. */
         if (visual->host_hwnd)
             dcomp_visual_teardown_host(visual, FALSE);
         dcomp_visual_bind_swapchain(visual, target->hwnd, target->hwnd);
         dcomp_visual_track_host(visual);
+        commit->direct_bound = TRUE;
     }
 
     LIST_FOR_EACH_ENTRY(child, &visual->children, struct dcomp_visual, child_entry)
-- 
