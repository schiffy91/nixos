From 6bb483deef9645c1894d458305886a7f193a063a Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Mon, 25 May 2026 16:45:00 -0700
Subject: [PATCH] winewayland.drv: Bound WM_CANCELMODE on keyboard leave

The Wayland keyboard leave handler runs while dispatching compositor
events. Sending WM_CANCELMODE synchronously from that path can block the
Wayland dispatch thread if the foreground window's owner thread is busy
destroying a window tree.

Use SendMessageTimeout semantics for the notification so a temporarily
hung target window cannot wedge the driver event loop permanently.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Signed-off-by: Alexander Schiffhauer <Alexander.Schiffhauer@gmail.com>
---
 dlls/winewayland.drv/wayland_keyboard.c |  2 +-
 dlls/winewayland.drv/waylanddrv.h       | 11 +++++++++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/dlls/winewayland.drv/wayland_keyboard.c b/dlls/winewayland.drv/wayland_keyboard.c
index 251919c..0efcef7 100644
--- a/dlls/winewayland.drv/wayland_keyboard.c
+++ b/dlls/winewayland.drv/wayland_keyboard.c
@@ -972,7 +972,7 @@ static void keyboard_handle_leave(void *private, struct wl_keyboard *wl_keyboard
     if (hwnd == NtUserGetForegroundWindow())
     {
         if (!(NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_MINIMIZE))
-            send_message(hwnd, WM_CANCELMODE, 0, 0);
+            send_message_timeout(hwnd, WM_CANCELMODE, 0, 0, SMTO_ABORTIFHUNG, 200, NULL);
 
         if (hwnd != NtUserGetForegroundWindow()) return;
 
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index 4b5d8ab..f768ee7 100644
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -558,6 +558,17 @@ void wayland_touch_deinit(void);
  */
 
 void wayland_text_input_init(void);
+static inline LRESULT send_message_timeout(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam,
+                                           UINT flags, UINT timeout, PDWORD_PTR res_ptr)
+{
+    struct send_message_timeout_params params = { .flags = flags, .timeout = timeout };
+    LRESULT res = NtUserMessageCall(hwnd, msg, wparam, lparam, &params,
+                                    NtUserSendMessageTimeout, FALSE);
+
+    if (res_ptr) *res_ptr = params.result;
+    return res;
+}
+
 void wayland_text_input_deinit(void);
 
 /**********************************************************************
