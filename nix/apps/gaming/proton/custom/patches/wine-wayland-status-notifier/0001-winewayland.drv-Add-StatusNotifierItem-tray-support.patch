+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "waylanddrv.h"
+#include "shellapi.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(systray);
+
+#ifdef SONAME_LIBDBUS_1
+
+#include <dbus/dbus.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define SNI_OBJECT_PATH "/StatusNotifierItem"
+
+struct sni_item
+{
+    struct list entry;
+    int serial;
+    char service[128];
+    char unique_service[128];
+    HWND owner_hwnd;
+    HWND window_hwnd;
+    UINT callback_message;
+    UINT id;
+    UINT version;
+    HICON image;
+    int icon_w, icon_h;
+    unsigned char *icon_argb;
+    WCHAR tiptext[128];
+};
+
+/* Mirrors explorer's private tray icon record as passed to WINE_SYSTRAY_DOCK_INSERT. */
+struct explorer_tray_icon
+{
+    struct list entry;
+    HICON image;
+    HWND owner;
+    HWND window;
+    BOOL layered;
+    HWND tooltip;
+    UINT state;
+    UINT id;
+    UINT callback_message;
+    int display;
+    WCHAR tiptext[128];
+    WCHAR info_text[256];
+    WCHAR info_title[64];
+    UINT info_flags;
+    UINT info_timeout;
+    HICON info_icon;
+    UINT version;
+};
+
+struct sni_callback
+{
+    HWND owner_hwnd;
+    HWND window_hwnd;
+    UINT callback_message;
+    UINT id;
+    UINT version;
+    UINT down_msg;
+    UINT up_msg;
+    int x;
+    int y;
+    int wheel_delta;
+    BOOL context_menu;
+};
+
+#define SNI_CHANGED_ICON    0x01
+#define SNI_CHANGED_TOOLTIP 0x02
+
+static struct list sni_list = LIST_INIT(sni_list);
+static int sni_serial;
+static pthread_mutex_t sni_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t sni_dispatch_cond = PTHREAD_COND_INITIALIZER;
+static DBusConnection *sni_conn;
+static BOOL sni_dispatch_running;
+
+static const char sni_xml[] =
+    "<!DOCTYPE node PUBLIC \"-//freedesktop//DTD D-BUS Object Introspection 1.0//EN\" "
+    "\"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd\">\n"
+    "<node>\n"
+    " <interface name=\"org.kde.StatusNotifierItem\">\n"
+    "  <property name=\"Id\" type=\"s\" access=\"read\"/>\n"
+    "  <property name=\"Category\" type=\"s\" access=\"read\"/>\n"
+    "  <property name=\"Status\" type=\"s\" access=\"read\"/>\n"
+    "  <property name=\"Title\" type=\"s\" access=\"read\"/>\n"
+    "  <property name=\"WindowId\" type=\"u\" access=\"read\"/>\n"
+    "  <property name=\"ItemIsMenu\" type=\"b\" access=\"read\"/>\n"
+    "  <property name=\"IconName\" type=\"s\" access=\"read\"/>\n"
+    "  <property name=\"IconPixmap\" type=\"a(iiay)\" access=\"read\"/>\n"
+    "  <property name=\"ToolTip\" type=\"(sa(iiay)ss)\" access=\"read\"/>\n"
+    "  <method name=\"Activate\"><arg name=\"x\" type=\"i\"/><arg name=\"y\" type=\"i\"/></method>\n"
+    "  <method name=\"SecondaryActivate\"><arg name=\"x\" type=\"i\"/><arg name=\"y\" type=\"i\"/></method>\n"
+    "  <method name=\"ContextMenu\"><arg name=\"x\" type=\"i\"/><arg name=\"y\" type=\"i\"/></method>\n"
+    "  <method name=\"Scroll\"><arg name=\"delta\" type=\"i\"/><arg name=\"orientation\" type=\"s\"/></method>\n"
+    "  <signal name=\"NewIcon\"/>\n"
+    "  <signal name=\"NewToolTip\"/>\n"
+    "  <signal name=\"NewTitle\"/>\n"
+    " </interface>\n"
+    " <interface name=\"org.freedesktop.DBus.Introspectable\">\n"
+    "  <method name=\"Introspect\"><arg name=\"xml\" type=\"s\" direction=\"out\"/></method>\n"
+    " </interface>\n"
+    " <interface name=\"org.freedesktop.DBus.Properties\">\n"
+    "  <method name=\"Get\">\n"
+    "   <arg name=\"interface\" type=\"s\" direction=\"in\"/>\n"
+    "   <arg name=\"name\" type=\"s\" direction=\"in\"/>\n"
+    "   <arg name=\"value\" type=\"v\" direction=\"out\"/>\n"
+    "  </method>\n"
+    "  <method name=\"GetAll\">\n"
+    "   <arg name=\"interface\" type=\"s\" direction=\"in\"/>\n"
+    "   <arg name=\"props\" type=\"a{sv}\" direction=\"out\"/>\n"
+    "  </method>\n"
+    " </interface>\n"
+    "</node>\n";
+
+static void utf8_from_wchar(const WCHAR *src, char *dst, size_t dst_sz)
+{
+    NTSTATUS status;
+    ULONG bytes;
+    size_t len;
+
+    if (!dst_sz) return;
+    dst[0] = 0;
+    if (!src) return;
+
+    len = lstrlenW(src) * sizeof(WCHAR);
+    status = RtlUnicodeToUTF8N(dst, dst_sz - 1, &bytes, src, len);
+    if (status)
+    {
+        dst[0] = 0;
+        return;
+    }
+    dst[bytes] = 0;
+}
+
+static unsigned char *icon_to_argb32(HICON hicon, int *w_out, int *h_out)
+{
+    ICONINFO info = {0};
+    BITMAPINFOHEADER bih = { sizeof(bih) };
+    unsigned char *argb = NULL;
+    HDC hdc;
+    BOOL has_alpha = FALSE;
+    int w, h, i;
+
+    if (!NtUserGetIconInfo(hicon, &info, NULL, NULL, NULL, 0)) return NULL;
+
+    hdc = NtUserGetDC(NULL);
+    if (!NtGdiGetDIBitsInternal(hdc, info.hbmColor, 0, 0, NULL,
+                                (BITMAPINFO *)&bih, DIB_RGB_COLORS, 0, 0))
+        goto done;
+
+    w = bih.biWidth;
+    h = abs(bih.biHeight);
+    if (w <= 0 || h <= 0) goto done;
+
+    bih.biBitCount = 32;
+    bih.biCompression = BI_RGB;
+    bih.biHeight = -h;
+    bih.biSizeImage = w * h * 4;
+
+    if (!(argb = malloc(w * h * 4))) goto done;
+    if (!NtGdiGetDIBitsInternal(hdc, info.hbmColor, 0, h, argb,
+                                (BITMAPINFO *)&bih, DIB_RGB_COLORS, w * h * 4, 0))
+    {
+        free(argb);
+        argb = NULL;
+        goto done;
+    }
+
+    for (i = 0; i < w * h; i++)
+    {
+        unsigned char b = argb[i * 4 + 0], g = argb[i * 4 + 1];
+        unsigned char r = argb[i * 4 + 2], a = argb[i * 4 + 3];
+
+        if (a) has_alpha = TRUE;
+        argb[i * 4 + 0] = a;
+        argb[i * 4 + 1] = r;
+        argb[i * 4 + 2] = g;
+        argb[i * 4 + 3] = b;
+    }
+
+    if (!has_alpha)
+    {
+        for (i = 0; i < w * h; i++)
+            if (argb[i * 4 + 1] || argb[i * 4 + 2] || argb[i * 4 + 3])
+                argb[i * 4 + 0] = 0xff;
+    }
+    *w_out = w;
+    *h_out = h;
+
+done:
+    NtUserReleaseDC(NULL, hdc);
+    if (info.hbmColor) NtGdiDeleteObjectApp(info.hbmColor);
+    if (info.hbmMask) NtGdiDeleteObjectApp(info.hbmMask);
+    return argb;
+}
+
+static struct sni_item *sni_find_by_service(const char *service)
+{
+    struct sni_item *item;
+
+    if (!service) return NULL;
+    LIST_FOR_EACH_ENTRY(item, &sni_list, struct sni_item, entry)
+        if (!strcmp(item->service, service) || !strcmp(item->unique_service, service)) return item;
+    return NULL;
+}
+
+static struct sni_item *sni_find_by_window(HWND hwnd)
+{
+    struct sni_item *item;
+
+    LIST_FOR_EACH_ENTRY(item, &sni_list, struct sni_item, entry)
+        if (item->window_hwnd == hwnd) return item;
+    return NULL;
+}
+
+static void append_pixmap(DBusMessageIter *iter, const struct sni_item *item)
+{
+    DBusMessageIter arr, st, ba;
+    dbus_int32_t w = item->icon_w, h = item->icon_h;
+
+    dbus_message_iter_open_container(iter, DBUS_TYPE_ARRAY, "(iiay)", &arr);
+    if (item->icon_argb && w > 0 && h > 0)
+    {
+        dbus_message_iter_open_container(&arr, DBUS_TYPE_STRUCT, NULL, &st);
+        dbus_message_iter_append_basic(&st, DBUS_TYPE_INT32, &w);
+        dbus_message_iter_append_basic(&st, DBUS_TYPE_INT32, &h);
+        dbus_message_iter_open_container(&st, DBUS_TYPE_ARRAY, "y", &ba);
+        dbus_message_iter_append_fixed_array(&ba, DBUS_TYPE_BYTE, &item->icon_argb, (int)(w * h * 4));
+        dbus_message_iter_close_container(&st, &ba);
+        dbus_message_iter_close_container(&arr, &st);
+    }
+    dbus_message_iter_close_container(iter, &arr);
+}
+
+static void send_tray_callback(const struct sni_callback *callback, UINT msg, BOOL wait)
+{
+    WPARAM wp = callback->id;
+    LPARAM lp = msg;
+
+    if (callback->version >= NOTIFYICON_VERSION_4)
+    {
+        wp = MAKEWPARAM((short)callback->x, (short)callback->y);
+        lp = MAKELPARAM(msg, callback->id);
+    }
+
+    NtUserMessageCall(callback->owner_hwnd, callback->callback_message, wp, lp, NULL,
+                      wait ? NtUserSendMessage : NtUserSendNotifyMessage, FALSE);
+}
+
+static void finish_tray_context_menu(const struct sni_callback *callback)
+{
+    NtUserPostMessage(callback->window_hwnd, WM_NULL, 0, 0);
+    if (callback->owner_hwnd != callback->window_hwnd)
+        NtUserPostMessage(callback->owner_hwnd, WM_NULL, 0, 0);
+}
+
+void WAYLAND_SystrayProcessCallback(void *data)
+{
+    struct sni_callback *callback = data;
+
+    if (!callback) return;
+
+    TRACE("hwnd=%p owner=%p id=%u version=%u down=%#x up=%#x pos=%d,%d wheel=%d\n",
+          callback->window_hwnd, callback->owner_hwnd, callback->id, callback->version,
+          callback->down_msg, callback->up_msg, callback->x, callback->y, callback->wheel_delta);
+
+    if (callback->wheel_delta)
+    {
+        NtUserMessageCall(callback->owner_hwnd, callback->callback_message, callback->id,
+                          MAKELPARAM(0, callback->wheel_delta), NULL, NtUserSendNotifyMessage, FALSE);
+    }
+    else
+    {
+        if (callback->context_menu) NtUserSetForegroundWindow(callback->owner_hwnd);
+        send_tray_callback(callback, callback->down_msg, callback->context_menu);
+        send_tray_callback(callback, callback->up_msg, callback->context_menu);
+        if (callback->up_msg == WM_LBUTTONUP && callback->version > 0)
+            send_tray_callback(callback, NIN_SELECT, FALSE);
+        else if (callback->up_msg == WM_RBUTTONUP)
+            send_tray_callback(callback, WM_CONTEXTMENU, TRUE);
+        if (callback->context_menu) finish_tray_context_menu(callback);
+    }
+
+    free(callback);
+}
+
+static BOOL queue_tray_callback(const struct sni_item *item, UINT down_msg, UINT up_msg,
+                                dbus_int32_t x, dbus_int32_t y, BOOL context_menu)
+{
+    struct sni_callback *callback;
+
+    if (!(callback = calloc(1, sizeof(*callback)))) return FALSE;
+    callback->owner_hwnd = item->owner_hwnd;
+    callback->window_hwnd = item->window_hwnd;
+    callback->callback_message = item->callback_message;
+    callback->id = item->id;
+    callback->version = item->version;
+    callback->down_msg = down_msg;
+    callback->up_msg = up_msg;
+    callback->x = x;
+    callback->y = y;
+    callback->context_menu = context_menu;
+
+    if (NtUserPostMessage(callback->window_hwnd, WM_WAYLAND_SNI_CALLBACK, 0, (LPARAM)callback))
+        return TRUE;
+
+    free(callback);
+    return FALSE;
+}
+
+static BOOL queue_tray_scroll(const struct sni_item *item, int delta)
+{
+    struct sni_callback *callback;
+
+    if (!(callback = calloc(1, sizeof(*callback)))) return FALSE;
+    callback->owner_hwnd = item->owner_hwnd;
+    callback->window_hwnd = item->window_hwnd;
+    callback->callback_message = item->callback_message;
+    callback->id = item->id;
+    callback->version = item->version;
+    callback->wheel_delta = delta > 0 ? WHEEL_DELTA : -WHEEL_DELTA;
+
+    if (NtUserPostMessage(callback->window_hwnd, WM_WAYLAND_SNI_CALLBACK, 0, (LPARAM)callback))
+        return TRUE;
+
+    free(callback);
+    return FALSE;
+}
+
+static BOOL append_sni_property(DBusMessageIter *iter, const struct sni_item *item, const char *name)
+{
+    DBusMessageIter var;
+
+    if (!strcmp(name, "Id") || !strcmp(name, "Category") ||
+        !strcmp(name, "Status") || !strcmp(name, "Title") ||
+        !strcmp(name, "IconName"))
+    {
+        const char *str;
+        char id_buf[64], tip[512];
+
+        if (!strcmp(name, "Id"))
+        {
+            snprintf(id_buf, sizeof(id_buf), "wine-tray-%d", item->serial);
+            str = id_buf;
+        }
+        else if (!strcmp(name, "Category")) str = "ApplicationStatus";
+        else if (!strcmp(name, "Status")) str = "Active";
+        else if (!strcmp(name, "IconName")) str = getenv("WINE_SNI_ICON_NAME");
+        else
+        {
+            utf8_from_wchar(item->tiptext, tip, sizeof(tip));
+            str = tip;
+        }
+        if (!str) str = "";
+        dbus_message_iter_open_container(iter, DBUS_TYPE_VARIANT, "s", &var);
+        dbus_message_iter_append_basic(&var, DBUS_TYPE_STRING, &str);
+        dbus_message_iter_close_container(iter, &var);
+        return TRUE;
+    }
+    if (!strcmp(name, "WindowId"))
+    {
+        dbus_uint32_t window_id = 0;
+
+        dbus_message_iter_open_container(iter, DBUS_TYPE_VARIANT, "u", &var);
+        dbus_message_iter_append_basic(&var, DBUS_TYPE_UINT32, &window_id);
+        dbus_message_iter_close_container(iter, &var);
+        return TRUE;
+    }
+    if (!strcmp(name, "ItemIsMenu"))
+    {
+        dbus_bool_t item_is_menu = FALSE;
+
+        dbus_message_iter_open_container(iter, DBUS_TYPE_VARIANT, "b", &var);
+        dbus_message_iter_append_basic(&var, DBUS_TYPE_BOOLEAN, &item_is_menu);
+        dbus_message_iter_close_container(iter, &var);
+        return TRUE;
+    }
+    if (!strcmp(name, "IconPixmap"))
+    {
+        dbus_message_iter_open_container(iter, DBUS_TYPE_VARIANT, "a(iiay)", &var);
+        append_pixmap(&var, item);
+        dbus_message_iter_close_container(iter, &var);
+        return TRUE;
+    }
+    if (!strcmp(name, "ToolTip"))
+    {
+        DBusMessageIter st;
+        const char *empty = "";
+        const char *tip_ptr;
+        char tip[512];
+
+        utf8_from_wchar(item->tiptext, tip, sizeof(tip));
+        tip_ptr = tip;
+        dbus_message_iter_open_container(iter, DBUS_TYPE_VARIANT, "(sa(iiay)ss)", &var);
+        dbus_message_iter_open_container(&var, DBUS_TYPE_STRUCT, NULL, &st);
+        dbus_message_iter_append_basic(&st, DBUS_TYPE_STRING, &empty);
+        append_pixmap(&st, item);
+        dbus_message_iter_append_basic(&st, DBUS_TYPE_STRING, &tip_ptr);
+        dbus_message_iter_append_basic(&st, DBUS_TYPE_STRING, &empty);
+        dbus_message_iter_close_container(&var, &st);
+        dbus_message_iter_close_container(iter, &var);
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void append_sni_property_dict(DBusMessageIter *dict, const struct sni_item *item, const char *name)
+{
+    DBusMessageIter entry;
+
+    dbus_message_iter_open_container(dict, DBUS_TYPE_DICT_ENTRY, NULL, &entry);
+    dbus_message_iter_append_basic(&entry, DBUS_TYPE_STRING, &name);
+    append_sni_property(&entry, item, name);
+    dbus_message_iter_close_container(dict, &entry);
+}
+
+static DBusHandlerResult sni_handler(DBusConnection *conn, DBusMessage *msg, void *user_data)
+{
+    const char *destination = dbus_message_get_destination(msg);
+    const char *iface = dbus_message_get_interface(msg);
+    const char *member = dbus_message_get_member(msg);
+    struct sni_item *item;
+    DBusMessage *reply = NULL;
+
+    (void)user_data;
+
+    pthread_mutex_lock(&sni_mutex);
+    item = sni_find_by_service(destination);
+    if (!item)
+    {
+        pthread_mutex_unlock(&sni_mutex);
+        return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+    }
+
+    if (dbus_message_is_method_call(msg, DBUS_INTERFACE_INTROSPECTABLE, "Introspect"))
+    {
+        const char *xml = sni_xml;
+
+        reply = dbus_message_new_method_return(msg);
+        dbus_message_append_args(reply, DBUS_TYPE_STRING, &xml, DBUS_TYPE_INVALID);
+    }
+    else if (dbus_message_is_method_call(msg, DBUS_INTERFACE_PROPERTIES, "Get"))
+    {
+        const char *property_iface = NULL, *name = NULL;
+        DBusMessageIter args;
+
+        if (!dbus_message_get_args(msg, NULL, DBUS_TYPE_STRING, &property_iface,
+                                   DBUS_TYPE_STRING, &name, DBUS_TYPE_INVALID))
+        {
+            reply = dbus_message_new_error(msg, DBUS_ERROR_INVALID_ARGS,
+                                           "Expected interface and property name");
+        }
+        else if (!name)
+        {
+            reply = dbus_message_new_error(msg, DBUS_ERROR_UNKNOWN_PROPERTY, "");
+        }
+        else if (!property_iface || strcmp(property_iface, "org.kde.StatusNotifierItem"))
+        {
+            reply = dbus_message_new_error(msg, DBUS_ERROR_UNKNOWN_INTERFACE, "");
+        }
+        else
+        {
+            reply = dbus_message_new_method_return(msg);
+            dbus_message_iter_init_append(reply, &args);
+            if (!append_sni_property(&args, item, name))
+            {
+                dbus_message_unref(reply);
+                reply = dbus_message_new_error(msg, DBUS_ERROR_UNKNOWN_PROPERTY, name);
+            }
+        }
+    }
+    else if (dbus_message_is_method_call(msg, DBUS_INTERFACE_PROPERTIES, "GetAll"))
+    {
+        static const char *props[] =
+        {
+            "Id", "Category", "Status", "Title", "WindowId", "ItemIsMenu",
+            "IconName", "IconPixmap", "ToolTip"
+        };
+        const char *property_iface = NULL;
+        DBusMessageIter args, dict;
+        unsigned int i;
+
+        dbus_message_get_args(msg, NULL, DBUS_TYPE_STRING, &property_iface, DBUS_TYPE_INVALID);
+        if (!property_iface || strcmp(property_iface, "org.kde.StatusNotifierItem"))
+        {
+            reply = dbus_message_new_error(msg, DBUS_ERROR_UNKNOWN_INTERFACE, "");
+        }
+        else
+        {
+            reply = dbus_message_new_method_return(msg);
+            dbus_message_iter_init_append(reply, &args);
+            dbus_message_iter_open_container(&args, DBUS_TYPE_ARRAY, "{sv}", &dict);
+            for (i = 0; i < sizeof(props) / sizeof(props[0]); i++)
+                append_sni_property_dict(&dict, item, props[i]);
+            dbus_message_iter_close_container(&args, &dict);
+        }
+    }
+    else if (iface && !strcmp(iface, "org.kde.StatusNotifierItem"))
+    {
+        struct sni_item snapshot = *item;
+        UINT down_msg = 0, up_msg = 0;
+        dbus_int32_t x = 0, y = 0;
+        BOOL context_menu = FALSE;
+
+        pthread_mutex_unlock(&sni_mutex);
+
+        if (!strcmp(member, "Activate"))
+        {
+            down_msg = WM_LBUTTONDOWN;
+            up_msg = WM_LBUTTONUP;
+        }
+        else if (!strcmp(member, "SecondaryActivate"))
+        {
+            down_msg = WM_MBUTTONDOWN;
+            up_msg = WM_MBUTTONUP;
+        }
+        else if (!strcmp(member, "ContextMenu"))
+        {
+            down_msg = WM_RBUTTONDOWN;
+            up_msg = WM_RBUTTONUP;
+            context_menu = TRUE;
+        }
+        else if (!strcmp(member, "Scroll"))
+        {
+            dbus_int32_t delta = 0;
+
+            dbus_message_get_args(msg, NULL, DBUS_TYPE_INT32, &delta, DBUS_TYPE_INVALID);
+            queue_tray_scroll(&snapshot, delta);
+        }
+        if (up_msg)
+        {
+            dbus_message_get_args(msg, NULL, DBUS_TYPE_INT32, &x, DBUS_TYPE_INT32, &y,
+                                  DBUS_TYPE_INVALID);
+            queue_tray_callback(&snapshot, down_msg, up_msg, x, y, context_menu);
+        }
+        reply = dbus_message_new_method_return(msg);
+        if (reply)
+        {
+            dbus_connection_send(conn, reply, NULL);
+            dbus_message_unref(reply);
+        }
+        return DBUS_HANDLER_RESULT_HANDLED;
+    }
+
+    if (reply)
+    {
+        dbus_connection_send(conn, reply, NULL);
+        dbus_message_unref(reply);
+        pthread_mutex_unlock(&sni_mutex);
+        return DBUS_HANDLER_RESULT_HANDLED;
+    }
+
+    pthread_mutex_unlock(&sni_mutex);
+    return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+}
+
+static const DBusObjectPathVTable sni_vtable = { NULL, sni_handler };
+
+void WAYLAND_SystrayDispatch(void)
+{
+    for (;;)
+    {
+        DBusConnection *conn;
+        BOOL running;
+
+        pthread_mutex_lock(&sni_mutex);
+        while (!sni_dispatch_running || !sni_conn)
+            pthread_cond_wait(&sni_dispatch_cond, &sni_mutex);
+        conn = sni_conn;
+        dbus_connection_ref(conn);
+        pthread_mutex_unlock(&sni_mutex);
+
+        do
+        {
+            if (!dbus_connection_read_write_dispatch(conn, 200)) break;
+
+            pthread_mutex_lock(&sni_mutex);
+            running = sni_dispatch_running && sni_conn == conn;
+            pthread_mutex_unlock(&sni_mutex);
+        }
+        while (running);
+
+        dbus_connection_unref(conn);
+    }
+}
+
+static BOOL sni_start_dispatch_thread(void)
+{
+    pthread_mutex_lock(&sni_mutex);
+    sni_dispatch_running = TRUE;
+    pthread_cond_signal(&sni_dispatch_cond);
+    pthread_mutex_unlock(&sni_mutex);
+    return TRUE;
+}
+
+static BOOL sni_ensure_bus(void)
+{
+    DBusError err;
+
+    pthread_mutex_lock(&sni_mutex);
+    if (sni_conn)
+    {
+        pthread_mutex_unlock(&sni_mutex);
+        return TRUE;
+    }
+
+    dbus_threads_init_default();
+    dbus_error_init(&err);
+    sni_conn = dbus_bus_get_private(DBUS_BUS_SESSION, &err);
+    if (!sni_conn || dbus_error_is_set(&err))
+    {
+        WARN("D-Bus connect failed: %s\n", dbus_error_is_set(&err) ? err.message : "");
+        dbus_error_free(&err);
+        if (sni_conn) dbus_connection_unref(sni_conn);
+        sni_conn = NULL;
+        pthread_mutex_unlock(&sni_mutex);
+        return FALSE;
+    }
+
+    dbus_connection_set_exit_on_disconnect(sni_conn, FALSE);
+    if (!dbus_connection_register_object_path(sni_conn, SNI_OBJECT_PATH, &sni_vtable, NULL))
+    {
+        WARN("D-Bus object registration failed\n");
+        dbus_connection_close(sni_conn);
+        dbus_connection_unref(sni_conn);
+        sni_conn = NULL;
+        pthread_mutex_unlock(&sni_mutex);
+        return FALSE;
+    }
+
+    pthread_mutex_unlock(&sni_mutex);
+    return TRUE;
+}
+
+static BOOL sni_register_item(struct sni_item *item)
+{
+    DBusMessage *reg, *reply;
+    DBusError err;
+    const char *service = item->service;
+    dbus_bool_t has_watcher;
+
+    dbus_error_init(&err);
+    has_watcher = dbus_bus_name_has_owner(sni_conn, "org.kde.StatusNotifierWatcher", &err);
+    if (!has_watcher || dbus_error_is_set(&err))
+    {
+        TRACE("StatusNotifierWatcher is not available: %s\n", dbus_error_is_set(&err) ? err.message : "");
+        dbus_error_free(&err);
+        return FALSE;
+    }
+    dbus_error_free(&err);
+
+    reg = dbus_message_new_method_call("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
+                                       "org.kde.StatusNotifierWatcher", "RegisterStatusNotifierItem");
+    if (!reg) return FALSE;
+    dbus_message_append_args(reg, DBUS_TYPE_STRING, &service, DBUS_TYPE_INVALID);
+
+    dbus_error_init(&err);
+    reply = dbus_connection_send_with_reply_and_block(sni_conn, reg, 1000, &err);
+    dbus_message_unref(reg);
+    if (!reply || dbus_error_is_set(&err))
+    {
+        WARN("StatusNotifierItem registration failed: %s\n", dbus_error_is_set(&err) ? err.message : "");
+        dbus_error_free(&err);
+        if (reply) dbus_message_unref(reply);
+        return FALSE;
+    }
+
+    dbus_message_unref(reply);
+    return TRUE;
+}
+
+static void sni_signal_item(struct sni_item *item, const char *name)
+{
+    DBusMessage *sig = dbus_message_new_signal(SNI_OBJECT_PATH, "org.kde.StatusNotifierItem", name);
+
+    if (!sig) return;
+    dbus_connection_send(sni_conn, sig, NULL);
+    dbus_connection_flush(sni_conn);
+    dbus_message_unref(sig);
+}
+
+static void sni_signal_changes(struct sni_item *item, unsigned int changed)
+{
+    if (changed & SNI_CHANGED_ICON) sni_signal_item(item, "NewIcon");
+    if (changed & SNI_CHANGED_TOOLTIP)
+    {
+        sni_signal_item(item, "NewToolTip");
+        sni_signal_item(item, "NewTitle");
+    }
+}
+
+static void sni_remove_item(struct sni_item *item)
+{
+    list_remove(&item->entry);
+    dbus_bus_release_name(sni_conn, item->service, NULL);
+    dbus_connection_flush(sni_conn);
+    free(item->icon_argb);
+    free(item);
+}
+
+static unsigned int sni_update_item(struct sni_item *item, const struct explorer_tray_icon *icon)
+{
+    unsigned int changed = 0;
+
+    item->owner_hwnd = icon->owner;
+    item->window_hwnd = icon->window;
+    item->id = icon->id;
+    item->callback_message = icon->callback_message;
+    item->version = icon->version;
+
+    if (memcmp(item->tiptext, icon->tiptext, sizeof(item->tiptext)))
+    {
+        memcpy(item->tiptext, icon->tiptext, sizeof(item->tiptext));
+        changed |= SNI_CHANGED_TOOLTIP;
+    }
+
+    if (item->image != icon->image)
+    {
+        const char *icon_name = getenv("WINE_SNI_ICON_NAME");
+
+        item->image = icon->image;
+        free(item->icon_argb);
+        item->icon_argb = NULL;
+        item->icon_w = item->icon_h = 0;
+        if (icon->image && (!icon_name || !icon_name[0]))
+            item->icon_argb = icon_to_argb32(icon->image, &item->icon_w, &item->icon_h);
+        changed |= SNI_CHANGED_ICON;
+    }
+
+    return changed;
+}
+
+static BOOL sni_publish_item(struct sni_item *item)
+{
+    DBusError err;
+    int ret;
+
+    if (!sni_ensure_bus()) return FALSE;
+
+    pthread_mutex_lock(&sni_mutex);
+    item->serial = ++sni_serial;
+    pthread_mutex_unlock(&sni_mutex);
+
+    snprintf(item->service, sizeof(item->service),
+             "org.kde.StatusNotifierItem-%d-%d", (int)getpid(), item->serial);
+
+    dbus_error_init(&err);
+    ret = dbus_bus_request_name(sni_conn, item->service, DBUS_NAME_FLAG_DO_NOT_QUEUE, &err);
+    if (ret != DBUS_REQUEST_NAME_REPLY_PRIMARY_OWNER || dbus_error_is_set(&err))
+    {
+        WARN("Could not claim %s: %s\n", item->service, dbus_error_is_set(&err) ? err.message : "");
+        dbus_error_free(&err);
+        return FALSE;
+    }
+    snprintf(item->unique_service, sizeof(item->unique_service), "%s",
+             dbus_bus_get_unique_name(sni_conn));
+
+    pthread_mutex_lock(&sni_mutex);
+    list_add_tail(&sni_list, &item->entry);
+    pthread_mutex_unlock(&sni_mutex);
+
+    if (!sni_start_dispatch_thread())
+    {
+        pthread_mutex_lock(&sni_mutex);
+        list_remove(&item->entry);
+        pthread_mutex_unlock(&sni_mutex);
+        dbus_bus_release_name(sni_conn, item->service, NULL);
+        return FALSE;
+    }
+
+    if (!sni_register_item(item))
+    {
+        pthread_mutex_lock(&sni_mutex);
+        list_remove(&item->entry);
+        pthread_mutex_unlock(&sni_mutex);
+        dbus_bus_release_name(sni_conn, item->service, NULL);
+        return FALSE;
+    }
+
+    return TRUE;
+}
+
+void WAYLAND_SystrayDockInit(HWND hwnd)
+{
+    TRACE("hwnd=%p\n", hwnd);
+    sni_ensure_bus();
+}
+
+BOOL WAYLAND_SystrayDockInsert(HWND hwnd, UINT cx, UINT cy, void *icon_data)
+{
+    const struct explorer_tray_icon *icon = icon_data;
+    struct sni_item *item;
+    unsigned int changed;
+
+    TRACE("hwnd=%p icon=%p size=%ux%u\n", hwnd, icon, cx, cy);
+    if (!icon) return FALSE;
+
+    pthread_mutex_lock(&sni_mutex);
+    item = sni_find_by_window(icon->window);
+    if (item)
+    {
+        changed = sni_update_item(item, icon);
+        TRACE("updated SNI %s hwnd=%p owner=%p id=%u version=%u changed=%#x\n",
+              item->service, item->window_hwnd, item->owner_hwnd, item->id,
+              item->version, changed);
+        sni_signal_changes(item, changed);
+        pthread_mutex_unlock(&sni_mutex);
+        return TRUE;
+    }
+    pthread_mutex_unlock(&sni_mutex);
+
+    if (!(item = calloc(1, sizeof(*item)))) return FALSE;
+    sni_update_item(item, icon);
+    if (!sni_publish_item(item))
+    {
+        free(item->icon_argb);
+        free(item);
+        return FALSE;
+    }
+
+    TRACE("registered SNI %s hwnd=%p owner=%p id=%u version=%u\n",
+          item->service, item->window_hwnd, item->owner_hwnd, item->id,
+          item->version);
+    return TRUE;
+}
+
+void WAYLAND_SystrayDockClear(HWND hwnd)
+{
+    struct sni_item *item;
+
+    pthread_mutex_lock(&sni_mutex);
+    if ((item = sni_find_by_window(hwnd)))
+    {
+        sni_signal_item(item, "NewIcon");
+        sni_signal_item(item, "NewToolTip");
+    }
+    pthread_mutex_unlock(&sni_mutex);
+}
+
+BOOL WAYLAND_SystrayDockRemove(HWND hwnd)
+{
+    struct sni_item *item;
+
+    pthread_mutex_lock(&sni_mutex);
+    if (!(item = sni_find_by_window(hwnd)))
+    {
+        pthread_mutex_unlock(&sni_mutex);
+        return FALSE;
+    }
+    sni_remove_item(item);
+    pthread_mutex_unlock(&sni_mutex);
+    return TRUE;
+}
+
+#else
+
+void WAYLAND_SystrayDockInit(HWND hwnd) {}
+
+BOOL WAYLAND_SystrayDockInsert(HWND hwnd, UINT cx, UINT cy, void *icon)
+{
+    FIXME("D-Bus support is not available; systray icon not registered\n");
+    return FALSE;
+}
+
+void WAYLAND_SystrayDockClear(HWND hwnd) {}
+
+BOOL WAYLAND_SystrayDockRemove(HWND hwnd)
+{
+    return FALSE;
+}
+
+void WAYLAND_SystrayDispatch(void) {}
+
+void WAYLAND_SystrayProcessCallback(void *data) {}
+
+#endif /* SONAME_LIBDBUS_1 */
