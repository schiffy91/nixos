From 405da70a4df6426bf007a7c1d866b208fded1c71 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Tue, 25 Aug 2026 23:55:52 -0700
Subject: [PATCH 1/3] win32u: Pass a systray icon snapshot to
 SystrayDockInsert.

The docked systray path hands explorer's private struct icon pointer to
the driver as an opaque void pointer. A driver that needs more than the
adaptor window to show the icon (the image, the owner window, the
callback message, the notification version and the tooltip) would have
to copy explorer's private layout.

Introduce struct systray_icon_snapshot with just the fields a dock
bridge needs, build it in explorer for every dock insert, and convert
its 32-bit layout in wow64win. The X11 driver keeps ignoring the
parameter.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/win32u/driver.c        |  6 ++++--
 dlls/winex11.drv/window.c   |  3 ++-
 dlls/winex11.drv/x11drv.h   |  3 ++-
 dlls/wow64win/user.c        | 25 +++++++++++++++++++++++++
 include/ntuser.h            | 12 ++++++++++++
 include/wine/gdi_driver.h   |  2 +-
 programs/explorer/systray.c | 20 ++++++++++++++++++--
 7 files changed, 64 insertions(+), 7 deletions(-)

diff --git a/dlls/win32u/driver.c b/dlls/win32u/driver.c
index 793de3f..def6f7c 100644
--- a/dlls/win32u/driver.c
+++ b/dlls/win32u/driver.c
@@ -728,7 +728,8 @@ static void nulldrv_SystrayDockInit( HWND hwnd )
 {
 }
 
-static BOOL nulldrv_SystrayDockInsert( HWND hwnd, UINT cx, UINT cy, void *icon )
+static BOOL nulldrv_SystrayDockInsert( HWND hwnd, UINT cx, UINT cy,
+                                       const struct systray_icon_snapshot *icon )
 {
     return FALSE;
 }
@@ -1166,7 +1167,8 @@ static void loaderdrv_SystrayDockInit( HWND hwnd )
     load_driver()->pSystrayDockInit( hwnd );
 }
 
-static BOOL loaderdrv_SystrayDockInsert( HWND hwnd, UINT cx, UINT cy, void *icon )
+static BOOL loaderdrv_SystrayDockInsert( HWND hwnd, UINT cx, UINT cy,
+                                         const struct systray_icon_snapshot *icon )
 {
     return load_driver()->pSystrayDockInsert( hwnd, cx, cy, icon );
 }
diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 10a6359..4ca0ea7 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3337,7 +3337,8 @@ static void get_systray_visual_info( Display *display, Window systray_window, XV
 /***********************************************************************
  *              SystrayDockInsert   (X11DRV.@)
  */
-BOOL X11DRV_SystrayDockInsert( HWND hwnd, UINT cx, UINT cy, void *icon )
+BOOL X11DRV_SystrayDockInsert( HWND hwnd, UINT cx, UINT cy,
+                               const struct systray_icon_snapshot *icon )
 {
     Display *display = thread_init_display();
     Window systray_window, window;
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index 41fc515..f5b6bcf 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -218,7 +218,8 @@ extern void X11DRV_SetCursor( HWND hwnd, HCURSOR handle );
 extern BOOL X11DRV_SetCursorPos( INT x, INT y );
 extern BOOL X11DRV_ClipCursor( const RECT *clip, BOOL reset );
 extern void X11DRV_SystrayDockInit( HWND systray );
-extern BOOL X11DRV_SystrayDockInsert( HWND owner, UINT cx, UINT cy, void *icon );
+extern BOOL X11DRV_SystrayDockInsert( HWND owner, UINT cx, UINT cy,
+                                      const struct systray_icon_snapshot *icon );
 extern void X11DRV_SystrayDockClear( HWND hwnd );
 extern BOOL X11DRV_SystrayDockRemove( HWND hwnd );
 extern LONG X11DRV_ChangeDisplaySettings( LPDEVMODEW displays, LPCWSTR primary_name, HWND hwnd, DWORD flags, LPVOID lpvoid );
diff --git a/dlls/wow64win/user.c b/dlls/wow64win/user.c
index 5888dc2..aafe744 100644
--- a/dlls/wow64win/user.c
+++ b/dlls/wow64win/user.c
@@ -3805,6 +3805,31 @@ NTSTATUS WINAPI wow64_NtUserMessageCall( UINT *args )
             return NtUserMessageCall( hwnd, msg, wparam, lparam, &params, type, ansi );
         }
 
+        case WINE_SYSTRAY_DOCK_INSERT:
+        {
+            struct
+            {
+                ULONG image;
+                ULONG owner;
+                ULONG window;
+                UINT id;
+                UINT callback_message;
+                UINT version;
+                WCHAR tiptext[128];
+            } *params32 = result_info;
+
+            struct systray_icon_snapshot params;
+            params.image = UlongToHandle( params32->image );
+            params.owner = UlongToHandle( params32->owner );
+            params.window = UlongToHandle( params32->window );
+            params.id = params32->id;
+            params.callback_message = params32->callback_message;
+            params.version = params32->version;
+            memcpy( params.tiptext, params32->tiptext, sizeof(params.tiptext) );
+
+            return NtUserMessageCall( hwnd, msg, wparam, lparam, &params, type, ansi );
+        }
+
         default:
             return NtUserMessageCall( hwnd, msg, wparam, lparam, result_info, type, ansi );
         }
diff --git a/include/ntuser.h b/include/ntuser.h
index 0011fa0..63d61b9 100644
--- a/include/ntuser.h
+++ b/include/ntuser.h
@@ -699,6 +699,18 @@ enum wine_systray_call
     WINE_SYSTRAY_DOCK_REMOVE,
 };
 
+/* WINE_SYSTRAY_DOCK_INSERT data */
+struct systray_icon_snapshot
+{
+    HICON image;
+    HWND owner;
+    HWND window;
+    UINT id;
+    UINT callback_message;
+    UINT version;
+    WCHAR tiptext[128];
+};
+
 /* NtUserDragDropCall calls */
 enum wine_drag_drop_call
 {
diff --git a/include/wine/gdi_driver.h b/include/wine/gdi_driver.h
index d52f6ec..29051c4 100644
--- a/include/wine/gdi_driver.h
+++ b/include/wine/gdi_driver.h
@@ -394,7 +394,7 @@ struct user_driver_funcs
     LRESULT (*pNotifyIcon)(HWND,UINT,NOTIFYICONDATAW *);
     void    (*pCleanupIcons)(HWND);
     void    (*pSystrayDockInit)(HWND);
-    BOOL    (*pSystrayDockInsert)(HWND,UINT,UINT,void *);
+    BOOL    (*pSystrayDockInsert)(HWND,UINT,UINT,const struct systray_icon_snapshot *);
     void    (*pSystrayDockClear)(HWND);
     BOOL    (*pSystrayDockRemove)(HWND);
     /* clipboard functions */
diff --git a/programs/explorer/systray.c b/programs/explorer/systray.c
index 02fe507..2a6b6de 100644
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -631,6 +631,23 @@ static void systray_remove_icon( struct icon *icon )
     SetWindowLongW( icon->window, GWL_STYLE, GetWindowLongW( icon->window, GWL_STYLE ) & ~WS_CHILD );
 }
 
+/* dock an icon in the host systray, passing the driver what it needs to show it */
+static BOOL dock_icon( struct icon *icon )
+{
+    struct systray_icon_snapshot snapshot = {0};
+
+    snapshot.image = icon->image;
+    snapshot.owner = icon->owner;
+    snapshot.window = icon->window;
+    snapshot.id = icon->id;
+    snapshot.callback_message = icon->callback_message;
+    snapshot.version = icon->version;
+    memcpy( snapshot.tiptext, icon->tiptext, sizeof(snapshot.tiptext) );
+
+    return NtUserMessageCall( icon->window, WINE_SYSTRAY_DOCK_INSERT, icon_cx, icon_cy,
+                              &snapshot, NtUserSystemTrayCall, FALSE );
+}
+
 /* make an icon visible */
 static void show_icon(struct icon *icon)
 {
@@ -648,8 +665,7 @@ static void show_icon(struct icon *icon)
         SetWindowLongW( icon->window, GWL_EXSTYLE, old_exstyle | WS_EX_LAYERED );
         paint_layered_icon( icon );
 
-        if (!NtUserMessageCall( icon->window, WINE_SYSTRAY_DOCK_INSERT, icon_cx, icon_cy,
-                                icon, NtUserSystemTrayCall, FALSE ))
+        if (!dock_icon( icon ))
             SetWindowLongW( icon->window, GWL_EXSTYLE, old_exstyle );
         else
         {
