From 483969978d4ea5d9f45573568d1af78e20cd24a2 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Tue, 25 Aug 2026 23:59:17 -0700
Subject: [PATCH 3/3] explorer: Forward docked tray icon updates.

The docked systray path only tells the driver about an icon when it is
first inserted. Later NIM_MODIFY and NIM_SETVERSION calls update
explorer's own record, but a driver that copied the image, the tooltip,
the callback message or the notification version keeps stale values.
Battle.net for instance adds its icon from a short-lived launcher and
only then sets the callback version from the process that stays.

Repeat the dock insert with a fresh snapshot whenever a docked icon is
modified. The X11 driver treats the repeat as a no-op while the icon is
embedded and mapped, since re-embedding would withdraw and re-map the
window and request docking again.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/winex11.drv/window.c   |  6 ++++++
 programs/explorer/systray.c | 13 ++++++++++++-
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 4ca0ea7..67362f8 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3351,6 +3351,12 @@ BOOL X11DRV_SystrayDockInsert( HWND hwnd, UINT cx, UINT cy,
     get_systray_visual_info( display, systray_window, &visual );
 
     if (!(data = get_win_data( hwnd ))) return FALSE;
+    if (data->embedded && data->desired_state.wm_state == NormalState)
+    {
+        /* explorer repeats the insert to update an already docked icon */
+        release_win_data( data );
+        return TRUE;
+    }
     set_window_visual( data, &visual, TRUE );
     make_window_embedded( data );
     window = data->whole_window;
diff --git a/programs/explorer/systray.c b/programs/explorer/systray.c
index 2a6b6de..d9e90fa 100644
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -648,6 +648,12 @@ static BOOL dock_icon( struct icon *icon )
                               &snapshot, NtUserSystemTrayCall, FALSE );
 }
 
+/* give the driver a fresh snapshot of a docked icon */
+static void update_docked_icon( struct icon *icon )
+{
+    if (enable_dock && icon->display == ICON_DISPLAY_DOCKED) dock_icon( icon );
+}
+
 /* make an icon visible */
 static void show_icon(struct icon *icon)
 {
@@ -754,7 +760,11 @@ static BOOL modify_icon( struct icon *icon, NOTIFYICONDATAW *nid )
         update_balloon( icon );
     }
     if (icon->state & NIS_HIDDEN) hide_icon( icon );
-    else show_icon( icon );
+    else
+    {
+        update_docked_icon( icon );
+        show_icon( icon );
+    }
     return TRUE;
 }
 
@@ -948,6 +958,7 @@ static BOOL handle_incoming(HWND hwndSource, COPYDATASTRUCT *cds)
         if (icon)
         {
             icon->version = nid.uVersion;
+            update_docked_icon( icon );
             ret = TRUE;
         }
         break;
