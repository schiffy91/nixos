+/* A docked explorer tray icon published on the session bus. Every item claims
+ * its own well-known name but all of them share one object path on one
+ * connection; the name a host addresses selects the item. A host addressing
+ * our unique name instead cannot be matched to an item, and the NewIcon and
+ * NewToolTip signals of one item refresh every item on hosts that match
+ * signals by sender name. */
+struct sni_item
+{
+    struct list entry;
+    int serial;
+    char service[64];
+    BOOL published;
+    HWND owner_hwnd;
+    HWND window_hwnd;
+    UINT id;
+    UINT callback_message;
+    UINT version;
+    int icon_width;
+    int icon_height;
+    unsigned char *icon_argb;
+    WCHAR tiptext[128];
+};
+
+/* An activation request relayed to the icon's adaptor window. */
+struct sni_callback
+{
+    HWND owner_hwnd;
+    HWND window_hwnd;
+    UINT id;
+    UINT callback_message;
+    UINT version;
+    UINT down_msg;
+    UINT up_msg;
+    int x;
+    int y;
+    BOOL context_menu;
+};
+
