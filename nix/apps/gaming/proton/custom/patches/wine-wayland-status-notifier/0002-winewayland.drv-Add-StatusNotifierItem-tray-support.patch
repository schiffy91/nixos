+/* Called from the unix side when the first tray icon is docked. */
+static NTSTATUS WINAPI start_systray_thread(void *param, ULONG size)
+{
+    HANDLE thread;
+
+    if (!(thread = CreateThread(NULL, 0, systray_thread, NULL, 0, NULL)))
+        return STATUS_UNSUCCESSFUL;
+    CloseHandle(thread);
+    return STATUS_SUCCESS;
+}
