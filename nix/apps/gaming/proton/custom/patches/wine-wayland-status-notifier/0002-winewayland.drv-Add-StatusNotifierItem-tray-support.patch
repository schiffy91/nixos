+static void utf8_from_wchar(const WCHAR *src, char *dst, size_t dst_size)
+{
+    NTSTATUS status;
+    ULONG len;
+
+    status = RtlUnicodeToUTF8N(dst, dst_size - 1, &len, src, lstrlenW(src) * sizeof(WCHAR));
+    if (status && status != STATUS_SOME_NOT_MAPPED) len = 0;
+    dst[len] = 0;
+}
