+/* Convert an icon to the ARGB32 network byte order pixmap format of the spec. */
+static unsigned char *icon_to_argb32(HICON hicon, int *width, int *height)
+{
+    char buffer[FIELD_OFFSET(BITMAPINFO, bmiColors[256])];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    unsigned char *mask_bits = NULL, *argb = NULL;
+    unsigned int *bits = NULL, *ptr;
+    ICONINFO icon_info;
+    BITMAP bm;
+    HDC hdc = 0;
+    BOOL has_alpha = FALSE;
+    int i, j;
+
+    if (!NtUserGetIconInfo(hicon, &icon_info, NULL, NULL, NULL, 0)) return NULL;
+    if (!icon_info.hbmColor)
+    {
+        TRACE("icon %p is monochrome, not published\n", hicon);
+        goto done;
+    }
+    if (!NtGdiExtGetObjectW(icon_info.hbmColor, sizeof(bm), &bm)) goto done;
+    if (!(hdc = NtGdiCreateCompatibleDC(0))) goto done;
+
+    memset(info, 0, sizeof(info->bmiHeader));
+    info->bmiHeader.biSize = sizeof(info->bmiHeader);
+    info->bmiHeader.biWidth = bm.bmWidth;
+    info->bmiHeader.biHeight = -bm.bmHeight;
+    info->bmiHeader.biPlanes = 1;
+    info->bmiHeader.biBitCount = 32;
+    info->bmiHeader.biCompression = BI_RGB;
+    info->bmiHeader.biSizeImage = bm.bmWidth * bm.bmHeight * 4;
+
+    if (!(bits = malloc(info->bmiHeader.biSizeImage))) goto done;
+    if (!NtGdiGetDIBitsInternal(hdc, icon_info.hbmColor, 0, bm.bmHeight, bits, info,
+                                DIB_RGB_COLORS, 0, 0))
+        goto done;
+
+    for (i = 0; i < bm.bmWidth * bm.bmHeight; i++)
+        if ((has_alpha = (bits[i] & 0xff000000) != 0)) break;
+
+    if (!has_alpha)
+    {
+        unsigned int width_bytes = (bm.bmWidth + 31) / 32 * 4;
+
+        /* generate the alpha channel from the mask */
+        info->bmiHeader.biBitCount = 1;
+        info->bmiHeader.biSizeImage = width_bytes * bm.bmHeight;
+        if (!(mask_bits = malloc(info->bmiHeader.biSizeImage))) goto done;
+        if (!NtGdiGetDIBitsInternal(hdc, icon_info.hbmMask, 0, bm.bmHeight, mask_bits, info,
+                                    DIB_RGB_COLORS, 0, 0))
+            goto done;
+        ptr = bits;
+        for (i = 0; i < bm.bmHeight; i++)
+        {
+            for (j = 0; j < bm.bmWidth; j++, ptr++)
+            {
+                if (!((mask_bits[i * width_bytes + j / 8] << (j % 8)) & 0x80))
+                    *ptr |= 0xff000000;
+            }
+        }
+    }
+
+    if (!(argb = malloc(bm.bmWidth * bm.bmHeight * 4))) goto done;
+    for (i = 0; i < bm.bmWidth * bm.bmHeight; i++)
+    {
+        argb[i * 4 + 0] = bits[i] >> 24;
+        argb[i * 4 + 1] = bits[i] >> 16;
+        argb[i * 4 + 2] = bits[i] >> 8;
+        argb[i * 4 + 3] = bits[i];
+    }
+    *width = bm.bmWidth;
+    *height = bm.bmHeight;
+
+done:
+    free(mask_bits);
+    free(bits);
+    if (hdc) NtGdiDeleteObjectApp(hdc);
+    if (icon_info.hbmColor) NtGdiDeleteObjectApp(icon_info.hbmColor);
+    if (icon_info.hbmMask) NtGdiDeleteObjectApp(icon_info.hbmMask);
+    return argb;
+}
+
+static struct sni_item *sni_find_by_service(const char *service)
+{
+    struct sni_item *item;
+
+    if (!service) return NULL;
+    LIST_FOR_EACH_ENTRY(item, &sni_items, struct sni_item, entry)
+        if (item->published && !strcmp(item->service, service)) return item;
+    return NULL;
+}
+
+static struct sni_item *sni_find_by_window(HWND hwnd)
+{
+    struct sni_item *item;
+
+    LIST_FOR_EACH_ENTRY(item, &sni_items, struct sni_item, entry)
+        if (item->window_hwnd == hwnd) return item;
+    return NULL;
+}
+
+static void sni_free_item(struct sni_item *item)
+{
+    free(item->icon_argb);
+    free(item);
+}
+
+/* Returns a reference to the bus connection, or NULL if there is none. */
+static DBusConnection *sni_get_connection(void)
+{
+    DBusConnection *conn;
+
+    pthread_mutex_lock(&sni_mutex);
+    if ((conn = sni_conn)) p_dbus_connection_ref(conn);
+    pthread_mutex_unlock(&sni_mutex);
+    return conn;
+}
+
+static void append_variant_string(DBusMessageIter *iter, const char *str)
+{
+    DBusMessageIter variant;
+
+    p_dbus_message_iter_open_container(iter, DBUS_TYPE_VARIANT, "s", &variant);
+    p_dbus_message_iter_append_basic(&variant, DBUS_TYPE_STRING, &str);
+    p_dbus_message_iter_close_container(iter, &variant);
+}
+
+static void append_pixmap_array(DBusMessageIter *iter, const struct sni_item *item)
+{
+    DBusMessageIter array, pixmap, bytes;
+    dbus_int32_t width = item->icon_width, height = item->icon_height;
+
+    p_dbus_message_iter_open_container(iter, DBUS_TYPE_ARRAY, "(iiay)", &array);
+    if (item->icon_argb)
+    {
+        p_dbus_message_iter_open_container(&array, DBUS_TYPE_STRUCT, NULL, &pixmap);
+        p_dbus_message_iter_append_basic(&pixmap, DBUS_TYPE_INT32, &width);
+        p_dbus_message_iter_append_basic(&pixmap, DBUS_TYPE_INT32, &height);
+        p_dbus_message_iter_open_container(&pixmap, DBUS_TYPE_ARRAY, "y", &bytes);
+        p_dbus_message_iter_append_fixed_array(&bytes, DBUS_TYPE_BYTE, &item->icon_argb,
+                                               width * height * 4);
+        p_dbus_message_iter_close_container(&pixmap, &bytes);
+        p_dbus_message_iter_close_container(&array, &pixmap);
+    }
+    p_dbus_message_iter_close_container(iter, &array);
+}
+
+static BOOL append_property(DBusMessageIter *iter, const struct sni_item *item, const char *name)
+{
+    DBusMessageIter variant, tooltip;
+    char text[512];
+
+    if (!strcmp(name, "Id"))
+    {
+        snprintf(text, sizeof(text), "wine-tray-%d", item->serial);
+        append_variant_string(iter, text);
+    }
+    else if (!strcmp(name, "Category")) append_variant_string(iter, "ApplicationStatus");
+    else if (!strcmp(name, "Status")) append_variant_string(iter, "Active");
+    else if (!strcmp(name, "IconName")) append_variant_string(iter, sni_icon_name ? sni_icon_name : "");
+    else if (!strcmp(name, "Title"))
+    {
+        utf8_from_wchar(item->tiptext, text, sizeof(text));
+        append_variant_string(iter, text);
+    }
+    else if (!strcmp(name, "WindowId"))
+    {
+        dbus_uint32_t window_id = 0;
+
+        p_dbus_message_iter_open_container(iter, DBUS_TYPE_VARIANT, "u", &variant);
+        p_dbus_message_iter_append_basic(&variant, DBUS_TYPE_UINT32, &window_id);
+        p_dbus_message_iter_close_container(iter, &variant);
+    }
+    else if (!strcmp(name, "ItemIsMenu"))
+    {
+        dbus_bool_t is_menu = FALSE;
+
+        p_dbus_message_iter_open_container(iter, DBUS_TYPE_VARIANT, "b", &variant);
+        p_dbus_message_iter_append_basic(&variant, DBUS_TYPE_BOOLEAN, &is_menu);
+        p_dbus_message_iter_close_container(iter, &variant);
+    }
+    else if (!strcmp(name, "IconPixmap"))
+    {
+        p_dbus_message_iter_open_container(iter, DBUS_TYPE_VARIANT, "a(iiay)", &variant);
+        append_pixmap_array(&variant, item);
+        p_dbus_message_iter_close_container(iter, &variant);
+    }
+    else if (!strcmp(name, "ToolTip"))
+    {
+        const char *empty = "", *title = text;
+
+        utf8_from_wchar(item->tiptext, text, sizeof(text));
+        p_dbus_message_iter_open_container(iter, DBUS_TYPE_VARIANT, "(sa(iiay)ss)", &variant);
+        p_dbus_message_iter_open_container(&variant, DBUS_TYPE_STRUCT, NULL, &tooltip);
+        p_dbus_message_iter_append_basic(&tooltip, DBUS_TYPE_STRING, &empty);
+        append_pixmap_array(&tooltip, item);
+        p_dbus_message_iter_append_basic(&tooltip, DBUS_TYPE_STRING, &title);
+        p_dbus_message_iter_append_basic(&tooltip, DBUS_TYPE_STRING, &empty);
+        p_dbus_message_iter_close_container(&variant, &tooltip);
+        p_dbus_message_iter_close_container(iter, &variant);
+    }
+    else return FALSE;
+
+    return TRUE;
+}
+
+static DBusMessage *introspect_reply(DBusMessage *msg)
+{
+    const char *xml = sni_introspection_xml;
+    DBusMessage *reply;
+
+    if (!(reply = p_dbus_message_new_method_return(msg))) return NULL;
+    p_dbus_message_append_args(reply, DBUS_TYPE_STRING, &xml, DBUS_TYPE_INVALID);
+    return reply;
+}
+
+static DBusMessage *get_property_reply(DBusMessage *msg, const struct sni_item *item)
+{
+    const char *iface, *name;
+    DBusMessageIter iter;
+    DBusMessage *reply;
+
+    if (!p_dbus_message_get_args(msg, NULL, DBUS_TYPE_STRING, &iface, DBUS_TYPE_STRING, &name,
+                                 DBUS_TYPE_INVALID))
+        return p_dbus_message_new_error(msg, DBUS_ERROR_INVALID_ARGS, "expected interface and property name");
+    if (strcmp(iface, SNI_ITEM_INTERFACE))
+        return p_dbus_message_new_error(msg, DBUS_ERROR_UNKNOWN_INTERFACE, iface);
+    if (!(reply = p_dbus_message_new_method_return(msg))) return NULL;
+    p_dbus_message_iter_init_append(reply, &iter);
+    if (!append_property(&iter, item, name))
+    {
+        p_dbus_message_unref(reply);
+        return p_dbus_message_new_error(msg, DBUS_ERROR_UNKNOWN_PROPERTY, name);
+    }
+    return reply;
+}
+
+static DBusMessage *get_all_properties_reply(DBusMessage *msg, const struct sni_item *item)
+{
+    DBusMessageIter iter, dict, entry;
+    DBusMessage *reply;
+    const char *iface;
+    unsigned int i;
+
+    if (!p_dbus_message_get_args(msg, NULL, DBUS_TYPE_STRING, &iface, DBUS_TYPE_INVALID))
+        return p_dbus_message_new_error(msg, DBUS_ERROR_INVALID_ARGS, "expected interface name");
+    if (strcmp(iface, SNI_ITEM_INTERFACE))
+        return p_dbus_message_new_error(msg, DBUS_ERROR_UNKNOWN_INTERFACE, iface);
+    if (!(reply = p_dbus_message_new_method_return(msg))) return NULL;
+    p_dbus_message_iter_init_append(reply, &iter);
+    p_dbus_message_iter_open_container(&iter, DBUS_TYPE_ARRAY, "{sv}", &dict);
+    for (i = 0; i < ARRAY_SIZE(sni_property_names); i++)
+    {
+        p_dbus_message_iter_open_container(&dict, DBUS_TYPE_DICT_ENTRY, NULL, &entry);
+        p_dbus_message_iter_append_basic(&entry, DBUS_TYPE_STRING, &sni_property_names[i]);
+        append_property(&entry, item, sni_property_names[i]);
+        p_dbus_message_iter_close_container(&dict, &entry);
+    }
+    p_dbus_message_iter_close_container(&iter, &dict);
+    return reply;
+}
+
+static struct sni_callback *alloc_tray_callback(const struct sni_item *item, DBusMessage *msg,
+                                                UINT down_msg, UINT up_msg, BOOL context_menu)
+{
+    struct sni_callback *callback;
+    dbus_int32_t x = 0, y = 0;
+
+    if (!(callback = calloc(1, sizeof(*callback)))) return NULL;
+    p_dbus_message_get_args(msg, NULL, DBUS_TYPE_INT32, &x, DBUS_TYPE_INT32, &y, DBUS_TYPE_INVALID);
+    callback->owner_hwnd = item->owner_hwnd;
+    callback->window_hwnd = item->window_hwnd;
+    callback->id = item->id;
+    callback->callback_message = item->callback_message;
+    callback->version = item->version;
+    callback->down_msg = down_msg;
+    callback->up_msg = up_msg;
+    callback->x = x;
+    callback->y = y;
+    callback->context_menu = context_menu;
+    return callback;
+}
+
+/* Relay the activation to the adaptor window, so that the Win32 tray callbacks
+ * run on Wine's message path instead of the bus dispatch thread. The callback
+ * is freed by wayland_systray_process_callback. It leaks if the adaptor window
+ * is destroyed before the message is processed, which explorer only does when
+ * the icon itself goes away. */
+static void queue_tray_callback(struct sni_callback *callback)
+{
+    if (!NtUserPostMessage(callback->window_hwnd, WM_WAYLAND_SNI_CALLBACK, 0, (LPARAM)callback))
+        free(callback);
+}
+
+static DBusHandlerResult sni_handler(DBusConnection *conn, DBusMessage *msg, void *user_data)
+{
+    struct sni_callback *callback = NULL;
+    DBusMessage *reply = NULL;
+    struct sni_item *item;
+
+    pthread_mutex_lock(&sni_mutex);
+    if (!(item = sni_find_by_service(p_dbus_message_get_destination(msg))))
+    {
+        pthread_mutex_unlock(&sni_mutex);
+        return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+    }
+
+    if (p_dbus_message_is_method_call(msg, DBUS_INTERFACE_INTROSPECTABLE, "Introspect"))
+        reply = introspect_reply(msg);
+    else if (p_dbus_message_is_method_call(msg, DBUS_INTERFACE_PROPERTIES, "Get"))
+        reply = get_property_reply(msg, item);
+    else if (p_dbus_message_is_method_call(msg, DBUS_INTERFACE_PROPERTIES, "GetAll"))
+        reply = get_all_properties_reply(msg, item);
+    else if (p_dbus_message_is_method_call(msg, SNI_ITEM_INTERFACE, "Activate"))
+    {
+        callback = alloc_tray_callback(item, msg, WM_LBUTTONDOWN, WM_LBUTTONUP, FALSE);
+        reply = p_dbus_message_new_method_return(msg);
+    }
+    else if (p_dbus_message_is_method_call(msg, SNI_ITEM_INTERFACE, "SecondaryActivate"))
+    {
+        callback = alloc_tray_callback(item, msg, WM_MBUTTONDOWN, WM_MBUTTONUP, FALSE);
+        reply = p_dbus_message_new_method_return(msg);
+    }
+    else if (p_dbus_message_is_method_call(msg, SNI_ITEM_INTERFACE, "ContextMenu"))
+    {
+        callback = alloc_tray_callback(item, msg, WM_RBUTTONDOWN, WM_RBUTTONUP, TRUE);
+        reply = p_dbus_message_new_method_return(msg);
+    }
+    else if (p_dbus_message_is_method_call(msg, SNI_ITEM_INTERFACE, "Scroll"))
+    {
+        /* Windows never delivers wheel events to tray icons. */
+        reply = p_dbus_message_new_method_return(msg);
+    }
+    pthread_mutex_unlock(&sni_mutex);
+
+    if (!reply)
+    {
+        free(callback);
+        return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+    }
+
+    p_dbus_connection_send(conn, reply, NULL);
+    p_dbus_message_unref(reply);
+    if (callback)
+    {
+        /* Let the host finish its own interaction before the application
+         * opens a popup menu. */
+        p_dbus_connection_flush(conn);
+        queue_tray_callback(callback);
+    }
+    return DBUS_HANDLER_RESULT_HANDLED;
+}
+
+static const DBusObjectPathVTable sni_vtable = { NULL, sni_handler };
+
+static DBusMessage *new_register_item_call(const struct sni_item *item)
+{
+    const char *service = item->service;
+    DBusMessage *msg;
+
+    if (!(msg = p_dbus_message_new_method_call(SNI_WATCHER_NAME, SNI_WATCHER_PATH, SNI_WATCHER_NAME,
+                                               "RegisterStatusNotifierItem")))
+        return NULL;
+    if (!p_dbus_message_append_args(msg, DBUS_TYPE_STRING, &service, DBUS_TYPE_INVALID))
+    {
+        p_dbus_message_unref(msg);
+        return NULL;
+    }
+    return msg;
+}
+
+/* Register an item with the watcher, waiting for the answer. */
+static void sni_register_item(DBusConnection *conn, const struct sni_item *item)
+{
+    DBusMessage *msg, *reply;
+    DBusError error;
+
+    if (!p_dbus_bus_name_has_owner(conn, SNI_WATCHER_NAME, NULL))
+    {
+        TRACE("no " SNI_WATCHER_NAME " on the bus, %s registers once one appears\n", item->service);
+        return;
+    }
+    if (!(msg = new_register_item_call(item))) return;
+
+    p_dbus_error_init(&error);
+    if ((reply = p_dbus_connection_send_with_reply_and_block(conn, msg, 1000, &error)))
+    {
+        TRACE("registered %s\n", item->service);
+        p_dbus_message_unref(reply);
+    }
+    else
+    {
+        WARN("failed to register %s: %s\n", item->service, debugstr_a(error.message));
+        p_dbus_error_free(&error);
+    }
+    p_dbus_message_unref(msg);
+}
+
+/* Register every item again after the watcher changed owner, e.g. when the
+ * shell restarted. Runs on the dispatch thread, so it must not wait for the
+ * replies. */
+static DBusHandlerResult sni_bus_filter(DBusConnection *conn, DBusMessage *msg, void *user_data)
+{
+    const char *name, *old_owner, *new_owner;
+    struct sni_item *item;
+    DBusMessage *call;
+
+    if (!p_dbus_message_is_signal(msg, DBUS_INTERFACE_DBUS, "NameOwnerChanged") ||
+        !p_dbus_message_get_args(msg, NULL, DBUS_TYPE_STRING, &name, DBUS_TYPE_STRING, &old_owner,
+                                 DBUS_TYPE_STRING, &new_owner, DBUS_TYPE_INVALID) ||
+        strcmp(name, SNI_WATCHER_NAME) || !new_owner[0])
+        return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+
+    TRACE(SNI_WATCHER_NAME " owner changed from %s to %s\n", debugstr_a(old_owner), debugstr_a(new_owner));
+
+    pthread_mutex_lock(&sni_mutex);
+    LIST_FOR_EACH_ENTRY(item, &sni_items, struct sni_item, entry)
+    {
+        if (!item->published || !(call = new_register_item_call(item))) continue;
+        p_dbus_connection_send(conn, call, NULL);
+        p_dbus_message_unref(call);
+    }
+    pthread_mutex_unlock(&sni_mutex);
+
+    /* Explorer re-docks every icon, like it does when an X11 tray appears. */
+    if (systray_hwnd) NtUserPostMessage(systray_hwnd, WM_USER + 1, 0, 0);
+    return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+}
+
+static BOOL sni_start_dispatch_thread(void)
+{
+    struct dispatch_callback_params params = {.callback = start_systray_thread_callback};
+    void *ret_ptr;
+    ULONG ret_len;
+    NTSTATUS status;
+
+    if (sni_dispatch_started) return TRUE;
+    if ((status = KeUserDispatchCallback(&params, sizeof(params), &ret_ptr, &ret_len)))
+    {
+        WARN("failed to start the dispatch thread, status %#x\n", (int)status);
+        return FALSE;
+    }
+    sni_dispatch_started = TRUE;
+    return TRUE;
+}
+
+/* Returns a reference to the bus connection, connecting if needed. Only ever
+ * called from the thread docking the icons. */
+static DBusConnection *sni_connect(void)
+{
+    static const char watcher_match[] =
+        "type='signal',sender='" DBUS_SERVICE_DBUS "',interface='" DBUS_INTERFACE_DBUS "',"
+        "member='NameOwnerChanged',arg0='" SNI_WATCHER_NAME "'";
+    static BOOL dbus_loaded, dbus_load_tried;
+    DBusConnection *conn;
+    DBusError error;
+
+    if ((conn = sni_get_connection())) return conn;
+
+    if (!dbus_load_tried)
+    {
+        dbus_load_tried = TRUE;
+        dbus_loaded = load_dbus_functions();
+    }
+    if (!dbus_loaded) return NULL;
+
+    p_dbus_threads_init_default();
+    p_dbus_error_init(&error);
+    if (!(conn = p_dbus_bus_get_private(DBUS_BUS_SESSION, &error)))
+    {
+        WARN("failed to connect to the session bus: %s\n", debugstr_a(error.message));
+        p_dbus_error_free(&error);
+        return NULL;
+    }
+    p_dbus_connection_set_exit_on_disconnect(conn, FALSE);
+
+    if (!p_dbus_connection_register_object_path(conn, SNI_ITEM_PATH, &sni_vtable, NULL) ||
+        !p_dbus_connection_add_filter(conn, sni_bus_filter, NULL, NULL))
+    {
+        WARN("failed to register the item object path\n");
+        goto failed;
+    }
+    p_dbus_bus_add_match(conn, watcher_match, NULL);
+
+    if (!sni_start_dispatch_thread()) goto failed;
+
+    /* The dispatch thread owns this reference and drops it on disconnect. */
+    pthread_mutex_lock(&sni_mutex);
+    sni_conn = conn;
+    p_dbus_connection_ref(conn);
+    pthread_cond_signal(&sni_cond);
+    pthread_mutex_unlock(&sni_mutex);
+
+    TRACE("connected to the session bus\n");
+    return conn;
+
+failed:
+    p_dbus_connection_close(conn);
+    p_dbus_connection_unref(conn);
+    return NULL;
+}
+
+void wayland_systray_dispatch(void)
+{
+    struct sni_item *item;
+    DBusConnection *conn;
+
+    for (;;)
+    {
+        pthread_mutex_lock(&sni_mutex);
+        while (!sni_conn) pthread_cond_wait(&sni_cond, &sni_mutex);
+        conn = sni_conn;
+        pthread_mutex_unlock(&sni_mutex);
+
+        /* The finite timeout bounds how long the threads sending from outside
+         * this loop wait for the I/O path of the connection. */
+        while (p_dbus_connection_read_write_dispatch(conn, 200)) continue;
+
+        WARN("lost the session bus connection\n");
+        pthread_mutex_lock(&sni_mutex);
+        sni_conn = NULL;
+        LIST_FOR_EACH_ENTRY(item, &sni_items, struct sni_item, entry) item->published = FALSE;
+        pthread_mutex_unlock(&sni_mutex);
+        p_dbus_connection_close(conn);
+        p_dbus_connection_unref(conn);
+
+        /* Explorer re-docks every icon, which publishes them again on a new
+         * connection. */
+        if (systray_hwnd) NtUserPostMessage(systray_hwnd, WM_USER + 1, 0, 0);
+    }
+}
+
+static void sni_signal_item(DBusConnection *conn, const char *name)
+{
+    DBusMessage *msg;
+
+    if (!(msg = p_dbus_message_new_signal(SNI_ITEM_PATH, SNI_ITEM_INTERFACE, name))) return;
+    p_dbus_connection_send(conn, msg, NULL);
+    p_dbus_message_unref(msg);
+}
+
+static void sni_signal_changes(unsigned int changed)
+{
+    DBusConnection *conn;
+
+    if (!changed || !(conn = sni_get_connection())) return;
+    if (changed & SNI_CHANGED_ICON) sni_signal_item(conn, "NewIcon");
+    if (changed & SNI_CHANGED_TOOLTIP)
+    {
+        sni_signal_item(conn, "NewToolTip");
+        sni_signal_item(conn, "NewTitle");
+    }
+    p_dbus_connection_unref(conn);
+}
+
+/* Update an item from a snapshot, taking ownership of the pixmap. */
+static unsigned int sni_update_item(struct sni_item *item, const struct systray_icon_snapshot *icon,
+                                    unsigned char *argb, int width, int height)
+{
+    unsigned int changed = 0;
+
+    item->owner_hwnd = icon->owner;
+    item->id = icon->id;
+    item->callback_message = icon->callback_message;
+    item->version = icon->version;
+
+    if (memcmp(item->tiptext, icon->tiptext, sizeof(item->tiptext)))
+    {
+        memcpy(item->tiptext, icon->tiptext, sizeof(item->tiptext));
+        changed |= SNI_CHANGED_TOOLTIP;
+    }
+
+    if (!argb != !item->icon_argb || width != item->icon_width || height != item->icon_height ||
+        (argb && memcmp(argb, item->icon_argb, width * height * 4)))
+    {
+        free(item->icon_argb);
+        item->icon_argb = argb;
+        item->icon_width = width;
+        item->icon_height = height;
+        changed |= SNI_CHANGED_ICON;
+    }
+    else free(argb);
+
+    return changed;
+}
+
+/* Claim a bus name for the item and register it with the watcher. */
+static BOOL sni_publish_item(struct sni_item *item)
+{
+    DBusConnection *conn;
+    DBusError error;
+    int ret;
+
+    if (!(conn = sni_connect())) return FALSE;
+
+    pthread_mutex_lock(&sni_mutex);
+    item->serial = ++sni_serial;
+    snprintf(item->service, sizeof(item->service), SNI_ITEM_INTERFACE "-%u-%d",
+             (unsigned int)getpid(), item->serial);
+    pthread_mutex_unlock(&sni_mutex);
+
+    p_dbus_error_init(&error);
+    ret = p_dbus_bus_request_name(conn, item->service, DBUS_NAME_FLAG_DO_NOT_QUEUE, &error);
+    if (ret != DBUS_REQUEST_NAME_REPLY_PRIMARY_OWNER)
+    {
+        WARN("failed to own %s: %s\n", item->service, debugstr_a(error.message));
+        p_dbus_error_free(&error);
+        p_dbus_connection_unref(conn);
+        return FALSE;
+    }
+
+    pthread_mutex_lock(&sni_mutex);
+    item->published = TRUE;
+    pthread_mutex_unlock(&sni_mutex);
+
+    sni_register_item(conn, item);
+    p_dbus_connection_unref(conn);
+    return TRUE;
+}
+
+static void send_tray_callback(const struct sni_callback *callback, UINT msg, BOOL wait)
+{
+    WPARAM wparam = callback->id;
+    LPARAM lparam = msg;
+
+    if (callback->version >= NOTIFYICON_VERSION_4)
+    {
+        wparam = MAKEWPARAM(callback->x, callback->y);
+        lparam = MAKELPARAM(msg, callback->id);
+    }
+
+    TRACE("sending msg %#x to hwnd %p id %u wait=%d\n", msg, callback->owner_hwnd, callback->id, wait);
+    if (wait)
+        send_message_timeout(callback->owner_hwnd, callback->callback_message, wparam, lparam,
+                             SMTO_ABORTIFHUNG, 2000, NULL);
+    else
+        NtUserMessageCall(callback->owner_hwnd, callback->callback_message, wparam, lparam, NULL,
+                          NtUserSendNotifyMessage, FALSE);
+}
+
+void wayland_systray_process_callback(void *data)
+{
+    struct sni_callback *callback = data;
+    RECT virtual_rect = NtUserGetVirtualScreenRect(MDT_DEFAULT);
+
+    TRACE("hwnd=%p owner=%p id=%u version=%u down=%#x up=%#x pos=%d,%d\n",
+          callback->window_hwnd, callback->owner_hwnd, callback->id, callback->version,
+          callback->down_msg, callback->up_msg, callback->x, callback->y);
+
+    /* Hosts report compositor coordinates. Applications that build their menu
+     * at GetCursorPos() need them, but they only map onto Wine's screen when
+     * the position is inside it. */
+    if (callback->x >= virtual_rect.left && callback->x < virtual_rect.right &&
+        callback->y >= virtual_rect.top && callback->y < virtual_rect.bottom)
+        NtUserSetCursorPos(callback->x, callback->y);
+
+    if (callback->context_menu) NtUserSetForegroundWindow(callback->owner_hwnd);
+
+    send_tray_callback(callback, callback->down_msg, FALSE);
+    /* Applications opening a menu from the button up notification need it to
+     * complete before the foreground handoff below. */
+    send_tray_callback(callback, callback->up_msg, callback->context_menu && !callback->version);
+    if (callback->version)
+    {
+        if (callback->up_msg == WM_LBUTTONUP) send_tray_callback(callback, NIN_SELECT, FALSE);
+        else if (callback->up_msg == WM_RBUTTONUP) send_tray_callback(callback, WM_CONTEXTMENU, TRUE);
+    }
+    if (callback->context_menu)
+    {
+        NtUserPostMessage(callback->window_hwnd, WM_NULL, 0, 0);
+        if (callback->owner_hwnd != callback->window_hwnd)
+            NtUserPostMessage(callback->owner_hwnd, WM_NULL, 0, 0);
+    }
+
+    free(callback);
+}
+
+void wayland_systray_init(UINT64 start_thread_callback)
+{
+    const char *env;
+
+    start_systray_thread_callback = start_thread_callback;
+    if ((env = getenv("WINE_SNI_ICON_NAME")) && env[0]) sni_icon_name = strdup(env);
+}
+
+/***********************************************************************
+ *           WAYLAND_SystrayDockInit
+ */
+void WAYLAND_SystrayDockInit(HWND hwnd)
+{
+    TRACE("hwnd=%p\n", hwnd);
+    /* The bus is only needed once an icon is docked. */
+    systray_hwnd = hwnd;
+}
+
+/***********************************************************************
+ *           WAYLAND_SystrayDockInsert
+ *
+ * Explorer repeats the insert with the same window to update a docked icon.
+ */
+BOOL WAYLAND_SystrayDockInsert(HWND hwnd, UINT cx, UINT cy, const struct systray_icon_snapshot *icon)
+{
+    unsigned char *argb = NULL;
+    int width = 0, height = 0;
+    struct sni_item *item;
+    unsigned int changed;
+    BOOL added = FALSE, published;
+
+    TRACE("hwnd=%p owner=%p id=%u version=%u\n", hwnd, icon->owner, icon->id, icon->version);
+
+    if (icon->image) argb = icon_to_argb32(icon->image, &width, &height);
+
+    pthread_mutex_lock(&sni_mutex);
+    if (!(item = sni_find_by_window(hwnd)))
+    {
+        if (!(item = calloc(1, sizeof(*item))))
+        {
+            pthread_mutex_unlock(&sni_mutex);
+            free(argb);
+            return FALSE;
+        }
+        item->window_hwnd = hwnd;
+        list_add_tail(&sni_items, &item->entry);
+        added = TRUE;
+    }
+    changed = sni_update_item(item, icon, argb, width, height);
+    published = item->published;
+    pthread_mutex_unlock(&sni_mutex);
+
+    if (published)
+    {
+        TRACE("updated %s changed=%#x\n", item->service, changed);
+        sni_signal_changes(changed);
+        return TRUE;
+    }
+    if (sni_publish_item(item)) return TRUE;
+    /* An item explorer already docked stays in the list, so that removing it
+     * keeps working. */
+    if (!added) return FALSE;
+
+    pthread_mutex_lock(&sni_mutex);
+    list_remove(&item->entry);
+    pthread_mutex_unlock(&sni_mutex);
+    sni_free_item(item);
+    return FALSE;
+}
+
+/***********************************************************************
+ *           WAYLAND_SystrayDockClear
+ */
+void WAYLAND_SystrayDockClear(HWND hwnd)
+{
+    /* Icon changes reach us through a new snapshot on dock insert. */
+    TRACE("hwnd=%p\n", hwnd);
+}
+
+/***********************************************************************
+ *           WAYLAND_SystrayDockRemove
+ */
+BOOL WAYLAND_SystrayDockRemove(HWND hwnd)
+{
+    struct sni_item *item;
+    DBusConnection *conn;
+
+    TRACE("hwnd=%p\n", hwnd);
+
+    pthread_mutex_lock(&sni_mutex);
+    if (!(item = sni_find_by_window(hwnd)))
+    {
+        pthread_mutex_unlock(&sni_mutex);
+        return FALSE;
+    }
+    list_remove(&item->entry);
+    pthread_mutex_unlock(&sni_mutex);
+
+    if (item->published && (conn = sni_get_connection()))
+    {
