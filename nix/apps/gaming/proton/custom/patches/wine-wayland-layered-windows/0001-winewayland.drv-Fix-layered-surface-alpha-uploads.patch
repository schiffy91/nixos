From 0c48696335137210fe2cae5fee0b69ee80ee3579 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Tue, 25 Aug 2026 23:45:30 -0700
Subject: [PATCH] winewayland.drv: Fix layered surface alpha uploads.

Layered windows set up through SetLayeredWindowAttributes have no
per-pixel alpha mask, so the alpha bytes GDI leaves in their DIB are
meaningless. The window surface flush copied them verbatim into the
ARGB8888 SHM buffer, and since GDI leaves them at zero, otherwise valid
RGB content such as menu and popup text came out fully transparent.

Derive the upload alpha from the window surface metadata instead, as
winex11.drv does. Surfaces without a per-pixel alpha mask are uploaded
opaque, except that the constant LWA_ALPHA value is baked into the
pixels when the compositor does not offer wp_alpha_modifier_v1; when it
does, the driver already applies that alpha through the surface
multiplier, and doing both would apply it twice. ARGB8888 SHM buffers
are premultiplied, so the color channels are scaled by the baked alpha.

Surfaces with a per-pixel alpha mask keep the alpha the application
provided.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/winewayland.drv/window_surface.c | 58 ++++++++++++++++++++++-----
 1 file changed, 48 insertions(+), 10 deletions(-)

diff --git a/dlls/winewayland.drv/window_surface.c b/dlls/winewayland.drv/window_surface.c
index 62866478edd..1603f5ece2c 100644
--- a/dlls/winewayland.drv/window_surface.c
+++ b/dlls/winewayland.drv/window_surface.c
@@ -941,12 +941,34 @@ static void wayland_window_surface_sync_regions(struct window_surface *window_su
     wayland_win_data_release(data);
 }
 
+/**********************************************************************
+ *          apply_alpha_bits
+ *
+ * Replace the alpha byte of a pixel with a constant alpha, premultiplying
+ * the color channels as ARGB8888 SHM buffers expect.
+ */
+static UINT32 apply_alpha_bits(UINT32 pixel, UINT alpha_bits)
+{
+    UINT32 alpha = alpha_bits >> 24;
+    UINT32 r, g, b;
+
+    if (alpha == 0xff) return (pixel & 0x00ffffff) | 0xff000000;
+
+    r = ((pixel >> 16) & 0xff) * alpha / 0xff;
+    g = ((pixel >> 8) & 0xff) * alpha / 0xff;
+    b = (pixel & 0xff) * alpha / 0xff;
+    return (alpha << 24) | (r << 16) | (g << 8) | b;
+}
+
 /**********************************************************************
  *          copy_pixel_region
+ *
+ * Copy pixels between buffers, replacing the alpha byte with alpha_bits
+ * unless it is (UINT)-1.
  */
 static void copy_pixel_region(const char *src_pixels, RECT *src_rect,
                               char *dst_pixels, RECT *dst_rect,
-                              HRGN region, BOOL force_opaque)
+                              HRGN region, UINT alpha_bits)
 {
     static const int bpp = WINEWAYLAND_BYTES_PER_PIXEL;
     RGNDATA *rgndata = get_region_data(region);
@@ -982,21 +1004,21 @@ static void copy_pixel_region(const char *src_pixels, RECT *src_rect,
         /* Fast path for full width rectangles. */
         if (width * bpp == src_stride && src_stride == dst_stride)
         {
-            if (force_opaque)
+            if (alpha_bits != (UINT)-1)
             {
                 for (x = 0; x < height * width; ++x)
-                    ((UINT32 *)dst)[x] = ((UINT32 *)src)[x] | 0xff000000;
+                    ((UINT32 *)dst)[x] = apply_alpha_bits(((UINT32 *)src)[x], alpha_bits);
             }
             else memcpy(dst, src, height * width * 4);
             continue;
         }
 
-        if (force_opaque)
+        if (alpha_bits != (UINT)-1)
         {
             for (y = 0; y < height; y++)
             {
                 for (x = 0; x < width; ++x)
-                    ((UINT32 *)dst)[x] = ((UINT32 *)src)[x] | 0xff000000;
+                    ((UINT32 *)dst)[x] = apply_alpha_bits(((UINT32 *)src)[x], alpha_bits);
                 src += src_stride;
                 dst += dst_stride;
             }
@@ -1109,11 +1131,11 @@ static HRGN union_regions(HRGN a, HRGN b)
  */
 static void wayland_shm_buffer_copy_data(struct wayland_shm_buffer *buffer,
                                          const char *bits, RECT *rect,
-                                         HRGN region, BOOL force_opaque)
+                                         HRGN region, UINT alpha_bits)
 {
     RECT buffer_rect = {0, 0, buffer->width, buffer->height};
     TRACE("buffer=%p bits=%p rect=%s\n", buffer, bits, wine_dbgstr_rect(rect));
-    copy_pixel_region(bits, rect, buffer->map_data, &buffer_rect, region, force_opaque);
+    copy_pixel_region(bits, rect, buffer->map_data, &buffer_rect, region, alpha_bits);
 }
 
 static void wayland_shm_buffer_copy(struct wayland_shm_buffer *src,
@@ -1122,9 +1144,11 @@ static void wayland_shm_buffer_copy(struct wayland_shm_buffer *src,
 {
     RECT src_rect = {0, 0, src->width, src->height};
     RECT dst_rect = {0, 0, dst->width, dst->height};
+    UINT alpha_bits = (UINT)-1;
     TRACE("src=%p dst=%p\n", src, dst);
-    copy_pixel_region(src->map_data, &src_rect, dst->map_data, &dst_rect, region,
-                      src->format == WL_SHM_FORMAT_XRGB8888 && dst->format == WL_SHM_FORMAT_ARGB8888);
+    if (src->format == WL_SHM_FORMAT_XRGB8888 && dst->format == WL_SHM_FORMAT_ARGB8888)
+        alpha_bits = 0xff000000;
+    copy_pixel_region(src->map_data, &src_rect, dst->map_data, &dst_rect, region, alpha_bits);
 }
 
 /**********************************************************************
@@ -1174,6 +1198,7 @@ static BOOL wayland_window_surface_flush(struct window_surface *window_surface,
     HRGN gdi_over_region, gdi_over_paint_region;
     HRGN copy_from_window_region = NULL;
     HRGN self_paint_clip = NULL, clip_region = window_surface->clip_region;
+    UINT alpha_bits = (UINT)-1;
     uint32_t buffer_format;
 
     if (!window_surface->app_painted_full && !window_surface->app_painted_region)
@@ -1213,6 +1238,19 @@ static BOOL wayland_window_surface_flush(struct window_surface *window_surface,
         clip_region = self_paint_clip;
     }
 
+    /* Layered windows without a per-pixel alpha mask carry meaningless DIB
+     * alpha bytes, so derive the upload alpha from the surface metadata. The
+     * constant LWA_ALPHA value is only baked into the pixels when the
+     * compositor cannot apply it through wp_alpha_modifier_v1. */
+    if ((shape_bits || wws->occlusion_clipped) && !wws->layered) alpha_bits = 0xff000000;
+    else if (wws->layered && !window_surface->alpha_mask)
+    {
+        if (window_surface->alpha_bits != (UINT)-1 && !process_wayland.wp_alpha_modifier_v1)
+            alpha_bits = window_surface->alpha_bits;
+        else
+            alpha_bits = 0xff000000;
+    }
+
     buffer_format = (shape_bits || wws->occlusion_clipped || wws->layered) ?
                     WL_SHM_FORMAT_ARGB8888 : WL_SHM_FORMAT_XRGB8888;
     if (wws->wayland_buffer_queue->format != buffer_format)
@@ -1269,7 +1307,7 @@ static BOOL wayland_window_surface_flush(struct window_surface *window_surface,
     }
 
     wayland_shm_buffer_copy_data(shm_buffer, color_bits, &surface_rect, copy_from_window_region,
-                                 (shape_bits || wws->occlusion_clipped) && !wws->layered);
+                                 alpha_bits);
     if (shape_bits) wayland_shm_buffer_copy_shape(shm_buffer, rect, shape_info, shape_bits);
 
     gdi_over_region = window_surface->gdi_over_producer_region;
