#!/usr/bin/env bash
set -euo pipefail

proton_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tool_name="proton-custom-$(sed -n 's/.*toolVersion *= *"\([^"]*\)".*/\1/p' "$proton_dir/package.nix")"

usage() {
  cat <<EOF
usage: proton-custom-install [dev|store PATH|production|restore|status]

Modes:
  dev         install the local dev compat tool by repointing the proton-custom symlink
  store PATH  point the proton-custom symlink at an already-built Nix store package
  production  run nixos update so the system-installed proton-custom package is active
  restore     restore the proton-custom symlink to the last Nix store build
  status      print the active compat tool paths

The dev path does not need sudo. The production path delegates to your existing
nixos update command, so any sudo/sudolessAllowlist need is whatever nixos update
already requires.
EOF
}

mode="${1:-dev}"
case "$mode" in
  -h|--help)
    usage
    ;;
  dev)
    "$proton_dir/bin/proton-custom-dev" use
    ;;
  store)
    store_path="${2:-}"
    if [ -z "$store_path" ] || [ ! -d "$store_path/files" ]; then
      echo "store mode needs a built proton-custom store path" >&2
      exit 1
    fi
    compat_dir="$HOME/.local/share/Steam/compatibilitytools.d"
    saved_store="$proton_dir/src/.store-target"
    mkdir -p "$compat_dir"
    mkdir -p "$(dirname "$saved_store")"
    ln -sfn "$store_path" "$compat_dir/$tool_name"
    printf '%s\n' "$store_path" > "$saved_store"
    echo "$compat_dir/$tool_name -> $(realpath "$compat_dir/$tool_name")"
    ;;
  production|system)
    nixos update
    ;;
  restore)
    "$proton_dir/bin/proton-custom-dev" restore
    ;;
  status)
    "$proton_dir/bin/proton-custom-dev" status
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
