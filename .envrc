watch_file flake.lock shell.nix
watch_file ci/tools.nix
watch_file config/pkgs/dev/nixd/package.nix config/pkgs/dev/nixd/flake-primops.patch
watch_file config/pkgs/utils/nixosctl/ui/tray/lib.nix config/pkgs/utils/nixosctl/ui/tray/submenus.patch
watch_file config/pkgs/dev/btrc/native-lsp.patch
use nix
ln -sfn "$(nix-build --no-out-link ci/tools.nix -A python)" .direnv/python
