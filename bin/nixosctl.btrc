class NixosCtl {
    public NixosConfig config;

    public NixosCtl() {
        string root = Environment.get("NIXOS_CONFIG_ROOT", "/etc/nixos");
        self.config = NixosConfig(root);
    }

    class string env(string name, string fallback) {
        return Environment.get(name, fallback);
    }

    public void usage() {
        Console.log("Usage: nixosctl <eval|update|upgrade|install|snapshot|diff|fix-permissions|change-password|secure-boot|tpm2|displays|audio|caffeine|system|vm|e2e|graph> [args]");
    }

    public void applySpecArgs(VmTestSpec spec, CliArgs args, int startIndex) {
        for (int i = startIndex; i < args.count(); i++) {
            string value = args.get(i);
            if (value.equals("--arg")) {
                if (i + 1 >= args.count()) {
                    NixosLog.fatal("Expected --arg key=value");
                }
                spec.setArgPair(args.get(i + 1));
                i++;
                continue;
            }
            if (value.startsWith("--arg=")) {
                spec.setArgPair(Strings.removePrefix(value, "--arg="));
                continue;
            }
        }
        spec.expandArgs();
    }

    public string tail(CliArgs args, int startIndex) {
        Vector<string> parts = [];
        for (int i = startIndex; i < args.count(); i++) {
            parts.push(args.get(i));
        }
        return parts.join(" ");
    }

    public bool needsRoot(string command) {
        if (NixosCtl.env("NIXOSCTL_ASSUME_ROOT_FOR_TESTS", "false").equals("true")) {
            return false;
        }
        return command.equals("update")
            || command.equals("upgrade")
            || command.equals("install")
            || command.equals("snapshot")
            || command.equals("diff")
            || command.equals("fix-permissions")
            || command.equals("change-password")
            || command.equals("secure-boot")
            || command.equals("tpm2");
    }

    public int sudoSelf(CliArgs args) {
        Command sudo = Command("sudo");
        sudo.arg(args.program);
        for value in args.values {
            sudo.arg(value);
        }
        sudo.capture(false);
        ExecResult result = UnixShell().runCommand(sudo);
        return result.code;
    }

    public int runVm(CliArgs args) {
        if (args.count() < 3) {
            NixosLog.fatal("Usage: nixosctl vm <spec.json> <status|hash|setup|up|boot-iso|boot-disk|bootstrap-ssh|wait-ssh|ssh|snapshot|restore|stop|reset-state|clean-state>");
        }
        VmTestSpec spec = VmSpecParser.readFile(args.get(1));
        self.applySpecArgs(spec, args, 3);
        QemuE2eHarness vm = QemuE2eHarness(spec);
        string action = args.get(2);

        if (action.equals("status")) { vm.printStatus(); return 0; }
        if (action.equals("hash")) { Console.log(spec.stateHash); return 0; }
        if (action.equals("setup")) { vm.setup(); return 0; }
        if (action.equals("download-iso")) { vm.downloadIso(); return 0; }
        if (action.equals("create-key")) { vm.createSshKey(); return 0; }
        if (action.equals("create-disk")) { vm.createDisk(); return 0; }
        if (action.equals("up")) { vm.upFromIso(); return 0; }
        if (action.equals("boot-iso")) { vm.start(true); return 0; }
        if (action.equals("boot-disk")) { vm.start(false); return 0; }
        if (action.equals("bootstrap-ssh")) { vm.bootstrapSsh(); return 0; }
        if (action.equals("wait-ssh")) {
            int timeout = Strings.toInt(args.valueAfter("--timeout", "180"));
            if (!vm.waitForSsh(timeout)) { return 1; }
            return 0;
        }
        if (action.equals("ssh")) {
            string command = self.tail(args, 3);
            if (command.isEmpty()) { NixosLog.fatal("Usage: nixosctl vm <spec.json> ssh <command>"); }
            ExecResult result = vm.ssh(command, false);
            Console.log(result.stdout().trim());
            return result.code;
        }
        if (action.equals("host")) {
            string command = self.tail(args, 3);
            if (command.isEmpty()) { NixosLog.fatal("Usage: nixosctl vm <spec.json> host <command>"); }
            ExecResult result = vm.host(command, false);
            Console.log(result.stdout().trim());
            return result.code;
        }
        if (action.equals("copy-workspace")) {
            vm.copyWorkspace(args.valueAfter("--local", ".."), args.valueAfter("--remote", "/etc/nixos"));
            return 0;
        }
        if (action.equals("configure-vm-host")) { vm.configureVmHost(); return 0; }
        if (action.equals("install-nixos")) { vm.installNixosGuest(); return 0; }
        if (action.equals("reboot-disk")) { vm.rebootDisk(); return 0; }
        if (action.equals("snapshot")) { vm.snapshot(args.valueAfter("--name", "manual")); return 0; }
        if (action.equals("restore")) { vm.restore(args.valueAfter("--name", "manual")); return 0; }
        if (action.equals("record-state")) { vm.recordState(); return 0; }
        if (action.equals("stop")) { vm.stop(); return 0; }
        if (action.equals("reset-state")) { vm.resetState(); return 0; }
        if (action.equals("clean-state")) { vm.resetState(); vm.cleanStateRecord(); return 0; }

        NixosLog.fatal("Unknown vm action: " + action);
        return 1;
    }

    public Map<string, string> graphArgs(CliArgs args, int startIndex) {
        Map<string, string> result = {};
        for (int i = startIndex; i < args.count(); i++) {
            string value = args.get(i);
            if (value.equals("--arg")) {
                if (i + 1 >= args.count()) { NixosLog.fatal("Expected --arg key=value"); }
                int pos = Strings.find(args.get(i + 1), "=", 0);
                if (pos <= 0) { NixosLog.fatal("Expected --arg key=value"); }
                result.put(JsonObject.slice(args.get(i + 1), 0, pos), JsonObject.slice(args.get(i + 1), pos + 1, args.get(i + 1).len()));
                i++;
                continue;
            }
            if (value.startsWith("--arg=")) {
                string pair = Strings.removePrefix(value, "--arg=");
                int pos = Strings.find(pair, "=", 0);
                if (pos <= 0) { NixosLog.fatal("Expected --arg=key=value"); }
                result.put(JsonObject.slice(pair, 0, pos), JsonObject.slice(pair, pos + 1, pair.len()));
            }
        }
        return result;
    }

    public Vector<string> graphTargets(CliArgs args, int startIndex) {
        Vector<string> result = [];
        for (int i = startIndex; i < args.count(); i++) {
            string value = args.get(i);
            if (value.equals("--arg")) {
                i++;
                continue;
            }
            if (value.startsWith("--arg=")) { continue; }
            result.push(value);
        }
        return result;
    }

    public int runGraph(CliArgs args) {
        if (args.count() < 3) {
            NixosLog.fatal("Usage: nixosctl graph <graph.json> <list|status|coverage|run> [node ...] [--arg key=value]");
        }
        VmTestGraph graph = VmGraphParser.readFile(args.get(1));
        string action = args.get(2);
        Map<string, string> overrides = self.graphArgs(args, 3);
        VmGraphRunner runner = VmGraphRunner(graph, overrides);
        if (action.equals("list")) {
            runner.list();
            return 0;
        }
        if (action.equals("status")) {
            runner.status();
            return 0;
        }
        if (action.equals("coverage")) {
            int code = runner.operationCoverage();
            return code;
        }
        if (action.equals("run")) {
            int code = runner.run(self.graphTargets(args, 3));
            return code;
        }
        NixosLog.fatal("Usage: nixosctl graph <graph.json> <list|status|coverage|run> [node ...] [--arg key=value]");
        return 1;
    }

    public int run(CliArgs args) {
        if (args.count() == 0) {
            self.usage();
            return 1;
        }

        string cmd = args.command();
        if (self.needsRoot(cmd) && !Platform.isRoot()) {
            return self.sudoSelf(args);
        }

        if (cmd.equals("eval")) {
            if (args.count() < 2) { NixosLog.fatal("Usage: nixosctl eval <attribute>"); }
            Console.log(self.config.evalRaw(args.get(1)));
            return 0;
        }

        if (cmd.equals("update") || cmd.equals("upgrade")) {
            RebuildOptions options = RebuildOptions();
            options.rebuildFileSystem = args.has("--rebuild-filesystem");
            options.reboot = args.has("--reboot");
            options.clean = args.has("--clean") || args.has("--upgrade") || cmd.equals("upgrade");
            options.upgrade = args.has("--upgrade") || cmd.equals("upgrade");
            NixosRebuilder(self.config).update(options);
            return 0;
        }

        if (cmd.equals("install")) {
            Installer installer = Installer(self.config);
            if (args.has("--collect-garbage")) {
                installer.collectGarbage();
            }
            if (args.has("--debug")) {
                installer.debugShell();
            }
            installer.bootstrapConfigIfMissing();
            SecretsManager(self.config).createIfMissing(installer.plainTextPasswordPath());
            bool confirmed = args.has("--yes");
            if (args.has("--format") || (!confirmed && installer.interactive.confirm("Format " + self.config.diskDevice() + "?"))) {
                installer.eraseAndMountDisk();
            } else {
                installer.mountDisk();
            }
            if (confirmed || installer.interactive.confirm("Install NixOS?")) {
                ExecResult installed = installer.installNixos();
                if (!installed.ok()) { return installed.code; }
            } else if (installer.interactive.confirm("Permission NixOS?")) {
                installer.permissionNixos();
            }
            installer.interactive.askToReboot();
            return 0;
        }

        if (cmd.equals("snapshot")) {
            SnapshotManager(self.config).createInitialSnapshots();
            return 0;
        }

        if (cmd.equals("diff")) {
            DiffOptions options = DiffOptions();
            options.recent = args.has("--recent");
            options.showSymlinks = args.has("--show-symlinks");
            options.showPersistPaths = args.has("--show-persist-paths");
            options.showChildren = args.valueAfter("--show-children", "");
            string depth = args.valueAfter("--depth", "");
            if (!depth.isEmpty()) { options.depth = Strings.toInt(depth); }
            options.pattern = args.valueAfter("--pattern", "");
            options.diffignore = args.valueAfter("--diffignore", "");
            DiffScanner(self.config).print(options);
            return 0;
        }

        if (cmd.equals("fix-permissions")) {
            string username = NixosCtl.env("SUDO_USER", "");
            if (username.isEmpty()) {
                username = NixosCtl.env("USER", "root");
            }
            PermissionsManager(self.config).secureTree(username);
            return 0;
        }

        if (cmd.equals("change-password")) {
            if (args.has("--full-disk-encryption-only") && args.has("--user-account-only")) {
                NixosLog.fatal("Cannot use both --full-disk-encryption-only and --user-account-only");
            }
            bool changeFde = !args.has("--user-account-only");
            bool changeUser = !args.has("--full-disk-encryption-only");
            string oldPassword = args.valueAfter("--old", NixosCtl.env("NIXOS_OLD_PASSWORD", ""));
            string newPassword = args.valueAfter("--new", NixosCtl.env("NIXOS_NEW_PASSWORD", ""));
            Interactive interactive = Interactive();
            if ((changeFde || changeUser) && oldPassword.isEmpty()) {
                oldPassword = interactive.askPassword("Enter current password (LUKS + account)");
            }
            if (newPassword.isEmpty()) {
                newPassword = interactive.askPasswordConfirmed("Enter new password");
            }
            PasswordManager(self.config).change(oldPassword, newPassword, changeFde, changeUser, args.has("--update-tpm2"));
            return 0;
        }

        if (cmd.equals("secure-boot")) {
            if (args.count() < 2) { NixosLog.fatal("Usage: nixosctl secure-boot <enable|disable|status>"); }
            SecureBootManager manager = SecureBootManager(self.config);
            string action = args.get(1);
            if (action.equals("enable")) { manager.enable(args.has("--microsoft")); return 0; }
            if (action.equals("disable")) { manager.disable(); return 0; }
            if (action.equals("status")) { manager.status(); return 0; }
            NixosLog.fatal("Usage: nixosctl secure-boot <enable|disable|status>");
        }

        if (cmd.equals("tpm2")) {
            if (args.count() < 2) { NixosLog.fatal("Usage: nixosctl tpm2 <enable|disable|status>"); }
            Tpm2Manager tpm = Tpm2Manager(self.config);
            string action = args.get(1);
            if (action.equals("status")) {
                tpm.status();
                return 0;
            }
            if (action.equals("enable")) {
                if (!tpm.exists()) { NixosLog.fatal("TPM2 does not exist"); }
                if (!tpm.diskEncrypted()) { NixosLog.fatal("Root disk is not LUKS encrypted"); }
                if (!tpm.enroll()) { NixosLog.fatal("TPM2 enrollment failed"); }
                return 0;
            }
            if (action.equals("disable")) {
                if (!tpm.wipe()) { NixosLog.fatal("TPM2 wipe failed"); }
                return 0;
            }
        }

        if (cmd.equals("displays")) {
            if (args.count() < 2) { NixosLog.fatal("Usage: nixosctl displays <list|layout|enable|disable|primary|dpms> [args]"); }
            DisplayManager displays = DisplayManager();
            string action = args.get(1);
            if (action.equals("list")) { displays.list(); return 0; }
            if (action.equals("layout")) { displays.layout(); return 0; }
            if (args.count() < 3) { NixosLog.fatal("Missing display argument"); }
            if (action.equals("enable")) { displays.enable(args.get(2)); return 0; }
            if (action.equals("disable")) { displays.disable(args.get(2)); return 0; }
            if (action.equals("primary")) { displays.primary(args.get(2)); return 0; }
            if (action.equals("dpms")) { displays.dpms(args.get(2)); return 0; }
        }

        if (cmd.equals("audio")) {
            if (args.count() < 2) { NixosLog.fatal("Usage: nixosctl audio <list|current|set> [sink]"); }
            AudioManager audio = AudioManager();
            string action = args.get(1);
            if (action.equals("list")) { audio.list(); return 0; }
            if (action.equals("current")) { Console.log(audio.current()); return 0; }
            if (action.equals("set")) {
                if (args.count() < 3) { NixosLog.fatal("Usage: nixosctl audio set <sink>"); }
                audio.set(args.get(2));
                return 0;
            }
        }

        if (cmd.equals("caffeine")) {
            if (args.count() < 2) { NixosLog.fatal("Usage: nixosctl caffeine <status|enable|disable|toggle>"); }
            CaffeineManager caffeine = CaffeineManager();
            string action = args.get(1);
            if (action.equals("status")) { return caffeine.enabled() ? 0 : 1; }
            if (action.equals("enable")) { caffeine.enable(); return 0; }
            if (action.equals("disable")) { caffeine.disable(); return 0; }
            if (action.equals("toggle")) { caffeine.toggle(); return 0; }
        }

        if (cmd.equals("system")) {
            if (args.count() < 2) { NixosLog.fatal("Usage: nixosctl system <update|upgrade>"); }
            SystemUi system = SystemUi();
            string action = args.get(1);
            if (action.equals("update")) { system.update(); return 0; }
            if (action.equals("upgrade")) { system.upgrade(); return 0; }
        }

        if (cmd.equals("vm")) {
            return self.runVm(args);
        }

        if (cmd.equals("e2e")) {
            if (args.count() < 2) { NixosLog.fatal("Usage: nixosctl e2e <spec.json>"); }
            VmTestSpec spec = VmSpecParser.readFile(args.get(1));
            self.applySpecArgs(spec, args, 2);
            VmTestRunner runner = VmTestRunner(spec);
            int result = runner.run();
            return result;
        }

        if (cmd.equals("graph")) {
            return self.runGraph(args);
        }

        self.usage();
        return 1;
    }
}

int main(int argc, char** argv) {
    CliArgs args = CliArgs(argc, argv);
    NixosCtl app = NixosCtl();
    int code = app.run(args);
    return code;
}
