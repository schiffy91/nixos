// Password bytes have one owner, fixed capacity and an explicit wipe. They
// never become a managed string, an ExecResult, or part of controller state.
class PasswordResponse {
    private SleepPasswordHandle? handle;

    public PasswordResponse(SleepPasswordHandle handle) {
        self.handle = handle;
    }

    public int length() {
        return self.handle == null ? -1 : sleepPasswordLength(self.handle);
    }

    public bool matches(string expected) {
        return self.handle != null && sleepPasswordEquals(self.handle, expected);
    }

    public void close() {
        var current = self.handle;
        if (current != null) {
            sleepPasswordClose(current);
            self.handle = null;
        }
    }

    public void __del__() { self.close(); }
}

class PasswordPrompt {
    private string executable;
    private string label;

    public PasswordPrompt(string executable, string label) {
        self.executable = executable;
        self.label = label;
    }

    public PasswordResponse? read() {
        var handle = sleepPasswordReadPrompt(self.executable, self.label, (int)PR_SET_PDEATHSIG);
        if (handle == null) { return null; }
        return PasswordResponse(handle);
    }

    class int maxResponseSize() {
        return sleepPamMaxResponseSize();
    }
}

class AccountAuthentication {
    private string user;
    private string plymouth;

    public AccountAuthentication(string user, string plymouth) {
        self.user = user;
        self.plymouth = plymouth;
    }

    public bool check(bool retry) {
        // This dedicated process locks PAM's copies as well as our response.
        if (mlockall((int)MCL_CURRENT | (int)MCL_FUTURE) < 0) { throw "Cannot lock authentication memory"; }
        return sleepPamAuthenticate(self.user, self.plymouth, retry, (int)PR_SET_PDEATHSIG);
    }
}
