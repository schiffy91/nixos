// Closing this handle never unlocks the session. Only an authenticated caller
// may release it; a failed operation or process exit leaves VT switching held.
class LockedConsole {
    private int descriptor;

    public LockedConsole() {
        self.descriptor = sleepConsoleOpen();
        LockedConsole.require(self.descriptor, "open lock console");
    }

    class void require(int result, string operation) {
        if (result < 0) { throw f"Cannot {operation}"; }
    }

    private int active() {
        int vt = sleepConsoleActiveVt(self.descriptor);
        LockedConsole.require(vt, "read active console");
        return vt;
    }

    public void verify() {
        if (self.active() != 63) { throw "The lock console is not active"; }
        LockedConsole.require(sleepConsoleLockSwitch(self.descriptor), "retain console lock");
    }

    public void secure() {
        LockedConsole.require(sleepConsoleSecureInput(self.descriptor), "secure console input");
        if (self.active() != 63) {
            LockedConsole.require(sleepConsoleActivate(self.descriptor, 63), "activate lock console");
            LockedConsole.require(sleepConsoleWaitActive(self.descriptor, 63), "wait for lock console");
        }
        LockedConsole.require(sleepConsoleLockSwitch(self.descriptor), "lock console switching");
        if (self.active() != 63) { throw "The lock console is not active"; }
    }

    public void unlock(int original) {
        if (original < 1 || original >= 63) { throw "Invalid session console"; }
        LockedConsole.require(sleepConsoleDiscardInput(self.descriptor), "discard lock console input");
        LockedConsole.require(sleepConsoleUnlockSwitch(self.descriptor), "release console lock");
        LockedConsole.require(sleepConsoleActivate(self.descriptor, original), "restore session console");
        LockedConsole.require(sleepConsoleWaitActive(self.descriptor, original), "wait for session console");
    }

    public void close() {
        if (self.descriptor >= 0) {
            sleepConsoleClose(self.descriptor);
            self.descriptor = -1;
        }
    }
    public void __del__() { self.close(); }
}
