import Library.Console;
import Library.FileSystem;
import Library.Platform;
import ./Console.btrc;
import ./Display.btrc;

int main() {
    try {
        if (!Platform.isRoot() || getuid() != (uid_t)0) { throw "Display clearing requires root"; }
        var console = LockedConsole(); console.verify(); console.close();
        var directory = Directory("/dev/dri");
        var entries = directory.entries().sorted();
        if (directory.failed()) { throw "Cannot enumerate DRM cards"; }
        bool safe = true; bool found = false;
        for name in entries {
            if (!name.startsWith("card") || name.length() < 5 || name[4] < '0' || name[4] > '9') { continue; }
            found = true;
            var card = DisplayCard(PathTools.join("/dev/dri", name));
            bool blank = card.blank(); bool closed = card.close();
            if (!blank || !closed) { Console.error(f"Cannot safely clear {name}"); safe = false; }
        }
        return safe && found ? 0 : 1;
    } catch (string error) { Console.error(error); return 1; }
}
