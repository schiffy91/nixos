import Library.CLI;
import Library.Console;
import Library.Platform;
import ./Console.btrc;
import ./Authentication.btrc;

int main(int argc, char** argv) {
    try {
        if (!Platform.isRoot() || getuid() != (uid_t)0) { throw "Session locking requires root"; }
        struct rlimit core = { 0, 0 };
        LockedConsole.require(setrlimit(RLIMIT_CORE, &core), "disable core dumps");
        LockedConsole.require(prctl(PR_SET_DUMPABLE, 0), "disable process dumps");
        var args = CLIArgs(argc, argv);
        if (args.count() < 2) { throw "Missing session lock operation"; }
        var operation = args.get(1);
        if (operation.equals("authenticate") && (args.count() == 3 || args.count() == 4)) {
            if (args.count() == 4 && !args.get(3).equals("retry")) { throw "Invalid authentication option"; }
            return AccountAuthentication(args.get(2), args.get(0)).check(args.count() == 4) ? 0 : 1;
        }
        var console = LockedConsole();
        if (operation.equals("secure") && args.count() == 2) { console.secure(); }
        else if (operation.equals("verify") && args.count() == 2) { console.verify(); }
        else if (operation.equals("release") && args.count() == 3) {
            var original = args.get(2);
            for digit in original { if (digit < '0' || digit > '9') { throw "Invalid session console"; } }
            console.unlock(Strings.toInt(original));
        } else { throw "Invalid session lock operation"; }
        return 0;
    } catch (string error) { Console.error(error); return 1; }
}
