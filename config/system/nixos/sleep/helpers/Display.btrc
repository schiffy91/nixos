// Own DRM master and its enumerations only while clearing this card. Nothing
// saves the game's scanout or restores it on error; Plymouth redraws the lock.
class DisplayCard {
    private DisplayCardHandle? handle = null;

    public DisplayCard(string path) {
        self.handle = displayCardOpen(path);
    }

    public bool blank() {
        return self.handle != null && displayCardBlank(self.handle);
    }

    public bool close() {
        var current = self.handle;
        if (current == null) { return true; }
        bool closed = displayCardClose(current);
        self.handle = null;
        return closed;
    }

    public void __del__() { self.close(); }
}
