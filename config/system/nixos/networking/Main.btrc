import Library.CLI;
import Library.Console;
import Library.FileSystem;
import ./TrustedConnections.btrc;
import ./TrustedFirewall.btrc;

class TrustedConnectionsCommand {
    public TrustedFirewall firewall = TrustedFirewall();

    public void execute(CLIArgs args) {
        var configuration = args.require(0, "Usage: trusted-connections CONFIG [--stop] [--exclude-interface DEVICE]");
        Vector<string> excluded = [];
        var stop = false;
        for (int index = 1; index < args.count(); index++) {
            var option = args.get(index);
            if (option.equals("--stop")) { stop = true; }
            else if (option.equals("--exclude-interface") && index + 1 < args.count()) {
                index++;
                excluded.push(args.get(index));
            } else { throw "Unknown or incomplete argument"; }
        }
        if (stop) { self.firewall.remove(); }
        else { self.firewall.replace(TrustedConnections(configuration).current(excluded)); }
    }

    public int run(CLIArgs args) {
        if (args.count() == 0) {
            Console.error("Usage: trusted-connections CONFIG [--stop] [--exclude-interface DEVICE]");
            return 1;
        }
        var acquired = AdvisoryFileLock.acquire("/run/nixos-trusted-connections.lock", wait=true);
        if (!acquired.ok()) { Console.error("Cannot lock trusted network rules"); return 1; }
        var lock = acquired.value();
        var status = 0;
        try {
            try { self.execute(args); }
            catch (string error) {
                // Failed discovery must revoke old grants while still serialized.
                self.firewall.replace(TrustedRules());
                Console.error(f"trusted-connections: {error}");
                status = 1;
            }
        } finally { lock.close(); }
        return status;
    }
}

int main(int argc, char** argv) {
    return TrustedConnectionsCommand().run(CLIArgs(argc, argv));
}
