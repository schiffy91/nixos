import Library.CLI;
import Library.Console;
import Library.FileSystem;
import ./TrustedConnections.btrc;

#include <sys/file.h>
#include <fcntl.h>

int main(int argc, char** argv) {
    var args = CLIArgs(argc, argv);
    if (args.count() < 1) { Console.error("Usage: trusted-connections CONFIG [--stop] [--exclude-interface DEVICE]"); return 1; }
    var lock = (int)open("/run/nixos-trusted-connections.lock", (int)O_WRONLY | (int)O_CREAT | (int)O_CLOEXEC | (int)O_NOFOLLOW, 0600);
    if (lock < 0 || (int)flock(lock, (int)LOCK_EX) != 0) { if (lock >= 0) { close(lock); } return 1; }
    try {
        Vector<string> excluded = [];
        var stop = false;
        for (int i = 1; i < args.count(); i++) {
            if (args.get(i).equals("--stop")) { stop = true; }
            else if (args.get(i).equals("--exclude-interface") && i + 1 < args.count()) { i++; excluded.push(args.get(i)); }
            else { throw "Unknown or incomplete argument"; }
        }
        if (stop) { TrustedRules().apply(true); }
        else {
            var configuration = JSONValue.parse(Path.readAll(args.get(0)));
            if (!configuration.isObject()) { throw "Invalid trusted-connections configuration"; }
            TrustedRules.current(configuration, excluded).apply();
        }
    } catch (string error) {
        // An unavailable or malformed inventory must close previously granted access.
        TrustedRules().apply();
        close(lock);
        Console.error(f"trusted-connections: {error}");
        return 1;
    }
    close(lock);
    return 0;
}
