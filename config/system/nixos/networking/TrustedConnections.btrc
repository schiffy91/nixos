import Library.FileSystem;
import Library.JSON;
import Library.Process;
import Library.Strings;
import Library.Vector;

import ./NetworkPrefix.btrc;

class TrustedRules {
    public Vector<string> ipv4;
    public Vector<string> ipv6;

    public TrustedRules() { self.ipv4 = []; self.ipv6 = []; }

    class string restore(Vector<string> rules) {
        return "*filter\n:nixos-trusted - [0:0]\n-F nixos-trusted\n" + rules.join("\n") +
            (rules.isEmpty() ? "" : "\n") + "COMMIT\n";
    }

    class bool safeInterface(string device) {
        // iptables treats a trailing '+' as an interface prefix wildcard.
        if (device.isEmpty() || device.endsWith("+")) { return false; }
        for (int i = 0; i < device.len(); i++) {
            var c = device[i];
            if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
                  (c >= '0' && c <= '9') || c == '_' || c == '.' || c == ':' || c == '+' || c == '-')) {
                return false;
            }
        }
        return true;
    }

    class TrustedRules forAddresses(JSONValue addresses, Vector<string> trusted, JSONValue ports, Vector<string> excluded) {
        if (!addresses.isArray()) { throw "Invalid interface inventory"; }
        var rules = TrustedRules();
        for entry in addresses.elements() {
            var device = entry.get("ifname").asString();
            if (!trusted.contains(device) || excluded.contains(device) || !TrustedRules.safeInterface(device)) { continue; }
            Vector<string> networks = [];
            for address in entry.get("addr_info").elements() {
                var prefix = NetworkPrefix.fromAddress(address);
                if (prefix != null) {
                    var network = prefix.cidr();
                    if (!networks.contains(network)) { networks.push(network); }
                }
            }
            for network in networks.sorted() {
                for protocol in ["tcp", "udp"] {
                    Vector<int> numbers = [];
                    for port in ports.get(protocol).elements() {
                        if (!port.isInt() || port.asInt() < 1 || port.asInt() > 65535) { throw "Invalid service port"; }
                        numbers.push(port.asInt());
                    }
                    for port in numbers.distinct().sorted() {
                        var rule = f"-A nixos-trusted -i {device} -s {network} -p {protocol} --dport {port} -j nixos-fw-accept";
                        if (network.contains(":")) { rules.ipv6.push(rule); } else { rules.ipv4.push(rule); }
                    }
                }
            }
        }
        return rules;
    }

}

class TrustedConnections {
    public JSONValue configuration;

    public TrustedConnections(string path) {
        self.configuration = JSONValue.parse(Path.readAll(path));
        if (!self.configuration.isObject()) { throw "Invalid trusted-connections configuration"; }
    }

    public TrustedRules current(Vector<string> excluded) {
        var shell = UnixShell();
        // Avoid D-Bus activation of NM while it waits for network-pre.target.
        if (!shell.run("systemctl is-active --quiet NetworkManager.service", logFailure=false).ok()) { return TrustedRules(); }
        var addresses = JSONValue.parse(shell.run("ip -json address show up", throwOnFailure=true).stdout());
        Vector<string> profiles = [];
        for profile in self.configuration.get("connections").elements() { profiles.push(profile.asString()); }
        Vector<string> trusted = [];
        for entry in addresses.elements() {
            var device = entry.get("ifname").asString();
            var profile = shell.run(f"nmcli --get-values GENERAL.CON-UUID device show {ShellWords.quote(device)}", logFailure=false);
            if (profile.ok() && profiles.contains(profile.stdout().trim())) { trusted.push(device); }
        }
        return TrustedRules.forAddresses(addresses, trusted, self.configuration.get("ports"), excluded);
    }
}
