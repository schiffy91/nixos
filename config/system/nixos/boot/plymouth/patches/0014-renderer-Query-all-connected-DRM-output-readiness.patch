@@ -29,6 +29,14 @@
 #include <sys/inotify.h>
 #include <sys/stat.h>
 #include <sys/types.h>
+#ifdef HAVE_DRM_READINESS
+#include <fcntl.h>
+#include <glob.h>
+#include <unistd.h>
+#include <xf86drm.h>
+#include <xf86drmMode.h>
+#endif
+
 
 #ifdef HAVE_UDEV
 #include <libudev.h>
@@ -1465,3 +1473,65 @@ ply_device_manager_unpause (ply_device_manager_t *manager)
         watch_for_udev_events (manager);
 #endif
 }
+
+/* Enumerate independently of the renderer table: an open/query failure must
+ * not turn a connected card into an invisible success. Headless cards are
+ * harmless only when resource readback confirms no connected or active output.
+ */
+bool
+ply_device_manager_has_safe_displays (ply_device_manager_t *manager)
+{
+#ifdef HAVE_DRM_READINESS
+        glob_t cards = { 0 };
+        bool safe = true, found = false;
+        size_t i;
+
+        if (glob ("/dev/dri/card[0-9]*", 0, NULL, &cards) != 0)
+                return false;
+        for (i = 0; i < cards.gl_pathc; i++) {
+                drmModeRes *resources;
+                ply_renderer_t *renderer;
+                bool needed = false;
+                int fd, j;
+
+                fd = open (cards.gl_pathv[i], O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+                resources = fd >= 0 ? drmModeGetResources (fd) : NULL;
+                if (resources == NULL) {
+                        safe = false;
+                        if (fd >= 0)
+                                close (fd);
+                        continue;
+                }
+                for (j = 0; j < resources->count_connectors; j++) {
+                        drmModeConnector *connector = drmModeGetConnectorCurrent (fd, resources->connectors[j]);
+                        if (connector == NULL) {
+                                safe = false;
+                        } else {
+                                needed |= connector->connection == DRM_MODE_CONNECTED;
+                                drmModeFreeConnector (connector);
+                        }
+                }
+                for (j = 0; j < resources->count_crtcs; j++) {
+                        drmModeCrtc *crtc = drmModeGetCrtc (fd, resources->crtcs[j]);
+                        if (crtc == NULL) {
+                                safe = false;
+                        } else {
+                                needed |= crtc->mode_valid || crtc->buffer_id != 0;
+                                drmModeFreeCrtc (crtc);
+                        }
+                }
+                drmModeFreeResources (resources);
+                close (fd);
+                if (!needed)
+                        continue;
+                found = true;
+                renderer = ply_hashtable_lookup (manager->renderers, cards.gl_pathv[i]);
+                if (renderer == NULL || !ply_renderer_has_safe_displays (renderer))
+                        safe = false;
+        }
+        globfree (&cards);
+        return safe && found;
+#else
+        return false;
+#endif
+}
