+/* Read the kernel's current scanout, not optimistic renderer bookkeeping.
+ * Every connected output and enabled plane must refer to our mapped buffer.
+ * No modesetting or permissive boot behavior is changed by this query.
+ */
+static uint32_t
+buffer_for_controller (ply_renderer_backend_t *backend, uint32_t controller_id)
+{
+        ply_list_node_t *node;
+        for (node = ply_list_get_first_node (backend->heads); node != NULL;
+             node = ply_list_get_next_node (backend->heads, node)) {
+                ply_renderer_head_t *head = ply_list_node_get_data (node);
+                ply_renderer_controller_t **controllers =
+                        (ply_renderer_controller_t **) ply_array_get_pointer_elements (head->controllers);
+                int i;
+                for (i = 0; i < ply_array_get_size (head->controllers); i++)
+                        if (controllers[i]->controller_id == controller_id)
+                                return head->scan_out_buffer_id;
+        }
+        return 0;
+}
+
+static bool
+has_safe_displays (ply_renderer_backend_t *backend)
+{
+        drmModeRes *resources;
+        drmModePlaneRes *planes;
+        ply_list_node_t *node;
+        bool safe = true, found = false;
+        int i;
+
+        if (!backend->is_active || backend->activation_failed || drmIsMaster (backend->device_fd) != 1)
+                return false;
+        resources = drmModeGetResources (backend->device_fd);
+        if (resources == NULL)
+                return false;
+        for (node = ply_list_get_first_node (backend->heads); node != NULL;
+             node = ply_list_get_next_node (backend->heads, node)) {
+                ply_renderer_head_t *head = ply_list_node_get_data (node);
+                if (head->scan_out_buffer_id == 0)
+                        safe = false;
+        }
+        for (i = 0; i < resources->count_crtcs; i++) {
+                drmModeCrtc *crtc = drmModeGetCrtc (backend->device_fd, resources->crtcs[i]);
+                if (crtc == NULL) {
+                        safe = false;
+                } else {
+                        uint32_t expected = buffer_for_controller (backend, crtc->crtc_id);
+                        if ((crtc->mode_valid || crtc->buffer_id != 0) &&
+                            (!crtc->mode_valid || expected == 0 || crtc->buffer_id != expected))
+                                safe = false;
+                        drmModeFreeCrtc (crtc);
+                }
+        }
+        for (i = 0; i < resources->count_connectors; i++) {
+                drmModeConnector *connector = drmModeGetConnectorCurrent (backend->device_fd, resources->connectors[i]);
+                if (connector == NULL) {
+                        safe = false;
+                } else if (connector->connection == DRM_MODE_CONNECTED) {
+                        drmModeEncoder *encoder = connector->encoder_id != 0 ?
+                                drmModeGetEncoder (backend->device_fd, connector->encoder_id) : NULL;
+                        drmModeCrtc *crtc = encoder != NULL && encoder->crtc_id != 0 ?
+                                drmModeGetCrtc (backend->device_fd, encoder->crtc_id) : NULL;
+                        uint32_t expected = crtc != NULL ? buffer_for_controller (backend, crtc->crtc_id) : 0;
+                        found = true;
+                        if (crtc == NULL || !crtc->mode_valid || expected == 0 || crtc->buffer_id != expected)
+                                safe = false;
+                        if (crtc != NULL)
+                                drmModeFreeCrtc (crtc);
+                        if (encoder != NULL)
+                                drmModeFreeEncoder (encoder);
+                }
+                if (connector != NULL)
+                        drmModeFreeConnector (connector);
+        }
+        drmModeFreeResources (resources);
+        if (drmSetClientCap (backend->device_fd, DRM_CLIENT_CAP_UNIVERSAL_PLANES, 1) != 0)
+                return false;
+        planes = drmModeGetPlaneResources (backend->device_fd);
+        if (planes == NULL)
+                return false;
+        for (i = 0; i < planes->count_planes; i++) {
+                drmModePlane *plane = drmModeGetPlane (backend->device_fd, planes->planes[i]);
+                if (plane == NULL) {
+                        safe = false;
+                } else {
+                        if (plane->fb_id != 0 && (plane->crtc_id == 0 ||
+                            plane->fb_id != buffer_for_controller (backend, plane->crtc_id)))
+                                safe = false;
+                        drmModeFreePlane (plane);
+                }
+        }
+        drmModeFreePlaneResources (planes);
+        return safe && found;
+}
