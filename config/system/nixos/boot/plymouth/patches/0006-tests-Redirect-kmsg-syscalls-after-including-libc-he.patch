From bde3afa6f0da616092e4fffa07a2ec4a2ba9e535 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <Alexander.Schiffhauer@gmail.com>
Date: Fri, 6 Nov 2026 17:34:55 -0800
Subject: [PATCH 06/12] tests: Redirect kmsg syscalls after including libc
 headers

Fortified read wrappers can bypass preprocessor renaming inside system headers and block on the real socket. Include system declarations before defining the fixture redirects so optimized builds exercise the intended calls.
---
 tests/kmsg-reader-test-syscalls.h | 20 ++++++++++++++++++++
 tests/meson.build                 |  3 +--
 2 files changed, 21 insertions(+), 2 deletions(-)
 create mode 100644 tests/kmsg-reader-test-syscalls.h

diff --git a/tests/kmsg-reader-test-syscalls.h b/tests/kmsg-reader-test-syscalls.h
new file mode 100644
index 00000000..48fae122
--- /dev/null
+++ b/tests/kmsg-reader-test-syscalls.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef KMSG_READER_TEST_SYSCALLS_H
+#define KMSG_READER_TEST_SYSCALLS_H
+
+/* Include libc declarations before redirecting calls. Renaming read in the
+* system headers lets fortified inline wrappers bypass the test fixture. */
+#include <fcntl.h>
+#include <unistd.h>
+
+int ply_test_kmsg_open (const char *path,
+                        int         flags,
+                        ...);
+ssize_t ply_test_kmsg_read (int    fd,
+                            void  *buffer,
+                            size_t size);
+
+#define open ply_test_kmsg_open
+#define read ply_test_kmsg_read
+
+#endif
diff --git a/tests/meson.build b/tests/meson.build
index 48c873f3..70d3dd01 100644
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -427,8 +427,7 @@ kmsg_reader_test_executable = executable(
     '../src/libply-splash-core/ply-kmsg-reader.c',
   ],
   c_args: test_c_args + [
-    '-Dopen=ply_test_kmsg_open',
-    '-Dread=ply_test_kmsg_read',
+    '-include', meson.current_source_dir() / 'kmsg-reader-test-syscalls.h',
     '-Wno-cast-function-type',
   ],
   dependencies: libply_dep,
-- 
2.56.0

