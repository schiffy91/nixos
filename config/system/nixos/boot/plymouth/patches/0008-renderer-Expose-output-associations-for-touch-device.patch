From ac9a0398b1f3f89f1162b98a86da97a8cddfc09f Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <Alexander.Schiffhauer@gmail.com>
Date: Fri, 6 Nov 2026 17:10:21 -0800
Subject: [PATCH 08/12] renderer: Expose output associations for touch devices

Allow a caller to match a logical display head against a DRM connector name rather than guessing from its pixel dimensions. Accept card-qualified names when different GPUs have identical connector names, and account for every connector in a cloned or tiled head.
---
 src/libply-splash-core/ply-renderer-plugin.h |  3 ++
 src/libply-splash-core/ply-renderer.c        | 12 +++++
 src/libply-splash-core/ply-renderer.h        |  3 ++
 src/plugins/renderers/drm/plugin.c           | 46 ++++++++++++++++++++
 tests/plugins/renderers/fake-renderer.c      |  9 ++++
 tests/test-renderer.c                        |  4 ++
 6 files changed, 77 insertions(+)

diff --git a/src/libply-splash-core/ply-renderer-plugin.h b/src/libply-splash-core/ply-renderer-plugin.h
index 8f7014da..79ebba05 100644
--- a/src/libply-splash-core/ply-renderer-plugin.h
+++ b/src/libply-splash-core/ply-renderer-plugin.h
@@ -85,6 +85,9 @@ typedef struct
         void (*remove_input_device)(ply_renderer_backend_t *backend,
                                     ply_input_device_t     *input_device);
         const char * (*get_keyboard_layout)(ply_renderer_backend_t *backend);
+        bool (*head_has_output)(ply_renderer_backend_t *backend,
+                                ply_renderer_head_t    *head,
+                                const char             *output_name);
 } ply_renderer_plugin_interface_t;
 
 #endif /* PLY_RENDERER_PLUGIN_H */
diff --git a/src/libply-splash-core/ply-renderer.c b/src/libply-splash-core/ply-renderer.c
index c139c8b2..97558eb6 100644
--- a/src/libply-splash-core/ply-renderer.c
+++ b/src/libply-splash-core/ply-renderer.c
@@ -542,3 +542,15 @@ ply_renderer_get_keyboard_layout (ply_renderer_t *renderer)
 
         return renderer->plugin_interface->get_keyboard_layout (renderer->backend);
 }
+
+bool
+ply_renderer_head_has_output (ply_renderer_t      *renderer,
+                              ply_renderer_head_t *head,
+                              const char          *output_name)
+{
+        if (head == NULL || output_name == NULL || renderer->plugin_interface == NULL ||
+            renderer->plugin_interface->head_has_output == NULL)
+                return false;
+
+        return renderer->plugin_interface->head_has_output (renderer->backend, head, output_name);
+}
diff --git a/src/libply-splash-core/ply-renderer.h b/src/libply-splash-core/ply-renderer.h
index ac69b120..de966d7e 100644
--- a/src/libply-splash-core/ply-renderer.h
+++ b/src/libply-splash-core/ply-renderer.h
@@ -99,6 +99,9 @@ bool ply_renderer_get_panel_properties (ply_renderer_t              *renderer,
 bool ply_renderer_get_capslock_state (ply_renderer_t *renderer);
 const char *ply_renderer_get_keymap (ply_renderer_t *renderer);
 const char *ply_renderer_get_keyboard_layout (ply_renderer_t *renderer);
+bool ply_renderer_head_has_output (ply_renderer_t      *renderer,
+                                   ply_renderer_head_t *head,
+                                   const char          *output_name);
 #endif
 
 #endif /* PLY_RENDERER_H */
diff --git a/src/plugins/renderers/drm/plugin.c b/src/plugins/renderers/drm/plugin.c
index eeeacee4..aed9ee76 100644
--- a/src/plugins/renderers/drm/plugin.c
+++ b/src/plugins/renderers/drm/plugin.c
@@ -136,6 +136,7 @@ typedef struct
         drmModeModeInfo             mode;
         uint32_t                    connector_id;
         uint32_t                    connector_type;
+        uint32_t                    connector_type_id;
         uint32_t                    controller_id;
         uint32_t                    possible_controllers;
         int                         device_scale;
@@ -1370,6 +1371,7 @@ get_output_info (ply_renderer_backend_t *backend,
                                                              (!has_90_rotation) ? connector->mmWidth : connector->mmHeight,
                                                              (!has_90_rotation) ? connector->mmHeight : connector->mmWidth);
         output->connector_type = connector->connector_type;
+        output->connector_type_id = connector->connector_type_id;
         output->connected = true;
 out:
         drmModeFreeConnector (connector);
@@ -2338,6 +2340,49 @@ get_panel_properties (ply_renderer_backend_t      *backend,
         return true;
 }
 
+static bool
+head_has_output (ply_renderer_backend_t *backend,
+                 ply_renderer_head_t    *head,
+                 const char             *output_name)
+{
+        ply_renderer_controller_t **controllers;
+        const char *device_name;
+        int number_of_controllers, i, j;
+
+        device_name = strrchr (backend->device_name, '/');
+        device_name = device_name != NULL ? device_name + 1 : backend->device_name;
+        controllers = (ply_renderer_controller_t **) ply_array_get_pointer_elements (head->controllers);
+        number_of_controllers = ply_array_get_size (head->controllers);
+
+        for (i = 0; i < number_of_controllers; i++) {
+                for (j = 0; j < backend->outputs_len; j++) {
+                        ply_output_t *output = &backend->outputs[j];
+                        const char *connector_type;
+                        char name[128];
+
+                        if (!output->connected ||
+                            !ply_array_contains_uint32_element (controllers[i]->connector_ids, output->connector_id))
+                                continue;
+
+                        connector_type = drmModeGetConnectorTypeName (output->connector_type);
+                        if (connector_type == NULL)
+                                continue;
+
+                        snprintf (name, sizeof(name), "%s-%u", connector_type, output->connector_type_id);
+                        if (strcmp (output_name, name) == 0)
+                                return true;
+
+                        /* Qualify the connector when multiple GPUs have the same name. */
+                        snprintf (name, sizeof(name), "%s-%s-%u", device_name,
+                                  connector_type, output->connector_type_id);
+                        if (strcmp (output_name, name) == 0)
+                                return true;
+                }
+        }
+
+        return false;
+}
+
 static ply_input_device_t *
 get_any_input_device (ply_renderer_backend_t *backend)
 {
@@ -2437,6 +2482,7 @@ ply_renderer_backend_get_interface (void)
                 .close_input_source           = close_input_source,
                 .get_device_name              = get_device_name,
                 .get_panel_properties         = get_panel_properties,
+                .head_has_output              = head_has_output,
                 .get_capslock_state           = get_capslock_state,
                 .get_keymap                   = get_keymap,
                 .add_input_device             = add_input_device,
diff --git a/tests/plugins/renderers/fake-renderer.c b/tests/plugins/renderers/fake-renderer.c
index d4b8678d..a1ecd27f 100644
--- a/tests/plugins/renderers/fake-renderer.c
+++ b/tests/plugins/renderers/fake-renderer.c
@@ -246,6 +246,14 @@ add_input_device (ply_renderer_backend_t *backend,
         state.input_device = input_device;
 }
 
+static bool
+head_has_output (ply_renderer_backend_t *backend,
+                 ply_renderer_head_t    *head,
+                 const char             *output_name)
+{
+        return head == &backend->head && strcmp (output_name, "Virtual-1") == 0;
+}
+
 static void
 remove_input_device (ply_renderer_backend_t *backend,
                      ply_input_device_t     *input_device)
@@ -280,6 +288,7 @@ ply_renderer_backend_get_interface (void)
                 .get_capslock_state           = get_capslock_state,
                 .get_keymap                   = get_keymap,
                 .get_keyboard_layout          = get_keyboard_layout,
+                .head_has_output              = head_has_output,
                 .add_input_device             = add_input_device,
                 .remove_input_device          = remove_input_device,
         };
diff --git a/tests/test-renderer.c b/tests/test-renderer.c
index a08152bd..35746cf9 100644
--- a/tests/test-renderer.c
+++ b/tests/test-renderer.c
@@ -93,6 +93,10 @@ test_renderer_delegates_backend_lifecycle (void)
         node = ply_list_get_first_node (ply_renderer_get_heads (renderer));
         PLY_TEST_ASSERT (node != NULL);
         head = ply_list_node_get_data (node);
+        PLY_TEST_ASSERT (ply_renderer_head_has_output (renderer, head, "Virtual-1"));
+        PLY_TEST_ASSERT (!ply_renderer_head_has_output (renderer, head, "Virtual-2"));
+        PLY_TEST_ASSERT (!ply_renderer_head_has_output (renderer, NULL, "Virtual-1"));
+        PLY_TEST_ASSERT (!ply_renderer_head_has_output (renderer, head, NULL));
         buffer = ply_renderer_get_buffer_for_head (renderer, head);
         PLY_TEST_ASSERT (buffer != NULL);
         ply_pixel_buffer_get_size (buffer, &size);
-- 
