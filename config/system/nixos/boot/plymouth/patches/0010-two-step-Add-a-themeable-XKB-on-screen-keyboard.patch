diff --git a/src/libply-splash-graphics/ply-keyboard-geometry.c b/src/libply-splash-graphics/ply-keyboard-geometry.c
new file mode 100644
index 00000000..6db8113b
--- /dev/null
+++ b/src/libply-splash-graphics/ply-keyboard-geometry.c
@@ -0,0 +1,207 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "ply-keyboard-geometry.h"
+
+#include <limits.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define MAX_KEYS 128
+#define MAX_UNITS 4096
+
+struct _ply_keyboard_geometry
+{
+        ply_keyboard_key_t keys[MAX_KEYS];
+        size_t             count;
+        unsigned long      columns, rows;
+        bool               valid;
+};
+
+/* ISO key positions in quarter-key units. XKB supplies all characters. */
+#define KEY(name, x, y, width) { name, PLY_KEYBOARD_KEY, x, y, width, 4 }
+static const ply_keyboard_key_t default_keys[] = {
+        KEY ("TLDE", 0,                  0,  4),  KEY ("AE01", 4,  0,           4), KEY ("AE02", 8,  0,  4), KEY ("AE03", 12, 0,  4),
+        KEY ("AE04", 16,                 0,  4),  KEY ("AE05", 20, 0,           4), KEY ("AE06", 24, 0,  4), KEY ("AE07", 28, 0,  4),
+        KEY ("AE08", 32,                 0,  4),  KEY ("AE09", 36, 0,           4), KEY ("AE10", 40, 0,  4), KEY ("AE11", 44, 0,  4),
+        KEY ("AE12", 48,                 0,  4),  KEY ("BKSP", 52, 0,           8),
+        KEY ("TAB",  0,                  4,  4),  KEY ("AD01", 4,  4,           4), KEY ("AD02", 8,  4,  4), KEY ("AD03", 12, 4,  4),
+        KEY ("AD04", 16,                 4,  4),  KEY ("AD05", 20, 4,           4), KEY ("AD06", 24, 4,  4), KEY ("AD07", 28, 4,  4),
+        KEY ("AD08", 32,                 4,  4),  KEY ("AD09", 36, 4,           4), KEY ("AD10", 40, 4,  4), KEY ("AD11", 44, 4,  4),
+        KEY ("AD12", 48,                 4,  4),  KEY ("BKSL", 52, 4,           8),
+        { "CAPS",    PLY_KEYBOARD_LOCK,  0,  8,   7,           4 },
+        KEY ("AC01", 7,                  8,  4),  KEY ("AC02", 11, 8,           4), KEY ("AC03", 15, 8,  4), KEY ("AC04", 19, 8,  4),
+        KEY ("AC05", 23,                 8,  4),  KEY ("AC06", 27, 8,           4), KEY ("AC07", 31, 8,  4), KEY ("AC08", 35, 8,  4),
+        KEY ("AC09", 39,                 8,  4),  KEY ("AC10", 43, 8,           4), KEY ("AC11", 47, 8,  4),
+        { "LFSH",    PLY_KEYBOARD_LATCH, 0,  12,  6,           4 },KEY ("LSGT", 6,  12,          4),
+        KEY ("AB01", 10,                 12, 4),  KEY ("AB02", 14, 12,          4), KEY ("AB03", 18, 12, 4), KEY ("AB04", 22, 12, 4),
+        KEY ("AB05", 26,                 12, 4),  KEY ("AB06", 30, 12,          4), KEY ("AB07", 34, 12, 4), KEY ("AB08", 38, 12, 4),
+        KEY ("AB09", 42,                 12, 4),  KEY ("AB10", 46, 12,          4),
+        { "RTSH",    PLY_KEYBOARD_LATCH, 50, 12,  10,          4 },
+        { "GROUP",   PLY_KEYBOARD_GROUP, 0,  16,  10,          4 },
+        { "RALT",    PLY_KEYBOARD_LATCH, 10, 16,  8,           4 },
+        KEY ("SPCE", 18,                 16, 24), KEY ("RTRN", 42, 16,          18)
+};
+#undef KEY
+
+ply_keyboard_geometry_t *
+ply_keyboard_geometry_new (void)
+{
+        ply_keyboard_geometry_t *geometry = calloc (1, sizeof(*geometry));
+
+        if (geometry == NULL)
+                return NULL;
+        memcpy (geometry->keys, default_keys, sizeof(default_keys));
+        geometry->count = sizeof(default_keys) / sizeof(default_keys[0]);
+        geometry->columns = 60;
+        geometry->rows = 20;
+        geometry->valid = true;
+        return geometry;
+}
+
+typedef struct
+{
+        ply_keyboard_geometry_t *geometry;
+        ply_key_file_t          *file;
+} load_data_t;
+
+static void
+load_key (const char *group,
+          const char *entry,
+          const char *value,
+          void       *user_data)
+{
+        load_data_t *data = user_data;
+        ply_keyboard_geometry_t *geometry = data->geometry;
+        ply_keyboard_key_t *key;
+        char *behavior;
+        size_t i;
+
+        if (strncmp (group, "Key ", 4) != 0 || !geometry->valid)
+                return;
+        for (i = 0; i < geometry->count; i++) {
+                if (strcmp (geometry->keys[i].name, group + 4) == 0)
+                        return;
+        }
+        if (geometry->count == MAX_KEYS || strlen (group + 4) == 0 || strlen (group + 4) >= sizeof(key->name)) {
+                geometry->valid = false;
+                return;
+        }
+
+        key = &geometry->keys[geometry->count++];
+        strcpy (key->name, group + 4);
+        key->x = ply_key_file_get_ulong (data->file, group, "X", ULONG_MAX);
+        key->y = ply_key_file_get_ulong (data->file, group, "Y", ULONG_MAX);
+        key->width = ply_key_file_get_ulong (data->file, group, "Width", 4);
+        key->height = ply_key_file_get_ulong (data->file, group, "Height", 4);
+        behavior = ply_key_file_get_value (data->file, group, "Behavior");
+        if (behavior == NULL || strcmp (behavior, "key") == 0)
+                key->behavior = PLY_KEYBOARD_KEY;
+        else if (strcmp (behavior, "latch") == 0)
+                key->behavior = PLY_KEYBOARD_LATCH;
+        else if (strcmp (behavior, "lock") == 0)
+                key->behavior = PLY_KEYBOARD_LOCK;
+        else if (strcmp (behavior, "group") == 0)
+                key->behavior = PLY_KEYBOARD_GROUP;
+        else
+                geometry->valid = false;
+        free (behavior);
+
+        if (key->width == 0 || key->height == 0 || key->width > geometry->columns ||
+            key->height > geometry->rows || key->x > geometry->columns - key->width ||
+            key->y > geometry->rows - key->height)
+                geometry->valid = false;
+}
+
+ply_keyboard_geometry_t *
+ply_keyboard_geometry_load (ply_key_file_t *file)
+{
+        ply_keyboard_geometry_t *geometry = calloc (1, sizeof(*geometry));
+        load_data_t data = { geometry, file };
+        size_t i, j;
+
+        if (geometry == NULL)
+                return NULL;
+        geometry->columns = ply_key_file_get_ulong (file, "Keyboard Geometry", "Columns", 0);
+        geometry->rows = ply_key_file_get_ulong (file, "Keyboard Geometry", "Rows", 0);
+        geometry->valid = geometry->columns > 0 && geometry->columns <= MAX_UNITS &&
+                          geometry->rows > 0 && geometry->rows <= MAX_UNITS;
+        ply_key_file_foreach_entry (file, load_key, &data);
+        for (i = 0; geometry->valid && i < geometry->count; i++) {
+                const ply_keyboard_key_t *a = &geometry->keys[i];
+                for (j = i + 1; j < geometry->count; j++) {
+                        const ply_keyboard_key_t *b = &geometry->keys[j];
+                        if (a->x < b->x + b->width && b->x < a->x + a->width &&
+                            a->y < b->y + b->height && b->y < a->y + a->height)
+                                geometry->valid = false;
+                }
+        }
+        if (!geometry->valid || geometry->count == 0) {
+                free (geometry);
+                return NULL;
+        }
+        return geometry;
+}
+
+void
+ply_keyboard_geometry_free (ply_keyboard_geometry_t *geometry)
+{
+        free (geometry);
+}
+
+size_t
+ply_keyboard_geometry_get_key_count (ply_keyboard_geometry_t *geometry)
+{
+        return geometry->count;
+}
+
+const ply_keyboard_key_t *
+ply_keyboard_geometry_get_key (ply_keyboard_geometry_t *geometry,
+                               size_t                   index)
+{
+        return index < geometry->count ? &geometry->keys[index] : NULL;
+}
+
+bool
+ply_keyboard_geometry_get_rectangle (ply_keyboard_geometry_t *geometry,
+                                     size_t                   index,
+                                     const ply_rectangle_t   *area,
+                                     double                   gap,
+                                     ply_rectangle_t         *rectangle)
+{
+        const ply_keyboard_key_t *key = ply_keyboard_geometry_get_key (geometry, index);
+        double x, y, right, bottom, inset;
+
+        if (key == NULL || area->width == 0 || area->height == 0 || !isfinite (gap) || gap < 0)
+                return false;
+        x = area->x + (double) key->x * area->width / geometry->columns;
+        y = area->y + (double) key->y * area->height / geometry->rows;
+        right = area->x + (double) (key->x + key->width) * area->width / geometry->columns;
+        bottom = area->y + (double) (key->y + key->height) * area->height / geometry->rows;
+        inset = fmin (gap, fmin (right - x, bottom - y) * .4) / 2;
+        rectangle->x = ceil (x + inset);
+        rectangle->y = ceil (y + inset);
+        if (floor (right - inset) <= rectangle->x || floor (bottom - inset) <= rectangle->y)
+                return false;
+        rectangle->width = floor (right - inset) - rectangle->x;
+        rectangle->height = floor (bottom - inset) - rectangle->y;
+        return true;
+}
+
+int
+ply_keyboard_geometry_hit (ply_keyboard_geometry_t *geometry,
+                           const ply_rectangle_t   *area,
+                           double                   gap,
+                           double                   x,
+                           double                   y)
+{
+        size_t i;
+        ply_rectangle_t rectangle;
+
+        for (i = 0; i < geometry->count; i++) {
+                if (ply_keyboard_geometry_get_rectangle (geometry, i, area, gap, &rectangle) &&
+                    x >= rectangle.x && x < rectangle.x + rectangle.width &&
+                    y >= rectangle.y && y < rectangle.y + rectangle.height)
+                        return i;
+        }
+        return -1;
+}
diff --git a/src/libply-splash-graphics/ply-keyboard-geometry.h b/src/libply-splash-graphics/ply-keyboard-geometry.h
