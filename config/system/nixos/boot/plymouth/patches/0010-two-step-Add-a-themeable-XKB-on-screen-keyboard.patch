+static void
+cache_prompt (ply_boot_splash_plugin_t *plugin,
+              const char               *prompt,
+              const char               *entry_text,
+              int                       bullets)
+{
+        char *new_prompt = strdup (prompt != NULL ? prompt : "");
+        char *new_entry_text = entry_text != NULL ? strdup (entry_text) : NULL;
+
+        free (plugin->prompt);
+        free (plugin->entry_text);
+        plugin->prompt = new_prompt;
+        plugin->entry_text = new_entry_text;
+        plugin->bullets = bullets;
+}
+
+static void
+keyboard_changed (void *user_data)
+{
+        ply_boot_splash_plugin_t *plugin = user_data;
+        ply_list_node_t *node;
+
+        if (!plugin->is_visible || plugin->should_show_console_messages ||
+            plugin->state == PLY_BOOT_SPLASH_DISPLAY_NORMAL)
+                return;
+        pause_views (plugin);
+        for (node = ply_list_get_first_node (plugin->views); node != NULL;
+             node = ply_list_get_next_node (plugin->views, node)) {
+                view_t *view = ply_list_node_get_data (node);
+                unsigned long height = ply_on_screen_keyboard_get_height (plugin->on_screen_keyboard, view->display);
+
+                if (height != view->keyboard_height) {
+                        /* Relayout every prompt control, including indicators
+                         * which must be hidden before being shown again. */
+                        ply_entry_hide (view->entry);
+                        ply_capslock_icon_hide (view->capslock_icon);
+                        ply_keymap_icon_hide (view->keymap_icon);
+                        ply_label_hide (view->label);
+                        view_show_prompt (view, plugin->prompt, plugin->entry_text, plugin->bullets);
+                }
+        }
+        redraw_views (plugin);
+        process_needed_redraws (plugin);
+        unpause_views (plugin);
+}
+
+static void
+set_keyboard (ply_boot_splash_plugin_t *plugin,
+              ply_keyboard_t           *keyboard)
+{
+        plugin->keyboard = keyboard;
+        ply_on_screen_keyboard_set_keyboard (plugin->on_screen_keyboard, keyboard);
+        keyboard_changed (plugin);
+}
+
+static void
+unset_keyboard (ply_boot_splash_plugin_t *plugin,
+                ply_keyboard_t           *keyboard)
+{
+        if (plugin->keyboard == keyboard) {
+                plugin->keyboard = NULL;
+                ply_on_screen_keyboard_set_keyboard (plugin->on_screen_keyboard, NULL);
+                keyboard_changed (plugin);
+        }
+}
