--- /dev/null
+++ b/tests/test-keyboard-geometry.c
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "ply-test.h"
+
+#include <fcntl.h>
+#include <math.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "ply-keyboard-geometry.h"
+
+static ply_keyboard_geometry_t *
+load (const char *contents)
+{
+        char path[] = "/tmp/plymouth-keyboard-geometry-XXXXXX";
+        int fd = mkstemp (path);
+        ply_key_file_t *file;
+        ply_keyboard_geometry_t *geometry = NULL;
+
+        if (fd < 0)
+                return NULL;
+        if (write (fd, contents, strlen (contents)) == (ssize_t) strlen (contents)) {
+                close (fd);
+                file = ply_key_file_new (path);
+                if (ply_key_file_load (file))
+                        geometry = ply_keyboard_geometry_load (file);
+                ply_key_file_free (file);
+        } else {
+                close (fd);
+        }
+        unlink (path);
+        return geometry;
+}
+
+static bool
+test_key_targets_share_drawing_geometry (void)
+{
+        const unsigned long sizes[][2] = { { 320, 120 }, { 1280, 400 }, { 3840, 1080 }, { 768, 1000 } };
+        ply_keyboard_geometry_t *geometry = ply_keyboard_geometry_new ();
+        size_t i, n;
+
+        PLY_TEST_ASSERT (geometry != NULL);
+        for (n = 0; n < sizeof(sizes) / sizeof(sizes[0]); n++) {
+                ply_rectangle_t area = { .x = 17, .y = 23, .width = sizes[n][0], .height = sizes[n][1] };
+                for (i = 0; i < ply_keyboard_geometry_get_key_count (geometry); i++) {
+                        ply_rectangle_t key;
+                        PLY_TEST_ASSERT (ply_keyboard_geometry_get_rectangle (geometry, i, &area, 4, &key));
+                        PLY_TEST_ASSERT (key.x >= area.x && key.y >= area.y);
+                        PLY_TEST_ASSERT (key.x + key.width <= area.x + area.width);
+                        PLY_TEST_ASSERT (key.y + key.height <= area.y + area.height);
+                        PLY_TEST_ASSERT (ply_keyboard_geometry_hit (geometry, &area, 4,
+                                                                    key.x + key.width / 2., key.y + key.height / 2.) == (int) i);
+                        PLY_TEST_ASSERT (ply_keyboard_geometry_hit (geometry, &area, 4,
+                                                                    key.x + key.width, key.y + key.height / 2.) == -1);
+                }
+                PLY_TEST_ASSERT (ply_keyboard_geometry_hit (geometry, &area, 4, NAN, 30) == -1);
+                PLY_TEST_ASSERT (ply_keyboard_geometry_hit (geometry, &area, 4, 30, INFINITY) == -1);
+        }
+        ply_keyboard_geometry_free (geometry);
+        return true;
+}
+
+static bool
+test_configured_geometry_changes_targets (void)
+{
+        ply_keyboard_geometry_t *geometry = load (
+                "[Keyboard Geometry]\nColumns=12\nRows=8\n"
+                "[Key AD01]\nX=8\nY=0\n"
+                "[Key SPCE]\nX=0\nY=4\nWidth=8\n"
+                "[Key GROUP]\nX=8\nY=4\nBehavior=group\n");
+        ply_rectangle_t area = { .width = 120, .height = 80 };
+        int index;
+
+        PLY_TEST_ASSERT (geometry != NULL);
+        PLY_TEST_ASSERT (ply_keyboard_geometry_get_key_count (geometry) == 3);
+        index = ply_keyboard_geometry_hit (geometry, &area, 2, 100, 20);
+        PLY_TEST_ASSERT (index >= 0);
+        PLY_TEST_ASSERT (strcmp (ply_keyboard_geometry_get_key (geometry, index)->name, "AD01") == 0);
+        index = ply_keyboard_geometry_hit (geometry, &area, 2, 100, 60);
+        PLY_TEST_ASSERT (index >= 0);
+        PLY_TEST_ASSERT (ply_keyboard_geometry_get_key (geometry, index)->behavior == PLY_KEYBOARD_GROUP);
+        PLY_TEST_ASSERT (ply_keyboard_geometry_hit (geometry, &area, 2, 20, 20) == -1);
+        ply_keyboard_geometry_free (geometry);
+        return true;
+}
+
+static bool
+test_invalid_geometry_is_rejected (void)
+{
+        static const char *invalid[] = {
+                "[Keyboard Geometry]\nColumns=0\nRows=20\n[Key AD01]\nX=0\nY=0\n",
+                "[Keyboard Geometry]\nColumns=60\nRows=20\n[Key AD01]\nX=-1\nY=0\n",
+                "[Keyboard Geometry]\nColumns=60\nRows=20\n[Key AD01]\nX=0\nY=0\nWidth=18446744073709551615\n",
+                "[Keyboard Geometry]\nColumns=60\nRows=20\n[Key AD01]\nX=0\nY=0\nBehavior=invalid\n",
+                "[Keyboard Geometry]\nColumns=60\nRows=20\n[Key AD01]\nX=0\nY=0\n[Key AD02]\nX=2\nY=0\n",
+                "[Keyboard Geometry]\nColumns=60\nRows=20\n[Key AD01]\nY=0\n",
+                "[Keyboard Geometry]\nColumns=60\nRows=20\n",
+        };
+        size_t i;
+
+        for (i = 0; i < sizeof(invalid) / sizeof(invalid[0]); i++) {
+                PLY_TEST_ASSERT (load (invalid[i]) == NULL);
+        }
+        return true;
+}
+
+static const ply_test_case_t test_cases[] = {
+        PLY_TEST_CASE (test_key_targets_share_drawing_geometry),
+        PLY_TEST_CASE (test_configured_geometry_changes_targets),
+        PLY_TEST_CASE (test_invalid_geometry_is_rejected)
+};
+PLY_TEST_MAIN (test_cases)
