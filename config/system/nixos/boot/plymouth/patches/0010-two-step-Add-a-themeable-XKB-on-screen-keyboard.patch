+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef PLY_KEYBOARD_GEOMETRY_H
+#define PLY_KEYBOARD_GEOMETRY_H
+
+#include "ply-key-file.h"
+#include "ply-rectangle.h"
+
+typedef enum
+{
+        PLY_KEYBOARD_KEY,
+        PLY_KEYBOARD_LATCH,
+        PLY_KEYBOARD_LOCK,
+        PLY_KEYBOARD_GROUP
+} ply_keyboard_key_behavior_t;
+
+typedef struct
+{
+        char                        name[32];
+        ply_keyboard_key_behavior_t behavior;
+        unsigned long               x, y, width, height;
+} ply_keyboard_key_t;
+
+typedef struct _ply_keyboard_geometry ply_keyboard_geometry_t;
+
+#ifndef PLY_HIDE_FUNCTION_DECLARATIONS
+ply_keyboard_geometry_t *ply_keyboard_geometry_new (void);
+ply_keyboard_geometry_t *ply_keyboard_geometry_load (ply_key_file_t *file);
+void ply_keyboard_geometry_free (ply_keyboard_geometry_t *geometry);
+size_t ply_keyboard_geometry_get_key_count (ply_keyboard_geometry_t *geometry);
+const ply_keyboard_key_t *ply_keyboard_geometry_get_key (ply_keyboard_geometry_t *geometry,
+                                                         size_t                   index);
+bool ply_keyboard_geometry_get_rectangle (ply_keyboard_geometry_t *geometry,
+                                          size_t                   index,
+                                          const ply_rectangle_t   *area,
+                                          double                   gap,
+                                          ply_rectangle_t         *rectangle);
+int ply_keyboard_geometry_hit (ply_keyboard_geometry_t *geometry,
+                               const ply_rectangle_t   *area,
+                               double                   gap,
+                               double                   x,
+                               double                   y);
+#endif
+#endif
diff --git a/src/libply-splash-graphics/ply-on-screen-keyboard.c b/src/libply-splash-graphics/ply-on-screen-keyboard.c
new file mode 100644
index 00000000..b0a82425
--- /dev/null
+++ b/src/libply-splash-graphics/ply-on-screen-keyboard.c
@@ -0,0 +1,520 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "ply-on-screen-keyboard.h"
+
+#include <libintl.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <xkbcommon/xkbcommon-keysyms.h>
+
+#include "ply-keyboard-geometry.h"
+#include "ply-keyboard-layout.h"
+#include "ply-label.h"
+#include "ply-list.h"
+#include "ply-logger.h"
+#include "ply-touch-input.h"
+
+#define _(text) dgettext ("plymouth", text)
+#define SETTINGS "OnScreenKeyboard"
+
+struct _ply_on_screen_keyboard
+{
+        ply_keyboard_geometry_t         *geometry;
+        ply_keyboard_layout_t           *layout;
+        ply_keyboard_t                  *keyboard;
+        ply_touch_input_t               *touch;
+        ply_list_t                      *displays;
+        ply_label_t                     *label;
+        ply_on_screen_keyboard_changed_t changed;
+        void                            *user_data;
+        bool                            *latched;
+        bool                             active, prompt, password, requested;
+        ply_touch_device_t              *pressed_device;
+        ply_pixel_display_t             *pressed_display;
+        int                              pressed_slot, pressed_key;
+        uint32_t                         background_color, key_color, action_color, selected_color, text_color;
+        unsigned long                    max_width, height_percent, gap, font_size;
+        char                            *font;
+};
+
+static void
+cancel_touch (ply_on_screen_keyboard_t *keyboard)
+{
+        keyboard->pressed_device = NULL;
+        keyboard->pressed_display = NULL;
+        keyboard->pressed_slot = keyboard->pressed_key = -1;
+}
+
+static xkb_keycode_t
+keycode_for_index (ply_on_screen_keyboard_t *keyboard,
+                   size_t                    index)
+{
+        const ply_keyboard_key_t *key = ply_keyboard_geometry_get_key (keyboard->geometry, index);
+        struct xkb_keymap *keymap = xkb_state_get_keymap (ply_keyboard_layout_get_state (keyboard->layout));
+
+        return xkb_keymap_key_by_name (keymap, key->name);
+}
+
+static void
+release_latches (ply_on_screen_keyboard_t *keyboard)
+{
+        ply_buffer_t *output;
+        size_t i;
+
+        if (keyboard->layout == NULL)
+                return;
+        output = ply_buffer_new ();
+        for (i = 0; i < ply_keyboard_geometry_get_key_count (keyboard->geometry); i++) {
+                if (keyboard->latched[i]) {
+                        ply_keyboard_layout_key (keyboard->layout, keycode_for_index (keyboard, i), XKB_KEY_UP, output);
+                        keyboard->latched[i] = false;
+                }
+        }
+        ply_buffer_free (output);
+}
+
+static ply_pixel_display_t *
+display_for_device (ply_on_screen_keyboard_t *keyboard,
+                    ply_touch_device_t       *device)
+{
+        const char *name = ply_touch_device_get_output_name (device);
+        ply_list_node_t *node;
+        ply_pixel_display_t *match = NULL;
+        unsigned int matches = 0;
+
+        for (node = ply_list_get_first_node (keyboard->displays); node != NULL; node = ply_list_get_next_node (keyboard->displays, node)) {
+                ply_pixel_display_t *display = ply_list_node_get_data (node);
+
+                if (name == NULL || ply_renderer_head_has_output (ply_pixel_display_get_renderer (display),
+                                                                  ply_pixel_display_get_renderer_head (display), name)) {
+                        matches++;
+                        match = display;
+                }
+        }
+        /* An unspecified or ambiguous association must never type on a
+         * different monitor. A single output needs no explicit mapping. */
+        return matches == 1 ? match : NULL;
+}
+
+bool
+ply_on_screen_keyboard_is_visible (ply_on_screen_keyboard_t *keyboard,
+                                   ply_pixel_display_t      *display)
+{
+        ply_list_t *devices;
+        ply_list_node_t *node;
+
+        if (keyboard == NULL || !keyboard->active || !keyboard->prompt || keyboard->layout == NULL ||
+            (!keyboard->requested && ply_touch_input_get_keyboard_count (keyboard->touch) > 0))
+                return false;
+        devices = ply_touch_input_get_devices (keyboard->touch);
+        if (devices == NULL)
+                return false;
+        for (node = ply_list_get_first_node (devices); node != NULL; node = ply_list_get_next_node (devices, node)) {
+                ply_touch_device_t *device = ply_list_node_get_data (node);
+                if (ply_touch_device_is_touchscreen (device) && display_for_device (keyboard, device) == display)
+                        return true;
+        }
+        return false;
+}
+
+unsigned long
+ply_on_screen_keyboard_get_height (ply_on_screen_keyboard_t *keyboard,
+                                   ply_pixel_display_t      *display)
+{
+        if (!ply_on_screen_keyboard_is_visible (keyboard, display))
+                return 0;
+        return ply_pixel_display_get_height (display) * keyboard->height_percent / 100;
+}
+
+static ply_rectangle_t
+keyboard_area (ply_on_screen_keyboard_t *keyboard,
+               ply_pixel_display_t      *display)
+{
+        unsigned long width = ply_pixel_display_get_width (display);
+        unsigned long height = ply_pixel_display_get_height (display);
+        unsigned long keyboard_width = fmin (width * .96, keyboard->max_width);
+        unsigned long keyboard_height = height * keyboard->height_percent / 100;
+
+        return (ply_rectangle_t) { .x = (width - keyboard_width) / 2,
+                                   .y = height - keyboard_height + keyboard->gap,
+                                   .width = keyboard_width,
+                                   .height = keyboard_height > 2 * keyboard->gap ? keyboard_height - 2 * keyboard->gap : 0 };
+}
+
+static int
+hit (ply_on_screen_keyboard_t *keyboard,
+     ply_pixel_display_t      *display,
+     double                    x,
+     double                    y)
+{
+        ply_pixel_buffer_t *buffer = ply_renderer_get_buffer_for_head (ply_pixel_display_get_renderer (display),
+                                                                       ply_pixel_display_get_renderer_head (display));
+        ply_rectangle_t area = keyboard_area (keyboard, display);
+        double a = x, b = y;
+
+        if (buffer == NULL)
+                return -1;
+        switch (ply_pixel_buffer_get_device_rotation (buffer)) {
+        case PLY_PIXEL_BUFFER_ROTATE_CLOCKWISE: x = b; y = 1 - a; break;
+        case PLY_PIXEL_BUFFER_ROTATE_COUNTER_CLOCKWISE: x = 1 - b; y = a; break;
+        case PLY_PIXEL_BUFFER_ROTATE_UPSIDE_DOWN: x = 1 - a; y = 1 - b; break;
+        default: break;
+        }
+        return ply_keyboard_geometry_hit (keyboard->geometry, &area, keyboard->gap,
+                                          x * ply_pixel_display_get_width (display), y * ply_pixel_display_get_height (display));
+}
+
+static void
+activate_key (ply_on_screen_keyboard_t *keyboard,
+              int                       index)
+{
+        const ply_keyboard_key_t *key;
+        ply_buffer_t *output;
+        xkb_keycode_t keycode;
+        struct xkb_state *state;
+
+        if (index < 0 || keyboard->layout == NULL || keyboard->keyboard == NULL)
+                return;
+        key = ply_keyboard_geometry_get_key (keyboard->geometry, index);
+        state = ply_keyboard_layout_get_state (keyboard->layout);
+        if (key->behavior == PLY_KEYBOARD_GROUP) {
+                xkb_layout_index_t group = xkb_state_serialize_layout (state, XKB_STATE_LAYOUT_EFFECTIVE);
+                xkb_layout_index_t count = xkb_keymap_num_layouts (xkb_state_get_keymap (state));
+
+                release_latches (keyboard);
+                ply_keyboard_layout_set_group (keyboard->layout, (group + 1) % count);
+                return;
+        }
+        keycode = keycode_for_index (keyboard, index);
+        if (keycode == XKB_KEYCODE_INVALID)
+                return;
+        output = ply_buffer_new ();
+        if (key->behavior == PLY_KEYBOARD_LATCH) {
+                keyboard->latched[index] = !keyboard->latched[index];
+                ply_keyboard_layout_key (keyboard->layout, keycode,
+                                         keyboard->latched[index] ? XKB_KEY_DOWN : XKB_KEY_UP, output);
+        } else {
+                ply_keyboard_layout_key (keyboard->layout, keycode, XKB_KEY_DOWN, output);
+                ply_keyboard_layout_key (keyboard->layout, keycode, XKB_KEY_UP, output);
+                if (key->behavior == PLY_KEYBOARD_KEY)
+                        release_latches (keyboard);
+        }
+        /* Delivery may synchronously change or dismiss the prompt. All local
+         * modifier transitions must finish before invoking its handlers. */
+        if (ply_buffer_get_size (output) > 0)
+                ply_keyboard_input (keyboard->keyboard, ply_buffer_get_bytes (output), ply_buffer_get_size (output));
+        ply_buffer_clear (output);
+        ply_buffer_free (output);
+}
+
+static void
+on_touch (void                    *user_data,
+          const ply_touch_event_t *event)
+{
+        ply_on_screen_keyboard_t *keyboard = user_data;
+        ply_pixel_display_t *display;
+
+        if (event->type == PLY_TOUCH_DEVICE_ADDED || event->type == PLY_TOUCH_DEVICE_REMOVED) {
+                cancel_touch (keyboard);
+                keyboard->changed (keyboard->user_data);
+                return;
+        }
+        if (!keyboard->active || !keyboard->prompt || keyboard->layout == NULL)
+                return;
+        display = display_for_device (keyboard, event->device);
+        if (display == NULL)
+                return;
+        if (event->type == PLY_TOUCH_DOWN && keyboard->pressed_device == NULL) {
+                bool visible = ply_on_screen_keyboard_is_visible (keyboard, display);
+
+                keyboard->requested = true;
+                keyboard->pressed_device = event->device;
+                keyboard->pressed_display = display;
+                keyboard->pressed_slot = event->slot;
+                keyboard->pressed_key = visible ? hit (keyboard, display, event->x, event->y) : -1;
+        } else if (keyboard->pressed_device == event->device && keyboard->pressed_slot == event->slot) {
+                if (event->type == PLY_TOUCH_MOTION) {
+                        if (hit (keyboard, display, event->x, event->y) != keyboard->pressed_key)
+                                keyboard->pressed_key = -1;
+                } else if (event->type == PLY_TOUCH_UP) {
+                        int index = keyboard->pressed_key;
+
+                        cancel_touch (keyboard);
+                        activate_key (keyboard, index);
+                } else if (event->type == PLY_TOUCH_CANCEL) {
+                        cancel_touch (keyboard);
+                }
+        }
+        keyboard->changed (keyboard->user_data);
+}
+
+static unsigned long
+setting (ply_key_file_t *settings,
+         const char     *name,
+         unsigned long   fallback,
+         unsigned long   minimum,
+         unsigned long   maximum)
+{
+        unsigned long value = ply_key_file_get_ulong (settings, SETTINGS, name, fallback);
+
+        return value >= minimum && value <= maximum ? value : fallback;
+}
+
+ply_on_screen_keyboard_t *
+ply_on_screen_keyboard_new (ply_key_file_t                  *settings,
+                            ply_on_screen_keyboard_changed_t changed,
+                            void                            *user_data)
+{
+        ply_on_screen_keyboard_t *keyboard = calloc (1, sizeof(*keyboard));
+        char *geometry_path;
+
+        if (keyboard == NULL)
+                return NULL;
+        keyboard->geometry = ply_keyboard_geometry_new ();
+        geometry_path = ply_key_file_get_value (settings, SETTINGS, "Geometry");
+        if (geometry_path != NULL) {
+                ply_key_file_t *file = ply_key_file_new (geometry_path);
+                ply_keyboard_geometry_t *geometry = NULL;
+
+                if (ply_key_file_load (file))
+                        geometry = ply_keyboard_geometry_load (file);
+                if (geometry != NULL) {
+                        ply_keyboard_geometry_free (keyboard->geometry);
+                        keyboard->geometry = geometry;
+                } else {
+                        ply_error ("Invalid on-screen keyboard geometry; using the default");
+                }
+                ply_key_file_free (file);
+                free (geometry_path);
+        }
+        if (keyboard->geometry == NULL) {
+                free (keyboard);
+                return NULL;
+        }
+        keyboard->latched = calloc (ply_keyboard_geometry_get_key_count (keyboard->geometry), sizeof(bool));
+        if (keyboard->latched == NULL) {
+                ply_keyboard_geometry_free (keyboard->geometry);
+                free (keyboard);
+                return NULL;
+        }
+        keyboard->background_color = setting (settings, "BackgroundColor", 0x23262e, 0, 0xffffff);
+        keyboard->key_color = setting (settings, "KeyColor", 0x0e141b, 0, 0xffffff);
+        keyboard->action_color = setting (settings, "ActionColor", 0, 0, 0xffffff);
+        keyboard->selected_color = setting (settings, "SelectedColor", 0x1a9fff, 0, 0xffffff);
+        keyboard->text_color = setting (settings, "TextColor", 0xffffff, 0, 0xffffff);
+        keyboard->max_width = setting (settings, "MaxWidth", 1280, 240, 8192);
+        keyboard->height_percent = setting (settings, "HeightPercent", 52, 20, 70);
+        keyboard->gap = setting (settings, "Gap", 4, 0, 32);
+        keyboard->font_size = setting (settings, "FontSize", 18, 6, 48);
+        keyboard->font = ply_key_file_get_value (settings, SETTINGS, "Font");
+        if (keyboard->font == NULL)
+                keyboard->font = strdup ("Sans");
+        keyboard->displays = ply_list_new ();
+        keyboard->label = ply_label_new ();
+        keyboard->changed = changed;
+        keyboard->user_data = user_data;
+        cancel_touch (keyboard);
+        keyboard->touch = ply_touch_input_new (ply_event_loop_get_default (), "seat0", on_touch, keyboard);
+        return keyboard;
+}
+
+void
+ply_on_screen_keyboard_free (ply_on_screen_keyboard_t *keyboard)
+{
+        if (keyboard == NULL)
+                return;
+        ply_touch_input_free (keyboard->touch);
+        ply_keyboard_layout_free (keyboard->layout);
+        ply_keyboard_geometry_free (keyboard->geometry);
+        ply_list_free (keyboard->displays);
+        ply_label_free (keyboard->label);
+        free (keyboard->font);
+        free (keyboard->latched);
+        free (keyboard);
+}
+
+void
+ply_on_screen_keyboard_set_keyboard (ply_on_screen_keyboard_t *keyboard,
+                                     ply_keyboard_t           *input)
+{
+        const char *locale;
+
+        if (keyboard == NULL || keyboard->keyboard == input)
+                return;
+        cancel_touch (keyboard);
+        release_latches (keyboard);
+        ply_keyboard_layout_free (keyboard->layout);
+        keyboard->layout = NULL;
+        keyboard->keyboard = input;
+        locale = getenv ("LC_ALL");
+        if (locale == NULL) locale = getenv ("LC_CTYPE");
+        if (locale == NULL) locale = getenv ("LANG");
+        if (locale == NULL) locale = "C";
+        if (input != NULL && ply_keyboard_get_keymap (input) != NULL)
+                keyboard->layout = ply_keyboard_layout_new (ply_keyboard_get_keymap (input), locale);
+}
+
+void
+ply_on_screen_keyboard_set_active (ply_on_screen_keyboard_t *keyboard,
+                                   bool                      active)
+{
+        if (keyboard == NULL)
+                return;
+        keyboard->active = active;
+        if (!active) {
+                cancel_touch (keyboard);
+                release_latches (keyboard);
+                if (keyboard->layout != NULL)
+                        ply_keyboard_layout_reset_compose (keyboard->layout);
+        }
+        ply_touch_input_set_active (keyboard->touch, active);
+}
+
+void
+ply_on_screen_keyboard_set_prompt (ply_on_screen_keyboard_t *keyboard,
+                                   bool                      prompt,
+                                   bool                      password)
+{
+        if (keyboard == NULL)
+                return;
+        keyboard->password = password;
+        if (keyboard->prompt != prompt) {
+                cancel_touch (keyboard);
+                release_latches (keyboard);
+                if (keyboard->layout != NULL)
+                        ply_keyboard_layout_reset_compose (keyboard->layout);
+        }
+        keyboard->prompt = prompt;
+}
+
+void
+ply_on_screen_keyboard_add_display (ply_on_screen_keyboard_t *keyboard,
+                                    ply_pixel_display_t      *display)
+{
+        if (keyboard == NULL)
+                return;
+        cancel_touch (keyboard);
+        ply_list_append_data (keyboard->displays, display);
+}
+
+void
+ply_on_screen_keyboard_remove_display (ply_on_screen_keyboard_t *keyboard,
+                                       ply_pixel_display_t      *display)
+{
+        if (keyboard == NULL)
+                return;
+        cancel_touch (keyboard);
+        ply_list_remove_data (keyboard->displays, display);
+}
+
+static char *
+key_label (ply_on_screen_keyboard_t *keyboard,
+           const ply_keyboard_key_t *key,
+           size_t                    index)
+{
+        const char *label = NULL;
+        struct xkb_state *state = ply_keyboard_layout_get_state (keyboard->layout);
+        xkb_keysym_t symbol;
+
+        if (key->behavior == PLY_KEYBOARD_GROUP) {
+                xkb_layout_index_t group = xkb_state_serialize_layout (state, XKB_STATE_LAYOUT_EFFECTIVE);
+                label = xkb_keymap_layout_get_name (xkb_state_get_keymap (state), group);
+                return strdup (label != NULL ? label : _ ("Layout"));
+        }
+        if (keycode_for_index (keyboard, index) == XKB_KEYCODE_INVALID)
+                return strdup ("");
+        symbol = xkb_state_key_get_one_sym (state, keycode_for_index (keyboard, index));
+        switch (symbol) {
+        case XKB_KEY_BackSpace: return strdup (_ ("Backspace"));
+        case XKB_KEY_Return: return strdup (keyboard->password ? _ ("Unlock") : _ ("Enter"));
+        case XKB_KEY_space: return strdup (_ ("Space"));
+        case XKB_KEY_Shift_L:
+        case XKB_KEY_Shift_R: return strdup (_ ("Shift"));
+        case XKB_KEY_Caps_Lock: return strdup (_ ("Caps"));
+        case XKB_KEY_ISO_Level3_Shift: return strdup (_ ("AltGr"));
+        case XKB_KEY_Alt_L:
+        case XKB_KEY_Alt_R: return strdup (_ ("Alt"));
+        case XKB_KEY_Control_L:
+        case XKB_KEY_Control_R: return strdup (_ ("Ctrl"));
+        case XKB_KEY_Tab:
+        case XKB_KEY_ISO_Left_Tab: return strdup (_ ("Tab"));
+        case XKB_KEY_Escape: return strdup (_ ("Esc"));
+        case XKB_KEY_Multi_key: return strdup (_ ("Compose"));
+        case XKB_KEY_dead_acute: return strdup ("´");
+        case XKB_KEY_dead_grave: return strdup ("`");
+        case XKB_KEY_dead_circumflex: return strdup ("^");
+        case XKB_KEY_dead_diaeresis: return strdup ("¨");
+        case XKB_KEY_dead_tilde: return strdup ("~");
+        case XKB_KEY_dead_caron: return strdup ("ˇ");
+        case XKB_KEY_dead_cedilla: return strdup ("¸");
+        case XKB_KEY_dead_abovering: return strdup ("°");
+        default: return ply_keyboard_layout_get_label (keyboard->layout, keycode_for_index (keyboard, index));
+        }
+}
+
+static void
+draw_label (ply_on_screen_keyboard_t *keyboard,
+            ply_pixel_buffer_t       *buffer,
+            const ply_rectangle_t    *rectangle,
+            const char               *text)
+{
+        double size = keyboard->font_size;
+        char *font;
+        long width, height;
+
+        ply_label_set_text (keyboard->label, text);
+        ply_label_set_hex_color (keyboard->label, (keyboard->text_color << 8) | 0xff);
+        for (;;) {
+                if (asprintf (&font, "%s %.1f", keyboard->font, size) < 0)
+                        return;
+                ply_label_set_font (keyboard->label, font);
+                free (font);
+                ply_label_show (keyboard->label, NULL, 0, 0);
+                width = ply_label_get_width (keyboard->label);
+                height = ply_label_get_height (keyboard->label);
+                if ((width <= rectangle->width * .9 && height <= rectangle->height * .9) || size <= 4)
+                        break;
+                size = fmax (4, size * .8);
+        }
+        ply_label_show (keyboard->label, NULL, rectangle->x + ((long) rectangle->width - width) / 2,
+                        rectangle->y + ((long) rectangle->height - height) / 2);
+        ply_label_draw_area (keyboard->label, buffer, rectangle->x, rectangle->y, rectangle->width, rectangle->height);
+}
+
+void
+ply_on_screen_keyboard_draw (ply_on_screen_keyboard_t *keyboard,
+                             ply_pixel_display_t      *display,
+                             ply_pixel_buffer_t       *buffer)
+{
+        ply_rectangle_t area, background, rectangle;
+        size_t i;
+
+        if (!ply_on_screen_keyboard_is_visible (keyboard, display))
+                return;
+        area = keyboard_area (keyboard, display);
+        background = (ply_rectangle_t) { .x = 0, .y = area.y - keyboard->gap,
+                                         .width = ply_pixel_display_get_width (display),
+                                         .height = ply_on_screen_keyboard_get_height (keyboard, display) };
+        ply_pixel_buffer_fill_with_hex_color (buffer, &background, keyboard->background_color);
+        for (i = 0; i < ply_keyboard_geometry_get_key_count (keyboard->geometry); i++) {
+                const ply_keyboard_key_t *key = ply_keyboard_geometry_get_key (keyboard->geometry, i);
+                bool selected = keyboard->latched[i] ||
+                                (keyboard->pressed_display == display && keyboard->pressed_key == (int) i);
+                uint32_t color;
+                char *label;
+
+                if (!ply_keyboard_geometry_get_rectangle (keyboard->geometry, i, &area, keyboard->gap, &rectangle))
+                        continue;
+                if (strcmp (key->name, "CAPS") == 0)
+                        selected |= xkb_state_led_name_is_active (ply_keyboard_layout_get_state (keyboard->layout), XKB_LED_NAME_CAPS) > 0;
+                color = selected ? keyboard->selected_color :
+                        key->behavior == PLY_KEYBOARD_KEY ? keyboard->key_color : keyboard->action_color;
+                ply_pixel_buffer_fill_with_hex_color (buffer, &rectangle, color);
+                label = key_label (keyboard, key, i);
+                if (label != NULL) {
+                        draw_label (keyboard, buffer, &rectangle, label);
+                        free (label);
+                }
+        }
+}
