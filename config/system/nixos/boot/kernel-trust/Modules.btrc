import Library.Bytes;
import Library.FileSystem;
import Library.IO;
import Library.Process;
import Library.Strings;
import Library.Vector;

class ModuleTrust {
    class Vector<Bytes> certificates(Bytes data) {
        Vector<Bytes> result = [];
        var offset = 0;
        while (offset < data.len) {
            if (data.len - offset < 2 || data.get(offset) != 0x30) { throw "invalid aggregate certificate encoding"; }
            long long length = data.get(offset + 1);
            var header = 2;
            if ((length & 0x80LL) != 0LL) {
                var count = (int)(length & 0x7fLL);
                if (count < 1 || count > 4 || data.len - offset < 2 + count) { throw "invalid aggregate certificate length"; }
                length = 0LL;
                for (int index = 0; index < count; index++) { length = length * 256LL + (long long)data.get(offset + 2 + index); }
                header = header + count;
            }
            if (length > (long long)(data.len - offset - header)) { throw "truncated aggregate certificate"; }
            var end = offset + header + (int)length;
            var certificate = data.slice(offset, end);
            if (!ModuleTrust.trusted(result, certificate)) { result.push(certificate); }
            offset = end;
        }
        return result;
    }

    class bool trusted(Vector<Bytes> certificates, Bytes certificate) {
        for item in certificates { if (item.equals(certificate)) { return true; } }
        return false;
    }

    class bool contains(Bytes image, Bytes bundle) {
        if (bundle.isEmpty()) { return false; }
        for (int offset = 0; offset <= image.len - bundle.len; offset++) {
            if (image.get(offset) == bundle.get(0) && memcmp(image.data + offset, bundle.data, (size_t)bundle.len) == 0) { return true; }
        }
        return false;
    }

    class int signatureSize(Bytes module) {
        var marker = Bytes.fromString("~Module signature appended~\n");
        var end = module.len - marker.len - 12;
        if (end < 0 || !module.slice(module.len - marker.len, module.len).equals(marker)) { throw "unsigned module"; }
        long long length = 0LL;
        for (int index = end + 8; index < end + 12; index++) { length = length * 256LL + (long long)module.get(index); }
        if (length <= 0LL || length > (long long)end) { throw "invalid signature length"; }
        return (int)length;
    }

    class void write(string path, Bytes data) {
        var file = File(path, "wb");
        if (!file.writeBytes(data) || !file.close()) { throw f"cannot write verification scratch file: {path}"; }
    }

    class Vector<string> modules(string root) {
        Vector<string> result = [];
        for name in Directory(root).entries() {
            var path = PathTools.join(root, name);
            var status = FileStatus(path);
            if (status.isDir() && !status.isSymlink()) {
                for nested in ModuleTrust.modules(path) { result.push(nested); }
            } else if (status.isFile() && (name.endsWith(".ko") || name.endsWith(".ko.xz") || name.endsWith(".ko.gz") || name.endsWith(".ko.zst"))) {
                result.push(path);
            }
        }
        return result;
    }

    class void checkModule(string path, Vector<Bytes> trusted, string scratch) {
        var rawPath = path;
        var certificate = f"{path}.cer";
        var decompressor = "";
        if (path.endsWith(".xz")) { decompressor = "xz"; }
        if (path.endsWith(".gz")) { decompressor = "gzip"; }
        if (path.endsWith(".zst")) { decompressor = "zstd"; }
        if (!decompressor.isEmpty()) {
            var suffixLength = path.endsWith(".zst") ? 4 : 3;
            certificate = f"{path.substring(0, path.length() - suffixLength)}.cer";
            rawPath = PathTools.join(scratch, "decompressed");
            UnixShell().run(f"{decompressor} -dc -- {ShellWords.quote(path)} > {ShellWords.quote(rawPath)}", throwOnFailure=true);
        }
        if (!FileSystem.isFile(certificate)) { throw f"missing certificate for {path}; use the kernel modules_install signing step"; }
        if (!ModuleTrust.trusted(trusted, FileSystem.readBytes(certificate))) { throw f"certificate for {path} is absent from the kernel trust set"; }
        var raw = FileSystem.readBytes(rawPath);
        var size = ModuleTrust.signatureSize(raw);
        var end = raw.len - "~Module signature appended~\n".length() - 12;
        var content = PathTools.join(scratch, "module");
        var signature = PathTools.join(scratch, "signature");
        var pem = PathTools.join(scratch, "certificate.pem");
        ModuleTrust.write(content, raw.slice(0, end - size));
        ModuleTrust.write(signature, raw.slice(end - size, end));
        UnixShell().run(f"openssl x509 -inform DER -in {ShellWords.quote(certificate)} -out {ShellWords.quote(pem)}", throwOnFailure=true);
        var verified = ChildProcess.run("openssl", ["cms", "-verify", "-binary", "-inform", "DER", "-in", signature, "-content", content, "-certfile", pem, "-nointern", "-noverify", "-out", "/dev/null"]);
        if (!verified.ok()) { throw f"signature does not match the certificate and contents of {path}"; }
    }

    class void check(string image, string aggregate, string version, Vector<string> packages) {
        var bundle = FileSystem.readBytes(aggregate);
        var trusted = ModuleTrust.certificates(bundle);
        if (!ModuleTrust.contains(FileSystem.readBytes(image), bundle)) { throw "the kernel image does not contain the selected module certificates"; }
        var created = FileSystem.createTemporaryDirectory("module-public-verification-");
        if (!created.ok()) { throw "cannot create module verification directory"; }
        var scratch = created.value();
        var checked = 0;
        try {
            for package in packages {
                var root = f"{package}/lib/modules/{version}";
                var modules = ModuleTrust.modules(root);
                if (modules.len == 0) { throw f"no modules found in {root}"; }
                for module in modules { ModuleTrust.checkModule(module, trusted, scratch.path()); checked++; }
            }
        } finally { scratch.close(); }
        print(f"Kernel trust verified: {trusted.len} embedded certificates, {checked} external modules.");
    }
}
