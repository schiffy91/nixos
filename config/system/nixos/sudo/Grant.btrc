import Library.FileSystem;
import Library.IO;
import Library.Process;
import Library.Strings;

#include <sys/stat.h>
#include <time.h>
#include <unistd.h>

class SudoGrant {
    public string admin;
    public string visudo;
    public string directory = "/run/nixosctl-sudo";

    public SudoGrant(string admin, string visudo) { self.admin = admin; self.visudo = visudo; }

    class int duration(string value) {
        if (value.length() < 2 || value.length() > 6 || value[0] < '1' || value[0] > '9') { throw "Duration must be an integer followed by s, m, or h, from 1s to 24h"; }
        var seconds = 0;
        for (int index = 0; index < value.length() - 1; index++) {
            if (value[index] < '0' || value[index] > '9') { throw "Invalid sudo grant duration"; }
            seconds = seconds * 10 + (int)(value[index] - '0');
        }
        var unit = value[value.length() - 1];
        if (unit == 'm') { seconds = seconds * 60; }
        else if (unit == 'h') { seconds = seconds * 3600; }
        else if (unit != 's') { throw "Invalid sudo grant duration unit"; }
        if (seconds > 86400) { throw "Sudo grants cannot exceed 24h"; }
        return seconds;
    }

    class void requirePath(string path, bool directory, int mode) {
        struct stat info;
        if (lstat(path, &info) != 0 || info.st_uid != (uid_t)0 || info.st_gid != (gid_t)0
            || (int)(info.st_mode & (mode_t)07777) != mode) { throw f"Refusing unsafe sudo grant path: {path}"; }
        if ((directory && !S_ISDIR(info.st_mode)) || (!directory && !S_ISREG(info.st_mode))) { throw f"Refusing unsafe sudo grant type: {path}"; }
    }

    class string date(long long expires, string format) {
        var result = ChildProcess.run("date", ["-u", "-d", f"@{expires}", format]);
        if (!result.ok()) { throw "Cannot format sudo grant expiration"; }
        return result.trimmed();
    }

    class long long expiry(string text) {
        var parts = Strings.split(text.trim(), " ");
        if (parts.len != 2 || !parts.get(0).equals("#expires")) { throw "Invalid sudo grant expiration"; }
        var value = parts.get(1);
        if (value.isEmpty() || value.length() > 18) { throw "Invalid sudo grant expiration"; }
        long long expires = 0LL;
        for (int index = 0; index < value.length(); index++) {
            if (value[index] < '0' || value[index] > '9') { throw "Invalid sudo grant expiration"; }
            expires = expires * 10LL + (long long)(value[index] - '0');
        }
        return expires;
    }

    public void status(string grant) {
        if (FileStatus(grant).isMissing()) { print(f"No temporary sudo grant for {self.admin}."); return; }
        SudoGrant.requirePath(grant, false, 0440);
        var first = File(grant).readLine();
        var expires = SudoGrant.expiry(first);
        if ((long long)time(NULL) >= expires) { print(f"Temporary sudo grant for {self.admin} has expired."); }
        else { print(f"Temporary sudo grant for {self.admin} expires {SudoGrant.date(expires, "+%Y-%m-%d %H:%M:%S UTC")}."); }
    }

    public void run(string action, int duration) {
        var directory = self.directory;
        var grant = PathTools.join(directory, "grant");
        if (FileStatus(directory).isMissing()) {
            if (action.equals("status")) { print(f"No temporary sudo grant for {self.admin}."); return; }
            if (FileSystem.mkdir(directory, 0755) != 0) { throw "Cannot create sudo grant directory"; }
        }
        SudoGrant.requirePath(directory, true, 0755);
        if (action.equals("status")) { self.status(grant); return; }
        umask(0077);
        var locked = AdvisoryFileLock.acquire(PathTools.join(directory, ".lock"), wait=true);
        if (!locked.ok()) { throw "Cannot lock sudo grant storage"; }
        var lease = locked.value();
        try {
            if (action.equals("disable")) {
                if (unlink(grant) != 0 && errno != ENOENT) { throw "Cannot remove temporary sudo grant"; }
                print(f"Temporary sudo grant for {self.admin} disabled. Existing root processes continue.");
                return;
            }
            var expires = (long long)time(NULL) + (long long)duration;
            var timestamp = SudoGrant.date(expires, "+%Y%m%d%H%M%SZ");
            var temporary = ChildProcess.run("mktemp", [f"{directory}/.grant.XXXXXXXX"]);
            if (!temporary.ok()) { throw "Cannot stage sudo grant"; }
            var path = temporary.trimmed();
            try {
                if (!Path.writeAll(path, f"#expires {expires}\n{self.admin} ALL=(ALL:ALL) NOTAFTER={timestamp} NOPASSWD: ALL\n")) { throw "Cannot write sudo grant"; }
                if (!ChildProcess.run(self.visudo, ["-cf", path]).ok()) { throw "Sudo rejected temporary grant"; }
                if (chmod(path, 0440) != 0 || rename(path, grant) != 0) { throw "Cannot publish sudo grant"; }
            } finally { unlink(path); }
            print(f"Temporary sudo grant for {self.admin} expires {SudoGrant.date(expires, "+%Y-%m-%d %H:%M:%S UTC")}.");
            print("This applies to every process using this account; it is not an agent sandbox.");
            print("Expiration does not stop existing root processes or undo their changes.");
        } finally { lease.close(); }
    }
}
