import Library.Timer;
import ./LuksVolume.btrc;

void quietCryptsetup(int level, const char* message, void* data) {}

class ProcessLimits {
    class bool singleThreaded() {
        var tasks = Directory("/proc/self/task");
        var names = tasks.entries();
        return !tasks.failed() && names.len == 1;
    }

    class bool protectSecrets() {
        struct rlimit limit;
        limit.rlim_cur = 0;
        limit.rlim_max = 0;
        return ProcessLimits.singleThreaded() && setrlimit(RLIMIT_CORE, &limit) == 0 && prctl(PR_SET_DUMPABLE, 0) == 0;
    }

    class bool child(pid_t parent) {
        struct rlimit memory;
        memory.rlim_cur = 1536UL * 1024 * 1024;
        memory.rlim_max = memory.rlim_cur;
        return prctl(PR_SET_PDEATHSIG, SIGKILL) == 0 && (pid_t)getppid() == parent && setrlimit(RLIMIT_AS, &memory) == 0;
    }
}

class UnlockAttempt {
    private int process = 0;
    private long long deadline = 0;

    public void start(BlockVolume volume, VolumeInventory inventory, BootPassphrase passphrase) {
        var parent = getpid();
        self.process = (int)fork();
        if (self.process == 0) {
            // No runtime threads are started before fork. Managed metadata can
            // be used normally; the inherited secret mapping must be relocked.
            try {
                if (ProcessLimits.child(parent) && passphrase.secret.lockAfterFork()) {
                    LuksVolume.unlock(volume, inventory, passphrase);
                }
            } catch (string error) {}
            passphrase.close();
            _exit(0);
        }
        if (self.process < 0) { self.process = 0; }
        self.deadline = MonotonicClock.deadlineAfter(8000);
    }

    public bool running() {
        if (self.process == 0) { return false; }
        int status;
        var exited = (int)waitpid((pid_t)self.process, &status, WNOHANG);
        if (exited == self.process || (exited < 0 && errno != EINTR)) { self.process = 0; }
        else if (self.deadline != 0 && !MonotonicClock.before(self.deadline)) { self.stop(); }
        return self.process != 0;
    }

    public void stop() {
        if (self.process > 0) { kill((pid_t)self.process, SIGKILL); }
        self.deadline = 0;
        // Keep the slot until waitpid reaps it. Stuck kernel I/O must not turn
        // one timed-out disk into an unbounded number of concurrent attempts.
    }
}

class UnlockSession {
    private BootPassphrase passphrase;
    private long long deadline;

    public UnlockSession(BootPassphrase passphrase) {
        self.passphrase = passphrase;
        self.deadline = MonotonicClock.deadlineAfter(20000);
    }

    public void run(string rootMapping) {
        var inventory = VolumeInventory(rootMapping);
        Vector<UnlockAttempt> attempts = [UnlockAttempt(), UnlockAttempt()];
        var next = 0;
        try {
            while (MonotonicClock.before(self.deadline)) {
                var running = false;
                for attempt in attempts {
                    if (!attempt.running() && next < inventory.volumes.len) {
                        attempt.start(inventory.volumes.get(next), inventory, self.passphrase);
                        next++;
                    }
                    running = attempt.running() || running;
                }
                if (next == inventory.volumes.len) { self.passphrase.secret.erase(); }
                if (!running && next == inventory.volumes.len) { break; }
                Timer.sleep(0.01);
            }
        } finally {
            self.passphrase.close();
            for attempt in attempts { attempt.stop(); }
        }
    }
}
