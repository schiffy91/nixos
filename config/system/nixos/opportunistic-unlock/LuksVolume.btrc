import ./Devices.btrc;
import ./Secrets.btrc;

class LuksVolume {
    private UnlockCryptHandle? handle = null;

    public LuksVolume(string path) {
        var opened = unlockCryptOpen(path);
        if (opened == null) { throw "Not a readable LUKS volume"; }
        self.handle = opened;
    }

    // Libcryptsetup validates formats, algorithms and keyslots. These exclusions
    // keep this operation to software decryption without hardware credentials or
    // reencryption/integrity metadata work.
    public bool softwareOnly() {
        return self.handle != null && unlockCryptSoftwareOnly(self.handle);
    }

    public void activate(BlockVolume volume, VolumeInventory inventory, int descriptor, BootPassphrase passphrase) {
        var mapping = volume.mapping();
        if (self.handle == null || !unlockCryptInactive(self.handle, mapping)) { return; }
        var key = self.verifiedKey(passphrase);
        try { self.activateWithKey(volume, inventory, descriptor, key); }
        finally { key.close(); }
    }

    public LockedSecret verifiedKey(BootPassphrase passphrase) {
        if (self.handle == null || !self.softwareOnly()) { throw "Not a software-only LUKS volume"; }
        var key = LockedSecret(unlockCryptKeySize(self.handle));
        var keyHandle = key.rawHandle();
        var passphraseHandle = passphrase.secret.rawHandle();
        var verified = keyHandle != null && passphraseHandle != null &&
            unlockCryptVerifyKey(self.handle, keyHandle, passphraseHandle, passphrase.length);
        passphrase.secret.erase();
        if (!verified) { key.close(); throw "Passphrase does not unlock this volume"; }
        return key;
    }

    private void activateWithKey(BlockVolume volume, VolumeInventory inventory, int descriptor, LockedSecret key) {
        if (self.handle == null || !volume.sameAttachment(descriptor) || !inventory.available(volume)) { return; }
        var keyHandle = key.rawHandle();
        if (keyHandle == null) { return; }
        var mapping = volume.mapping();
        if (unlockCryptActivate(self.handle, descriptor, mapping, keyHandle) > 0 &&
            (!volume.sameAttachment(descriptor) || !LuksVolume.matches(mapping, volume))) {
            unlockCryptDeactivate(self.handle, mapping);
        }
    }

    class bool matches(string mapping, BlockVolume volume) {
        return BlockVolume.formatNumber(unlockCryptMappingDeviceAt(mapping)).equals(volume.number);
    }

    class void unlock(BlockVolume volume, VolumeInventory inventory, BootPassphrase passphrase) {
        var descriptor = unlockOpenVolumeDescriptor(volume.path());
        if (descriptor < 0) { return; }
        try {
            if (volume.sameAttachment(descriptor) && inventory.available(volume)) {
                var luks = LuksVolume(f"/proc/self/fd/{descriptor}");
                try { luks.activate(volume, inventory, descriptor, passphrase); }
                finally { luks.close(); }
            }
        } finally { unlockCloseDescriptor(descriptor); }
    }

    public void close() { self.handle = null; }
    public void __del__() { self.close(); }
}
