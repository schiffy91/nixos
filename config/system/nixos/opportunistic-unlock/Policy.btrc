import ./Native.btrc;
// Header metadata is borrowed from libcryptsetup; neither policy nor its tests
// receive the passphrase or volume key.
class UnlockPolicy {
    class bool typeAllowed(const char* type) {
        return type != NULL && (strcmp(type, CRYPT_LUKS1) == 0 || strcmp(type, CRYPT_LUKS2) == 0);
    }

    class bool activeSlot(int status) { return status == (int)CRYPT_SLOT_ACTIVE || status == (int)CRYPT_SLOT_ACTIVE_LAST; }

    class bool cipherAllowed(const char* cipher, size_t bytes) {
        return cipher != NULL &&
            ((strcmp(cipher, "aes-xts-plain64") == 0 && (bytes == 32 || bytes == 64)) ||
             (strcmp(cipher, "aes-cbc-essiv:sha256") == 0 && bytes == 32));
    }

    class bool kdfAllowed(crypt_pbkdf_type* kdf) {
        if (kdf->type == NULL || kdf->iterations == 0) { return false; }
        if (strcmp(kdf->type, CRYPT_KDF_PBKDF2) == 0) {
            return kdf->hash != NULL && (strcmp(kdf->hash, "sha256") == 0 || strcmp(kdf->hash, "sha512") == 0) &&
                kdf->iterations <= 100000000;
        }
        return (strcmp(kdf->type, CRYPT_KDF_ARGON2I) == 0 || strcmp(kdf->type, CRYPT_KDF_ARGON2ID) == 0) &&
            kdf->max_memory_kb > 0 && kdf->max_memory_kb <= 1024 * 1024 && kdf->iterations <= 32 &&
            kdf->parallel_threads > 0 && kdf->parallel_threads <= 8;
    }

    class bool softwareOnly(int hardware, int reencryption, int flagsResult, uint32_t requirements, const char* integrity) {
        return hardware == (int)CRYPT_SW_ONLY && reencryption == (int)CRYPT_REENCRYPT_NONE &&
            flagsResult >= 0 && requirements == 0 && (integrity == NULL || integrity[0] == 0);
    }

    class bool volumeCipherAllowed(const char* cipher, const char* mode, int bytes) {
        return cipher != NULL && mode != NULL && strcmp(cipher, "aes") == 0 &&
            ((strcmp(mode, "xts-plain64") == 0 && (bytes == 32 || bytes == 64)) ||
             (strcmp(mode, "cbc-essiv:sha256") == 0 && bytes == 32));
    }

    class bool headerAllowed(crypt_device* device) {
        const char* type = crypt_get_type(device);
        if (!UnlockPolicy.typeAllowed(type)) { return false; }
        if (strcmp(type, CRYPT_LUKS2) == 0) {
            uint32_t requirements = 0;
            crypt_params_integrity integrity;
            memset(&integrity, 0, sizeof(integrity));
            var integrityResult = crypt_get_integrity_info(device, &integrity);
            var flagsResult = crypt_persistent_flags_get(device, CRYPT_FLAGS_REQUIREMENTS, &requirements);
            if (!UnlockPolicy.softwareOnly(crypt_get_hw_encryption_type(device), (int)crypt_reencrypt_status(device, NULL),
                flagsResult, requirements, integrityResult == 0 ? integrity.integrity : NULL)) { return false; }
        }
        if (!UnlockPolicy.volumeCipherAllowed(crypt_get_cipher(device), crypt_get_cipher_mode(device), crypt_get_volume_key_size(device))) { return false; }
        var active = 0;
        for (int slot = 0; slot < crypt_keyslot_max(type); slot++) {
            var status = crypt_keyslot_status(device, slot);
            if (status == CRYPT_SLOT_INACTIVE || status == CRYPT_SLOT_UNBOUND) { continue; }
            if (!UnlockPolicy.activeSlot((int)status)) { return false; }
            size_t bytes = 0;
            const char* cipher = crypt_keyslot_get_encryption(device, slot, &bytes);
            crypt_pbkdf_type kdf;
            if (!UnlockPolicy.cipherAllowed(cipher, bytes) || crypt_keyslot_get_pbkdf(device, slot, &kdf) < 0 ||
                !UnlockPolicy.kdfAllowed(&kdf)) { return false; }
            active++;
        }
        return active > 0;
    }
}
