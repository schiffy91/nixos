import Library.Strings;

// Only the opaque handle and size are managed. Secret bytes live in a private,
// locked native mapping, never in a string, Bytes, or container.
class LockedSecret {
    private UnlockSecretHandle? handle = null;
    public int capacity;

    public LockedSecret(int capacity) {
        if (capacity <= 0 || capacity > 4096) { throw "Invalid secret buffer size"; }
        self.capacity = capacity;
        var created = unlockSecretCreate(capacity);
        if (created == null) { throw "Cannot allocate or protect secret memory"; }
        self.handle = created;
    }

    public UnlockSecretHandle? rawHandle() { return self.handle; }
    public bool opened() { return self.handle != null && unlockSecretOpened(self.handle); }
    public bool lockAfterFork() { return self.handle != null && unlockSecretLockAfterFork(self.handle); }
    public void erase() { if (self.handle != null) { unlockSecretErase(self.handle); } }
    public void fill(int value) { if (self.handle != null) { unlockSecretFill(self.handle, value); } }
    public bool allEqual(int value) { return self.handle != null && unlockSecretAllEqual(self.handle, value); }
    public int loadText(string text) { return self.handle == null ? -1 : unlockSecretLoadText(self.handle, text); }

    public void close() {
        var current = self.handle;
        if (current == null) { return; }
        unlockSecretCloseMemory(current);
        self.handle = null;
    }
    public void __del__() { self.close(); }
}

class BootPassphrase {
    public LockedSecret secret;
    public int length = 0;

    public BootPassphrase() { self.secret = LockedSecret(4096); }

    class string keyName() { return "nixos:opportunistic-unlock"; }

    class bool trustedDescription(string description) {
        var fields = Strings.split(description, ";");
        if (fields.length != 5 || !fields.get(0).equals("user") || !fields.get(1).equals("0") ||
            !fields.get(4).equals(BootPassphrase.keyName())) { return false; }
        var permissions = fields.get(3);
        while (permissions.startsWith("0")) { permissions = permissions.substring(1, permissions.length - 1); }
        return permissions.equals("3f0000");
    }

    class bool trustedKey(long key) {
        var description = unlockKeyDescriptionRead(key);
        if (description == null) { return false; }
        var text = unlockKeyDescriptionText(description);
        return text != null && BootPassphrase.trustedDescription(text);
    }

    class BootPassphrase? consume() {
        var key = unlockKeyringSearchPassphrase();
        if (key < 0) { return null; }
        BootPassphrase? passphrase = null;
        try {
            if (!BootPassphrase.trustedKey(key)) { throw "Untrusted boot passphrase handoff"; }
            passphrase = BootPassphrase();
            var secretHandle = passphrase.secret.rawHandle();
            if (secretHandle == null) { throw "Invalid boot passphrase"; }
            var length = unlockKeyringReadPassphrase(key, secretHandle);
            if (length <= 0 || length > passphrase.secret.capacity) { throw "Invalid boot passphrase"; }
            passphrase.length = length;
        } catch (string error) {
            if (passphrase != null) { passphrase.close(); }
            passphrase = null;
        }
        if (!unlockKeyringRevoke(key) && passphrase != null) {
            passphrase.close();
            passphrase = null;
        }
        return passphrase;
    }

    public void loadFixture(string fixture) {
        var loaded = self.secret.loadText(fixture);
        if (loaded <= 0) { throw "Invalid fixture passphrase"; }
        self.length = loaded;
    }

    public void close() { if (self.secret != null) { self.secret.close(); } self.length = 0; }
    public void __del__() { self.close(); }
}
