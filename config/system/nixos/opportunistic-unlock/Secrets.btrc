import Library.Strings;
import ./Native.btrc;

// Only the address and size are managed. Secret bytes live in this private,
// locked mapping, never in a string, Bytes or a container.
class LockedSecret {
    private char* memory = NULL;
    public int capacity;

    public LockedSecret(int capacity) {
        if (capacity <= 0 || capacity > 4096) { throw "Invalid secret buffer size"; }
        self.capacity = capacity;
        self.memory = (char*)mmap(NULL, capacity, (int)PROT_READ | (int)PROT_WRITE,
            (int)MAP_PRIVATE | (int)MAP_ANONYMOUS, -1, 0);
        if (self.memory == (char*)((intptr_t)(-1))) { self.memory = NULL; throw "Cannot allocate secret memory"; }
        if (mlock(self.memory, capacity) != 0 || madvise(self.memory, capacity, MADV_DONTDUMP) != 0) {
            self.close();
            throw "Cannot protect secret memory";
        }
    }

    public char* borrow() { return self.memory; }
    public bool lockAfterFork() { return self.memory != NULL && mlock(self.memory, self.capacity) == 0; }
    public void erase() { if (self.memory != NULL) { explicit_bzero(self.memory, self.capacity); } }
    public void close() {
        if (self.memory == NULL) { return; }
        self.erase();
        munmap(self.memory, self.capacity);
        self.memory = NULL;
    }
    public void __del__() { self.close(); }
}

class BootPassphrase {
    public LockedSecret secret;
    public int length = 0;

    public BootPassphrase() { self.secret = LockedSecret(4096); }

    class bool trustedDescription(string description) {
        var fields = Strings.split(description, ";");
        if (fields.len != 5 || !fields.get(0).equals("user") || !fields.get(1).equals("0") ||
            !fields.get(4).equals((string)UNLOCK_PASSPHRASE_KEY)) { return false; }
        var permissions = fields.get(3);
        while (permissions.startsWith("0")) { permissions = permissions.substring(1, permissions.length() - 1); }
        return permissions.equals("3f0000");
    }

    class bool trustedKey(long key) {
        char description[256];
        var size = (long)syscall(SYS_keyctl, KEYCTL_DESCRIBE, key, description, sizeof(description));
        return size > 0 && size <= (long)sizeof(description) && BootPassphrase.trustedDescription(Strings.copy(description));
    }

    class BootPassphrase? consume() {
        var key = (long)syscall(SYS_keyctl, KEYCTL_SEARCH, KEY_SPEC_USER_KEYRING, "user", UNLOCK_PASSPHRASE_KEY, 0);
        if (key < 0) { return null; }
        BootPassphrase? passphrase = null;
        try {
            if (!BootPassphrase.trustedKey(key)) { throw "Untrusted boot passphrase handoff"; }
            passphrase = BootPassphrase();
            var length = (long)syscall(SYS_keyctl, KEYCTL_READ, key, passphrase.secret.borrow(), passphrase.secret.capacity);
            if (length <= 0 || length > passphrase.secret.capacity) { throw "Invalid boot passphrase"; }
            passphrase.length = (int)length;
        } catch (string error) {
            if (passphrase != null) { passphrase.close(); }
            passphrase = null;
        }
        if ((long)syscall(SYS_keyctl, KEYCTL_REVOKE, key) < 0 && passphrase != null) {
            passphrase.close();
            passphrase = null;
        }
        return passphrase;
    }

    public void close() { if (self.secret != null) { self.secret.close(); } self.length = 0; }
    public void __del__() { self.close(); }
}
