import ./Native.btrc;

const int passwordLimit = 4096;
const int secretBytes = 4160;

// Raw pointer storage deliberately never enters a BTRC string, Bytes, class or
// container. The generated code is checked by the small regression suite.
class SecretMemory {
    class char* allocate() {
        char* secret = (char*)mmap(NULL, secretBytes, (int)PROT_READ | (int)PROT_WRITE,
            (int)MAP_PRIVATE | (int)MAP_ANONYMOUS, -1, 0);
        if (secret == (char*)((intptr_t)(-1))) { return NULL; }
        if ((int)mlock(secret, secretBytes) < 0) { munmap(secret, secretBytes); return NULL; }
        madvise(secret, secretBytes, MADV_DONTDUMP);
        return secret;
    }

    class void wipe(char* secret) { explicit_bzero(secret, secretBytes); }
    class void forgetPassword(char* secret) { explicit_bzero(secret, passwordLimit); }

    class long findKey() {
        long key = (long)syscall(SYS_keyctl, KEYCTL_SEARCH, KEY_SPEC_USER_KEYRING, "user", UNLOCK_PASSPHRASE_KEY, 0);
        if (key < 0) { return -1; }
        char description[256];
        long length = (long)syscall(SYS_keyctl, KEYCTL_DESCRIBE, key, description, sizeof(description));
        unsigned uid;
        unsigned gid;
        unsigned permissions;
        if (length <= 0 || length > (long)sizeof(description) ||
            sscanf(description, "user;%u;%u;%x;", &uid, &gid, &permissions) != 3 ||
            uid != 0 || permissions != UNLOCK_PASSPHRASE_PERMISSIONS) {
            SecretMemory.revoke(key);
            return -1;
        }
        return key;
    }

    class void revoke(long key) { syscall(SYS_keyctl, KEYCTL_REVOKE, key); }

    class long consume(long key, char* secret) {
        long length = (long)syscall(SYS_keyctl, KEYCTL_READ, key, secret, passwordLimit);
        long revoked = (long)syscall(SYS_keyctl, KEYCTL_REVOKE, key);
        if (revoked < 0 || length <= 0 || length > passwordLimit) { SecretMemory.wipe(secret); return 0; }
        return length;
    }

    class void dispose(char* secret) { SecretMemory.wipe(secret); munmap(secret, secretBytes); }
}
