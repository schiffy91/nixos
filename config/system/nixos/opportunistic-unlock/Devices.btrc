import Library.FileSystem;
import Library.Strings;
import Library.Vector;
import ./Native.btrc;

class BlockVolume {
    public string name;
    public string number;
    public string disk;
    public long sequence;
    public long start;
    public long size;

    class string deviceNumber(dev_t device) { return f"{(unsigned)major(device)}:{(unsigned)minor(device)}"; }

    class string numberAt(string path) {
        struct stat status;
        if (stat(path, &status) != 0 || !S_ISBLK(status.st_mode)) { return ""; }
        return BlockVolume.deviceNumber(status.st_rdev);
    }

    class long readNumber(string path) {
        var text = Path.readAll(path).trim();
        var value = text.toLong();
        if (!text.isDigit() || value < 0 || !f"{value}".equals(text)) { throw "Invalid block metadata"; }
        return value;
    }

    class BlockVolume? inspect(string name) {
        try {
            var path = FileSystem.realPath(f"/sys/class/block/{name}");
            if (path.isEmpty() || path.contains("/virtual/block/") || path.contains("/session") ||
                path.contains("/rport-") || path.contains("/nvme-fabrics/")) { return null; }
            var partition = FileSystem.exists(path + "/partition");
            var disk = partition ? PathTools.dirname(path) : path;
            if (PathTools.basename(disk).startsWith("nvme") && !Path.readAll(disk + "/device/transport").trim().equals("pcie")) { return null; }
            var volume = BlockVolume();
            volume.name = name;
            volume.number = Path.readAll(path + "/dev").trim();
            volume.disk = Path.readAll(disk + "/dev").trim();
            volume.sequence = BlockVolume.readNumber(disk + "/diskseq");
            volume.start = partition ? BlockVolume.readNumber(path + "/start") : 0;
            volume.size = BlockVolume.readNumber(path + "/size");
            if (volume.number.isEmpty() || volume.disk.isEmpty() || volume.sequence == 0 || volume.size == 0 || volume.start > (long)LONG_MAX - volume.size ||
                FileStatus(volume.path()).isSymlink() || !BlockVolume.numberAt(volume.path()).equals(volume.number)) { return null; }
            return volume;
        } catch (string error) { return null; }
    }

    public string path() { return f"/dev/{self.name}"; }
    public string mapping() { return f"opportunistic-{self.number.replace(":", "-")}-{self.sequence}"; }

    public bool overlaps(BlockVolume other) {
        return self.disk.equals(other.disk) && self.sequence == other.sequence &&
            self.start < other.start + other.size && other.start < self.start + self.size;
    }

    public bool sameAttachment(int descriptor) {
        struct stat status;
        uint64_t sequence = 0;
        if (fstat(descriptor, &status) != 0 || !S_ISBLK(status.st_mode) ||
            !BlockVolume.deviceNumber(status.st_rdev).equals(self.number) ||
            ioctl(descriptor, unlockDiskSequence, &sequence) != 0 || sequence != (uint64_t)self.sequence) { return false; }
        var current = BlockVolume.inspect(self.name);
        return current != null && current.number.equals(self.number) && current.disk.equals(self.disk) &&
            current.sequence == self.sequence && current.start == self.start && current.size == self.size;
    }

    public bool inUse(Vector<string> mounted) {
        var holders = Directory(f"/sys/class/block/{self.name}/holders");
        var names = holders.entries();
        if (holders.failed()) { throw "Cannot inspect block holders"; }
        if (!names.isEmpty()) { return true; }
        for number in mounted { if (number.equals(self.number)) { return true; } }
        return false;
    }
}

class VolumeInventory {
    public Vector<BlockVolume> volumes = [];
    private Vector<BlockVolume> root = [];

    public VolumeInventory(string rootMapping) {
        if (rootMapping.isEmpty() || rootMapping.contains("/")) { throw "Invalid root mapping"; }
        var number = BlockVolume.numberAt(f"/dev/mapper/{rootMapping}");
        var path = f"/sys/dev/block/{number}";
        if (!Path.readAll(path + "/dm/uuid").startsWith("CRYPT-LUKS")) { throw "Root is not a LUKS mapping"; }
        self.findRoot(path, 0);
        self.volumes = VolumeInventory.present();
    }

    class Vector<string> names(string path) {
        var directory = Directory(path);
        var names = directory.entries();
        if (directory.failed()) { throw "Cannot inspect block devices"; }
        names.sort();
        return names;
    }

    class Vector<BlockVolume> present() {
        Vector<BlockVolume> volumes = [];
        for name in VolumeInventory.names("/sys/class/block") {
            var volume = BlockVolume.inspect(name);
            if (volume != null) { volumes.push(volume); }
        }
        return volumes;
    }

    private void findRoot(string path, int depth) {
        if (depth > 8) { throw "Cannot resolve root storage"; }
        var volume = BlockVolume.inspect(PathTools.basename(FileSystem.realPath(path)));
        if (volume != null) { self.root.push(volume); return; }
        var slaves = VolumeInventory.names(path + "/slaves");
        if (slaves.isEmpty()) { throw "Cannot resolve root storage"; }
        for name in slaves { self.findRoot(f"/sys/class/block/{name}", depth + 1); }
    }

    public bool available(BlockVolume volume) {
        try {
            for root in self.root { if (volume.overlaps(root)) { return false; } }
            var mounts = Path.readAll("/proc/self/mountinfo");
            if (mounts.isEmpty()) { return false; }
            Vector<string> mounted = [];
            for line in Strings.split(mounts, "\n") {
                var fields = Strings.split(line, " ");
                if (fields.len >= 3) { mounted.push(fields.get(2)); }
            }
            for other in VolumeInventory.present() {
                if (volume.overlaps(other) && other.inUse(mounted)) { return false; }
            }
            return true;
        } catch (string error) { return false; }
    }
}
