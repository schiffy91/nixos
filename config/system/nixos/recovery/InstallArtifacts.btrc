import Library.CLI;
import Library.Console;
import Library.FileSystem;
import Library.FileSystem.FileSystemHandles;
import Library.JSON;
import ./Artifacts.btrc;

#include <sys/stat.h>

class RecoveryArtifactInstaller {
    private RecoveryArtifacts artifacts;
    private bool strict;

    public RecoveryArtifactInstaller(CLIArgs args) {
        if (args.count() != 2 || (!args.get(1).equals("--strict") && !args.get(1).equals("--optional"))) {
            throw "Usage: nixos-recovery-artifacts PLAN --strict|--optional";
        }
        self.artifacts = RecoveryArtifacts(JSONValue.readFile(args.get(0)));
        self.strict = args.get(1).equals("--strict");
    }

    public void run() {
        umask(0077);
        RecoveryArtifacts.handleInterruptions();
        if (FileSystem.mkdirp("/run/lock") != 0) { throw "Cannot create recovery lock directory"; }
        var acquired = AdvisoryFileLock.acquire("/run/lock/nixos-recovery.lock", wait=true);
        if (!acquired.ok()) { throw "Cannot lock recovery artifact installation"; }
        var lock = acquired.value();
        try {
            if (self.artifacts.ready(self.strict)) { self.artifacts.install(); }
        } finally { lock.close(); }
    }
}

int main(int argc, char** argv) {
    try {
        RecoveryArtifactInstaller(CLIArgs(argc, argv)).run();
        return 0;
    } catch (string error) {
        Console.error(f"nixos-recovery-artifacts: {error}");
        return 1;
    }
}
