import Library.CLI;
import Library.JSON;
import ./Mount.btrc;

int main(int argc, char** argv) {
    try {
        var args = CLIArgs(argc, argv);
        if (args.count() == 2 && args.get(1).equals("--help")) {
            print("Usage: nixos-mount [target]\n\nUnlocks and mounts the installed NixOS system at target, defaulting to /mnt.");
            return 0;
        }
        if (args.count() < 1 || args.count() > 2) { throw "Usage: nixos-mount [target]"; }
        RecoveryMount(JSONValue.readFile(args.get(0)), args.count() == 2 ? args.get(1) : "/mnt").run();
        return 0;
    } catch (string error) {
        fprintf(stderr, "%s\n", error);
        return 1;
    }
}
