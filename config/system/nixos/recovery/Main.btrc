import Library.CLI;
import Library.Console;
import Library.JSON;
import ./Mount.btrc;

class RecoveryMountCommand {
    public CLIArgs args;

    public RecoveryMountCommand(CLIArgs args) { self.args = args; }

    public void run() {
        var usage = "Usage: nixos-mount [target]";
        if (self.args.count() == 2 && self.args.get(1).equals("--help")) {
            CLIHelp().line(usage).blank()
                .line("Unlocks and mounts the installed NixOS system at target, defaulting to /mnt.").print();
            return;
        }
        if (self.args.count() < 1 || self.args.count() > 2) { throw usage; }
        var plan = JSONValue.readFile(self.args.require(0, usage));
        var target = self.args.count() == 2 ? self.args.get(1) : "/mnt";
        RecoveryMount(plan, target).run();
    }
}

int main(int argc, char** argv) {
    try {
        RecoveryMountCommand(CLIArgs(argc, argv)).run();
        return 0;
    } catch (string error) {
        Console.error(error);
        return 1;
    }
}
