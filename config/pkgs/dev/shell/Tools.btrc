import Library.FileSystem;
import Library.Pattern;
import Library.Strings;

class ShellTools {
    class void printFile(string path) {
        FILE* file = fopen(path, "rb");
        if (file == NULL) { throw f"Cannot read file: {path}"; }
        printf("==File: %s==\n", path);
        char buffer[8192];
        var count = fread(buffer, 1, sizeof(buffer), file);
        while (count > (size_t)0) {
            if (fwrite(buffer, 1, count, stdout) != count) { fclose(file); throw "Cannot write file contents"; }
            count = fread(buffer, 1, sizeof(buffer), file);
        }
        var failed = ferror(file);
        fclose(file);
        if (failed != 0) { throw f"Cannot finish reading file: {path}"; }
        printf("\n");
    }

    class void printFiles(string path, string pattern) {
        var status = FileStatus(path);
        if (status.isSymlink()) { return; }
        if (status.isDir()) {
            for name in Directory(path).entries() { ShellTools.printFiles(PathTools.join(path, name), pattern); }
        } else if (status.isFile()) {
            if (Pattern.matches(pattern, PathTools.basename(path))) { ShellTools.printFile(path); }
        } else { throw f"Cannot read file or directory: {path}"; }
    }

    class string extract(string prefix, string suffix, string text) {
        Vector<string> lines = [];
        for line in Strings.split(text, "\n") {
            var start = line.indexOf(prefix);
            var end = line.lastIndexOf(suffix);
            if (start < 0 || end < start + prefix.length()) { continue; }
            var before = line.substring(0, start);
            var middle = line.substring(start + prefix.length(), end - start - prefix.length());
            var after = line.substring(end + suffix.length(), line.length() - end - suffix.length());
            lines.push(f"{before}{middle}{after}");
        }
        var result = Strings.join(lines, "\n");
        while (result.endsWith("\n")) { result = result.substring(0, result.length() - 1); }
        if (result.isEmpty()) { throw f"Substring not found between prefix \"{prefix}\" and suffix \"{suffix}\"."; }
        return result;
    }
}
