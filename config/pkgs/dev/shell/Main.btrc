import Library.CLI;
import ./Tools.btrc;

int main(int argc, char** argv) {
    try {
        var args = CLIArgs(argc, argv);
        if (args.count() >= 2 && args.get(0).equals("print-files")) {
            if (args.count() == 2) { ShellTools.printFiles(args.get(1), "*"); }
            for (int index = 2; index < args.count(); index++) { ShellTools.printFiles(args.get(1), args.get(index)); }
        } else if (args.count() == 4 && args.get(0).equals("extract-substring")) {
            var file = File(args.get(3));
            if (!file.ok()) { throw "Cannot open substring input file"; }
            var text = file.read();
            if (file.failed()) { throw "Cannot read substring input file"; }
            print(ShellTools.extract(args.get(1), args.get(2), text));
        } else { throw "Usage: print-files <directory> [patterns ...] | extract-substring <prefix> <suffix> <file>"; }
        return 0;
    } catch (string error) { fprintf(stderr, "%s\n", error); return 1; }
}
