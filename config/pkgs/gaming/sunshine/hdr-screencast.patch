+// XBGR2101010 and ABGR2101010 (and their RGB/RGBX twins) have the same memory
+// layout; the only difference is whether the top two bits are alpha or ignored.
+// Drivers in practice let us render into the alpha-carrying one but not the
+// alpha-less one, which fails the framebuffer completeness check.
+static uint32_t renderableTwin(uint32_t drmFormat)
+{
+    switch (drmFormat) {
+    case DRM_FORMAT_XBGR2101010:
+        return DRM_FORMAT_ABGR2101010;
+    case DRM_FORMAT_XRGB2101010:
+        return DRM_FORMAT_ARGB2101010;
+    case DRM_FORMAT_RGBX1010102:
+        return DRM_FORMAT_RGBA1010102;
+    case DRM_FORMAT_BGRX1010102:
+        return DRM_FORMAT_BGRA1010102;
+    default:
+        return drmFormat;
+    }
+}
+
+// A two-bit alpha channel is useless for a capture, and clients disagree on how
+// the alpha variants map onto PipeWire's format names, so only ever announce
+// the alpha-less twin and allocate the one we can actually render into.
+static uint32_t announcedTwin(uint32_t drmFormat)
+{
+    switch (drmFormat) {
+    case DRM_FORMAT_ABGR2101010:
+        return DRM_FORMAT_XBGR2101010;
+    case DRM_FORMAT_ARGB2101010:
+        return DRM_FORMAT_XRGB2101010;
+    case DRM_FORMAT_RGBA1010102:
+        return DRM_FORMAT_RGBX1010102;
+    case DRM_FORMAT_BGRA1010102:
+        return DRM_FORMAT_BGRX1010102;
+    default:
+        return drmFormat;
+    }
+}
