import Library.CLI;
import ./Credentials.btrc;

string readReference(string reference) {
    if (!reference.startsWith("op://")) { throw "Expected a 1Password secret reference"; }
    var result = ChildProcess.run("/run/wrappers/bin/op", ["read", "--no-newline", reference], timeoutMilliseconds=120000, maxStdoutBytes=32768, stderr=COMMAND_OUTPUT_SUPPRESS);
    if (!result.ok()) { throw "1Password retrieval failed; existing Sunshine credentials were kept"; }
    return result.stdout();
}

int credentials(CLIArgs args) {
        struct rlimit limit;
        limit.rlim_cur = (rlim_t)0;
        limit.rlim_max = (rlim_t)0;
        if (setrlimit(RLIMIT_CORE, &limit) != 0) { throw "Cannot disable credential core dumps"; }
        umask((mode_t)0077);
        if (args.count() != 2 || !["sync", "provision", "prepare", "status"].contains(args.get(1))) { throw "Usage: nixosctl sunshine <sync|provision|status>"; }
        var config = JSONValue.readFile(args.get(0));
        struct passwd account;
        struct passwd* found = NULL;
        char accountBuffer[16384];
        if (getpwnam_r(config.get("user").asString(), &account, accountBuffer, sizeof(accountBuffer), &found) != 0) { throw "Cannot resolve desktop account"; }
        if (found == NULL || (uid_t)getuid() != (uid_t)account.pw_uid) { throw "Run this command as the configured desktop user"; }
        var action = args.get(1);
        if (action.equals("sync")) {
            var record = JSONValue.makeObject();
            record.set("username", JSONValue.makeString(readReference(config.get("usernameReference").asString())));
            record.set("password", JSONValue.makeString(readReference(config.get("passwordReference").asString())));
            SunshineCredentialStore(config.get("home").asString()).provision(record);
        } else if (action.equals("provision")) {
            var record = SunshineCredentials.parse(SunshineCredentials.readDescriptor(STDIN_FILENO, 32768));
            SunshineCredentialStore(config.get("home").asString()).provision(record);
        } else {
            var store = SunshineCredentialStore(config.get("home").asString());
            var current = store.read();
            if (action.equals("prepare") && current.isNull()) {
                var legacy = store.legacy();
                if (SunshineCredentials.valid(legacy)) {
                    current = JSONValue.makeObject();
                    for key in ["username", "salt", "password"] { current.set(key, legacy.get(key)); }
                    store.write(current);
                }
            }
            if (current.isNull() && config.get("publicKeys").size() > 0) {
                if (action.equals("status")) { print("Sunshine SSH-key administration is configured."); }
                return 0;
            }
            if (!SunshineCredentials.valid(current)) { throw "Sunshine credentials are not provisioned; run nixosctl sunshine sync"; }
        }
        if (!action.equals("prepare")) { print(action.equals("status") ? "Sunshine credentials are provisioned." : "Sunshine credentials updated. Restart Sunshine to apply them."); }
        return 0;
}

int main(int argc, char** argv) {
    try { return credentials(CLIArgs(argc, argv)); }
    catch (string error) { Console.error(error); return 1; }
}
