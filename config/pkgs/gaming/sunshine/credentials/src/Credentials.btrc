import Library.Bytes;
import Library.Console;
import Library.Digest.SHA256;
import Library.FileSystem;
import Library.JSON;
import Library.Process;
import Library.Strings;

#include <sys/random.h>
#include <sys/resource.h>
#include <sys/stat.h>
#include <pwd.h>

class SunshineCredentials {
    class bool valid(JSONValue record) {
        if (!record.isObject() || !record.get("username").isString() || !record.get("salt").isString() || !record.get("password").isString()) { return false; }
        var user = record.get("username").asString();
        int characters = 0;
        for (int index = 0; index < user.length(); index++) { if (((unsigned char)user[index] & (unsigned char)192) != (unsigned char)128) { characters++; } }
        if (user.isEmpty() || characters > 256 || user.contains(":")) { return false; }
        for (int index = 0; index < user.length(); index++) { if ((unsigned char)user[index] < (unsigned char)32) { return false; } }
        var hash = record.get("password").asString();
        if (record.get("salt").asString().isEmpty() || hash.length() != 64) { return false; }
        for (int index = 0; index < hash.length(); index++) { if ("0123456789ABCDEF".indexOf(hash.substring(index, 1)) < 0) { return false; } }
        return true;
    }

    class string digest(string password, string salt) {
        // Sunshine's util::hex serializes SHA256 bytes in reverse order.
        var hash = SHA256.digest(password + salt).toUpper();
        var reversed = StringBuilder();
        for (int index = 62; index >= 0; index -= 2) { reversed.append(hash.substring(index, 2)); }
        return reversed.toString();
    }

    class string salt() {
        var alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        var value = StringBuilder();
        while (value.length() < 16) {
            unsigned char byte = 0;
            if (getrandom(&byte, (size_t)1, 0) != (ssize_t)1) { if (errno == EINTR) { continue; } throw "Cannot obtain credential entropy"; }
            // Rejection sampling avoids modulo bias.
            if (byte < (unsigned char)248) { value.append(alphabet.substring((int)byte % 62, 1)); }
        }
        return value.toString();
    }

    class int escapedCodepoint(string text, int start) {
        if (start + 4 > text.length()) { throw "Invalid credential JSON"; }
        int result = 0;
        for (int index = start; index < start + 4; index++) {
            int digit = "0123456789abcdef".indexOf(text.substring(index, 1).toLower());
            if (digit < 0) { throw "Invalid credential JSON"; }
            result = result * 16 + digit;
        }
        return result;
    }

    class JSONValue parse(Bytes data) {
        if (!data.isNulFreeUtf8()) { throw "Invalid credential JSON"; }
        var text = data.toString();
        // Reject NUL and malformed surrogate escapes before the general JSON
        // parser can truncate or replace them in a password.
        for (int index = 0; index + 1 < text.length(); index++) {
            if (text[index] != '\\') { continue; }
            if (text[index + 1] == 'u') {
                int point = SunshineCredentials.escapedCodepoint(text, index + 2);
                if (point == 0 || (point >= 0xDC00 && point <= 0xDFFF)) { throw "Invalid credential JSON"; }
                if (point >= 0xD800 && point <= 0xDBFF) {
                    if (index + 12 > text.length() || !text.substring(index + 6, 2).equals("\\u")) { throw "Invalid credential JSON"; }
                    int low = SunshineCredentials.escapedCodepoint(text, index + 8);
                    if (low < 0xDC00 || low > 0xDFFF) { throw "Invalid credential JSON"; }
                    index += 6;
                }
                index += 4;
            }
            index++;
        }
        var document = JSONValue.parse(text);
        if (document.isError()) { throw "Invalid credential JSON"; }
        return document;
    }

    class Bytes readDescriptor(int descriptor, int limit) {
        var bytes = Bytes();
        char buffer[4096];
        while (bytes.length() <= limit) {
            var count = read(descriptor, buffer, (size_t)4096);
            if (count == (ssize_t)0) { return bytes; }
            if (count < (ssize_t)0) { if (errno == EINTR) { continue; } throw "Cannot read credential input"; }
            bytes.appendRaw(buffer, (int)count);
        }
        throw "Credential input is too large";
    }
}

class SunshineCredentialStore {
    private PrivateDirectory directory;
    private ExclusiveFileLease lease;
    private int descriptor;

    public SunshineCredentialStore(string home) {
        self.descriptor = -1;
        if (!home.startsWith("/") || home.endsWith("/")) { throw "Unsafe credential directory"; }
        var path = home + "/.config/sunshine";
        int current = open("/", (int)O_RDONLY | (int)O_DIRECTORY | (int)O_CLOEXEC);
        if (current < 0) { throw "Cannot open credential directory"; }
        try {
            var components = Strings.split(path, "/");
            for (int index = 1; index < components.len; index++) {
                var part = components.get(index);
                if (part.isEmpty() || part.equals(".") || part.equals("..")) { throw "Unsafe credential directory"; }
                if (mkdirat(current, part, (mode_t)0700) != 0 && errno != EEXIST) { throw "Cannot create credential directory"; }
                int child = openat(current, part, (int)O_RDONLY | (int)O_DIRECTORY | (int)O_NOFOLLOW | (int)O_CLOEXEC);
                if (child < 0) { throw "Unsafe credential directory"; }
                struct stat info;
                bool safe = fstat(child, &info) == 0 && (info.st_uid == (uid_t)0 || (uid_t)info.st_uid == (uid_t)getuid()) && (info.st_mode & (mode_t)0022) == (mode_t)0;
                close(current);
                current = child;
                if (!safe) { throw "Unsafe credential directory"; }
            }
            struct stat info;
            if (fstat(current, &info) != 0 || (uid_t)info.st_uid != (uid_t)getuid() || fchmod(current, (mode_t)0700) != 0) { throw "Credential directory must belong to the desktop user"; }
            var opened = PrivateDirectory.openAbsoluteLeaf(path);
            if (!opened.ok()) { throw "Unsafe credential directory"; }
            self.directory = opened.value();
            var locked = self.directory.acquireExclusiveLease(".credentials.lock", wait=true);
            if (!locked.ok()) { throw "Unsafe credential lock"; }
            self.lease = locked.value();
            if (!self.directory.validatePath().ok()) { throw "Credential directory changed"; }
            struct stat named;
            if (lstat(path, &named) != 0 || named.st_ino != info.st_ino || named.st_dev != info.st_dev) { throw "Credential directory changed"; }
            self.descriptor = current;
        } catch (string error) { close(current); throw error; }
    }

    public JSONValue read() {
        if (!self.directory.validatePath().ok()) { throw "Credential directory changed"; }
        var read = self.lease.readRegularChild("credentials.json", 4 * 1024 * 1024);
        if (!read.ok()) { throw "Unsafe credential file ownership, type, or permissions"; }
        if (!read.found()) { return JSONValue.makeNull(); }
        return SunshineCredentials.parse(read.bytes());
    }

    public JSONValue legacy() {
        int file = openat(self.descriptor, "sunshine_state.json", (int)O_RDONLY | (int)O_NOFOLLOW | (int)O_NONBLOCK | (int)O_CLOEXEC);
        if (file < 0) { if (errno == ENOENT) { return JSONValue.makeNull(); } throw "Unsafe legacy credentials"; }
        try {
            struct stat info;
            if (fstat(file, &info) != 0 || !S_ISREG(info.st_mode) || (uid_t)info.st_uid != (uid_t)getuid() || info.st_nlink != (nlink_t)1 || (info.st_mode & (mode_t)0022) != (mode_t)0) { throw "Unsafe legacy credentials"; }
            var data = SunshineCredentials.readDescriptor(file, 4 * 1024 * 1024);
            close(file);
            file = -1;
            return SunshineCredentials.parse(data);
        } catch (string error) { if (file >= 0) { close(file); } throw error; }
    }

    public void write(JSONValue record) {
        if (!SunshineCredentials.valid(record)) { throw "Invalid Sunshine credentials"; }
        self.read();
        if (!self.lease.replaceRegularChildDurably("credentials.json", Bytes.fromString(record.stringify() + "\n")).committed()) { throw "Could not durably store Sunshine credentials"; }
    }

    public void provision(JSONValue input) {
        if (!input.get("username").isString() || !input.get("password").isString() || input.get("password").asString().isEmpty()) { throw "Empty or invalid credential input"; }
        var username = input.get("username").asString();
        var password = input.get("password").asString();
        var old = self.read();
        if (SunshineCredentials.valid(old) && old.get("username").asString().equals(username) && old.get("password").asString().equals(SunshineCredentials.digest(password, old.get("salt").asString()))) { return; }
        var salt = SunshineCredentials.salt();
        var record = JSONValue.makeObject();
        record.set("username", JSONValue.makeString(username));
        record.set("salt", JSONValue.makeString(salt));
        record.set("password", JSONValue.makeString(SunshineCredentials.digest(password, salt)));
        self.write(record);
    }

    public void __del__() {
        if (self.lease != null) { self.lease.close(); }
        if (self.directory != null) { self.directory.close(); }
        if (self.descriptor >= 0) { close(self.descriptor); self.descriptor = -1; }
    }
}
