#!/usr/bin/env bash
set -euo pipefail

app_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ "${BATTLENET_IN_DEV_SHELL:-}" = 1 ]; then
  exec make -C "$app_dir" "$@"
fi

export BATTLENET_QUIET_SHELL=1
exec nix-shell "$app_dir/dev-shell.nix" --run \
  "make -C '$app_dir' $(printf '%q ' "$@")"
