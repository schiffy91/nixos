+                string original = FileSystem.readLink(place);
+                string history = PathTools.join(stateRoot, "semu-mod-repairs.tsv");
+                string record = SemuModRecord("link", kind.id, SemuPaths.relative(stateRoot, place), original).line() + "\n";
+                if (!SemuPaths.writeOwned(stateRoot, history, FileSystem.readText(history) + record)) { report.note("mods: could not record repair for " + place); continue; }
+                string outcome = SemuModInstaller.place(stateRoot, place, entry.source, true);
+                report.add(f"{kind.emulator} {kind.id} {entry.relative}: {outcome}");
