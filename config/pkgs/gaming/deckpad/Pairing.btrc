import Library.Strings;
import Library.Vector;
import ./Link.btrc;

// Dotted IPv4 addresses and networks.
class IPv4 {
    // "a.b.c.d" as a host-order number, or -1.
    class long long address(string text) {
        var parts = Strings.split(text, ".");
        if (parts.len != 4) { return -1LL; }
        long long value = 0LL;
        for part in parts {
            if (part.isEmpty() || part.length() > 3 || !part.isDigit() || Strings.toInt(part) > 255) { return -1LL; }
            value = (value << 8) | (long long)Strings.toInt(part);
        }
        return value;
    }

    class string text(long long address) {
        return f"{(int)((address >> 24) & 255LL)}.{(int)((address >> 16) & 255LL)}.{(int)((address >> 8) & 255LL)}.{(int)(address & 255LL)}";
    }

    // The prefix length of "a.b.c.d" (32) or "a.b.c.d/bits"; -1 when malformed.
    class int prefix(string entry) {
        var parts = Strings.split(entry, "/");
        if (parts.len < 1 || parts.len > 2 || IPv4.address(parts.get(0)) < 0LL) { return -1; }
        if (parts.len == 1) { return 32; }
        var bits = parts.get(1);
        return bits.isEmpty() || bits.length() > 2 || !bits.isDigit() || Strings.toInt(bits) > 32 ? -1 : Strings.toInt(bits);
    }

    // Whether an address is the entry's address or inside its network.
    class bool within(long long address, string entry) {
        int bits = IPv4.prefix(entry);
        if (bits < 0) { return false; }
        long long network = IPv4.address(Strings.split(entry, "/").get(0));
        long long mask = bits == 0 ? 0LL : (0xFFFFFFFFLL << (32 - bits)) & 0xFFFFFFFFLL;
        return (address & mask) == (network & mask);
    }
}

// Trust by network address: this machine always, others when an address or
// network on the list matches. It proves nothing about who is at that address,
// so it suits a firewalled home network until peers carry keys.
class AddressPairing implements IPairing {
    private Vector<string> allowed;

    public AddressPairing(Vector<string> allowed) {
        for entry in allowed { if (IPv4.prefix(entry) < 0) { throw f"Invalid address or network: {entry}"; } }
        self.allowed = allowed;
    }

    public bool trusts(Peer peer) {
        long long address = IPv4.address(peer.identity);
        if (address < 0LL) { return false; }
        if ((address >> 24) == 127LL) { return true; }
        for entry in self.allowed { if (IPv4.within(address, entry)) { return true; } }
        return false;
    }
}
