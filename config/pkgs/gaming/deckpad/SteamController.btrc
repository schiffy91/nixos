import Library.Bytes;
import Library.Vector;
import ./PadSource.btrc;
import ./PadState.btrc;
import ./Wire.btrc;

// The 2026 Steam Controller as a host sees it over HID: one vendor collection of
// reports, the same on every link. How those reports travel (USB descriptors and
// transfers, Bluetooth channels) belongs to the link, not here.
// Report IDs and layouts follow SDL's Steam Controller driver and hid-steam.c;
// the Deck-to-controller mapping follows jmedina21/deck-as-controller (MIT).
enum {
    STEAM_VENDOR = 0x28DE, STEAM_PRODUCT = 0x1302, STEAM_PRODUCT_BLUETOOTH = 0x1303,
    STEAM_REPORT_STATE = 0x42, STEAM_REPORT_STATE_BLUETOOTH = 0x45, STEAM_STATE_LENGTH_BLUETOOTH = 46, STEAM_REPORT_BATTERY = 0x43, STEAM_REPORT_FEATURE = 0x01,
    STEAM_STATE_LENGTH = 54, STEAM_BATTERY_LENGTH = 15, STEAM_FEATURE_LENGTH = 64,
    STEAM_OUT_RUMBLE = 0x80, STEAM_OUT_PULSE = 0x81, STEAM_OUT_COMMAND = 0x82,
    STEAM_OUT_TONE = 0x83, STEAM_OUT_SWEEP = 0x84, STEAM_OUT_SCRIPT = 0x85,
    STEAM_GET_ATTRIBUTES = 0x83, STEAM_SET_SETTINGS = 0x87, STEAM_GET_SETTINGS = 0x89,
    STEAM_HAPTIC_PULSE = 0x8F, STEAM_GET_STRING = 0xAE, STEAM_RUMBLE = 0xEB,
    STEAM_SERIAL_LENGTH = 20,
    // Steam's hardware updater offers firmware to a controller whose build
    // time is not that of the firmware it ships (IBEX_FW_<time>.fw), unless
    // its board is older than revision 68. This controller cannot take
    // firmware, so it is an older board, running the firmware of November 2026.
    STEAM_BOARD_REVISION = 67, STEAM_FIRMWARE_TIME = 0x6AE90BC5
};

enum { HOST_EFFECT_NONE, HOST_EFFECT_RUMBLE, HOST_EFFECT_HAPTIC };

// What a host write asks of the controller: motor speeds, or a trackpad haptic
// already translated into the Deck controller's own command.
class HostEffect {
    public int kind = HOST_EFFECT_NONE;
    public int left = 0;
    public int right = 0;
    public PadCommand command;

    public HostEffect() {
        self.command = PadCommand();
    }
}

class SteamController {
    private string serialNumber;
    private Bytes commandMemory;
    private Vector<int> settings = [];
    private int sequence = 0;

    public SteamController(string serial) {
        if (serial.isEmpty() || serial.length() > STEAM_SERIAL_LENGTH) { throw "Controller serial must be 1 to 20 characters"; }
        self.serialNumber = serial;
        self.commandMemory = Wire.zeros(64);
        for (int index = 0; index < 256; index++) { self.settings.push(0); }
    }

    class void vendorReports(Bytes out, int item, int identifier, int length) {
        out.append(0x85); out.append(identifier);
        out.append(0x09); out.append(0x01);
        out.append(0x95); out.append(length);
        out.append(item); out.append(0x02);
    }

    // One vendor collection of byte arrays, like the real controller's. Lengths
    // exclude the report ID; hid-steam requires the feature report to be 63.
    public int reportDescriptor(Bytes out) {
        out.clear();
        for headerByte in [0x06, 0x00, 0xFF, 0x09, 0x01, 0xA1, 0x01, 0x15, 0x00, 0x26, 0xFF, 0x00, 0x75, 0x08] {
            out.append(headerByte);
        }
        SteamController.vendorReports(out, 0x81, STEAM_REPORT_STATE, 53);
        SteamController.vendorReports(out, 0x81, STEAM_REPORT_BATTERY, 14);
        SteamController.vendorReports(out, 0x81, 0x45, 45);
        SteamController.vendorReports(out, 0x81, 0x47, 45);
        SteamController.vendorReports(out, 0x81, 0x79, 1);
        SteamController.vendorReports(out, 0x91, STEAM_OUT_RUMBLE, 9);
        SteamController.vendorReports(out, 0x91, STEAM_OUT_PULSE, 7);
        SteamController.vendorReports(out, 0x91, STEAM_OUT_COMMAND, 3);
        SteamController.vendorReports(out, 0x91, STEAM_OUT_TONE, 9);
        SteamController.vendorReports(out, 0x91, STEAM_OUT_SWEEP, 8);
        SteamController.vendorReports(out, 0x91, STEAM_OUT_SCRIPT, 3);
        SteamController.vendorReports(out, 0x91, 0x86, 3);
        SteamController.vendorReports(out, 0x91, 0x87, 63);
        SteamController.vendorReports(out, 0x91, 0x88, 63);
        SteamController.vendorReports(out, 0x91, 0x89, 63);
        SteamController.vendorReports(out, 0xB1, STEAM_REPORT_FEATURE, 63);
        out.append(0xC0);
        return out.length();
    }

    // Who the controller says it is, on any link.
    public int vendor() { return STEAM_VENDOR; }
    public int product() { return STEAM_PRODUCT; }
    public string manufacturer() { return "Valve Software"; }
    public string name() { return "Steam Controller"; }
    public string serial() { return self.serialNumber; }

    public int encodeState(PadState state, long long microseconds, Bytes out) {
        Wire.resetZeros(out, STEAM_STATE_LENGTH);
        out.set(0, STEAM_REPORT_STATE);
        out.set(1, self.sequence);
        self.sequence = (self.sequence + 1) & 0xFF;
        Wire.putU32le(out, 2, (long long)state.buttons);
        Wire.putU16le(out, 6, state.leftTrigger);
        Wire.putU16le(out, 8, state.rightTrigger);
        Wire.putU16le(out, 10, state.leftStickX);
        Wire.putU16le(out, 12, state.leftStickY);
        Wire.putU16le(out, 14, state.rightStickX);
        Wire.putU16le(out, 16, state.rightStickY);
        Wire.putU16le(out, 18, state.leftPadX);
        Wire.putU16le(out, 20, state.leftPadY);
        Wire.putU16le(out, 22, state.leftPadPressure);
        Wire.putU16le(out, 24, state.rightPadX);
        Wire.putU16le(out, 26, state.rightPadY);
        Wire.putU16le(out, 28, state.rightPadPressure);
        Wire.putU32le(out, 30, microseconds);
        Wire.putU16le(out, 34, state.accelX);
        Wire.putU16le(out, 36, state.accelY);
        Wire.putU16le(out, 38, state.accelZ);
        Wire.putU16le(out, 40, state.gyroX);
        Wire.putU16le(out, 42, state.gyroY);
        Wire.putU16le(out, 44, state.gyroZ);
        return STEAM_STATE_LENGTH;
    }

    // Charge state 1 discharging, 2 charging, 4 full; voltages and currents stay zero.
    public int encodeBattery(int percent, bool charging, Bytes out) {
        Wire.resetZeros(out, STEAM_BATTERY_LENGTH);
        out.set(0, STEAM_REPORT_BATTERY);
        int level = Wire.clamp(percent, 0, 100);
        out.set(1, charging ? (level >= 100 ? 4 : 2) : 1);
        out.set(2, level);
        return STEAM_BATTERY_LENGTH;
    }

    // The host wrote feature report 1: a command, answered by the next read.
    public void setFeature(Bytes data) {
        if (data.length() < 3 || data.get(0) != STEAM_REPORT_FEATURE) { return; }
        Wire.resetZeros(self.commandMemory, 64);
        int copyCount = data.length() - 1 > 63 ? 63 : data.length() - 1;
        for (int index = 0; index < copyCount; index++) {
            self.commandMemory.set(index, data.get(index + 1));
        }
        if (self.commandMemory.get(0) != STEAM_SET_SETTINGS) { return; }
        // <register> <value: u16>, repeated. The daemon already runs the Deck's
        // controller the way Steam asks for here, so the values are only kept.
        int count = Wire.clamp(self.commandMemory.get(1), 0, 60);
        for (int index = 0; index + 2 < count; index += 3) {
            int registerIndex = self.commandMemory.get(2 + index);
            self.settings.set(registerIndex, Wire.u16le(self.commandMemory, 3 + index));
        }
    }

    private void attribute(Bytes out, int offset, int tag, long long value) {
        out.set(offset, tag & 0xFF);
        Wire.putU32le(out, offset + 1, value);
    }

    // The reply to the last command, as a real controller answers.
    public int getFeature(Bytes out) {
        Wire.resetZeros(out, STEAM_FEATURE_LENGTH);
        out.set(0, STEAM_REPORT_FEATURE);
        int command = self.commandMemory.get(0);
        int arguments = Wire.clamp(self.commandMemory.get(1), 0, 60);
        out.set(1, command);
        if (command == STEAM_GET_ATTRIBUTES) {
            self.attribute(out, 3, 1, (long long)STEAM_PRODUCT);
            self.attribute(out, 8, 2, 0LL);
            self.attribute(out, 13, 10, 0x68D2F92ELL);
            self.attribute(out, 18, 4, (long long)STEAM_FIRMWARE_TIME);
            self.attribute(out, 23, 9, (long long)STEAM_BOARD_REVISION);
            out.set(2, 25);
        } else if (command == STEAM_GET_STRING && arguments >= 1) {
            out.set(3, self.commandMemory.get(2));
            Bytes serialBytes = Bytes.fromString(self.serialNumber);
            for (int index = 0; index < serialBytes.length(); index++) { out.set(4 + index, serialBytes.get(index)); }
            out.set(2, 1 + STEAM_SERIAL_LENGTH);
        } else if (command == STEAM_GET_SETTINGS) {
            int length = 0;
            for (int index = 0; index < arguments && length + 3 <= 60; index += 3) {
                int setting = self.commandMemory.get(2 + index);
                out.set(3 + length, setting);
                Wire.putU16le(out, 4 + length, self.settings.get(setting));
                length += 3;
            }
            out.set(2, length);
        } else {
            for (int index = 0; index < 63; index++) {
                out.set(1 + index, self.commandMemory.get(index));
            }
        }
        return STEAM_FEATURE_LENGTH;
    }

    class int signedByte(int value) { return value >= 128 ? value - 256 : value; }

    // The controller's haptic sides also count its grip motors; the Deck only has
    // trackpads. Pulses use the legacy numbering: 0 right, 1 left, 2 both.
    class int pulsePad(int side) { return side == 0 || side == 4 ? 0 : (side == 1 || side == 3 ? 1 : 2); }
    class int hapticPad(int side) { return side == 0 || side == 3 ? 0 : (side == 1 || side == 4 ? 1 : 2); }

    // Steam sets a click's strength as a gain here (-9 dB low, -3 dB high); the
    // Deck's controller takes an intensity level instead.
    class int clickIntensity(int gain) { return gain <= -8 ? 1 : (gain <= -5 ? 2 : (gain <= 0 ? 3 : 4)); }

    // An output report from the host, starting with its report ID.
    public void outputEffect(Bytes data, HostEffect effect) {
        effect.kind = HOST_EFFECT_NONE;
        if (data.length() < 4) { return; }
        int report = data.get(0);
        int side = data.get(1);
        if (report == STEAM_OUT_RUMBLE && data.length() >= 10) {
            effect.kind = HOST_EFFECT_RUMBLE;
            effect.left = Wire.u16le(data, 4);
            effect.right = Wire.u16le(data, 7);
            return;
        }
        effect.kind = HOST_EFFECT_HAPTIC;
        if (report == STEAM_OUT_PULSE && data.length() >= 8) {
            DeckCommand.pulse(effect.command, SteamController.pulsePad(side), Wire.u16le(data, 2), Wire.u16le(data, 4), Wire.u16le(data, 6));
        } else if (report == STEAM_OUT_COMMAND) {
            int kind = data.get(2) > 2 ? 2 : data.get(2);
            DeckCommand.haptic(effect.command, SteamController.hapticPad(side), kind, SteamController.clickIntensity(SteamController.signedByte(data.get(3))), 0, 0, 0, 0, 0, 0, 0, 0);
        } else if (report == STEAM_OUT_TONE && data.length() >= 10) {
            DeckCommand.haptic(effect.command, SteamController.hapticPad(side), DECK_HAPTIC_TONE, 0, SteamController.signedByte(data.get(2)),
                Wire.u16le(data, 3), Wire.u16le(data, 5), Wire.u16le(data, 7), data.get(9), 0, 0, 0);
        } else if (report == STEAM_OUT_SWEEP && data.length() >= 9) {
            DeckCommand.haptic(effect.command, SteamController.hapticPad(side), DECK_HAPTIC_SWEEP, 0, SteamController.signedByte(data.get(2)),
                0, Wire.u16le(data, 3), 0, 0, 0, Wire.u16le(data, 5), Wire.u16le(data, 7));
        } else if (report == STEAM_OUT_SCRIPT) {
            DeckCommand.haptic(effect.command, SteamController.hapticPad(side), DECK_HAPTIC_SCRIPT, 0, SteamController.signedByte(data.get(3)),
                0, 0, 0, 0, data.get(2), 0, 0);
        } else {
            effect.kind = HOST_EFFECT_NONE;
        }
    }

    // Rumble and pulses can also arrive as feature commands, as on older controllers.
    public void featureEffect(Bytes data, HostEffect effect) {
        effect.kind = HOST_EFFECT_NONE;
        if (data.length() < 10 || data.get(0) != STEAM_REPORT_FEATURE) { return; }
        if (data.get(1) == STEAM_RUMBLE) {
            effect.kind = HOST_EFFECT_RUMBLE;
            effect.left = Wire.u16le(data, 6);
            effect.right = Wire.u16le(data, 8);
        } else if (data.get(1) == STEAM_HAPTIC_PULSE) {
            effect.kind = HOST_EFFECT_HAPTIC;
            DeckCommand.pulse(effect.command, data.get(3) > 2 ? 2 : data.get(3), Wire.u16le(data, 4), Wire.u16le(data, 6), Wire.u16le(data, 8));
        }
    }
}
