import ./Controller.btrc;
import ./SteamController.btrc;
import ./Wire.btrc;

enum { USB_STALL = -1 };

// The controller as a full-speed USB device with one HID interface: the USB
// descriptors and control transfers that wrap the HID reports. USB/IP uses it
// today; a USB gadget presents the same device over a cable.
class UsbHidDevice {
    private VirtualController controller;

    public UsbHidDevice(VirtualController controller) { self.controller = controller; }

    public VirtualController hid() { return self.controller; }

    public int deviceDescriptor(unsigned char* out) {
        int bytes[18] = {18, 0x01, 0x00, 0x02, 0x00, 0x00, 0x00, 64, 0, 0, 0, 0, 0x00, 0x01, 1, 2, 3, 1};
        for (int index = 0; index < 18; index++) { out[index] = (unsigned char)bytes[index]; }
        Wire.putU16le(out, 8, self.controller.personality().vendor());
        Wire.putU16le(out, 10, self.controller.personality().product());
        return 18;
    }

    // Configuration, interface, HID, then interrupt IN 0x81 and OUT 0x01 at 1 ms.
    public int configurationDescriptor(unsigned char* out) {
        unsigned char report[256];
        int reportLength = self.controller.personality().reportDescriptor(report);
        int bytes[41] = {
            9, 0x02, 41, 0, 1, 1, 0, 0x80, 250,
            9, 0x04, 0, 0, 2, 0x03, 0, 0, 0,
            9, 0x21, 0x11, 0x01, 0, 1, 0x22, 0, 0,
            7, 0x05, 0x81, 0x03, 64, 0, 1,
            7, 0x05, 0x01, 0x03, 64, 0, 1
        };
        for (int index = 0; index < 41; index++) { out[index] = (unsigned char)bytes[index]; }
        Wire.putU16le(out, 25, reportLength);
        return 41;
    }

    public int hidDescriptor(unsigned char* out) {
        unsigned char configuration[64];
        self.configurationDescriptor(configuration);
        memcpy(out, configuration + 18, (size_t)9);
        return 9;
    }

    // 0 is the language table; 1 manufacturer, 2 product, 3 serial number.
    public int stringDescriptor(int index, unsigned char* out) {
        if (index == 0) { out[0] = (unsigned char)4; out[1] = (unsigned char)0x03; out[2] = (unsigned char)0x09; out[3] = (unsigned char)0x04; return 4; }
        var identity = self.controller.personality();
        string text = index == 1 ? identity.manufacturer() : (index == 2 ? identity.name() : (index == 3 ? identity.serial() : ""));
        if (text.isEmpty()) { return 0; }
        int length = text.length();
        out[0] = (unsigned char)(2 + 2 * length);
        out[1] = (unsigned char)0x03;
        for (int position = 0; position < length; position++) {
            out[2 + 2 * position] = (unsigned char)text[position];
            out[3 + 2 * position] = (unsigned char)0;
        }
        return 2 + 2 * length;
    }

    private int descriptor(int kind, int index, unsigned char* out) {
        if (kind == 0x01) { return self.deviceDescriptor(out); }
        if (kind == 0x02) { return self.configurationDescriptor(out); }
        if (kind == 0x03) { int length = self.stringDescriptor(index, out); return length > 0 ? length : USB_STALL; }
        if (kind == 0x21) { return self.hidDescriptor(out); }
        if (kind == 0x22) { return self.controller.personality().reportDescriptor(out); }
        return USB_STALL;
    }

    private int answer(unsigned char* data, int capacity, unsigned char* reply, int length) {
        if (length < 0) { return USB_STALL; }
        int count = length < capacity ? length : capacity;
        memcpy(data, reply, (size_t)count);
        return count;
    }

    // One control transfer. For device-to-host requests the reply is written to
    // data (at most `length` bytes) and its size returned; for host-to-device
    // requests data holds `length` bytes. USB_STALL refuses the request.
    public int control(unsigned char* setup, unsigned char* data, int length) {
        int kind = (int)setup[0];
        int request = (int)setup[1];
        int value = Wire.u16le(setup, 2);
        unsigned char reply[256];
        memset(reply, 0, sizeof(reply));
        if ((kind == 0x80 || kind == 0x81) && request == 0x06) { return self.answer(data, length, reply, self.descriptor(value >> 8, value & 0xFF, reply)); }
        if (kind == 0x80 && request == 0x08) { reply[0] = (unsigned char)1; return self.answer(data, length, reply, 1); }
        if ((kind == 0x80 || kind == 0x81 || kind == 0x82) && request == 0x00) { return self.answer(data, length, reply, 2); }
        if (kind == 0x81 && request == 0x0A) { return self.answer(data, length, reply, 1); }
        if (kind == 0x00 && request == 0x09) { return 0; }
        if ((kind == 0x01 && request == 0x0B) || (kind == 0x02 && request == 0x01)) { return 0; }
        if (kind == 0x21 && (request == 0x0A || request == 0x0B)) { return 0; }
        if (kind == 0xA1 && request == 0x02) { return self.answer(data, length, reply, 1); }
        if (kind == 0xA1 && request == 0x03) { reply[0] = (unsigned char)1; return self.answer(data, length, reply, 1); }
        // HID GET_REPORT and SET_REPORT: the report type is the value's high byte.
        if (kind == 0xA1 && request == 0x01) {
            return (value >> 8) == 0x03 ? self.answer(data, length, reply, self.controller.feature(value & 0xFF, reply)) : USB_STALL;
        }
        if (kind == 0x21 && request == 0x09) {
            if ((value >> 8) == 0x03) { return self.controller.setFeature(data, length) ? length : USB_STALL; }
            if ((value >> 8) == 0x02) { self.controller.output(data, length); return length; }
            return USB_STALL;
        }
        return USB_STALL;
    }
}
