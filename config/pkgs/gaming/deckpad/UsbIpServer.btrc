import Library.Console;
import Library.IO;
import Library.Strings;
import Library.Vector;
import ./Native.btrc;
import ./UsbDevice.btrc;
import ./Wire.btrc;

// USB/IP (Documentation/usb/usbip_protocol.rst): the host's vhci_hcd attaches
// the controller as a real USB device. Everything on the wire is big-endian.
enum {
    USBIP_VERSION = 0x0111,
    USBIP_REQUEST_DEVICES = 0x8005, USBIP_REPLY_DEVICES = 0x0005,
    USBIP_REQUEST_IMPORT = 0x8003, USBIP_REPLY_IMPORT = 0x0003,
    USBIP_SUBMIT = 1, USBIP_UNLINK = 2, USBIP_SUBMIT_REPLY = 3, USBIP_UNLINK_REPLY = 4,
    USBIP_HEADER = 48, USBIP_DEVICE = 312, USBIP_SPEED_FULL = 2,
    USBIP_BUS = 1, USBIP_ADDRESS = 2, USBIP_PAYLOAD_LIMIT = 1024,
    USBIP_STALLED = -32, USBIP_UNLINKED = -104
};

struct UsbIpBuffer {
    unsigned char bytes[4096];
    int length;
};

// Interrupt IN requests the host is waiting on, oldest first.
struct UsbIpPending {
    long long sequence[8];
    int count;
};

class UsbIpWire {
    class string busId() { return "1-1"; }

    // A dotted IPv4 address as a host-order number, or -1.
    class long long address(string text) {
        var parts = Strings.split(text, ".");
        if (parts.len != 4) { return -1LL; }
        long long value = 0LL;
        for part in parts {
            if (part.isEmpty() || part.length() > 3 || !part.isDigit() || Strings.toInt(part) > 255) { return -1LL; }
            value = (value << 8) | (long long)Strings.toInt(part);
        }
        return value;
    }

    // struct usbip_usb_device: path, bus id, numbers, speed, then the identity.
    // The prefix length of "a.b.c.d" (32) or "a.b.c.d/bits"; -1 when malformed.
    class int prefix(string entry) {
        var parts = Strings.split(entry, "/");
        if (parts.len < 1 || parts.len > 2 || UsbIpWire.address(parts.get(0)) < 0LL) { return -1; }
        if (parts.len == 1) { return 32; }
        var bits = parts.get(1);
        return bits.isEmpty() || bits.length() > 2 || !bits.isDigit() || Strings.toInt(bits) > 32 ? -1 : Strings.toInt(bits);
    }

    // Whether a host-order address is the entry's address or inside its network.
    class bool within(long long host, string entry) {
        int bits = UsbIpWire.prefix(entry);
        if (bits < 0) { return false; }
        long long network = UsbIpWire.address(Strings.split(entry, "/").get(0));
        long long mask = bits == 0 ? 0LL : (0xFFFFFFFFLL << (32 - bits)) & 0xFFFFFFFFLL;
        return (host & mask) == (network & mask);
    }

    class void device(unsigned char* out) {
        memset(out, 0, (size_t)USBIP_DEVICE);
        var path = "/sys/devices/platform/deckpad/usb1/1-1";
        memcpy(out, path, (size_t)path.length());
        memcpy(out + 256, UsbIpWire.busId(), (size_t)UsbIpWire.busId().length());
        Wire.putU32be(out, 288, (long long)USBIP_BUS);
        Wire.putU32be(out, 292, (long long)USBIP_ADDRESS);
        Wire.putU32be(out, 296, (long long)USBIP_SPEED_FULL);
        Wire.putU16be(out, 300, STEAM_VENDOR);
        Wire.putU16be(out, 302, STEAM_PRODUCT);
        Wire.putU16be(out, 304, 0x0100);
        out[309] = (unsigned char)1;
        out[310] = (unsigned char)1;
        out[311] = (unsigned char)1;
    }

    class void operation(unsigned char* out, int code, int status) {
        Wire.putU16be(out, 0, USBIP_VERSION);
        Wire.putU16be(out, 2, code);
        Wire.putU32be(out, 4, (long long)status);
    }

    class void reply(unsigned char* out, int command, long long sequence, int status, int length) {
        memset(out, 0, (size_t)USBIP_HEADER);
        Wire.putU32be(out, 0, (long long)command);
        Wire.putU32be(out, 4, sequence);
        Wire.putU32be(out, 20, (long long)status);
        Wire.putU32be(out, 24, (long long)length);
    }
}

class UsbIpServer {
    private UsbDevice device;
    private Vector<string> allowed;
    private int listener = -1;
    private int client = -1;
    private int signals = -1;
    private bool imported = false;
    private struct UsbIpBuffer received;
    private struct UsbIpPending pending;

    // Loopback clients are always accepted; others must match an address or
    // network in `allowed`. USB/IP itself has no authentication.
    public UsbIpServer(UsbDevice device, string address, int port, Vector<string> allowed) {
        self.device = device;
        self.allowed = allowed;
        self.received.length = 0;
        self.pending.count = 0;
        struct sockaddr_in local;
        memset(&local, 0, sizeof(local));
        local.sin_family = AF_INET;
        local.sin_port = htons((unsigned short)port);
        long long host = UsbIpWire.address(address);
        if (port < 0 || port > 65535 || host < 0LL) { throw f"Invalid listen address {address}:{port}"; }
        local.sin_addr.s_addr = htonl((uint32_t)host);
        self.listener = socket(AF_INET, SOCK_STREAM, 0);
        int yes = 1;
        if (self.listener < 0 || !DescriptorFlags.configure(self.listener, true) ||
            setsockopt(self.listener, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes)) != 0 ||
            bind(self.listener, (struct sockaddr*)&local, sizeof(local)) != 0 || listen(self.listener, 4) != 0) {
            self.close();
            throw f"Cannot listen on {address}:{port}";
        }
    }

    public int port() {
        struct sockaddr_in local;
        memset(&local, 0, sizeof(local));
        socklen_t length = sizeof(local);
        return getsockname(self.listener, (struct sockaddr*)&local, &length) == 0 ? (int)ntohs(local.sin_port) : -1;
    }

    // Stop signals arrive as readable data instead of interrupting a transfer.
    private void watchSignals() {
        sigset_t stopping;
        sigemptyset(&stopping);
        sigaddset(&stopping, SIGINT);
        sigaddset(&stopping, SIGTERM);
        if (sigprocmask((int)SIG_BLOCK, &stopping, NULL) != 0) { throw "Cannot block stop signals"; }
        self.signals = signalfd(-1, &stopping, (int)SFD_NONBLOCK | (int)SFD_CLOEXEC);
        if (self.signals < 0) { throw "Cannot watch stop signals"; }
    }

    private void drop() {
        if (self.client >= 0) { shutdown(self.client, SHUT_RDWR); close(self.client); self.client = -1; }
        self.imported = false;
        self.received.length = 0;
        self.pending.count = 0;
        self.device.detach();
    }

    public void close() {
        self.drop();
        if (self.listener >= 0) { close(self.listener); self.listener = -1; }
        if (self.signals >= 0) { close(self.signals); self.signals = -1; }
    }

    private bool permitted(struct sockaddr_in* peer) {
        long long host = (long long)ntohl(peer->sin_addr.s_addr);
        if ((host >> 24) == 127LL) { return true; }
        for entry in self.allowed { if (UsbIpWire.within(host, entry)) { return true; } }
        Console.error(f"deckpad: refused {(int)((host >> 24) & 255LL)}.{(int)((host >> 16) & 255LL)}.{(int)((host >> 8) & 255LL)}.{(int)(host & 255LL)}");
        return false;
    }

    private void admit() {
        struct sockaddr_in peer;
        memset(&peer, 0, sizeof(peer));
        socklen_t length = sizeof(peer);
        int descriptor = accept(self.listener, (struct sockaddr*)&peer, &length);
        if (descriptor < 0) { return; }
        int yes = 1;
        // One host at a time; a second connection never takes the controller away.
        if (self.imported || !self.permitted(&peer) || !DescriptorFlags.configure(descriptor, true) ||
            setsockopt(descriptor, IPPROTO_TCP, TCP_NODELAY, &yes, sizeof(yes)) != 0) {
            close(descriptor);
            return;
        }
        self.drop();
        self.client = descriptor;
    }

    private bool transmit(unsigned char* data, int length) {
        int sent = 0;
        while (sent < length) {
            ssize_t count = send(self.client, data + sent, (size_t)(length - sent), MSG_NOSIGNAL);
            if (count > (ssize_t)0) { sent += (int)count; continue; }
            if (count < (ssize_t)0 && errno == EINTR) { continue; }
            if (count < (ssize_t)0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
                struct pollfd waiting;
                waiting.fd = self.client;
                waiting.events = POLLOUT;
                waiting.revents = 0;
                if (poll(&waiting, (nfds_t)1, 1000) > 0) { continue; }
            }
            return false;
        }
        return true;
    }

    private bool receive() {
        int room = 4096 - self.received.length;
        if (room <= 0) { return false; }
        ssize_t count = recv(self.client, self.received.bytes + self.received.length, (size_t)room, 0);
        if (count > (ssize_t)0) { self.received.length += (int)count; return true; }
        return count < (ssize_t)0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR);
    }

    private void consume(int length) {
        memmove(self.received.bytes, self.received.bytes + length, (size_t)(self.received.length - length));
        self.received.length -= length;
    }

    private bool sendDevices() {
        unsigned char reply[328];
        memset(reply, 0, sizeof(reply));
        UsbIpWire.operation(reply, USBIP_REPLY_DEVICES, 0);
        Wire.putU32be(reply, 8, 1LL);
        UsbIpWire.device(reply + 12);
        reply[324] = (unsigned char)0x03;
        return self.transmit(reply, 328);
    }

    // Take the controller for an importing host; the reason when that fails.
    private string claim(unsigned char* busId) {
        char requested[33];
        memset(requested, 0, sizeof(requested));
        memcpy(requested, busId, (size_t)32);
        if (!Strings.copy(requested).equals(UsbIpWire.busId())) { return "unknown bus id"; }
        try { self.device.attach(); } catch (string error) { return error; }
        return "";
    }

    private bool importDevice(unsigned char* busId) {
        var failure = self.claim(busId);
        unsigned char reply[320];
        memset(reply, 0, sizeof(reply));
        if (!failure.isEmpty()) {
            Console.error(f"deckpad: import refused: {failure}");
            UsbIpWire.operation(reply, USBIP_REPLY_IMPORT, 1);
            self.transmit(reply, 8);
            return false;
        }
        UsbIpWire.operation(reply, USBIP_REPLY_IMPORT, 0);
        UsbIpWire.device(reply + 8);
        self.imported = true;
        Console.error("deckpad: host attached");
        return self.transmit(reply, 320);
    }

    // Before import the client speaks the operation protocol: list, or import.
    private bool operation() {
        if (self.received.length < 8) { return true; }
        if (Wire.u16be(self.received.bytes, 0) != USBIP_VERSION) { return false; }
        int code = Wire.u16be(self.received.bytes, 2);
        if (code == USBIP_REQUEST_DEVICES) { self.consume(8); return self.sendDevices(); }
        if (code != USBIP_REQUEST_IMPORT) { return false; }
        if (self.received.length < 40) { return true; }
        unsigned char busId[32];
        memcpy(busId, self.received.bytes + 8, (size_t)32);
        self.consume(40);
        return self.importDevice(busId);
    }

    private bool submit(long long sequence, bool incoming, int endpoint, int length, unsigned char* setup, unsigned char* payload) {
        unsigned char reply[USBIP_HEADER + USBIP_PAYLOAD_LIMIT];
        if (endpoint == 1 && incoming) {
            if (self.pending.count == 8) { UsbIpWire.reply(reply, USBIP_SUBMIT_REPLY, sequence, USBIP_STALLED, 0); return self.transmit(reply, USBIP_HEADER); }
            self.pending.sequence[self.pending.count] = sequence;
            self.pending.count++;
            return true;
        }
        int result = USB_STALL;
        if (endpoint == 0 && incoming) { result = self.device.control(setup, reply + USBIP_HEADER, length < USBIP_PAYLOAD_LIMIT ? length : USBIP_PAYLOAD_LIMIT); }
        else if (endpoint == 0) { result = self.device.control(setup, payload, length); }
        else if (endpoint == 1) { self.device.output(payload, length); result = length; }
        if (result == USB_STALL) { UsbIpWire.reply(reply, USBIP_SUBMIT_REPLY, sequence, USBIP_STALLED, 0); return self.transmit(reply, USBIP_HEADER); }
        UsbIpWire.reply(reply, USBIP_SUBMIT_REPLY, sequence, 0, result);
        return self.transmit(reply, USBIP_HEADER + (incoming ? result : 0));
    }

    private bool cancel(long long sequence, long long target) {
        int status = 0;
        for (int index = 0; index < self.pending.count; index++) {
            if (self.pending.sequence[index] != target) { continue; }
            for (int next = index + 1; next < self.pending.count; next++) { self.pending.sequence[next - 1] = self.pending.sequence[next]; }
            self.pending.count--;
            status = USBIP_UNLINKED;
            break;
        }
        unsigned char reply[USBIP_HEADER];
        UsbIpWire.reply(reply, USBIP_UNLINK_REPLY, sequence, status, 0);
        return self.transmit(reply, USBIP_HEADER);
    }

    // After import every message is a 48-byte header, then data for OUT transfers.
    private bool transfer() {
        if (self.received.length < USBIP_HEADER) { return true; }
        unsigned char* header = self.received.bytes;
        long long command = Wire.u32be(header, 0);
        long long sequence = Wire.u32be(header, 4);
        if (command == (long long)USBIP_UNLINK) {
            long long target = Wire.u32be(header, 20);
            self.consume(USBIP_HEADER);
            return self.cancel(sequence, target);
        }
        if (command != (long long)USBIP_SUBMIT) { return false; }
        bool incoming = Wire.u32be(header, 12) == 1LL;
        int endpoint = (int)Wire.u32be(header, 16);
        long long requested = Wire.u32be(header, 24);
        if (requested > (long long)USBIP_PAYLOAD_LIMIT) { return false; }
        int length = (int)requested;
        int total = USBIP_HEADER + (incoming ? 0 : length);
        if (self.received.length < total) { return true; }
        unsigned char setup[8];
        unsigned char payload[USBIP_PAYLOAD_LIMIT];
        memcpy(setup, header + 40, (size_t)8);
        if (!incoming) { memcpy(payload, header + USBIP_HEADER, (size_t)length); }
        self.consume(total);
        return self.submit(sequence, incoming, endpoint, length, setup, payload);
    }

    private bool process() {
        while (true) {
            int before = self.received.length;
            if (!(self.imported ? self.transfer() : self.operation())) { return false; }
            if (self.client < 0 || self.received.length == before) { return true; }
        }
        return true;
    }

    // Answer waiting interrupt IN requests with the reports that are due.
    private bool flush() {
        struct UsbReport report;
        unsigned char reply[USBIP_HEADER + 64];
        while (self.pending.count > 0 && self.device.input(&report)) {
            UsbIpWire.reply(reply, USBIP_SUBMIT_REPLY, self.pending.sequence[0], 0, report.length);
            memcpy(reply + USBIP_HEADER, report.bytes, (size_t)report.length);
            for (int next = 1; next < self.pending.count; next++) { self.pending.sequence[next - 1] = self.pending.sequence[next]; }
            self.pending.count--;
            if (!self.transmit(reply, USBIP_HEADER + report.length)) { return false; }
        }
        return true;
    }

    // Serve until a stop signal arrives or the Deck's stop chord is held.
    public void run() {
        self.watchSignals();
        while (!self.device.stopRequested()) {
            // Read the controller first: the host's next request arrives while
            // this waits, so each fresh state leaves in the same turn.
            if (self.imported) { try { self.device.pump(8); } catch (string error) { self.close(); throw error; } }
            struct pollfd watched[3];
            memset(watched, 0, sizeof(watched));
            watched[0].fd = self.signals; watched[0].events = POLLIN;
            watched[1].fd = self.listener; watched[1].events = POLLIN;
            watched[2].fd = self.client; watched[2].events = POLLIN;
            int ready = poll(watched, (nfds_t)(self.client >= 0 ? 3 : 2), self.imported ? 0 : 500);
            if (ready < 0 && errno != EINTR) { throw "Cannot wait for USB/IP clients"; }
            if (ready > 0 && ((int)watched[0].revents & POLLIN) != 0) { break; }
            if (ready > 0 && self.client >= 0 && (int)watched[2].revents != 0 && !(self.receive() && self.process())) {
                if (self.imported) { Console.error("deckpad: host detached"); }
                self.drop();
            }
            if (ready > 0 && ((int)watched[1].revents & POLLIN) != 0) { self.admit(); }
            if (self.imported && !self.flush()) { Console.error("deckpad: host detached"); self.drop(); }
        }
        self.close();
    }

    public void __del__() { self.close(); }
}
