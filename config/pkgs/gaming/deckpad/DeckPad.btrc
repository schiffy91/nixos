import Library.Bytes;
import Library.USB.USBDescriptors;
import Library.USB.USBHost;
import ./PadSource.btrc;
import ./PadState.btrc;

// The Steam Deck's built-in controller, read through Library.USB.
//
// While open, the kernel's HID driver is detached from the controller's three
// interfaces (keyboard, mouse, gamepad), so Steam and the desktop on the Deck
// stop seeing it, and the gamepad interface is read directly. close() and
// DeckPad.giveBack() hand it back.
class DeckPad implements IPadSource {
    private USBHostDevice? device = null;

    class int vendor() { return 0x28DE; }
    class int product() { return 0x1205; }

    // Give every interface back to the kernel's driver. Safe at any time: after
    // a crash the claims died with the process, and unclaiming rebinds.
    class void giveBack() {
        if (!USBHost.present(DeckPad.vendor(), DeckPad.product())) { return; }
        try {
            USBHostDevice pad = USBHostDevice.open(DeckPad.vendor(), DeckPad.product());
            for (int number = 0; number < 3; number++) { pad.unclaim(number); }
            pad.close();
        } catch (string error) {}
    }

    public void open() {
        if (self.device != null) { return; }
        USBHostDevice pad = USBHostDevice.open(DeckPad.vendor(), DeckPad.product());
        for (int number = 0; number < 3; number++) {
            if (!pad.claim(number)) {
                for (int taken = 0; taken <= number; taken++) { pad.unclaim(taken); }
                pad.close();
                throw "Cannot take the Steam Deck controller: another program holds it (is the service serving a host?)";
            }
        }
        self.device = pad;
        struct PadCommand command;
        DeckCommand.clearMappings(&command);
        self.command(&command);
        DeckCommand.gamepadSettings(&command);
        self.command(&command);
    }

    // One state report from interrupt endpoint 3, or false when none arrived in time.
    public bool read(struct PadState* state, int timeoutMilliseconds) {
        USBHostDevice? pad = self.device;
        if (pad == null) { return false; }
        Bytes report = Bytes();
        int received = pad.transferIn(3, 64, report, timeoutMilliseconds > 0 ? timeoutMilliseconds : 1);
        if (received == -ETIMEDOUT || received == -EINTR) { return false; }
        if (received < 0) { throw "The Steam Deck controller stopped answering"; }
        return DeckReport.parse((unsigned char*)report.data, received, state);
    }

    // SET_REPORT, feature report 0, on the gamepad interface.
    public void command(struct PadCommand* command) {
        USBHostDevice? pad = self.device;
        if (pad == null) { return; }
        Bytes report = Bytes.fromRaw((char*)command->bytes, command->length);
        while (report.length() < 64) { report.append(0); }
        pad.controlOut(USBSetup(0x21, 0x09, 0x0300, 2, 64), report, 500);
    }

    public void close() {
        USBHostDevice? pad = self.device;
        if (pad == null) { return; }
        struct PadCommand quiet;
        DeckCommand.rumble(&quiet, 0, 0);
        self.command(&quiet);
        for (int number = 0; number < 3; number++) { pad.unclaim(number); }
        pad.close();
        self.device = null;
    }

    public void __del__() { self.close(); }
}
