import ./Controller.btrc;

#include <poll.h>

// One way a host reaches the controller: the network, a USB cable, Bluetooth.
// A link owns its transport and how a host comes to be trusted on it; the
// service only waits on what the link gives it and lets it take its turn.
interface IControllerLink {
    string name();

    // Bring the link up, or throw why it cannot work on this machine.
    void open();

    // Fill `descriptors` with what to wait on before the next step; the number filled.
    int watch(struct pollfd* descriptors, int capacity);

    // Do what is due without blocking.
    void step();

    // Whether a host is using the controller through this link right now.
    bool attached();

    // The controller as this link presents it.
    ControllerPort port();

    // One line about the link's state, for people.
    string status();

    void close();
}
