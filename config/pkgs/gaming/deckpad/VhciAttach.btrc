import Library.Console;
import Library.FileSystem;
import Library.Strings;
import Library.Timer;
import Library.Vector;
import ./Native.btrc;
import ./SteamController.btrc;
import ./UsbIpServer.btrc;
import ./Wire.btrc;

struct VhciImport {
    int socket;
    long long deviceId;
    int speed;
};

// The host side: import the controller from a deckpad server and hand the
// connection to the kernel's vhci_hcd, which then presents a USB device. This
// is what `usbip attach` does, without needing the usbip tools.
class VhciAttach {
    class string controller() { return "/sys/devices/platform/vhci_hcd.0"; }

    class bool writeAttribute(string path, string value) {
        int descriptor = open(path, (int)O_WRONLY | (int)O_CLOEXEC);
        if (descriptor < 0) { return false; }
        int length = value.length();
        bool written = (int)write(descriptor, value, (size_t)length) == length;
        close(descriptor);
        return written;
    }

    class void timeouts(int descriptor, int seconds) {
        struct timeval limit;
        limit.tv_sec = (time_t)seconds;
        limit.tv_usec = 0;
        setsockopt(descriptor, SOL_SOCKET, SO_RCVTIMEO, &limit, sizeof(limit));
        setsockopt(descriptor, SOL_SOCKET, SO_SNDTIMEO, &limit, sizeof(limit));
    }

    class int connectTo(string host, int port) {
        struct addrinfo hints;
        memset(&hints, 0, sizeof(hints));
        hints.ai_family = AF_INET;
        hints.ai_socktype = SOCK_STREAM;
        struct addrinfo* found = NULL;
        var service = f"{port}";
        if (getaddrinfo(host, service, &hints, &found) != 0 || found == NULL) { throw f"Cannot resolve {host}"; }
        int descriptor = socket(AF_INET, SOCK_STREAM, 0);
        if (descriptor >= 0) { VhciAttach.timeouts(descriptor, 3); }
        bool connected = descriptor >= 0 && connect(descriptor, found->ai_addr, found->ai_addrlen) == 0;
        freeaddrinfo(found);
        if (!connected) {
            if (descriptor >= 0) { close(descriptor); }
            throw f"Cannot reach {host}:{port}";
        }
        return descriptor;
    }

    class bool exchange(int descriptor, unsigned char* request, int requestLength, unsigned char* reply, int replyLength) {
        if (send(descriptor, request, (size_t)requestLength, MSG_NOSIGNAL) != (ssize_t)requestLength) { return false; }
        int received = 0;
        while (received < replyLength) {
            ssize_t count = recv(descriptor, reply + received, (size_t)(replyLength - received), 0);
            if (count <= (ssize_t)0) { return false; }
            received += (int)count;
        }
        return true;
    }

    // Ask the server for its controller. The returned socket carries USB traffic.
    class void importDevice(string host, int port, struct VhciImport* imported) {
        int descriptor = VhciAttach.connectTo(host, port);
        unsigned char request[40];
        unsigned char reply[320];
        memset(request, 0, sizeof(request));
        UsbIpWire.operation(request, USBIP_REQUEST_IMPORT, 0);
        memcpy(request + 8, UsbIpWire.busId(), (size_t)UsbIpWire.busId().length());
        bool answered = VhciAttach.exchange(descriptor, request, 40, reply, 8) && Wire.u16be(reply, 2) == USBIP_REPLY_IMPORT &&
            Wire.u32be(reply, 4) == 0LL && VhciAttach.exchange(descriptor, request, 0, reply + 8, USBIP_DEVICE);
        if (!answered || Wire.u16be(reply, 308) != STEAM_VENDOR || Wire.u16be(reply, 310) != STEAM_PRODUCT) {
            close(descriptor);
            throw f"{host}:{port} did not offer a controller";
        }
        // The kernel reads this socket from now on: no timeouts, no batching.
        int yes = 1;
        VhciAttach.timeouts(descriptor, 0);
        setsockopt(descriptor, IPPROTO_TCP, TCP_NODELAY, &yes, sizeof(yes));
        setsockopt(descriptor, SOL_SOCKET, SO_KEEPALIVE, &yes, sizeof(yes));
        imported->socket = descriptor;
        imported->deviceId = (Wire.u32be(reply, 296) << 16) | Wire.u32be(reply, 300);
        imported->speed = (int)Wire.u32be(reply, 304);
    }

    // Rows of vhci's status table: hub, port, state, speed, device, socket, bus id.
    class Vector<Vector<string>> ports() {
        Vector<Vector<string>> rows = [];
        var path = VhciAttach.controller() + "/status";
        if (!FileSystem.exists(path)) { throw "vhci_hcd is not loaded (modprobe vhci-hcd)"; }
        for line in Strings.split(Path.readAll(path), "\n") {
            Vector<string> fields = [];
            for field in Strings.split(line, " ") { if (!field.isEmpty()) { fields.push(field); } }
            if (fields.len >= 7 && (fields.get(0).equals("hs") || fields.get(0).equals("ss"))) { rows.push(fields); }
        }
        return rows;
    }

    // State 004 is a free port; USB 2 devices go on the high-speed hub.
    class int freePort() {
        for row in VhciAttach.ports() {
            if (row.get(0).equals("hs") && row.get(2).equals("004")) { return Strings.toInt(row.get(1)); }
        }
        throw "No free vhci_hcd port";
    }

    class bool busy(int port) {
        for row in VhciAttach.ports() {
            if (row.get(0).equals("hs") && Strings.toInt(row.get(1)) == port) { return !row.get(2).equals("004"); }
        }
        return false;
    }

    class int attach(string host, int port) {
        struct VhciImport imported;
        VhciAttach.importDevice(host, port, &imported);
        int local = -1;
        string failure = "";
        try {
            local = VhciAttach.freePort();
            if (!VhciAttach.writeAttribute(VhciAttach.controller() + "/attach", f"{local} {imported.socket} {imported.deviceId} {imported.speed}")) {
                failure = "vhci_hcd refused the controller (root is required)";
            }
        } catch (string error) { failure = error; }
        close(imported.socket);
        if (!failure.isEmpty()) { throw failure; }
        return local;
    }

    // Detach every vhci port that holds one of our controllers.
    class int detach() {
        int detached = 0;
        for row in VhciAttach.ports() {
            if (row.get(2).equals("004")) { continue; }
            var device = "/sys/bus/usb/devices/" + row.get(6);
            string vendor = "";
            string product = "";
            try { vendor = Path.readAll(device + "/idVendor").trim(); product = Path.readAll(device + "/idProduct").trim(); } catch (string error) { continue; }
            if (vendor.equals("28de") && product.equals("1302") && VhciAttach.writeAttribute(VhciAttach.controller() + "/detach", row.get(1))) { detached++; }
        }
        return detached;
    }

    // Attach once, or with `watch` keep the controller attached whenever the
    // server offers it, retrying every two seconds.
    class void run(string host, int port, bool watch) {
        while (true) {
            try {
                int local = VhciAttach.attach(host, port);
                Console.error(f"deckpad: {host} attached on vhci port {local}");
                if (!watch) { return; }
                while (VhciAttach.busy(local)) { Timer.sleepMillis(1000); }
                Console.error(f"deckpad: {host} detached");
            } catch (string error) {
                if (!watch) { throw error; }
            }
            Timer.sleepMillis(2000);
        }
    }
}
