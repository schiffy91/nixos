import Library.FileSystem;
import Library.Strings;
import Library.Timer;
import ./Native.btrc;
import ./PadSource.btrc;
import ./PadState.btrc;
import ./SteamController.btrc;

// One HID report, starting with its report ID.
struct HidReport {
    unsigned char bytes[64];
    int length;
};

// The first battery the kernel reports; a host without one reads as full.
class DeckBattery {
    class string attribute(string path) {
        try { return Path.readAll(path).trim(); } catch (string error) { return ""; }
    }

    class string find() {
        var root = "/sys/class/power_supply";
        if (!FileSystem.isDir(root)) { return ""; }
        for name in FileSystem.listDir(root) {
            if (DeckBattery.attribute(f"{root}/{name}/type").equals("Battery")) { return f"{root}/{name}"; }
        }
        return "";
    }

    class int percent(string battery) {
        var text = battery.isEmpty() ? "" : DeckBattery.attribute(battery + "/capacity");
        return text.isEmpty() || !text.isDigit() ? 100 : Strings.toInt(text);
    }

    class bool charging(string battery) {
        var status = battery.isEmpty() ? "" : DeckBattery.attribute(battery + "/status");
        return status.equals("Charging") || status.equals("Full");
    }
}

// The emulated controller, in HID terms only: input reports out, output and
// feature reports in. It knows nothing about how a host reaches it; every link
// (USB/IP, a USB gadget, Bluetooth) talks to this one object.
class VirtualController {
    private IPadSource source;
    private SteamController identity;
    private PadLatch latch;
    private bool sendQuickAccess;
    private bool active = false;
    private bool stop = false;
    private long long quickAccessSince = 0LL;
    private int wantedLeft = 0;
    private int wantedRight = 0;
    private int appliedLeft = 0;
    private int appliedRight = 0;
    private long long rumbleSentAt = 0LL;
    private long long rumbleExpiresAt = 0LL;
    private long long batteryDueAt = 0LL;
    private bool batteryPending = false;
    private string battery = "";

    public VirtualController(IPadSource source, SteamController identity, bool sendQuickAccess) {
        self.source = source;
        self.identity = identity;
        self.latch = PadLatch();
        self.sendQuickAccess = sendQuickAccess;
    }

    // The controller the host believes it is talking to.
    public SteamController personality() { return self.identity; }

    public bool attached() { return self.active; }

    // Holding the Deck's ... button for two seconds asks the service to stop.
    public bool stopRequested() { return self.stop; }

    // A host attached: take the pad. Only one link holds it at a time.
    public void attach() {
        if (self.active) { throw "The controller is already in use"; }
        self.source.open();
        self.active = true;
        self.battery = DeckBattery.find();
        self.batteryDueAt = 0LL;
        self.quickAccessSince = 0LL;
        self.wantedLeft = 0; self.wantedRight = 0; self.appliedLeft = 0; self.appliedRight = 0;
    }

    // The host left: give the pad back.
    public void detach() {
        if (!self.active) { return; }
        self.active = false;
        self.source.close();
    }

    // Read the pad for at most the timeout and run the rumble and battery timers.
    public void pump(int timeoutMilliseconds) {
        if (!self.active) { return; }
        struct PadState state;
        long long now = MonotonicClock.milliseconds();
        if (self.source.read(&state, timeoutMilliseconds)) {
            now = MonotonicClock.milliseconds();
            if ((state.buttons & PAD_QUICK_ACCESS) != 0) {
                if (self.quickAccessSince == 0LL) { self.quickAccessSince = now; }
                else if (now - self.quickAccessSince >= 2000LL) { self.stop = true; }
            } else { self.quickAccessSince = 0LL; }
            if (!self.sendQuickAccess) { state.buttons &= ~PAD_QUICK_ACCESS; }
            self.latch.update(&state);
        }
        if (self.rumbleExpiresAt != 0LL && now >= self.rumbleExpiresAt) {
            self.wantedLeft = 0; self.wantedRight = 0; self.rumbleExpiresAt = 0LL;
        }
        // The pad gets overloaded by rapid rumble commands; Steam and the kernel
        // driver throttle them to 20 Hz, always applying the latest values.
        if ((self.wantedLeft != self.appliedLeft || self.wantedRight != self.appliedRight) && now - self.rumbleSentAt >= 50LL) {
            struct PadCommand command;
            DeckCommand.rumble(&command, self.wantedLeft, self.wantedRight);
            self.source.command(&command);
            self.appliedLeft = self.wantedLeft; self.appliedRight = self.wantedRight; self.rumbleSentAt = now;
        }
        if (now >= self.batteryDueAt) { self.batteryPending = true; self.batteryDueAt = now + 5000LL; }
    }

    // The next input report, when one is due. The battery report goes first: it
    // is due every five seconds, and a state is nearly always waiting.
    public bool input(struct HidReport* report) {
        if (self.batteryPending) {
            self.batteryPending = false;
            report->length = self.identity.encodeBattery(DeckBattery.percent(self.battery), DeckBattery.charging(self.battery), report->bytes);
            return true;
        }
        if (!self.latch.pending()) { return false; }
        struct PadState state;
        self.latch.take(&state);
        report->length = self.identity.encodeState(&state, MonotonicClock.nanoseconds() / 1000LL, report->bytes);
        return true;
    }

    private void apply(struct HostEffect* effect) {
        if (effect->kind == HOST_EFFECT_RUMBLE) {
            self.wantedLeft = effect->left;
            self.wantedRight = effect->right;
            // The real controller stops about 50 ms after the last rumble report
            // and hosts repeat it while it should run; allow for link jitter.
            self.rumbleExpiresAt = effect->left != 0 || effect->right != 0 ? MonotonicClock.milliseconds() + 500LL : 0LL;
        } else if (effect->kind == HOST_EFFECT_HAPTIC && self.active) {
            self.source.command(&effect->command);
        }
    }

    // An output report from the host.
    public void output(unsigned char* data, int length) {
        struct HostEffect effect;
        self.identity.outputEffect(data, length, &effect);
        self.apply(&effect);
    }

    // The host wrote a feature report. False when the controller has no such report.
    public bool setFeature(unsigned char* data, int length) {
        if (length < 1 || (int)data[0] != STEAM_REPORT_FEATURE) { return false; }
        struct HostEffect effect;
        self.identity.setFeature(data, length);
        self.identity.featureEffect(data, length, &effect);
        self.apply(&effect);
        return true;
    }

    // The host reads a feature report: its length, or -1 when there is no such report.
    public int feature(int report, unsigned char* out) {
        return report == STEAM_REPORT_FEATURE ? self.identity.getFeature(out) : -1;
    }
}
