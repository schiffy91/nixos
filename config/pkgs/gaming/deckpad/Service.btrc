import Library.Console;
import Library.FileSystem;
import Library.Timer;
import Library.Vector;
import ./Controller.btrc;
import ./Link.btrc;

#include <errno.h>
#include <poll.h>
#include <signal.h>
#include <string.h>

// Something else the service's loop looks after between turns, such as the
// control interface.
interface IServiceTask {
    int watch(struct pollfd* descriptors, int capacity);
    void step();
    void close();
}

// Told, turn after turn, while someone is playing on the pad.
interface IPadUseListener {
    void used(long long now);
    void close();
}

// Runs the controller behind every link that came up. While no host is
// attached it sleeps on the links' descriptors; once one attaches, each turn
// reads the pad and lets the links move reports. The first host to attach, on
// any link, holds the controller until it leaves; then the next one may.
class ControllerService {
    private VirtualController controller;
    private Vector<IControllerLink> links = [];
    private Vector<IServiceTask> tasks = [];
    private IPadUseListener? player = null;
    private int holder = -1;
    private string runtime = "";
    private long long retryAt = 0LL;
    private bool stopped = false;

    public ControllerService(VirtualController controller) { self.controller = controller; }

    public void add(IControllerLink link) { self.links.push(link); }

    public void attend(IServiceTask task) { self.tasks.push(task); }

    // Who to tell while the pad is in use: within a minute of its last use.
    public void tell(IPadUseListener player) { self.player = player; }

    public Vector<IControllerLink> all() { return self.links; }

    // The link whose host holds the controller; empty when none does.
    public string holding() { return self.holder >= 0 ? self.links.get(self.holder).name() : ""; }

    public void stop() { self.stopped = true; }

    // While a host holds the controller, the directory holds a file named for
    // its link (`usb-host`), for programs that act differently for that long.
    public void announceIn(string directory) { self.runtime = directory; }

    private void announce(bool held) {
        if (self.runtime.isEmpty() || self.holder < 0) { return; }
        string marker = f"{self.runtime}/{self.links.get(self.holder).name()}-host";
        if (held) { Path.writeAll(marker, "\n"); } else { FileSystem.removeRecursive(marker); }
    }

    // Bring up every link that can work here. One that cannot says why and is
    // left out; the service needs at least one.
    public void open() {
        Vector<IControllerLink> up = [];
        for link in self.links {
            try {
                link.open();
                up.push(link);
            } catch (string error) { Console.error(f"deckpad: no {link.name()} link: {error}"); }
        }
        self.links = up;
        if (up.len == 0) { throw "No link to serve the controller on"; }
    }

    public void close() {
        self.letGo();
        for link in self.links { link.close(); }
        for task in self.tasks { task.close(); }
        IPadUseListener? player = self.player;
        if (player != null) { player.close(); }
        self.player = null;
    }

    private void letGo() {
        if (self.holder < 0) { return; }
        self.announce(false);
        self.links.get(self.holder).port().hold(false);
        self.controller.detach();
        self.holder = -1;
    }

    // Take the Deck's controls for the host; when they cannot be taken yet,
    // try again every second while the host stays.
    private void take() {
        if (self.controller.attached() || MonotonicClock.milliseconds() < self.retryAt) { return; }
        try { self.controller.attach(); } catch (string error) {
            Console.error(f"deckpad: {error}");
            self.retryAt = MonotonicClock.milliseconds() + 1000LL;
        }
    }

    private void arbitrate() {
        if (self.holder >= 0 && !self.links.get(self.holder).attached()) { self.letGo(); }
        for (int index = 0; index < self.links.len && self.holder < 0; index++) {
            if (!self.links.get(index).attached()) { continue; }
            self.holder = index;
            self.retryAt = 0LL;
            self.links.get(index).port().hold(true);
            self.announce(true);
            Console.error(f"deckpad: the {self.links.get(index).name()} link holds the controller");
        }
        if (self.holder >= 0) { self.take(); }
    }

    // Stop signals are held back and looked for each turn, so one never cuts
    // a transfer short.
    private void blockSignals() {
        sigset_t stopping;
        sigemptyset(&stopping);
        sigaddset(&stopping, (int)SIGINT);
        sigaddset(&stopping, (int)SIGTERM);
        if (sigprocmask((int)SIG_BLOCK, &stopping, NULL) != 0) { throw "Cannot hold back stop signals"; }
    }

    private bool signalled() {
        sigset_t pending;
        sigemptyset(&pending);
        return sigpending(&pending) == 0 && (sigismember(&pending, (int)SIGINT) == 1 || sigismember(&pending, (int)SIGTERM) == 1);
    }

    // One turn. False once the service should stop.
    public bool turn(int idleMilliseconds) {
        // Read the pad first: the host's next request arrives while this
        // waits, so each fresh state leaves in the same turn. A report ends
        // the wait at once, so its length only matters when the pad is
        // late: several of the pad's 4 ms report periods, because a wait as
        // short as one period cancels transfers that are about to complete.
        self.controller.pump(20);
        IPadUseListener? player = self.player;
        if (player != null && self.controller.attached() && self.controller.usedAt() != 0LL) {
            long long now = MonotonicClock.milliseconds();
            if (now - self.controller.usedAt() < 60000LL) { player.used(now); }
        }
        struct pollfd watched[48];
        memset(watched, 0, sizeof(watched));
        int count = 0;
        for link in self.links { count += link.watch(watched + count, 48 - count); }
        for task in self.tasks { count += task.watch(watched + count, 48 - count); }
        int ready = poll(watched, (nfds_t)count, self.controller.attached() ? 0 : idleMilliseconds);
        if (ready < 0 && errno != EINTR) { throw "Cannot wait for hosts"; }
        for link in self.links { link.step(); }
        for task in self.tasks { task.step(); }
        self.arbitrate();
        return !self.stopped && !self.signalled() && !self.controller.stopRequested();
    }

    // Serve until a stop signal arrives, the control interface says stop, or
    // the Deck's stop chord is held.
    public void run() {
        self.blockSignals();
        try {
            self.open();
            while (self.turn(250)) {}
        } catch (string error) {
            self.close();
            throw error;
        }
        self.close();
    }
}
