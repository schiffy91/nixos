import ./Native.btrc;

// An outgoing TCP connection, owned until it is closed or handed on.
class LanStream {
    private int connection = -1;

    public LanStream(string host, int port) {
        struct addrinfo hints;
        memset(&hints, 0, sizeof(hints));
        hints.ai_family = AF_INET;
        hints.ai_socktype = SOCK_STREAM;
        struct addrinfo* found = NULL;
        var service = f"{port}";
        if (getaddrinfo(host, service, &hints, &found) != 0 || found == NULL) { throw f"Cannot resolve {host}"; }
        self.connection = socket(AF_INET, SOCK_STREAM, 0);
        if (self.connection >= 0) { self.timeouts(3); }
        bool connected = self.connection >= 0 && connect(self.connection, found->ai_addr, found->ai_addrlen) == 0;
        freeaddrinfo(found);
        if (!connected) {
            self.close();
            throw f"Cannot reach {host}:{port}";
        }
    }

    public int descriptor() { return self.connection; }

    // How long a send or receive may wait; zero waits for ever.
    public void timeouts(int seconds) {
        struct timeval limit;
        limit.tv_sec = (time_t)seconds;
        limit.tv_usec = 0;
        setsockopt(self.connection, SOL_SOCKET, SO_RCVTIMEO, &limit, sizeof(limit));
        setsockopt(self.connection, SOL_SOCKET, SO_SNDTIMEO, &limit, sizeof(limit));
    }

    // Small writes leave at once, and a dead peer is noticed.
    public void interactive() {
        int yes = 1;
        setsockopt(self.connection, IPPROTO_TCP, TCP_NODELAY, &yes, sizeof(yes));
        setsockopt(self.connection, SOL_SOCKET, SO_KEEPALIVE, &yes, sizeof(yes));
    }

    // Send a request and read exactly the reply. Either length may be zero.
    public bool exchange(unsigned char* request, int requestLength, unsigned char* reply, int replyLength) {
        if (send(self.connection, request, (size_t)requestLength, MSG_NOSIGNAL) != (ssize_t)requestLength) { return false; }
        int received = 0;
        while (received < replyLength) {
            ssize_t count = recv(self.connection, reply + received, (size_t)(replyLength - received), 0);
            if (count <= (ssize_t)0) { return false; }
            received += (int)count;
        }
        return true;
    }

    public void close() { if (self.connection >= 0) { close(self.connection); self.connection = -1; } }

    public void __del__() { self.close(); }
}
