import Library.FileSystem;
import Library.Strings;
import Library.Vector;
import ./Native.btrc;

// The kernel's virtual USB host controller, vhci_hcd: give it a connected
// USB/IP socket and it presents the device at the other end as a USB device.
class VhciPort {
    class string controller() { return "/sys/devices/platform/vhci_hcd.0"; }

    // Sysfs attributes need one plain write; an atomic replace does not work there.
    class bool writeAttribute(string path, string value) {
        int descriptor = open(path, (int)O_WRONLY | (int)O_CLOEXEC);
        if (descriptor < 0) { return false; }
        int length = value.length();
        bool written = (int)write(descriptor, value, (size_t)length) == length;
        close(descriptor);
        return written;
    }

    // Rows of vhci's status table: hub, port, state, speed, device, socket, bus id.
    class Vector<Vector<string>> ports() {
        Vector<Vector<string>> rows = [];
        var path = VhciPort.controller() + "/status";
        if (!FileSystem.exists(path)) { throw "vhci_hcd is not loaded (modprobe vhci-hcd)"; }
        for line in Strings.split(Path.readAll(path), "\n") {
            Vector<string> fields = [];
            for field in Strings.split(line, " ") { if (!field.isEmpty()) { fields.push(field); } }
            if (fields.len >= 7 && (fields.get(0).equals("hs") || fields.get(0).equals("ss"))) { rows.push(fields); }
        }
        return rows;
    }

    // State 004 is a free port; USB 2 devices go on the high-speed hub.
    class int freePort() {
        for row in VhciPort.ports() {
            if (row.get(0).equals("hs") && row.get(2).equals("004")) { return Strings.toInt(row.get(1)); }
        }
        throw "No free vhci_hcd port";
    }

    class bool busy(int port) {
        for row in VhciPort.ports() {
            if (row.get(0).equals("hs") && Strings.toInt(row.get(1)) == port) { return !row.get(2).equals("004"); }
        }
        return false;
    }

    // Hand a connected socket to the kernel; the port it was attached to. The
    // kernel keeps its own reference, so the caller still closes the descriptor.
    class int attach(int socket, long long deviceId, int speed) {
        int port = VhciPort.freePort();
        if (!VhciPort.writeAttribute(VhciPort.controller() + "/attach", f"{port} {socket} {deviceId} {speed}")) {
            throw "vhci_hcd refused the controller (root is required)";
        }
        return port;
    }

    // Detach every port that holds a device with this identity; how many.
    class int detach(string vendor, string product) {
        int detached = 0;
        for row in VhciPort.ports() {
            if (row.get(2).equals("004")) { continue; }
            var device = "/sys/bus/usb/devices/" + row.get(6);
            string foundVendor = "";
            string foundProduct = "";
            try { foundVendor = Path.readAll(device + "/idVendor").trim(); foundProduct = Path.readAll(device + "/idProduct").trim(); } catch (string error) { continue; }
            if (foundVendor.equals(vendor) && foundProduct.equals(product) && VhciPort.writeAttribute(VhciPort.controller() + "/detach", row.get(1))) { detached++; }
        }
        return detached;
    }
}
