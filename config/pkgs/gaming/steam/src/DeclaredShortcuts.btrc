import Library.Bytes;
import Library.Digest;
import Library.FileSystem;
import Library.JSON;
import Library.Steam.SteamShortcuts;
import Library.Vector;
import ../../lib/ModTree.btrc;
import ./SteamLibrary.btrc;

class DeclaredShortcuts {  // the shortcuts this configuration declares; the file itself is Library.Steam's
    class string executable(JSONValue shortcut) {
        return shortcut.isObject() ? shortcut.get("exe").asString() : shortcut.asString();
    }

    class SteamShortcuts declare(Bytes current, JSONValue declared, string machine = "") {  // every other entry stays as it is
        var shortcuts = SteamShortcuts.parse(current);
        for name in declared.keys().sorted() {
            var shortcut = declared.get(name);
            var entry = shortcuts.ensure(name, DeclaredShortcuts.executable(shortcut), "", machine);
            if (shortcut.isObject() && !shortcut.get("icon").asString().isEmpty()) { entry.setIcon(shortcut.get("icon").asString()); }
        }
        return shortcuts;
    }

    class void pictures(SteamShortcut entry, string grid, string artwork) {
        var legacyPath = f"{artwork}/legacy.json";
        var legacy = FileSystem.isFile(legacyPath) ? JSONValue.parse(Path.readAll(legacyPath)) : JSONValue.makeObject();
        Vector<SteamPicture> kinds = [STEAM_PICTURE_PORTRAIT, STEAM_PICTURE_LANDSCAPE, STEAM_PICTURE_HERO, STEAM_PICTURE_LOGO];
        var filenames = ["p", "landscape", "_hero", "_logo"];
        for (int index = 0; index < kinds.len; index++) {
            var target = entry.picture(grid, kinds.get(index));
            var filename = filenames.get(index);
            var source = f"{artwork}/{filename}.png";
            var record = f"{grid}/.nixos-artwork/{PathTools.basename(target)}.sha256";
            // Only our unchanged defaults may be upgraded. Artwork tools and
            // Steam can replace files in place or choose another extension.
            var custom = false;
            for extension in ["jpg", "jpeg", "webp"] {
                if (FileSystem.exists(f"{target}.{extension}")) { custom = true; }
            }
            if (custom) { continue; }
            if (FileSystem.exists(f"{target}.png")) {
                var digest = SHA256.digestBytes(ModTree.read(f"{target}.png"));
                var previous = FileSystem.isFile(record) ? Path.readAll(record).trim() : "";
                if (!digest.equals(previous) && !digest.equals(legacy.get(filename).asString())) { continue; }
                if (ModTree.read(source).equals(ModTree.read(f"{target}.png"))) { continue; }
            }
            ModTree.copy(source, f"{target}.png");
            ModTree.write(record, SHA256.digestBytes(ModTree.read(source)));
        }
    }

    class void install(SteamLibrary library, JSONValue declared, string machine = "") {
        if (library.root.isEmpty() || !declared.isObject()) { throw "Required: --steam-path PATH --shortcuts JSON"; }
        for path in SteamShortcuts.files(library.root) {
            var current = FileSystem.isFile(path) ? ModTree.read(path) : Bytes();
            var shortcuts = DeclaredShortcuts.declare(current, declared, machine);
            for name in declared.keys() {
                var shortcut = declared.get(name);
                SteamShortcut? found = shortcuts.find(name);
                if (found == null || !shortcut.isObject() || shortcut.get("artwork").asString().isEmpty()) { continue; }
                SteamShortcut entry = found;
                if (entry.id != 0) { DeclaredShortcuts.pictures(entry, SteamShortcuts.pictures(path), shortcut.get("artwork").asString()); }
            }
            var desired = shortcuts.render();
            if (!desired.equals(current)) { ModTree.writeBytes(path, desired); }
        }
    }
}
