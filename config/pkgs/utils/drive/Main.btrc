import Library.CLI;
import Library.Console;
import Library.Platform;
import Library.Vector;
import Library.Strings;
import Library.Process;
import Library.Map;
import Library.Timer;

#include <stdio.h>

import Library.FileSystem;
import Library.FileSystem.IUserspaceFileSystem;
import Library.FileSystem.Userspace;

import ./auth/Login.btrc;
import ./door/Channel.btrc;
import ./door/Door.btrc;
import ./engine/Engine.btrc;
import ./engine/Mirror.btrc;
import ./push/Push.btrc;
import ./remote/DriveApi.btrc;
import ./remote/DriveFile.btrc;
import ./remote/Transport.btrc;
import ./store/Store.btrc;

class Drive {
    class DriveApi api(CLICommandLine options) {
        string home = Environment.get("HOME", "");
        DriveCredentials? credentials = null;
        if (options.has("--rclone")) { credentials = DriveCredentials.fromRclone(options.option("--rclone", ""), options.option("--remote", "gdrive")); }
        else { credentials = DriveCredentials.load(options.option("--credentials", f"{home}/.config/drive/credentials.json")); }
        if (credentials == null) { throw "No Drive sign-in found (see --credentials and --rclone)"; }
        DriveApi api = DriveApi(Transport(options.option("--scratch", Environment.get("XDG_RUNTIME_DIR", "/tmp") + "/drive-transport")), credentials);
        if (options.has("--api")) {
            api.apiBase = options.option("--api", "");
            api.tokenUrl = api.apiBase + "/token";
        }
        return api;
    }

    class string why(DriveApi api) {
        DriveError? failure = api.failure;
        return failure == null ? "no reason given" : failure.describe();
    }

    // Read-only looks at the Drive, for checking a sign-in and timing the API.
    class void remote(CLICommandLine options) {
        DriveApi api = Drive.api(options);
        string what = options.operand(1, "root");
        long long started = MonotonicClock.milliseconds();
        if (what.equals("root")) {
            string? root = api.rootId();
            if (root == null) { throw f"Cannot reach the Drive: {Drive.why(api)}"; }
            Console.log(f"root folder {root}");
        } else if (what.equals("list")) {
            int pages = options.option("--pages", "0").toInt();
            int files = 0;
            int folders = 0;
            int documents = 0;
            int orphans = 0;
            long long bytes = 0LL;
            string token = "";
            int read = 0;
            while (pages == 0 || read < pages) {
                DriveListing? page = api.list(token);
                if (page == null) { throw f"The listing stopped: {Drive.why(api)}"; }
                read++;
                for file in page.files {
                    if (file.parent.isEmpty()) { orphans++; }
                    if (file.isFolder()) { folders++; }
                    else if (file.isDocument()) { documents++; }
                    else {
                        files++;
                        bytes += file.size;
                    }
                }
                token = page.next;
                if (token.isEmpty()) { break; }
            }
            Console.log(f"{read} pages: {files} files ({bytes} bytes), {folders} folders, {documents} Google documents, {orphans} outside the tree{token.isEmpty() ? "" : ", more to read"}");
        } else if (what.equals("changes")) {
            string? start = options.has("--from") ? options.option("--from", "") : api.startToken();
            if (start == null) { throw f"The change feed gave no position: {Drive.why(api)}"; }
            DriveChanges? page = api.changes(start);
            if (page == null) { throw f"The change feed stopped: {Drive.why(api)}"; }
            Console.log(f"from {start}: {page.changes.len} changes, resume at {page.resume.isEmpty() ? page.next : page.resume}");
        } else {
            throw "usage: drive remote root|list [--pages N]|changes [--from POSITION]";
        }
        Console.log(f"took {MonotonicClock.milliseconds() - started} ms");
    }

    // This machine's name, for what is made in its name: its subscription, the copies it sets aside.
    class string machine() {
        string name = FileSystem.readText("/proc/sys/kernel/hostname").trim();
        return name.isEmpty() ? "this-machine" : name;
    }

    class string runtime(CLICommandLine options) { return options.option("--runtime", Environment.get("DRIVE_RUNTIME", Environment.get("XDG_RUNTIME_DIR", "/run") + "/drive")); }

    // The mount: forwards to the store's tree and asks the engine for what is not downloaded.
    class void door(CLICommandLine options) {
        string store = options.option("--store", "");
        string directory = options.option("--mount", "");
        if (store.isEmpty() || directory.isEmpty()) { throw "usage: drive door --store DIR --mount DIR [--runtime DIR] [--allow-others]"; }
        FileSystem.mkdirp(Drive.runtime(options));
        Door door = Door(store, Drive.runtime(options) + "/door.sock");
        door.readOnly = options.has("--read-only");
        door.unguarded = options.has("--unguarded");
        for declared in options.values("--place") {
            if (!door.volumes.place(declared)) { throw f"--place wants PATH=LOCATION, not {declared}"; }
        }
        for declared in options.values("--place-device") {
            if (!door.volumes.require(declared)) { throw f"--place-device wants LOCATION=DEVICE for a placed location, not {declared}"; }
        }
        UserspaceOptions mounting = UserspaceOptions();
        mounting.name = "drive";
        mounting.passthrough = true;
        mounting.allowOthers = options.has("--allow-others");
        UserspaceMount mount = Userspace.mount(door, directory, mounting);
        Console.log("READY");
        fflush(stdout);
        door.serve(mount);
    }

    // Bring a store in line with the Drive once: all of it the first time, what changed after that.
    class void mirror(CLICommandLine options) {
        string path = options.option("--store", "");
        if (path.isEmpty()) { throw "usage: drive mirror --store DIR"; }
        Store store = Store(path);
        store.scan();
        Mirror mirror = Mirror(Drive.api(options), store);
        long long started = MonotonicClock.milliseconds();
        if (store.position().isEmpty()) { mirror.build(); }
        else if (!mirror.follow()) { throw "The Drive cannot be reached"; }
        Console.log(f"{store.added} added, {store.changed} changed, {store.removed} removed, {store.skipped} outside the tree, {store.folderCount()} folders, in {(MonotonicClock.milliseconds() - started) / 1000LL} s");
    }

    // The part that talks to the Drive.
    class void engine(CLICommandLine options) {
        string store = options.option("--store", "");
        if (store.isEmpty()) { throw "usage: drive engine --store DIR [--runtime DIR] [--chunk BYTES] [--follow SECONDS]"; }
        Engine engine = Engine(Drive.api(options), Store(store), Drive.runtime(options) + "/door.sock");
        engine.chunk = options.option("--chunk", "4194304").toLong();
        engine.followSeconds = options.option("--follow", "30").toInt();
        if (engine.chunk < 4096LL || engine.chunk % 4096LL != 0LL) { throw "--chunk must be a multiple of 4096"; }
        engine.readers.budgetFiles = options.option("--budget-files", "20").toInt();
        engine.readers.budgetBytes = options.option("--budget-bytes", "268435456").toLong();
        for path in options.values("--deny-file") { engine.readers.deny(path); }
        for name in options.values("--deny") { engine.readers.denied.push(name); }
        engine.askCommand = options.option("--ask", "");
        engine.askSeconds = options.option("--ask-seconds", "60").toInt();
        for declared in options.values("--place") {
            if (!engine.places(declared)) { throw f"--place wants PATH=LOCATION, not {declared}"; }
        }
        for declared in options.values("--place-device") {
            if (!engine.requires(declared)) { throw f"--place-device wants LOCATION=DEVICE for a placed location, not {declared}"; }
        }
        for pin in options.values("--pin") { engine.pins.push(pin); }
        engine.cacheBytes = options.option("--cache-bytes", "0").toLong();
        engine.freeFloor = options.option("--free-floor", "0").toLong();
        engine.uploader.machine = options.option("--machine", Drive.machine());
        for pattern in options.values("--ignore") { engine.uploader.ignored.push(pattern); }
        engine.uploader.quietSeconds = options.option("--quiet", "5").toInt();
        engine.uploader.deleteLimit = options.option("--delete-limit", "50").toInt();
        engine.uploader.overwriteConflicts = options.has("--overwrite-conflicts");
        engine.following().deleteLimit = engine.uploader.deleteLimit;
        Console.log("READY");
        fflush(stdout);
        engine.run();
    }

    // Sign in through a browser and keep the result. The OAuth client comes from an earlier sign-in or from rclone's.
    class void auth(CLICommandLine options) {
        string home = Environment.get("HOME", "");
        string path = options.option("--credentials", f"{home}/.config/drive/credentials.json");
        DriveCredentials? client = options.has("--rclone") ? DriveCredentials.fromRclone(options.option("--rclone", ""), options.option("--remote", "gdrive")) : DriveCredentials.load(path);
        if (client == null) { throw "No OAuth client found: pass --rclone FILE to take rclone's"; }
        Vector<string> scopes = ["https://www.googleapis.com/auth/drive", "https://www.googleapis.com/auth/pubsub"];
        for extra in options.values("--scope") { scopes.push(extra); }
        Transport transport = Transport(options.option("--scratch", Environment.get("XDG_RUNTIME_DIR", "/tmp") + "/drive-transport"));
        DriveCredentials granted = Login.run(client, scopes, transport, options.option("--port", "53683").toInt(), options.option("--wait", "300").toInt());
        FileSystem.mkdirp(PathTools.dirname(path));
        Login.save(granted, path);
        Console.log(f"Signed in; kept in {path} (granted: {granted.scope})");
    }

    // Push: set it up in the Cloud project, ask Drive to publish a folder's events, or wait for them.
    class void push(CLICommandLine options) {
        DriveApi api = Drive.api(options);
        string home = Environment.get("HOME", "");
        DriveCredentials? credentials = options.has("--rclone") ? DriveCredentials.fromRclone(options.option("--rclone", ""), options.option("--remote", "gdrive")) : DriveCredentials.load(options.option("--credentials", f"{home}/.config/drive/credentials.json"));
        if (credentials == null) { throw "No Drive sign-in found"; }
        string project = options.option("--project", credentials.clientId.substring(0, credentials.clientId.indexOf("-")));
        Push push = Push(api, project, options.option("--machine", Drive.machine()));
        string what = options.operand(1, "");
        if (what.equals("prepare")) {
            push.prepare();
        } else if (what.equals("watch")) {
            string? root = options.has("--folder") ? options.option("--folder", "") : api.rootId();
            if (root == null) { throw f"Cannot find the folder to watch: {Drive.why(api)}"; }
            Console.log(push.watch(root));
        } else if (what.equals("watch-all")) {
            Console.log(f"{push.watchAll()} folders watched");
        } else if (what.equals("listen")) {  // wait for events and tell the engine; renew the watches now and then
            long long renew = 0LL;
            while (true) {
                if (MonotonicClock.milliseconds() >= renew) {
                    try { Console.error(f"drive: {push.watchAll()} folders watched"); } catch (string error) { Console.error(f"drive: {error}"); }
                    renew = MonotonicClock.milliseconds() + 21600000LL;
                }
                int arrived = push.pull(options.has("--quiet"));
                if (arrived < 0) {
                    Console.error(f"drive: cannot wait for events: {Drive.why(api)}");
                    Timer.sleepMillis(30000);
                } else if (arrived > 0) {
                    Channel? engine = Channel.connect(Drive.runtime(options) + "/engine.sock");
                    if (engine != null) { engine.send("changed"); }
                }
            }
        } else if (what.equals("watching")) {
            Console.log(push.watching());
        } else if (what.equals("pull")) {
            long long until = MonotonicClock.milliseconds() + options.option("--seconds", "60").toLong() * 1000LL;
            int total = 0;
            while (MonotonicClock.milliseconds() < until) {
                int arrived = push.pull();
                if (arrived < 0) { throw f"Cannot wait on the subscription: {Drive.why(api)}"; }
                total += arrived;
            }
            Console.log(f"{total} events");
        } else {
            throw "usage: drive push prepare|watch [--folder ID]|watch-all|watching|pull [--seconds N]|listen";
        }
    }

    // Ask the running engine something and print what it says.
    class void ask(CLICommandLine options, string message) {
        Channel? engine = Channel.connect(Drive.runtime(options) + "/engine.sock");
        if (engine == null || !engine.send(message)) { throw "The engine is not running"; }
        Channel.wait(engine.handle(), -1, -1, 10000);
        Console.write(engine.receive());
    }

    // Which programs may download: the list, or a decision for one of them.
    class string asked(CLICommandLine options, string message, int seconds) {
        Channel? engine = Channel.connect(Drive.runtime(options) + "/engine.sock");
        if (engine == null || !engine.send(message)) { throw "The engine is not running"; }
        Channel.wait(engine.handle(), -1, -1, seconds * 1000);
        return engine.receive().trim();
    }

    // A folder as its path in the Drive, given as that or as a path under the mount.
    class string treePath(CLICommandLine options, string given) {
        string mount = options.option("--mount", Environment.get("DRIVE_MOUNT", Environment.get("HOME", "") + "/Drive"));
        string path = given;
        while (path.len() > 1 && path.endsWith("/")) { path = path.substring(0, path.len() - 1); }
        if (path.equals(mount)) { return ""; }
        if (path.startsWith(mount + "/")) { return path.substring(mount.len() + 1, path.len() - mount.len() - 1); }
        return path;
    }

    class void pin(CLICommandLine options, string command) {
        string path = Drive.treePath(options, options.operand(1, ""));
        if (path.isEmpty()) { throw f"usage: drive {command} FOLDER   (its path in the Drive, or under the mount)"; }
        string answer = Drive.asked(options, f"{command}\t{path}", command.equals("place") ? 3600 : 60);
        if (!answer.equals("ok")) { throw answer; }
        Console.log(command.equals("pin") ? f"{path} is kept downloaded" : command.equals("unpin") ? f"{path} is no longer kept downloaded" : f"{path} is on its volume");
    }

    class void adoptBatch(CLICommandLine options, string source, string target, Vector<string> batch, Vector<int> counts, Vector<string> left) {
        if (batch.len == 0) { return; }
        Vector<string> arguments = ["--"];
        for relative in batch { arguments.push(f"{source}/{relative}"); }
        ExecResult summed = ChildProcess.run("sha256sum", arguments, timeoutMilliseconds=86400000);
        Map<string, string> sums = {};
        for line in Strings.split(summed.out, "\n") {
            if (line.len() > 66 && !line.startsWith("\\")) { sums.put(line.substring(66, line.len() - 66), line.substring(0, 64)); }
        }
        for relative in batch {
            string full = f"{source}/{relative}";
            string logical = target.isEmpty() ? relative : f"{target}/{relative}";
            if (!sums.has(full) || relative.contains("\t")) {
                counts.set(4, counts.get(4) + 1);
                left.push(f"not read: {full}");
                continue;
            }
            string answer = Drive.asked(options, f"{options.has("--check") ? "probe" : "take"}\t{sums.get(full)}\t{full}\t{logical}", 3600);
            if (answer.equals("unknown") && options.has("--upload-new")) { answer = Drive.asked(options, f"bring\t{full}\t{logical}", 3600); }
            if (answer.equals("adopted") || answer.equals("same")) { counts.set(0, counts.get(0) + 1); }
            else if (answer.equals("added")) { counts.set(1, counts.get(1) + 1); }
            else if (answer.equals("here")) { counts.set(2, counts.get(2) + 1); }
            else {
                counts.set(answer.equals("different") ? 3 : 4, counts.get(answer.equals("different") ? 3 : 4) + 1);
                left.push(f"{answer.equals("different") ? "differs from the Drive" : answer.equals("unknown") ? "not in the Drive" : answer}: {full}");
            }
        }
        batch.clear();
    }

    class void adoptBelow(CLICommandLine options, string source, string target, string relative, Vector<string> batch, Vector<int> counts, Vector<string> left) {
        string folder = relative.isEmpty() ? source : f"{source}/{relative}";
        for name in FileSystem.listDir(folder).sorted() {
            string child = relative.isEmpty() ? name : f"{relative}/{name}";
            if (FileSystem.isSymlink(f"{source}/{child}")) { continue; }
            if (FileSystem.isDir(f"{source}/{child}")) {
                Drive.adoptBelow(options, source, target, child, batch, counts, left);
                continue;
            }
            batch.push(child);
            if (batch.len >= 64) { Drive.adoptBatch(options, source, target, batch, counts, left); }
        }
    }

    // Make the files of a local folder the contents of the same files in the Drive, without transferring them.
    class void adopt(CLICommandLine options) {
        string source = options.operand(1, "");
        string target = Drive.treePath(options, options.operand(2, ""));
        if (source.isEmpty() || !FileSystem.isDir(source) || options.operand(2, "").isEmpty()) { throw "usage: drive adopt LOCAL-FOLDER DRIVE-FOLDER [--upload-new | --check]"; }
        while (source.len() > 1 && source.endsWith("/")) { source = source.substring(0, source.len() - 1); }
        Vector<int> counts = [0, 0, 0, 0, 0];
        Vector<string> left = [];
        Vector<string> batch = [];
        bool check = options.has("--check");  // only say whether every file here is on the Drive; change nothing
        if (!check) { Drive.asked(options, "pause", 10); }  // nothing is downloaded that is about to be adopted
        try {
            Drive.adoptBelow(options, source, target, "", batch, counts, left);
            Drive.adoptBatch(options, source, target, batch, counts, left);
        } catch (string error) {
            if (!check) { Drive.asked(options, "unpause", 10); }
            throw error;
        }
        if (!check) { Drive.asked(options, "unpause", 10); }
        for line in left { Console.log(line); }
        if (check) {
            Console.log(f"{counts.get(0)} the same on the Drive, {counts.get(3)} different from the Drive, {counts.get(4)} not on the Drive or not read");
            if (counts.get(3) + counts.get(4) > 0) { throw "Not everything here is on the Drive"; }
            return;
        }
        Console.log(f"{counts.get(0)} adopted, {counts.get(1)} new here and sent to the Drive, {counts.get(2)} already downloaded, {counts.get(3)} different from the Drive, {counts.get(4)} left alone");
    }

    class void readers(CLICommandLine options) {
        string decision = options.operand(1, "");
        if (decision.isEmpty()) {
            Drive.ask(options, "readers");
            return;
        }
        string key = options.operand(2, "");
        if (key.isEmpty()) { throw "usage: drive readers [allow|block|once|forget READER]"; }
        Drive.ask(options, f"answer {decision} {key}");
    }

    class int run(CLIArgs args) {
        CLICommandLine options = CLICommandLine.parseFrom(args, 0);
        string command = options.operand(0, "help");
        if (command.equals("remote")) { Drive.remote(options); }
        else if (command.equals("door")) { Drive.door(options); }
        else if (command.equals("engine")) { Drive.engine(options); }
        else if (command.equals("mirror")) { Drive.mirror(options); }
        else if (command.equals("readers")) { Drive.readers(options); }
        else if (command.equals("auth")) { Drive.auth(options); }
        else if (command.equals("push")) { Drive.push(options); }
        else if (command.equals("status")) { Drive.ask(options, "status"); }
        else if (command.equals("resume")) { Drive.ask(options, "resume"); }
        else if (command.equals("pin") || command.equals("unpin") || command.equals("place")) { Drive.pin(options, command); }
        else if (command.equals("pins")) { Drive.ask(options, "pins"); }
        else if (command.equals("evict")) { Drive.ask(options, "evict"); }
        else if (command.equals("adopt")) { Drive.adopt(options); }
        else { Console.log("usage: drive door|engine|remote ... [--credentials FILE | --rclone FILE [--remote NAME]] [--api URL]"); }
        return 0;
    }
}

int main(int argc, char** argv) {
    try {
        return Drive.run(CLIArgs(argc, argv));
    } catch (string error) {
        Console.error(f"drive: {error}");
        return 1;
    }
    return 1;
}
