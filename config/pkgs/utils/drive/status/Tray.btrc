import Library.Console;
import Library.FileSystem;
import Library.Platform;
import Library.Process;
import Library.Tray;

import ./Progress.btrc;

// The Drive in the system tray: the Drive's mark when everything is here, the mark with how far along it is
// while files come and go, and a click for the window that says more.
class DriveTray {
    private string runtime;
    private string icons;
    private SystemTray tray;
    private bool measured = false;  // the kept folders were measured since they last changed

    public DriveTray(string runtime, string icons, string window, string mount) {
        self.runtime = runtime;
        self.icons = icons;
        self.tray = SystemTray("Google Drive");
        self.tray.icon(self.picture("offline")).tip("Google Drive")
            .onClick(window)
            .item("Show status", window)
            .item("Open the Drive folder", "xdg-open " + ShellWords.quote(mount))
            .checkItem("Pause downloading kept folders", "if drive progress | grep -q '^paused yes'; then drive unpause; else drive pause; fi > /dev/null", "drive progress | grep -q '^paused yes'")
            .item("Quit", TraySignal.quit());
    }

    private string picture(string name) { return f"{self.icons}/{name}.svg"; }

    private void refresh() {
        DriveProgress progress = DriveProgress.read(self.runtime);
        self.tray.setIcon(self.picture(progress.icon()));
        self.tray.setTip(progress.tip());
        // Measuring walks every kept file, so it is left to another process, and only once things have settled.
        bool settled = progress.state().equals("synced");
        if (settled && !self.measured) { UnixShell().run("setsid --fork drive usage --save > /dev/null 2>&1 < /dev/null", logFailure=false); }
        self.measured = settled;
    }

    public int run() {
        try {
            self.tray.show();
        } catch (string error) {  // no session to show it in
            Console.error(f"drive-tray: no tray to show the Drive in ({error})");
            return 0;
        }
        self.refresh();
        while (self.tray.pump(2000)) { self.refresh(); }
        self.tray.close();
        return 0;
    }
}

int main() {
    string runtime = Environment.get("DRIVE_RUNTIME", Environment.get("XDG_RUNTIME_DIR", "/run") + "/drive");
    string icons = Environment.get("DRIVE_TRAY_ICONS", "");
    string window = Environment.get("DRIVE_TRAY_WINDOW", "drive-status");
    string mount = Environment.get("DRIVE_MOUNT", Environment.get("HOME", "") + "/Drive");
    if (icons.isEmpty() || !FileSystem.isDir(icons)) {
        Console.error("drive-tray: DRIVE_TRAY_ICONS does not name the folder of its pictures");
        return 2;
    }
    return DriveTray(runtime, icons, window, mount).run();
}
