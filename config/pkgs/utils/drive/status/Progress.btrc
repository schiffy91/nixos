import Library.FileSystem;
import Library.Platform;
import Library.Strings;
import Library.Vector;

import ../store/StoreFile.btrc;

class DriveSize {
    class string words(long long bytes) {  // "3.1 GB": one decimal while the number is small
        if (bytes < 1000LL) { return f"{bytes} bytes"; }
        Vector<string> units = ["KB", "MB", "GB", "TB"];
        long long unit = 1000LL;
        int index = 0;
        while (index < units.len - 1 && bytes >= unit * 1000LL) {
            unit *= 1000LL;
            index++;
        }
        long long tenths = (bytes * 10LL + unit / 2LL) / unit;
        if (tenths >= 1000LL) { return f"{(tenths + 5LL) / 10LL} {units.get(index)}"; }
        return f"{tenths / 10LL}.{tenths % 10LL} {units.get(index)}";
    }
}

class DriveCount {
    class string words(int count) {  // "42,283"
        string digits = f"{count}";
        string grouped = "";
        for (int index = 0; index < digits.len(); index++) {
            if (index > 0 && (digits.len() - index) % 3 == 0) { grouped = grouped + ","; }
            grouped = grouped + digits.substring(index, 1);
        }
        return grouped;
    }
}

// One folder that is kept downloaded.
class DrivePin {
    public string path;  // in the Drive
    public string real;  // where its files are on this machine
    public bool here;  // false while the volume it lives on is away
    public int files = 0;
    public long long onDisk = 0LL;
    public long long inDrive = 0LL;
    public long long free = -1LL;  // on the volume it lives on

    public DrivePin(string path, string real, bool here) {
        self.path = path;
        self.real = real;
        self.here = here;
    }

    private void walk(string folder) {
        for name in FileSystem.listDir(folder) {
            string child = f"{folder}/{name}";
            if (FileSystem.isSymlink(child)) { continue; }
            if (FileSystem.isDir(child)) {
                self.walk(child);
                continue;
            }
            StoreFile? file = StoreFile.open(child);
            if (file == null) { continue; }
            long long size = file.size();
            self.files++;
            self.inDrive += size;
            self.onDisk += file.attribute("state").equals("cloud") ? size - file.lacking() : size;  // a downloaded file may have holes of its own: runs of zeros
            file.close();
        }
    }

    public void measure() {
        if (!self.here || !FileSystem.isDir(self.real)) { return; }
        self.walk(self.real);
        self.free = StorePaths.freeBytes(self.real);
    }

    public string line() { return f"pin\t{self.here ? "here" : "away"}\t{self.files}\t{self.onDisk}\t{self.inDrive}\t{self.free}\t{self.path}"; }
}

// What the engine says of itself, one fact to a line: the answer to `progress`, and the file it keeps.
class DriveProgress {
    public bool running = false;  // the engine that wrote this is alive
    public bool starting = false;  // it is still reading what is on this machine
    public bool online = false;
    public bool door = false;
    public bool paused = false;
    public bool behind = false;  // more changes from the Drive are still to be read
    public bool held = false;  // deletions wait for `drive resume`
    public int folders = 0;
    public int files = 0;  // files of kept folders still to download
    public long long arrived = 0LL;
    public long long total = 0LL;
    public int sending = 0;
    public int asking = 0;
    public string missing = "";
    public string current = "";
    public string store = "";
    public long long cacheLimit = 0LL;
    public Vector<DrivePin> pins = [];

    class DriveProgress parse(string answer) {
        DriveProgress progress = DriveProgress();
        for line in Strings.split(answer, "\n") {
            int space = Strings.find(line, " ", 0);
            if (space <= 0) { continue; }
            string name = line.substring(0, space);
            string value = line.substring(space + 1, line.len() - space - 1);
            Vector<string> words = Strings.split(value, " ");
            if (name.equals("engine")) { progress.running = FileSystem.isDir(f"/proc/{value}"); }
            else if (name.equals("starting")) { progress.starting = value.equals("yes"); }
            else if (name.equals("online")) { progress.online = value.equals("yes"); }
            else if (name.equals("door")) { progress.door = value.equals("connected"); }
            else if (name.equals("paused")) { progress.paused = value.equals("yes"); }
            else if (name.equals("behind")) { progress.behind = value.equals("yes"); }
            else if (name.equals("deletions")) { progress.held = value.equals("held"); }
            else if (name.equals("folders")) { progress.folders = value.toInt(); }
            else if (name.equals("upload")) { progress.sending = value.toInt(); }
            else if (name.equals("asking")) { progress.asking = value.toInt(); }
            else if (name.equals("missing")) { progress.missing = value; }
            else if (name.equals("current")) { progress.current = value; }
            else if (name.equals("store")) { progress.store = value; }
            else if (name.equals("limits") && words.len == 2) { progress.cacheLimit = words.get(0).toLong(); }
            else if (name.equals("download") && words.len == 3) {
                progress.files = words.get(0).toInt();
                progress.arrived = words.get(1).toLong();
                progress.total = words.get(2).toLong();
            } else if (name.equals("pin")) {
                int tab = Strings.find(value, "\t", 0);
                int gap = Strings.find(value, " ", 0);
                if (tab > gap && gap > 0) { progress.pins.push(DrivePin(value.substring(tab + 1, value.len() - tab - 1), value.substring(gap + 1, tab - gap - 1), value.startsWith("here "))); }
            }
        }
        return progress;
    }

    // What the engine behind `runtime` last said of itself. It keeps this in a file, because while a transfer
    // runs it answers no questions; an engine that is gone leaves a file whose writer is no longer there.
    class DriveProgress read(string runtime) { return DriveProgress.parse(FileSystem.readText(runtime + "/progress")); }

    public string state() {
        if (!self.running) { return "stopped"; }
        if (self.starting) { return "syncing"; }
        if (!self.online) { return "offline"; }
        if (self.held || !self.missing.isEmpty()) { return "attention"; }
        if (self.files > 0 && self.paused) { return "paused"; }
        if (self.files > 0 || self.sending > 0 || self.behind) { return "syncing"; }
        return "synced";
    }

    public int percent() {  // of the bytes to download; -1 when there is nothing to measure
        if (!self.state().equals("syncing") || self.files == 0 || self.total <= 0LL) { return -1; }
        long long share = self.arrived * 100LL / self.total;
        return share > 100LL ? 100 : (int)share;
    }

    public string icon() {  // the name of the picture for this state
        string state = self.state();
        if (state.equals("stopped")) { return "offline"; }
        int percent = self.percent();
        if (!state.equals("syncing") || percent < 0) { return state; }
        int step = percent / 5 * 5;
        return f"syncing-{step < 10 ? "00" : step < 100 ? "0" : ""}{step}";
    }

    public string headline() {
        string state = self.state();
        if (state.equals("stopped")) { return "Not running"; }
        if (state.equals("offline")) { return "Offline"; }
        if (state.equals("paused")) { return "Paused"; }
        if (state.equals("synced")) { return "Up to date"; }
        if (state.equals("attention")) { return self.held ? "Deletions are waiting for a yes" : f"Waiting for {self.missing}"; }
        if (self.starting) { return "Starting"; }
        int percent = self.percent();
        return percent < 0 ? "Syncing" : f"Syncing, {percent}%";
    }

    public string detail() {
        string state = self.state();
        if (state.equals("stopped")) { return "The Drive client's engine does not answer."; }
        if (state.equals("offline")) { return "Changes are sent and fetched when the Drive can be reached again."; }
        if (state.equals("attention") && self.held) { return "Many files were deleted at once. `drive resume` lets the deletions through."; }
        if (state.equals("attention")) { return "Its files are on a volume that is not attached; changes to it are held until it is back."; }
        if (self.starting) { return "Reading what is already on this computer."; }
        Vector<string> parts = [];
        if (self.files > 0 && self.total > 0LL) { parts.push(f"{DriveSize.words(self.arrived)} of {DriveSize.words(self.total)}"); }
        if (self.files > 0) { parts.push(f"{DriveCount.words(self.files)} {self.files == 1 ? "file" : "files"} to download"); }
        if (self.sending > 0) { parts.push(f"{self.sending} {self.sending == 1 ? "change" : "changes"} to send"); }
        if (self.behind) { parts.push("reading changes from the Drive"); }
        return Strings.join(parts, ", ");
    }

    public string tip() {  // one line for a tooltip
        string detail = self.detail();
        return detail.isEmpty() ? self.headline() : f"{self.headline()}: {detail}";
    }
}

// How much the kept folders hold, measured by walking them: slow, so done apart from the engine and kept in a file.
class DriveUsage {
    class string file() { return Environment.get("XDG_RUNTIME_DIR", "/tmp") + "/drive-usage"; }

    class string measure(DriveProgress progress) {
        Vector<string> lines = [];
        for pin in progress.pins {
            pin.measure();
            lines.push(pin.line());
        }
        return lines.len == 0 ? "" : Strings.join(lines, "\n") + "\n";
    }

    // The measured numbers put onto the pins of a newer progress, by path.
    class void apply(DriveProgress progress, string measured) {
        for line in Strings.split(measured, "\n") {
            Vector<string> fields = Strings.split(line, "\t");
            if (fields.len != 7 || !fields.get(0).equals("pin")) { continue; }
            for pin in progress.pins {
                if (!pin.path.equals(fields.get(6))) { continue; }
                pin.files = fields.get(2).toInt();
                pin.onDisk = fields.get(3).toLong();
                pin.inDrive = fields.get(4).toLong();
                pin.free = fields.get(5).toLong();
            }
        }
    }
}
