import Library.Strings;

// One end of the socket between the door and the engine. Messages are single lines of words.
class Channel {
    private int descriptor = -1;

    private Channel(int descriptor) { self.descriptor = descriptor; }

    class Channel? listen(string path) {
        int descriptor = driveChannelListen(path);
        return descriptor < 0 ? null : Channel(descriptor);
    }

    class Channel? connect(string path) {
        int descriptor = driveChannelConnect(path);
        return descriptor < 0 ? null : Channel(descriptor);
    }

    public Channel? accept() {
        int descriptor = driveChannelAccept(self.descriptor);
        return descriptor < 0 ? null : Channel(descriptor);
    }

    public int handle() { return self.descriptor; }

    public bool isOpen() { return self.descriptor >= 0; }

    public bool send(string message) { return self.descriptor >= 0 && driveChannelSend(self.descriptor, message) == 0; }

    // The next message, "" when none is waiting; closes itself when the other side is gone.
    public string receive() {
        char message[4096];
        long length = self.descriptor < 0 ? -1L : driveChannelReceive(self.descriptor, message, 4096UL);
        if (length < 0L) {
            self.close();
            return "";
        }
        return length == 0L ? "" : Strings.copy(message);
    }

    public void close() {
        if (self.descriptor >= 0) { close(self.descriptor); }
        self.descriptor = -1;
    }

    public void __del__() { self.close(); }

    // Which of the descriptors have something to read, one bit each, after at most `milliseconds`.
    class int wait(int first, int second, int third, int milliseconds) { return driveChannelWait(first, second, third, milliseconds); }
}
