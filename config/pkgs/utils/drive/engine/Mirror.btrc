import Library.Map;
import Library.Vector;

import ../remote/DriveApi.btrc;
import ../remote/DriveFile.btrc;
import Library.Console;

import ../store/Store.btrc;
import ../store/StoreFile.btrc;
import ./Planner.btrc;
import ./Uploader.btrc;

// Keeps the store's tree the shape of the Drive: all of it once, then what the change feed reports.
class Mirror {
    private DriveApi api;
    private Store store;
    public Uploader? uploader = null;  // told when a change from the Drive meets a change made here
    public int deleteLimit = 50;  // 0: no brake
    public int deletePercent = 10;
    public bool allowDeletions = false;  // a person said the waiting deletions may go
    public bool braked = false;
    private int streak = 0;  // deletions taken from the feed since the store was last current: a batch is counted whole, however many pages it comes in

    public Mirror(DriveApi api, Store store) {
        self.api = api;
        self.store = store;
    }

    private string why() {
        DriveError? failure = self.api.failure;
        return failure == null ? "no reason given" : failure.describe();
    }

    // The whole Drive into an empty store. The feed position is taken first, so nothing that changes meanwhile is lost.
    public void build() {
        string? root = self.api.rootId();
        string? start = self.api.startToken();
        if (root == null || start == null) { throw f"Cannot reach the Drive: {self.why()}"; }
        self.store.adoptRoot(root);
        Map<string, Vector<DriveFile>> children = {};
        string token = "";
        while (true) {
            DriveListing? page = self.api.list(token);
            if (page == null) { throw f"The listing stopped: {self.why()}"; }
            for file in page.files {
                if (file.parent.isEmpty()) {
                    self.store.skipped++;
                    continue;
                }
                if (!children.has(file.parent)) { children.put(file.parent, []); }
                children.get(file.parent).push(file);
            }
            token = page.next;
            if (token.isEmpty()) { break; }
        }
        Vector<string> waiting = [root];  // folders whose contents are still to be made
        int reached = 0;
        while (waiting.len > 0) {
            string folder = waiting.pop();
            if (!children.has(folder)) { continue; }
            for file in children.get(folder) {
                if (self.store.knows(file.id)) { self.store.update(file); }  // a build that was interrupted carries on
                else if (self.store.add(file)) { reached++; }
                if (file.isFolder()) { waiting.push(file.id); }
            }
            children.remove(folder);
        }
        for orphans in children.values() { self.store.skipped += orphans.len; }  // under folders that are not in the tree
        if (!self.store.setPosition(start)) { throw "Cannot record the change feed position"; }
    }

    // False when the entry is new and its folder is not here yet.
    private bool apply(DriveChange change) {
        DriveFile? file = change.file;
        if (change.removed || file == null || file.trashed) {
            if (self.store.knows(change.id)) { self.store.discard(change.id); }
            return true;
        }
        if (self.store.knows(file.id)) {
            Uploader? uploader = self.uploader;
            StoreFile? held = self.store.file(file.id);
            if (uploader != null && !uploader.overwriteConflicts && held != null && self.store.changedHere(file.id) && !held.attribute("revision").equals(file.revision)) { uploader.collide(file.id, file); }  // changed on both sides
            else { self.store.update(file); }
            return true;
        }
        return !file.parent.isEmpty() && self.store.add(file);
    }

    // One page of what changed on the Drive since last time: 0 when the store is now current, 1 when there is
    // more to read, -1 when the Drive could not be reached, -2 when deletions are held for a yes. Below 0 the
    // position stays where it was.
    public int step() {
        string token = self.store.position();
        if (token.isEmpty()) { throw "The store has no change feed position; build it first"; }
        DriveChanges? page = self.api.changes(token);
        if (page == null) { return -1; }
        int deletions = 0;
        for change in page.changes {
            DriveFile? file = change.file;
            if ((change.removed || file == null || file.trashed) && self.store.knows(change.id)) { deletions += self.store.weight(change.id); }
        }
        if (!self.allowDeletions && deletions > 0 && Planner.tooManyDeletions(self.streak + deletions, self.store.entryCount(), self.deleteLimit, self.deletePercent)) {
            if (!self.braked) { Console.error(f"drive: the Drive reports {self.streak + deletions} deletions and counting; the rest are waiting for 'drive resume'"); }
            self.braked = true;
            return -2;  // the position stays, so nothing is skipped
        }
        Vector<DriveChange> waiting = [];  // a new folder's contents can be listed before the folder
        for change in page.changes {
            if (!self.apply(change)) { waiting.push(change); }
        }
        bool progress = true;
        while (progress && waiting.len > 0) {
            progress = false;
            Vector<DriveChange> still = [];
            for change in waiting {
                if (self.apply(change)) { progress = true; }
                else { still.push(change); }
            }
            waiting = still;
        }
        self.store.skipped += waiting.len;
        if (!self.store.setPosition(page.next.isEmpty() ? page.resume : page.next)) { throw "Cannot record the change feed position"; }
        self.braked = false;
        self.streak += deletions;
        if (!page.next.isEmpty()) { return 1; }
        self.streak = 0;
        self.allowDeletions = false;  // a yes covers the batch it was given for
        return 0;
    }

    // Everything that changed, page after page. False when the Drive could not be reached or deletions are held.
    public bool follow() {
        int more = 1;
        while (more == 1) { more = self.step(); }
        return more == 0;
    }
}
