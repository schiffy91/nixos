import Library.Bytes;
import Library.Platform;
import Library.Process;
import Library.Terminal.PTYProcess;
import Library.Timer;
import Library.Vector;
import ./accounts/UserAccount.btrc;
import ./PasswordPrompts.btrc;

class PasswordChange {
    class bool safeResponse(string? text) { return text != null && text.len() <= 4096 && !text.contains("\n") && !text.contains("\r"); }

    class bool waitForPrompt(PTYProcess child, PasswordPrompts prompts, long long deadline) {
        var settling = false;
        while (MonotonicClock.before(deadline)) {
            var output = child.readUntil(deadline, settling ? 250 : 1000);
            if (output == null) { return false; }
            if (!output.isEmpty()) {
                prompts.feed(output);
                settling = prompts.candidate();
            } else if (settling) {
                // A quiet interval must follow the whole prompt, including SGR.
                return prompts.ready();
            }
        }
        return false;
    }

    class bool answer(PTYProcess child, Vector<string> responses, long long deadline) {
        if (responses.len != 2 && responses.len != 3) { return false; }
        for response in responses {
            if (!PasswordChange.safeResponse(response)) { return false; }
        }
        var prompts = PasswordPrompts(responses.len == 3);
        for response in responses {
            if (!PasswordChange.waitForPrompt(child, prompts, deadline)
                || !child.echoDisabled() || !prompts.advance()) { return false; }
            if (!child.writeUntil(Bytes.fromString(f"{response}\n"), deadline)) { return false; }
        }
        return prompts.complete();
    }

    class bool change(string user, string oldPassword, string newPassword) {
        if (user.isEmpty() || user.startsWith("-")) { return false; }
        var account = UserAccount.find(user);
        if (account == null) { return false; }
        var root = Platform.isRoot();
        if (!root && !account.current) { return false; }
        Vector<string> environment = [
            "PATH=/run/wrappers/bin:/run/current-system/sw/bin:/usr/bin:/bin",
            "LC_ALL=C", "LANG=C", f"HOME={account.homeDirectory}",
            f"USER={account.name}", f"LOGNAME={account.name}"
        ];
        var path = ChildProcessExecutable.resolve("passwd", "/", environment, []);
        if (path.isEmpty()) { return false; }
        Vector<string> args = [path];
        if (root) { args.push(account.name); }
        Vector<string> responses = root ? [newPassword, newPassword] : [oldPassword, newPassword, newPassword];
        var child = PTYProcess.start(path, args, environment);
        if (child == null) { return false; }
        var deadline = MonotonicClock.deadlineAfter(30000);
        return PasswordChange.answer(child, responses, deadline) && child.waitExitUntil(deadline) == 0;
    }
}
