import Library.Bytes;
import Library.Vector;

enum PasswordPrompt { PASSWORD_CURRENT, PASSWORD_NEW, PASSWORD_CONFIRM, PASSWORD_COMPLETE };
enum PasswordPromptEscape { PROMPT_TEXT, PROMPT_ESCAPE, PROMPT_SGR_DIGIT, PROMPT_SGR_PARAMETER };

class PasswordPrompts {
    private PasswordPrompt prompt;
    private PasswordPromptEscape escape = PROMPT_TEXT;
    private Bytes line = Bytes();
    private bool invalid = false;
    private int rawLength = 0;
    private int escapeLength = 0;

    public PasswordPrompts(bool requireCurrentPassword) {
        self.prompt = requireCurrentPassword ? PASSWORD_CURRENT : PASSWORD_NEW;
    }

    private void resetLine() {
        self.line = Bytes();
        self.invalid = false;
        self.rawLength = 0;
        self.escape = PROMPT_TEXT;
        self.escapeLength = 0;
    }

    private Vector<string> expected() {
        if (self.prompt == PASSWORD_CURRENT) {
            return ["Current password:", "(current) UNIX password:", "Old password:", "Old Password:"];
        }
        if (self.prompt == PASSWORD_NEW) {
            return ["New password:", "New Password:", "Enter new UNIX password:"];
        }
        if (self.prompt == PASSWORD_CONFIRM) {
            return ["Retype new password:", "Retype New Password:", "Retype new UNIX password:", "Re-enter new password:", "Retype password:"];
        }
        return [];
    }

    // Only numeric SGR is decoration: ESC '[' digit+ (';' digit+)* 'm'.
    // Other terminal controls invalidate the line; incomplete SGR cannot be answered.
    private void consumeEscape(int value) {
        if (self.escape == PROMPT_ESCAPE) {
            if (value != '[') { self.invalid = true; return; }
            self.escape = PROMPT_SGR_DIGIT;
            self.escapeLength = 0;
            return;
        }
        self.escapeLength++;
        if (self.escapeLength > 16) { self.invalid = true; return; }
        if (value >= '0' && value <= '9') {
            self.escape = PROMPT_SGR_PARAMETER;
        } else if (self.escape == PROMPT_SGR_PARAMETER && value == ';') {
            self.escape = PROMPT_SGR_DIGIT;
        } else if (self.escape == PROMPT_SGR_PARAMETER && value == 'm') {
            self.escape = PROMPT_TEXT;
        } else {
            self.invalid = true;
        }
    }

    // Bound each line to 128 visible bytes and 192 raw bytes. Keep input as
    // Bytes until control characters (especially NUL) have been rejected.
    public void feed(Bytes bytes) {
        if (self.complete()) { return; }
        for (int i = 0; i < bytes.length(); i++) {
            var value = bytes.get(i);
            if (value == '\r' || value == '\n') { self.resetLine(); continue; }
            self.rawLength++;
            if (self.rawLength > 192) { self.invalid = true; }
            if (self.invalid) { continue; }
            if (self.escape != PROMPT_TEXT) { self.consumeEscape(value); continue; }
            if (value == 0x1b) { self.escape = PROMPT_ESCAPE; continue; }
            if ((value < 0x20 && value != '\t') || value == 0x7f || self.line.length() >= 128) {
                self.invalid = true;
                continue;
            }
            self.line.append(value);
        }
    }

    public bool candidate() {
        if (self.invalid || self.complete()) { return false; }
        // The only whitespace feed permits within a line is space and tab.
        return self.expected().contains(self.line.toString().rstrip());
    }

    public bool ready() { return self.escape == PROMPT_TEXT && self.candidate(); }

    public bool advance() {
        if (!self.ready()) { return false; }
        if (self.prompt == PASSWORD_CURRENT) { self.prompt = PASSWORD_NEW; }
        else if (self.prompt == PASSWORD_NEW) { self.prompt = PASSWORD_CONFIRM; }
        else { self.prompt = PASSWORD_COMPLETE; }
        self.resetLine();
        return true;
    }

    public bool complete() { return self.prompt == PASSWORD_COMPLETE; }
}
