import Library.Bytes;
import Library.Strings;
import Library.Terminal.PTYProcess;
import Library.Timer;
import Library.Vector;
import ./PasswdPromptClassifier.btrc;

#include <pwd.h>
#include <unistd.h>

class PasswdDriver {
    class string executable() {
        Vector<string> candidates = ["/run/wrappers/bin/passwd", "/run/current-system/sw/bin/passwd", "/usr/bin/passwd", "/bin/passwd"];
        for (int i = 0; i < candidates.len; i++) {
            if (access(candidates.get(i), X_OK) == 0) { return candidates.get(i); }
        }
        return "";
    }

    class bool safeResponse(string? text) { return text != null && text.len() <= 4096 && !text.contains("\n") && !text.contains("\r"); }

    class bool answer(PTYProcess child, Vector<string> responses, long long deadline) {
        for response in responses {
            if (!PasswdDriver.safeResponse(response)) { return false; }
        }
        var classifier = PasswdPromptClassifier(responses.len);
        var sent = 0;
        var output = child.readUntil(deadline);
        while (MonotonicClock.before(deadline) && sent < responses.len) {
            if (output == null) { return false; }
            if (output.isEmpty()) {
                output = child.readUntil(deadline);
                continue;
            }
            var complete = classifier.feedBytes(output);
            if (!complete && !classifier.incompleteCandidate()) {
                output = child.readUntil(deadline);
                continue;
            }
            output = child.readUntil(deadline, 250);
            if (output == null) { return false; }
            if (!output.isEmpty()) { continue; }
            if (!complete || !child.echoDisabled() || !classifier.acceptPending()) { return false; }
            if (!child.writeUntil(Bytes.fromString(f"{responses.get(sent)}\n"), deadline)) { return false; }
            sent++;
            if (sent < responses.len) { output = child.readUntil(deadline); }
        }
        return sent == responses.len && classifier.complete();
    }

    class bool change(string user, string oldPassword, string newPassword) {
        if (user.isEmpty() || user[0] == '-') { return false; }
        struct passwd account;
        struct passwd* found = NULL;
        char accountBuffer[16384];
        if (getpwnam_r(user, &account, accountBuffer, sizeof(accountBuffer), &found) != 0 || found == NULL) { return false; }
        string path = PasswdDriver.executable();
        bool root = geteuid() == (uid_t)0;
        if (path.isEmpty() || (!root && geteuid() != found->pw_uid)) { return false; }
        string name = Strings.copy(found->pw_name);
        Vector<string> args = [path];
        if (root) { args.push(name); }
        Vector<string> env = ["PATH=/run/wrappers/bin:/run/current-system/sw/bin:/usr/bin:/bin", "LC_ALL=C", "LANG=C", "HOME=" + Strings.copy(found->pw_dir), "USER=" + name, "LOGNAME=" + name];
        Vector<string> responses = root ? [newPassword, newPassword] : [oldPassword, newPassword, newPassword];
        var child = PTYProcess.start(path, args, env);
        if (child == null) { return false; }
        long long deadline = MonotonicClock.deadlineAfter(30000);
        if (!PasswdDriver.answer(child, responses, deadline)) {
            child.close();
            return false;
        }
        return child.waitExitUntil(deadline) == 0;
    }
}
