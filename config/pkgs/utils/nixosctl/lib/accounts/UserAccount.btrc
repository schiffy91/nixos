class UserAccount {
    public string name;
    public string homeDirectory;
    public bool current;
    public int uid;
    public int gid;

    private UserAccount(string name, string homeDirectory, bool current, int uid, int gid) {
        self.name = name;
        self.homeDirectory = homeDirectory;
        self.current = current;
        self.uid = uid;
        self.gid = gid;
    }

    class UserAccount? find(string name) {
        var record = userAccountFind(name);
        if (record == null) { return null; }
        var accountName = userAccountName(record);
        var homeDirectory = userAccountHome(record);
        if (accountName == null || homeDirectory == null) { return null; }
        return UserAccount(accountName, homeDirectory, userAccountIsCurrent(record), userAccountUid(record), userAccountGid(record));
    }
}
