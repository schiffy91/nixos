import Library.Console;
import Library.FileSystem;
import Library.Graph;
import Library.JSON;
import Library.Map;
import Library.Network;
import Library.Process;
import Library.Set;
import Library.Strings;
import Library.Timer;
import Library.Vector;
import ../../core/NixosLog.btrc;
import ../Spec.btrc;
import ../VmTestRunner.btrc;
import ../QemuE2eHarness.btrc;

// One node being run by a child of the graph runner.
class GraphJob {
    public string id;
    public BackgroundProcess process;
    public long long started;
    public int memory;
    public int port;
    public string log;

    public GraphJob(string id, BackgroundProcess process, int memory, int port, string log) {
        self.id = id;
        self.process = process;
        self.started = MonotonicClock.milliseconds();
        self.memory = memory;
        self.port = port;
        self.log = log;
    }

    public long long seconds() { return (MonotonicClock.milliseconds() - self.started + 500LL) / 1000LL; }
}

class VmGraphRunner {
    public ExecutionGraph graph;
    public Map<string, string> args;
    public string sourceHashValue;
    public string treeStateValue;
    public Map<string, string> derivations;  // what a spec asks nix to instantiate -> the .drv path that gives
    private bool derivationsLoaded;

    public VmGraphRunner(ExecutionGraph graph, Map<string, string> args) {
        self.graph = graph;
        self.args = args;
        self.sourceHashValue = "";
        self.treeStateValue = "";
        self.derivations = {};
        self.derivationsLoaded = false;
    }

    private string sha256InputCommand() {
        return "if command -v sha256sum >/dev/null 2>&1; then "
            + "sha256sum; else shasum -a 256; fi";
    }

    private string sha256ArgumentsCommand() {
        return "if command -v sha256sum >/dev/null 2>&1; then "
            + "sha256sum \"$@\"; else shasum -a 256 \"$@\"; fi";
    }

    private string sha256FileCommand(string path) {
        var quoted = ShellWords.quote(path);
        return "if command -v sha256sum >/dev/null 2>&1; then "
            + f"sha256sum {quoted}; else shasum -a 256 {quoted}; fi | awk '{{print $1}}'";
    }

    public string sourceHash() {
        if (!self.sourceHashValue.isEmpty()) { return self.sourceHashValue; }
        var root = self.graph.resolvedWorkspaceRoot();
        var hashPipeline = "cd " + ShellWords.quote(root)
            + " && find ."
            + " \\( -path './.git' -o -path './.vm' -o -path './build' -o -path './secrets' -o -path './.agents' -o -path './.claude' -o -path './.codex' -o -path './.gemini' -o -path './result' -o -name '.btrc-cache' -o -name '__pycache__' \\) -prune"
            + " -o -type f"
            + " ! -name '.DS_Store'"
            + " ! -name '._*'"
            + " \\( -name '*.btrc' -o -name '*.nix' -o -name '*.json' -o -name '*.toml' -o -name '*.yaml' -o -name '*.yml' -o -name '*.tsv' -o -name '*.c' -o -name '*.h'"
            + " -o -name '*.cpp' -o -name '*.cc' -o -name '*.cxx' -o -name '*.hpp' -o -name '*.hh' -o -name '*.hxx'"
            + " -o -name '*.js' -o -name '*.sh' -o -name '*.rs' -o -name '*.py' -o -name '*.patch' -o -name 'Makefile' -o -name 'flake.lock' \\)"
            + " -print0 | LC_ALL=C sort -z | xargs -0 sh -c '" + self.sha256ArgumentsCommand() + "' sh | "
            + "sh -c '" + self.sha256InputCommand() + "' | awk '{print $1}'";
        var command = f"bash -o pipefail -c {ShellWords.quote(hashPipeline)}";
        var result = UnixShell().run(command);
        if (!result.ok() || result.trimmed().isEmpty()) {
            NixosLog.fatal("Failed to compute workspace source hash for " + root);
        }
        var toolPath = PathTools.join(root, "build/nixosctl");
        var toolHash = "missing";
        if (FileSystem.exists(toolPath)) {
            var toolPipeline = self.sha256FileCommand(toolPath);
            var tool = UnixShell().run(f"bash -o pipefail -c {ShellWords.quote(toolPipeline)}");
            if (!tool.ok() || tool.trimmed().isEmpty()) {
                NixosLog.fatal("Failed to compute nixosctl hash for " + toolPath);
            }
            toolHash = tool.trimmed();
        }
        self.sourceHashValue = result.trimmed() + ":nixosctl=" + toolHash;
        return self.sourceHashValue;
    }

    // The spec with the graph's and the node's arguments, before anything is expanded or hashed.
    private VmTestSpec declared(GraphNode node) {
        var spec = VmSpecParser.readFile(self.graph.resolvedSpecPath(node));
        spec.setArg("graphName", self.graph.name);
        spec.setArg("nodeId", node.id);
        spec.setArg("workspaceRoot", self.graph.resolvedWorkspaceRoot());
        spec.setArg("sourceHash", self.sourceHash());
        spec.applyStructuralOverrides(node.args);
        spec.applyStructuralOverrides(self.args);
        for key, value in node.args {
            spec.setArg(key, value);
        }
        for key, value in self.args {
            spec.setArg(key, value);
        }
        return spec;
    }

    public VmTestSpec specFor(GraphNode node) {
        var spec = self.declared(node);
        if (!spec.derivation.isEmpty()) {
            spec.derivation = VmSpecArgs.expand(spec.derivation, spec.args).trim();
            spec.setArg("derivation", self.derivationPath(spec.derivation));
        }
        spec.expandArgs();
        return spec;
    }

    // Every file under the workspace by path, size and time of change, whatever its kind: a derivation
    // may read any of them, so this decides whether the .drv paths found earlier still hold. A changed
    // time with unchanged content only costs an evaluation; the derivation itself is exact.
    public string treeState() {
        if (!self.treeStateValue.isEmpty()) { return self.treeStateValue; }
        var listing = f"cd {ShellWords.quote(self.graph.resolvedWorkspaceRoot())} && find ."
            + " \\( -path './.git' -o -path './.vm' -o -path './build' -o -path './result' -o -name '.btrc-cache' -o -name '__pycache__' \\) -prune"
            + " -o -type f -printf '%P\\t%s\\t%T@\\n' | LC_ALL=C sort | sha256sum | cut -d' ' -f1";
        var result = UnixShell().run(f"bash -o pipefail -c {ShellWords.quote(listing)}");
        if (!result.ok() || result.trimmed().isEmpty()) { NixosLog.fatal("Failed to read the workspace tree for " + self.graph.resolvedWorkspaceRoot()); }
        self.treeStateValue = result.trimmed();
        return self.treeStateValue;
    }

    public string inputsFile() {
        return PathTools.join(PathTools.join(self.graph.resolvedWorkspaceRoot(), ".vm"), "inputs.json");
    }

    // The .drv paths found for this exact tree, so an unchanged tree asks nix nothing.
    private void loadDerivations() {
        if (self.derivationsLoaded) { return; }
        self.derivationsLoaded = true;
        if (!FileSystem.exists(self.inputsFile())) { return; }
        var saved = JSONValue.readFile(self.inputsFile());
        if (!saved.isObject() || !saved.has("tree") || saved.get("tree").asString() != self.treeState() || !saved.has("derivations")) { return; }
        var found = saved.get("derivations");
        for request in found.keys() {
            var path = found.get(request).asString();
            if (FileSystem.exists(path)) { self.derivations.put(request, path); }  // a collected store leaves the path behind
        }
    }

    private void saveDerivations() {
        var found = JSONValue.makeObject();
        for request, path in self.derivations {
            if (path.startsWith("/nix/store/")) { found.set(request, JSONValue.makeString(path)); }
        }
        var saved = JSONValue.makeObject();
        saved.set("tree", JSONValue.makeString(self.treeState()));
        saved.set("derivations", found);
        FileSystem.mkdirp(PathTools.dirname(self.inputsFile()));
        FileSystem.writeAtomic(self.inputsFile(), saved.stringify() + "\n");
    }

    private string instantiation(string request) {
        return f"cd {ShellWords.quote(self.graph.resolvedWorkspaceRoot())} && nix-instantiate {request}";
    }

    // Asks nix for every derivation these nodes are keyed on that is not known yet, several at a time.
    public void resolveDerivations(Vector<GraphNode> nodes) {
        self.loadDerivations();
        Vector<string> wanted = [];
        for node in nodes {
            var spec = self.declared(node);
            if (spec.derivation.isEmpty()) { continue; }
            var request = VmSpecArgs.expand(spec.derivation, spec.args).trim();
            if (!self.derivations.has(request) && !wanted.contains(request)) { wanted.push(request); }
        }
        if (wanted.isEmpty()) { return; }
        NixosLog.info(f"graph {self.graph.name}: evaluating {wanted.length} derivations");
        var scratch = TemporaryDirectory.create("nixos-graph-derivations").value();
        int jobs = self.jobLimit();
        for (int start = 0; start < wanted.length; start += jobs) {
            Vector<BackgroundProcess> evaluations = [];
            for (int index = start; index < wanted.length && index < start + jobs; index++) {
                var output = ShellWords.quote(PathTools.join(scratch.path(), f"{index}.out"));
                var problem = ShellWords.quote(PathTools.join(scratch.path(), f"{index}.err"));
                evaluations.push(BackgroundProcess.start("sh", ["-c", f"{self.instantiation(wanted.get(index))} > {output} 2> {problem}"], killOnDrop=true));
            }
            for (int offset = 0; offset < evaluations.length; offset++) {
                int index = start + offset;
                var path = evaluations.get(offset).wait() == 0 ? Path.readAll(PathTools.join(scratch.path(), f"{index}.out")).trim() : "";
                self.derivations.put(wanted.get(index), path.startsWith("/nix/store/") ? path : "unevaluated");
            }
        }
        scratch.close();
        self.saveDerivations();
    }

    public string derivationPath(string request) {
        self.loadDerivations();
        if (self.derivations.has(request)) { return self.derivations.get(request); }
        var evaluated = UnixShell().run(self.instantiation(request), logFailure=false);
        var path = evaluated.ok() ? evaluated.trimmed() : "";
        self.derivations.put(request, path.startsWith("/nix/store/") ? path : "unevaluated");
        self.saveDerivations();
        return self.derivations.get(request);
    }

    public void list() {
        GraphReport.list(self.graph);
    }

    public void status() {
        self.resolveDerivations(self.graph.nodes);
        for node in self.graph.nodes {
            var spec = self.specFor(node);
            var recorded = "missing";
            if (!node.enabled()) {
                recorded = "disabled";
            } else if (FileSystem.exists(spec.stateHashFile())) {
                var saved = Path.readAll(spec.stateHashFile()).trim();
                recorded = saved.equals(spec.stateHash) ? "ready" : "stale";
            }
            Console.log(node.id + " " + recorded + " " + spec.stateHashShort + " " + spec.stateDir() + " " + self.lastDuration(spec));
        }
    }

    public string durationFile(VmTestSpec spec) {
        return PathTools.join(spec.stateDir(), "duration");
    }

    // How long the node's last pass took, kept beside its recorded state.
    public string lastDuration(VmTestSpec spec) {
        var path = self.durationFile(spec);
        return FileSystem.exists(path) ? Path.readAll(path).trim() + "s" : "-";
    }

    public void resolve(Vector<string> targets) {
        for target in targets {
            Console.log(f"{target} -> {self.resolveHostTarget(target)}");
        }
    }

    public int operationCoverage() {
        Vector<string> covered = [];
        for node in self.graph.nodes {
            if (!node.enabled()) { continue; }  // a node that never runs covers nothing
            var spec = VmSpecParser.readFile(self.graph.resolvedSpecPath(node));
            for op in spec.operations {
                if (!op.kind.isEmpty() && !covered.contains(op.kind)) {
                    covered.push(op.kind);
                }
            }
        }

        Vector<string> missing = [];
        for kind in VmOperationCatalog.all() {
            if (!covered.contains(kind)) {
                missing.push(kind);
            }
        }
        if (!missing.isEmpty()) {
            Console.error("Missing e2e operation coverage: " + missing.join(", "));
            return 1;
        }

        Vector<string> seenRequired = [];
        Vector<string> duplicateRequired = [];
        Vector<string> emptyRequired = [];
        Vector<string> missingRequired = [];
        for id in self.graph.required {
            if (seenRequired.contains(id)) {
                duplicateRequired.push(id);
                continue;
            }
            seenRequired.push(id);
            if (!self.hasNode(id)) {
                missingRequired.push(id);
                continue;
            }
            var spec = VmSpecParser.readFile(self.graph.resolvedSpecPath(self.graph.node(id)));
            if (spec.operations.isEmpty()) {
                emptyRequired.push(id);
            }
        }
        if (!duplicateRequired.isEmpty()) {
            Console.error("Duplicate required e2e graph nodes: " + duplicateRequired.join(", "));
            return 1;
        }
        if (!missingRequired.isEmpty()) {
            Console.error("Missing required e2e graph nodes: " + missingRequired.join(", "));
            return 1;
        }
        if (!emptyRequired.isEmpty()) {
            Console.error("Required e2e graph nodes with no operations: " + emptyRequired.join(", "));
            return 1;
        }

        var traversal = GraphTraversal(self.graph);
        traversal.order(self.graph.required);
        if (!traversal.ok()) {
            Console.error("Invalid required e2e graph traversal: " + traversal.error);
            return 1;
        }

        Console.log("E2E operation coverage: " + Strings.fromInt(covered.len) + "/" + Strings.fromInt(VmOperationCatalog.all().len));
        int disabled = self.graph.required.len - self.graph.enabledTargets(self.graph.required).len;
        Console.log("E2E required graph nodes: " + Strings.fromInt(seenRequired.len) + "/" + Strings.fromInt(self.graph.required.len) + (disabled > 0 ? f", {disabled} disabled" : ""));
        return 0;
    }

    public bool force() {
        return self.args.getOrDefault("force", "false").equals("true");
    }

    public bool ready(VmTestSpec spec) {
        if (!FileSystem.exists(spec.stateHashFile())) { return false; }
        var saved = Path.readAll(spec.stateHashFile()).trim();
        return saved.equals(spec.stateHash);
    }

    public bool hasNode(string id) {
        for node in self.graph.nodes {
            if (node.id.equals(id)) { return true; }
        }
        return false;
    }

    public string resolveHostTarget(string target) {
        if (self.hasNode(target)) { return target; }
        var hostTarget = f"{target}-{VmSpecArgs.hostArch()}";
        if (self.hasNode(hostTarget)) {
            NixosLog.info(f"graph {self.graph.name}: host target {target} -> {hostTarget}");
            return hostTarget;
        }
        return target;
    }

    public bool architectureTarget(string target) {
        return target.endsWith("-x86_64") || target.endsWith("-aarch64");
    }

    public bool hostArchitectureTarget(string target) {
        return target.endsWith(f"-{VmSpecArgs.hostArch()}");
    }

    public Vector<string> hostRequiredTargets() {
        Vector<string> result = [];
        for target in self.graph.required {
            if (self.architectureTarget(target) && !self.hostArchitectureTarget(target)) {
                continue;
            }
            result.push(target);
        }
        return result;
    }

    public Vector<string> hostDefaultTargets() {
        Vector<string> result = [];
        for target in self.graph.defaultTargets() {
            if (self.architectureTarget(target) && !self.hostArchitectureTarget(target)) {
                continue;
            }
            result.push(target);
        }
        return result;
    }

    public Vector<string> resolveHostTargets(Vector<string> targets) {
        Vector<string> result = [];
        for target in targets {
            result.push(self.resolveHostTarget(target));
        }
        return result;
    }

    public string lockPath() {
        return PathTools.join(PathTools.join(self.graph.resolvedWorkspaceRoot(), ".vm"), "graph.lock");
    }

    // A run and a collection both change the VM state under the workspace, so one holds it at a time.
    public AdvisoryFileLock hold(string purpose) {
        FileSystem.mkdirp(PathTools.dirname(self.lockPath()));
        var locked = AdvisoryFileLock.acquire(self.lockPath());
        if (!locked.ok()) {
            NixosLog.fatal(f"graph {self.graph.name}: cannot {purpose} while another graph run or collection holds {self.lockPath()}");
        }
        return locked.value();
    }

    // A work directory is named for its state and the first twelve digits of that state's hash.
    public bool stateDirectoryName(string name) {
        if (name.length < 14 || name[name.length - 13] != '-') { return false; }
        for (int index = name.length - 12; index < name.length; index++) {
            char digit = name[index];
            if (!((digit >= '0' && digit <= '9') || (digit >= 'a' && digit <= 'f'))) { return false; }
        }
        return true;
    }

    // A work directory in use, and every directory its disk is a delta of.
    private void retain(Set<string> kept, string workDir) {
        var path = FileSystem.realPath(workDir);
        while (!path.isEmpty() && !kept.has(path)) {
            kept.add(path);
            var backing = PathTools.join(path, "backing-disk");
            if (!FileSystem.exists(backing)) { break; }
            path = FileSystem.realPath(PathTools.dirname(Path.readAll(backing).trim()));
        }
    }

    private bool vmAlive(string workDir) {
        var pidFile = PathTools.join(workDir, "vm.pid");
        if (!FileSystem.exists(pidFile)) { return false; }
        var pid = Path.readAll(pidFile).trim();
        return !pid.isEmpty() && FileSystem.exists(f"/proc/{pid}");
    }

    // Deletes the work directories under the workspace's .vm that no node's current state names,
    // after printing them. Each run with changed inputs leaves the directories of the states it replaced.
    public int collect(bool dryRun) {
        var lock = self.hold("collect state");
        var boundary = FileSystem.realPath(PathTools.join(self.graph.resolvedWorkspaceRoot(), ".vm"));
        Set<string> kept = {};
        Vector<string> roots = [];
        self.resolveDerivations(self.graph.nodes);
        for node in self.graph.nodes {
            var spec = self.specFor(node);
            self.retain(kept, spec.workDir);
            var root = FileSystem.realPath(PathTools.dirname(spec.workDir));
            if (root.isEmpty() || boundary.isEmpty() || !(root == boundary || root.startsWith(boundary + "/"))) { continue; }
            if (!roots.contains(root)) { roots.push(root); }
        }
        Vector<string> unreferenced = [];
        for root in roots {
            for name in FileSystem.listDir(root).sorted() {
                var path = PathTools.join(root, name);
                if (!self.stateDirectoryName(name) || FileSystem.isSymlink(path) || !FileSystem.isDir(path) || kept.has(path)) { continue; }
                if (self.vmAlive(path)) { NixosLog.info(f"graph {self.graph.name}: left {path}: its VM is still running"); continue; }
                unreferenced.push(path);
            }
        }
        for path in unreferenced { Console.log(path); }
        if (dryRun) {
            Console.log(f"graph gc: {unreferenced.length} state directories that no current node references; nothing deleted");
            return 0;
        }
        int failed = 0;
        for path in unreferenced {
            if (VmFiles.remove(path) != 0 || FileSystem.exists(path)) { failed++; NixosLog.error(f"could not delete {path}"); }
        }
        Console.log(f"graph gc: deleted {unreferenced.length - failed} state directories that no current node references");
        return failed == 0 ? 0 : 1;
    }

    // How many nodes run at once: `--arg jobs=N`, or one for every four processors, since a VM is given four.
    public int jobLimit() {
        if (self.args.has("jobs")) {
            int asked = Strings.toInt(self.args.get("jobs"));
            return asked < 1 ? 1 : asked;
        }
        int processors = 0;
        if (FileSystem.exists("/proc/cpuinfo")) {
            for line in Strings.split(Path.readAll("/proc/cpuinfo"), "\n") {
                if (line.startsWith("processor")) { processors++; }
            }
        }
        return processors < 8 ? 1 : processors / 4;
    }

    // The memory the running nodes may be given together, in megabytes: `--arg memoryBudget=48G`,
    // or three quarters of what the machine has.
    public int memoryBudget() {
        if (self.args.has("memoryBudget")) {
            var asked = VmTestSpec();
            asked.memory = self.args.get("memoryBudget");
            return asked.memoryMegabytes();
        }
        if (!FileSystem.exists("/proc/meminfo")) { return 8192; }
        for line in Strings.split(Path.readAll("/proc/meminfo"), "\n") {
            if (!line.startsWith("MemTotal:")) { continue; }
            var fields = Strings.split(line.replace("MemTotal:", "").trim(), " ");
            return Strings.toInt(fields.get(0)) / 1024 / 4 * 3;
        }
        return 8192;
    }

    // Whether something already listens on the port, found by trying to take it. Connecting to it
    // instead would reach another run's VM: its sshd counts a connection that never authenticates
    // against this host and then refuses the next ones.
    private bool occupied(int port) {
        try {
            TCPListener.listen(IPv4Address.any(), port).close();
            return false;
        } catch (string inUse) {
            return true;
        }
    }

    // A port no running node has and nothing on this machine listens on.
    private int freePort(Vector<GraphJob> running) {
        for (int port = 22300; port < 22600; port++) {
            var taken = false;
            for job in running { if (job.port == port) { taken = true; } }
            if (!taken && !self.occupied(port)) { return port; }
        }
        NixosLog.fatal("No free port for a VM between 22300 and 22599");
        return 0;
    }

    public string logPath(VmTestSpec spec, string id) {
        return PathTools.join(PathTools.join(PathTools.dirname(spec.stateRoot), "logs"), f"{id}.log");
    }

    // Runs one node in a child of its own, so several can run at once. With one job the child
    // writes straight to this terminal; with more, each writes its own log.
    private GraphJob start(GraphNode node, VmTestSpec spec, int port, bool streamed) {
        Vector<string> command = [FileSystem.realPath("/proc/self/exe"), "graph", self.graph.path, "run-node", node.id];
        for key, value in self.args {
            if (key == "sshPort") { continue; }
            command.push("--arg"); command.push(f"{key}={value}");
        }
        command.push("--arg"); command.push(f"sshPort={port}");
        var log = streamed ? "" : self.logPath(spec, node.id);
        if (streamed) {
            return GraphJob(node.id, BackgroundProcess.start(command.get(0), command.slice(1, command.length), killOnDrop=true), spec.memoryMegabytes(), port, log);
        }
        FileSystem.mkdirp(PathTools.dirname(log));
        Vector<string> words = ["exec"];
        for word in command { words.push(ShellWords.quote(word)); }
        var script = f"{words.join(" ")} > {ShellWords.quote(log)} 2>&1 < /dev/null";
        return GraphJob(node.id, BackgroundProcess.start("sh", ["-c", script], killOnDrop=true), spec.memoryMegabytes(), port, log);
    }

    // The node itself, in the child: its operations, then how long they took.
    public int runNode(string id) {
        var node = self.graph.node(id);
        var spec = self.specFor(node);
        var started = MonotonicClock.milliseconds();
        var result = VmTestRunner(spec).run();
        var seconds = (MonotonicClock.milliseconds() - started + 500LL) / 1000LL;
        if (result == 0 && FileSystem.isDir(spec.stateDir())) { Path.writeAll(self.durationFile(spec), f"{seconds}\n"); }
        return result;
    }

    private string tail(string path, int count) {
        if (!FileSystem.exists(path)) { return ""; }
        var lines = Strings.split(Path.readAll(path).trim(), "\n");
        return lines.slice(lines.length > count ? lines.length - count : 0, lines.length).join("\n");
    }

    public int run(Vector<string> targets) {
        var lock = self.hold("run");
        var traversal = GraphTraversal(self.graph);
        var asked = targets.isEmpty() ? self.hostDefaultTargets() : self.resolveHostTargets(targets);
        for id in asked {
            if (self.hasNode(id) && !self.graph.node(id).enabled()) { NixosLog.info(f"graph {self.graph.name}: disabled {id}: {self.graph.node(id).disabled}"); }
        }
        var selected = self.graph.enabledTargets(asked);
        if (selected.isEmpty()) { return 0; }  // an empty selection would otherwise mean the defaults
        var order = traversal.order(selected);
        if (!traversal.ok()) {
            NixosLog.fatal(traversal.error);
        }

        Vector<GraphNode> ordered = [];
        for id in order { ordered.push(self.graph.node(id)); }
        self.resolveDerivations(ordered);

        int jobs = self.jobLimit();
        int budget = self.memoryBudget();
        var name = self.graph.name;
        var began = MonotonicClock.milliseconds();
        Map<string, string> outcome = {};  // passed, skipped, failed, or blocked by a parent that failed
        Vector<string> failed = [];
        Vector<string> blocked = [];
        Vector<GraphJob> running = [];
        Vector<string> pending = order.copy();
        int passed = 0;
        int skipped = 0;
        while (!pending.isEmpty() || !running.isEmpty()) {
            Vector<GraphJob> still = [];
            for job in running {
                if (job.process.running()) { still.push(job); continue; }
                if (job.process.code() == 0) {
                    outcome.put(job.id, "passed"); passed++;
                    NixosLog.info(f"graph {name}: pass {job.id} in {job.seconds()}s");
                    continue;
                }
                outcome.put(job.id, "failed");
                failed.push(job.log.isEmpty() ? job.id : f"{job.id} ({job.log})");
                NixosLog.error(f"graph {name}: FAIL {job.id} after {job.seconds()}s");
                if (!job.log.isEmpty()) { Console.error(self.tail(job.log, 60)); }
            }
            running = still;

            Vector<string> waiting = [];
            for id in pending {
                var node = self.graph.node(id);
                var blocker = "";
                var parentsDone = true;
                for parent in node.after {
                    if (!outcome.has(parent)) { parentsDone = false; continue; }
                    var result = outcome.get(parent);
                    if (result == "failed" || result == "blocked") { blocker = parent; }
                }
                if (!blocker.isEmpty()) {
                    outcome.put(id, "blocked"); blocked.push(f"{id} (waits on {blocker})");
                    NixosLog.error(f"graph {name}: blocked {id}: {blocker} did not pass");
                    continue;
                }
                if (!parentsDone) { waiting.push(id); continue; }
                var spec = self.specFor(node);  // only now: a state's hash takes in its parent's recorded hash
                if (!self.force() && self.ready(spec)) {
                    outcome.put(id, "skipped"); skipped++;
                    NixosLog.info(f"graph {name}: skip {id} -> {spec.state}@{spec.stateHashShort}");
                    continue;
                }
                int used = 0;
                for job in running { used += job.memory; }
                if (running.length >= jobs || (!running.isEmpty() && used + spec.memoryMegabytes() > budget)) { waiting.push(id); continue; }
                NixosLog.info(f"graph {name}: run {id} -> {spec.state}@{spec.stateHashShort}");
                running.push(self.start(node, spec, self.freePort(running), jobs == 1));
            }
            pending = waiting;
            if (!running.isEmpty()) { Timer.sleepMillis(200); }
        }

        var seconds = (MonotonicClock.milliseconds() - began + 500LL) / 1000LL;
        Console.log(f"graph {name}: {passed} passed, {skipped} skipped, {failed.length} failed, {blocked.length} blocked in {seconds}s");
        for entry in failed { Console.log(f"  failed: {entry}"); }
        for entry in blocked { Console.log(f"  blocked: {entry}"); }
        return failed.isEmpty() && blocked.isEmpty() ? 0 : 1;
    }

    public int runRequired() {
        if (self.graph.required.isEmpty()) {
            NixosLog.fatal("Graph has no required nodes");
        }
        return self.run(self.hostRequiredTargets());
    }
}
