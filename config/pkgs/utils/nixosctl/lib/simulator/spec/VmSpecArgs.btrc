import Library.JSON;
import Library.Map;
import Library.Process;
import Library.Strings;
import ../../core/NixosLog.btrc;

class VmSpecArgs {
    class string hostArch() {
        var shell = UnixShell();
        var result = shell.run("uname -m");
        var machine = result.trimmed();
        if (machine.equals("arm64") || machine.equals("aarch64")) { return "aarch64"; }
        if (machine.equals("x86_64") || machine.equals("amd64")) { return "x86_64"; }
        NixosLog.fatal(f"Unsupported host architecture for e2e simulator: {machine}");
        return "";
    }

    class string defaultIsoUrl(string arch) {
        var isoVersion = "26.11pre1077143.44a91898084f";
        return f"https://releases.nixos.org/nixos/unstable/nixos-{isoVersion}/nixos-minimal-{isoVersion}-{arch}-linux.iso";
    }

    class string defaultIso(string arch) {
        return ".vm/e2e/iso/nixos-minimal-" + arch + ".iso";
    }

    class string expand(string text, Map<string, string> args) {
        string result = Strings.copy(text);
        for key, value in args {
            result = Strings.replace(result, "{{" + key + "}}", value);
        }
        for key, value in args {
            result = Strings.replace(result, "${" + key + "}", value);
        }
        return result;
    }
}
