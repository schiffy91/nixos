import Library.CLI;
import Library.Console;
import Library.FileSystem;
import Library.Platform;
import Library.Process;
import ../core/NixosLog.btrc;
import ../core/NixosPaths.btrc;
import ../NixosConfig.btrc;
import ./E2eCli.btrc;

// The VM lab: `vm`, `e2e` and `graph`. It is a program of its own so that the tool every machine and
// every test guest carries does not contain the test harness: an edit to the harness then changes no
// system, and the scenarios keyed on those systems keep their recorded results.
class NixosLab {
    public NixosConfig config;

    public NixosLab() { self.config = NixosConfig(NixosPaths.rootFromEnv()); }

    public void usage() {
        var help = CLIHelp();
        help.line("Usage: nixosctl <vm|e2e|graph> ...   (the VM lab; `nixosctl` hands these three to this program)");
        help.item("vm <build|run> [--target Standard-Boot|Secure-Boot]", "Boot the host config in a QEMU VM.");
        help.item("e2e <spec.json> [--arg key=value]...", "Run one scenario spec.");
        help.item("graph <graph.json> <command> [targets...]", "Run, list or collect the scenario graph.");
        help.print();
    }

    public bool needsTestShell(CLIArgs args) {
        if (Environment.get("NIXOS_BTRC_TEST_SHELL", "").equals("1")) { return false; }
        var command = args.command();
        if (command.equals("vm")) { return args.count() >= 3; }
        if (command.equals("e2e")) { return args.count() >= 2; }
        if (command.equals("graph")) { return args.count() >= 3; }
        return false;
    }

    public int nixShellSelf(CLIArgs args) {
        var shellPath = PathTools.join(self.config.paths.root, "tests/shell.nix");
        var runCmd = f"export NIXOS_BTRC_TEST_SHELL=1 && exec {ShellWords.quote(args.program)}";
        for value in args.values { runCmd = f"{runCmd} {ShellWords.quote(value)}"; }
        NixosLog.info(f"nixosctl {args.command()}: entering tests/shell.nix (qemu/swtpm/socat). First entry can take a minute.");
        var command = f"nix-shell {ShellWords.quote(shellPath)} --run {ShellWords.quote(runCmd)}";
        return UnixShell().run(command, stdout=COMMAND_OUTPUT_STREAM, stderr=COMMAND_OUTPUT_STREAM, foreground=true).code;  /* the inner run prompts on the tty */
    }

    public int run(CLIArgs args) {
        var command = args.count() == 0 ? "" : args.command();
        if (!command.equals("vm") && !command.equals("e2e") && !command.equals("graph")) {
            self.usage();
            return command.equals("help") || command.equals("--help") || command.equals("-h") ? 0 : 1;
        }
        if (self.needsTestShell(args)) { return self.nixShellSelf(args); }
        if (command.equals("vm")) { return E2eCli().runVm(args); }
        if (command.equals("e2e")) { return E2eCli().runE2e(args); }
        return E2eCli().runGraph(args);
    }
}

int main(int argc, char** argv) {
    try {
        return NixosLab().run(CLIArgs(argc, argv));
    } catch (string error) {
        NixosLog.error(error);
        return 1;
    }
}
