import Library.Console;
import Library.Process;
import Library.Strings;
import Library.Timer;
import Library.Vector;
import ../core/NixosLog.btrc;
import ./Spec.btrc;
import ./QemuE2eHarness.btrc;

class VmOperationCatalog {
    class Vector<string> all() {
        Vector<string> kinds = [];
        kinds.push("download-iso");
        kinds.push("require-tpm2");
        kinds.push("require-secure-boot");
        kinds.push("probe-secure-boot");
        kinds.push("require-state");
        kinds.push("inherit-state");
        kinds.push("record-state");
        kinds.push("validate-immutability-v2");
        kinds.push("reset-state");
        kinds.push("create-key");
        kinds.push("create-disk");
        kinds.push("boot-iso");
        kinds.push("boot-disk");
        kinds.push("up-iso");
        kinds.push("bootstrap-ssh");
        kinds.push("wait-ssh");
        kinds.push("expect-no-ssh");
        kinds.push("unlock-luks");
        kinds.push("send-keys");
        kinds.push("serial-send");
        kinds.push("wait-serial");
        kinds.push("sleep");
        kinds.push("guest");
        kinds.push("reboot-disk");
        kinds.push("reboot-recovery");
        kinds.push("host");
        kinds.push("build-derivation");
        kinds.push("qmp");
        kinds.push("copy-workspace");
        kinds.push("configure-vm-host");
        kinds.push("install-nixos");
        kinds.push("prepare-secure-boot-first-boot");
        kinds.push("enroll-secure-boot");
        kinds.push("copy-to");
        kinds.push("copy-from");
        kinds.push("snapshot");
        kinds.push("restore");
        kinds.push("stop");
        return kinds;
    }
}

class VmTestRunner {
    public VmTestSpec spec;
    public QemuE2eHarness vm;
    public int failures;

    public VmTestRunner(VmTestSpec spec) {
        self.spec = spec;
        self.vm = QemuE2eHarness(spec);
        self.failures = 0;
    }

    class VmTestRunner fromFile(string path) {
        var spec = VmSpecParser.readFile(path);
        spec.expandArgs();
        return VmTestRunner(spec);
    }

    public void fail(string message) {
        self.failures++;
        NixosLog.error(message);
    }

    public bool outputMatches(ExecResult result, string expect) {
        if (expect.isEmpty()) { return true; }
        return result.stdout().contains(expect);
    }

    public void assertResult(string label, ExecResult result, string expect) {
        if (!result.ok()) {
            Console.error(result.trimmed());
            Console.error(result.stderr().trim());  /* set -e failures only speak on stderr */
            self.fail(label + " failed with exit code " + Strings.fromInt(result.code));
            return;
        }
        if (!self.outputMatches(result, expect)) {
            Console.error(result.trimmed());
            self.fail(label + " output did not contain expected text: " + expect);
        }
    }

    // Builds the derivation the node is keyed on, so what ran is exactly what the key names. The log
    // stays in the work directory; a failure shows its last lines.
    public string derivationBuild(string options) {
        var derivation = self.spec.args.getOrDefault("derivation", "");
        var workDir = ShellWords.quote(self.spec.workDir);
        var log = ShellWords.quote(PathTools.join(self.spec.workDir, "test.log"));
        if (!derivation.startsWith("/nix/store/")) {  // it did not evaluate: say why
            return f"mkdir -p {workDir} && {VmSpecArgs.derivationQuestion(self.spec.derivation)} > {log} 2>&1; tail -80 {log}; exit 1";
        }
        return f"mkdir -p {workDir} && nix-store --realise {ShellWords.quote(derivation)} {options} > {log} 2>&1 || {{ tail -80 {log}; exit 1; }}";
    }

    public void runOperation(VmOperation op) {
        NixosLog.info("e2e " + self.spec.name + ": " + op.kind);

        if (op.kind.equals("download-iso")) {
            self.vm.downloadIso();
            return;
        }
        if (op.kind.equals("require-tpm2")) {
            self.vm.requireTpm2Capability();
            return;
        }
        if (op.kind.equals("require-secure-boot")) {
            self.vm.requireSecureBootCapability();
            return;
        }
        if (op.kind.equals("probe-secure-boot")) {
            Console.log(self.vm.secureBootCapabilityReport());
            return;
        }
        if (op.kind.equals("require-state")) {
            self.vm.requireParentState();
            return;
        }
        if (op.kind.equals("inherit-state")) {
            self.vm.inheritState();
            return;
        }
        if (op.kind.equals("record-state")) {
            self.vm.recordState();
            return;
        }
        if (op.kind.equals("validate-immutability-v2")) {
            var version = self.spec.args.getOrDefault("immutabilityVersion", "");
            if (!version.equals("v2")) {
                self.fail("btrc E2E specs must use immutabilityVersion=v2; v1 belongs only to the original Rust implementation");
            }
            return;
        }
        if (op.kind.equals("reset-state")) {
            self.vm.resetState();
            return;
        }
        if (op.kind.equals("create-key")) {
            self.vm.createSshKey();
            return;
        }
        if (op.kind.equals("create-disk")) {
            self.vm.createDisk();
            return;
        }
        if (op.kind.equals("boot-iso")) {
            self.vm.start(true);
            return;
        }
        if (op.kind.equals("boot-disk")) {
            self.vm.start(false);
            return;
        }
        if (op.kind.equals("up-iso")) {
            self.vm.upFromIso();
            return;
        }
        if (op.kind.equals("bootstrap-ssh")) {
            self.vm.bootstrapSsh();
            return;
        }
        if (op.kind.equals("wait-ssh")) {
            if (!self.vm.waitForSsh(op.timeout)) {
                self.fail("SSH was not ready after " + Strings.fromInt(op.timeout) + " seconds; serial log: " + self.vm.serialLogPath());
            }
            return;
        }
        if (op.kind == "expect-no-ssh") {
            if (!self.vm.staysWithoutSsh(op.timeout)) {
                self.fail(f"The guest answered SSH, or QEMU exited, within {op.timeout} seconds; serial log: {self.vm.serialLogPath()}");
            }
            return;
        }
        if (op.kind.equals("unlock-luks")) {
            if (!self.vm.unlockLuks(op.command, op.timeout)) {
                self.fail(f"LUKS unlock did not reach SSH within {op.timeout} seconds; serial log: {self.vm.serialLogPath()}");
            }
            return;
        }
        if (op.kind.equals("send-keys")) {
            if (!self.vm.sendKeys(op.command)) { self.fail("QMP refused the key events"); }
            return;
        }
        if (op.kind.equals("serial-send")) {
            self.vm.serialSend(op.command);
            return;
        }
        if (op.kind == "wait-serial") {
            if (!self.vm.waitForSerial(op.command, op.timeout)) {
                self.fail(f"The serial console did not show `{op.command}` within {op.timeout} seconds of the last text typed there; serial log: {self.vm.serialLogPath()}");
            }
            return;
        }
        if (op.kind.equals("sleep")) {
            self.vm.sleepSeconds(op.timeout);
            return;
        }
        if (op.kind.equals("guest")) {
            var result = self.vm.sshWithTimeout(op.command, false, op.timeout);
            self.assertResult("guest command", result, op.expect);
            return;
        }
        if (op.kind.equals("reboot-disk")) {
            self.vm.rebootDisk();
            return;
        }
        if (op.kind.equals("reboot-recovery")) {
            self.vm.rebootRecovery();
            return;
        }
        if (op.kind.equals("host")) {
            var result = self.vm.host(op.command, false, op.timeout);
            self.assertResult("host command", result, op.expect);
            return;
        }
        if (op.kind == "build-derivation") {
            var result = self.vm.host(self.derivationBuild(op.command), false, op.timeout);
            self.assertResult("derivation build", result, op.expect);
            return;
        }
        if (op.kind.equals("qmp")) {
            var result = self.vm.qmp(op.command, op.timeout);
            self.assertResult("qmp command", result, op.expect);
            return;
        }
        if (op.kind.equals("copy-workspace")) {
            self.vm.copyWorkspace(op.localPath, op.remotePath);
            return;
        }
        if (op.kind.equals("configure-vm-host")) {
            self.vm.configureVmHost();
            return;
        }
        if (op.kind.equals("install-nixos")) {
            self.vm.installNixosGuest();
            return;
        }
        if (op.kind.equals("prepare-secure-boot-first-boot")) {
            self.vm.prepareSecureBootFirstBootFallback();
            return;
        }
        if (op.kind.equals("enroll-secure-boot")) {
            self.vm.enrollSecureBoot();
            return;
        }
        if (op.kind.equals("copy-to")) {
            self.vm.copyTo(op.localPath, op.remotePath);
            return;
        }
        if (op.kind.equals("copy-from")) {
            self.vm.copyFrom(op.remotePath, op.localPath);
            return;
        }
        if (op.kind.equals("snapshot")) {
            self.vm.snapshot(op.name);
            return;
        }
        if (op.kind.equals("restore")) {
            self.vm.restore(op.name);
            return;
        }
        if (op.kind.equals("stop")) {
            self.vm.stop();
            return;
        }

        self.fail("Unknown VM operation: " + op.kind);
    }

    public int run() {
        if (self.spec.operations.len == 0) {
            NixosLog.fatal("VM spec has no operations");
        }
        for (int index = 0; index < self.spec.operations.len; index++) {
            if (self.failures > 0) { break; }
            var op = self.spec.operations.get(index);
            var started = MonotonicClock.milliseconds();
            self.runOperation(op);
            var seconds = (MonotonicClock.milliseconds() - started) / 1000;
            if (seconds >= 5) { NixosLog.info(f"e2e {self.spec.name}: step {index} ({op.kind}) took {seconds} s"); }  // where a long node's time goes
        }
        if (self.failures > 0) {
            self.vm.stop();
            return 1;
        }
        NixosLog.info("e2e " + self.spec.name + ": pass");
        return 0;
    }
}
