import Library.Console;
import Library.FileSystem;
import Library.Process;
import Library.Vector;
import ./core/Interactive.btrc;
import ./core/NixosLog.btrc;
import ./NixosConfig.btrc;
import ./SecretsManager.btrc;
import ./PermissionsManager.btrc;
import ./hardware/SecureBootVerification.btrc;

class RebuildOptions {
    public bool rebuildFileSystem;
    public bool reboot;
    public bool promptReboot;
    public bool clean;
    public bool upgrade;

    public RebuildOptions() {
        self.rebuildFileSystem = false;
        self.reboot = false;
        self.promptReboot = true;
        self.clean = false;
        self.upgrade = false;
    }
}

class NixosRebuilder {
    public NixosConfig config;
    public UnixShell shell;
    public Interactive interactive;

    public NixosRebuilder(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
        self.interactive = Interactive();
    }

    public ExecResult runNixCollectGarbage() {
        return self.shell.run(
            "nix-collect-garbage -d",
            stdout=COMMAND_OUTPUT_STREAM,
            stderr=COMMAND_OUTPUT_STREAM);
    }

    public ExecResult verifyStore() {
        return self.shell.run(
            "nix-store --verify --repair",
            stdout=COMMAND_OUTPUT_STREAM,
            stderr=COMMAND_OUTPUT_STREAM);
    }

    public ExecResult updateFlake() {
        return self.shell.run(
            f"nix flake update {self.config.linuxInputs().join(" ")} --flake {ShellWords.quote(self.config.paths.root)}",
            stdout=COMMAND_OUTPUT_STREAM,
            stderr=COMMAND_OUTPUT_STREAM);
    }

    // Modules drop executables here to refresh pins they own. Core knows nothing of what they are.
    public void runUpgradeHooks() {
        var directory = PathTools.join("/etc", self.config.evalString("config.settings.apps.utils.nixosctl.upgradeHooksDir"));
        if (!FileSystem.isDir(directory)) { return; }
        for name in FileSystem.listDir(directory).sorted() {
            var hook = PathTools.join(directory, name);
            if (FileSystem.isDir(hook)) { continue; }
            self.requireOk(f"upgrade hook {name}", self.shell.run(
                f"NIXOS_CONFIG_ROOT={ShellWords.quote(self.config.paths.root)} {ShellWords.quote(hook)}",
                stdout=COMMAND_OUTPUT_STREAM,
                stderr=COMMAND_OUTPUT_STREAM));
        }
    }

    public ExecResult switchSystem(RebuildOptions options) {
        Vector<string> env = [];
        if (options.rebuildFileSystem) {
            env.push("NIXOS_INSTALL_BOOTLOADER=1");
        }
        return self.shell.run(
            f"nixos-rebuild switch --flake {ShellWords.quote(self.config.flakeRef())}",
            stdout=COMMAND_OUTPUT_STREAM,
            stderr=COMMAND_OUTPUT_STREAM,
            env=env);
    }

    public void requireOk(string action, ExecResult result) {
        if (!result.ok()) {
            NixosLog.fatal(f"{action} failed");
        }
    }

    public void bootstrapConfigIfMissing(RebuildOptions options) {
        if (self.config.exists()) { return; }
        NixosLog.error(f"'{self.config.paths.configPath()}' is missing.");
        var hostPath = self.interactive.askHostPath(self.config.paths.hostsPath());
        self.config.reset(hostPath, self.config.standardTarget());
        options.rebuildFileSystem = true;
    }

    public string plainTextPasswordPath() {
        if (self.config.evalBool("config.settings.disk.encryption.enable")) {
            return self.config.evalString("config.settings.disk.encryption.plainTextPasswordFile");
        }
        return "";
    }

    public string homeManagerLogs() {
        var result = self.shell.run("journalctl -u 'home-manager-*.service' --no-pager -o cat -q -r", logFailure=false);
        Vector<string> lines = [];
        for line in Strings.split(result.stdout(), "\n") {
            if (line.equals("Starting Home Manager activation")) { break; }
            var systemdNoise = line.startsWith("Starting ")
                || line.startsWith("Stopping ")
                || line.startsWith("Stopped ")
                || line.startsWith("Finished ")
                || line.startsWith("Activating ");
            if (systemdNoise) {
                continue;
            }
            if (!line.trim().isEmpty()) { lines.push(line); }
        }
        lines.reverse();
        return lines.join("\n").trim();
    }

    public void update(RebuildOptions options) {
        self.bootstrapConfigIfMissing(options);
        if (self.config.target().equals(self.config.standardTarget())) {
            SecureBootVerification.requireDisabled();
        }
        var username = self.config.username();
        if (options.clean || options.upgrade) {
            self.requireOk("nix-collect-garbage", self.runNixCollectGarbage());
            FileSystem.removeRecursive("/root/.cache");
            self.requireOk("nix-store verify", self.verifyStore());
        }
        if (options.upgrade) {
            FileSystem.removeRecursive("/root/.cache");
            self.requireOk("nix flake update", self.updateFlake());
            self.runUpgradeHooks();
        }
        SecretsManager(self.config).createIfMissing("");
        PermissionsManager(self.config).secureTree(username);
        var result = self.switchSystem(options);
        if (!result.ok()) {
            NixosLog.fatal("nixos-rebuild switch failed");
        }
        PermissionsManager(self.config).secureTree(username);
        var logs = self.homeManagerLogs();
        if (!logs.isEmpty()) { Console.log(logs); }
        if (options.reboot) {
            self.shell.run(
                "shutdown -r now",
                stdout=COMMAND_OUTPUT_STREAM,
                stderr=COMMAND_OUTPUT_STREAM,
                throwOnFailure=true);
        } else if (options.promptReboot) {
            self.interactive.askToReboot();
        }
    }
}
