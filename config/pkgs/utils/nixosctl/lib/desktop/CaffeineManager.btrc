import Library.Process;

/* The idle inhibitor runs as its own user unit, so it outlives whatever turned it on
 * (a tray that restarts would otherwise take the inhibitor down with it). */
class CaffeineManager {
    public UnixShell shell;

    public CaffeineManager() {
        self.shell = UnixShell();
    }

    class string unit() { return "nixos-caffeine-inhibitor.service"; }

    public bool enabled() {
        return self.shell.run(f"systemctl --user is-active --quiet {CaffeineManager.unit()}", logFailure=false).ok();
    }

    public void enable() {
        if (self.enabled()) { return; }
        self.shell.run(f"systemctl --user reset-failed {CaffeineManager.unit()}", logFailure=false);
        var command = f"systemd-run --user --quiet --unit={CaffeineManager.unit()} --description='Caffeine: keep the session awake' "
            + "systemd-inhibit --what=idle --who=nixos --why='User disabled sleep' sleep infinity";
        self.shell.run(command, stdout=COMMAND_OUTPUT_STREAM, stderr=COMMAND_OUTPUT_STREAM, throwOnFailure=true);
    }

    public void disable() {
        self.shell.run(f"systemctl --user stop {CaffeineManager.unit()}", logFailure=false);
    }

    public void toggle() {
        if (self.enabled()) { self.disable(); }
        else { self.enable(); }
    }
}
