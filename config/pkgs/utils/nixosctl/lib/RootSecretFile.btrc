import Library.Bytes;
import Library.FileSystem;
import Library.Platform;
import Library.Strings;

/* The directory's public path is part of its authority: a root-owned leaf
 * under a user-writable ancestor would still let that user replace it. */
class RootSecretFile {
    private string path;
    private PrivateDirectory directory;
    private ExclusiveFileLease lease;

    public RootSecretFile(string path, string lockName = ".credentials.lock") {
        if (!Platform.isRoot()) { throw "Secret storage requires root"; }
        if (!path.startsWith("/") || path.endsWith("/")) { throw "Secret path must be absolute"; }
        var components = Strings.split(path, "/");
        var parent = "/";
        for (int index = 1; index < components.len; index++) {
            var part = components.get(index);
            if (part.isEmpty() || part.equals(".") || part.equals("..")) { throw "Invalid secret path"; }
            if (index == components.len - 1) { break; }
            RootSecretFile.requireRootDirectory(parent);
            parent = PathTools.join(parent, part);
            if (index < components.len - 2 && FileStatus(parent).isMissing()) {
                if (FileSystem.mkdir(parent, 0755) != 0 && !FileSystem.isDir(parent)) {
                    throw f"Cannot create secret ancestor: {parent}";
                }
            }
        }
        RootSecretFile.requireRootDirectory(PathTools.dirname(parent));
        var opened = PrivateDirectory.openAbsoluteLeaf(parent);
        if (!opened.ok()) { throw f"Unsafe secret directory: {parent}"; }
        self.directory = opened.value();
        var locked = self.directory.acquireExclusiveLease(lockName, wait=true);
        if (!locked.ok()) { throw "Cannot lock secret storage"; }
        self.lease = locked.value();
        self.path = path;
    }

    class void requireRootDirectory(string path) {
        if (!credentialRootDirectory(path)) {
            throw f"Secret ancestor must be a root-owned, non-writable directory: {path}";
        }
    }

    public PrivateFileReadOutcome read(int maximumBytes) {
        if (!self.directory.validatePath().ok()) { throw "Secret directory changed"; }
        var result = self.lease.readRegularChild(PathTools.basename(self.path), maximumBytes);
        if (!result.ok()) { throw "Cannot safely read secret storage"; }
        return result;
    }

    public void write(Bytes bytes) {
        if (!self.directory.validatePath().ok()) { throw "Secret directory changed"; }
        var result = self.lease.replaceRegularChildDurably(PathTools.basename(self.path), bytes);
        if (!result.committed()) { throw "Secret could not be durably stored"; }
    }

    public void remove() {
        if (!self.directory.validatePath().ok()) { throw "Secret directory changed"; }
        if (!self.lease.removeRegularChildDurably(PathTools.basename(self.path)).committed()) {
            throw "Secret could not be removed";
        }
    }

    public void close() { self.lease.close(); }
}
