import Library.Console;
import Library.FileSystem;
import Library.Process;
import Library.Strings;
import ../NixosConfig.btrc;

class Tpm2Manager {
    public NixosConfig config;
    public UnixShell shell;

    public Tpm2Manager(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
    }

    public string listedDevice() {
        var result = self.shell.run(
            "systemd-cryptenroll --tpm2-device=list",
            stderr=COMMAND_OUTPUT_SUPPRESS,
            logFailure=false);
        if (!result.ok()) { return ""; }
        for line in Strings.split(result.stdout(), "\n") {
            var trimmed = line.trim();
            if (trimmed.startsWith("/dev/tpm")) {
                return Strings.split(trimmed, " ").get(0);
            }
        }
        return "";
    }

    public bool configuredDeviceExists() {
        var device = ShellWords.quote(self.config.tpmDevice());
        return FileSystem.exists(self.config.tpmDevice())
            || self.shell.run(f"test -e {device}", stderr=COMMAND_OUTPUT_SUPPRESS, logFailure=false).ok();
    }

    public bool configuredVersionIsTpm2() {
        var version = Path.readAll(self.config.tpmVersionPath()).trim();
        return version.equals("2");
    }

    public bool sysfsVersionIsTpm2() {
        if (!FileSystem.isDir("/sys/class/tpm")) { return false; }
        for device in FileSystem.listDir("/sys/class/tpm") {
            var versionPath = PathTools.join(PathTools.join("/sys/class/tpm", device), "tpm_version_major");
            if (Path.readAll(versionPath).trim().equals("2")) { return true; }
        }
        return false;
    }

    public bool exists() {
        if (!self.listedDevice().isEmpty()) { return true; }
        if (self.configuredDeviceExists() && self.configuredVersionIsTpm2()) { return true; }
        return self.sysfsVersionIsTpm2();
    }

    public string enrollmentDevice() {
        if (self.configuredDeviceExists()) { return self.config.tpmDevice(); }
        var listed = self.listedDevice();
        if (!listed.isEmpty()) { return listed; }
        return "auto";
    }

    public bool diskEncrypted() {
        var result = self.shell.run(f"cryptsetup isLuks {ShellWords.quote(self.config.rootPartLabelPath())}", logFailure=false);
        return result.ok();
    }

    public bool enroll() {
        var command = f"systemd-cryptenroll {ShellWords.quote(self.config.rootPartLabelPath())}";
        command = f"{command} --wipe-slot=tpm2 --tpm2-device={ShellWords.quote(self.enrollmentDevice())} --tpm2-pcrs=7+12";
        return self.shell.run(
            command,
            stdout=COMMAND_OUTPUT_STREAM,
            stderr=COMMAND_OUTPUT_STREAM,
            logFailure=false,
            foreground=true).ok();  /* ask-password must own the tty to disable echo */
    }

    public bool wipe() {
        var command = f"systemd-cryptenroll {ShellWords.quote(self.config.rootPartLabelPath())} --wipe-slot=tpm2";
        return self.shell.run(
            command,
            stdout=COMMAND_OUTPUT_STREAM,
            stderr=COMMAND_OUTPUT_STREAM,
            logFailure=false).ok();
    }

    public void status() {
        Console.log(f"TPM2 configured device: {self.config.tpmDevice()}");
        var listed = self.listedDevice();
        if (!listed.isEmpty()) {
            Console.log(f"TPM2 detected device: {listed}");
        }
        self.shell.run(
            f"systemd-cryptenroll --tpm2-device=list {ShellWords.quote(self.config.rootPartLabelPath())}",
            stdout=COMMAND_OUTPUT_STREAM,
            stderr=COMMAND_OUTPUT_STREAM,
            logFailure=false);
        self.shell.run(
            f"cryptsetup luksDump {ShellWords.quote(self.config.rootPartLabelPath())}",
            stdout=COMMAND_OUTPUT_STREAM,
            stderr=COMMAND_OUTPUT_STREAM,
            logFailure=false);
    }
}
