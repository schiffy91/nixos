import Library.FileSystem;
import Library.Platform;
import Library.Process;
import ./NixosConfig.btrc;

class PermissionsManager {
    public NixosConfig config;
    public UnixShell shell;
    public string enterRoot;  // installed-system root, or "" for the live system

    public PermissionsManager(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
        self.enterRoot = "";
    }

    /* The stdlib's UnixShell.chroot wrapped every command in nixos-enter; it is
     * gone, so apply the same wrapper here for the installer's offline tree. */
    public string inRoot(string command) {
        if (self.enterRoot.isEmpty()) { return command; }
        return f"nixos-enter --root {ShellWords.quote(self.enterRoot)} --command {ShellWords.quote(command)}";
    }

    public string ignorePredicate() {
        var secrets = ShellWords.quote("*/secrets*");
        var venv = ShellWords.quote("*/.venv*");
        var direnv = ShellWords.quote("*/.direnv*");
        return f"\\( -path {secrets} -o -path {venv} -o -path {direnv} \\)";
    }

    public void chmodMatching(string quotedRoot, string ignores, string predicate, string mode) {
        var execArg = "{}";
        var prune = ignores.isEmpty() ? "" : f"{ignores} -prune -o";
        var command = f"find {quotedRoot} {prune} {predicate} -exec chmod -h {mode} {execArg} +";
        self.shell.run(
            self.inRoot(command),
            stdout=COMMAND_OUTPUT_STREAM,
            stderr=COMMAND_OUTPUT_STREAM,
            throwOnFailure=true);
    }

    public void secureSecretsPath(string path) {
        var quoted = ShellWords.quote(path);
        if (!self.shell.run(self.inRoot(f"test ! -L {quoted}"), logFailure=false).ok()) {
            throw "Secret directory must not be a symlink";
        }
        if (!self.shell.run(self.inRoot(f"test -d {quoted}"), logFailure=false).ok()) { return; }
        if (Platform.isRoot()) {
            self.shell.run(
                self.inRoot(f"chown -hRP root:root {quoted}"),
                stdout=COMMAND_OUTPUT_STREAM,
                stderr=COMMAND_OUTPUT_STREAM,
                throwOnFailure=true);
        }
        var execArg = "{}";
        self.shell.run(
            self.inRoot(f"find {quoted} -type d -exec chmod -h 700 {execArg} +"),
            stdout=COMMAND_OUTPUT_STREAM,
            stderr=COMMAND_OUTPUT_STREAM,
            throwOnFailure=true);
        self.shell.run(
            self.inRoot(f"find {quoted} -type f -exec chmod -h 600 {execArg} +"),
            stdout=COMMAND_OUTPUT_STREAM,
            stderr=COMMAND_OUTPUT_STREAM,
            throwOnFailure=true);
    }

    public void trustGitDirectory(string path) {
        var quoted = ShellWords.quote(path);
        var exists = self.shell.run(self.inRoot(f"git config --global --get-all safe.directory | grep -Fx -- {quoted} >/dev/null"), logFailure=false);
        if (exists.ok()) { return; }
        self.shell.run(
            self.inRoot(f"git config --global --add safe.directory {quoted}"),
            stdout=COMMAND_OUTPUT_STREAM,
            stderr=COMMAND_OUTPUT_STREAM,
            logFailure=false);
    }

    public void secureTree(string username) {
        var root = self.config.paths.root;
        var quotedRoot = ShellWords.quote(root);
        var ignores = self.ignorePredicate();
        if (Platform.isRoot()) {
            var execArg = "{}";
            self.shell.run(
                self.inRoot(f"find {quotedRoot} {ignores} -prune -o -exec chown -h {ShellWords.quote(username)} {execArg} +"),
                stdout=COMMAND_OUTPUT_STREAM,
                stderr=COMMAND_OUTPUT_STREAM,
                throwOnFailure=true);
        }

        // chmod follows symlink operands, including store links and broken VM links.
        self.chmodMatching(quotedRoot, ignores, "\\( -type f -o -type d \\)", "u+rwX,go=rX");
        var gitObjects = PathTools.join(root, ".git/objects");
        if (FileSystem.exists(gitObjects)) {
            var quotedGitObjects = ShellWords.quote(gitObjects);
            var execArg = "{}";
            self.shell.run(
                self.inRoot(f"find {quotedGitObjects} -type f -exec chmod -h 444 {execArg} +"),
                stdout=COMMAND_OUTPUT_STREAM,
                stderr=COMMAND_OUTPUT_STREAM,
                throwOnFailure=true);
        }

        self.trustGitDirectory(root);

        self.secureSecretsPath(self.config.exists()
            ? self.config.secretsPath() : self.config.paths.secretsPathFallback());
    }
}
