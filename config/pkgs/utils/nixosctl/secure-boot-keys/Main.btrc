import Library.CLI;
import Library.Console;
import Library.Platform;
import ./Archive.btrc;
import ./Crypto.btrc;
import ./Files.btrc;

int main(int argc, char** argv) {
    try {
        if (!Platform.isRoot() || Platform.uid() != 0) { throw "Secure Boot key transfer requires root"; }
        if (!keyFilesDisableDumps()) { throw "Could not disable process dumps"; }
        Platform.setUmask(0o077);
        var args = CLIArgs(argc, argv);
        if (args.count() != 2 || !(args.get(0).equals("export") || args.get(0).equals("import") || args.get(0).equals("verify"))) {
            throw "Usage: nixosctl secure-boot keys <export|import|verify> /absolute/bundle/path";
        }
        var action = args.get(0);
        var path = args.get(1);
        KeyFiles.components(path);
        Map<string, Bytes> files = {};
        if (action.equals("import")) {
            if (KeyFiles.stdinIsTty()) { throw "Import requires a private archive on stdin"; }
            files = KeyArchive.decode(KeyFiles.readStdin(1048576));
        } else { files = KeyFiles.readBundle(path); }
        var report = KeyCrypto.verify(files);
        if (action.equals("export")) {
            if (Console.isTty()) { throw "Refusing to print private keys to a terminal; pipe directly to the remote importer"; }
            KeyFiles.writeStdout(KeyArchive.encode(files));
        } else if (action.equals("import")) {
            KeyFiles.publish(files, path);
            Console.error("Secure Boot key bundle imported and verified.");
        } else { print(report.document()); }
        return 0;
    } catch (string error) {
        // Only our fixed diagnostic strings reach this boundary, never key bytes.
        Console.error(f"{error}");
        return 1;
    }
}
