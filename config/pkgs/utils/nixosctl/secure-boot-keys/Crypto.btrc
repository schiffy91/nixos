import Library.Bytes;
import Library.JSON;
import Library.Map;
import Library.Strings;

class KeyCrypto {
    class void limitVerification(int seconds = 10) {
        if (!secureBootVerificationDeadline(seconds)) { throw "Could not enforce key verification deadline"; }
    }

    class string guid(Bytes bytes) {
        if (!bytes.isNulFreeUtf8()) { throw "Invalid sbctl owner GUID"; }
        var text = bytes.toString().trim().toLower();
        if (text.startsWith("urn:uuid:")) { text = text.substring(9, text.length() - 9); }
        if (text.startsWith("{") && text.endsWith("}")) { text = text.substring(1, text.length() - 2); }
        text = text.replace("-", "");
        if (text.length() != 32) { throw "Invalid sbctl owner GUID"; }
        for (int index = 0; index < text.length(); index++) {
            if (!((text[index] >= '0' && text[index] <= '9') || (text[index] >= 'a' && text[index] <= 'f'))) { throw "Invalid sbctl owner GUID"; }
        }
        return f"{text.substring(0, 8)}-{text.substring(8, 4)}-{text.substring(12, 4)}-{text.substring(16, 4)}-{text.substring(20, 12)}";
    }

    class string verifyPair(Bytes privateBytes, Bytes certificateBytes) {
        // Untrusted key parameters must not make root spend unbounded CPU time.
        KeyCrypto.limitVerification();
        try {
            var key = secureBootPrivateKeyRead(privateBytes.data, privateBytes.length());
            if (key == null) { throw "Invalid Secure Boot private key"; }
            if (!secureBootPrivateKeyValid(key)) { throw "Invalid Secure Boot private key"; }
            var certificate = secureBootCertificateRead(certificateBytes.data, certificateBytes.length());
            if (certificate == null) { throw "Invalid Secure Boot certificate"; }
            if (!secureBootKeyMatches(key, certificate)) { throw "Secure Boot private key does not match its certificate"; }
            var fingerprint = secureBootCertificateFingerprint(certificate);
            if (fingerprint == null) { throw "Could not fingerprint Secure Boot certificate"; }
            return fingerprint;
        } finally {
            secureBootVerificationFinished();
        }
    }

    class JSONValue verify(Map<string, Bytes> files) {
        var report = JSONValue.makeObject();
        report.set("guid", JSONValue.makeString(KeyCrypto.guid(files.get("GUID"))));
        var fingerprints = JSONValue.makeObject();
        for name in ["PK", "KEK", "db"] {
            fingerprints.set(name, JSONValue.makeString(KeyCrypto.verifyPair(files.get(f"keys/{name}/{name}.key"), files.get(f"keys/{name}/{name}.pem"))));
        }
        report.set("certificateSha256", fingerprints);
        return report;
    }
}
