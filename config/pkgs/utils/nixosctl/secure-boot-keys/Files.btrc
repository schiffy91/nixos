import Library.Bytes;
import Library.FileSystem;
import Library.Map;
import Library.Strings;
import Library.Vector;
import ./Archive.btrc;

class KeyPublicationSignals {
    private KeySignalGuardHandle? guard = null;

    public KeyPublicationSignals() {
        var acquired = keySignalGuardAcquire();
        if (acquired == null) { throw "Could not protect atomic key publication"; }
        self.guard = acquired;
    }

    public void close() {
        var current = self.guard;
        if (current != null) {
            keySignalGuardClose(current);
            self.guard = null;
        }
    }

    public void __del__() { self.close(); }
}

class KeyFiles {
    class Vector<string> components(string path) {
        if (!path.startsWith("/") || path.equals("/") || path.equals("/nix/store") || path.startsWith("/nix/store/")) {
            throw "Use an absolute bundle path outside the Nix store";
        }
        Vector<string> parts = [];
        var all = Strings.split(path, "/");
        for (int index = 1; index < all.length; index++) {
            var part = all.get(index);
            if (part.isEmpty() || part.equals(".") || part.equals("..")) { throw "Bundle paths cannot contain empty or relative components"; }
            parts.push(part);
        }
        return parts;
    }

    class Vector<string> parent(Vector<string> parts) {
        Vector<string> result = [];
        for (int index = 0; index < parts.length - 1; index++) { result.push(parts.get(index)); }
        return result;
    }

    class int openDirectory(Vector<string> parts, bool create = false, int initial = -1) {
        var descriptor = keyFilesOpenInitialDirectory(initial);
        if (descriptor < 0) {
            throw "Bundle ancestors must be root-owned directories without group/other write access";
        }
        for part in parts {
            descriptor = keyFilesStepDirectory(descriptor, part, create);
            if (descriptor == -2) { throw "Could not sync bundle directory"; }
            if (descriptor == -3) { throw "Could not create bundle directory"; }
            if (descriptor < 0) {
                throw "Bundle ancestors must be root-owned directories without group/other write access";
            }
        }
        return descriptor;
    }

    class bool stdinIsTty() {
        return keyFilesStdinIsTty();
    }

    class Bytes readStdin(int limit) {
        var handle = keyFilesReadStdin(limit);
        if (handle == null) { throw "Could not read complete key bundle"; }
        int code = keyBytesError(handle);
        if (code == 2) { throw "Oversized key bundle input"; }
        if (code != 0) { throw "Could not read complete key bundle"; }
        var bytes = keyBytesData(handle);
        return bytes == null ? Bytes() : bytes;
    }

    class void writeStdout(Bytes bytes) {
        if (!keyFilesWriteStdoutHex(bytes.toHex())) {
            throw "Could not write complete key bundle";
        }
    }

    class Map<string, Bytes> readBundle(string path) {
        var bundle = KeyFiles.openDirectory(KeyFiles.components(path));
        Map<string, Bytes> files = {};
        try {
            for name in KeyArchive.members() {
                var parts = Strings.split(name, "/");
                var parent = KeyFiles.openDirectory(KeyFiles.parent(parts), initial=bundle);
                try {
                    var handle = keyFilesReadMember(parent, parts.get(parts.length - 1), name.endsWith(".key"), 65536);
                    if (handle == null) { throw "Could not open key bundle file"; }
                    int code = keyBytesError(handle);
                    if (code == 10) { throw "Could not open key bundle file"; }
                    if (code == 11) { throw "Unsafe key bundle file type, ownership, link count, or permissions"; }
                    if (code == 12) { throw "Empty key bundle file"; }
                    if (code == 2) { throw "Oversized key bundle input"; }
                    if (code != 0) { throw "Could not read complete key bundle"; }
                    var bytes = keyBytesData(handle);
                    if (bytes == null || bytes.isEmpty()) { throw "Empty key bundle file"; }
                    files.put(name, bytes);
                } finally { keyFilesCloseDescriptor(parent); }
            }
        } finally { keyFilesCloseDescriptor(bundle); }
        return files;
    }

    class string stagingName() {
        var handle = keyFilesStagingName();
        if (handle == null) { throw "Could not reserve key staging name"; }
        var name = keyTextValue(handle);
        if (name == null || name.isEmpty()) { throw "Could not reserve key staging name"; }
        return name;
    }

    class void publish(Map<string, Bytes> files, string path) {
        // Finish or clean up the private staging tree before honoring termination.
        var signals = KeyPublicationSignals();
        var parts = KeyFiles.components(path);
        var parent = KeyFiles.openDirectory(KeyFiles.parent(parts), create=true);
        var name = parts.get(parts.length - 1);
        var staged = KeyFiles.stagingName();
        var stage = -1;
        var created = false;
        var published = false;
        try {
            if (!keyFilesDestinationAbsent(parent, name)) {
                throw "Destination already exists or cannot be checked; no keys were overwritten";
            }
            if (!keyFilesCreateStagingRoot(parent, staged)) {
                throw "Could not create private key staging directory";
            }
            created = true;
            stage = KeyFiles.openDirectory([staged], initial=parent);
            for member in KeyArchive.members() {
                var relative = Strings.split(member, "/");
                var directory = KeyFiles.openDirectory(KeyFiles.parent(relative), create=true, initial=stage);
                try {
                    int written = keyFilesWriteStagedMemberHex(directory, relative.get(relative.length - 1), files.get(member).toHex());
                    if (written == -1) { throw "Could not stage key bundle file"; }
                    if (written == -2) { throw "Could not write complete key bundle"; }
                    if (written != 0) { throw "Could not sync key bundle file"; }
                } finally { keyFilesCloseDescriptor(directory); }
            }
            if (!keyFilesPublishStaged(parent, stage, staged, name)) {
                throw "Could not atomically publish key bundle; no existing keys were overwritten";
            }
            published = true;
            if (!keyFilesSyncDirectory(parent)) {
                throw "Key bundle was published but its directory could not be synced";
            }
        } finally {
            if (!published && stage >= 0) {
                for member in KeyArchive.members() { keyFilesRemoveStagedFile(stage, member); }
                for directory in ["keys/db", "keys/KEK", "keys/PK", "keys"] { keyFilesRemoveStagedDirectory(stage, directory); }
            }
            keyFilesCloseDescriptor(stage);
            if (!published && created) { keyFilesRemoveStagedDirectory(parent, staged); }
            keyFilesCloseDescriptor(parent);
            signals.close();
        }
    }
}
