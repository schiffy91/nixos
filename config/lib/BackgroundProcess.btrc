import Library.Process;
import Library.Timer;

#include <spawn.h>
#include <signal.h>
#include <sys/wait.h>
extern int posix_spawn_file_actions_addclosefrom_np(posix_spawn_file_actions_t* actions, int first);

class BackgroundProcess {
    public int pid;
    public bool exited;
    public int code;

    public BackgroundProcess(int pid) { self.pid = pid; self.exited = false; self.code = -1; }

    class BackgroundProcess start(string command, Vector<string> arguments, Vector<string> environment = []) {
        var executable = ChildProcessExecutable.resolve(command, "", environment, []);
        if (executable.isEmpty()) { throw f"Cannot find {command}"; }
        char** argv = ChildProcessArguments.build(executable, arguments);
        char** env = ChildProcessEnvironment.build(environment, []);
        char* path = strdup(executable);
        if (argv == NULL || env == NULL || path == NULL) {
            free(path); CStringArray.freeAll(argv); CStringArray.freeAll(env);
            throw "Cannot allocate child process arguments";
        }
        pid_t pid = (pid_t)0;
        posix_spawn_file_actions_t actions;
        int initialized = posix_spawn_file_actions_init(&actions);
        int error = initialized;
        // Linux launchers inherit standard streams, never unrelated caller files.
        if (error == 0) { error = posix_spawn_file_actions_addclosefrom_np(&actions, 3); }
        if (error == 0) { error = posix_spawn(&pid, path, &actions, NULL, argv, env); }
        if (initialized == 0) { posix_spawn_file_actions_destroy(&actions); }
        free(path);
        CStringArray.freeAll(argv);
        CStringArray.freeAll(env);
        if (error != 0) { throw f"Cannot start {command}"; }
        return BackgroundProcess((int)pid);
    }

    public bool running() {
        if (self.exited) { return false; }
        int status = 0;
        var result = waitpid((pid_t)self.pid, &status, WNOHANG);
        if (result == (pid_t)0 || (result < (pid_t)0 && errno == EINTR)) { return true; }
        self.exited = true;
        self.code = result > (pid_t)0 ? ProcessStatus(status).code() : 1;
        return false;
    }

    public void stop(int graceMilliseconds = 2000) {
        if (!self.running()) { return; }
        kill((pid_t)self.pid, SIGTERM);
        var deadline = MonotonicClock.deadlineAfter((long long)graceMilliseconds);
        while (self.running() && MonotonicClock.before(deadline)) { usleep(10000); }
        if (self.running()) {
            kill((pid_t)self.pid, SIGKILL);
            int status = 0;
            while (waitpid((pid_t)self.pid, &status, 0) < (pid_t)0 && errno == EINTR) {}
            self.exited = true;
            self.code = 137;
        }
    }
}
