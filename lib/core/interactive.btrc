class Interactive {
    public UnixShell shell;

    public Interactive() {
        self.shell = UnixShell();
    }

    public string ask(string prompt) {
        string command = "printf "
            + UnixShell.quote(prompt + " ")
            + " >&2; IFS= read -r value; printf '%s' \"$value\"";
        ExecResult result = self.shell.runRaw(command, true, false, "");
        return result.stdout();
    }

    public bool confirm(string prompt) {
        while (true) {
            string response = self.ask(prompt + " (y/n):").toLower().trim();
            if (response.equals("y") || response.equals("yes")) { return true; }
            if (response.equals("n") || response.equals("no")) { return false; }
            Console.error("Invalid input. Enter 'y' or 'n'.");
        }
        return false;
    }

    public string askPassword(string prompt) {
        string command = "printf "
            + UnixShell.quote(prompt + ": ")
            + " >&2; stty -echo; IFS= read -r value; stty echo; printf '\\n' >&2; printf '%s' \"$value\"";
        ExecResult result = self.shell.runRaw(command, true, false, "");
        return result.stdout();
    }

    public string askPasswordConfirmed(string prompt) {
        while (true) {
            string first = self.askPassword(prompt);
            string second = self.askPassword("Confirm password");
            if (first.equals(second)) { return first; }
            NixosLog.error("Passwords do not match.");
        }
        return "";
    }

    public string askHostPath(string hostsPath) {
        ExecResult found = self.shell.runUnchecked("find " + UnixShell.quote(hostsPath) + " -type f -name '*.nix' | sort");
        Vector<string> candidates = [];
        for line in Strings.split(found.stdout(), "\n") {
            string path = line.trim();
            if (path.isEmpty()) { continue; }
            string hostName = Strings.replace(PathTools.basename(path), ".nix", "");
            string hostDir = PathTools.basename(PathTools.dirname(path));
            if (hostName.equals(hostDir)) {
                candidates.push(path);
            }
        }
        if (candidates.len == 0) {
            NixosLog.fatal("No host files found under " + hostsPath);
        }
        while (true) {
            for (int i = 0; i < candidates.len; i++) {
                string path = candidates.get(i);
                string hostName = Strings.replace(PathTools.basename(path), ".nix", "");
                string arch = PathTools.basename(PathTools.dirname(PathTools.dirname(path)));
                Console.error(Strings.fromInt(i + 1) + ") " + hostName + " (" + arch + ")");
            }
            int selected = Strings.toInt(self.ask(">").trim()) - 1;
            if (selected >= 0 && selected < candidates.len) {
                return candidates.get(selected);
            }
            NixosLog.error("Invalid choice.");
        }
        return candidates.get(0);
    }

    public void askToReboot() {
        if (self.confirm("Restart now?")) {
            Command reboot = Command("shutdown")
                .arg("-r")
                .arg("now")
                .capture(false);
            self.shell.runCommand(reboot);
        }
    }
}
