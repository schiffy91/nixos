class PermissionsManager {
    public NixosConfig config;
    public UnixShell shell;

    public PermissionsManager(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
    }

    public string ignorePredicate(string quotedRoot) {
        return "\\( -path " + UnixShell.quote("*/secrets*")
            + " -o -path " + UnixShell.quote("*/.venv*")
            + " -o -path " + UnixShell.quote("*/.direnv*")
            + " \\)";
    }

    public void secureSecretsPath(string path) {
        if (!FileSystem.exists(path)) { return; }
        string quoted = UnixShell.quote(path);
        if (Platform.isRoot()) {
            self.shell.runRaw("chown -R root:root " + quoted, false, false, "");
        }
        self.shell.runRaw("find " + quoted + " -type d -exec chmod 700 {} +", false, false, "");
        self.shell.runRaw("find " + quoted + " -type f -exec chmod 600 {} +", false, false, "");
    }

    public void secureTree(string username) {
        string root = self.config.paths.root;
        if (Platform.isRoot()) {
            Command chownRoot = Command("chown");
            chownRoot.arg("-R");
            chownRoot.arg(username);
            chownRoot.arg(root);
            chownRoot.capture(false);
            self.shell.runCommand(chownRoot);
        }

        string quotedRoot = UnixShell.quote(root);
        string ignores = self.ignorePredicate(quotedRoot);
        self.shell.runRaw("find " + quotedRoot + " " + ignores + " -prune -o -type d -exec chmod 755 {} +", false, false, "");
        self.shell.runRaw("find " + quotedRoot + " " + ignores + " -prune -o -type f -exec chmod 644 {} +", false, false, "");
        self.shell.runRaw("find " + quotedRoot + " " + ignores + " -prune -o \\( -path '*/scripts/*' -o -path '*/bin/*' \\) -exec chmod 755 {} +", false, false, "");
        string gitObjects = PathTools.join(root, ".git/objects");
        if (FileSystem.exists(gitObjects)) {
            self.shell.runRaw("find " + UnixShell.quote(gitObjects) + " -type f -exec chmod 444 {} +", false, false, "");
        }

        Command safe = Command("git");
        safe.arg("config");
        safe.arg("--global");
        safe.arg("--add");
        safe.arg("safe.directory");
        safe.arg(root);
        safe.capture(false);
        safe.check(false);
        self.shell.runCommand(safe);

        if (self.config.exists()) {
            SecretsManager(self.config).secure();
        } else {
            self.secureSecretsPath(self.config.paths.secretsPathFallback());
        }
    }
}
