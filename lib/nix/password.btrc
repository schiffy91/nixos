class PasswordManager {
    public NixosConfig config;
    public UnixShell shell;
    public SecretsManager secrets;

    public PasswordManager(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
        self.secrets = SecretsManager(config);
    }

    public bool changeLuksPassword(string oldPassword, string newPassword) {
        string command = "printf '%s\\n%s' "
            + UnixShell.quote(oldPassword)
            + " "
            + UnixShell.quote(newPassword)
            + " | cryptsetup luksChangeKey "
            + UnixShell.quote(self.config.rootPartLabelPath());
        ExecResult result = self.shell.runRaw(command, false, false, oldPassword);
        return result.ok();
    }

    public void fallbackChangeUserPassword(string user, string password) {
        string command = "printf '%s:%s\\n' "
            + UnixShell.quote(user)
            + " "
            + UnixShell.quote(password)
            + " | chpasswd";
        ExecResult changed = self.shell.runRaw(command, false, false, password);
        if (!changed.ok()) {
            NixosLog.error("Fallback account password update failed.");
        }
    }

    public void changeUserPassword(string oldPassword, string password) {
        string user = self.config.username();
        if (!UnixPamPassword.change(user, oldPassword, password)) {
            NixosLog.error("PAM password update failed; falling back to chpasswd. KDE Wallet may need manual repair.");
            self.fallbackChangeUserPassword(user, password);
        }
        string hashed = self.secrets.hashPassword(password);
        self.secrets.writeHashedPassword(hashed);
        RebuildOptions options = RebuildOptions();
        NixosRebuilder(self.config).update(options);
    }

    public void updateTpm2() {
        Tpm2Manager tpm = Tpm2Manager(self.config);
        if (!tpm.exists()) {
            NixosLog.error("TPM2 does not exist");
            return;
        }
        if (!tpm.enroll()) {
            NixosLog.error("TPM2 enrollment failed");
        }
    }

    public void change(string oldPassword, string newPassword, bool changeFde, bool changeUser, bool updateTpm) {
        if (changeFde) {
            if (!self.changeLuksPassword(oldPassword, newPassword)) {
                NixosLog.fatal("Failed to change LUKS password");
            }
            if (updateTpm) {
                self.updateTpm2();
            }
        }
        if (changeUser) {
            self.changeUserPassword(oldPassword, newPassword);
        }
    }
}
