class Installer {
    public NixosConfig config;
    public UnixShell shell;
    public Interactive interactive;
    public string mountPoint;

    public Installer(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
        self.interactive = Interactive();
        self.mountPoint = "/mnt";
    }

    public ExecResult runDisko(string mode, string extraArgs) {
        string rev = self.config.inputLockedRev("disko");
        if (rev.isEmpty()) {
            rev = "master";
        }
        string command = "nix --extra-experimental-features nix-command --extra-experimental-features flakes run "
            + "github:nix-community/disko/" + rev
            + " --verbose -- --show-trace --flake "
            + UnixShell.quote(self.config.paths.root + "#" + self.config.host() + "-" + self.config.diskOperationTarget())
            + " --mode " + UnixShell.quote(mode)
            + " --root-mountpoint " + UnixShell.quote(self.mountPoint)
            + " " + extraArgs;
        return self.shell.runRaw(command, false, true, "");
    }

    public ExecResult mountDisk() {
        return self.runDisko("mount", "");
    }

    public ExecResult eraseAndMountDisk() {
        return self.runDisko("destroy,format,mount", "--yes-wipe-all-disks");
    }

    public ExecResult installNixos() {
        FileSystem.mkdirp(PathTools.join(self.mountPoint, "/nix/tmp"));
        FileSystem.removeRecursive(PathTools.join(self.mountPoint, self.config.paths.root));
        Command cp = Command("cp");
        cp.arg("-r");
        cp.arg(self.config.paths.root);
        cp.arg(PathTools.join(self.mountPoint, self.config.paths.root));
        cp.capture(false);
        self.shell.runCommand(cp);

        Command install = Command("nixos-install");
        install.flag("--flake", PathTools.join(self.mountPoint, self.config.paths.root) + "#" + self.config.host() + "-" + self.config.target());
        install.flag("--root", self.mountPoint);
        install.arg("--no-channel-copy");
        install.arg("--show-trace");
        install.arg("--no-root-password");
        install.arg("--cores");
        install.arg("0");
        install.envVar("TMPDIR", PathTools.join(self.mountPoint, "/nix/tmp"));
        install.capture(false);
        ExecResult result = self.shell.runCommand(install);
        FileSystem.removeRecursive(PathTools.join(self.mountPoint, "/nix/tmp"));
        if (result.ok()) {
            self.permissionNixos();
        }
        return result;
    }

    public void permissionNixos() {
        PermissionsManager permissions = PermissionsManager(self.config);
        permissions.shell.chroot(self.mountPoint);
        permissions.secureTree(self.config.username());
        permissions.shell.clearChroot();

        SnapshotManager snapshots = SnapshotManager(self.config);
        snapshots.rootPrefix = self.mountPoint;
        snapshots.createInitialSnapshots();
    }

    public string plainTextPasswordPath() {
        if (self.config.evalBool("config.settings.disk.encryption.enable")) {
            return self.config.evalRaw("config.settings.disk.encryption.plainTextPasswordFile");
        }
        return "";
    }

    public void bootstrapConfigIfMissing() {
        if (self.config.exists()) { return; }
        string hostPath = self.interactive.askHostPath(self.config.paths.hostsPath());
        self.config.reset(hostPath, self.config.standardTarget());
    }

    public void collectGarbage() {
        Command cmd = Command("nix-collect-garbage")
            .arg("-d")
            .capture(false);
        self.shell.runCommand(cmd);
    }

    public void debugShell() {
        string base = "nix --extra-experimental-features nix-command --extra-experimental-features flakes run nixpkgs#vscodium -- --no-sandbox --user-data-dir /tmp/vscodium-data";
        self.shell.runRaw(base + " --install-extension ms-python.python", false, false, "");
        self.shell.runRaw(base + " --install-extension rogalmic.bash-debug", false, false, "");
        self.shell.runRaw(base + " " + UnixShell.quote(self.config.paths.root), false, false, "");
        NixosLog.fatal("Please continue in VSCodium");
    }
}
