/* Parses the membrane's inputs: the tab-separated spec file (volume, mount,
 * abs-path, kind) into MembraneSpec rows, and the `name=mount` volume args (or,
 * when none are given, one volume per distinct spec) into MembraneVolume rows.
 * Pure: static readers returning the parsed vectors for the engine to hold.
 */
class MembraneConfig {
    class Vector<MembraneSpec> readSpecs(string specFile) {
        Vector<MembraneSpec> result = [];
        string content = FileSystem.readText(specFile);
        for raw in Strings.split(content, "\n") {
            string line = raw.trim();
            if (line.isEmpty() || line.startsWith("#")) { continue; }
            Vector<string> parts = Strings.split(raw, "\t");
            if (parts.len != 4) {
                NixosLog.fatal(specFile + " expected 4 tab-separated fields: " + raw);
            }
            string volume = MembranePaths.normSubvol(parts.get(0));
            string mountPoint = MembranePaths.normMount(parts.get(1));
            MembraneAbsPath abs = MembranePaths.normAbs(parts.get(2));
            string kind = MembranePaths.kind(parts.get(3));
            if (kind.equals("auto") && abs.endedWithSlash) {
                kind = "dir";
            }
            string rel = MembranePaths.relToMount(abs.path, mountPoint);
            result.push(MembraneSpec(volume, mountPoint, abs.path, rel, kind));
        }
        return result;
    }

    class bool volumeSeen(Vector<MembraneVolume> volumes, string name) {
        for volume in volumes {
            if (volume.name.equals(name)) { return true; }
        }
        return false;
    }

    class Vector<MembraneVolume> readVolumes(Vector<string> args, Vector<MembraneSpec> specs) {
        Vector<MembraneVolume> result = [];
        if (args.isEmpty()) {
            for spec in specs {
                if (!MembraneConfig.volumeSeen(result, spec.volume)) {
                    result.push(MembraneVolume(spec.volume, "/"));
                }
            }
            return result;
        }
        for arg in args {
            int marker = Strings.find(arg, "=", 0);
            if (marker < 0) { NixosLog.fatal("bad volume arg: " + arg); }
            string name = arg.substring(0, marker);
            string mountPoint = arg.substring(marker + 1, arg.len() - marker - 1);
            result.push(MembraneVolume(MembranePaths.normSubvol(name), MembranePaths.normMount(mountPoint)));
        }
        return result;
    }
}
