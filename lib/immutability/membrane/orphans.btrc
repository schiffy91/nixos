/* Namespace + orphan hygiene for the persist store: ensureNamespaces creates
 * the persistRoot / dirs / meta / files subvolumes, and pruneOrphans drops any
 * dir-store subvolume whose key no longer appears in the specs. Operates over
 * the fs collaborator + run; the engine passes persistRoot (and the specs).
 */
class MembraneOrphans {
    public MembraneFs fs;
    public MembraneRun run;

    public MembraneOrphans(MembraneFs fs, MembraneRun run) {
        self.fs = fs;
        self.run = run;
    }

    public void ensureNamespaces(string persistRoot) {
        Vector<string> namespaces = [
            persistRoot,
            PathTools.join(persistRoot, MembraneConstants.dirs()),
            PathTools.join(persistRoot, MembraneConstants.meta()),
            PathTools.join(PathTools.join(persistRoot, MembraneConstants.meta()), MembraneConstants.files())
        ];
        for rel in namespaces {
            string path = self.run.path(rel);
            if (!self.fs.exists(path)) {
                self.fs.makeSubvolume(path);
            } else if (!self.fs.isSubvolume(path)) {
                self.run.fatal("not a subvolume: " + path);
            }
        }
    }

    public bool keyInSpec(Vector<string> validKeys, string key) {
        for v in validKeys {
            if (v.equals(key)) { return true; }
        }
        return false;
    }

    public void pruneOrphans(string persistRoot, Vector<MembraneSpec> specs) {
        Vector<string> validKeys = [];
        for spec in specs {
            validKeys.push(MembranePaths.key(spec.absPath));
        }
        string dirsPath = self.run.path(PathTools.join(persistRoot, MembraneConstants.dirs()));
        // Snapshot the listing: deleting inside a loop over self.method() re-evaluates the call.
        Vector<string> children = self.fs.childSubvolumes(dirsPath);
        for child in children {
            string key = PathTools.basename(child);
            if (!self.keyInSpec(validKeys, key)) {
                self.run.log("Pruning orphaned persist subvolume " + key);
                self.fs.deleteSubvolume(child);
            }
        }
    }
}
