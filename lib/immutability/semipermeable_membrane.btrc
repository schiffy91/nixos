class MembraneConstants {
    class string topBase() { return "/run/semipermeable-membrane-top"; }
    class string dirs() { return "dirs"; }
    class string meta() { return ".semipermeable_membrane"; }
    class string files() { return "files"; }
    class string next() { return "NEXT"; }
    class string a() { return "A"; }
    class string b() { return "B"; }
    class string c() { return "C"; }
    class string disabled() { return "disabled"; }
    class string converge() { return "converge"; }
    class string reset() { return "reset"; }
    class string prepareOnly() { return "prepare-only"; }
    class string snapshotOnly() { return "snapshot-only"; }
    class string restoreA() { return "restore-a"; }
    class string restoreB() { return "restore-b"; }
    class string restoreC() { return "restore-c"; }
    class string restorePrevious() { return "restore-previous"; }
    class string restorePenultimate() { return "restore-penultimate"; }
}

class MembraneAbsPath {
    public string path;
    public bool endedWithSlash;

    public MembraneAbsPath(string path, bool endedWithSlash) {
        self.path = path;
        self.endedWithSlash = endedWithSlash;
    }
}

class MembraneSpec {
    public string volume;
    public string mountPoint;
    public string absPath;
    public string relPath;
    public string kind;

    public MembraneSpec(string volume, string mountPoint, string absPath, string relPath, string kind) {
        self.volume = volume;
        self.mountPoint = mountPoint;
        self.absPath = absPath;
        self.relPath = relPath;
        self.kind = kind;
    }
}

class MembraneVolume {
    public string name;
    public string mountPoint;

    public MembraneVolume(string name, string mountPoint) {
        self.name = name;
        self.mountPoint = mountPoint;
    }
}

class MembranePlan {
    public MembraneSpec spec;
    public string kind;
    public string store;

    public MembranePlan(MembraneSpec spec, string kind, string store) {
        self.spec = spec;
        self.kind = kind;
        self.store = store;
    }
}

class MembranePaths {
    class string trimSlashes(string raw) {
        string value = raw.trim();
        int start = 0;
        int end = value.len();
        while (start < end && value[start] == '/') { start++; }
        while (end > start && value[end - 1] == '/') { end--; }
        return value.substring(start, end - start);
    }

    class string trimTrailingSlashes(string raw) {
        string value = raw.trim();
        int end = value.len();
        while (end > 1 && value[end - 1] == '/') { end--; }
        return value.substring(0, end);
    }

    class bool validRel(string path) {
        if (path.isEmpty()) { return false; }
        if (path.contains("\t") || path.contains("!")) { return false; }
        for part in Strings.split(path, "/") {
            if (part.isEmpty() || part.equals(".") || part.equals("..")) { return false; }
        }
        return true;
    }

    class string normSubvol(string raw) {
        string value = MembranePaths.trimSlashes(raw);
        if (!MembranePaths.validRel(value)) {
            NixosLog.fatal("bad subvolume: " + raw);
        }
        return value;
    }

    class string normMount(string raw) {
        string value = raw.trim();
        if (value.isEmpty() || value.equals("/")) { return "/"; }
        value = MembranePaths.trimTrailingSlashes(value);
        if (!value.startsWith("/")) {
            NixosLog.fatal("bad mount: " + raw);
        }
        string rel = value.substring(1, value.len() - 1);
        if (!MembranePaths.validRel(rel)) {
            NixosLog.fatal("bad mount: " + raw);
        }
        return value;
    }

    class MembraneAbsPath normAbs(string raw) {
        string value = raw.trim();
        bool slash = value.len() > 1 && value.endsWith("/");
        value = MembranePaths.trimTrailingSlashes(value);
        if (!value.startsWith("/") || value.equals("/")) {
            NixosLog.fatal("bad keep path: " + raw);
        }
        string rel = value.substring(1, value.len() - 1);
        if (!MembranePaths.validRel(rel)) {
            NixosLog.fatal("bad keep path: " + raw);
        }
        return MembraneAbsPath(value, slash);
    }

    class string relToMount(string absPath, string mountPoint) {
        if (mountPoint.equals("/")) {
            return absPath.substring(1, absPath.len() - 1);
        }
        string prefix = mountPoint + "/";
        if (!absPath.startsWith(prefix)) {
            NixosLog.fatal(absPath + " not under " + mountPoint);
        }
        return absPath.substring(prefix.len(), absPath.len() - prefix.len());
    }

    class string kind(string raw) {
        string value = raw.trim();
        if (value.equals("auto")) { return "auto"; }
        if (value.equals("directory") || value.equals("dir")) { return "dir"; }
        if (value.equals("file")) { return "file"; }
        NixosLog.fatal("bad kind: " + raw);
        return "auto";
    }

    class bool ancestor(string parent, string child) {
        return child.startsWith(parent + "/");
    }

    class string key(string absPath) {
        string rel = absPath.substring(1, absPath.len() - 1);
        return Strings.replace(rel, "/", "!");
    }

    class string dirStore(string persistRoot, string absPath) {
        return PathTools.join(PathTools.join(persistRoot, MembraneConstants.dirs()), MembranePaths.key(absPath));
    }

    class string fileStore(string persistRoot, string absPath) {
        string root = PathTools.join(PathTools.join(persistRoot, MembraneConstants.meta()), MembraneConstants.files());
        return PathTools.join(root, MembranePaths.key(absPath));
    }
}

class MembraneRun {
    public UnixShell shell;
    public Timer timer;
    public string top;
    public bool dryRun;

    public MembraneRun(bool dryRun) {
        self.shell = UnixShell();
        self.timer = Timer();
        self.timer.start();
        self.top = Environment.get("SEMIPERMEABLE_MEMBRANE_MOUNT_PATH", MembraneConstants.topBase() + "." + Strings.fromInt(Platform.pid()));
        self.dryRun = dryRun;
    }

    public string elapsed() {
        return "[" + Strings.fromFloat(self.timer.elapsed()) + "s]";
    }

    public string path(string rel) {
        string base = MembranePaths.trimTrailingSlashes(self.top);
        string child = MembranePaths.trimSlashes(rel);
        if (child.isEmpty()) { return base; }
        return PathTools.join(base, child);
    }

    public void log(string message) {
        Console.error(self.elapsed() + " " + message);
    }

    public void fatal(string message) {
        NixosLog.fatal(self.elapsed() + " ERR " + message);
    }

    public ExecResult runCommand(Command command) {
        string rendered = command.render();
        if (self.dryRun) {
            self.log("DRY " + rendered);
            return ExecResult(0, "", "", rendered);
        }
        self.log(rendered);
        return self.shell.runCommand(command);
    }

    public ExecResult runRaw(string command, bool captureOutput, bool checkStatus) {
        if (self.dryRun) {
            self.log("DRY " + command);
            return ExecResult(0, "", "", command);
        }
        self.log(command);
        return self.shell.runRaw(command, captureOutput, checkStatus, "");
    }

    public void requireCommand(Command command) {
        ExecResult result = self.runCommand(command);
        if (!result.ok()) { self.fatal("Failed: " + command.render()); }
    }

    public void requireRaw(string command) {
        ExecResult result = self.runRaw(command, false, true);
        if (!result.ok()) { self.fatal("Failed: " + command); }
    }

    public void mkdirp(string path) {
        if (self.dryRun) {
            self.log("DRY mkdir -p " + UnixShell.quote(path));
            return;
        }
        FileSystem.mkdirp(path);
    }

    public void removePath(string path) {
        if (self.dryRun) {
            self.log("DRY rm -rf " + UnixShell.quote(path));
            return;
        }
        if (FileSystem.exists(path) || FileSystem.isSymlink(path)) {
            FileSystem.removeRecursive(path);
        }
    }

    public void renamePath(string source, string destination) {
        self.requireRaw("mv --no-copy " + UnixShell.quote(source) + " " + UnixShell.quote(destination));
    }
}

/* Centralized btrfs CLI vocabulary. Every btrfs subcommand the membrane issues
 * is built here, so a syntax change touches one place and call sites read as
 * verbs rather than arg chains. capture(false) streams output to the terminal;
 * check(false) hands a non-zero exit back to the caller instead of aborting. */
class MembraneBtrfs {
    class Command show(string path) {
        return Command("btrfs").arg("subvolume").arg("show").arg(path).check(false);
    }

    class Command getReadonly(string path) {
        return Command("btrfs").arg("property").arg("get").arg("-ts").arg(path).arg("ro").check(false);
    }

    class Command listChildren(string path) {
        return Command("btrfs").arg("subvolume").arg("list").arg("-o").arg(path);
    }

    class Command deleteSubvol(string path) {
        return Command("btrfs").arg("subvolume").arg("delete").arg(path).capture(false);
    }

    class Command createSubvol(string path) {
        return Command("btrfs").arg("subvolume").arg("create").arg(path).capture(false);
    }

    class Command snapshot(string source, string destination, bool readonly) {
        Command command = Command("btrfs").arg("subvolume").arg("snapshot");
        if (readonly) { command.arg("-r"); }
        return command.arg(source).arg(destination).capture(false);
    }

    class Command clearReadonly(string path) {
        return Command("btrfs").arg("property").arg("set").arg("-ts").arg(path).arg("ro").arg("false").capture(false);
    }

    class Command sync(string top) {
        return Command("btrfs").arg("filesystem").arg("sync").arg(top).capture(false);
    }
}

class SemipermeableMembrane {
    public MembraneRun run;
    public string device;
    public string snapshotsSubvolume;
    public string cleanName;
    public string mode;
    public string persistRoot;
    public string specFile;
    public Vector<MembraneSpec> specs;
    public Vector<MembraneVolume> volumes;
    public bool assumeMounted;

    public SemipermeableMembrane(bool dryRun, bool assumeMounted) {
        self.run = MembraneRun(dryRun);
        self.device = "";
        self.snapshotsSubvolume = "";
        self.cleanName = "";
        self.mode = "";
        self.persistRoot = "";
        self.specFile = "";
        self.specs = [];
        self.volumes = [];
        self.assumeMounted = assumeMounted;
    }

    class bool envDryRun() {
        string value = Environment.get("SEMIPERMEABLE_MEMBRANE_DRY_RUN", "");
        return value.equals("1") || value.equals("true") || value.equals("yes") || value.equals("on");
    }

    public bool exists(string path) {
        return FileSystem.exists(path) || FileSystem.isSymlink(path);
    }

    public bool isSubvolume(string path) {
        if (!FileSystem.exists(path)) { return false; }
        ExecResult result = self.run.shell.runCommand(MembraneBtrfs.show(path));
        return result.ok();
    }

    public bool isReadonly(string path) {
        ExecResult result = self.run.shell.runCommand(MembraneBtrfs.getReadonly(path));
        return result.ok() && result.stdout().contains("ro=true");
    }

    public bool mounted(string path) {
        Command command = Command("findmnt")
            .arg("--mountpoint")
            .arg(path)
            .check(false);
        ExecResult result = self.run.shell.runCommand(command);
        return result.ok();
    }

    public int compareDeepestFirst(string left, string right) {
        int leftDepth = Strings.count(left, "/");
        int rightDepth = Strings.count(right, "/");
        if (leftDepth != rightDepth) { return rightDepth - leftDepth; }
        if (left.len() != right.len()) { return right.len() - left.len(); }
        return Strings.compare(left, right);
    }

    public void pushChildSorted(Vector<string> paths, string path) {
        int index = 0;
        while (index < paths.len && self.compareDeepestFirst(paths.get(index), path) <= 0) {
            index++;
        }
        paths.insert(index, path);
    }

    public Vector<string> childSubvolumes(string path) {
        Vector<string> result = [];
        if (!FileSystem.isDir(path)) { return result; }
        ExecResult listed = self.run.runCommand(MembraneBtrfs.listChildren(path));
        if (!listed.ok()) { self.run.fatal("list " + path); }
        for line in Strings.split(listed.stdout(), "\n") {
            int marker = Strings.find(line, " path ", 0);
            if (marker < 0) { continue; }
            string child = line.substring(marker + 6, line.len() - (marker + 6)).trim();
            string childPath = self.run.path(child);
            if (MembranePaths.ancestor(path, childPath)) {
                self.pushChildSorted(result, childPath);
            }
        }
        return result;
    }

    public void deleteSubvolume(string path) {
        if (!FileSystem.isDir(path)) { return; }
        // childSubvolumes returns every descendant subvolume deepest-first, so
        // deleting them in that order clears all nesting before the parent.
        // Snapshot the listing into a local first: `for x in self.method()`
        // re-evaluates the call each iteration, so deleting inside the loop
        // would index a shrinking vector out of bounds (segfault).
        Vector<string> children = self.childSubvolumes(path);
        for child in children {
            self.run.requireCommand(MembraneBtrfs.deleteSubvol(child));
        }
        self.run.requireCommand(MembraneBtrfs.deleteSubvol(path));
    }

    public void makeSubvolume(string path) {
        self.run.mkdirp(PathTools.dirname(path));
        self.run.requireCommand(MembraneBtrfs.createSubvol(path));
    }

    public void snapshot(string source, string destination, bool readonly) {
        if (!FileSystem.isDir(source)) {
            self.run.fatal("Source missing: " + source);
        }
        self.deleteSubvolume(destination);
        self.run.requireCommand(MembraneBtrfs.snapshot(source, destination, readonly));
        if (!readonly) {
            self.run.requireCommand(MembraneBtrfs.clearReadonly(destination));
        }
    }

    public string sourcePath(string live, string clean, string relPath) {
        string livePath = PathTools.join(live, relPath);
        if (self.exists(livePath)) { return livePath; }
        string cleanPath = PathTools.join(clean, relPath);
        if (self.exists(cleanPath)) { return cleanPath; }
        return "";
    }

    public void copyPath(string source, string destination) {
        self.run.mkdirp(PathTools.dirname(destination));
        Command command = Command("cp")
            .arg("--reflink=always")
            .arg("-a")
            .arg(source)
            .arg(destination)
            .capture(false);
        self.run.requireCommand(command);
    }

    public void copyDirectoryContents(string source, string destination) {
        if (!FileSystem.isDir(source)) { return; }
        Vector<string> nested = self.childSubvolumes(source);
        if (!nested.isEmpty()) {
            self.run.fatal("nested subvolumes in persisted dir: " + nested.join(" "));
        }
        self.run.requireRaw("cp --reflink=always -a " + UnixShell.quote(PathTools.join(source, ".")) + " " + UnixShell.quote(destination));
    }

    public void ensureNamespaces() {
        Vector<string> namespaces = [
            self.persistRoot,
            PathTools.join(self.persistRoot, MembraneConstants.dirs()),
            PathTools.join(self.persistRoot, MembraneConstants.meta()),
            PathTools.join(PathTools.join(self.persistRoot, MembraneConstants.meta()), MembraneConstants.files())
        ];
        for rel in namespaces {
            string path = self.run.path(rel);
            if (!self.exists(path)) {
                self.makeSubvolume(path);
            } else if (!self.isSubvolume(path)) {
                self.run.fatal("not a subvolume: " + path);
            }
        }
    }

    public bool keyInSpec(Vector<string> validKeys, string key) {
        for v in validKeys {
            if (v.equals(key)) { return true; }
        }
        return false;
    }

    public void pruneOrphans() {
        Vector<string> validKeys = [];
        for spec in self.specs {
            validKeys.push(MembranePaths.key(spec.absPath));
        }
        string dirsPath = self.run.path(PathTools.join(self.persistRoot, MembraneConstants.dirs()));
        // Snapshot the listing: deleting inside a loop over self.method() re-evaluates the call.
        Vector<string> children = self.childSubvolumes(dirsPath);
        for child in children {
            string key = PathTools.basename(child);
            if (!self.keyInSpec(validKeys, key)) {
                self.run.log("Pruning orphaned persist subvolume " + key);
                self.deleteSubvolume(child);
            }
        }
    }

    public void rotate(string volume, string live) {
        string root = PathTools.join(self.snapshotsSubvolume, volume);
        string a = self.run.path(PathTools.join(root, MembraneConstants.a()));
        string b = self.run.path(PathTools.join(root, MembraneConstants.b()));
        string c = self.run.path(PathTools.join(root, MembraneConstants.c()));
        self.deleteSubvolume(c);
        if (self.exists(b)) {
            self.snapshot(b, c, true);
            self.deleteSubvolume(b);
        }
        if (self.exists(a)) {
            self.snapshot(a, b, true);
            self.deleteSubvolume(a);
        }
        self.snapshot(live, a, true);
    }

    public void publish(MembraneVolume volume, string live, string next) {
        if (!self.exists(next)) { return; }
        if (!self.run.dryRun && !volume.mountPoint.equals("/") && self.mounted(volume.mountPoint)) {
            self.run.log("WRN " + volume.mountPoint + " mounted; leaving NEXT for boot");
            return;
        }
        if (!self.exists(live)) {
            self.run.renamePath(next, live);
            return;
        }
        self.run.requireRaw("mv -T --exchange --no-copy " + UnixShell.quote(live) + " " + UnixShell.quote(next));
        self.deleteSubvolume(next);
    }

    public int compareSpecs(MembraneSpec left, MembraneSpec right) {
        int volume = Strings.compare(left.volume, right.volume);
        if (volume != 0) { return volume; }
        int leftDepth = Strings.count(left.relPath, "/");
        int rightDepth = Strings.count(right.relPath, "/");
        if (leftDepth != rightDepth) { return leftDepth - rightDepth; }
        if (left.relPath.len() != right.relPath.len()) { return left.relPath.len() - right.relPath.len(); }
        return Strings.compare(left.relPath, right.relPath);
    }

    public void pushSpecSorted(Vector<MembraneSpec> specs, MembraneSpec spec) {
        int index = 0;
        while (index < specs.len && self.compareSpecs(specs.get(index), spec) <= 0) {
            index++;
        }
        specs.insert(index, spec);
    }

    public Vector<MembraneSpec> sortedSpecs(Vector<MembraneSpec> input) {
        Vector<MembraneSpec> sorted = [];
        for spec in input {
            self.pushSpecSorted(sorted, spec);
        }
        return sorted;
    }

    public string resolveKind(string live, string clean, MembraneSpec spec) {
        string path = self.sourcePath(live, clean, spec.relPath);
        if (path.isEmpty()) { return "file"; }
        if (FileSystem.isDir(path)) { return "dir"; }
        return "file";
    }

    public bool planAlreadyCovers(Vector<MembranePlan> plans, MembraneSpec spec) {
        for plan in plans {
            if (plan.spec.volume.equals(spec.volume) && plan.spec.relPath.equals(spec.relPath)) {
                return true;
            }
            if (plan.spec.volume.equals(spec.volume) && plan.kind.equals("dir") && MembranePaths.ancestor(plan.spec.relPath, spec.relPath)) {
                return true;
            }
        }
        return false;
    }

    public Vector<MembranePlan> makePlan(Vector<MembraneSpec> specs, string live, string clean) {
        Vector<MembranePlan> plans = [];
        // Sort once; `for x in self.method()` re-evaluates the call each pass.
        Vector<MembraneSpec> ordered = self.sortedSpecs(specs);
        for spec in ordered {
            string kind = spec.kind;
            if (kind.equals("auto")) {
                kind = self.resolveKind(live, clean, spec);
            }
            if (self.planAlreadyCovers(plans, spec)) { continue; }
            string store = kind.equals("dir")
                ? MembranePaths.dirStore(self.persistRoot, spec.absPath)
                : MembranePaths.fileStore(self.persistRoot, spec.absPath);
            plans.push(MembranePlan(spec, kind, store));
        }
        return plans;
    }

    public Vector<MembraneSpec> specsForVolume(string volume) {
        Vector<MembraneSpec> result = [];
        for spec in self.specs {
            if (spec.volume.equals(volume)) { result.push(spec); }
        }
        return result;
    }

    public void resetVolume(MembraneVolume volume) {
        string live = self.run.path(volume.name);
        string root = PathTools.join(self.snapshotsSubvolume, volume.name);
        string clean = self.run.path(PathTools.join(root, self.cleanName));
        string next = self.run.path(PathTools.join(root, MembraneConstants.next()));

        if (!self.exists(clean) || !self.isSubvolume(clean) || !self.isReadonly(clean)) {
            self.run.fatal("bad CLEAN: " + clean);
        }
        if (!self.exists(live)) {
            self.publish(volume, live, next);
        }
        if (!self.exists(live)) { self.run.fatal("live missing: " + live); }
        if (!self.isSubvolume(live)) { self.run.fatal("live is not a subvolume: " + live); }
        self.deleteSubvolume(next);

        Vector<MembranePlan> plans = self.makePlan(self.specsForVolume(volume.name), live, clean);
        self.restorePersistentDirs(plans, live, clean);
        self.restorePersistentFiles(plans, live, clean);

        self.rotate(volume.name, live);
        self.snapshot(clean, next, false);
        self.populateNext(plans, next);
        self.publish(volume, live, next);
    }

    public void restorePersistentDirs(Vector<MembranePlan> plans, string live, string clean) {
        for plan in plans {
            if (!plan.kind.equals("dir")) { continue; }
            string store = self.run.path(plan.store);
            if (!self.exists(store)) {
                self.makeSubvolume(store);
                string source = self.sourcePath(live, clean, plan.spec.relPath);
                if (!source.isEmpty()) {
                    self.copyDirectoryContents(source, store);
                }
            } else if (!self.isSubvolume(store)) {
                self.run.fatal("not a subvolume: " + store);
            }
        }
    }

    public void restorePersistentFiles(Vector<MembranePlan> plans, string live, string clean) {
        for plan in plans {
            if (!plan.kind.equals("file")) { continue; }
            string destination = self.run.path(plan.store);
            string source = self.sourcePath(live, clean, plan.spec.relPath);
            if (!source.isEmpty()) {
                string temporary = destination + ".tmp." + Strings.fromInt(Platform.pid());
                self.run.removePath(temporary);
                self.copyPath(source, temporary);
                self.run.removePath(destination);
                self.run.renamePath(temporary, destination);
            } else {
                self.run.removePath(destination);
            }
        }
    }

    public void populateNext(Vector<MembranePlan> plans, string next) {
        for plan in plans {
            string target = PathTools.join(next, plan.spec.relPath);
            self.run.removePath(target);
            if (plan.kind.equals("dir")) {
                self.run.mkdirp(target);
            } else {
                string source = self.run.path(plan.store);
                if (self.exists(source)) {
                    self.copyPath(source, target);
                }
            }
        }
    }

    public void restoreSlot(MembraneVolume volume, string slot) {
        string root = PathTools.join(self.snapshotsSubvolume, volume.name);
        string live = self.run.path(volume.name);
        string next = self.run.path(PathTools.join(root, MembraneConstants.next()));
        string source = self.run.path(PathTools.join(root, slot));
        if (!self.exists(source) || !self.isSubvolume(source)) {
            self.run.fatal("restore source missing: " + source);
        }
        self.snapshot(source, next, false);
        self.publish(volume, live, next);
    }

    public void readSpecs() {
        string content = FileSystem.readText(self.specFile);
        for raw in Strings.split(content, "\n") {
            string line = raw.trim();
            if (line.isEmpty() || line.startsWith("#")) { continue; }
            Vector<string> parts = Strings.split(raw, "\t");
            if (parts.len != 4) {
                NixosLog.fatal(self.specFile + " expected 4 tab-separated fields: " + raw);
            }
            string volume = MembranePaths.normSubvol(parts.get(0));
            string mountPoint = MembranePaths.normMount(parts.get(1));
            MembraneAbsPath abs = MembranePaths.normAbs(parts.get(2));
            string kind = MembranePaths.kind(parts.get(3));
            if (kind.equals("auto") && abs.endedWithSlash) {
                kind = "dir";
            }
            string rel = MembranePaths.relToMount(abs.path, mountPoint);
            self.specs.push(MembraneSpec(volume, mountPoint, abs.path, rel, kind));
        }
    }

    public bool volumeSeen(Vector<MembraneVolume> volumes, string name) {
        for volume in volumes {
            if (volume.name.equals(name)) { return true; }
        }
        return false;
    }

    public void readVolumes(Vector<string> args) {
        if (args.isEmpty()) {
            for spec in self.specs {
                if (!self.volumeSeen(self.volumes, spec.volume)) {
                    self.volumes.push(MembraneVolume(spec.volume, "/"));
                }
            }
            return;
        }
        for arg in args {
            int marker = Strings.find(arg, "=", 0);
            if (marker < 0) { NixosLog.fatal("bad volume arg: " + arg); }
            string name = arg.substring(0, marker);
            string mountPoint = arg.substring(marker + 1, arg.len() - marker - 1);
            self.volumes.push(MembraneVolume(MembranePaths.normSubvol(name), MembranePaths.normMount(mountPoint)));
        }
    }

    public void mountTop() {
        if (self.assumeMounted) {
            if (!FileSystem.isDir(self.run.top)) {
                self.run.fatal("missing mount path: " + self.run.top);
            }
            return;
        }
        self.run.mkdirp(self.run.top);
        Command command = Command("mount")
            .arg("-t")
            .arg("btrfs")
            .arg("-o")
            .arg("subvolid=5,user_subvol_rm_allowed")
            .arg(self.device)
            .arg(self.run.top)
            .capture(false);
        self.run.requireCommand(command);
    }

    public void unmountTop() {
        if (self.assumeMounted) { return; }
        Command command = Command("umount")
            .arg("-R")
            .arg(self.run.top)
            .capture(false)
            .check(false);
        self.run.runCommand(command);
        if (self.run.top.startsWith(MembraneConstants.topBase() + ".")) {
            FileSystem.removeRecursive(self.run.top);
        }
    }

    public void configure(string device, string snapshotsSubvolume, string cleanName, string mode, string persistRoot, string specFile, Vector<string> volumeArgs) {
        self.device = device;
        self.snapshotsSubvolume = MembranePaths.normSubvol(snapshotsSubvolume);
        self.cleanName = cleanName.trim();
        self.mode = mode.trim();
        self.persistRoot = MembranePaths.normSubvol(persistRoot);
        self.specFile = specFile;
        self.readSpecs();
        self.readVolumes(volumeArgs);
    }

    public void runAll() {
        Vector<string> names = [];
        for volume in self.volumes { names.push(volume.name); }
        self.run.log("Mode=" + self.mode + " dry_run=" + (self.run.dryRun ? "true" : "false") + " device=" + self.device + " subvolumes=" + names.join(" "));
        if (self.mode.equals(MembraneConstants.disabled())) {
            self.run.log("Semipermeable membrane disabled; skipping");
            return;
        }
        if (self.run.dryRun && !self.assumeMounted) {
            self.run.log("DRY add --assume-mounted to walk mounted test roots");
            return;
        }
        self.mountTop();
        self.ensureNamespaces();
        if (self.mode.equals(MembraneConstants.converge()) || self.mode.equals(MembraneConstants.reset()) || self.mode.equals(MembraneConstants.prepareOnly())) {
            self.pruneOrphans();
        }
        for volume in self.volumes {
            if (self.mode.equals(MembraneConstants.converge()) || self.mode.equals(MembraneConstants.reset()) || self.mode.equals(MembraneConstants.prepareOnly())) {
                self.resetVolume(volume);
            } else if (self.mode.equals(MembraneConstants.snapshotOnly())) {
                self.rotate(volume.name, self.run.path(volume.name));
            } else if (self.mode.equals(MembraneConstants.restoreA()) || self.mode.equals(MembraneConstants.restorePrevious())) {
                self.restoreSlot(volume, MembraneConstants.a());
            } else if (self.mode.equals(MembraneConstants.restoreB()) || self.mode.equals(MembraneConstants.restorePenultimate())) {
                self.restoreSlot(volume, MembraneConstants.b());
            } else if (self.mode.equals(MembraneConstants.restoreC())) {
                self.restoreSlot(volume, MembraneConstants.c());
            } else {
                self.run.fatal("Unknown mode: " + self.mode);
            }
        }
        self.run.requireCommand(MembraneBtrfs.sync(self.run.top));
        self.unmountTop();
        self.run.log("Semipermeable membrane complete");
    }

    public bool coveredBy(Vector<string> selected, string target) {
        for s in selected {
            if (target.startsWith(s + "/")) { return true; }
        }
        return false;
    }

    public void mountTarget(string target, string subvol) {
        self.run.mkdirp(target);
        if (self.mounted(target)) { return; }
        Command command = Command("mount")
            .arg("-t").arg("btrfs")
            .arg("-o").arg("subvol=" + subvol + ",compress=zstd,noatime")
            .arg(self.device).arg(target)
            .capture(false);
        self.run.requireCommand(command);
    }

    public void configureMount(string device, string persistRoot, string specFile) {
        self.device = device;
        self.persistRoot = MembranePaths.normSubvol(persistRoot);
        self.specFile = specFile;
        self.readSpecs();
    }

    public void mountPersist() {
        self.run.log("Mounting persistent subvolumes dry_run=" + (self.run.dryRun ? "true" : "false"));
        bool mountedTop = false;
        if (!self.assumeMounted && !self.mounted(self.run.top)) {
            self.run.mkdirp(self.run.top);
            Command m = Command("mount")
                .arg("-t").arg("btrfs")
                .arg("-o").arg("ro,subvolid=5")
                .arg(self.device).arg(self.run.top)
                .capture(false);
            self.run.requireCommand(m);
            mountedTop = true;
        }
        Vector<string> selected = [];
        for spec in self.specs {
            string target = spec.absPath;
            if (self.coveredBy(selected, target)) { continue; }
            string subvol = PathTools.join(PathTools.join(self.persistRoot, MembraneConstants.dirs()), MembranePaths.key(target));
            if (!self.isSubvolume(self.run.path(subvol))) { continue; }
            self.mountTarget(target, subvol);
            selected.push(target);
        }
        if (mountedTop) {
            Command u = Command("umount").arg(self.run.top).capture(false).check(false);
            self.run.runCommand(u);
        }
        self.run.log("Persistent mounts complete");
    }

    public void configureSnapshotClean(string device, string snapshotsSubvolume, string cleanName, Vector<string> volumeArgs) {
        self.device = device;
        self.snapshotsSubvolume = MembranePaths.normSubvol(snapshotsSubvolume);
        self.cleanName = cleanName.trim();
        self.readVolumes(volumeArgs);
    }

    public void snapshotCleanVolume(MembraneVolume volume) {
        string live = self.run.path(volume.name);
        string root = PathTools.join(self.snapshotsSubvolume, volume.name);
        string clean = self.run.path(PathTools.join(root, self.cleanName));
        if (!self.exists(live)) { self.run.fatal("live missing: " + live); }
        if (!self.isSubvolume(live)) { self.run.fatal("live is not a subvolume: " + live); }
        // snapshot() deletes the prior CLEAN (and any nested subvolumes,
        // deepest-first) before taking a fresh read-only snapshot of live.
        self.run.log("Re-capturing CLEAN baseline for " + volume.name + " from live subvolume");
        self.snapshot(live, clean, true);
    }

    public void snapshotCleanAll() {
        Vector<string> names = [];
        // `for x in self.volumes` reads a field, but the loop below mutates
        // btrfs (delete + recreate CLEAN), so snapshot the volume list into a
        // local Vector first: re-evaluating a list-returning call mid-loop has
        // previously caused a segfault + subvolume leak.
        Vector<MembraneVolume> volumes = self.volumes;
        for volume in volumes { names.push(volume.name); }
        self.run.log("snapshot-clean dry_run=" + (self.run.dryRun ? "true" : "false") + " device=" + self.device + " subvolumes=" + names.join(" "));
        if (self.run.dryRun && !self.assumeMounted) {
            self.run.log("DRY add --assume-mounted to walk mounted test roots");
            return;
        }
        self.mountTop();
        for volume in volumes {
            self.snapshotCleanVolume(volume);
        }
        self.run.requireCommand(MembraneBtrfs.sync(self.run.top));
        self.unmountTop();
        self.run.log("snapshot-clean complete");
    }

    class int cli(CliArgs args) {
        bool dryRun = SemipermeableMembrane.envDryRun();
        bool assumeMounted = false;
        int index = 0;
        while (index < args.count()) {
            string value = args.get(index);
            if (value.equals("--dry-run")) {
                dryRun = true;
                index++;
                continue;
            }
            if (value.equals("--assume-mounted")) {
                assumeMounted = true;
                index++;
                continue;
            }
            break;
        }
        if (index < args.count() && args.get(index).equals("mount")) {
            if (args.count() < index + 4) {
                Console.error("Usage: semipermeable_membrane [--dry-run] mount <device> <persist_root> <spec_file>");
                return 1;
            }
            SemipermeableMembrane mounter = SemipermeableMembrane(dryRun, assumeMounted);
            mounter.configureMount(args.get(index + 1), args.get(index + 2), args.get(index + 3));
            mounter.mountPersist();
            return 0;
        }
        if (index < args.count() && args.get(index).equals("snapshot-clean")) {
            if (args.count() < index + 4) {
                Console.error("Usage: semipermeable_membrane [--dry-run] [--assume-mounted] snapshot-clean <device> <snapshots> <clean> [name=mount ...]");
                return 1;
            }
            Vector<string> cleanVolumeArgs = [];
            for (int i = index + 4; i < args.count(); i++) {
                cleanVolumeArgs.push(args.get(i));
            }
            SemipermeableMembrane snapshotter = SemipermeableMembrane(dryRun, assumeMounted);
            snapshotter.configureSnapshotClean(args.get(index + 1), args.get(index + 2), args.get(index + 3), cleanVolumeArgs);
            snapshotter.snapshotCleanAll();
            return 0;
        }
        if (args.count() < index + 6) {
            Console.error("Usage: semipermeable_membrane [--dry-run] [--assume-mounted] <device> <snapshots> <clean> <mode> <persist_root> <spec_file> [name=mount ...]");
            return 1;
        }
        Vector<string> volumeArgs = [];
        for (int i = index + 6; i < args.count(); i++) {
            volumeArgs.push(args.get(i));
        }
        SemipermeableMembrane membrane = SemipermeableMembrane(dryRun, assumeMounted);
        membrane.configure(
            args.get(index),
            args.get(index + 1),
            args.get(index + 2),
            args.get(index + 3),
            args.get(index + 4),
            args.get(index + 5),
            volumeArgs
        );
        membrane.runAll();
        return 0;
    }
}
