/* Semipermeable membrane — module aggregator.
 *
 * The implementation is split one-class-per-file under membrane/, included here
 * in dependency order. This file stays the single include point (the executable
 * entry is bin/semipermeable_membrane.btrc), and because btrc #include is
 * textual the transpiled C is identical to the former monolithic file.
 *
 *   constants  MembraneConstants            — string/literal constants
 *   types      MembraneAbsPath, …Spec,      — small value types
 *              …Volume, …Plan
 *   paths      MembranePaths                — path math (static)
 *   run        MembraneRun                  — process/IO context
 *   btrfs      MembraneBtrfs                — btrfs CLI vocabulary (static)
 *   membrane   SemipermeableMembrane        — the reset/snapshot engine
 */
#include "membrane/constants.btrc"
#include "membrane/types.btrc"
#include "membrane/paths.btrc"
#include "membrane/run.btrc"
#include "membrane/btrfs.btrc"
#include "membrane/fs.btrc"
#include "membrane/planner.btrc"
#include "membrane/mounts.btrc"
#include "membrane/slots.btrc"
#include "membrane/membrane.btrc"
