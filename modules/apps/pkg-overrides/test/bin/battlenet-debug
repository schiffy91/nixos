#!/usr/bin/env bash
set -euo pipefail

app_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
nixos_dir="$(cd "$app_dir/../../../.." && pwd)"
proton_dir="$nixos_dir/modules/apps/pkg-overrides/proton-custom"
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/battlenet-proton"
prefix="${HOME}/Games/Battle.net/prefix"

usage() {
  cat <<EOF
usage: battlenet-debug [status|logs|sni|context-menu|window-info|cache-state|reset-browser-cache|probe-window|capture-window|frames-window|diagnose]

Commands:
  status          print process, compat tool, desktop entry, and log locations
  logs [LINES]    print redacted tails of wrapper, Proton, Battle.net, and CEF logs
  sni             print StatusNotifierItem metadata without screenshots
  context-menu    call Battle.net's SNI ContextMenu method without capturing the screen
  window-info     print Battle.net and Plasma window geometry without screenshots
  cache-state     print Battle.net browser/GPU cache paths and sizes
  reset-browser-cache
                  move only browser/GPU caches to a timestamped backup
  probe-window    capture only Battle.net, print aggregate pixels, delete temp captures
  capture-window  capture only the Battle.net window; foreground fallback is opt-in
  frames-window   capture a short burst of only the active Battle.net window
  diagnose        run status, sni, and logs

Full-desktop capture is intentionally unavailable here.
EOF
}

run_in_devshell() {
  if [ "${BATTLENET_IN_DEV_SHELL:-}" = 1 ]; then
    return 0
  fi
  export BATTLENET_QUIET_SHELL=1
  exec nix-shell "$app_dir/dev-shell.nix" --run "$(printf '%q ' "$0" "$@")"
}

redact() {
  sed -E \
    -e 's/((access|refresh|id)?_?token=)[^&[:space:]"]+/\1<redacted>/Ig' \
    -e 's/((session|sid|authorization|cookie)=)[^&[:space:]"]+/\1<redacted>/Ig' \
    -e 's/(account=GameAccount)\([^)]*\)/\1(<redacted>)/g' \
    -e 's/(entity=)[^ )]+/\1<redacted>/g' \
    -e 's/(name=)[^ )]+/\1<redacted>/g' \
    -e 's/(\|accountId=)[^[:space:]]+/\1<redacted>/g'
}

print_file_tail() {
  local file="$1"
  local lines="$2"
  [ -f "$file" ] || return 0
  printf '\n==> %s <==\n' "$file"
  tail -n "$lines" "$file" | redact
}

print_error_tail() {
  local file="$1"
  local lines="$2"
  [ -f "$file" ] || return 0
  printf '\n==> %s <==\n' "$file"
  grep -E '(^[EW] |ERROR|WARNING|failed|Failed|crash|Crash|exception|Exception|DPI|CEF|DirectComposition|DComp|DXGI)' "$file" \
    | tail -n "$lines" | redact || true
}

status() {
  echo "compat:"
  "$proton_dir/bin/proton-custom-dev" status
  echo
  echo "desktop entry:"
  if [ -e /run/current-system/sw/share/applications/battlenet.desktop ]; then
    sed -n '1,40p' /run/current-system/sw/share/applications/battlenet.desktop
  else
    echo "missing /run/current-system/sw/share/applications/battlenet.desktop"
  fi
  echo
  echo "processes:"
  mapfile -t pids < <(pgrep -f 'Battle.net|Agent.exe|wine|umu|pressure-vessel|explorer.exe' || true)
  if [ "${#pids[@]}" -gt 0 ]; then
    ps -o pid=,stat=,comm= -p "$(IFS=,; echo "${pids[*]}")" | sed 's/^/  /'
  fi
  echo
  echo "logs:"
  find "$runtime_dir" -maxdepth 1 -type f -print 2>/dev/null | sort || true
}

sni_items() {
  qdbus org.kde.StatusNotifierWatcher /StatusNotifierWatcher \
    org.kde.StatusNotifierWatcher.RegisteredStatusNotifierItems 2>/dev/null || true
}

split_sni_item() {
  local item="$1"
  local service="${item%%/*}"
  local path="/${item#*/}"
  printf '%s\n%s\n' "$service" "$path"
}

get_sni_prop() {
  local service="$1"
  local path="$2"
  local prop="$3"
  gdbus call --session --dest "$service" --object-path "$path" \
    --method org.freedesktop.DBus.Properties.Get org.kde.StatusNotifierItem "$prop" \
    2>/dev/null || true
}

find_battlenet_sni() {
  local item service path title icon
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    mapfile -t parts < <(split_sni_item "$item")
    service="${parts[0]}"
    path="${parts[1]}"
    title="$(get_sni_prop "$service" "$path" Title)"
    icon="$(get_sni_prop "$service" "$path" IconName)"
    if printf '%s\n%s\n' "$title" "$icon" | grep -Eiq 'battle[.]?net|battlenet'; then
      printf '%s\n%s\n' "$service" "$path"
      return 0
    fi
  done < <(sni_items)
  return 1
}

sni() {
  local item service path
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    mapfile -t parts < <(split_sni_item "$item")
    service="${parts[0]}"
    path="${parts[1]}"
    printf '\n==> %s %s <==\n' "$service" "$path"
    printf 'Id:       %s\n' "$(get_sni_prop "$service" "$path" Id)"
    printf 'Title:    %s\n' "$(get_sni_prop "$service" "$path" Title)"
    printf 'IconName: %s\n' "$(get_sni_prop "$service" "$path" IconName)"
    printf 'Status:   %s\n' "$(get_sni_prop "$service" "$path" Status)"
  done < <(sni_items)
}

logs() {
  local lines="${1:-180}"
  print_file_tail "$runtime_dir/battlenet-wrapper.log" "$lines"
  print_file_tail "$runtime_dir/steam-battlenet.log" "$lines"
  find "$prefix/drive_c/users/steamuser/AppData/Local/Battle.net/Logs" \
    -maxdepth 1 -type f \( -name '*.log' -o -name '*.txt' \) -printf '%T@ %p\n' 2>/dev/null \
    | sort -nr | head -4 | cut -d' ' -f2- \
    | while IFS= read -r file; do print_error_tail "$file" "$lines"; done
}

context_menu() {
  local x="${1:-1900}"
  local y="${2:-1050}"
  local service path
  mapfile -t parts < <(find_battlenet_sni)
  service="${parts[0]:-}"
  path="${parts[1]:-}"
  if [ -z "$service" ] || [ -z "$path" ]; then
    echo "Battle.net SNI item not found" >&2
    exit 1
  fi
  gdbus call --session --dest "$service" --object-path "$path" \
    --method org.kde.StatusNotifierItem.ContextMenu "$x" "$y"
}

print_window_group() {
  local title="$1"
  local class="$2"
  local ids id

  mapfile -t ids < <(kdotool search --class "$class" getwindowid %@ 2>/dev/null || true)
  for id in "${ids[@]}"; do
    [ -n "$id" ] || continue
    printf '\n==> %s %s <==\n' "$title" "$id"
    kdotool getwindowgeometry "$id" 2>/dev/null || true
    qdbus org.kde.KWin /KWin org.kde.KWin.getWindowInfo "$id" 2>/dev/null \
      | grep -E '^(caption|height|keepAbove|layer|resourceClass|role|skipTaskbar|type|width|x|y):' \
      || true
  done
}

window_info() {
  run_in_devshell window-info "$@"
  print_window_group "Battle.net" 'battle[.]net[.]exe'
  print_window_group "Explorer" 'explorer[.]exe'
  print_window_group "Chromium" 'Cr.*Main'
  print_window_group "Wine" 'wine'
  print_window_group "Plasma" 'plasmashell'
}

cache_roots() {
  local appdata="$prefix/drive_c/users/steamuser/AppData/Local"

  find "$appdata/Battle.net/BrowserCaches" "$appdata/CEF/User Data" \
    -maxdepth 3 \( -type d \( -name GPUCache -o -name DawnCache -o -name 'Code Cache' \) \) \
    -print 2>/dev/null || true
  [ -d "$appdata/Battle.net/Cache" ] && printf '%s\n' "$appdata/Battle.net/Cache"
  [ -f "$appdata/Battle.net/CachedData.db" ] && printf '%s\n' "$appdata/Battle.net/CachedData.db"
}

cache_state() {
  local path

  while IFS= read -r path; do
    [ -e "$path" ] || continue
    printf '%s\t' "$path"
    du -sh "$path" 2>/dev/null | awk '{print $1}'
  done < <(cache_roots)
}

reset_browser_cache() {
  local backup path name

  "$proton_dir/bin/proton-custom-dev" cleanup
  backup="$prefix/drive_c/users/steamuser/AppData/Local/Battle.net/CacheBackups/$(date +%Y%m%dT%H%M%S)"
  mkdir -p "$backup"

  while IFS= read -r path; do
    [ -e "$path" ] || continue
    name="$(printf '%s' "$path" | sed "s#^$prefix/drive_c/users/steamuser/AppData/Local/##; s#[ /]#_#g")"
    mv "$path" "$backup/$name"
    echo "moved $path -> $backup/$name"
  done < <(cache_roots)

  echo "backup=$backup"
}

install_capture_helper() {
  local desktop_dir desktop_file helper installed_helper

  pkill -f '/etc/nixos/modules/apps/battlenet/.build/battlenet-capture-window' 2>/dev/null || true
  pkill -f "$app_dir/.build/battlenet-capture-window" 2>/dev/null || true

  helper="$app_dir/.build/battlenet-capture-window"
  if [ ! -x "$helper" ] || [ "$app_dir/battlenet-capture-window.c" -nt "$helper" ]; then
    mkdir -p "$(dirname "$helper")"
    cc "$app_dir/battlenet-capture-window.c" -o "$helper" \
      $(pkg-config --cflags --libs gio-2.0 gio-unix-2.0 glib-2.0)
  fi

  desktop_dir="$HOME/.local/share/applications"
  desktop_file="$desktop_dir/battlenet-capture-window.desktop"
  installed_helper="$helper"

  tmp_desktop="$(mktemp)"
  cat > "$tmp_desktop" <<EOF
[Desktop Entry]
Name=Battle.net Window Capture
Exec=$installed_helper
Icon=battlenet
Type=Application
NoDisplay=true
StartupNotify=false
X-KDE-DBUS-Restricted-Interfaces=org.kde.kwin.Screenshot,org.kde.KWin.ScreenShot2
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management,zkde_screencast_unstable_v1
EOF
  install -Dm644 "$tmp_desktop" "$desktop_file"
  rm -f "$tmp_desktop" "$HOME/.local/share/applications/battlenet-window-capture.desktop"
  kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
  echo "$desktop_file"
}

window_handle() {
  kdotool search --class 'battle[.]net[.]exe' --limit 1 getwindowid %1 2>/dev/null \
    | head -n1
}

capture_foreground_window() {
  local output="$1"
  "$proton_dir/bin/proton-custom-dev" focus >/dev/null
  spectacle -b -n -a -o "$output" >/dev/null
  if [ ! -s "$output" ]; then
    echo "capture-method=none reason=spectacle-active-empty-output output=$output" >&2
    return 1
  fi
}

raw_capture_size() {
  local output="$1"
  local bytes pixels geometry width height

  bytes="$(stat -c '%s' "$output")"
  [ "$bytes" -gt 0 ] || return 1
  [ $((bytes % 4)) -eq 0 ] || return 1
  pixels=$((bytes / 4))

  geometry="$(kdotool search --class 'battle[.]net[.]exe' --limit 1 getwindowgeometry %1 2>/dev/null)"
  read -r width height < <(
    printf '%s\n' "$geometry" | awk -v pixels="$pixels" '
      /Geometry:/ {
        split($2, size, "x")
        logical_w = size[1]
        logical_h = size[2]
      }
      END {
        if (!logical_w || !logical_h) exit 1
        scale = sqrt(pixels / (logical_w * logical_h))
        width = int(logical_w * scale + 0.5)
        height = int(logical_h * scale + 0.5)
        if (width * height != pixels) exit 1
        print width, height
      }
    '
  )
  [ -n "${width:-}" ] && [ -n "${height:-}" ] || return 1
  printf '%sx%s\n' "$width" "$height"
}

normalize_capture_image() {
  local output="$1"
  local size tmp

  magick identify "$output" >/dev/null 2>&1 && return 0

  size="$(raw_capture_size "$output")"
  tmp="$(mktemp --tmpdir battlenet-window.XXXXXX.png)"
  magick -size "$size" -depth 8 RGBA:"$output" "$tmp"
  mv "$tmp" "$output"
}

capture_battlenet_window() {
  local output="$1"
  local handle request_dir request status started ended payload ok error fallback helper_error
  mkdir -p "$(dirname "$output")"
  handle="$(window_handle)"

  if [ -z "$handle" ]; then
    echo "capture-method=none reason=battlenet-window-not-found" >&2
    return 1
  fi

  fallback="${BATTLENET_CAPTURE_FALLBACK:-none}"
  if [ "$fallback" = "foreground" ]; then
    echo "capture-method=spectacle-active fallback=foreground reason=foreground-requested handle=$handle" >&2
    capture_foreground_window "$output"
    normalize_capture_image "$output"
    return 0
  fi

  helper_error=""
  if ! helper_error="$(install_capture_helper 2>&1 >/dev/null)"; then
    if [ "$fallback" = "foreground" ]; then
      echo "capture-method=spectacle-active fallback=foreground reason=kwin-helper-unavailable handle=$handle error=$helper_error" >&2
      capture_foreground_window "$output"
      normalize_capture_image "$output"
      return 0
    fi
    echo "capture-method=none reason=kwin-helper-unavailable handle=$handle error=$helper_error" >&2
    return 1
  fi

  request_dir="$runtime_dir/window-capture"
  request="$request_dir/request"
  status="$request_dir/status"
  mkdir -p "$request_dir"
  rm -f "$status"

  printf '%s\n%s\n' "$handle" "$output" > "$request"

  kstart --application battlenet-capture-window >/dev/null 2>&1 || true

  started="$(date +%s)"
  ended=$((started + 8))
  while [ "$(date +%s)" -le "$ended" ]; do
    [ -s "$status" ] && break
    sleep 0.1
  done

  if [ ! -s "$status" ]; then
    fallback="${BATTLENET_CAPTURE_FALLBACK:-none}"
    if [ "$fallback" = "foreground" ]; then
      echo "capture-method=spectacle-active fallback=foreground reason=kwin-window-timeout handle=$handle" >&2
      capture_foreground_window "$output"
      normalize_capture_image "$output"
      return 0
    fi
    echo "capture-method=none reason=kwin-window-timeout handle=$handle" >&2
    return 1
  fi

  payload="$(cat "$status")"
  ok="$(sed -n 's/^ok=//p' "$status" | head -n1)"
  if [ "$ok" = "1" ] && [ -s "$output" ]; then
    normalize_capture_image "$output"
    echo "capture-method=kwin-window handle=$handle"
    return 0
  fi

  error="$(sed -n 's/^message=//p' "$status" | head -n1)"
  fallback="${BATTLENET_CAPTURE_FALLBACK:-none}"
  if [ "$fallback" = "foreground" ]; then
    echo "capture-method=spectacle-active fallback=foreground reason=kwin-window-unavailable handle=$handle error=$error" >&2
    capture_foreground_window "$output"
    normalize_capture_image "$output"
    return 0
  fi

  echo "capture-method=none reason=kwin-window-unavailable handle=$handle error=$error payload=$payload" >&2
  return 1
}

probe_window() {
  run_in_devshell probe-window "$@"
  local output keep mean stdev min max classification
  output="${1:-}"
  keep=1
  if [ -z "$output" ]; then
    output="$(mktemp --tmpdir battlenet-window.XXXXXX.png)"
    keep=0
  fi
  if [ "$keep" = 0 ]; then
    trap 'rm -f "$output"' RETURN
  fi

  capture_battlenet_window "$output"

  read -r mean stdev min max < <(
    magick identify -format '%[fx:mean] %[fx:standard_deviation] %[fx:minima] %[fx:maxima]\n' "$output"
  )
  classification="$(
    awk -v mean="$mean" -v stdev="$stdev" '
      BEGIN {
        if (mean > 0.88 && stdev < 0.08) print "white";
        else if (mean < 0.04 && stdev < 0.04) print "black";
        else print "content";
      }
    '
  )"
  magick identify -format 'window width=%w height=%h ' "$output"
  printf 'mean=%s stdev=%s min=%s max=%s classification=%s\n' \
    "$mean" "$stdev" "$min" "$max" "$classification"
  if [ "$keep" = 1 ]; then
    echo "image=$output"
  fi
}

capture_window() {
  run_in_devshell capture-window "$@"
  local output="${1:-/tmp/battlenet-window.png}"
  capture_battlenet_window "$output"
  echo "$output"
}

frames_window() {
  run_in_devshell frames-window "$@"
  local output_dir="${1:-/tmp/battlenet-window-frames}"
  "$proton_dir/bin/proton-custom-dev" grab-frames --focus --count "${COUNT:-24}" \
    --interval "${INTERVAL:-0.12}" --mode active --format jpg --output-dir "$output_dir"
}

command="${1:-diagnose}"
shift || true

case "$command" in
  -h|--help) usage ;;
  status) status ;;
  logs) logs "$@" ;;
  sni) sni ;;
  context-menu) context_menu "$@" ;;
  window-info) window_info "$@" ;;
  cache-state) cache_state ;;
  reset-browser-cache) reset_browser_cache ;;
  install-capture-helper) install_capture_helper ;;
  probe-window) probe_window "$@" ;;
  capture-window) capture_window "$@" ;;
  frames-window) frames_window "$@" ;;
  diagnose)
    status
    sni
    logs "${1:-120}"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
