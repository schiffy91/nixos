#!/usr/bin/env bash
set -euo pipefail

app_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
nixos_dir="$(cd "$app_dir/../../../.." && pwd)"
proton_dir="$nixos_dir/modules/apps/pkg-overrides/proton-custom"

usage() {
  cat <<EOF
usage: battlenet-cycle [BUILD_MODE] [--no-run]

Runs the repeatable Battle.net test loop:
  1. proton-custom-build BUILD_MODE
  2. proton-custom-install dev
  3. battlenet-configure
  4. battlenet-run
  5. battlenet-debug diagnose

BUILD_MODE defaults to "changed". Use --no-run to stop after configure.
EOF
}

build_mode="changed"
run_launcher=1

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --no-run)
      run_launcher=0
      ;;
    *)
      build_mode="$1"
      ;;
  esac
  shift
done

"$proton_dir/bin/proton-custom-build" "$build_mode"
"$proton_dir/bin/proton-custom-install" dev
"$app_dir/bin/battlenet-configure"

if [ "$run_launcher" = 0 ]; then
  exit 0
fi

"$app_dir/bin/battlenet-run" &
pid=$!
echo "Battle.net pid: $pid"
sleep "${DELAY:-20}"
"$app_dir/bin/battlenet-debug" diagnose "${LOG_LINES:-120}"
echo "Battle.net left running; clean up with: $app_dir/bin/battlenet-make cleanup"
