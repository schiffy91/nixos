@@ -259,6 +259,27 @@ static void finish_tray_context_menu(const struct sni_callback *callback)
         NtUserPostMessage(callback->owner_hwnd, WM_NULL, 0, 0);
 }
 
+static void adjust_context_menu_position(const struct sni_item *item, int *x, int *y)
+{
+    int screen_x = NtUserGetSystemMetrics(SM_XVIRTUALSCREEN);
+    int screen_y = NtUserGetSystemMetrics(SM_YVIRTUALSCREEN);
+    int screen_w = NtUserGetSystemMetrics(SM_CXVIRTUALSCREEN);
+    int screen_h = NtUserGetSystemMetrics(SM_CYVIRTUALSCREEN);
+    int margin_x = max(max(item->icon_w, NtUserGetSystemMetrics(SM_CXSMICON)) * 2, 48);
+    int margin_y = max(max(item->icon_h, NtUserGetSystemMetrics(SM_CYSMICON)) * 2, 48);
+
+    if (screen_w > margin_x * 2)
+    {
+        if (*x < screen_x + margin_x) *x = screen_x + margin_x;
+        else if (*x > screen_x + screen_w - margin_x) *x = screen_x + screen_w - margin_x;
+    }
+    if (screen_h > margin_y * 2)
+    {
+        if (*y < screen_y + margin_y) *y = screen_y + margin_y;
+        else if (*y > screen_y + screen_h - margin_y) *y = screen_y + screen_h - margin_y;
+    }
+}
+
 void WAYLAND_SystrayProcessCallback(void *data)
 {
     struct sni_callback *callback = data;
@@ -280,6 +301,7 @@ void WAYLAND_SystrayProcessCallback(void *data)
         if (callback->context_menu)
         {
             NtUserSetForegroundWindow(callback->owner_hwnd);
+            WAYLAND_RequestWindowActivation(callback->owner_hwnd);
         }
 
         send_tray_callback(callback, callback->down_msg, FALSE);
@@ -312,6 +334,7 @@ static BOOL queue_tray_callback(const struct sni_item *item, UINT down_msg, UINT
     callback->x = x;
     callback->y = y;
     callback->context_menu = context_menu;
+    if (context_menu) adjust_context_menu_position(item, &callback->x, &callback->y);
 
     if (NtUserPostMessage(callback->window_hwnd, WM_WAYLAND_SNI_CALLBACK, 0, (LPARAM)callback))
         return TRUE;
