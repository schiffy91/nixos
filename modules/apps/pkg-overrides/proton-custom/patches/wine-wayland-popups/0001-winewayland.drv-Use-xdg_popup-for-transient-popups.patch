+static void wayland_surface_get_parent_relative_rect(struct wayland_surface *surface,
+                                                     struct wayland_surface *parent,
+                                                     int *x, int *y, int *width, int *height)
+{
+    int local_x = surface->window.rect.left - parent->window.rect.left;
+    int local_y = surface->window.rect.top - parent->window.rect.top;
+    int win_width = surface->window.rect.right - surface->window.rect.left;
+    int win_height = surface->window.rect.bottom - surface->window.rect.top;
+
+    wayland_surface_coords_from_window(surface, local_x, local_y, x, y);
+    wayland_surface_coords_from_window(surface, win_width, win_height, width, height);
+
+    if (!*width) *width = 1;
+    if (!*height) *height = 1;
+}
+
+static struct xdg_positioner *wayland_surface_create_positioner(struct wayland_surface *surface,
+                                                                struct wayland_surface *parent)
+{
+    struct xdg_positioner *positioner;
+    int x, y, width, height;
+
+    if (!(positioner = xdg_wm_base_create_positioner(process_wayland.xdg_wm_base))) return NULL;
+
+    wayland_surface_get_parent_relative_rect(surface, parent, &x, &y, &width, &height);
+    xdg_positioner_set_size(positioner, width, height);
+    xdg_positioner_set_anchor_rect(positioner, x, y, 1, 1);
+    xdg_positioner_set_anchor(positioner, XDG_POSITIONER_ANCHOR_TOP_LEFT);
+    xdg_positioner_set_gravity(positioner, XDG_POSITIONER_GRAVITY_BOTTOM_RIGHT);
+    xdg_positioner_set_constraint_adjustment(positioner,
+                                             XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_SLIDE_X |
+                                             XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_SLIDE_Y |
+                                             XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_FLIP_X |
+                                             XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_FLIP_Y);
+
+    return positioner;
+}
