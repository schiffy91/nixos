+static BOOL wayland_surface_create_fractional_scale(struct wayland_surface *surface,
+                                                    const char *role_name)
+{
+    if (!process_wayland.wp_fractional_scale_manager_v1) return TRUE;
+
+    surface->wp_fractional_scale_v1 =
+        wp_fractional_scale_manager_v1_get_fractional_scale(
+            process_wayland.wp_fractional_scale_manager_v1,
+            surface->wl_surface);
+    if (!surface->wp_fractional_scale_v1)
+    {
+        ERR("Failed to create %s wp_fractional_scale_v1\n", role_name);
+        return FALSE;
+    }
+    wp_fractional_scale_v1_add_listener(
+        surface->wp_fractional_scale_v1,
+        &wp_fractional_scale_listener,
+        surface->hwnd);
+
+    return TRUE;
+}
+
 static void wl_surface_handle_enter(void *user_data, struct wl_surface *wl_surface, struct wl_output *wl_output)
 {
     TRACE("surface %p output %p\n", wl_surface, wl_output);
@@ -213,6 +266,44 @@ static const struct zxdg_toplevel_decoration_v1_listener zxdg_toplevel_decoratio
     zxdg_toplevel_decoration_v1_configure
