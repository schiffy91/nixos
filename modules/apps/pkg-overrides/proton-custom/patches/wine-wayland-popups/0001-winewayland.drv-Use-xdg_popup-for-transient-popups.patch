-        {
-            ERR("Failed to create client wp_fractional_scale_v1\n");
-            goto err;
-        }
-        wp_fractional_scale_v1_add_listener(
-            surface->wp_fractional_scale_v1,
-            &wp_fractional_scale_listener,
-            surface->hwnd);
-    }
+    if (!wayland_surface_create_fractional_scale(surface, "client")) goto err;
 
     surface->role = WAYLAND_SURFACE_ROLE_SUBSURFACE;
     surface->toplevel_hwnd = parent->hwnd;
@@ -487,6 +600,28 @@ void wayland_surface_clear_role(struct wayland_surface *surface)
     case WAYLAND_SURFACE_ROLE_NONE:
         break;
 
+    case WAYLAND_SURFACE_ROLE_POPUP:
+        if (surface->wp_fractional_scale_v1)
+        {
+            wp_fractional_scale_v1_destroy(surface->wp_fractional_scale_v1);
+            surface->wp_fractional_scale_v1 = NULL;
+        }
+
+        if (surface->xdg_popup)
+        {
+            xdg_popup_destroy(surface->xdg_popup);
+            surface->xdg_popup = NULL;
+        }
+
+        if (surface->popup_xdg_surface)
+        {
+            xdg_surface_destroy(surface->popup_xdg_surface);
+            surface->popup_xdg_surface = NULL;
+        }
+
+        surface->popup_parent_hwnd = 0;
+        break;
+
     case WAYLAND_SURFACE_ROLE_TOPLEVEL:
         if (surface->xdg_toplevel_icon)
         {
@@ -886,6 +1021,25 @@ static void wayland_surface_reconfigure_subsurface(struct wayland_surface *surfa
     }
 }
 
+static void wayland_surface_reconfigure_popup(struct wayland_surface *surface)
+{
+    struct wayland_win_data *parent_data;
+    struct wayland_surface *parent_surface;
+    struct xdg_positioner *positioner;
+
+    if (!surface->processing.serial || !surface->processing.processed) return;
+    if (!(parent_data = wayland_win_data_get_nolock(surface->popup_parent_hwnd))) return;
+    if (!(parent_surface = parent_data->wayland_surface)) return;
+    if (!(positioner = wayland_surface_create_positioner(surface, parent_surface))) return;
+
+    if (xdg_popup_get_version(surface->xdg_popup) >= XDG_POPUP_REPOSITION_SINCE_VERSION)
+        xdg_popup_reposition(surface->xdg_popup, positioner, ++surface->popup_reposition_token);
+    xdg_positioner_destroy(positioner);
+    wl_surface_commit(surface->wl_surface);
+
+    memset(&surface->processing, 0, sizeof(surface->processing));
+}
+
 /**********************************************************************
  *          wayland_surface_reconfigure
  *
@@ -917,6 +1071,11 @@ BOOL wayland_surface_reconfigure(struct wayland_surface *surface)
         if (!surface->xdg_surface) break; /* surface role has been cleared */
         if (!wayland_surface_reconfigure_xdg(surface, width, height)) return FALSE;
         break;
+    case WAYLAND_SURFACE_ROLE_POPUP:
+        if (!surface->xdg_popup) break; /* surface role has been cleared */
+        if (!surface->current.serial) return FALSE;
+        wayland_surface_reconfigure_popup(surface);
+        break;
     case WAYLAND_SURFACE_ROLE_SUBSURFACE:
         if (!surface->wl_subsurface) break; /* surface role has been cleared */
         wayland_surface_reconfigure_subsurface(surface);
