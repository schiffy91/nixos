+static BOOL request_window_surface_activation(HWND hwnd)
+{
+    struct wayland_win_data *data;
+    BOOL ret = FALSE;
+
+    if ((data = wayland_win_data_get(hwnd)))
+    {
+        if (data->wayland_surface && wayland_surface_is_toplevel(data->wayland_surface))
+        {
+            wayland_surface_set_activation(data->wayland_surface, TRUE);
+            ret = TRUE;
+        }
+        wayland_win_data_release(data);
+    }
+
+    return ret;
+}
+
+void WAYLAND_RequestWindowActivation(HWND hwnd)
+{
+    DWORD process_id = 0;
+    HWND *list, root;
+    UINT i;
+
+    if (!hwnd) return;
+
+    NtUserGetWindowThread(hwnd, &process_id);
+    if ((root = NtUserGetAncestor(hwnd, GA_ROOT)) && request_window_surface_activation(root))
+        goto done;
+
+    if (process_id && (list = build_hwnd_list()))
+    {
+        for (i = 0; list[i] != HWND_BOTTOM; i++)
+        {
+            DWORD candidate_process = 0;
+
+            if (!NtUserIsWindowVisible(list[i])) continue;
+            NtUserGetWindowThread(list[i], &candidate_process);
+            if (candidate_process != process_id) continue;
+            if (request_window_surface_activation(list[i])) break;
+        }
+        free(list);
+    }
+
+done:
+    wl_display_flush(process_wayland.wl_display);
+}
+
 static BOOL has_owned_popups(HWND hwnd)
 {
     HWND *list;
@@ -481,6 +540,22 @@ static BOOL is_window_managed(HWND hwnd, UINT swp_flags, BOOL fullscreen)
     return FALSE;
 }
 
+static BOOL is_transient_popup(HWND hwnd, HWND owner_hint)
+{
+    DWORD style, ex_style;
+
+    if (!owner_hint) return FALSE;
+
+    style = NtUserGetWindowLongW(hwnd, GWL_STYLE);
+    if ((style & (WS_CHILD | WS_POPUP)) != WS_POPUP) return FALSE;
+    if (style & (WS_CAPTION | WS_THICKFRAME | WS_SYSMENU)) return FALSE;
+
+    ex_style = NtUserGetWindowLongW(hwnd, GWL_EXSTYLE);
+    if (ex_style & WS_EX_APPWINDOW) return FALSE;
+
+    return TRUE;
+}
