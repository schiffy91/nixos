From 2315c232abeb5ca2a489c412f977700a99ff1281 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Thu, 21 May 2026 03:54:10 -0700
Subject: [PATCH] dcomp: Make composition host windows presentation-only

The host HWND exists only to give DXVK a native target for a composition swap
chain. It should not have its own Win32 backing contents competing with the
swap chain surface.

Use WS_EX_NOREDIRECTIONBITMAP, as DirectComposition hosts commonly do on
Windows, and consume erase/paint messages without drawing. That prevents stale
host-window contents from briefly showing through while the GPU-backed
composition surface is being resized, moved, or rebound.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index a80b5ec..28ba0a6 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -153,6 +153,18 @@ static const WCHAR dcomp_host_class_name[] =
 
 static LRESULT CALLBACK dcomp_host_wndproc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
 {
+    PAINTSTRUCT ps;
+
+    switch (msg)
+    {
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_PAINT:
+        BeginPaint(hwnd, &ps);
+        EndPaint(hwnd, &ps);
+        return 0;
+    }
+
     return DefWindowProcW(hwnd, msg, wparam, lparam);
 }
 
@@ -784,7 +796,8 @@ static void dcomp_bind_visual(struct dcomp_target *t, struct dcomp_visual *v,
             if (!v->host_hwnd || v->host_parent != t->hwnd)
             {
                 if (v->host_hwnd) DestroyWindow(v->host_hwnd);
-                v->host_hwnd = CreateWindowExW(WS_EX_NOACTIVATE,
+                v->host_hwnd = CreateWindowExW(WS_EX_NOACTIVATE |
+                                               WS_EX_NOREDIRECTIONBITMAP,
                                                dcomp_host_class_name, NULL,
                                                WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_CLIPSIBLINGS,
                                                x, y, width, height, t->hwnd, NULL,
-- 
