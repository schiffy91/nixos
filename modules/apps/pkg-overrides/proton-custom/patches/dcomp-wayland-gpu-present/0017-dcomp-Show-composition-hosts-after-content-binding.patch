From af29c7ccba026c647c412f7b2115e7c37b76b5d1 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Mon, 25 May 2026 17:41:00 -0700
Subject: [PATCH] dcomp: Show surface hosts after content binding

Composition host HWNDs are implementation details for placed or clipped
visuals. Creating or moving them while visible can expose an uninitialized
child window before the DComp content has been bound.

Keep the host hidden while it is positioned, then show IDCompositionSurface
hosts after their backing content has been presented. Swap chain hosts remain
hidden until their first DXGI present.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index 35578fd..accc4a0 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -1487,7 +1487,7 @@ static void dcomp_bind_visual(struct dcomp_target *t, struct dcomp_visual *v,
                                                WS_EX_NOPARENTNOTIFY |
                                                WS_EX_NOREDIRECTIONBITMAP,
                                                dcomp_host_class_name, NULL,
-                                               WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_CLIPSIBLINGS,
+                                               WS_CHILD | WS_DISABLED | WS_CLIPSIBLINGS,
                                                x, y, width, height, t->hwnd, NULL,
                                                GetModuleHandleW(NULL), NULL);
                 dcomp_visual_reset_host_state(v);
@@ -1498,7 +1498,7 @@ static void dcomp_bind_visual(struct dcomp_target *t, struct dcomp_visual *v,
             {
                 BOOL changed = v->host_x != x || v->host_y != y ||
                                v->host_width != width || v->host_height != height;
-                UINT swp_flags = SWP_NOACTIVATE | SWP_NOOWNERZORDER | SWP_SHOWWINDOW;
+                UINT swp_flags = SWP_NOACTIVATE | SWP_NOOWNERZORDER;
 
                 if (!changed) swp_flags |= SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER;
 
@@ -1600,6 +1600,8 @@ static void dcomp_bind_visual(struct dcomp_target *t, struct dcomp_visual *v,
     {
         if (FAILED(dcomp_surface_present(surface, v->host_hwnd, t->hwnd)))
             WARN("surface=%p present failed\n", surface);
+        else
+            ShowWindow(v->host_hwnd, SW_SHOWNOACTIVATE);
     }
     else if (v->content &&
         SUCCEEDED(IUnknown_QueryInterface(v->content, &IID_IDXGIVkCompositionSwapChain,
-- 
