+
+    CRITICAL_SECTION cs;
+    BOOL             cs_init;
+};
+
+struct dcomp_visual
+{
+    IDCompositionVisual2 IDCompositionVisual2_iface;
+    LONG ref;
+    struct list entry;
+    struct dcomp_device *device;
+
+    IUnknown *content;                     /* AddRef'd; usually a swap chain or dcomp_surface */
+    BOOL has_swapchain_desc;
+    DXGI_SWAP_CHAIN_DESC1 swapchain_desc;
+    float offset_x, offset_y;
+    BOOL has_clip;
+    D2D_RECT_F clip;
