+static int round_float(float value)
+{
+    return (int)(value + (value >= 0.0f ? 0.5f : -0.5f));
+}
+
+static struct dcomp_placement dcomp_visual_placement(const struct dcomp_placement *parent,
+                                                     const struct dcomp_visual *v)
+{
+    struct dcomp_placement placement = *parent;
+
+    placement.x += round_float(v->offset_x + v->transform.dx);
+    placement.y += round_float(v->offset_y + v->transform.dy);
+    if (v->transform.m12 != 0.0f || v->transform.m21 != 0.0f ||
+        v->transform.m11 != 1.0f || v->transform.m22 != 1.0f)
+    {
+        FIXME("visual=%p non-translation transform not fully supported: "
+              "[%.8e %.8e %.8e %.8e %.8e %.8e]\n",
+              v, v->transform.m11, v->transform.m12, v->transform.m21,
+              v->transform.m22, v->transform.dx, v->transform.dy);
+    }
+    return placement;
+}
+
+static BOOL dcomp_refresh_swapchain_desc(struct dcomp_visual *v)
+{
+    IDXGISwapChain1 *sc1 = NULL;
+    DXGI_SWAP_CHAIN_DESC1 desc = {0};
+    HRESULT hr;
+
+    if (!v->content ||
+        FAILED(IUnknown_QueryInterface(v->content, &IID_IDXGISwapChain1, (void **)&sc1)) ||
+        !sc1)
+    {
+        v->has_swapchain_desc = FALSE;
+        memset(&v->swapchain_desc, 0, sizeof(v->swapchain_desc));
+        return FALSE;
+    }
+
+    hr = IDXGISwapChain1_GetDesc1(sc1, &desc);
+    IDXGISwapChain1_Release(sc1);
+    if (FAILED(hr))
+    {
+        v->has_swapchain_desc = FALSE;
+        memset(&v->swapchain_desc, 0, sizeof(v->swapchain_desc));
+        return FALSE;
+    }
+
+    v->has_swapchain_desc = TRUE;
+    v->swapchain_desc = desc;
+    return TRUE;
+}
+
+static void dcomp_bind_visual(struct dcomp_target *t, struct dcomp_visual *v,
+                              const struct dcomp_placement *parent_placement)
+{
+    struct dcomp_visual *c;
+    IDXGIVkCompositionSwapChain *composition_sc = NULL;
+    struct dcomp_placement placement;
+    HWND target_hwnd;
+
+    if (!v) return;
+    placement = dcomp_visual_placement(parent_placement, v);
+
+    TRACE("target=%p hwnd=%p visual=%p content=%p pos=(%d,%d) offset=(%.8e,%.8e) clip=%d composite=%u opacity=%u\n",
+          t, t->hwnd, v, v->content, placement.x, placement.y, v->offset_x,
+          v->offset_y, v->has_clip, v->composite_mode, v->opacity_mode);
+
+    target_hwnd = t->hwnd;
+    dcomp_refresh_swapchain_desc(v);
+    if (v->content && v->has_swapchain_desc &&
+        v->swapchain_desc.AlphaMode != DXGI_ALPHA_MODE_IGNORE)
+    {
+        int x = placement.x;
+        int y = placement.y;
+        UINT width = v->swapchain_desc.Width;
+        UINT height = v->swapchain_desc.Height;
+
+        if (v->has_clip)
+        {
+            int clip_left = placement.x + round_float(v->clip.left);
+            int clip_top = placement.y + round_float(v->clip.top);
+            int clip_right = placement.x + round_float(v->clip.right);
+            int clip_bottom = placement.y + round_float(v->clip.bottom);
+            int right = x + width;
+            int bottom = y + height;
+
+            if (clip_left > x) x = clip_left;
+            if (clip_top > y) y = clip_top;
+            if (clip_right < right) right = clip_right;
+            if (clip_bottom < bottom) bottom = clip_bottom;
+            width = right > x ? right - x : 0;
+            height = bottom > y ? bottom - y : 0;
+        }
+
+        if (width && height && dcomp_register_host_class())
+        {
+            if (!v->host_hwnd || v->host_parent != t->hwnd)
+            {
+                if (v->host_hwnd) DestroyWindow(v->host_hwnd);
+                v->host_hwnd = CreateWindowExW(WS_EX_NOACTIVATE | WS_EX_TRANSPARENT,
+                                               dcomp_host_class_name, NULL,
+                                               WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_CLIPSIBLINGS,
+                                               x, y, width, height, t->hwnd, NULL,
+                                               GetModuleHandleW(NULL), NULL);
+                v->host_parent = t->hwnd;
+                v->host_width = v->host_height = 0;
+            }
+
+            if (v->host_hwnd &&
+                (v->host_x != x || v->host_y != y ||
+                 v->host_width != width || v->host_height != height))
+            {
+                SetWindowPos(v->host_hwnd, HWND_TOP, x, y, width, height,
+                             SWP_NOACTIVATE | SWP_NOOWNERZORDER | SWP_SHOWWINDOW);
+                v->host_x = x;
+                v->host_y = y;
+                v->host_width = width;
+                v->host_height = height;
+            }
+
+            if (v->host_hwnd) target_hwnd = v->host_hwnd;
+        }
+    }
+
+    if (v->content &&
+        SUCCEEDED(IUnknown_QueryInterface(v->content, &IID_IDXGIVkCompositionSwapChain,
+                                          (void **)&composition_sc)) &&
+        composition_sc)
+    {
+        TRACE("binding composition swap chain content=%p hwnd=%p parent=%p alpha=%u\n",
+              v->content, target_hwnd, t->hwnd,
+              v->has_swapchain_desc ? v->swapchain_desc.AlphaMode : 0);
+        composition_sc->lpVtbl->SetCompositionTarget(composition_sc, target_hwnd, t->hwnd);
+        composition_sc->lpVtbl->Release(composition_sc);
+    }
+
+    LIST_FOR_EACH_ENTRY(c, &v->children, struct dcomp_visual, child_entry)
+        dcomp_bind_visual(t, c, &placement);
+}
+
+static HRESULT WINAPI device_Commit(IDCompositionDesktopDevice *iface)
+{
+    struct dcomp_device *d = impl_from_IDCompositionDesktopDevice(iface);
+    struct dcomp_target *t;
+    int target_count = 0;
+    TRACE("device=%p\n", d);
+
+    if (d->cs_init) EnterCriticalSection(&d->cs);
+    LIST_FOR_EACH_ENTRY(t, &d->targets, struct dcomp_target, entry)
+    {
+        const struct dcomp_placement placement = {0, 0};
+
+        target_count++;
+        TRACE("  target=%p hwnd=%p root=%p\n", t, t->hwnd, t->root);
+        if (t->root) dcomp_bind_visual(t, t->root, &placement);
+    }
+    d->pending_commit = FALSE;
+    if (d->cs_init) LeaveCriticalSection(&d->cs);
+    if (!target_count) TRACE("Commit with no targets registered\n");
+    return S_OK;
+}
