+    enum DCOMPOSITION_OPACITY_MODE opacity_mode;
+    HWND host_hwnd;
+    HWND host_parent;
+    UINT host_width, host_height;
+    int host_x, host_y;
+    struct list children;
+    struct list child_entry;               /* link in parent->children */
+    struct dcomp_visual *parent;
+    BOOL dirty;
+
+};
+
