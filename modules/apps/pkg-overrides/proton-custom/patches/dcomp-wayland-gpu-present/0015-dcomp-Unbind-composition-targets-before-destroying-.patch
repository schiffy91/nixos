From aece5fad4a9936c0484b564e2cf097bf56860465 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Fri, 22 May 2026 11:41:17 -0700
Subject: [PATCH] dcomp: Unbind composition targets before destroying hosts

Composition hosts are ordinary HWNDs used as presentation targets for DComp
swap-chain and surface content. When a host window is destroyed or replaced,
retarget the DXVK composition swap chain back to its dummy target first so the
presenter never keeps a stale Wayland/client-surface association for a dead
HWND.

Also avoid falling back to the root target when a visual requires a child host
for placement, clipping, or DComp surface presentation but no valid host can be
created. Leaving the content unbound is preferable to presenting it at the
wrong location or with the wrong clipping.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 73 +++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 70 insertions(+), 3 deletions(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index 0c6befa..f779d21 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -177,6 +177,7 @@ static const IDCompositionSurfaceFactoryVtbl dcomp_surface_factory_vtbl;
 static const IDCompositionTargetVtbl        dcomp_target_vtbl;
 
 static void dcomp_visual_unbind_hosts(struct dcomp_visual *v);
+static void dcomp_surface_unbind_swapchain(struct dcomp_surface *s);
 static void dcomp_surface_reset_swapchain(struct dcomp_surface *s);
 
 static const WCHAR dcomp_host_class_name[] =
@@ -1213,13 +1214,31 @@ static struct dcomp_surface *dcomp_visual_surface(struct dcomp_visual *v)
     return surface;
 }
 
+static void dcomp_content_unbind_swapchain(IUnknown *content)
+{
+    IDXGIVkCompositionSwapChain *composition_sc = NULL;
+
+    if (!content) return;
+    if (SUCCEEDED(IUnknown_QueryInterface(content, &IID_IDXGIVkCompositionSwapChain,
+                                          (void **)&composition_sc)) &&
+        composition_sc)
+    {
+        TRACE("unbinding composition swap chain content=%p\n", content);
+        composition_sc->lpVtbl->SetCompositionTarget(composition_sc, NULL, NULL);
+        composition_sc->lpVtbl->Release(composition_sc);
+    }
+}
+
 static void dcomp_visual_unbind_hosts(struct dcomp_visual *v)
 {
     struct dcomp_surface *surface;
     struct dcomp_visual *c;
 
+    dcomp_content_unbind_swapchain(v->content);
+
     if ((surface = dcomp_visual_surface(v)))
     {
+        dcomp_surface_unbind_swapchain(surface);
         surface->target_hwnd = NULL;
         surface->dirty = TRUE;
     }
@@ -1256,6 +1275,8 @@ static BOOL dcomp_visual_needs_host(const struct dcomp_visual *v, BOOL has_surfa
 
 static void dcomp_surface_reset_swapchain(struct dcomp_surface *s)
 {
+    dcomp_surface_unbind_swapchain(s);
+
     if (s->swapchain)
     {
         IDXGISwapChain1_Release(s->swapchain);
@@ -1269,6 +1290,27 @@ static void dcomp_surface_reset_swapchain(struct dcomp_surface *s)
     s->dirty = TRUE;
 }
 
+static void dcomp_surface_unbind_swapchain(struct dcomp_surface *s)
+{
+    IDXGIVkCompositionSwapChain *composition_sc = NULL;
+
+    if (!s->swapchain) return;
+    if (!s->target_hwnd) return;
+
+    if (SUCCEEDED(IDXGISwapChain1_QueryInterface(s->swapchain, &IID_IDXGIVkCompositionSwapChain,
+                                                 (void **)&composition_sc)) &&
+        composition_sc)
+    {
+        TRACE("surface=%p unbinding composition swapchain %p from hwnd=%p\n",
+              s, s->swapchain, s->target_hwnd);
+        composition_sc->lpVtbl->SetCompositionTarget(composition_sc, NULL, NULL);
+        composition_sc->lpVtbl->Release(composition_sc);
+    }
+
+    s->target_hwnd = NULL;
+    s->dirty = TRUE;
+}
+
 static HRESULT dcomp_surface_create_swapchain(struct dcomp_surface *s)
 {
     DXGI_SWAP_CHAIN_DESC1 desc = {0};
@@ -1409,6 +1451,7 @@ static void dcomp_bind_visual(struct dcomp_target *t, struct dcomp_visual *v,
     IDXGIVkCompositionSwapChain *composition_sc = NULL;
     struct dcomp_placement placement;
     HWND target_hwnd;
+    BOOL needs_host, host_ready = FALSE;
 
     if (!v) return;
     placement = dcomp_visual_placement(parent_placement, v);
@@ -1420,7 +1463,8 @@ static void dcomp_bind_visual(struct dcomp_target *t, struct dcomp_visual *v,
     target_hwnd = t->hwnd;
     surface = dcomp_visual_surface(v);
     dcomp_refresh_swapchain_desc(v);
-    if (v->content && dcomp_visual_needs_host(v, !!surface))
+    needs_host = v->content && dcomp_visual_needs_host(v, !!surface);
+    if (needs_host)
     {
         RECT host_clip;
         int x = placement.x;
@@ -1433,7 +1477,12 @@ static void dcomp_bind_visual(struct dcomp_target *t, struct dcomp_visual *v,
         {
             if (!v->host_hwnd || v->host_parent != t->hwnd)
             {
-                if (v->host_hwnd) DestroyWindow(v->host_hwnd);
+                if (v->host_hwnd)
+                {
+                    if (surface) dcomp_surface_unbind_swapchain(surface);
+                    else dcomp_content_unbind_swapchain(v->content);
+                    DestroyWindow(v->host_hwnd);
+                }
                 v->host_hwnd = CreateWindowExW(WS_EX_NOACTIVATE |
                                                WS_EX_NOREDIRECTIONBITMAP,
                                                dcomp_host_class_name, NULL,
@@ -1512,9 +1561,12 @@ static void dcomp_bind_visual(struct dcomp_target *t, struct dcomp_visual *v,
             }
 
             if (v->host_hwnd) target_hwnd = v->host_hwnd;
+            host_ready = !!v->host_hwnd;
         }
         else if (v->host_hwnd)
         {
+            if (surface) dcomp_surface_unbind_swapchain(surface);
+            else dcomp_content_unbind_swapchain(v->content);
             DestroyWindow(v->host_hwnd);
             v->host_hwnd = NULL;
             dcomp_visual_reset_host_state(v);
@@ -1523,12 +1575,27 @@ static void dcomp_bind_visual(struct dcomp_target *t, struct dcomp_visual *v,
     }
     else if (v->host_hwnd)
     {
+        if (surface) dcomp_surface_unbind_swapchain(surface);
+        else dcomp_content_unbind_swapchain(v->content);
         DestroyWindow(v->host_hwnd);
         v->host_hwnd = NULL;
         dcomp_visual_reset_host_state(v);
     }
 
-    if (surface && v->host_hwnd)
+    if (needs_host && !host_ready)
+    {
+        if (surface)
+        {
+            dcomp_surface_unbind_swapchain(surface);
+            TRACE("surface=%p has no valid composition host; leaving unbound\n", surface);
+        }
+        else
+        {
+            dcomp_content_unbind_swapchain(v->content);
+            TRACE("visual=%p has no valid composition host; leaving content unbound\n", v);
+        }
+    }
+    else if (surface && v->host_hwnd)
     {
         if (FAILED(dcomp_surface_present(surface, v->host_hwnd, t->hwnd)))
             WARN("surface=%p present failed\n", surface);
-- 
