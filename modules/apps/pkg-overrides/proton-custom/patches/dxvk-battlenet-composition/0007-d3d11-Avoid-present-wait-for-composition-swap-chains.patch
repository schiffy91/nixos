From 13e4633af0d8c5de46d53e111552b94b3af94f27 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Mon, 25 May 2026 09:42:44 -0700
Subject: [PATCH] d3d11: Avoid present wait for composition swap chains

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 src/d3d11/d3d11_swapchain.cpp | 18 ++++++++++--------
 src/dxvk/dxvk_device.cpp      |  4 +++-
 src/dxvk/dxvk_device.h        |  3 ++-
 src/dxvk/dxvk_presenter.cpp   | 14 +++++++++-----
 src/dxvk/dxvk_presenter.h     |  6 ++++--
 src/dxvk/dxvk_queue.cpp       |  6 ++++--
 src/dxvk/dxvk_queue.h         |  1 +
 7 files changed, 33 insertions(+), 19 deletions(-)

diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index b1fc493..718abb2 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -501,6 +501,12 @@ namespace dxvk {
 
     m_presenter->setSyncInterval(GetCompositionSyncInterval(SyncInterval));
 
+    bool compositionTarget = false;
+    {
+      std::lock_guard<dxvk::mutex> lock(m_compositionLock);
+      compositionTarget = m_compositionTarget != nullptr;
+    }
+
     // Presentation semaphores and WSI swap chain image
     if (m_latency)
       m_latency->notifyCpuPresentBegin(m_frameId + 1u);
@@ -542,7 +548,8 @@ namespace dxvk {
       cPresenter      = m_presenter,
       cLatency        = m_latency,
       cColorSpace     = m_colorSpace,
-      cFrameId        = m_frameId
+      cFrameId        = m_frameId,
+      cWaitForPresent = !compositionTarget
     ] (DxvkContext* ctx) {
       // Update back buffer color space as necessary
       if (cSwapImage->image()->info().colorSpace != cColorSpace) {
@@ -564,15 +571,10 @@ namespace dxvk {
       ctx->synchronizeWsi(cSync);
       ctx->flushCommandList(nullptr, nullptr);
 
-      cDevice->presentImage(cPresenter, cLatency, cFrameId, nullptr);
+      cDevice->presentImage(cPresenter, cLatency, cFrameId, nullptr,
+        cWaitForPresent);
     });
 
-    bool compositionTarget = false;
-    {
-      std::lock_guard<dxvk::mutex> lock(m_compositionLock);
-      compositionTarget = m_compositionTarget;
-    }
-
     if (m_backBuffers.size() > 1u)
       RotateBackBuffers(immediateContext, compositionTarget);
 
diff --git a/src/dxvk/dxvk_device.cpp b/src/dxvk/dxvk_device.cpp
index 87c1a95..75225a0 100644
--- a/src/dxvk/dxvk_device.cpp
+++ b/src/dxvk/dxvk_device.cpp
@@ -606,10 +606,12 @@ namespace dxvk {
     const Rc<Presenter>&            presenter,
     const Rc<DxvkLatencyTracker>&   tracker,
           uint64_t                  frameId,
-          DxvkSubmitStatus*         status) {
+          DxvkSubmitStatus*         status,
+          bool                      waitForPresent) {
     DxvkPresentInfo presentInfo = { };
     presentInfo.presenter = presenter;
     presentInfo.frameId = frameId;
+    presentInfo.waitForPresent = waitForPresent;
 
     DxvkLatencyInfo latencyInfo;
     latencyInfo.tracker = tracker;
diff --git a/src/dxvk/dxvk_device.h b/src/dxvk/dxvk_device.h
index ed5e6e2..8c18ab3 100644
--- a/src/dxvk/dxvk_device.h
+++ b/src/dxvk/dxvk_device.h
@@ -645,7 +645,8 @@ namespace dxvk {
       const Rc<Presenter>&            presenter,
       const Rc<DxvkLatencyTracker>&   tracker,
             uint64_t                  frameId,
-            DxvkSubmitStatus*         status);
+            DxvkSubmitStatus*         status,
+            bool                      waitForPresent = true);
     
     /**
      * \brief Submits a command list
diff --git a/src/dxvk/dxvk_presenter.cpp b/src/dxvk/dxvk_presenter.cpp
index 6b03782..ee64b43 100644
--- a/src/dxvk/dxvk_presenter.cpp
+++ b/src/dxvk/dxvk_presenter.cpp
@@ -172,7 +172,10 @@ namespace dxvk {
   }
 
 
-  VkResult Presenter::presentImage(uint64_t frameId, const Rc<DxvkLatencyTracker>& tracker) {
+  VkResult Presenter::presentImage(
+          uint64_t                frameId,
+    const Rc<DxvkLatencyTracker>& tracker,
+          bool                    waitForPresent) {
     PresenterSync& currSync = m_semaphores.at(m_frameIndex);
 
     VkPresentIdKHR presentId = { VK_STRUCTURE_TYPE_PRESENT_ID_KHR };
@@ -234,7 +237,7 @@ namespace dxvk {
     }
 
     // Add frame to waiter queue with current properties
-    if (m_hasPresentWait) {
+    if (m_hasPresentWait && waitForPresent) {
       std::lock_guard lock(m_frameMutex);
 
       auto& frame = m_frameQueue.emplace();
@@ -248,7 +251,7 @@ namespace dxvk {
 
     // On a successful present, try to acquire next image already, in
     // order to hide potential delays from the application thread.
-    if (status == VK_SUCCESS) {
+    if (status == VK_SUCCESS && waitForPresent) {
       PresenterSync& nextSync = m_semaphores.at(m_frameIndex);
       waitForSwapchainFence(nextSync);
 
@@ -275,11 +278,12 @@ namespace dxvk {
 
   void Presenter::signalFrame(
           uint64_t                frameId,
-    const Rc<DxvkLatencyTracker>& tracker) {
+    const Rc<DxvkLatencyTracker>& tracker,
+          bool                    waitForPresent) {
     if (m_signal == nullptr || !frameId)
       return;
 
-    if (m_hasPresentWait) {
+    if (m_hasPresentWait && waitForPresent) {
       bool canSignal = false;
 
       { std::unique_lock lock(m_frameMutex);
diff --git a/src/dxvk/dxvk_presenter.h b/src/dxvk/dxvk_presenter.h
index 72bce28..e53c7d7 100644
--- a/src/dxvk/dxvk_presenter.h
+++ b/src/dxvk/dxvk_presenter.h
@@ -130,7 +130,8 @@ namespace dxvk {
      */
     VkResult presentImage(
             uint64_t                frameId,
-      const Rc<DxvkLatencyTracker>& tracker);
+      const Rc<DxvkLatencyTracker>& tracker,
+            bool                    waitForPresent);
 
     /**
      * \brief Signals a given frame
@@ -144,7 +145,8 @@ namespace dxvk {
      */
     void signalFrame(
             uint64_t                frameId,
-      const Rc<DxvkLatencyTracker>& tracker);
+      const Rc<DxvkLatencyTracker>& tracker,
+            bool                    waitForPresent);
 
     /**
      * \brief Changes sync interval
diff --git a/src/dxvk/dxvk_queue.cpp b/src/dxvk/dxvk_queue.cpp
index 6d2d153..b75d5be 100644
--- a/src/dxvk/dxvk_queue.cpp
+++ b/src/dxvk/dxvk_queue.cpp
@@ -170,7 +170,8 @@ namespace dxvk {
             entry.latency.tracker->notifyQueuePresentBegin(entry.latency.frameId);
 
           entry.result = entry.present.presenter->presentImage(
-            entry.present.frameId, entry.latency.tracker);
+            entry.present.frameId, entry.latency.tracker,
+            entry.present.waitForPresent);
 
           if (entry.latency.tracker) {
             entry.latency.tracker->notifyQueuePresentEnd(
@@ -275,7 +276,8 @@ namespace dxvk {
         // Signal the frame and then immediately destroy the reference.
         // This is necessary since the front-end may want to explicitly
         // destroy the presenter object. 
-        entry.present.presenter->signalFrame(entry.present.frameId, entry.latency.tracker);
+        entry.present.presenter->signalFrame(entry.present.frameId,
+          entry.latency.tracker, entry.present.waitForPresent);
         entry.present.presenter = nullptr;
       }
 
diff --git a/src/dxvk/dxvk_queue.h b/src/dxvk/dxvk_queue.h
index 4cc63ef..be09b6a 100644
--- a/src/dxvk/dxvk_queue.h
+++ b/src/dxvk/dxvk_queue.h
@@ -45,6 +45,7 @@ namespace dxvk {
   struct DxvkPresentInfo {
     Rc<Presenter>       presenter;
     uint64_t            frameId;
+    bool                waitForPresent = true;
   };
 
 
-- 
2.53.0
