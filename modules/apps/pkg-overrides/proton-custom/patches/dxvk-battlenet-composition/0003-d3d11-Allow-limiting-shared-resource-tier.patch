From 77444e8920efc283497afab0c8140d433755fee8 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Thu, 21 May 2026 06:10:30 -0700
Subject: [PATCH] d3d11: Allow limiting shared resource tier

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 src/d3d11/d3d11_features.cpp | 22 +++++++++++++++++++++-
 src/d3d11/d3d11_options.cpp  |  1 +
 src/d3d11/d3d11_options.h    |  3 +++
 src/util/config/config.cpp   |  3 ++-
 4 files changed, 27 insertions(+), 2 deletions(-)

diff --git a/src/d3d11/d3d11_features.cpp b/src/d3d11/d3d11_features.cpp
index 504145b..567ae92 100644
--- a/src/d3d11/d3d11_features.cpp
+++ b/src/d3d11/d3d11_features.cpp
@@ -4,6 +4,24 @@

 namespace dxvk {

+  static D3D11_SHARED_RESOURCE_TIER CapSharedResourceTier(
+          D3D11_SHARED_RESOURCE_TIER tier,
+          int32_t                   cap) {
+    if (cap < 0)
+      return tier;
+
+    if (cap <= 0)
+      return D3D11_SHARED_RESOURCE_TIER_0;
+
+    if (cap == 1 && tier > D3D11_SHARED_RESOURCE_TIER_1)
+      return D3D11_SHARED_RESOURCE_TIER_1;
+
+    if (cap == 2 && tier > D3D11_SHARED_RESOURCE_TIER_2)
+      return D3D11_SHARED_RESOURCE_TIER_2;
+
+    return tier;
+  }
+
   D3D11DeviceFeatures::D3D11DeviceFeatures() {

   }
@@ -36,7 +54,9 @@ namespace dxvk {
     m_d3d10Options.ComputeShaders_Plus_RawAndStructuredBuffers_Via_Shader_4_x = TRUE;

     // D3D11.1 options. All of these are required for Feature Level 11_1.
-    auto sharedResourceTier = DetermineSharedResourceTier(Adapter, FeatureLevel);
+    auto sharedResourceTier = CapSharedResourceTier(
+      DetermineSharedResourceTier(Adapter, FeatureLevel),
+      Options.maxSharedResourceTier);

     bool hasDoublePrecisionSupport = m_features.core.features.shaderFloat64
                                   && m_features.core.features.shaderInt64;
diff --git a/src/d3d11/d3d11_options.cpp b/src/d3d11/d3d11_options.cpp
index adf426d..0567451 100644
--- a/src/d3d11/d3d11_options.cpp
+++ b/src/d3d11/d3d11_options.cpp
@@ -27,5 +27,6 @@ namespace dxvk {
     this->deferSurfaceCreation  = config.getOption<bool>("dxgi.deferSurfaceCreation", false);
     this->maxFrameLatency       = config.getOption<int32_t>("dxgi.maxFrameLatency", 0);
+    this->maxSharedResourceTier = config.getOption<int32_t>("d3d11.maxSharedResourceTier", -1);
     this->exposeDriverCommandLists = config.getOption<bool>("d3d11.exposeDriverCommandLists", true);
     this->reproducibleCommandStream = config.getOption<bool>("d3d11.reproducibleCommandStream", false);
     this->disableDirectImageMapping = config.getOption<bool>("d3d11.disableDirectImageMapping", false);
diff --git a/src/d3d11/d3d11_options.h b/src/d3d11/d3d11_options.h
index 3bf1e5e..ea4ac66 100644
--- a/src/d3d11/d3d11_options.h
+++ b/src/d3d11/d3d11_options.h
@@ -66,4 +66,7 @@ namespace dxvk {

+    /// Highest D3D11 shared resource tier reported to applications.
+    int32_t maxSharedResourceTier = -1;
+
     /// Defer surface creation until first present call. This
     /// fixes issues with games that create multiple swap chains
     /// for a single window that may interfere with each other.
diff --git a/src/util/config/config.cpp b/src/util/config/config.cpp
index af9ea69..8f13a7f 100644
--- a/src/util/config/config.cpp
+++ b/src/util/config/config.cpp
@@ -62,6 +62,7 @@ namespace dxvk {
     /* Battle.net: Uses DirectComposition swap chains in the launcher. */
     { R"(\\Battle\.net\.exe$)", {{
-      { "dxgi.enableDummyCompositionSwapchain", "True" }
+      { "dxgi.enableDummyCompositionSwapchain", "True" },
+      { "d3d11.maxSharedResourceTier", "0" }
     }} },

     /**********************************************/
--
2.53.0
