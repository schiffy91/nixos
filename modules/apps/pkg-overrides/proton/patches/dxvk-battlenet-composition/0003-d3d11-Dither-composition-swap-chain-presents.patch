 src/d3d11/d3d11_options.h                     |  3 +++
 src/d3d11/d3d11_swapchain.cpp                 | 13 ++++++++--
 src/d3d11/d3d11_swapchain.h                   |  2 ++
 src/dxvk/dxvk_swapchain_blitter.cpp           | 24 +++++++++++++++---
 src/dxvk/dxvk_swapchain_blitter.h             |  7 ++++--
