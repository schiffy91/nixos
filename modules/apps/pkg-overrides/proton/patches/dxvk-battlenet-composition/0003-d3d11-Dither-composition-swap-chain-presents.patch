index adf426d..aca61e2 100644
--- a/src/d3d11/d3d11_options.cpp
+++ b/src/d3d11/d3d11_options.cpp
@@ -28,2 +28,3 @@ namespace dxvk {
     this->maxFrameLatency       = config.getOption<int32_t>("dxgi.maxFrameLatency", 0);
+    this->ditherCompositionSwapchain = config.getOption<bool>("dxgi.ditherCompositionSwapchain", false);
     this->exposeDriverCommandLists = config.getOption<bool>("d3d11.exposeDriverCommandLists", true);
diff --git a/src/d3d11/d3d11_options.h b/src/d3d11/d3d11_options.h
index 3bf1e5e..456c601 100644
--- a/src/d3d11/d3d11_options.h
+++ b/src/d3d11/d3d11_options.h
@@ -66,2 +66,5 @@ namespace dxvk {
 
+    /// Apply output dithering to composition swap chains.
+    bool ditherCompositionSwapchain = false;
+
     /// Defer surface creation until first present call. This
diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index 28d7f90..d137692 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -437,2 +437,9 @@ namespace dxvk {
 
+  VkBool32 D3D11SwapChain::GetCompositionDither() {
+    std::lock_guard<dxvk::mutex> lock(m_compositionLock);
+
+    return m_compositionTarget && m_parent->GetOptions()->ditherCompositionSwapchain;
+  }
+
+
   Rc<DxvkImageView> D3D11SwapChain::GetBackBufferView() {
@@ -505,3 +512,4 @@ namespace dxvk {
       cColorSpace     = m_colorSpace,
-      cFrameId        = m_frameId
+      cFrameId        = m_frameId,
+      cDither         = GetCompositionDither()
     ] (DxvkContext* ctx) {
@@ -521,3 +529,4 @@ namespace dxvk {
         cBackBuffer, VkRect2D(),
-        cSwapImage, VkRect2D());
+        cSwapImage, VkRect2D(),
+        cDither);
 
diff --git a/src/d3d11/d3d11_swapchain.h b/src/d3d11/d3d11_swapchain.h
index 63983dc..d1ad0aa 100644
--- a/src/d3d11/d3d11_swapchain.h
+++ b/src/d3d11/d3d11_swapchain.h
@@ -163,2 +163,4 @@ namespace dxvk {
 
+    VkBool32 GetCompositionDither();
+
     HRESULT PresentImage(UINT SyncInterval);
diff --git a/src/dxvk/dxvk_swapchain_blitter.cpp b/src/dxvk/dxvk_swapchain_blitter.cpp
index 9f6e7eb..3183170 100644
--- a/src/dxvk/dxvk_swapchain_blitter.cpp
+++ b/src/dxvk/dxvk_swapchain_blitter.cpp
@@ -11,2 +11,17 @@
 namespace dxvk {
+
+  static bool IsDitheredSwapchainFormat(VkFormat format) {
+    switch (format) {
+      case VK_FORMAT_R8G8B8A8_UNORM:
+      case VK_FORMAT_R8G8B8A8_SRGB:
+      case VK_FORMAT_B8G8R8A8_UNORM:
+      case VK_FORMAT_B8G8R8A8_SRGB:
+      case VK_FORMAT_A8B8G8R8_UNORM_PACK32:
+      case VK_FORMAT_A8B8G8R8_SRGB_PACK32:
+        return true;
+
+      default:
+        return false;
+    }
+  }
   
@@ -38,3 +53,4 @@ namespace dxvk {
     const Rc<DxvkImageView>&  srcView,
-          VkRect2D            srcRect) {
+          VkRect2D            srcRect,
+          VkBool32            dither) {
     std::unique_lock lock(m_mutex);
@@ -113,3 +129,3 @@ namespace dxvk {
     performDraw(ctx, dstView, dstRect,
-      srcView, srcRect, composite);
+      srcView, srcRect, composite, dither);
 
@@ -248,3 +264,4 @@ namespace dxvk {
           VkRect2D            srcRect,
-          VkBool32            composite) {
+          VkBool32            composite,
+          VkBool32            dither) {
     VkColorSpaceKHR dstColorSpace = dstView->image()->info().colorSpace;
@@ -345,2 +362,3 @@ namespace dxvk {
     args.samplerCursor = cursorSampler;
+    args.outputDither = dither && IsDitheredSwapchainFormat(dstView->info().format);
 
diff --git a/src/dxvk/dxvk_swapchain_blitter.h b/src/dxvk/dxvk_swapchain_blitter.h
index b210303..f41018a 100644
--- a/src/dxvk/dxvk_swapchain_blitter.h
+++ b/src/dxvk/dxvk_swapchain_blitter.h
@@ -137,3 +137,4 @@ namespace dxvk {
       const Rc<DxvkImageView>&  srcView,
-            VkRect2D            srcRect);
+            VkRect2D            srcRect,
+            VkBool32            dither = VK_FALSE);
 
@@ -197,2 +198,3 @@ namespace dxvk {
       uint32_t   samplerCursor;
+      uint32_t   outputDither;
     };
@@ -248,3 +250,4 @@ namespace dxvk {
             VkRect2D                    srcRect,
-            VkBool32                    composite);
+            VkBool32                    composite,
+            VkBool32                    dither);
 
diff --git a/src/dxvk/shaders/dxvk_present_common.glsl b/src/dxvk/shaders/dxvk_present_common.glsl
index 5836e44..7eb732c 100644
--- a/src/dxvk/shaders/dxvk_present_common.glsl
+++ b/src/dxvk/shaders/dxvk_present_common.glsl
@@ -32,2 +32,3 @@ uniform present_info_t {
   uint sampler_cursor;
+  uint output_dither;
 };
@@ -66,2 +67,26 @@ vec4 composite_image(vec4 color) {
 
+float dither_noise(ivec2 coord) {
+  uvec2 n = uvec2(coord);
+  uint state = n.x * 0x9e3779b9u + n.y * 0xbb67ae85u;
+
+  state ^= state >> 16;
+  state *= 0x85ebca6bu;
+  state ^= state >> 13;
+  state *= 0xc2b2ae35u;
+  state ^= state >> 16;
+
+  return float(state & 0xffffu) * (1.0f / 65535.0f) - 0.5f;
+}
+
+
+vec4 dither_output(vec4 color) {
+  if (output_dither != 0u) {
+    float noise = dither_noise(ivec2(gl_FragCoord.xy)) * (1.0f / 255.0f);
+    color.rgb += vec3(noise * min(color.a, 1.0f));
+  }
+
+  return color;
+}
+
+
 vec4 input_to_sc_rgb(vec4 color) {
diff --git a/src/dxvk/shaders/dxvk_present_frag.frag b/src/dxvk/shaders/dxvk_present_frag.frag
index f934e91..177e6ae 100644
--- a/src/dxvk/shaders/dxvk_present_frag.frag
+++ b/src/dxvk/shaders/dxvk_present_frag.frag
@@ -13,3 +13,3 @@ void main() {
   o_color = composite_image(o_color);
-  o_color = sc_rgb_to_output(o_color);
+  o_color = dither_output(sc_rgb_to_output(o_color));
 }
diff --git a/src/dxvk/shaders/dxvk_present_frag_blit.frag b/src/dxvk/shaders/dxvk_present_frag_blit.frag
index ac07d05..92f11a4 100644
--- a/src/dxvk/shaders/dxvk_present_frag_blit.frag
+++ b/src/dxvk/shaders/dxvk_present_frag_blit.frag
@@ -35,3 +35,3 @@ void main() {
   o_color = composite_image(o_color);
-  o_color = sc_rgb_to_output(o_color);
+  o_color = dither_output(sc_rgb_to_output(o_color));
 }
diff --git a/src/dxvk/shaders/dxvk_present_frag_ms.frag b/src/dxvk/shaders/dxvk_present_frag_ms.frag
index e5bf1ae..062bc34 100644
--- a/src/dxvk/shaders/dxvk_present_frag_ms.frag
+++ b/src/dxvk/shaders/dxvk_present_frag_ms.frag
@@ -16,3 +16,3 @@ void main() {
   o_color = composite_image(o_color / float(c_samples));
-  o_color = sc_rgb_to_output(o_color);
+  o_color = dither_output(sc_rgb_to_output(o_color));
 }
diff --git a/src/dxvk/shaders/dxvk_present_frag_ms_blit.frag b/src/dxvk/shaders/dxvk_present_frag_ms_blit.frag
index a565f88..41e2b59 100644
--- a/src/dxvk/shaders/dxvk_present_frag_ms_blit.frag
+++ b/src/dxvk/shaders/dxvk_present_frag_ms_blit.frag
@@ -64,3 +64,3 @@ void main() {
   o_color = composite_image(o_color / float(c_samples));
-  o_color = sc_rgb_to_output(o_color);
+  o_color = dither_output(sc_rgb_to_output(o_color));
 }
diff --git a/src/util/config/config.cpp b/src/util/config/config.cpp
index af9ea69..bca49f1 100644
--- a/src/util/config/config.cpp
+++ b/src/util/config/config.cpp
@@ -63,3 +63,4 @@ namespace dxvk {
     { R"(\\Battle\.net\.exe$)", {{
-      { "dxgi.enableDummyCompositionSwapchain", "True" }
+      { "dxgi.enableDummyCompositionSwapchain", "True" },
+      { "dxgi.ditherCompositionSwapchain", "True" }
     }} },
