+/**
+ * \brief Private DXGI composition swap chain interface
+ *
+ * Lets Wine's DirectComposition implementation bind a composition swap chain
+ * to the window that owns the visual tree. DXVK can then present the swap
+ * chain through its regular WSI path.
+ */
+MIDL_INTERFACE("4765d18a-eba0-40bd-a730-7f5f3d915c1f")
+IDXGIVkCompositionSwapChain : public IUnknown {
+  virtual void STDMETHODCALLTYPE SetCompositionTarget(
+          HWND                      hTarget,
+          HWND                      hDispatch) = 0;
+};
+
 
 /**
  * \brief Private DXGI presenter factory
@@ -479,5 +496,6 @@ __CRT_UUID_DECL(IDXGIVkSurfaceFactory,     0x1e7895a1,0x1bc3,0x4f9c,0xa6,0x70,0x
 __CRT_UUID_DECL(IDXGIVkSwapChain,          0xe4a9059e,0xb569,0x46ab,0x8d,0xe7,0x50,0x1b,0xd2,0xbc,0x7f,0x7a);
 __CRT_UUID_DECL(IDXGIVkSwapChain1,         0x785326d4,0xb77b,0x4826,0xae,0x70,0x8d,0x08,0x30,0x8e,0xe6,0xd1);
 __CRT_UUID_DECL(IDXGIVkSwapChain2,         0xaed91093,0xe02e,0x458c,0xbd,0xef,0xa9,0x7d,0xa1,0xa7,0xe6,0xd2);
