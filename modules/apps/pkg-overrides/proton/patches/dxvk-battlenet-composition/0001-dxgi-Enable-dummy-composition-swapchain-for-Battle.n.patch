@@ -25,6 +25,17 @@ namespace dxvk {
     }
   }
 
+  static VkCompositeAlphaFlagBitsKHR ConvertCompositeAlpha(DXGI_ALPHA_MODE mode) {
+    switch (mode) {
+      case DXGI_ALPHA_MODE_PREMULTIPLIED:
+        return VK_COMPOSITE_ALPHA_PRE_MULTIPLIED_BIT_KHR;
+      case DXGI_ALPHA_MODE_STRAIGHT:
+        return VK_COMPOSITE_ALPHA_POST_MULTIPLIED_BIT_KHR;
+      default:
+        return VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+    }
+  }
+
   static VkXYColorEXT ConvertXYColor(const UINT16 (&dxgiColor)[2]) {
     return VkXYColorEXT{ float(dxgiColor[0]) / 50000.0f, float(dxgiColor[1]) / 50000.0f };
   }
@@ -61,6 +72,7 @@ namespace dxvk {
           IDXGIVkSurfaceFactory*  pSurfaceFactory,
     const DXGI_SWAP_CHAIN_DESC1*  pDesc)
   : m_dxgiDevice(pContainer),
+    m_composition(this),
     m_parent(pDevice),
     m_surfaceFactory(pSurfaceFactory),
     m_desc(*pDesc),
@@ -102,6 +114,12 @@ namespace dxvk {
       return S_OK;
     }
 
+    if (riid == __uuidof(IDXGIVkCompositionSwapChain)) {
+      *ppvObject = &m_composition;
+      AddRef();
+      return S_OK;
+    }
+
     if (logQueryInterfaceError(__uuidof(IDXGIVkSwapChain), riid)) {
       Logger::warn("D3D11SwapChain::QueryInterface: Unknown interface query");
       Logger::warn(str::format(riid));
@@ -298,6 +316,37 @@ namespace dxvk {
   }
 
 
+  D3D11CompositionSwapChain::D3D11CompositionSwapChain(
+          D3D11SwapChain*        parent)
+  : m_parent(parent) {
+
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D11CompositionSwapChain::QueryInterface(
+          REFIID                riid,
+          void**                ppvObject) {
+    return m_parent->QueryInterface(riid, ppvObject);
+  }
+
+
+  ULONG STDMETHODCALLTYPE D3D11CompositionSwapChain::AddRef() {
+    return m_parent->AddRef();
+  }
+
+
+  ULONG STDMETHODCALLTYPE D3D11CompositionSwapChain::Release() {
+    return m_parent->Release();
+  }
+
+
+  void STDMETHODCALLTYPE D3D11CompositionSwapChain::SetCompositionTarget(
+          HWND                  hTarget,
+          HWND                  hDispatch) {
+    m_parent->SetCompositionTarget(hTarget, hDispatch);
+  }
+
+
   UINT STDMETHODCALLTYPE D3D11SwapChain::CheckColorSpaceSupport(
           DXGI_COLOR_SPACE_TYPE     ColorSpace) {
     UINT supportFlags = 0;
@@ -357,6 +406,27 @@ namespace dxvk {
   }
 
 
+  void D3D11SwapChain::SetCompositionTarget(
+          HWND                      hTarget,
+          HWND                      hDispatch) {
+    HWND previousTarget = nullptr;
+
+    {
+      std::lock_guard<dxvk::mutex> lock(m_compositionLock);
+      previousTarget = m_compositionTarget;
+      m_compositionTarget = hTarget;
+      m_compositionChildTarget = hTarget && hTarget != hDispatch;
+    }
+
+    if (hTarget != previousTarget) {
+      m_presenter->destroyResources();
+      m_surfaceFactory->SetWindow(hTarget);
+    }
+
+    Logger::debug("D3D11SwapChain::SetCompositionTarget: bound composition target");
+  }
+
+
   Rc<DxvkImageView> D3D11SwapChain::GetBackBufferView() {
     Rc<DxvkImage> image = GetCommonTexture(m_backBuffers[0].ptr())->GetImage();
 
@@ -505,6 +574,7 @@ namespace dxvk {
   void D3D11SwapChain::CreatePresenter() {
     PresenterDesc presenterDesc = { };
     presenterDesc.deferSurfaceCreation = m_parent->GetOptions()->deferSurfaceCreation;
+    presenterDesc.compositeAlpha = ConvertCompositeAlpha(m_desc.AlphaMode);
 
     m_presenter = new Presenter(m_device, m_frameLatencySignal, presenterDesc, [
       cAdapter  = m_device->adapter(),
