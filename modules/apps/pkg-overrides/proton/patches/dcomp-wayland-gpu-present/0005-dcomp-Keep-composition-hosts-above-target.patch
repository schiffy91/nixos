From bea1efc5d006da58d3c3cb336991c46ea75c6214 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Thu, 21 May 2026 05:08:44 -0700
Subject: [PATCH] dcomp: Keep composition hosts above target backing

The host HWND exists to give a DirectComposition swap chain a Wayland/DXVK
presentation target. It must stay above the target window's ordinary backing
surface, otherwise transient Chromium popup widgets can expose their native
background instead of their accelerated content.

Reassert the host window's z-order on each commit. Keep the cached geometry so
unchanged commits use SWP_NOMOVE/SWP_NOSIZE, avoiding redundant resize work
while still asking user32 and the Wayland driver to keep the presentation
surface on top of the target backing.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index 667b6f3..7419026 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -809,12 +809,16 @@ static void dcomp_bind_visual(struct dcomp_target *t, struct dcomp_visual *v,
                 v->host_width = v->host_height = 0;
             }
 
-            if (v->host_hwnd &&
-                (v->host_x != x || v->host_y != y ||
-                 v->host_width != width || v->host_height != height))
+            if (v->host_hwnd)
             {
+                UINT swp_flags = SWP_NOACTIVATE | SWP_NOOWNERZORDER | SWP_SHOWWINDOW;
+
+                if (v->host_x == x && v->host_y == y) swp_flags |= SWP_NOMOVE;
+                if (v->host_width == width && v->host_height == height) swp_flags |= SWP_NOSIZE;
+
                 SetWindowPos(v->host_hwnd, HWND_TOP, x, y, width, height,
-                             SWP_NOACTIVATE | SWP_NOOWNERZORDER | SWP_SHOWWINDOW);
+                             swp_flags);
+
                 v->host_x = x;
                 v->host_y = y;
                 v->host_width = width;
