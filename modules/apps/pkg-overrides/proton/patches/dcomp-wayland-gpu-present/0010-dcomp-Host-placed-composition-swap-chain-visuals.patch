From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
Date: Thu, 21 May 2026 18:15:00 -0700
Subject: [PATCH] dcomp: Host placed composition swap-chain visuals.

DirectComposition visual placement and stacking are independent from the
swap-chain alpha mode. Opaque child visuals still need their own
presentation target so their offset, clip, and z-order are preserved.

Keep the root identity swap chain on the target HWND. That avoids replacing
the main window with a child presentation surface, while still giving CEF
dialog, popup, and form-control layers their own positioned host windows.

Signed-off-by: Alexander Schiffhauer <alexander.schiffhauer@gmail.com>
---
 dlls/dcomp/device.c | 23 +++++++++++++++++++++--
 1 file changed, 21 insertions(+), 2 deletions(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index f59d390..f7e1f83 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -827,6 +827,25 @@ static struct dcomp_surface *dcomp_visual_surface(struct dcomp_visual *v)
     return surface;
 }
 
+static BOOL dcomp_visual_needs_host(const struct dcomp_visual *v, BOOL has_surface)
+{
+    BOOL placed;
+
+    if (has_surface) return TRUE;
+    if (!v->has_swapchain_desc) return FALSE;
+
+    if (v->has_clip) return TRUE;
+    placed = round_float(v->offset_x + v->transform.dx) ||
+             round_float(v->offset_y + v->transform.dy) ||
+             v->transform.m12 != 0.0f || v->transform.m21 != 0.0f ||
+             v->transform.m11 != 1.0f || v->transform.m22 != 1.0f;
+    if (placed) return TRUE;
+
+    if (v->parent && v->parent->parent) return TRUE;
+
+    return FALSE;
+}
+
 static void dcomp_surface_reset_swapchain(struct dcomp_surface *s)
 {
     if (s->swapchain)
@@ -1003,8 +1023,7 @@ static void dcomp_bind_visual(struct dcomp_target *t, struct dcomp_visual *v,
     target_hwnd = t->hwnd;
     surface = dcomp_visual_surface(v);
     dcomp_refresh_swapchain_desc(v);
-    if (v->content && (surface || (v->has_swapchain_desc &&
-        v->swapchain_desc.AlphaMode != DXGI_ALPHA_MODE_IGNORE)))
+    if (v->content && dcomp_visual_needs_host(v, !!surface))
     {
         RECT host_clip;
         int x = placement.x;
-- 
