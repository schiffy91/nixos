#!/usr/bin/env bash
set -euo pipefail

proton_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ "${SCWHINE_IN_DEV_SHELL:-}" = 1 ]; then
  exec make -C "$proton_dir" "$@"
fi

export SCWHINE_QUIET_SHELL=1
exec nix-shell "$proton_dir/dev-shell.nix" --run \
  "make -C '$proton_dir' $(printf '%q ' "$@")"
