import std.*;
import ../core/log.btrc;
import ../system/config.btrc;

class ResetSubvolume {
    public string name;
    public string mountPoint;

    public ResetSubvolume(string name, string mountPoint) {
        self.name = name;
        self.mountPoint = mountPoint;
    }
}

class SnapshotManager {
    public NixosConfig config;
    public UnixShell shell;
    public string rootPrefix;

    public SnapshotManager(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
        self.rootPrefix = "";
    }

    public string hostPath(string path) {
        if (self.rootPrefix.isEmpty()) { return path; }
        if (path.equals("/")) { return self.rootPrefix; }
        if (path.startsWith("/")) { return self.rootPrefix + path; }
        return PathTools.join(self.rootPrefix, path);
    }

    public string snapshotsPath() {
        return self.config.evalRaw("config.settings.disk.subvolumes.snapshots.mountPoint");
    }

    public string cleanName() {
        return self.config.evalRaw("config.settings.disk.immutability.persist.snapshots.cleanName");
    }

    public Vector<ResetSubvolume> resetSubvolumes() {
        Vector<ResetSubvolume> result = [];
        string raw = self.config.evalRaw("config.settings.disk.subvolumes.nameMountPointPairs.resetOnBoot");
        Vector<string> pairs = Strings.split(raw, " ");
        for pair in pairs {
            if (pair.isEmpty()) { continue; }
            Vector<string> parts = Strings.split(pair, "=");
            if (parts.len >= 2) {
                result.push(ResetSubvolume(parts.get(0), parts.get(1)));
            }
        }
        return result;
    }

    public string cleanSnapshotPath(string subvolumeName) {
        return PathTools.join(PathTools.join(self.snapshotsPath(), subvolumeName), self.cleanName());
    }

    public bool isSubvolume(string path) {
        if (!FileSystem.exists(path)) { return false; }
        Command cmd = Command("btrfs")
            .arg("subvolume")
            .arg("show")
            .arg(path)
            .check(false);
        return self.shell.runCommand(cmd).ok();
    }

    public bool isReadonly(string path) {
        Command cmd = Command("btrfs")
            .arg("property")
            .arg("get")
            .arg("-ts")
            .arg(path)
            .arg("ro")
            .check(false);
        ExecResult result = self.shell.runCommand(cmd);
        return result.ok() && result.stdout().contains("ro=true");
    }

    public Vector<string> childSubvolumes(string path) {
        Vector<string> result = [];
        Command cmd = Command("btrfs")
            .arg("subvolume")
            .arg("list")
            .arg("-o")
            .arg(path)
            .check(false);
        ExecResult listed = self.shell.runCommand(cmd);
        if (!listed.ok()) {
            NixosLog.fatal("Failed to list child subvolumes under " + path);
        }
        string snapshotsName = self.config.evalRaw("config.settings.disk.subvolumes.snapshots.name");
        string snapshotsMount = self.snapshotsPath();
        for line in Strings.split(listed.stdout(), "\n") {
            int marker = Strings.find(line, " path ", 0);
            if (marker < 0) { continue; }
            string child = line.substring(marker + 6, line.len() - (marker + 6)).trim();
            if (child.equals(snapshotsName)) {
                result.push(self.hostPath(snapshotsMount));
            } else if (child.startsWith(snapshotsName + "/")) {
                result.push(self.hostPath(PathTools.join(snapshotsMount, child.substring(snapshotsName.len() + 1, child.len() - snapshotsName.len() - 1))));
            } else {
                result.push(self.hostPath("/" + child));
            }
        }
        return result;
    }

    public void deleteSubvolume(string path) {
        if (!FileSystem.exists(path)) { return; }
        if (!self.isSubvolume(path)) {
            NixosLog.fatal("Refusing to delete non-subvolume: " + path);
        }
        for child in self.childSubvolumes(path) {
            self.deleteSubvolume(child);
        }
        Command cmd = Command("btrfs")
            .arg("subvolume")
            .arg("delete")
            .arg("-C")
            .arg(path)
            .capture(false);
        self.shell.runCommand(cmd);
    }

    public void createReadonlySnapshot(string source, string destination) {
        self.deleteSubvolume(destination);
        FileSystem.mkdirp(PathTools.dirname(destination));
        Command cmd = Command("btrfs")
            .arg("subvolume")
            .arg("snapshot")
            .arg("-r")
            .arg(source)
            .arg(destination)
            .capture(false);
        ExecResult result = self.shell.runCommand(cmd);
        if (!result.ok()) {
            NixosLog.fatal("Failed to create readonly snapshot " + destination);
        }
    }

    public void createCleanSnapshot(ResetSubvolume volume) {
        string clean = self.hostPath(self.cleanSnapshotPath(volume.name));
        string source = self.hostPath(volume.mountPoint);
        string temporary = clean + ".tmp." + Strings.fromInt(Platform.pid());
        self.deleteSubvolume(temporary);
        self.createReadonlySnapshot(source, temporary);
        if (!self.isSubvolume(temporary)) {
            NixosLog.fatal("CLEAN temporary is not a subvolume: " + temporary);
        }
        if (!self.isReadonly(temporary)) {
            NixosLog.fatal("CLEAN temporary is not readonly: " + temporary);
        }
        string parent = PathTools.dirname(clean);
        self.deleteSubvolume(PathTools.join(parent, "READY"));
        self.deleteSubvolume(PathTools.join(parent, "NEXT"));
        if (FileSystem.exists(clean)) {
            if (!self.isSubvolume(clean)) {
                NixosLog.fatal("Refusing to replace non-subvolume CLEAN: " + clean);
            }
            self.shell.runRaw("mv -T --exchange --no-copy " + UnixShell.quote(temporary) + " " + UnixShell.quote(clean), false, true, "");
            self.deleteSubvolume(temporary);
        } else {
            self.shell.runRaw("mv --no-copy " + UnixShell.quote(temporary) + " " + UnixShell.quote(clean), false, true, "");
        }
        if (!self.isSubvolume(clean)) {
            NixosLog.fatal("CLEAN is not a subvolume: " + clean);
        }
        if (!self.isReadonly(clean)) {
            NixosLog.fatal("CLEAN is not readonly: " + clean);
        }
    }

    public void createInitialSnapshots() {
        Vector<ResetSubvolume> volumes = self.resetSubvolumes();
        for volume in volumes {
            self.createCleanSnapshot(volume);
        }
    }
}
