import std.console;
import std.fs;
import std.json;
import std.pattern;
import std.process;
import std.strings;
import std.vector;
import ../core/log.btrc;
import ./snapshot.btrc;
import ../system/config.btrc;

class DiffOptions {
    public bool recent;
    public bool showSymlinks;
    public bool showPersistPaths;
    public string showChildren;
    public int depth;
    public string pattern;
    public string diffignore;

    public DiffOptions() {
        self.recent = false;
        self.showSymlinks = false;
        self.showPersistPaths = false;
        self.showChildren = "";
        self.depth = 0;
        self.pattern = "";
        self.diffignore = "";
    }
}

class DiffScanner {
    public NixosConfig config;
    public SnapshotManager snapshots;
    public UnixShell shell;

    public DiffScanner(NixosConfig config) {
        self.config = config;
        self.snapshots = SnapshotManager(config);
        self.shell = UnixShell();
    }

    public Vector<string> keepPaths() {
        return self.config.evalStringList("config.settings.disk.immutability.persist.paths");
    }

    public Vector<string> ignorePatterns(string path) {
        Vector<string> patterns = [];
        if (!FileSystem.exists(path)) { return patterns; }
        for line in Strings.split(Path.readAll(path), "\n") {
            var trimmed = line.trim();
            if (!trimmed.isEmpty() && !trimmed.startsWith("#")) {
                patterns.push(trimmed);
            }
        }
        return patterns;
    }

    public Vector<string> mountPoints() {
        Vector<string> result = [];
        var volumes = self.snapshots.resetSubvolumes();
        for volume in volumes {
            result.push(volume.mountPoint);
        }
        return result;
    }

    public string transactionMarker(string output) {
        for line in Strings.split(output, "\n") {
            var parts = Strings.split(line.trim(), " ");
            if (parts.len >= 4 && parts.get(0).equals("transid") && parts.get(1).equals("marker") && parts.get(2).equals("was")) {
                var marker = parts.get(3).trim();
                if (Strings.isDigitStr(marker)) { return marker; }
            }
        }
        return "";
    }

    public Vector<string> changedPaths(string output) {
        Vector<string> result = [];
        for line in Strings.split(output, "\n") {
            var marker = Strings.find(line, " path ", 0);
            if (marker < 0) { continue; }
            var path = line.substring(marker + 6, line.len() - (marker + 6)).trim();
            if (!path.isEmpty()) { result.push(path); }
        }
        result = result.distinct();
        result.sort();
        return result;
    }

    public Vector<string> changedFiles() {
        Vector<string> result = [];
        var volumes = self.snapshots.resetSubvolumes();
        for volume in volumes {
            var temporarySnapshot = PathTools.join(PathTools.join(self.snapshots.snapshotsPath(), volume.name), "temporary");
            var clean = self.snapshots.cleanSnapshotPath(volume.name);
            self.snapshots.deleteSubvolume(temporarySnapshot);
            self.snapshots.createReadonlySnapshot(volume.mountPoint, temporarySnapshot);

            var quotedClean = UnixShell.quote(clean);
            var tx = self.shell.run(f"btrfs subvolume find-new {quotedClean} 9999999", logFailure=false);
            if (!tx.ok()) {
                self.snapshots.deleteSubvolume(temporarySnapshot);
                NixosLog.fatal(f"Failed to read CLEAN transaction marker: {clean}");
            }
            var transaction = self.transactionMarker(tx.stdout());
            if (transaction.isEmpty()) {
                self.snapshots.deleteSubvolume(temporarySnapshot);
                NixosLog.fatal(f"Failed to parse CLEAN transaction marker: {clean}");
            }
            var quotedTemporary = UnixShell.quote(temporarySnapshot);
            var quotedTransaction = UnixShell.quote(transaction);
            var changes = self.shell.run(f"btrfs subvolume find-new {quotedTemporary} {quotedTransaction}", logFailure=false);
            if (!changes.ok()) {
                self.snapshots.deleteSubvolume(temporarySnapshot);
                NixosLog.fatal(f"Failed to compare CLEAN snapshot: {clean}");
            }
            for path in self.changedPaths(changes.stdout()) {
                var full = f"{volume.mountPoint}/{path}";
                result.push(Strings.replace(full, "//", "/"));
            }

            self.snapshots.deleteSubvolume(temporarySnapshot);
        }
        return result;
    }

    public bool isPersisted(string path, Vector<string> keepPaths) {
        for keepPath in keepPaths {
            var keepPrefix = f"{keepPath}/";
            if (path.equals(keepPath) || path.startsWith(keepPrefix)) {
                return true;
            }
        }
        return false;
    }

    public bool matchesPattern(string path, string pattern) {
        if (pattern.isEmpty()) { return true; }
        return Pattern.matches(pattern.toLower(), path.toLower());
    }

    public bool ignored(string path, Vector<string> patterns) {
        for pattern in patterns {
            if (Pattern.matches(pattern, path)) { return true; }
        }
        return false;
    }

    public string topAncestor(string path, Vector<string> keepList, Vector<string> mounts) {
        var segments = Strings.split(path, "/");
        var ancestor = "";
        for (int i = 1; i < segments.len; i++) {
            if (segments.get(i).isEmpty()) { continue; }
            ancestor = f"{ancestor}/{segments.get(i)}";
            if (mounts.contains(ancestor)) { continue; }
            var coversKeep = false;
            for keepPath in keepList {
                var ancestorPrefix = f"{ancestor}/";
                if (keepPath.startsWith(ancestorPrefix)) { coversKeep = true; }
            }
            if (coversKeep) { continue; }
            return ancestor;
        }
        return path;
    }

    public Vector<string> collapse(Vector<string> paths, Vector<string> keepList, Vector<string> mounts) {
        Vector<string> result = [];
        for path in paths {
            result.push(self.topAncestor(path, keepList, mounts));
        }
        var distinct = result.distinct();
        distinct.sort();
        return distinct;
    }

    public Vector<string> collapseToPersist(Vector<string> persisted, Vector<string> keepList) {
        Vector<string> result = [];
        for path in persisted {
            for keepPath in keepList {
                var keepPrefix = f"{keepPath}/";
                if (path.equals(keepPath) || path.startsWith(keepPrefix)) {
                    result.push(keepPath);
                    break;
                }
            }
        }
        var distinct = result.distinct();
        distinct.sort();
        return distinct;
    }

    public Vector<string> atDepth(Vector<string> bases, Vector<string> source, int depth) {
        if (depth == 0) { return bases; }
        Vector<string> result = [];
        for base in bases {
            var prefix = f"{base}/";
            for path in source {
                if (!path.startsWith(prefix)) { continue; }
                if (depth < 0) {
                    result.push(path);
                } else {
                    var parts = Strings.split(path, "/");
                    var wanted = Strings.count(base, "/") + depth + 1;
                    var collapsed = "";
                    for (int i = 1; i < parts.len && i <= wanted; i++) {
                        if (!parts.get(i).isEmpty()) {
                            collapsed = f"{collapsed}/{parts.get(i)}";
                        }
                    }
                    if (!collapsed.isEmpty()) { result.push(collapsed); }
                }
            }
        }
        var distinct = result.distinct();
        distinct.sort();
        return distinct;
    }

    public Vector<string> filterPattern(Vector<string> input, string pattern) {
        if (pattern.isEmpty()) { return input; }
        Vector<string> output = [];
        for path in input {
            if (self.matchesPattern(path, pattern)) { output.push(path); }
        }
        return output;
    }

    public Vector<string> previousCache(string cachePath) {
        Vector<string> result = [];
        if (!FileSystem.exists(cachePath)) { return result; }
        var data = JsonObject.readFile(cachePath);
        for key in data.values.keys() {
            result.push(key);
        }
        return result;
    }

    public void writeCache(string cachePath, Vector<string> paths) {
        var data = JsonObject();
        for path in paths {
            data.setBool(path, true);
        }
        FileSystem.mkdirp(PathTools.dirname(cachePath));
        data.writeFile(cachePath);
    }

    public void print(DiffOptions options) {
        var keepList = self.keepPaths();
        var mounts = self.mountPoints();
        var ignorePath = options.diffignore.isEmpty() ? PathTools.join(self.config.paths.root, "btrc/btrfs/.diffignore") : options.diffignore;
        var ignores = self.ignorePatterns(ignorePath);
        Vector<string> ephemeral = [];
        Vector<string> persistedPaths = [];
        var changed = self.changedFiles();
        for path in changed {
            if (self.isPersisted(path, keepList)) {
                persistedPaths.push(path);
                continue;
            }
            if (!self.ignored(path, ignores)) { ephemeral.push(path); }
        }

        Vector<string> output = [];
        if (options.showPersistPaths) {
            var bases = self.collapseToPersist(persistedPaths, keepList);
            output = self.atDepth(bases, persistedPaths, options.depth);
        } else {
            output = self.selectEphemeral(ephemeral, keepList, mounts, options);
        }
        output = self.filterPattern(output, options.pattern);
        if (output.len == 0) { return; }
        if (options.showPersistPaths) {
            NixosLog.error("\nPERSISTED CHANGES:");
        } else {
            NixosLog.error("\nCHANGES TO DELETE:");
        }
        for path in output {
            Console.error(path);
        }
    }

    public Vector<string> selectEphemeral(Vector<string> ephemeral, Vector<string> keepList, Vector<string> mounts, DiffOptions options) {
        var top = self.collapse(ephemeral, keepList, mounts);
        var cachePath = "/tmp/nixosctl/diff/cache.json";
        var previous = self.previousCache(cachePath);
        self.writeCache(cachePath, top);
        if (options.recent) {
            Vector<string> recent = [];
            for path in top {
                if (!previous.contains(path)) { recent.push(path); }
            }
            top = recent;
        }
        if (!options.showSymlinks) {
            Vector<string> filtered = [];
            for path in top {
                if (!FileSystem.isSymlink(path)) { filtered.push(path); }
            }
            top = filtered;
        }
        if (!options.showChildren.isEmpty()) {
            var covers = false;
            for path in top {
                var pathPrefix = f"{path}/";
                var childrenPrefix = f"{options.showChildren}/";
                if (path.equals(options.showChildren) || options.showChildren.startsWith(pathPrefix) || path.startsWith(childrenPrefix)) {
                    covers = true;
                }
            }
            Vector<string> bases = [];
            if (covers) { bases.push(options.showChildren); }
            return self.atDepth(bases, ephemeral, options.depth);
        }
        return self.atDepth(top, ephemeral, options.depth);
    }
}
