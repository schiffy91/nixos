class DisplayLayoutRule {
    public string display;
    public string position;
    public string relativeTo;

    public DisplayLayoutRule() {
        self.display = "";
        self.position = "";
        self.relativeTo = "";
    }
}

class AudioPreset {
    public string label;
    public string card;
    public string profile;
    public string sink;
    public string volume;

    public AudioPreset() {
        self.label = "";
        self.card = "";
        self.profile = "";
        self.sink = "";
        self.volume = "";
    }
}

class LabelsConfig {
    public string path;
    public string content;

    public LabelsConfig() {
        self.path = Environment.get("NIXOS_CONFIG", "");
        self.content = self.path.isEmpty() ? "" : Path.readAll(self.path);
    }

    public string displayLabel(string name) {
        bool inDisplays = false;
        for line in Strings.split(self.content, "\n") {
            string trimmed = line.trim();
            string section = Toml.sectionName(trimmed);
            if (section.equals("displays")) {
                inDisplays = true;
                continue;
            }
            if (!section.isEmpty() || !Toml.tableArrayName(trimmed).isEmpty()) {
                inDisplays = false;
            }
            if (inDisplays && Toml.key(trimmed).equals(name)) {
                return Toml.value(trimmed);
            }
        }
        return name;
    }

    public Vector<DisplayLayoutRule> layoutRules() {
        Vector<DisplayLayoutRule> result = [];
        DisplayLayoutRule current = DisplayLayoutRule();
        bool inLayout = false;
        for line in Strings.split(self.content, "\n") {
            string trimmed = line.trim();
            string table = Toml.tableArrayName(trimmed);
            if (table.equals("layout")) {
                if (inLayout && !current.display.isEmpty()) { result.push(current); }
                current = DisplayLayoutRule();
                inLayout = true;
                continue;
            }
            if ((!Toml.sectionName(trimmed).isEmpty() || !table.isEmpty()) && !table.equals("layout")) {
                if (inLayout && !current.display.isEmpty()) { result.push(current); }
                inLayout = false;
            }
            if (!inLayout || Strings.find(trimmed, "=", 0) < 0) { continue; }
            string key = Toml.key(trimmed);
            string value = Toml.value(trimmed);
            if (key.equals("display")) { current.display = value; }
            if (key.equals("position")) { current.position = value; }
            if (key.equals("relative_to")) { current.relativeTo = value; }
        }
        if (inLayout && !current.display.isEmpty()) { result.push(current); }
        return result;
    }

    public Vector<AudioPreset> audioPresets() {
        Vector<AudioPreset> result = [];
        AudioPreset current = AudioPreset();
        bool inAudio = false;
        for line in Strings.split(self.content, "\n") {
            string trimmed = line.trim();
            string table = Toml.tableArrayName(trimmed);
            if (table.equals("audio")) {
                if (inAudio && (!current.sink.isEmpty() || !current.label.isEmpty())) { result.push(current); }
                current = AudioPreset();
                inAudio = true;
                continue;
            }
            if ((!Toml.sectionName(trimmed).isEmpty() || !table.isEmpty()) && !table.equals("audio")) {
                if (inAudio && (!current.sink.isEmpty() || !current.label.isEmpty())) { result.push(current); }
                inAudio = false;
            }
            if (!inAudio || Strings.find(trimmed, "=", 0) < 0) { continue; }
            string key = Toml.key(trimmed);
            string value = Toml.value(trimmed);
            if (key.equals("label")) { current.label = value; }
            if (key.equals("card")) { current.card = value; }
            if (key.equals("profile")) { current.profile = value; }
            if (key.equals("sink")) { current.sink = value; }
            if (key.equals("volume")) { current.volume = value; }
        }
        if (inAudio && (!current.sink.isEmpty() || !current.label.isEmpty())) { result.push(current); }
        return result;
    }
}
