class SecureBootManager {
    public NixosConfig config;
    public UnixShell shell;

    public SecureBootManager(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
    }

    public void removeOldEntries() {
        FileSystem.mkdirp("/boot/EFI/Linux");
        FileSystem.mkdirp("/var/lib/sbctl");
        self.shell.runRaw("find /boot/EFI/Linux -type f -name 'linux-*.efi' -delete", false, false, "");
        FileSystem.removeRecursive("/etc/secureboot");
    }

    public bool keysEnrolled() {
        ExecResult result = self.shell.runUnchecked("sbctl status 2>&1");
        return result.stdout().toLower().contains("secure boot:") && result.stdout().toLower().contains("enabled");
    }

    public bool keysSigned() {
        ExecResult result = self.shell.runUnchecked("sbctl verify 2>&1");
        return result.stdout().toLower().contains("is signed");
    }

    public void createKeys() {
        Command create = Command("sbctl");
        create.arg("create-keys");
        create.capture(false);
        create.check(false);
        self.shell.runCommand(create);
    }

    public void enrollKeys(bool microsoft) {
        Command enroll = Command("sbctl");
        enroll.arg("enroll-keys");
        if (microsoft) {
            enroll.arg("--microsoft");
        } else {
            enroll.arg("--yes-this-might-brick-my-machine");
        }
        enroll.capture(false);
        self.shell.runCommand(enroll);
    }

    public string compactJson(string text) {
        string compact = Strings.replace(text, " ", "");
        compact = Strings.replace(compact, "\n", "");
        compact = Strings.replace(compact, "\t", "");
        compact = Strings.replace(compact, "\r", "");
        return compact;
    }

    public Vector<string> unsignedFromJson(string json) {
        Vector<string> result = [];
        int len = json.len();
        int i = 0;
        while (i < len) {
            while (i < len && json[i] != (char)34) { i++; }
            if (i >= len) { break; }
            int keyStart = i + 1;
            i = keyStart;
            while (i < len && json[i] != (char)34) { i++; }
            if (i >= len) { break; }
            string key = JsonObject.slice(json, keyStart, i);
            i++;
            while (i < len && json[i] != '{') { i++; }
            if (i >= len) { break; }
            int bodyStart = i;
            int depth = 0;
            bool inString = false;
            bool escaped = false;
            for (; i < len; i++) {
                char c = json[i];
                if (inString) {
                    if (!escaped && c == (char)34) { inString = false; }
                    escaped = !escaped && c == '\\';
                    if (c != '\\') { escaped = false; }
                    continue;
                }
                if (c == (char)34) {
                    inString = true;
                    escaped = false;
                    continue;
                }
                if (c == '{') { depth++; }
                if (c == '}') {
                    depth--;
                    if (depth == 0) {
                        string body = JsonObject.slice(json, bodyStart, i + 1);
                        if (self.compactJson(body).contains("\"is_signed\":false")) {
                            result.push(key);
                        }
                        i++;
                        break;
                    }
                }
            }
        }
        return result;
    }

    public void verify() {
        Command verify = Command("sbctl")
            .arg("verify")
            .arg("--json")
            .check(false);
        ExecResult result = self.shell.runCommand(verify);
        string output = result.stdout().trim();
        if (output.isEmpty() || output.equals("null")) {
            NixosLog.error("No EFI binaries registered");
            return;
        }
        Vector<string> unsignedPaths = self.unsignedFromJson(output);
        if (unsignedPaths.isEmpty()) {
            NixosLog.info("All EFI binaries are signed");
            return;
        }
        for path in unsignedPaths {
            NixosLog.error("NOT signed: " + path);
        }
    }

    public void enable(bool microsoft) {
        self.removeOldEntries();
        self.createKeys();
        self.enrollKeys(microsoft);
        self.config.local.setString("target", self.config.secureBootTarget());
        RebuildOptions options = RebuildOptions();
        options.rebuildFileSystem = true;
        options.clean = true;
        NixosRebuilder(self.config).update(options);
        self.verify();
    }

    public void disable() {
        self.removeOldEntries();
        self.config.local.setString("target", self.config.standardTarget());
        RebuildOptions options = RebuildOptions();
        options.rebuildFileSystem = true;
        options.clean = true;
        NixosRebuilder(self.config).update(options);
    }

    public void status() {
        Command status = Command("sbctl")
            .arg("status")
            .capture(false)
            .check(false);
        self.shell.runCommand(status);
        self.verify();
    }
}
