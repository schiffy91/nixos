import std.*;
import ./hardware_ui_labels.btrc;

class DisplayOutput {
    public string name;
    public string label;
    public string kind;
    public int priority;
    public int x;
    public int y;
    public int width;
    public int height;
    public bool enabled;
    public bool connected;

    public DisplayOutput() {
        self.name = "";
        self.label = "";
        self.kind = "";
        self.priority = 999;
        self.x = 0;
        self.y = 0;
        self.width = 0;
        self.height = 0;
        self.enabled = false;
        self.connected = false;
    }

    public string toJson() {
        var json = JsonObject();
        json.setString("name", self.name);
        json.setString("label", self.label);
        json.setString("type", self.kind);
        json.setBool("enabled", self.enabled);
        json.setBool("connected", self.connected);
        json.setInt("priority", self.priority);
        var geometry = JsonObject();
        geometry.setInt("x", self.x);
        geometry.setInt("y", self.y);
        geometry.setInt("w", self.width);
        geometry.setInt("h", self.height);
        json.setRaw("geometry", geometry.stringify());
        var encoded = json.stringify();
        return encoded;
    }
}

class DisplayManager {
    public UnixShell shell;
    public LabelsConfig labels;

    public DisplayManager() {
        self.shell = UnixShell();
        self.labels = LabelsConfig();
    }

    public string kscreen() {
        var result = self.shell.run("kscreen-doctor -o | sed -E 's/\\x1b\\[[0-9;]*m//g'", logFailure=false);
        return result.stdout();
    }

    public bool drmConnected(string name) {
        var status = PathTools.join(PathTools.join("/sys/class/drm", f"card*-{name}"), "status");
        var result = self.shell.run(f"cat {status} 2>/dev/null | head -n 1", logFailure=false);
        return result.trimmed().equals("connected");
    }

    public string lineValue(string block, string prefix) {
        for line in Strings.split(block, "\n") {
            var trimmed = line.trim();
            if (trimmed.startsWith(prefix)) {
                return trimmed.substring(prefix.len(), trimmed.len() - prefix.len()).trim();
            }
        }
        return "";
    }

    public DisplayOutput parseBlock(string block) {
        var output = DisplayOutput();
        var lines = Strings.split(block, "\n");
        if (lines.len == 0) { return output; }
        var header = lines.get(0).trim();
        var headerParts = Strings.split(header, " ");
        if (headerParts.len < 2) { return output; }
        output.name = headerParts.get(1);
        output.label = self.labels.displayLabel(output.name);
        output.enabled = block.contains("\tenabled");
        output.connected = block.contains("\tconnected") || self.drmConnected(output.name);
        var priority = self.lineValue(block, "priority ");
        if (!priority.isEmpty()) { output.priority = Strings.toInt(priority); }
        for kind in ["HDMI", "DisplayPort", "VGA", "DVI", "Panel", "TV", "Unknown"] {
            var marker = f"\t{kind}";
            if (block.contains(marker)) { output.kind = kind; }
        }
        self.applyGeometry(output, block);
        return output;
    }

    public void applyGeometry(DisplayOutput output, string block) {
        var geometry = self.lineValue(block, "Geometry: ");
        if (geometry.isEmpty()) { return; }
        var parts = Strings.split(geometry, " ");
        if (parts.len < 2) { return; }
        var xy = Strings.split(parts.get(0), ",");
        var wh = Strings.split(parts.get(1), "x");
        if (xy.len >= 2) {
            output.x = Strings.toInt(xy.get(0));
            output.y = Strings.toInt(xy.get(1));
        }
        if (wh.len >= 2) {
            output.width = Strings.toInt(wh.get(0));
            output.height = Strings.toInt(wh.get(1));
        }
    }

    public Vector<DisplayOutput> outputs() {
        Vector<DisplayOutput> result = [];
        for block in Strings.split(self.kscreen(), "Output: ") {
            var trimmed = block.trim();
            if (trimmed.isEmpty()) { continue; }
            var output = self.parseBlock(trimmed);
            if (!output.name.isEmpty() && (output.connected || output.enabled)) {
                result.push(output);
            }
        }
        return result;
    }

    public DisplayOutput findOutput(string name, Vector<DisplayOutput> outputs) {
        for output in outputs {
            if (output.name.equals(name)) { return output; }
        }
        return DisplayOutput();
    }

    public void run(string arg) {
        var cmd = Command("kscreen-doctor")
            .arg(arg);
        self.shell.run(cmd.render(), stdout=CommandOutput.stream(), logFailure=false);
    }

    public void enable(string name) {
        self.run(f"output.{name}.enable");
        self.applyLayout(name);
    }

    public void disable(string name) {
        self.run(f"output.{name}.disable");
    }

    public void primary(string name) {
        self.run(f"output.{name}.priority.1");
    }

    public void dpms(string state) {
        var cmd = Command("kscreen-doctor")
            .arg("--dpms")
            .arg(state);
        self.shell.run(cmd.render(), stdout=CommandOutput.stream(), logFailure=false);
    }

    public void layout() {
        var rules = self.labels.layoutRules();
        for rule in rules {
            self.applyLayout(rule.display);
        }
    }

    public void applyLayout(string name) {
        var selected = DisplayLayoutRule();
        var rules = self.labels.layoutRules();
        for rule in rules {
            if (rule.display.equals(name)) { selected = rule; }
        }
        if (selected.display.isEmpty()) { return; }
        var all = self.outputs();
        var display = self.findOutput(selected.display, all);
        var anchor = self.findOutput(selected.relativeTo, all);
        if (display.name.isEmpty() || anchor.name.isEmpty() || !display.enabled) { return; }
        var px = anchor.x;
        var py = anchor.y;
        if (selected.position.equals("left-of")) { px = anchor.x - display.width; }
        else if (selected.position.equals("right-of")) { px = anchor.x + anchor.width; }
        else if (selected.position.equals("above")) { py = anchor.y - display.height; }
        else if (selected.position.equals("below")) { py = anchor.y + anchor.height; }
        self.run(f"output.{display.name}.position.{px},{py}");
    }

    public void list() {
        Vector<string> rows = [];
        var all = self.outputs();
        for output in all {
            rows.push(output.toJson());
        }
        var json = rows.join(",");
        Console.log(f"[{json}]");
    }
}
