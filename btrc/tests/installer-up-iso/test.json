{
  "name": "installer-up-iso",
  "state": "installer-up-iso",
  "parentState": "base-iso",
  "stateMaterial": "nixos-installer-up-iso:{{arch}}:{{isoUrl}}:{{diskSize}}",
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "diskSize": "30G",
  "memory": "4G",
  "cpus": 4,
  "sshPort": 2231,
  "operations": [
    { "op": "require-state" },
    { "op": "reset-state" },
    { "op": "up-iso" },
    { "op": "guest", "command": "test -f /etc/NIXOS && printf installer", "expect": "installer" },
    { "op": "record-state" },
    { "op": "stop" }
  ]
}
