import std.*;
import ../core/*;
import ./{config,secrets,permissions,rebuild,password}.btrc;
import ../btrfs/snapshot.btrc;
import ../hardware/tpm2.btrc;

class SecretsManager {
    public NixosConfig config;
    public UnixShell shell;
    public Interactive interactive;

    public SecretsManager(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
        self.interactive = Interactive();
    }

    public bool hasHashedPassword() {
        return FileSystem.exists(self.config.hashedPasswordPath());
    }

    public void writeHashedPassword(string hashed) {
        FileSystem.mkdirp(PathTools.dirname(self.config.hashedPasswordPath()));
        Path.writeAll(self.config.hashedPasswordPath(), hashed);
    }

    public bool needsPassword(string plainTextPasswordPath) {
        if (!self.hasHashedPassword()) { return true; }
        if (!plainTextPasswordPath.isEmpty() && !FileSystem.exists(plainTextPasswordPath)) { return true; }
        return false;
    }

    public string hashPassword(string password) {
        Command cmd = Command("mkpasswd");
        cmd.arg("-m");
        cmd.arg("sha-512");
        cmd.arg(password);
        cmd.redact(password);
        ExecResult result = self.shell.runCommand(cmd);
        if (!result.ok()) {
            NixosLog.fatal("mkpasswd failed");
        }
        return result.trimmed();
    }

    public void createIfMissing(string plainTextPasswordPath) {
        FileSystem.mkdirp(self.config.secretsPath());
        if (!self.needsPassword(plainTextPasswordPath)) { return; }
        string password = self.interactive.askPasswordConfirmed("Set your password");
        if (!plainTextPasswordPath.isEmpty()) {
            FileSystem.mkdirp(PathTools.dirname(plainTextPasswordPath));
            Path.writeAll(plainTextPasswordPath, password);
        }
        self.writeHashedPassword(self.hashPassword(password));
    }

    public void secure() {
        if (!FileSystem.exists(self.config.secretsPath())) { return; }
        string root = UnixShell.quote(self.config.secretsPath());
        self.shell.runRaw("chown -R root:root " + root, false, false, "");
        self.shell.runRaw("find " + root + " -type d -exec chmod 700 {} +", false, false, "");
        self.shell.runRaw("find " + root + " -type f -exec chmod 600 {} +", false, false, "");
    }
}
