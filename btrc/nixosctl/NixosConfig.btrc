import Library.FileSystem;
import Library.JSON;
import Library.Map;
import Library.Process;
import Library.Strings;
import Library.Vector;
import ../core/NixosLog.btrc;
import ../core/NixosPaths.btrc;

class NixEvalCache {
    public Map<string, string> values;

    public NixEvalCache() {
        self.values = {};
    }

    public bool has(string key) {
        return self.values.has(key);
    }

    public string get(string key) {
        return self.values.get(key);
    }

    public void put(string key, string value) {
        self.values.put(key, value);
    }
}

class NixosConfig {
    public NixosPaths paths;
    public LocalConfigFile local;
    public UnixShell shell;
    public NixEvalCache cache;

    public NixosConfig(string root = "/etc/nixos") {
        self.paths = NixosPaths(root);
        self.local = LocalConfigFile(self.paths.configPath());
        self.shell = UnixShell();
        self.cache = NixEvalCache();
    }

    public bool exists() {
        return self.local.exists();
    }

    public string hostPath() {
        return self.local.getString("host_path", "");
    }

    public string target() {
        return self.local.getString("target", "Standard-Boot");
    }

    public void reset(string hostPath, string target) {
        var data = JSONValue.makeObject();
        data.set("host_path", JSONValue.makeString(hostPath));
        data.set("target", JSONValue.makeString(target));
        self.local.overwrite(data);
    }

    class string hostOf(string hostPath) {
        return Strings.replace(PathTools.basename(hostPath), ".nix", "");
    }

    /* hosts live at <arch>/<host>.nix or at <arch>/<host>/<host>.nix */
    class string architectureOf(string hostPath) {
        var parent = PathTools.dirname(hostPath);
        var hostDir = PathTools.basename(parent);
        if (hostDir.equals(NixosConfig.hostOf(hostPath))) {
            return PathTools.basename(PathTools.dirname(parent));
        }
        return hostDir;
    }

    class string outputNameOf(string hostsPath, string hostPath) {
        var name = NixosConfig.hostOf(hostPath);
        var declarations = 0;
        for architecture in FileSystem.listDir(hostsPath) {
            var directory = PathTools.join(hostsPath, architecture);
            if (!FileSystem.isDir(directory)) { continue; }
            if (FileSystem.exists(PathTools.join(directory, f"{name}.nix"))
                || FileSystem.exists(PathTools.join(directory, f"{name}/{name}.nix"))) {
                declarations = declarations + 1;
            }
        }
        if (declarations > 1) { return f"{name}-{NixosConfig.architectureOf(hostPath)}"; }
        return name;
    }

    public string host() {
        return NixosConfig.outputNameOf(self.paths.hostsPath(), self.hostPath());
    }

    public string architecture() {
        return NixosConfig.architectureOf(self.hostPath());
    }

    public string flakeRef() {
        return f"{self.paths.root}#{self.host()}-{self.target()}";
    }

    public string nixCommand() {
        return "nix --extra-experimental-features nix-command --extra-experimental-features flakes";
    }

    public string inputLockedRev(string inputName) {
        var lockPath = PathTools.join(self.paths.root, "flake.lock");
        if (!FileSystem.exists(lockPath)) {
            NixosLog.fatal(f"Missing flake lock: {lockPath}");
        }
        var node = JSONValue.readFile(lockPath).get("nodes").get(inputName).get("locked");
        var rev = node.has("rev") ? node.get("rev").asString() : "";
        if (rev.isEmpty()) {
            NixosLog.fatal(f"flake.lock is missing locked rev for input: {inputName}");
        }
        return rev;
    }

    public Vector<string> linuxInputs() {
        var lock = Path.readAll(PathTools.join(self.paths.root, "flake.lock"));
        var inputs = JSONValue.parse(lock).get("nodes").get("root").get("inputs");
        Vector<string> names = [];
        for name in inputs.keys() {
            if (!name.contains("darwin")) { names.push(name); }
        }
        return names;
    }

    public string evalRaw(string attribute) {
        var key = f"{self.flakeRef()}:{attribute}";
        if (self.cache.has(key)) {
            return self.cache.get(key);
        }
        var flake = ShellWords.quote(f"{self.paths.root}#nixosConfigurations.{self.host()}-{self.target()}.{attribute}");
        var result = self.shell.run(f"{self.nixCommand()} eval {flake}", stderr=COMMAND_OUTPUT_STREAM);
        if (!result.ok()) {
            NixosLog.fatal(f"nix eval failed for {attribute}");
        }
        var value = result.trimmed();
        self.cache.put(key, value);
        return value;
    }

    public string evalString(string attribute) {
        var key = f"{self.flakeRef()}:{attribute}:raw-string";
        if (self.cache.has(key)) {
            return self.cache.get(key);
        }
        var flake = ShellWords.quote(f"{self.paths.root}#nixosConfigurations.{self.host()}-{self.target()}.{attribute}");
        var result = self.shell.run(f"{self.nixCommand()} eval --raw {flake}", stderr=COMMAND_OUTPUT_STREAM);
        if (!result.ok()) {
            NixosLog.fatal(f"nix eval --raw failed for {attribute}");
        }
        var value = result.trimmed();
        self.cache.put(key, value);
        return value;
    }

    public string evalJson(string attribute) {
        var key = f"{self.flakeRef()}:{attribute}:json";
        if (self.cache.has(key)) {
            return self.cache.get(key);
        }
        var flake = ShellWords.quote(f"{self.paths.root}#nixosConfigurations.{self.host()}-{self.target()}.{attribute}");
        var result = self.shell.run(f"{self.nixCommand()} eval --json {flake}", stderr=COMMAND_OUTPUT_STREAM);
        if (!result.ok()) {
            NixosLog.fatal(f"nix eval --json failed for {attribute}");
        }
        var value = result.trimmed();
        self.cache.put(key, value);
        return value;
    }

    public Vector<string> evalStringList(string attribute) {
        Vector<string> values = [];
        var parsed = JSONValue.parse(self.evalJson(attribute));
        if (!parsed.isArray()) { return values; }
        for element in parsed.elements() {
            if (element.isString()) { values.push(Strings.copy(element.asString())); }
        }
        return values;
    }

    public bool evalBool(string attribute) {
        var value = self.evalJson(attribute);
        return value.equals("true");
    }

    public string standardTarget() { return "Standard-Boot"; }
    public string secureBootTarget() { return "Secure-Boot"; }
    public string diskOperationTarget() { return "Disk-Operation"; }

    public string username() {
        return self.evalString("config.settings.users.admin.username");
    }

    public string secretsPath() {
        return self.evalString("config.settings.secrets.path");
    }

    public string hashedPasswordPath() {
        var name = self.evalString("config.settings.secrets.hashedPasswordFile");
        return PathTools.join(self.secretsPath(), name);
    }

    public string diskDevice() {
        return self.evalString("config.settings.disk.device");
    }

    public string rootPartLabelPath() {
        return self.evalString("config.settings.disk.by.partlabel.root");
    }

    public string tpmDevice() {
        return self.evalString("config.settings.tpm.device");
    }

    public string tpmVersionPath() {
        return self.evalString("config.settings.tpm.versionPath");
    }
}
