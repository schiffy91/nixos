import Library.Bytes;
import Library.FileSystem;
import Library.IO;
import Library.Platform;
import Library.Process;
import ../core/Interactive.btrc;
import ../core/NixosLog.btrc;
import ./NixosConfig.btrc;
import ./PasswordHashFile.btrc;
import ./RootSecretFile.btrc;

class SecretsManager {
    public NixosConfig config;
    public UnixShell shell;
    public Interactive interactive;
    private RootSecretFile? installerPassword;
    private bool createdInstallerPassword = false;

    public SecretsManager(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
        self.interactive = Interactive();
    }

    public bool hasHashedPassword() {
        return !PasswordHashFile(self.config.hashedPasswordPath()).read().isEmpty();
    }

    public void writeHashedPassword(string hashed) {
        PasswordHashFile(self.config.hashedPasswordPath()).write(hashed);
    }

    public string hashPassword(string password) {
        var result = self.shell.run("mkpasswd -m sha-512 -s", stdin=f"{password}\n");
        if (!result.ok()) {
            throw "mkpasswd failed";
        }
        return result.trimmed();
    }

    public void createIfMissing(string plainTextPasswordPath) {
        if (plainTextPasswordPath.isEmpty()) {
            PasswordHashFile(self.config.hashedPasswordPath()).initializeFromAccount(self.config.username());
        }
        FileSystem.mkdirp(self.config.secretsPath());
        bool missingPlaintext = false;
        string suppliedPassword = "";
        if (!plainTextPasswordPath.isEmpty()) {
            self.installerPassword = RootSecretFile(plainTextPasswordPath);
            var existing = self.installerPassword.read(4096);
            missingPlaintext = !existing.found();
            if (existing.found() && (existing.bytes().isEmpty() || !existing.bytes().isNulFreeUtf8())) {
                throw "Invalid installer passphrase file";
            }
            if (existing.found()) { suppliedPassword = existing.bytes().toString(); }
        }
        if (!missingPlaintext) {
            if (self.hasHashedPassword()) { return; }
            if (!suppliedPassword.isEmpty()) {
                self.writeHashedPassword(self.hashPassword(suppliedPassword));
                return;
            }
        }
        var password = self.interactive.askPasswordConfirmed("Set your password");
        if (password.isEmpty()) { throw "An empty password is not allowed"; }
        var installerPassword = self.installerPassword;
        if (installerPassword != null) {
            self.createdInstallerPassword = missingPlaintext;
            installerPassword.write(Bytes.fromString(password));
        }
        self.writeHashedPassword(self.hashPassword(password));
    }

    /* Only remove a passphrase created by this invocation. An explicitly
     * supplied, securely permissioned file belongs to its caller. */
    public void releaseInstallerPassword() {
        var installerPassword = self.installerPassword;
        if (installerPassword == null) { return; }
        try {
            if (self.createdInstallerPassword) { installerPassword.remove(); }
        } finally {
            installerPassword.close();
            self.installerPassword = null;
            self.createdInstallerPassword = false;
        }
    }

    public void secure() {
        if (!FileSystem.exists(self.config.secretsPath())) { return; }
        var root = ShellWords.quote(self.config.secretsPath());
        var execArg = "{}";
        if (Platform.isRoot()) {
            self.shell.run(f"chown -R root:root {root}", stdout=COMMAND_OUTPUT_STREAM, stderr=COMMAND_OUTPUT_STREAM, throwOnFailure=true);
        }
        self.shell.run(f"find {root} -type d -exec chmod 700 {execArg} +", stdout=COMMAND_OUTPUT_STREAM, stderr=COMMAND_OUTPUT_STREAM, throwOnFailure=true);
        self.shell.run(f"find {root} -type f -exec chmod 600 {execArg} +", stdout=COMMAND_OUTPUT_STREAM, stderr=COMMAND_OUTPUT_STREAM, throwOnFailure=true);
    }
}
