import std.console;
import std.fs;
import std.process;
import ../config.btrc;

class Tpm2Manager {
    public NixosConfig config;
    public UnixShell shell;

    public Tpm2Manager(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
    }

    public bool exists() {
        if (!FileSystem.exists(self.config.tpmDevice())) { return false; }
        var version = Path.readAll(self.config.tpmVersionPath()).trim();
        return version.equals("2");
    }

    public bool diskEncrypted() {
        var result = self.shell.run(f"cryptsetup isLuks {UnixShell.quote(self.config.rootPartLabelPath())}", logFailure=false);
        return result.ok();
    }

    public bool enroll() {
        var command = f"systemd-cryptenroll {UnixShell.quote(self.config.rootPartLabelPath())}";
        command = f"{command} --wipe-slot=tpm2 --tpm2-device={UnixShell.quote(self.config.tpmDevice())} --tpm2-pcrs=7+12";
        return self.shell.run(
            command,
            stdout=CommandOutput.stream(),
            stderr=CommandOutput.stream(),
            logFailure=false).ok();
    }

    public bool wipe() {
        var command = f"systemd-cryptenroll {UnixShell.quote(self.config.rootPartLabelPath())} --wipe-slot=tpm2";
        return self.shell.run(
            command,
            stdout=CommandOutput.stream(),
            stderr=CommandOutput.stream(),
            logFailure=false).ok();
    }

    public void status() {
        Console.log(f"TPM2 device: {self.config.tpmDevice()}");
        self.shell.run(
            f"systemd-cryptenroll --tpm2-device=list {UnixShell.quote(self.config.rootPartLabelPath())}",
            stdout=CommandOutput.stream(),
            stderr=CommandOutput.stream(),
            logFailure=false);
        self.shell.run(
            f"cryptsetup luksDump {UnixShell.quote(self.config.rootPartLabelPath())}",
            stdout=CommandOutput.stream(),
            stderr=CommandOutput.stream(),
            logFailure=false);
    }
}
