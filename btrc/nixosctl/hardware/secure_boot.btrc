import std.fs;
import std.json;
import std.process;
import std.vector;
import ../../core/interactive.btrc;
import ../../core/log.btrc;
import ../config.btrc;
import ../rebuild.btrc;

class SecureBootManager {
    public NixosConfig config;
    public UnixShell shell;

    public SecureBootManager(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
    }

    public void removeOldEntries() {
        FileSystem.mkdirp("/boot/EFI/Linux");
        FileSystem.mkdirp("/var/lib/sbctl");
        self.shell.run("find /boot/EFI/Linux -type f -name 'linux-*.efi' -delete", stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), throwOnFailure=true);
        FileSystem.removeRecursive("/etc/secureboot");
    }

    public string dbPublicKey() {
        return PathTools.join(self.config.evalString("config.settings.boot.pkiBundle"), "keys/db/db.pem");
    }

    public string dbPrivateKey() {
        return PathTools.join(self.config.evalString("config.settings.boot.pkiBundle"), "keys/db/db.key");
    }

    public bool dbKeysExist() {
        return FileSystem.exists(self.dbPublicKey()) && FileSystem.exists(self.dbPrivateKey());
    }

    public void createKeys() {
        if (self.dbKeysExist()) { return; }
        self.shell.run("sbctl create-keys", stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), throwOnFailure=true);
        if (!self.dbKeysExist()) {
            NixosLog.fatal("sbctl did not create db keys");
        }
    }

    public void enrollKeys(bool microsoft) {
        var command = "sbctl enroll-keys";
        if (microsoft) {
            command = f"{command} --microsoft";
        } else {
            command = f"{command} --yes-this-might-brick-my-machine";
        }
        self.shell.run(command, stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), throwOnFailure=true);
    }

    public Vector<string> unsignedFromJson(string json) {
        Vector<string> result = [];
        var top = JsonObject.parse(json);
        for key, _ in top.values {
            var body = JsonText.objectField(json, key);
            if (body.isEmpty()) { continue; }
            var signature = JsonObject.parse(body);
            if (!signature.getBool("is_signed", true)) {
                result.push(key);
            }
        }
        return result;
    }

    public bool verify() {
        var result = self.shell.run("sbctl verify --json", logFailure=false);
        var output = result.trimmed();
        if (output.isEmpty() || output.equals("null")) {
            NixosLog.error("No EFI binaries registered");
            return false;
        }
        var unsignedPaths = self.unsignedFromJson(output);
        if (unsignedPaths.isEmpty()) {
            NixosLog.info("All EFI binaries are signed");
            return true;
        }
        for path in unsignedPaths {
            NixosLog.error(f"NOT signed: {path}");
        }
        return false;
    }

    public void requireVerified() {
        if (!self.verify()) {
            NixosLog.fatal("Secure Boot verification found unsigned EFI binaries");
        }
    }

    public void enable(bool microsoft) {
        self.removeOldEntries();
        self.createKeys();
        self.config.local.setString("target", self.config.secureBootTarget());
        var options = RebuildOptions();
        options.rebuildFileSystem = true;
        options.clean = true;
        options.promptReboot = false;
        NixosRebuilder(self.config).update(options);
        self.requireVerified();
        self.enrollKeys(microsoft);
        Interactive().askToReboot();
    }

    public void disable() {
        self.removeOldEntries();
        self.config.local.setString("target", self.config.standardTarget());
        var options = RebuildOptions();
        options.rebuildFileSystem = true;
        options.clean = true;
        NixosRebuilder(self.config).update(options);
    }

    public void status() {
        self.shell.run("sbctl status", stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), logFailure=false);
        self.verify();
    }
}
