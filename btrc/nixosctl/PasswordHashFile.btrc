import Library.Bytes;
import Library.FileSystem;
import Library.Platform;
import Library.Strings;

#if defined(__linux__)
#include <shadow.h>
#endif
#include <sys/stat.h>

/* The directory's public path is part of its authority: a root-owned leaf
 * under a user-writable ancestor would still let that user replace it. */
class PasswordHashFile {
    public string path;
    public PrivateDirectory directory;
    public ExclusiveFileLease lease;

    public PasswordHashFile(string path) {
        if (!Platform.isRoot()) { throw "Password hash storage requires root"; }
        if (!path.startsWith("/") || path.endsWith("/")) { throw "Password hash path must be absolute"; }
        var components = Strings.split(path, "/");
        var parent = "/";
        for (int index = 1; index < components.len; index++) {
            var part = components.get(index);
            if (part.isEmpty() || part.equals(".") || part.equals("..")) { throw "Invalid password hash path"; }
            if (index == components.len - 1) { break; }
            PasswordHashFile.requireRootDirectory(parent);
            parent = PathTools.join(parent, part);
            if (index < components.len - 2 && FileStatus(parent).isMissing()) {
                if (FileSystem.mkdir(parent, 0755) != 0 && !FileSystem.isDir(parent)) {
                    throw f"Cannot create password hash ancestor: {parent}";
                }
            }
        }
        PasswordHashFile.requireRootDirectory(PathTools.dirname(parent));
        var opened = PrivateDirectory.openAbsoluteLeaf(parent);
        if (!opened.ok()) { throw f"Unsafe password hash directory: {parent}"; }
        self.directory = opened.value();
        var locked = self.directory.acquireExclusiveLease(".password.lock", wait=true);
        if (!locked.ok()) { throw "Cannot lock password hash storage"; }
        self.lease = locked.value();
        self.path = path;
    }

    class void requireRootDirectory(string path) {
        struct stat info;
        if (lstat(path, &info) != 0 || !S_ISDIR(info.st_mode)
            || info.st_uid != (uid_t)0 || (info.st_mode & (mode_t)0022) != (mode_t)0) {
            throw f"Password hash ancestor must be a root-owned, non-writable directory: {path}";
        }
    }

    class bool valid(string hash) {
        return !hash.isEmpty() && hash.length() < 4096
            && !hash.contains("\n") && !hash.contains("\r") && !hash.contains(":")
            && (hash.startsWith("$") || hash.startsWith("!") || hash.equals("*"));
    }

    public string read() {
        var result = self.lease.readRegularChild(PathTools.basename(self.path), 4096);
        if (!result.ok()) { throw "Cannot safely read password hash storage"; }
        if (!result.found()) { return ""; }
        if (!result.bytes().isNulFreeUtf8()) { throw "Invalid password hash encoding"; }
        var hash = result.bytes().toString().trim();
        if (!PasswordHashFile.valid(hash)) { throw "Invalid stored password hash"; }
        return hash;
    }

    public void write(string hash) {
        if (!PasswordHashFile.valid(hash)) { throw "Invalid password hash"; }
        if (!self.directory.validatePath().ok()) { throw "Password hash directory changed"; }
        var result = self.lease.replaceRegularChildDurably(PathTools.basename(self.path), Bytes.fromString(f"{hash}\n"));
        if (!result.committed()) { throw "Password hash could not be durably stored"; }
    }

    public bool initializeFromAccount(string user) {
        if (!self.read().isEmpty()) { return true; }
#if defined(__linux__)
        struct spwd* account = getspnam(user);
        if (account == NULL || account->sp_pwdp == NULL) { return false; }
        var hash = Strings.copy(account->sp_pwdp);
        if (!PasswordHashFile.valid(hash)) { return false; }
        self.write(hash);
        return true;
#else
        throw "Account password migration requires Linux";
#endif
    }
}
