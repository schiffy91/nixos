import std.fs;
import std.platform;
import std.process;
import std.strings;

class CaffeineManager {
    public UnixShell shell;
    public string pidFile;

    public CaffeineManager() {
        self.shell = UnixShell();
        var runtime = Environment.get("XDG_RUNTIME_DIR", "/tmp");
        self.pidFile = PathTools.join(runtime, "nixos-caffeine.pid");
    }

    public int pid() {
        if (!FileSystem.exists(self.pidFile)) { return 0; }
        var existing = Strings.toInt(Path.readAll(self.pidFile).trim());
        if (existing <= 0) {
            FileSystem.removeRecursive(self.pidFile);
            return 0;
        }
        var alive = self.shell.run(f"kill -0 {existing}", logFailure=false);
        if (!alive.ok()) {
            FileSystem.removeRecursive(self.pidFile);
            return 0;
        }
        return existing;
    }

    public bool enabled() {
        return self.pid() > 0;
    }

    public void enable() {
        if (self.enabled()) { return; }
        var command = f"systemd-inhibit --what=idle --who=nixos --why='User disabled sleep' sleep infinity >/dev/null 2>&1 & echo $! > {UnixShell.quote(self.pidFile)}";
        self.shell.run(command, stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), throwOnFailure=true);
    }

    public void disable() {
        var existing = self.pid();
        if (existing > 0) {
            self.shell.run(f"kill {existing}", logFailure=false);
        }
        FileSystem.removeRecursive(self.pidFile);
    }

    public void toggle() {
        if (self.enabled()) { self.disable(); }
        else { self.enable(); }
    }
}
