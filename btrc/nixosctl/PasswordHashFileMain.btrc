import Library.CLI;
import ../core/NixosLog.btrc;
import ./PasswordHashFile.btrc;

/* Activation passes paths and account names only; credentials never enter argv. */
int main(int argc, char** argv) {
    try {
        var args = CLIArgs(argc, argv);
        if (args.count() != 2) { throw "Usage: nixosctl-password-file <file> <user>"; }
        var file = PasswordHashFile(args.get(0));
        if (!file.initializeFromAccount(args.get(1))) {
            throw "Missing authoritative password hash and no existing account to preserve";
        }
        return 0;
    } catch (string error) {
        NixosLog.error(error);
        return 1;
    }
}
