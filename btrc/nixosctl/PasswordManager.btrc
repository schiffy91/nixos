import Library.CLI;
import Library.Bytes;
import Library.FileSystem;
import Library.Platform;
import Library.Process;
import Library.Strings;
import Library.Terminal;
import ../core/Interactive.btrc;
import ../core/NixosLog.btrc;
import ./NixosConfig.btrc;
import ./SecretsManager.btrc;
import ./PasswordHashFile.btrc;
import ./NixosRebuilder.btrc;
import ./PasswdDriver.btrc;
import ./hardware/Tpm2Manager.btrc;

class PasswordManager {
    public NixosConfig config;
    public UnixShell shell;
    public SecretsManager secrets;
    public Interactive interactive;
    public string suppliedCurrentPassword;  /* NIXOS_OLD_PASSWORD; empty means prompt */

    public PasswordManager(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
        self.secrets = SecretsManager(config);
        self.interactive = Interactive();
        self.suppliedCurrentPassword = "";
    }

    public bool encryptionEnabled() {
        return self.config.evalBool("config.settings.disk.encryption.enable");
    }

    public bool luksAccepts(string password) {
        var device = ShellWords.quote(self.config.rootPartLabelPath());
        var result = self.shell.run(
            f"cryptsetup open --test-passphrase {device}",
            stdin=f"{password}\n",
            stderr=COMMAND_OUTPUT_SUPPRESS,
            logFailure=false);
        return result.ok();
    }

    /* "!", "*", "" and bare text are locked or invalid, never a crypt(3) hash */
    class bool hashUsable(string hash) {
        return hash.startsWith("$");
    }

    public bool hashAccepts(string hash, string password) {
        if (!PasswordManager.hashUsable(hash)) { return false; }
        var result = self.shell.run(
            "perl -e 'chomp(my $candidate = <STDIN>); print crypt($candidate, $ENV{HASH})'",
            stdin=f"{password}\n",
            env=[f"HASH={hash}"],
            logFailure=false);
        return result.ok() && result.trimmed().equals(hash);
    }

    public bool accountAccepts(string password) {
        /* pam_unix's verifier expects a NUL-terminated password on stdin.
           Convert the line without putting the password in argv or environment. */
        var result = self.shell.run(
            "perl -e 'chomp(my $p = <STDIN>); print $p, chr(0)' | unix_chkpwd " + ShellWords.quote(self.config.username()) + " nullok",
            stdin=f"{password}\n",
            stderr=COMMAND_OUTPUT_SUPPRESS,
            logFailure=false);
        return result.ok();
    }

    public bool hashFileAccepts(string password) {
        if (!self.secrets.hasHashedPassword()) { return false; }
        return self.hashAccepts(PasswordHashFile(self.config.hashedPasswordPath()).read(), password);
    }

    public bool accepts(string kind, string password) {
        if (kind.equals("LUKS")) { return self.luksAccepts(password); }
        return self.accountAccepts(password);
    }

    public string currentPassword(string kind, string prompt) {
        if (!self.suppliedCurrentPassword.isEmpty()) {
            if (self.accepts(kind, self.suppliedCurrentPassword)) { return self.suppliedCurrentPassword; }
            NixosLog.fatal(f"NIXOS_OLD_PASSWORD is not the current {kind} password");
        }
        for (int attempt = 0; attempt < 3; attempt++) {
            var candidate = self.interactive.askPassword(prompt);
            if (self.accepts(kind, candidate)) { return candidate; }
            NixosLog.error(f"That is not the current {kind} password.");
        }
        NixosLog.fatal(f"Too many failed {kind} password attempts");
        return "";
    }

    public bool changeLuksPassword(string oldPassword, string newPassword) {
        var command = f"cryptsetup luksChangeKey {ShellWords.quote(self.config.rootPartLabelPath())}";
        var input = f"{oldPassword}\n{newPassword}\n";
        var result = self.shell.run(
            command,
            stdin=input,
            stdout=COMMAND_OUTPUT_STREAM,
            stderr=COMMAND_OUTPUT_STREAM,
            logFailure=false);
        return result.ok();
    }

    public void convergeLuks(string newPassword) {
        if (!self.encryptionEnabled()) {
            NixosLog.info("Disk encryption is disabled; skipping LUKS");
            return;
        }
        if (self.luksAccepts(newPassword)) {
            NixosLog.info("LUKS already unlocks with the new password");
            return;
        }
        var current = self.currentPassword("LUKS", "Enter current LUKS passphrase");
        if (!self.changeLuksPassword(current, newPassword)) {
            NixosLog.fatal("Failed to change LUKS password");
        }
        if (!self.luksAccepts(newPassword)) {
            NixosLog.fatal("LUKS does not unlock with the new password after the change");
        }
        NixosLog.info("LUKS password changed");
    }

    public void fallbackChangeUserPassword(string user, string password) {
        var changed = self.shell.run(
            "chpasswd",
            stdin=f"{user}:{password}\n",
            stdout=COMMAND_OUTPUT_STREAM,
            stderr=COMMAND_OUTPUT_STREAM,
            logFailure=false);
        if (!changed.ok()) {
            NixosLog.error("Fallback account password update failed.");
        }
    }

    public void convergeAccountPassword(string newPassword) {
        var user = self.config.username();
        if (self.accountAccepts(newPassword)) {
            NixosLog.info(f"Account {user} already uses the new password");
            return;
        }
        var current = self.currentPassword("account", f"Enter current password for {user}");
        if (!PasswdDriver.change(user, current, newPassword)) {
            NixosLog.error("PAM password change failed.");
        }
        if (!self.accountAccepts(newPassword)) {
            NixosLog.fatal(f"Account {user} does not accept the new password after the change");
        }
        NixosLog.info(f"Account {user} password changed");
    }

    public void convergeAccountFile(string newPassword) {
        if (self.hashFileAccepts(newPassword)) {
            NixosLog.info("Hashed password file already matches");
            return;
        }
        try {
            self.secrets.writeHashedPassword(self.secrets.hashPassword(newPassword));
        } catch (string error) {
            NixosLog.error("The account uses the new password, but its persistent update failed. A reboot may restore the previous account password; any completed disk password change remains. Rerun change-password with the intended new password to finish.");
            throw error;
        }
        var switched = NixosRebuilder(self.config).switchSystem(RebuildOptions());
        if (!switched.ok()) {
            NixosLog.fatal("The account password and its persistent hash were updated, but nixos-rebuild switch failed. The new password survives reboot. Run nixosctl update to retry activation.");
        }
        NixosLog.info("Hashed password file updated and system switched");
    }

    public void updateTpm2() {
        var tpm = Tpm2Manager(self.config);
        if (!tpm.exists()) {
            NixosLog.fatal("TPM2 does not exist");
        }
        if (!tpm.enroll()) {
            NixosLog.fatal("TPM2 enrollment failed");
        }
    }

    /* sudo (even NOPASSWD) resets the environment by default, so NIXOS_OLD_PASSWORD /
       NIXOS_NEW_PASSWORD would silently vanish across reexecAsRoot's re-exec — fatal
       for a scripted, non-interactive caller that has no TTY to fall back to prompting.
       Hand the secrets across via a 0600 temp file instead: its PATH (not its
       contents) is the only thing that touches argv, so this doesn't reintroduce the
       argv-leak this file's --old/--new rejection exists to prevent. */
    public int reexecAsRoot(CLIArgs args, string newPassword, string oldPassword) {
        var created = FileSystem.createTemporaryDirectory("nixosctl-password");
        if (!created.ok()) { throw "Cannot create private password handoff directory"; }
        var temporary = created.value();
        var opened = PrivateDirectory.openAbsoluteLeaf(temporary.path());
        if (!opened.ok()) { throw "Cannot open private password handoff directory"; }
        var locked = opened.value().acquireExclusiveLease(".lock");
        if (!locked.ok()) { throw "Cannot lock private password handoff directory"; }
        var written = locked.value().replaceRegularChildDurably("secrets", Bytes.fromString(f"{newPassword}\n{oldPassword}\n"));
        if (!written.committed()) { throw "Cannot write private password handoff"; }
        var secretsPath = PathTools.join(temporary.path(), "secrets");
        var command = f"sudo {ShellWords.quote(args.program)}";
        for value in args.values {
            command = f"{command} {ShellWords.quote(value)}";
        }
        command = f"{command} --reexec-secrets {ShellWords.quote(secretsPath)}";
        var result = UnixShell().run(command, stdout=COMMAND_OUTPUT_STREAM, stderr=COMMAND_OUTPUT_STREAM, foreground=true);
        temporary.close();
        return result.code;
    }

    public int change(CLIArgs args, string newPassword, bool changeFde, bool changeUser, bool updateTpm) {
        SecretsManager.requirePassword(newPassword);
        if (!self.suppliedCurrentPassword.isEmpty()) {
            SecretsManager.requirePassword(self.suppliedCurrentPassword);
        }
        /* Everything here needs root: chpasswd refuses to run unprivileged, so there
           is nothing left to do before elevating. */
        if (!Platform.isRoot()) {
            if (changeFde || changeUser) {
                return self.reexecAsRoot(args, newPassword, self.suppliedCurrentPassword);
            }
            return 0;
        }
        if (changeFde && updateTpm && !Tpm2Manager(self.config).enrollmentAllowed()) {
            NixosLog.fatal("Managed TPM enrollment is unavailable; no passwords changed");
        }
        if (changeUser && !PasswordHashFile(self.config.hashedPasswordPath()).initializeFromAccount(self.config.username())) {
            NixosLog.fatal("Cannot establish authoritative password storage before changing credentials");
        }
        if (changeFde) {
            self.convergeLuks(newPassword);
            if (updateTpm) {
                self.updateTpm2();
            }
        }
        if (changeUser) {
            self.convergeAccountPassword(newPassword);
            self.convergeAccountFile(newPassword);
        }
        return 0;
    }
}
