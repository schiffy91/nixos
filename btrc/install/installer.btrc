import std.fs;
import std.process;
import ../btrfs/snapshot.btrc;
import ../core/interactive.btrc;
import ../core/log.btrc;
import ../system/config.btrc;
import ../system/secrets.btrc;
import ../system/permissions.btrc;
import ../system/rebuild.btrc;
import ../hardware/secure_boot.btrc;
import ../hardware/tpm2.btrc;

class Installer {
    public NixosConfig config;
    public UnixShell shell;
    public Interactive interactive;
    public string mountPoint;

    public Installer(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
        self.interactive = Interactive();
        self.mountPoint = "/mnt";
    }

    public ExecResult runDisko(string mode, string extraArgs) {
        var rev = self.config.inputLockedRev("disko");
        var flake = UnixShell.quote(f"{self.config.paths.root}#{self.config.host()}-{self.config.diskOperationTarget()}");
        var quotedMode = UnixShell.quote(mode);
        var quotedMountPoint = UnixShell.quote(self.mountPoint);
        var command = f"nix --extra-experimental-features nix-command --extra-experimental-features flakes run github:nix-community/disko/{rev} --verbose -- --show-trace --flake {flake} --mode {quotedMode} --root-mountpoint {quotedMountPoint} {extraArgs}";
        return self.shell.run(command, stdout=CommandOutput.stream(), stderr=CommandOutput.stream());
    }

    public ExecResult mountDisk() {
        return self.runDisko("mount", "");
    }

    public ExecResult eraseAndMountDisk() {
        return self.runDisko("destroy,format,mount", "--yes-wipe-all-disks");
    }

    public ExecResult prepareDisk(bool format) {
        if (format) {
            return self.eraseAndMountDisk();
        }
        return self.mountDisk();
    }

    public ExecResult installNixos() {
        FileSystem.mkdirp(PathTools.join(self.mountPoint, "/nix/tmp"));
        FileSystem.removeRecursive(PathTools.join(self.mountPoint, self.config.paths.root));
        var source = UnixShell.quote(self.config.paths.root);
        var destination = UnixShell.quote(PathTools.join(self.mountPoint, self.config.paths.root));
        self.shell.run(Command(f"cp -r {source} {destination}"), stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), throwOnFailure=true);

        var flake = UnixShell.quote(f"{PathTools.join(self.mountPoint, self.config.paths.root)}#{self.config.host()}-{self.config.target()}");
        var root = UnixShell.quote(self.mountPoint);
        var temporaryDirectory = PathTools.join(self.mountPoint, "/nix/tmp");
        var result = self.shell.run(Command(f"nixos-install --flake {flake} --root {root} --no-channel-copy --show-trace --no-root-password --max-jobs auto --cores 0"),
            stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), env=[f"TMPDIR={temporaryDirectory}"]);
        FileSystem.removeRecursive(PathTools.join(self.mountPoint, "/nix/tmp"));
        if (result.ok()) {
            self.permissionNixos();
        }
        return result;
    }

    public void permissionNixos() {
        var permissions = PermissionsManager(self.config);
        permissions.shell.chroot(self.mountPoint);
        permissions.secureTree(self.config.username());
        permissions.shell.clearChroot();

        var snapshots = SnapshotManager(self.config);
        snapshots.rootPrefix = self.mountPoint;
        snapshots.createInitialSnapshots();
    }

    public string plainTextPasswordPath() {
        if (self.config.evalBool("config.settings.disk.encryption.enable")) {
            return self.config.evalString("config.settings.disk.encryption.plainTextPasswordFile");
        }
        return "";
    }

    public void bootstrapConfigIfMissing() {
        if (self.config.exists()) { return; }
        var hostPath = self.interactive.askHostPath(self.config.paths.hostsPath());
        self.config.reset(hostPath, self.config.standardTarget());
    }

    public void collectGarbage() {
        self.shell.run(Command("nix-collect-garbage -d"), stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), throwOnFailure=true);
    }

    public string debugExtensionsDir() {
        return "/tmp/vscodium-extensions";
    }

    public void prepareDebugExtensions() {
        var rev = self.config.inputLockedRev("btrc");
        if (rev.isEmpty() || rev.equals("master")) {
            rev = "main";
        }
        var flake = UnixShell.quote(f"github:schiffy91/btrc/{rev}#btrc-vscode");
        var build = self.shell.run(f"{self.config.nixCommand()} build --no-link --print-out-paths {flake}", stderr=CommandOutput.stream(), throwOnFailure=true);
        var source = UnixShell.quote(f"{build.trimmed()}/share/vscode/extensions/btrc-dev.btrc");
        var directory = UnixShell.quote(self.debugExtensionsDir());
        FileSystem.removeRecursive(self.debugExtensionsDir());
        FileSystem.mkdirp(self.debugExtensionsDir());
        self.shell.run(f"cp -R {source} {directory}", stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), throwOnFailure=true);
    }

    public void debugShell() {
        self.prepareDebugExtensions();
        var extensions = UnixShell.quote(self.debugExtensionsDir());
        var vscodium = f"{self.config.nixCommand()} run nixpkgs#vscodium -- --no-sandbox --user-data-dir /tmp/vscodium-data --extensions-dir {extensions}";
        self.shell.run(f"{vscodium} --install-extension ms-python.python", stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), logFailure=false);
        self.shell.run(f"{vscodium} --install-extension rogalmic.bash-debug", stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), logFailure=false);
        self.shell.run(f"{vscodium} {UnixShell.quote(self.config.paths.root)}", stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), logFailure=false);
        NixosLog.fatal("Please continue in VSCodium");
    }
}
