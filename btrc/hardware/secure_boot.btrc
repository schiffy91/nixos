import std.*;
import ../core/log.btrc;
import ../system/config.btrc;
import ../system/rebuild.btrc;

class SecureBootManager {
    public NixosConfig config;
    public UnixShell shell;

    public SecureBootManager(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
    }

    public void removeOldEntries() {
        FileSystem.mkdirp("/boot/EFI/Linux");
        FileSystem.mkdirp("/var/lib/sbctl");
        self.shell.run("find /boot/EFI/Linux -type f -name 'linux-*.efi' -delete", stdout=CommandOutput.stream(), logFailure=false);
        FileSystem.removeRecursive("/etc/secureboot");
    }

    public bool keysEnrolled() {
        var result = self.shell.run("sbctl status 2>&1", logFailure=false);
        return result.stdout().toLower().contains("secure boot:") && result.stdout().toLower().contains("enabled");
    }

    public bool keysSigned() {
        var result = self.shell.run("sbctl verify 2>&1", logFailure=false);
        return result.stdout().toLower().contains("is signed");
    }

    public void createKeys() {
        var create = Command("sbctl")
            .arg("create-keys");
        self.shell.run(create.render(), stdout=CommandOutput.stream(), logFailure=false);
    }

    public void enrollKeys(bool microsoft) {
        var enroll = Command("sbctl")
            .arg("enroll-keys");
        if (microsoft) {
            enroll.arg("--microsoft");
        } else {
            enroll.arg("--yes-this-might-brick-my-machine");
        }
        self.shell.run(enroll.render(), stdout=CommandOutput.stream());
    }

    public Vector<string> unsignedFromJson(string json) {
        // sbctl verify --json emits {"<file_path>": {"is_signed": <bool>, ...}, ...}.
        // JsonObject.parse correctly reads top-level keys; JsonText.objectField pulls
        // each balanced nested object, and JsonText.field extracts its is_signed.
        Vector<string> result = [];
        var top = JsonObject.parse(json);
        for key, _ in top.values {
            var body = JsonText.objectField(json, key);
            if (body.isEmpty()) { continue; }
            if (JsonText.field(body, "is_signed", "true").equals("false")) {
                result.push(key);
            }
        }
        return result;
    }

    public void verify() {
        var verify = Command("sbctl")
            .arg("verify")
            .arg("--json");
        var result = self.shell.run(verify.render(), logFailure=false);
        var output = result.trimmed();
        if (output.isEmpty() || output.equals("null")) {
            NixosLog.error("No EFI binaries registered");
            return;
        }
        var unsignedPaths = self.unsignedFromJson(output);
        if (unsignedPaths.isEmpty()) {
            NixosLog.info("All EFI binaries are signed");
            return;
        }
        for path in unsignedPaths {
            NixosLog.error(f"NOT signed: {path}");
        }
    }

    public void enable(bool microsoft) {
        self.removeOldEntries();
        self.createKeys();
        self.enrollKeys(microsoft);
        self.config.local.setString("target", self.config.secureBootTarget());
        var options = RebuildOptions();
        options.rebuildFileSystem = true;
        options.clean = true;
        NixosRebuilder(self.config).update(options);
        self.verify();
    }

    public void disable() {
        self.removeOldEntries();
        self.config.local.setString("target", self.config.standardTarget());
        var options = RebuildOptions();
        options.rebuildFileSystem = true;
        options.clean = true;
        NixosRebuilder(self.config).update(options);
    }

    public void status() {
        var status = Command("sbctl")
            .arg("status");
        self.shell.run(status.render(), stdout=CommandOutput.stream(), logFailure=false);
        self.verify();
    }
}
