import std.*;
import ../system/config.btrc;

class Tpm2Manager {
    public NixosConfig config;
    public UnixShell shell;

    public Tpm2Manager(NixosConfig config) {
        self.config = config;
        self.shell = UnixShell();
    }

    public bool exists() {
        if (!FileSystem.exists(self.config.tpmDevice())) { return false; }
        var version = Path.readAll(self.config.tpmVersionPath()).trim();
        return version.equals("2");
    }

    public bool diskEncrypted() {
        var cmd = Command("cryptsetup")
            .arg("isLuks")
            .arg(self.config.rootPartLabelPath());
        var result = self.shell.run(cmd.render(), logFailure=false);
        return result.ok();
    }

    public bool enroll() {
        var cmd = Command("systemd-cryptenroll")
            .arg(self.config.rootPartLabelPath())
            .arg("--wipe-slot=tpm2")
            .arg(f"--tpm2-device={self.config.tpmDevice()}")
            .arg("--tpm2-pcrs=7+12");
        return self.shell.run(cmd.render(), stdout=CommandOutput.stream(), logFailure=false).ok();
    }

    public bool wipe() {
        var cmd = Command("systemd-cryptenroll")
            .arg(self.config.rootPartLabelPath())
            .arg("--wipe-slot=tpm2");
        return self.shell.run(cmd.render(), stdout=CommandOutput.stream(), logFailure=false).ok();
    }

    public void status() {
        Console.log(f"TPM2 device: {self.config.tpmDevice()}");
        var list = Command("systemd-cryptenroll")
            .arg("--tpm2-device=list")
            .arg(self.config.rootPartLabelPath());
        self.shell.run(list.render(), stdout=CommandOutput.stream(), logFailure=false);
        var dump = Command("cryptsetup")
            .arg("luksDump")
            .arg(self.config.rootPartLabelPath());
        self.shell.run(dump.render(), stdout=CommandOutput.stream(), logFailure=false);
    }
}
