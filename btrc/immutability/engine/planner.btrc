import std.*;
import ./fs.btrc;
import ./paths.btrc;
import ./types.btrc;

class ImmutabilityPlanner {
    public ImmutabilityFs fs;

    public ImmutabilityPlanner(ImmutabilityFs fs) {
        self.fs = fs;
    }

    public int compareSpecs(ImmutabilitySpec left, ImmutabilitySpec right) {
        var volume = Strings.compare(left.volume, right.volume);
        if (volume != 0) { return volume; }
        var leftDepth = Strings.count(left.relativePath, "/");
        var rightDepth = Strings.count(right.relativePath, "/");
        if (leftDepth != rightDepth) { return leftDepth - rightDepth; }
        if (left.relativePath.len() != right.relativePath.len()) { return left.relativePath.len() - right.relativePath.len(); }
        return Strings.compare(left.relativePath, right.relativePath);
    }

    public void pushSpecSorted(Vector<ImmutabilitySpec> specs, ImmutabilitySpec spec) {
        var index = 0;
        while (index < specs.len && self.compareSpecs(specs.get(index), spec) <= 0) {
            index++;
        }
        specs.insert(index, spec);
    }

    public Vector<ImmutabilitySpec> sortedSpecs(Vector<ImmutabilitySpec> input) {
        Vector<ImmutabilitySpec> sorted = [];
        for spec in input {
            self.pushSpecSorted(sorted, spec);
        }
        return sorted;
    }

    public string resolveKind(string live, string clean, ImmutabilitySpec spec) {
        var path = self.fs.sourcePath(live, clean, spec.relativePath);
        if (path.isEmpty()) { return "file"; }
        if (FileSystem.isDir(path)) { return "dir"; }
        return "file";
    }

    public bool planAlreadyCovers(Vector<ImmutabilityPlan> plans, ImmutabilitySpec spec) {
        for plan in plans {
            if (plan.spec.volume.equals(spec.volume) && plan.spec.relativePath.equals(spec.relativePath)) {
                return true;
            }
            if (plan.spec.volume.equals(spec.volume) && plan.kind.equals("dir") && ImmutabilityPaths.ancestor(plan.spec.relativePath, spec.relativePath)) {
                return true;
            }
        }
        return false;
    }

    public Vector<ImmutabilityPlan> makePlan(Vector<ImmutabilitySpec> specs, string live, string clean, string persistRoot) {
        Vector<ImmutabilityPlan> plans = [];
        var ordered = self.sortedSpecs(specs);
        for spec in ordered {
            var kind = spec.kind;
            if (kind.equals("auto")) {
                kind = self.resolveKind(live, clean, spec);
            }
            if (self.planAlreadyCovers(plans, spec)) { continue; }
            var store = kind.equals("dir")
                ? ImmutabilityPaths.dirStore(persistRoot, spec.absPath)
                : ImmutabilityPaths.fileStore(persistRoot, spec.absPath);
            plans.push(ImmutabilityPlan(spec, kind, store));
        }
        return plans;
    }
}
