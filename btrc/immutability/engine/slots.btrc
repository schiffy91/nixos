import std.*;
import ./constants.btrc;
import ./fs.btrc;
import ./run.btrc;
import ./types.btrc;

/* A/B/C snapshot-slot rotation and atomic publish. rotate() shifts live -> A ->
 * B -> C (dropping the oldest); publish() swaps a populated NEXT into LIVE (or
 * leaves it for boot when LIVE is mounted); restoreSlot() snapshots a chosen
 * slot into NEXT and publishes it. Operates over the fs collaborator + run; the
 * engine passes its snapshotsSubvolume.
 */
class ImmutabilitySlots {
    public ImmutabilityFs fs;
    public ImmutabilityRun run;

    public ImmutabilitySlots(ImmutabilityFs fs, ImmutabilityRun run) {
        self.fs = fs;
        self.run = run;
    }

    public void rotate(string volume, string live, string snapshotsSubvolume) {
        var root = PathTools.join(snapshotsSubvolume, volume);
        var a = self.run.path(PathTools.join(root, ImmutabilityConstants.a()));
        var b = self.run.path(PathTools.join(root, ImmutabilityConstants.b()));
        var c = self.run.path(PathTools.join(root, ImmutabilityConstants.c()));
        self.fs.deleteSubvolume(c);
        if (self.fs.exists(b)) {
            self.fs.snapshot(b, c, true);
            self.fs.deleteSubvolume(b);
        }
        if (self.fs.exists(a)) {
            self.fs.snapshot(a, b, true);
            self.fs.deleteSubvolume(a);
        }
        self.fs.snapshot(live, a, true);
    }

    public void publish(ImmutabilityVolume volume, string live, string next) {
        if (!self.fs.exists(next)) { return; }
        if (!self.run.dryRun && !volume.mountPoint.equals("/") && self.fs.mounted(volume.mountPoint)) {
            self.run.log(f"WRN {volume.mountPoint} mounted; leaving NEXT for boot");
            return;
        }
        if (!self.fs.exists(live)) {
            self.run.renamePath(next, live);
            return;
        }
        var quotedLive = UnixShell.quote(live);
        var quotedNext = UnixShell.quote(next);
        self.run.requireRaw(f"mv -T --exchange --no-copy {quotedLive} {quotedNext}");
        self.fs.deleteSubvolume(next);
    }

    public void restoreSlot(ImmutabilityVolume volume, string slot, string snapshotsSubvolume) {
        var root = PathTools.join(snapshotsSubvolume, volume.name);
        var live = self.run.path(volume.name);
        var next = self.run.path(PathTools.join(root, ImmutabilityConstants.next()));
        var source = self.run.path(PathTools.join(root, slot));
        if (!self.fs.exists(source) || !self.fs.isSubvolume(source)) {
            self.run.fatal(f"restore source missing: {source}");
        }
        self.fs.snapshot(source, next, false);
        self.publish(volume, live, next);
    }
}
