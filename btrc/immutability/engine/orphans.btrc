import std.datetime;
import std.fs;
import std.strings;
import std.vector;
import ./constants.btrc;
import ./fs.btrc;
import ./paths.btrc;
import ./run.btrc;
import ./types.btrc;

class ImmutabilityOrphans {
    public ImmutabilityFs fs;
    public ImmutabilityRun run;

    public ImmutabilityOrphans(ImmutabilityFs fs, ImmutabilityRun run) {
        self.fs = fs;
        self.run = run;
    }

    public void ensureNamespaces(string persistRoot) {
        var namespaces = [
            persistRoot,
            PathTools.join(persistRoot, ImmutabilityConstants.dirs()),
            PathTools.join(persistRoot, ImmutabilityConstants.orphans()),
            PathTools.join(persistRoot, ImmutabilityConstants.meta()),
            PathTools.join(PathTools.join(persistRoot, ImmutabilityConstants.meta()), ImmutabilityConstants.files())
        ];
        for rel in namespaces {
            var path = self.run.path(rel);
            if (!self.fs.exists(path)) {
                self.fs.makeSubvolume(path);
            } else if (!self.fs.isSubvolume(path)) {
                self.run.fatal(f"not a subvolume: {path}");
            }
        }
    }

    public string quarantineStamp() {
        var now = DateTime.now();
        return Strings.replace(Strings.replace(now.format(), " ", "T"), ":", "");
    }

    public void pruneOrphans(string persistRoot, Vector<ImmutabilitySpec> specs) {
        Vector<string> expectedPersistKeys = [];
        for spec in specs {
            expectedPersistKeys.push(ImmutabilityPaths.key(spec.absPath));
        }
        var dirsPath = self.run.path(PathTools.join(persistRoot, ImmutabilityConstants.dirs()));
        var orphansPath = self.run.path(PathTools.join(persistRoot, ImmutabilityConstants.orphans()));
        var children = self.fs.childSubvolumes(dirsPath);
        var stamp = self.quarantineStamp();
        for child in children {
            var key = PathTools.basename(child);
            if (!expectedPersistKeys.contains(key)) {
                var trashPath = PathTools.join(orphansPath, f"{key}-{stamp}");
                self.run.log(f"Quarantining orphaned persist subvolume {key} -> {trashPath} (delete manually after review)");
                self.run.renamePath(child, trashPath);
            }
        }
    }
}
