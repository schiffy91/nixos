import std.process;

class ImmutabilityBtrfs {
    class Command show(string path) {
        return Command(f"btrfs subvolume show {UnixShell.quote(path)}");
    }

    class Command getReadonly(string path) {
        return Command(f"btrfs property get -ts {UnixShell.quote(path)} ro");
    }

    class Command listChildren(string path) {
        return Command(f"btrfs subvolume list -o {UnixShell.quote(path)}");
    }

    class Command deleteSubvol(string path) {
        return Command(f"btrfs subvolume delete {UnixShell.quote(path)}");
    }

    class Command createSubvol(string path) {
        return Command(f"btrfs subvolume create {UnixShell.quote(path)}");
    }

    class Command snapshot(string source, string destination, bool readonly) {
        var flag = readonly ? "-r " : "";
        return Command(f"btrfs subvolume snapshot {flag}{UnixShell.quote(source)} {UnixShell.quote(destination)}");
    }

    class Command clearReadonly(string path) {
        return Command(f"btrfs property set -ts {UnixShell.quote(path)} ro false");
    }

    class Command sync(string top) {
        return Command(f"btrfs filesystem sync {UnixShell.quote(top)}");
    }
}
