import std.*;

/* Centralized btrfs CLI vocabulary. Every btrfs subcommand the immutability issues
 * is built here, so a syntax change touches one place and call sites read as
 * verbs rather than arg chains. Execution policy stays at the run site. */
class ImmutabilityBtrfs {
    class Command show(string path) {
        return Command("btrfs").arg("subvolume").arg("show").arg(path);
    }

    class Command getReadonly(string path) {
        return Command("btrfs").arg("property").arg("get").arg("-ts").arg(path).arg("ro");
    }

    class Command listChildren(string path) {
        return Command("btrfs").arg("subvolume").arg("list").arg("-o").arg(path);
    }

    class Command deleteSubvol(string path) {
        return Command("btrfs").arg("subvolume").arg("delete").arg(path);
    }

    class Command createSubvol(string path) {
        return Command("btrfs").arg("subvolume").arg("create").arg(path);
    }

    class Command snapshot(string source, string destination, bool readonly) {
        var command = Command("btrfs").arg("subvolume").arg("snapshot");
        if (readonly) { command.arg("-r"); }
        return command.arg(source).arg(destination);
    }

    class Command clearReadonly(string path) {
        return Command("btrfs").arg("property").arg("set").arg("-ts").arg(path).arg("ro").arg("false");
    }

    class Command sync(string top) {
        return Command("btrfs").arg("filesystem").arg("sync").arg(top);
    }
}
