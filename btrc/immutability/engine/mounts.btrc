import std.*;
import ./btrfs.btrc;
import ./constants.btrc;
import ./fs.btrc;
import ./paths.btrc;
import ./run.btrc;
import ./types.btrc;

class ImmutabilityMounts {
    public ImmutabilityRun run;
    public ImmutabilityFs fs;

    public ImmutabilityMounts(ImmutabilityRun run, ImmutabilityFs fs) {
        self.run = run;
        self.fs = fs;
    }

    public void mountTop(string device, bool assumeMounted) {
        if (assumeMounted) {
            if (!FileSystem.isDir(self.run.top)) {
                self.run.fatal(f"missing mount path: {self.run.top}");
            }
            return;
        }
        self.run.mkdirp(self.run.top);
        self.run.requireCommand(Command(f"mount -t btrfs -o subvolid=5,user_subvol_rm_allowed {UnixShell.quote(device)} {UnixShell.quote(self.run.top)}"));
    }

    public void unmountTop(bool assumeMounted) {
        if (assumeMounted) { return; }
        var unmounted = self.run.run(Command(f"umount -R {UnixShell.quote(self.run.top)}"), stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), logFailure=false);
        if (!unmounted.ok()) {
            self.run.fatal(f"failed to unmount: {self.run.top}");
        }
        if (self.fs.mounted(self.run.top)) {
            self.run.fatal(f"still mounted after unmount: {self.run.top}");
        }
        var topPrefix = f"{ImmutabilityConstants.topBase()}.";
        if (self.run.top.startsWith(topPrefix)) {
            FileSystem.removeRecursive(self.run.top);
        }
    }

    public bool coveredBy(Vector<string> selected, string target) {
        for s in selected {
            var prefix = f"{s}/";
            if (target.startsWith(prefix)) { return true; }
        }
        return false;
    }

    public void mountTarget(string device, string target, string subvol) {
        self.run.mkdirp(target);
        if (self.fs.mounted(target)) { return; }
        var mountOptions = f"subvol={subvol},compress=zstd,noatime";
        self.run.requireCommand(Command(f"mount -t btrfs -o {UnixShell.quote(mountOptions)} {UnixShell.quote(device)} {UnixShell.quote(target)}"));
    }

    public void mountPersist(string device, string persistRoot, Vector<ImmutabilitySpec> specs, bool assumeMounted) {
        var dryRun = self.run.dryRun ? "true" : "false";
        self.run.log(f"Mounting persistent subvolumes dry_run={dryRun}");
        var mountedTop = false;
        if (!assumeMounted && !self.fs.mounted(self.run.top)) {
            self.run.mkdirp(self.run.top);
            self.run.requireCommand(Command(f"mount -t btrfs -o ro,subvolid=5 {UnixShell.quote(device)} {UnixShell.quote(self.run.top)}"));
            mountedTop = true;
        }
        try {
            Vector<string> selected = [];
            for spec in specs {
                var target = spec.absPath;
                if (self.coveredBy(selected, target)) { continue; }
                var subvol = PathTools.join(PathTools.join(persistRoot, ImmutabilityConstants.dirs()), ImmutabilityPaths.key(target));
                if (!self.fs.isSubvolume(self.run.path(subvol))) { continue; }
                self.mountTarget(device, target, subvol);
                selected.push(target);
            }
        } finally {
            if (mountedTop) {
                self.unmountTop(false);
            }
        }
        self.run.log("Persistent mounts complete");
    }

}
