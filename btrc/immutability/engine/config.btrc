import std.*;
import ../../core/log.btrc;
import ./*;

/* Parses the immutability's inputs: the tab-separated spec file (volume, mount,
 * abs-path, kind) into ImmutabilitySpec rows, and the `name=mount` volume args (or,
 * when none are given, one volume per distinct spec) into ImmutabilityVolume rows.
 * Pure: static readers returning the parsed vectors for the engine to hold.
 */
class ImmutabilityConfig {
    class Vector<ImmutabilitySpec> readSpecs(string specFile) {
        Vector<ImmutabilitySpec> result = [];
        string content = FileSystem.readText(specFile);
        for raw in Strings.split(content, "\n") {
            string line = raw.trim();
            if (line.isEmpty() || line.startsWith("#")) { continue; }
            Vector<string> parts = Strings.split(raw, "\t");
            if (parts.len != 4) {
                NixosLog.fatal(specFile + " expected 4 tab-separated fields: " + raw);
            }
            string volume = ImmutabilityPaths.normSubvol(parts.get(0));
            string mountPoint = ImmutabilityPaths.normMount(parts.get(1));
            ImmutabilityAbsPath abs = ImmutabilityPaths.normAbs(parts.get(2));
            string kind = ImmutabilityPaths.kind(parts.get(3));
            if (kind.equals("auto") && abs.endedWithSlash) {
                kind = "dir";
            }
            string rel = ImmutabilityPaths.relToMount(abs.path, mountPoint);
            result.push(ImmutabilitySpec(volume, mountPoint, abs.path, rel, kind));
        }
        return result;
    }

    class bool volumeSeen(Vector<ImmutabilityVolume> volumes, string name) {
        for volume in volumes {
            if (volume.name.equals(name)) { return true; }
        }
        return false;
    }

    class Vector<ImmutabilityVolume> readVolumes(Vector<string> args, Vector<ImmutabilitySpec> specs) {
        Vector<ImmutabilityVolume> result = [];
        if (args.isEmpty()) {
            for spec in specs {
                if (!ImmutabilityConfig.volumeSeen(result, spec.volume)) {
                    result.push(ImmutabilityVolume(spec.volume, "/"));
                }
            }
            return result;
        }
        for arg in args {
            int marker = Strings.find(arg, "=", 0);
            if (marker < 0) { NixosLog.fatal("bad volume arg: " + arg); }
            string name = arg.substring(0, marker);
            string mountPoint = arg.substring(marker + 1, arg.len() - marker - 1);
            result.push(ImmutabilityVolume(ImmutabilityPaths.normSubvol(name), ImmutabilityPaths.normMount(mountPoint)));
        }
        return result;
    }
}
