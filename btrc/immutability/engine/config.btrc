import std.*;
import ../../core/log.btrc;
import ./paths.btrc;
import ./types.btrc;

class ImmutabilityConfig {
    class Vector<ImmutabilitySpec> readSpecs(string specFile) {
        Vector<ImmutabilitySpec> result = [];
        var rows = Toml.tableArrayBlocks(FileSystem.readText(specFile), "keep");
        for row in rows {
            var rawVolume = row.getOrDefault("volume", "");
            var rawMountPoint = row.getOrDefault("mountPoint", "");
            var rawPath = row.getOrDefault("path", "");
            var rawKind = row.getOrDefault("kind", "auto");
            if (rawVolume.isEmpty() || rawMountPoint.isEmpty() || rawPath.isEmpty()) {
                NixosLog.fatal(f"{specFile} [[keep]] entries require volume, mountPoint, and path");
            }
            var volume = ImmutabilityPaths.normSubvol(rawVolume);
            var mountPoint = ImmutabilityPaths.normMount(rawMountPoint);
            var abs = ImmutabilityPaths.normAbs(rawPath);
            var kind = ImmutabilityPaths.kind(rawKind);
            if (kind.equals("auto") && abs.endedWithSlash) {
                kind = "dir";
            }
            var rel = ImmutabilityPaths.relToMount(abs.path, mountPoint);
            result.push(ImmutabilitySpec(volume, mountPoint, abs.path, rel, kind));
        }
        return result;
    }

    class bool volumeSeen(Vector<ImmutabilityVolume> volumes, string name) {
        for volume in volumes {
            if (volume.name.equals(name)) { return true; }
        }
        return false;
    }

    class Vector<ImmutabilityVolume> readVolumes(Vector<string> args, Vector<ImmutabilitySpec> specs) {
        Vector<ImmutabilityVolume> result = [];
        if (args.isEmpty()) {
            for spec in specs {
                if (!ImmutabilityConfig.volumeSeen(result, spec.volume)) {
                    result.push(ImmutabilityVolume(spec.volume, "/"));
                }
            }
            return result;
        }
        for arg in args {
            var marker = Strings.find(arg, "=", 0);
            if (marker < 0) { NixosLog.fatal(f"bad volume arg: {arg}"); }
            var name = arg.substring(0, marker);
            var mountPoint = arg.substring(marker + 1, arg.len() - marker - 1);
            result.push(ImmutabilityVolume(ImmutabilityPaths.normSubvol(name), ImmutabilityPaths.normMount(mountPoint)));
        }
        return result;
    }
}
