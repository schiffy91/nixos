import std.fs;
import std.platform;
import std.vector;
import ./fs.btrc;
import ./paths.btrc;
import ./run.btrc;
import ./types.btrc;

class ImmutabilityMaterializer {
    public ImmutabilityRun run;
    public ImmutabilityFs fs;

    public ImmutabilityMaterializer(ImmutabilityRun run, ImmutabilityFs fs) {
        self.run = run;
        self.fs = fs;
    }

    public string pathInVolume(ImmutabilitySpec spec) {
        return self.run.path(PathTools.join(spec.volume, spec.relativePath));
    }

    public string dirStore(string persistRoot, ImmutabilitySpec spec) {
        var canonical = self.run.path(ImmutabilityPaths.dirStore(persistRoot, spec.absPath));
        if (self.fs.isSubvolume(canonical)) { return canonical; }
        return "";
    }

    public string fileStore(string persistRoot, ImmutabilitySpec spec) {
        var canonical = self.run.path(ImmutabilityPaths.fileStore(persistRoot, spec.absPath));
        if (self.fs.exists(canonical)) { return canonical; }
        return "";
    }

    public void removeTarget(string path) {
        if (self.fs.isSubvolume(path)) {
            self.fs.deleteSubvolume(path);
            return;
        }
        self.run.removePath(path);
    }

    public void materializeDirectory(ImmutabilitySpec spec, string store) {
        if (store.isEmpty()) { return; }
        var target = self.pathInVolume(spec);
        self.run.log(f"Materializing persistent directory {store} -> {target}");
        self.removeTarget(target);
        self.run.mkdirp(target);
        self.fs.copyDirectoryContents(store, target);
        self.fs.matchOwnerAndMode(store, target);
    }

    public void materializeFile(ImmutabilitySpec spec, string store) {
        var target = self.pathInVolume(spec);
        if (self.fs.exists(target)) {
            self.run.log(f"Persistent file already materialized at {target}");
            return;
        }
        if (store.isEmpty()) { return; }
        var temporary = f"{target}.tmp.{Platform.pid()}";
        self.run.log(f"Materializing persistent file {store} -> {target}");
        self.run.mkdirp(PathTools.dirname(target));
        self.run.removePath(temporary);
        self.fs.copyPath(store, temporary);
        self.removeTarget(target);
        self.run.renamePath(temporary, target);
    }

    public void materialize(Vector<ImmutabilityPlan> plans, string persistRoot) {
        for plan in plans {
            if (plan.kind.equals("dir")) {
                self.materializeDirectory(plan.spec, self.dirStore(persistRoot, plan.spec));
            } else {
                self.materializeFile(plan.spec, self.fileStore(persistRoot, plan.spec));
            }
        }
    }
}
