import std.process;

class ImmutabilityBtrfs {
    class string show(string path) {
        return f"btrfs subvolume show {UnixShell.quote(path)}";
    }

    class string getReadonly(string path) {
        return f"btrfs property get -ts {UnixShell.quote(path)} ro";
    }

    class string listChildren(string path) {
        return f"btrfs subvolume list -o {UnixShell.quote(path)}";
    }

    class string deleteSubvol(string path) {
        return f"btrfs subvolume delete {UnixShell.quote(path)}";
    }

    class string createSubvol(string path) {
        return f"btrfs subvolume create {UnixShell.quote(path)}";
    }

    class string snapshot(string source, string destination, bool readonly) {
        var flag = readonly ? "-r " : "";
        return f"btrfs subvolume snapshot {flag}{UnixShell.quote(source)} {UnixShell.quote(destination)}";
    }

    class string clearReadonly(string path) {
        return f"btrfs property set -ts {UnixShell.quote(path)} ro false";
    }

    class string sync(string top) {
        return f"btrfs filesystem sync {UnixShell.quote(top)}";
    }
}
