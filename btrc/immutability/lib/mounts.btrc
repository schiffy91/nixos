import std.fs;
import std.process;
import std.vector;
import ./btrfs.btrc;
import ./constants.btrc;
import ./fs.btrc;
import ./paths.btrc;
import ./run.btrc;
import ./types.btrc;

class ImmutabilityMounts {
    public ImmutabilityRun run;
    public ImmutabilityFs fs;

    public ImmutabilityMounts(ImmutabilityRun run, ImmutabilityFs fs) {
        self.run = run;
        self.fs = fs;
    }

    public void mountTop(string device, bool assumeMounted) {
        if (assumeMounted) {
            if (!FileSystem.isDir(self.run.top)) {
                self.run.fatal(f"missing mount path: {self.run.top}");
            }
            return;
        }
        self.run.mkdirp(self.run.top);
        self.run.require(f"mount -t btrfs -o subvolid=5,user_subvol_rm_allowed {UnixShell.quote(device)} {UnixShell.quote(self.run.top)}");
    }

    public void unmountTop(bool assumeMounted) {
        if (assumeMounted) { return; }
        var unmounted = self.run.run(f"umount -R {UnixShell.quote(self.run.top)}", stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), logFailure=false);
        if (!unmounted.ok()) {
            self.run.fatal(f"failed to unmount: {self.run.top}");
        }
        if (self.fs.mounted(self.run.top)) {
            self.run.fatal(f"still mounted after unmount: {self.run.top}");
        }
        var topPrefix = f"{ImmutabilityConstants.topBase()}.";
        if (self.run.top.startsWith(topPrefix)) {
            FileSystem.removeRecursive(self.run.top);
        }
    }

    public bool coveredBy(Vector<string> selected, string target) {
        for s in selected {
            var prefix = f"{s}/";
            if (target.startsWith(prefix)) { return true; }
        }
        return false;
    }

    public void mountTarget(string device, string target, string subvol) {
        self.run.mkdirp(target);
        if (self.fs.mounted(target)) { return; }
        var mountOptions = f"subvol={subvol},compress=zstd,noatime";
        self.run.require(f"mount -t btrfs -o {UnixShell.quote(mountOptions)} {UnixShell.quote(device)} {UnixShell.quote(target)}");
    }

    public bool persistAsDirectory(ImmutabilitySpec spec) {
        if (spec.kind.equals("dir")) { return true; }
        if (spec.kind.equals("file")) { return false; }
        return FileSystem.isDir(spec.absPath);
    }

    public void ensurePersistentSubvolume(ImmutabilitySpec spec, string persistentSubvolume) {
        if (self.fs.isSubvolume(persistentSubvolume)) { return; }
        if (!self.persistAsDirectory(spec)) { return; }
        self.fs.makeSubvolume(persistentSubvolume);
        if (self.fs.exists(spec.absPath)) {
            self.fs.copyDirectoryContents(spec.absPath, persistentSubvolume);
            self.fs.matchOwnerAndMode(spec.absPath, persistentSubvolume);
        }
    }

    public Vector<ImmutabilitySpec> selectedSpecs(Vector<ImmutabilitySpec> specs) {
        Vector<ImmutabilitySpec> selected = [];
        Vector<string> targets = [];
        for spec in specs {
            var target = spec.absPath;
            if (self.coveredBy(targets, target)) { continue; }
            targets.push(target);
            selected.push(spec);
        }
        return selected;
    }

    public void mountPersist(string device, string persistRoot, Vector<ImmutabilitySpec> specs, bool assumeMounted) {
        var dryRun = self.run.dryRun ? "true" : "false";
        self.run.log(f"Mounting persistent subvolumes dry_run={dryRun}");
        var mountedTop = false;
        if (!assumeMounted && !self.fs.mounted(self.run.top)) {
            self.run.mkdirp(self.run.top);
            self.run.require(f"mount -t btrfs -o subvolid=5 {UnixShell.quote(device)} {UnixShell.quote(self.run.top)}");
            mountedTop = true;
        }
        try {
            var selected = self.selectedSpecs(specs);
            for spec in selected {
                var target = spec.absPath;
                var subvol = PathTools.join(PathTools.join(persistRoot, ImmutabilityConstants.dirs()), ImmutabilityPaths.key(target));
                self.ensurePersistentSubvolume(spec, self.run.path(subvol));
                if (!self.fs.isSubvolume(self.run.path(subvol))) { continue; }
                self.mountTarget(device, target, subvol);
            }
        } finally {
            if (mountedTop) {
                self.unmountTop(false);
            }
        }
        self.run.log("Persistent mounts complete");
    }

}
