import std.fs;
import std.strings;
import std.vector;
import ./constants.btrc;
import ./fs.btrc;
import ./mounts.btrc;
import ./paths.btrc;
import ./run.btrc;
import ./slots.btrc;
import ./types.btrc;

class ImmutabilityMigrations {
    public ImmutabilityRun run;
    public ImmutabilityFs fs;
    public ImmutabilitySlots slots;
    public ImmutabilityMounts mounts;

    public ImmutabilityMigrations(ImmutabilityRun run, ImmutabilityFs fs, ImmutabilitySlots slots, ImmutabilityMounts mounts) {
        self.run = run;
        self.fs = fs;
        self.slots = slots;
        self.mounts = mounts;
    }

    public string metadataRoot(string snapshotsSubvolume) {
        return self.run.path(PathTools.join(snapshotsSubvolume, ImmutabilityConstants.meta()));
    }

    public string versionPath(string snapshotsSubvolume) {
        return PathTools.join(self.metadataRoot(snapshotsSubvolume), ImmutabilityConstants.versionFile());
    }

    public string installedVersion(string snapshotsSubvolume) {
        var path = self.versionPath(snapshotsSubvolume);
        if (!FileSystem.exists(path)) { return "0.0"; }
        var version = FileSystem.readText(path).trim();
        if (version.isEmpty()) { return "0.0"; }
        return version;
    }

    public int versionPart(string version, int index) {
        var parts = Strings.split(version, ".");
        if (index >= parts.len) { return 0; }
        var part = parts.get(index).trim();
        if (!Strings.isDigitStr(part)) { return -1; }
        return Strings.toInt(part);
    }

    public bool versionLessThan(string left, string right) {
        for (int index = 0; index < 3; index++) {
            var leftPart = self.versionPart(left, index);
            var rightPart = self.versionPart(right, index);
            if (leftPart < rightPart) { return true; }
            if (leftPart > rightPart) { return false; }
        }
        return false;
    }

    public Vector<string> targets(Vector<ImmutabilitySpec> specs) {
        Vector<string> result = [];
        for spec in specs {
            result.push(spec.absPath);
        }
        return result;
    }

    public void migrateLegacySlots(string snapshotsSubvolume, Vector<ImmutabilityVolume> volumes, int generations) {
        for volume in volumes {
            var root = self.run.path(PathTools.join(snapshotsSubvolume, volume.name));
            self.slots.migrateLegacy(root, generations);
            self.slots.pruneGenerations(root, generations);
        }
    }

    public void migrateLegacyDirStores(string persistRoot, Vector<ImmutabilitySpec> specs) {
        var targets = self.targets(specs);
        for spec in specs {
            var key = ImmutabilityPaths.key(spec.absPath);
            var legacyKey = ImmutabilityPaths.legacyKey(spec.absPath);
            if (key.equals(legacyKey)) { continue; }
            if (self.mounts.ambiguousLegacyKey(spec.absPath, targets)) { continue; }

            var canonical = self.run.path(ImmutabilityPaths.dirStore(persistRoot, spec.absPath));
            var legacy = self.run.path(PathTools.join(PathTools.join(persistRoot, ImmutabilityConstants.dirs()), legacyKey));
            if (self.fs.isSubvolume(legacy) && !self.fs.exists(canonical)) {
                self.run.log(f"Migrating legacy persist dir {legacy} -> {canonical}");
                self.run.mkdirp(PathTools.dirname(canonical));
                self.run.renamePath(legacy, canonical);
            }
        }
    }

    public void migrateLegacyFileStores(string persistRoot, Vector<ImmutabilitySpec> specs) {
        var targets = self.targets(specs);
        var filesRoot = PathTools.join(PathTools.join(persistRoot, ImmutabilityConstants.meta()), ImmutabilityConstants.files());
        for spec in specs {
            var key = ImmutabilityPaths.key(spec.absPath);
            var legacyKey = ImmutabilityPaths.legacyKey(spec.absPath);
            if (key.equals(legacyKey)) { continue; }
            if (self.mounts.ambiguousLegacyKey(spec.absPath, targets)) { continue; }

            var canonical = self.run.path(ImmutabilityPaths.fileStore(persistRoot, spec.absPath));
            var legacy = self.run.path(PathTools.join(filesRoot, legacyKey));
            if (self.fs.exists(legacy) && !self.fs.exists(canonical)) {
                self.run.log(f"Migrating legacy persist file {legacy} -> {canonical}");
                self.run.mkdirp(PathTools.dirname(canonical));
                self.run.renamePath(legacy, canonical);
            }
        }
    }

    public void writeVersion(string snapshotsSubvolume) {
        var path = self.versionPath(snapshotsSubvolume);
        if (self.run.dryRun) {
            self.run.log(f"DRY write immutability version {ImmutabilityConstants.currentVersion()} to {path}");
            return;
        }
        FileSystem.mkdirp(PathTools.dirname(path));
        FileSystem.writeText(path, f"{ImmutabilityConstants.currentVersion()}\n");
    }

    public void migrate(string snapshotsSubvolume, string persistRoot, Vector<ImmutabilityVolume> volumes, Vector<ImmutabilitySpec> specs, int generations) {
        var version = self.installedVersion(snapshotsSubvolume);
        if (!self.versionLessThan(version, ImmutabilityConstants.currentVersion())) { return; }
        self.run.log(f"Migrating immutability state {version} -> {ImmutabilityConstants.currentVersion()}");
        self.migrateLegacySlots(snapshotsSubvolume, volumes, generations);
        self.migrateLegacyDirStores(persistRoot, specs);
        self.migrateLegacyFileStores(persistRoot, specs);
        self.writeVersion(snapshotsSubvolume);
    }
}
