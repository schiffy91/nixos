import Library.Console;
import Library.Timer;
import Library.FileSystem;
import Library.Platform;
import Library.Vector;
import Library.Process;
import ../../core/NixosLog.btrc;
import ./ImmutabilityConstants.btrc;
import ./ImmutabilityPaths.btrc;

class ImmutabilityRun {
    public UnixShell shell;
    public Timer timer;
    public string top;
    public string logFile;
    public bool dryRun;

    public ImmutabilityRun(bool dryRun) {
        self.shell = UnixShell();
        self.timer = Timer();
        self.timer.start();
        self.top = Environment.get("IMMUTABILITY_MOUNT_PATH", f"{ImmutabilityConstants.topBase()}.{Platform.pid()}");
        self.logFile = "";
        self.dryRun = dryRun;
    }

    public string elapsed() {
        return f"[{self.timer.elapsed()}s]";
    }

    public string path(string rel) {
        var base = ImmutabilityPaths.trimTrailingSlashes(self.top);
        var child = ImmutabilityPaths.trimSlashes(rel);
        if (child.isEmpty()) { return base; }
        return PathTools.join(base, child);
    }

    public void log(string message) {
        var line = f"{self.elapsed()} {message}";
        Console.error(line);
        if (!self.logFile.isEmpty()) {
            self.shell.run(f"printf '%s\\n' {ShellWords.quote(line)} >> {ShellWords.quote(self.logFile)}", logFailure=false);
        }
    }

    public void enableFileLog(string path) {
        if (self.dryRun) { return; }
        self.logFile = path;
        FileSystem.mkdirp(PathTools.dirname(path));
        FileSystem.writeText(path, "");
    }

    public void fatal(string message) {
        throw f"{self.elapsed()} ERR {message}";
    }

    public ExecResult run(string command,
                          CommandOutput stdout = COMMAND_OUTPUT_COLLECT,
                          CommandOutput stderr = COMMAND_OUTPUT_COMBINE,
                          bool logFailure = true) {
        if (self.dryRun) {
            self.log(f"DRY {command}");
            return ExecResult(0, "", "", command);
        }
        self.log(command);
        return self.shell.run(command, stdout=stdout, stderr=stderr, logFailure=logFailure);
    }

    public void require(string command) {
        var result = self.run(command, stdout=COMMAND_OUTPUT_STREAM, stderr=COMMAND_OUTPUT_STREAM);
        if (!result.ok()) { self.fatal(f"Failed: {command}"); }
    }

    public void mkdirpInheriting(string path) {
        Vector<string> missing = [];
        var ancestor = path;
        while (!ancestor.isEmpty() && !FileSystem.exists(ancestor)) {
            missing.push(ancestor);
            var parent = PathTools.dirname(ancestor);
            if (parent.equals(ancestor)) { break; }
            ancestor = parent;
        }
        if (missing.isEmpty()) { return; }
        self.mkdirp(path);
        if (self.dryRun || !FileSystem.exists(ancestor)) { return; }
        var reference = ShellWords.quote(ancestor);
        for (int i = missing.len - 1; i >= 0; i--) {
            var created = ShellWords.quote(missing.get(i));
            self.require(f"chown --reference={reference} {created}");
            self.require(f"chmod --reference={reference} {created}");
        }
    }

    public void mkdirp(string path) {
        if (self.dryRun) {
            self.log(f"DRY mkdir -p {ShellWords.quote(path)}");
            return;
        }
        FileSystem.mkdirp(path);
    }

    public void removePath(string path) {
        if (self.dryRun) {
            self.log(f"DRY rm -rf {ShellWords.quote(path)}");
            return;
        }
        if (FileSystem.exists(path) || FileSystem.isSymlink(path)) {
            FileSystem.removeRecursive(path);
        }
    }

    public void renamePath(string source, string destination) {
        var quotedSource = ShellWords.quote(source);
        var quotedDestination = ShellWords.quote(destination);
        self.require(f"mv --no-copy {quotedSource} {quotedDestination}");
    }
}
