import std.*;
import ../core/log.btrc;
import ./engine/btrfs.btrc;
import ./engine/config.btrc;
import ./engine/constants.btrc;
import ./engine/fs.btrc;
import ./engine/mounts.btrc;
import ./engine/orphans.btrc;
import ./engine/paths.btrc;
import ./engine/planner.btrc;
import ./engine/run.btrc;
import ./engine/slots.btrc;
import ./engine/types.btrc;

class Immutability {
    public ImmutabilityRun run;
    public ImmutabilityFs fs;
    public ImmutabilityPlanner planner;
    public ImmutabilityMounts mounts;
    public ImmutabilitySlots slots;
    public ImmutabilityOrphans orphans;
    public string device;
    public string snapshotsSubvolume;
    public string cleanName;
    public string mode;
    public string persistRoot;
    public string specFile;
    public Vector<ImmutabilitySpec> specs;
    public Vector<ImmutabilityVolume> volumes;
    public bool assumeMounted;

    public Immutability(bool dryRun, bool assumeMounted) {
        self.run = ImmutabilityRun(dryRun);
        self.fs = ImmutabilityFs(self.run);
        self.planner = ImmutabilityPlanner(self.fs);
        self.mounts = ImmutabilityMounts(self.run, self.fs);
        self.slots = ImmutabilitySlots(self.fs, self.run);
        self.orphans = ImmutabilityOrphans(self.fs, self.run);
        self.device = "";
        self.snapshotsSubvolume = "";
        self.cleanName = "";
        self.mode = "";
        self.persistRoot = "";
        self.specFile = "";
        self.specs = [];
        self.volumes = [];
        self.assumeMounted = assumeMounted;
    }

    class bool envDryRun() {
        var value = Environment.get("IMMUTABILITY_DRY_RUN", "");
        return value.equals("1") || value.equals("true") || value.equals("yes") || value.equals("on");
    }

    public Vector<ImmutabilitySpec> specsForVolume(string volume) {
        Vector<ImmutabilitySpec> result = [];
        for spec in self.specs {
            if (spec.volume.equals(volume)) { result.push(spec); }
        }
        return result;
    }

    public void resetVolume(ImmutabilityVolume volume) {
        var live = self.run.path(volume.name);
        var root = PathTools.join(self.snapshotsSubvolume, volume.name);
        var clean = self.run.path(PathTools.join(root, self.cleanName));
        var next = self.run.path(PathTools.join(root, ImmutabilityConstants.next()));

        if (!self.fs.exists(clean) || !self.fs.isSubvolume(clean) || !self.fs.isReadonly(clean)) {
            self.run.fatal(f"bad CLEAN: {clean}");
        }
        if (!self.fs.exists(live)) {
            self.slots.publish(volume, live, next);
        }
        if (!self.fs.exists(live)) { self.run.fatal(f"live missing: {live}"); }
        if (!self.fs.isSubvolume(live)) { self.run.fatal(f"live is not a subvolume: {live}"); }
        self.fs.deleteSubvolume(next);

        var plans = self.planner.makePlan(self.specsForVolume(volume.name), live, clean, self.persistRoot);
        self.restorePersistentDirs(plans, live, clean);
        self.restorePersistentFiles(plans, live, clean);

        self.slots.rotate(volume.name, live, self.snapshotsSubvolume);
        self.fs.snapshot(clean, next, false);
        self.populateNext(plans, next);
        self.slots.publish(volume, live, next);
    }

    public void restorePersistentDirs(Vector<ImmutabilityPlan> plans, string live, string clean) {
        for plan in plans {
            if (!plan.kind.equals("dir")) { continue; }
            var store = self.run.path(plan.store);
            if (!self.fs.exists(store)) {
                self.fs.makeSubvolume(store);
                var source = self.fs.sourcePath(live, clean, plan.spec.relativePath);
                if (!source.isEmpty()) {
                    self.fs.copyDirectoryContents(source, store);
                    self.fs.matchOwnerAndMode(source, store);
                }
            } else if (!self.fs.isSubvolume(store)) {
                self.run.fatal(f"not a subvolume: {store}");
            }
        }
    }

    public void restorePersistentFiles(Vector<ImmutabilityPlan> plans, string live, string clean) {
        for plan in plans {
            if (!plan.kind.equals("file")) { continue; }
            var destination = self.run.path(plan.store);
            var source = self.fs.sourcePath(live, clean, plan.spec.relativePath);
            if (!source.isEmpty()) {
                var temporary = f"{destination}.tmp.{Platform.pid()}";
                self.run.removePath(temporary);
                self.fs.copyPath(source, temporary);
                self.run.removePath(destination);
                self.run.renamePath(temporary, destination);
            } else {
                self.run.removePath(destination);
            }
        }
    }

    public void populateNext(Vector<ImmutabilityPlan> plans, string next) {
        for plan in plans {
            var target = PathTools.join(next, plan.spec.relativePath);
            self.run.removePath(target);
            if (plan.kind.equals("dir")) {
                self.run.mkdirp(target);
            } else {
                var source = self.run.path(plan.store);
                if (self.fs.exists(source)) {
                    self.fs.copyPath(source, target);
                }
            }
        }
    }

    public void configure(string device, string snapshotsSubvolume, string cleanName, string mode, string persistRoot, string specFile, Vector<string> volumeArgs) {
        self.device = device;
        self.snapshotsSubvolume = ImmutabilityPaths.normSubvol(snapshotsSubvolume);
        self.cleanName = cleanName.trim();
        self.mode = mode.trim();
        self.persistRoot = ImmutabilityPaths.normSubvol(persistRoot);
        self.specFile = specFile;
        self.specs = ImmutabilityConfig.readSpecs(self.specFile);
        self.volumes = ImmutabilityConfig.readVolumes(volumeArgs, self.specs);
    }

    public bool modeIn(Vector<string> modes) {
        for mode in modes {
            if (self.mode.equals(mode)) { return true; }
        }
        return false;
    }

    public bool resetMode() {
        return self.modeIn([
            ImmutabilityConstants.converge(),
            ImmutabilityConstants.reset(),
            ImmutabilityConstants.prepareOnly()
        ]);
    }

    public void runVolume(ImmutabilityVolume volume) {
        if (self.resetMode()) {
            self.resetVolume(volume);
            return;
        }
        if (self.mode.equals(ImmutabilityConstants.snapshotOnly())) {
            self.slots.rotate(volume.name, self.run.path(volume.name), self.snapshotsSubvolume);
            return;
        }
        if (self.modeIn([ImmutabilityConstants.restoreA(), ImmutabilityConstants.restorePrevious()])) {
            self.slots.restoreSlot(volume, ImmutabilityConstants.a(), self.snapshotsSubvolume);
            return;
        }
        if (self.modeIn([ImmutabilityConstants.restoreB(), ImmutabilityConstants.restorePenultimate()])) {
            self.slots.restoreSlot(volume, ImmutabilityConstants.b(), self.snapshotsSubvolume);
            return;
        }
        if (self.mode.equals(ImmutabilityConstants.restoreC())) {
            self.slots.restoreSlot(volume, ImmutabilityConstants.c(), self.snapshotsSubvolume);
            return;
        }
        self.run.fatal(f"Unknown mode: {self.mode}");
    }

    public void runAll() {
        Vector<string> names = [];
        for volume in self.volumes { names.push(volume.name); }
        var dryRun = self.run.dryRun ? "true" : "false";
        var subvolumes = names.join(" ");
        self.run.log(f"Mode={self.mode} dry_run={dryRun} device={self.device} subvolumes={subvolumes}");
        if (self.mode.equals(ImmutabilityConstants.disabled())) {
            self.run.log("Immutability disabled; skipping");
            return;
        }
        if (self.run.dryRun && !self.assumeMounted) {
            self.run.log("DRY add --assume-mounted to walk mounted test roots");
            return;
        }
        self.mounts.mountTop(self.device, self.assumeMounted);
        try {
            self.orphans.ensureNamespaces(self.persistRoot);
            if (self.resetMode()) {
                self.orphans.pruneOrphans(self.persistRoot, self.specs);
            }
            for volume in self.volumes {
                self.runVolume(volume);
            }
            self.run.requireCommand(ImmutabilityBtrfs.sync(self.run.top));
        } finally {
            self.mounts.unmountTop(self.assumeMounted);
        }
        self.run.log("Immutability complete");
    }

    public void configureMount(string device, string persistRoot, string specFile) {
        self.device = device;
        self.persistRoot = ImmutabilityPaths.normSubvol(persistRoot);
        self.specFile = specFile;
        self.specs = ImmutabilityConfig.readSpecs(self.specFile);
    }

    public void mountPersist() {
        self.mounts.mountPersist(self.device, self.persistRoot, self.specs, self.assumeMounted);
    }

    class int cli(CliArgs args) {
        try {
            var parsed = CliCommandLine.parse(args);
            var dryRun = Immutability.envDryRun() || parsed.flag("--dry-run");
            var assumeMounted = parsed.flag("--assume-mounted");
            if (parsed.operand(0).equals("mount")) {
                if (parsed.operandCount() < 4) {
                    Console.error("Usage: immutability [--dry-run] mount <device> <persist_root> <spec_file>");
                    return 1;
                }
                var mounter = Immutability(dryRun, assumeMounted);
                mounter.configureMount(parsed.operand(1), parsed.operand(2), parsed.operand(3));
                mounter.mountPersist();
                return 0;
            }
            if (parsed.operandCount() < 6) {
                Console.error("Usage: immutability [--dry-run] [--assume-mounted] <device> <snapshots> <clean> <mode> <persist_root> <spec_file> [name=mount ...]");
                return 1;
            }
            Vector<string> volumeArgs = [];
            for (int i = 6; i < parsed.operandCount(); i++) {
                volumeArgs.push(parsed.operand(i));
            }
            var immutability = Immutability(dryRun, assumeMounted);
            immutability.configure(
                parsed.operand(0),
                parsed.operand(1),
                parsed.operand(2),
                parsed.operand(3),
                parsed.operand(4),
                parsed.operand(5),
                volumeArgs
            );
            immutability.runAll();
            return 0;
        } catch (string error) {
            var message = f"{error}";
            NixosLog.fatal(message);
        }
        return 1;
    }
}

int main(int argc, char** argv) {
    CliArgs args = CliArgs(argc, argv);
    int code = Immutability.cli(args);
    return code;
}
