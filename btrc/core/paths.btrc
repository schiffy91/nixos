import std.fs;
import std.json;
import std.platform;
import std.strings;

class NixosPaths {
    public string root;

    public NixosPaths(string root = "/etc/nixos") {
        self.root = root;
    }

    class string rootFromEnv() {
        return Environment.get("NIXOS_CONFIG_ROOT", "/etc/nixos");
    }

    class string hardwareConfigPathFromEnv() {
        return Environment.get("NIXOS_CONFIG", "");
    }

    class string trayIconPathFromEnv() {
        return Environment.get("NIXOS_TRAY_ICON", "");
    }

    public string configPath() {
        return PathTools.join(self.root, "config.json");
    }

    public string flakePath() {
        return PathTools.join(self.root, "flake.nix");
    }

    public string settingsPath() {
        return PathTools.join(self.root, "nix/settings.nix");
    }

    public string hostsPath() {
        return PathTools.join(self.root, "nix/hosts");
    }

    public string secretsPathFallback() {
        return PathTools.join(self.root, "secrets");
    }
}

class LocalConfigFile {
    public string path;

    public LocalConfigFile(string path) {
        self.path = path;
    }

    public bool exists() {
        return FileSystem.exists(self.path);
    }

    public JsonObject read() {
        if (!self.exists()) {
            return JsonObject();
        }
        return JsonObject.readFile(self.path);
    }

    public void overwrite(JsonObject data) {
        var dir = PathTools.dirname(self.path);
        FileSystem.mkdirp(dir);
        data.writeFile(self.path);
    }

    public string getString(string key, string fallback) {
        var data = self.read();
        var value = data.getString(key, fallback);
        return Strings.copy(value);
    }

    public void setString(string key, string value) {
        var data = self.read();
        data.setString(key, value);
        self.overwrite(data);
    }
}
