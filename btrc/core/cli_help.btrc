import std.*;

/* Two-column help text formatter for nixosctl-style CLIs.
 * - section(t)         heading like "System lifecycle:" with leading blank
 * - item(sig, desc)    "  <signature padded to col 30><description>"
 *                      signatures >= 30 chars wrap onto a second line
 * - continuation(t)    line aligned under the description column
 * - line(t)            raw passthrough (use for "Usage:" header / footers)
 */
class CliHelp {
    public int width;
    public string padding;

    public CliHelp() {
        self.width = 30;
        self.padding = Strings.repeat(" ", 30);
    }

    public void line(string text) {
        Console.log(text);
    }

    public void blank() {
        Console.log("");
    }

    public void section(string title) {
        self.blank();
        Console.log(title + ":");
    }

    public void item(string signature, string description) {
        if (signature.len() >= self.width) {
            Console.log("  " + signature);
            if (!description.isEmpty()) {
                Console.log(self.padding + description);
            }
            return;
        }
        Console.log("  " + Strings.padRight(signature, self.width, ' ') + description);
    }

    public void continuation(string text) {
        Console.log(self.padding + text);
    }
}
