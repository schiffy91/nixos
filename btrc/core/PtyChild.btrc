import Library.Vector;

#include <errno.h>
#include <fcntl.h>
#include <limits.h>
#include <poll.h>
#include <pty.h>
#include <signal.h>
#include <stdlib.h>
#include <string.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <termios.h>
#include <time.h>
#include <unistd.h>


class PtyChild {
    public int fd;
    public pid_t pid;

    public PtyChild() {
        self.fd = -1;
        self.pid = (pid_t)0;
    }

    class long long now() {
        struct timespec t;
        if (clock_gettime(CLOCK_MONOTONIC, &t) != 0) { return LLONG_MAX; }
        return (long long)t.tv_sec * 1000LL + (long long)t.tv_nsec / 1000000LL;
    }

    class long long deadlineAfter(int milliseconds) { return PtyChild.now() + (long long)milliseconds; }

    class char** cArray(Vector<string> values) {
        char** result = (char**)calloc((size_t)values.len + (size_t)1, sizeof(char*));
        if (result == NULL) { return NULL; }
        for (int i = 0; i < values.len; i++) {
            result[i] = strdup(values.get(i));
            if (result[i] == NULL) {
                PtyChild.freeArray(result);
                return NULL;
            }
        }
        return result;
    }

    class void freeArray(char** values) {
        if (values == NULL) { return; }
        for (int i = 0; values[i] != NULL; i++) { free(values[i]); }
        free(values);
    }

    public bool start(string executable, Vector<string> args, Vector<string> env) {
        char** argv = PtyChild.cArray(args);
        char** envp = PtyChild.cArray(env);
        if (argv == NULL || envp == NULL) {
            PtyChild.freeArray(argv);
            PtyChild.freeArray(envp);
            return false;
        }
        int master = -1;
        pid_t child = forkpty(&master, NULL, NULL, NULL);
        if (child == (pid_t)0) {
            for (int d = 3; d < 1024; d++) { close(d); }
            execve(executable, argv, envp);
            _exit(127);
        }
        PtyChild.freeArray(argv);
        PtyChild.freeArray(envp);
        if (child < (pid_t)0) { return false; }
        self.fd = master;
        self.pid = child;
        int fdFlags = fcntl(master, F_GETFD, 0);
        int fileFlags = fcntl(master, F_GETFL, 0);
        if (fdFlags < 0 || fileFlags < 0 || fcntl(master, F_SETFD, fdFlags | FD_CLOEXEC) < 0 || fcntl(master, F_SETFL, fileFlags | O_NONBLOCK) < 0) {
            self.terminate();
            return false;
        }
        return true;
    }

    public int pollUntil(short events, long long deadline, int sliceMilliseconds) {
        while (true) {
            long long remaining = deadline - PtyChild.now();
            if (remaining <= 0LL) { return 0; }
            int wait = remaining > (long long)sliceMilliseconds ? sliceMilliseconds : (int)remaining;
            struct pollfd p;
            p.fd = self.fd;
            p.events = events;
            p.revents = 0;
            int ready = poll(&p, (nfds_t)1, wait);
            if (ready < 0 && errno == EINTR) { continue; }
            if (ready < 0) { return -1; }
            return ready == 0 ? 0 : (int)p.revents;
        }
        return -1;
    }

    public int readSome(char* buffer, int capacity) {
        while (true) {
            ssize_t n = read(self.fd, buffer, (size_t)capacity);
            if (n < (ssize_t)0 && errno == EINTR) { continue; }
            if (n < (ssize_t)0 && (errno == EAGAIN || errno == EWOULDBLOCK)) { return 0; }
            return (int)n <= 0 ? -1 : (int)n;
        }
        return -1;
    }

    public bool writeUntil(string text, bool newline, long long deadline) {
        if (text == null || text.len() > 4096 || text.contains("\n") || text.contains("\r")) { return false; }
        string line = newline ? text + "\n" : text;
        size_t length = strlen(line);
        size_t offset = 0;
        while (offset < length) {
            int events = self.pollUntil(POLLOUT, deadline, 1000);
            if (events <= 0 || (events & POLLOUT) == 0) { return false; }
            ssize_t n = write(self.fd, (char*)line + offset, length - offset);
            if (n > (ssize_t)0) { offset += (size_t)n; }
            else if (n < (ssize_t)0 && errno != EINTR && errno != EAGAIN && errno != EWOULDBLOCK) { return false; }
        }
        return true;
    }

    public bool echoDisabled() {
        struct termios attributes;
        return tcgetattr(self.fd, &attributes) == 0 && ((unsigned long)attributes.c_lflag & (unsigned long)ECHO) == 0UL;
    }

    public void terminate() {
        if (self.pid > (pid_t)0) {
            kill(-self.pid, SIGKILL);
            kill(self.pid, SIGKILL);
            int status = 0;
            while (waitpid(self.pid, &status, 0) < (pid_t)0 && errno == EINTR) {}
            self.pid = (pid_t)0;
        }
        self.closeMaster();
    }

    public void closeMaster() {
        if (self.fd >= 0) {
            close(self.fd);
            self.fd = -1;
        }
    }

    public int waitExitUntil(long long deadline) {
        char sink[4096];
        int status = 0;
        while (self.pid > (pid_t)0) {
            pid_t waited = waitpid(self.pid, &status, WNOHANG);
            if (waited == self.pid) {
                self.pid = (pid_t)0;
                self.closeMaster();
                return WIFEXITED(status) ? WEXITSTATUS(status) : 128 + WTERMSIG(status);
            }
            if (waited < (pid_t)0 && errno != EINTR) { break; }
            if (PtyChild.now() >= deadline) { break; }
            int events = self.pollUntil(POLLIN, deadline, 50);
            if (events > 0 && (events & POLLIN) != 0) { while (self.readSome(sink, 4096) > 0) {} }
            else if (events != 0) { poll(NULL, (nfds_t)0, 10); }
        }
        self.terminate();
        return -1;
    }
}
