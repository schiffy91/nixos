import Library.Console;
import Library.FileSystem;
import Library.Process;
import Library.Strings;
import Library.Terminal;
import Library.Vector;
import ./NixosLog.btrc;

class Interactive {
    public UnixShell shell;

    public Interactive() {
        self.shell = UnixShell();
    }

    public string ask(string prompt) {
        return Terminal.prompt(f"{prompt} ");
    }

    class int maxPromptAttempts() { return 3; }

    class string confirmationFor(string response) {
        var normalized = response.toLower().trim();
        if (normalized.equals("y") || normalized.equals("yes")) { return "yes"; }
        if (normalized.equals("n") || normalized.equals("no")) { return "no"; }
        return "";
    }

    public bool confirm(string prompt) {
        for (int attempt = 0; attempt < Interactive.maxPromptAttempts(); attempt++) {
            var answer = Interactive.confirmationFor(self.ask(f"{prompt} (y/n):"));
            if (answer.equals("yes")) { return true; }
            if (answer.equals("no")) { return false; }
            Console.error("Invalid input. Enter 'y' or 'n'.");
        }
        NixosLog.error("No answer; taking that as no.");
        return false;
    }

    public string askPassword(string prompt) {
        return Terminal.promptPassword(f"{prompt}: ");
    }

    public string askPasswordConfirmed(string prompt) {
        while (true) {
            var first = self.askPassword(prompt);
            var second = self.askPassword("Confirm password");
            if (first.equals(second)) { return first; }
            NixosLog.error("Passwords do not match.");
        }
        return "";
    }

    public string askHostPath(string hostsPath) {
        var found = self.shell.run(f"find {ShellWords.quote(hostsPath)} -type f -name '*.nix' | sort");
        if (!found.ok()) {
            NixosLog.fatal(f"Failed to search host files under {hostsPath}");
        }
        Vector<string> candidates = [];
        for line in Strings.split(found.stdout(), "\n") {
            var path = line.trim();
            if (path.isEmpty()) { continue; }
            var hostName = Strings.replace(PathTools.basename(path), ".nix", "");
            var hostDir = PathTools.basename(PathTools.dirname(path));
            if (hostName.equals(hostDir)) {
                candidates.push(path);
            }
        }
        if (candidates.len == 0) {
            NixosLog.fatal(f"No host files found under {hostsPath}");
        }
        for (int attempt = 0; attempt < Interactive.maxPromptAttempts(); attempt++) {
            for (int i = 0; i < candidates.len; i++) {
                var path = candidates.get(i);
                var hostName = Strings.replace(PathTools.basename(path), ".nix", "");
                var arch = PathTools.basename(PathTools.dirname(PathTools.dirname(path)));
                Console.error(f"{i + 1}) {hostName} ({arch})");
            }
            var selected = Strings.toInt(self.ask(">").trim()) - 1;
            if (selected >= 0 && selected < candidates.len) {
                return candidates.get(selected);
            }
            NixosLog.error("Invalid choice.");
        }
        NixosLog.fatal("No host chosen");
        return candidates.get(0);
    }

    public void askToReboot() {
        if (self.confirm("Restart now?")) {
            self.shell.run("shutdown -r now", stdout=COMMAND_OUTPUT_STREAM, stderr=COMMAND_OUTPUT_STREAM, throwOnFailure=true);
        }
    }
}
