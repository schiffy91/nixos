import Library.CLI;
import ./lib/Checks.btrc;
import ./lib/Publisher.btrc;

int main(int argc, char** argv) {
    signal((int)SIGPIPE, SIG_IGN);
    setvbuf((FILE*)stdout, null, (int)_IOLBF, (size_t)0);
    try {
        var args = CLIArgs(argc, argv);
        var repository = Repository(Environment.get("NIXOS_CONFIG_ROOT", Platform.currentDirectory()));
        var checks = Checks(repository);
        if (args.command().equals("lint")) { return checks.lint(!args.values.contains("--sources-only")); }
        if (args.command().equals("publish")) { return CachePublisher(repository.root).run(args); }
        if (args.command().equals("lsp")) {
            var server = args.require(1, "lsp requires SERVER LANGUAGE [FILE...]");
            var language = args.require(2, "lsp requires SERVER LANGUAGE [FILE...]");
            Vector<string> paths = [];
            for (int i = 3; i < args.count(); i++) { paths.push(args.get(i)); }
            if (paths.isEmpty()) { repository.discover(); paths = repository.suffix(language.equals("nix") ? ".nix" : ".btrc"); }
            return checks.lsp(server, language, paths) ? 0 : 1;
        }
        if (args.command().equals("nix-builtins")) { return checks.builtinRegression(args.count() > 1 ? args.get(1) : "nixd") ? 0 : 1; }
        print("Usage: repo-tools lint [--sources-only] | lsp SERVER LANGUAGE [FILE...] | nix-builtins [SERVER] | publish [OPTIONS]");
        return args.command().equals("--help") ? 0 : 1;
    } catch (string error) { fprintf(stderr, "repo-tools: %s\n", error); return 1; }
}
