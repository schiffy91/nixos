import Library.FileSystem;
import Library.JSON;
import Library.Platform;
import Library.Strings;
import ./PipeProcess.btrc;

class LspFrames {
    private Bytes pending = Bytes();

    class Bytes encode(JSONValue message) {
        var body = message.stringify();
        return Bytes.fromString(f"Content-Length: {body.len()}\r\n\r\n{body}");
    }

    public void append(Bytes bytes) {
        if (self.pending.length() + bytes.length() > 33554432) { throw "LSP frame exceeds 32 MiB"; }
        self.pending.appendBytes(bytes);
    }

    public JSONValue? take() {
        var separator = -1;
        for (int i = 0; i + 3 < self.pending.length(); i++) {
            if (self.pending.get(i) == 13 && self.pending.get(i + 1) == 10 && self.pending.get(i + 2) == 13 && self.pending.get(i + 3) == 10) { separator = i; break; }
        }
        if (separator < 0) {
            if (self.pending.length() > 8192) { throw "LSP headers exceed 8 KiB"; }
            return null;
        }
        if (separator > 8192) { throw "LSP headers exceed 8 KiB"; }
        var header = self.pending.slice(0, separator);
        if (!header.isNulFreeUtf8()) { throw "Invalid LSP header encoding"; }
        int length = -1;
        for line in Strings.split(header.toString(), "\r\n") {
            var colon = line.find(":", 0);
            if (colon < 0) { throw "Malformed LSP header"; }
            if (line.substring(0, colon).toLower().equals("content-length")) {
                if (length >= 0) { throw "Duplicate LSP content length"; }
                var value = line.substring(colon + 1, line.len() - colon - 1).trim();
                if (value.isEmpty()) { throw "Empty LSP content length"; }
                length = 0;
                for (int i = 0; i < value.len(); i++) {
                    if (value[i] < '0' || value[i] > '9') { throw "Invalid LSP content length"; }
                    length = length * 10 + (int)value[i] - (int)'0';
                    if (length > 33554432) { throw "LSP content exceeds 32 MiB"; }
                }
            }
        }
        if (length < 0) { throw "Missing LSP content length"; }
        if (self.pending.length() - separator - 4 < length) { return null; }
        var body = self.pending.slice(separator + 4, separator + 4 + length);
        self.pending = self.pending.slice(separator + 4 + length, self.pending.length());
        if (!body.isNulFreeUtf8()) { throw "Invalid LSP content encoding"; }
        var message = JSONValue.parse(body.toString());
        if (!message.isObject()) { throw "LSP payload must be a JSON object"; }
        return message;
    }
}

class LspSession {
    private PipeProcess child;
    private LspFrames frames = LspFrames();
    public JSONValue workspace = JSONValue.makeObject();

    public LspSession(string server, string language, string root, string log) {
        Vector<string> arguments = [];
        if (language.equals("nix")) { arguments.push("--nixpkgs-expr={}"); }
        self.child = PipeProcess(server, arguments, log);
        var params = JSONValue.makeObject();
        params.set("processId", JSONValue.makeInt((int)getpid()));
        params.set("rootUri", JSONValue.makeString(LspSession.uri(root)));
        var folder = JSONValue.makeObject(); folder.set("uri", JSONValue.makeString(LspSession.uri(root))); folder.set("name", JSONValue.makeString(PathTools.basename(root)));
        var folders = JSONValue.makeArray(); folders.push(folder); params.set("workspaceFolders", folders);
        params.set("capabilities", JSONValue.parse("{\"workspace\":{\"configuration\":true}}"));
        self.request(1, "initialize", params);
        var reply = self.response(1);
        if (!reply.has("result")) { throw "LSP initialization failed"; }
        self.notify("initialized", JSONValue.makeObject());
    }

    class string uri(string path) {
        var bytes = Bytes.fromString(PathTools.absolute(path));
        var encoded = "file://";
        var digits = "0123456789ABCDEF";
        for (int i = 0; i < bytes.length(); i++) {
            var c = bytes.get(i);
            if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 47 || c == 45 || c == 46 || c == 95 || c == 126) {
                encoded = encoded + bytes.slice(i, i + 1).toString();
            } else { encoded = encoded + "%" + digits.substring(c / 16, 1) + digits.substring(c % 16, 1); }
        }
        return encoded;
    }

    public void send(JSONValue message) {
        message.set("jsonrpc", JSONValue.makeString("2.0"));
        self.child.write(LspFrames.encode(message), MonotonicClock.deadlineAfter(60000));
    }
    public void notify(string method, JSONValue params) {
        var message = JSONValue.makeObject(); message.set("method", JSONValue.makeString(method)); message.set("params", params); self.send(message);
    }
    public void request(int id, string method, JSONValue params) {
        var message = JSONValue.makeObject(); message.set("id", JSONValue.makeInt(id)); message.set("method", JSONValue.makeString(method)); message.set("params", params); self.send(message);
    }
    private JSONValue receive() {
        var deadline = MonotonicClock.deadlineAfter(60000);
        while (MonotonicClock.before(deadline)) {
            var message = self.frames.take();
            if (message == null) {
                var bytes = self.child.read(deadline);
                if (bytes == null) { throw "LSP server exited before answering"; }
                self.frames.append(bytes);
                continue;
            }
            if (message.get("method").asString().equals("textDocument/publishDiagnostics")) {
                var params = message.get("params"); self.workspace.set(params.get("uri").asString(), params.get("diagnostics"));
            }
            if (message.has("method") && message.has("id")) {
                var reply = JSONValue.makeObject(); reply.set("id", message.get("id"));
                var result = JSONValue.makeNull();
                if (message.get("method").asString().equals("workspace/configuration")) {
                    result = JSONValue.makeArray();
                    for item in message.get("params").get("items").elements() { result.push(JSONValue.parse("{\"nixpkgs\":{\"expr\":\"{}\"},\"options\":{}}")); }
                }
                reply.set("result", result); self.send(reply);
            } else { return message; }
        }
        throw "LSP request timed out";
    }
    public JSONValue response(int id) {
        while (true) { var message = self.receive(); if (message.has("id") && message.get("id").asInt() == id) { return message; } }
        return JSONValue.makeNull();
    }
    public JSONValue diagnostics(string path, string language, string text) {
        var uri = LspSession.uri(path);
        var document = JSONValue.makeObject(); document.set("uri", JSONValue.makeString(uri)); document.set("languageId", JSONValue.makeString(language)); document.set("version", JSONValue.makeInt(1)); document.set("text", JSONValue.makeString(text));
        var params = JSONValue.makeObject(); params.set("textDocument", document); self.notify("textDocument/didOpen", params);
        while (true) {
            var message = self.receive();
            if (message.get("method").asString().equals("textDocument/publishDiagnostics") && message.get("params").get("uri").asString().equals(uri)) {
                var close = JSONValue.makeObject(); close.set("textDocument", JSONValue.parse("{\"uri\":" + JSONValue.makeString(uri).stringify() + "}")); self.notify("textDocument/didClose", close);
                return message.get("params").get("diagnostics");
            }
        }
        return JSONValue.makeArray();
    }
    public void finish() {
        self.request(2, "shutdown", JSONValue.makeNull()); self.response(2); self.notify("exit", JSONValue.makeNull());
        self.child.closeInput();
        if (self.child.wait(MonotonicClock.deadlineAfter(5000)) != 0) { throw "LSP server exited with an error"; }
    }
}
