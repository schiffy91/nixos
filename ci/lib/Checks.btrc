import Library.Console;
import Library.Strings;
import ./Repository.btrc;
import ./Lsp.btrc;

class Checks {
    public Repository repository;
    private Vector<string> failures = [];
    private Vector<string> timings = [];
    private string phaseName = "";
    private long long phaseStarted = 0LL;
    private string program;
    public Checks(Repository repository) {
        self.repository = repository;
        var invoked = Platform.programName();  // children of lint are this same program
        self.program = invoked.contains("/") ? FileSystem.realPath(invoked) : invoked;
    }

    class bool isIdentChar(char ch) {
        return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
    }

    class string stripStringsAndComments(string source) {
        var out = StringBuilder();
        int index = 0;
        int total = source.length();
        int mode = 0;  // 0=code, 1=string, 2=fstring, 3=block comment, 4=char
        Vector<int> fstack = [];
        while (index < total) {
            char ch = source[index];
            char next = index + 1 < total ? source[index + 1] : '\0';
            if (mode == 0) {
                if (ch == '/' && next == '/') {
                    while (index < total && source[index] != '\n') {
                        out.append(" ");
                        index++;
                    }
                    continue;
                }
                if (ch == '/' && next == '*') {
                    out.append("  ");
                    index += 2;
                    mode = 3;
                    continue;
                }
                char prev = index > 0 ? source[index - 1] : '\0';
                if (ch == 'f' && next == '"' && !Checks.isIdentChar(prev)) {
                    out.append("  ");
                    index += 2;
                    mode = 2;
                    continue;
                }
                if (ch == '"') {
                    out.append(" ");
                    index++;
                    mode = 1;
                    continue;
                }
                if (ch == '\'') {
                    out.append(" ");
                    index++;
                    mode = 4;
                    continue;
                }
                if (ch == '{' && !fstack.isEmpty()) {
                    int top = fstack.len - 1;
                    fstack.set(top, fstack.get(top) + 1);
                    out.append("{");
                    index++;
                    continue;
                }
                if (ch == '}' && !fstack.isEmpty()) {
                    int top = fstack.len - 1;
                    int nextDepth = fstack.get(top) - 1;
                    fstack.set(top, nextDepth);
                    out.append("}");
                    index++;
                    if (nextDepth == 0) {
                        fstack.pop();
                        mode = 2;
                    }
                    continue;
                }
                out.append(source.substring(index, 1));
                index++;
            } else if (mode == 1) {
                if (ch == '\\' && index + 1 < total) {
                    out.append(ch == '\n' ? "\n" : " ");
                    out.append(next == '\n' ? "\n" : " ");
                    index += 2;
                    continue;
                }
                if (ch == '"') {
                    out.append(" ");
                    index++;
                    mode = 0;
                    continue;
                }
                out.append(ch == '\n' ? "\n" : " ");
                index++;
            } else if (mode == 2) {
                if (ch == '\\' && index + 1 < total) {
                    out.append(ch == '\n' ? "\n" : " ");
                    out.append(next == '\n' ? "\n" : " ");
                    index += 2;
                    continue;
                }
                if ((ch == '{' && next == '{') || (ch == '}' && next == '}')) {
                    out.append("  ");
                    index += 2;
                    continue;
                }
                if (ch == '{') {
                    fstack.push(1);
                    out.append("{");
                    index++;
                    mode = 0;
                    continue;
                }
                if (ch == '"') {
                    out.append(" ");
                    index++;
                    mode = 0;
                    continue;
                }
                out.append(ch == '\n' ? "\n" : " ");
                index++;
            } else if (mode == 3) {
                if (ch == '*' && next == '/') {
                    out.append("  ");
                    index += 2;
                    mode = 0;
                    continue;
                }
                out.append(ch == '\n' ? "\n" : " ");
                index++;
            } else {
                if (ch == '\\' && index + 1 < total) {
                    out.append("  ");
                    index += 2;
                    continue;
                }
                if (ch == '\'') {
                    out.append(" ");
                    index++;
                    mode = 0;
                    continue;
                }
                out.append(ch == '\n' ? "\n" : " ");
                index++;
            }
        }
        return out.toString();
    }

    class bool hasToken(string line, string token) {
        int length = line.length();
        int tokenLen = token.length();
        for (int index = 0; index + tokenLen <= length; index++) {
            if (!line.substring(index, tokenLen).equals(token)) { continue; }
            char before = index > 0 ? line[index - 1] : ' ';
            char after = index + tokenLen < length ? line[index + tokenLen] : ' ';
            if (!Checks.isIdentChar(before) && before != '.' && !Checks.isIdentChar(after)) {
                return true;
            }
        }
        return false;
    }

    class bool hasCall(string line, string fn) {
        int length = line.length();
        int fnLen = fn.length();
        for (int index = 0; index + fnLen < length; index++) {
            if (!line.substring(index, fnLen).equals(fn)) { continue; }
            char before = index > 0 ? line[index - 1] : ' ';
            if (Checks.isIdentChar(before) || before == '.') { continue; }
            int cursor = index + fnLen;
            while (cursor < length && (line[cursor] == ' ' || line[cursor] == '\t')) { cursor++; }
            if (cursor < length && line[cursor] == '(') { return true; }
        }
        return false;
    }

    class bool hasRawDataAccess(string line) {
        int length = line.length();
        for (int index = 0; index + 5 <= length; index++) {
            if (!line.substring(index, 5).equals(".data")) { continue; }
            char after = index + 5 < length ? line[index + 5] : ' ';
            if (Checks.isIdentChar(after)) { continue; }
            if (index >= 4 && line.substring(index - 4, 4).equals("self") && (index == 4 || !Checks.isIdentChar(line[index - 5]))) {
                continue;
            }
            int cursor = index + 5;
            while (cursor < length && (line[cursor] == ' ' || line[cursor] == '\t')) { cursor++; }
            if (cursor < length && (line[cursor] == '(' || line[cursor] == '.')) { continue; }
            return true;
        }
        return false;
    }

    class bool hasLegacyOctal(string line) {
        int length = line.length();
        for (int index = 0; index + 4 <= length; index++) {
            if (line[index] != '0') { continue; }
            char before = index > 0 ? line[index - 1] : ' ';
            if (Checks.isIdentChar(before) || before == '.') { continue; }
            int digits = 0;
            while (index + 1 + digits < length && line[index + 1 + digits] >= '0' && line[index + 1 + digits] <= '7') {
                digits++;
            }
            if ((digits == 3 || digits == 4) && (index + 1 + digits == length || !Checks.isIdentChar(line[index + 1 + digits]))) {
                return true;
            }
        }
        return false;
    }

    class Vector<string> boundaryViolations(string path, string source) {
        Vector<string> violations = [];
        var stripped = Checks.stripStringsAndComments(source);
        var lines = Strings.split(stripped, "\n");
        for (int i = 0; i < lines.len; i++) {
            var line = lines.get(i);
            var trimmed = line.trim();
            int lineNo = i + 1;
            if (trimmed.startsWith("#include") || trimmed.startsWith("#define")) {
                violations.push(f"{path}:{lineNo}: raw C preprocessor directive");
                continue;
            }
            for keyword in ["extern", "struct", "typedef", "union", "NULL"] {
                if (Checks.hasToken(line, keyword)) {
                    violations.push(f"{path}:{lineNo}: raw C token '{keyword}'");
                }
            }
            for call in ["malloc", "calloc", "realloc", "free", "strdup", "memcpy", "memset", "memcmp", "strcmp", "strncmp", "strlen"] {
                if (Checks.hasCall(line, call)) {
                    violations.push(f"{path}:{lineNo}: raw C call '{call}(...)'");
                }
            }
            if (Checks.hasRawDataAccess(line)) {
                violations.push(f"{path}:{lineNo}: raw .data backing pointer access");
            }
            if (Checks.hasLegacyOctal(line)) {
                violations.push(f"{path}:{lineNo}: legacy C octal literal (use 0o...)");
            }
        }
        return violations;
    }

    public bool btrcBoundaries(Vector<string> paths) {
        print(f"\nBTRC native boundaries: {paths.len} files");
        Vector<string> violations = [];
        for path in paths {
            var absolute = PathTools.join(self.repository.root, path);
            for violation in Checks.boundaryViolations(path, Path.readAll(absolute)) {
                violations.push(violation);
            }
        }
        for violation in violations { print(violation); }
        if (!violations.isEmpty()) {
            self.failures.push("BTRC native boundaries");
            return false;
        }
        return true;
    }

    public bool run(string name, string executable, Vector<string> arguments, bool quiet = false) {
        if (!quiet) { print(f"\n{name}"); }
        var result = ChildProcess.run(executable, arguments, cwd=self.repository.root,
            stdout=quiet ? COMMAND_OUTPUT_SUPPRESS : COMMAND_OUTPUT_STREAM,
            stderr=quiet ? COMMAND_OUTPUT_COLLECT : COMMAND_OUTPUT_STREAM);
        if (!result.ok()) {
            self.failures.push(name);
            if (quiet) { print(f"{name}: {result.stderr()}"); }
        }
        return result.ok();
    }
    // Ends the phase that was running and starts the next; lint closes with how long each took.
    private void phase(string name) {
        var now = MonotonicClock.milliseconds();
        if (!self.phaseName.isEmpty()) { self.timings.push(f"{(now - self.phaseStarted + 500LL) / 1000LL}s {self.phaseName}"); }
        self.phaseName = name;
        self.phaseStarted = now;
    }
    // How many children run at once: half the processors, as each is one busy thread and lint runs beside other work.
    private int workers() {
        int processors = 0;
        if (FileSystem.exists("/proc/cpuinfo")) {
            for line in Strings.split(Path.readAll("/proc/cpuinfo"), "\n") {
                if (line.startsWith("processor")) { processors++; }
            }
        }
        return processors < 8 ? 4 : processors / 2;
    }
    class string words(Vector<string> command) {
        Vector<string> quoted = [];
        for word in command { quoted.push(ShellWords.quote(word)); }
        return quoted.join(" ");
    }
    // Runs every shell line, `limit` at a time, and returns the indexes of those that did not exit 0. A line
    // says where its own output goes.
    private Vector<int> together(Vector<string> lines, int limit) {
        Vector<int> failed = [];
        Vector<BackgroundProcess> running = [];
        Vector<int> owners = [];
        int next = 0;
        while (next < lines.length || !running.isEmpty()) {
            while (next < lines.length && running.length < limit) {
                running.push(BackgroundProcess.start("sh", ["-c", lines.get(next)], cwd=self.repository.root, killOnDrop=true));
                owners.push(next);
                next++;
            }
            Vector<BackgroundProcess> still = [];
            Vector<int> stillOwners = [];
            for (int index = 0; index < running.length; index++) {
                if (running.get(index).running()) { still.push(running.get(index)); stillOwners.push(owners.get(index)); continue; }
                if (running.get(index).code() != 0) { failed.push(owners.get(index)); }
            }
            if (still.length == running.length) { Timer.sleepMillis(20); }
            running = still;
            owners = stillOwners;
        }
        return failed;
    }
    private string head(string log) {
        var said = FileSystem.exists(log) ? Path.readAll(log) : "";
        return said.length > 65536 ? said.substring(0, 65536) : said;
    }
    // One child for each file. What a child prints is dropped (the compiler prints its whole IR); what it
    // says on stderr is shown when it fails.
    public void files(string name, string executable, Vector<string> arguments, Vector<string> paths) {
        print(f"\n{name}: {paths.length} files");
        var directory = PathTools.join(self.repository.root, "build/lint"); FileSystem.mkdirp(directory);
        Vector<string> lines = [];
        Vector<string> logs = [];
        for (int index = 0; index < paths.length; index++) {
            Vector<string> command = ["timeout", "300", executable];
            for argument in arguments { command.push(argument); }
            command.push(PathTools.join(self.repository.root, paths.get(index)));
            var log = PathTools.join(directory, name.replace(" ", "-") + f"-{index}.log");
            lines.push(f"exec {Checks.words(command)} > /dev/null 2> {ShellWords.quote(log)} < /dev/null");
            logs.push(log);
        }
        var failed = self.together(lines, self.workers());
        for (int index = 0; index < paths.length; index++) {
            if (failed.contains(index)) { self.failures.push(paths.get(index)); print(paths.get(index) + ":\n" + self.head(logs.get(index))); }
            else { FileSystem.removeIfExists(logs.get(index)); }
        }
    }
    public void record(JSONValue diagnostics, string path, JSONValue errors, JSONValue warnings) {
        for diagnostic in diagnostics.elements() {
            diagnostic.set("path", JSONValue.makeString(path));
            if (!diagnostic.has("severity") || diagnostic.get("severity").asInt() == 1) { errors.push(diagnostic); }
            else { warnings.push(diagnostic); }
        }
    }
    // `label` names the server log and the report; `known` are the files some run opens, so a diagnostic
    // the server volunteers for one of them is left to the run that opens it.
    public bool lsp(string server, string language, Vector<string> paths, string label = "", Vector<string>? known = null) {
        if (label.isEmpty()) { label = language; }
        FileSystem.mkdirp(PathTools.join(self.repository.root, "build/lint"));
        var session = LspSession(server, language, self.repository.root, PathTools.join(self.repository.root, f"build/lint/{label}-server.log"));
        var errors = JSONValue.makeArray(); var warnings = JSONValue.makeArray();
        Vector<string> uris = [];
        if (known != null) { for path in known { uris.push(LspSession.uri(PathTools.join(self.repository.root, path))); } }
        int count = 0;
        for path in paths {
            var absolute = PathTools.join(self.repository.root, path);
            uris.push(LspSession.uri(absolute));
            self.record(session.diagnostics(absolute, language, Path.readAll(absolute)), path, errors, warnings);
            count++;
            if (count % 20 == 0) { print(f"{language} {count}/{paths.len}: {errors.size()} errors"); }
        }
        session.finish();
        for uri in session.workspace.keys() { if (!uris.contains(uri)) { self.record(session.workspace.get(uri), uri, errors, warnings); } }
        var report = JSONValue.makeObject(); report.set("errors", errors); report.set("warnings", warnings);
        Path.writeAll(PathTools.join(self.repository.root, f"build/lint/{label}-diagnostics.json"), report.document());
        print(f"{language}: {paths.len} files, {errors.size()} errors, {warnings.size()} other diagnostics");
        for error in errors.elements() { print(error.get("path").asString() + ": " + error.get("message").asString()); }
        if (errors.size() > 0) { self.failures.push(f"{language} workspace diagnostics"); }
        return errors.size() == 0;
    }
    // Every `count`th file, starting at `shard`: one server's share when the files are dealt out.
    public bool lspShard(string server, string language, int shard, int count) {
        self.repository.discover();
        var all = self.repository.suffix("." + language);
        Vector<string> mine = [];
        for (int index = shard; index < all.length; index += count) { mine.push(all.get(index)); }
        return self.lsp(server, language, mine, f"{language}-{shard}", all);
    }
    // A language server answers one file at a time, so the files are dealt out to several servers, each
    // driven by a child of this program. Each child's report is build/lint/<language>-<shard>-diagnostics.json.
    public bool lspTogether(string server, string language, int shards) {
        print(f"\n{language} workspace diagnostics, {shards} servers");
        var directory = PathTools.join(self.repository.root, "build/lint"); FileSystem.mkdirp(directory);
        Vector<string> lines = [];
        Vector<string> logs = [];
        for (int shard = 0; shard < shards; shard++) {
            var log = PathTools.join(directory, f"{language}-shard-{shard}.log");
            lines.push(f"exec {Checks.words([self.program, \"lsp-shard\", server, language, f\"{shard}\", f\"{shards}\"])} > {ShellWords.quote(log)} 2>&1 < /dev/null");
            logs.push(log);
        }
        var failed = self.together(lines, shards);
        for (int shard = 0; shard < shards; shard++) {
            var said = Strings.split(Path.readAll(logs.get(shard)).trim(), "\n");
            if (failed.contains(shard)) { print(said.join("\n")); } else { print(said.get(said.length - 1)); }  // a passing server's last line is its count
        }
        if (!failed.isEmpty()) { self.failures.push(f"{language} workspace diagnostics"); }
        return failed.isEmpty();
    }
    public bool builtinRegression(string server) {
        FileSystem.mkdirp(PathTools.join(self.repository.root, "build/lint"));
        var session = LspSession(server, "nix", self.repository.root, PathTools.join(self.repository.root, "build/lint/nix-regression-server.log"));
        var valid = session.diagnostics(PathTools.join(self.repository.root, "build/lint/valid-builtins.nix"), "nix", "{ a = builtins.getFlake; b = builtins.parseFlakeRef; c = builtins.flakeRefToString; }\n");
        var invalid = session.diagnostics(PathTools.join(self.repository.root, "build/lint/invalid-builtin.nix"), "nix", "builtins.getFlkae\n");
        bool genuineError = false;
        for diagnostic in invalid.elements() { if (diagnostic.get("code").asString().equals("sema-primop-unknown")) { genuineError = true; } }
        session.finish();
        if (valid.size() != 0 || !genuineError) { self.failures.push("Nix builtin regression"); return false; }
        print("PASS: flake builtins recognized; unknown builtin still diagnosed");
        return true;
    }
    public int lint(bool full) {
        self.repository.discover();
        var nix = self.repository.suffix(".nix"); var btrc = self.repository.suffix(".btrc");
        var shell = self.repository.shellScripts();
        self.phase("source boundaries and Nix parser");
        self.btrcBoundaries(btrc);
        self.files("Nix parser", "nix-instantiate", ["--parse"], nix);
        self.phase("BTRC compiler, one file at a time");
        self.files("BTRC compiler", "btrcpy", ["--strict-imports", "--emit-ir"], btrc);
        self.phase("other parsers and linters");
        self.files("JavaScript parser", "node", ["--check"], self.repository.suffix(".js"));
        self.files("Lua compiler", "luac", ["-p"], self.repository.suffix(".lua"));
        var shellLint = ["--severity=error", "--shell=bash"]; for path in shell { shellLint.push(path); }
        self.run("ShellCheck", "shellcheck", shellLint);
        self.run("GitHub workflows", "actionlint", []);
        for path in self.repository.suffix(".json") {
            if (JSONValue.readFile(PathTools.join(self.repository.root, path)).isError()) { print(f"Invalid JSON: {path}"); self.failures.push(path); }
        }
        self.files("TOML parser", "taplo", ["check"], self.repository.suffix(".toml"));
        self.files("YAML parser", "yq", ["eval", "."], self.repository.suffix(".yaml"));
        self.files("YAML parser", "yq", ["eval", "."], self.repository.suffix(".yml"));
        self.phase("Nix language server");
        self.lsp("nixd", "nix", nix); self.builtinRegression("nixd");
        self.phase("BTRC language server");
        self.lspTogether("btrc-lsp", "btrc", self.workers() / 2);
        if (full) {
            self.phase("native programs and unit suites (make)");
            self.run("Native programs and unit suites", "make", ["build", "unit"]);
            self.phase("contract and native derivations (nix-build)");
            // The unit suites that are flake checks are built by ci/checks.sh, not here.
            self.run("CI contracts, sleep helpers, gaming suites and native compilation", "nix-build", ["tests/ci", "tests/sleep-lock/helpers", "tests/gaming", "ci/native.nix", "--no-out-link"]);
            var coverage = ChildProcess.run("nix", ["eval", "--json", "--impure", "--expr", "(import ./ci/native.nix {}).coveredSources"], cwd=self.repository.root);
            var covered = JSONValue.parse(coverage.stdout());
            Vector<string> actual = self.repository.suffix(".c"); for path in self.repository.suffix(".h") { actual.push(path); }
            Vector<string> declared = []; for entry in covered.elements() { declared.push(entry.asString()); }
            if (!coverage.ok() || !covered.isArray() || !actual.sorted().join("\n").equals(declared.sorted().join("\n"))) { self.failures.push("Native source coverage"); print("Native C/header inventory does not match ci/native.nix"); }
            var outputs = ChildProcess.run("nix", ["eval", "--json", "--impure", "--expr", "import ./ci/outputs.nix (builtins.getFlake (\"git+file://\" + toString ./. + \"?shallow=1\"))"], cwd=self.repository.root);  // the git fetcher: a path copy trips on a socket under .git
            var attributes = JSONValue.parse(outputs.stdout());
            if (!outputs.ok() || !attributes.isArray()) { self.failures.push("Flake outputs"); print("Cannot list flake outputs:\n" + outputs.stderr()); }
            else {  // one evaluator each bounds memory, four at a time
                self.phase("flake outputs");
                var directory = PathTools.join(self.repository.root, "build/lint");
                Vector<string> names = [];
                Vector<string> lines = [];
                Vector<string> logs = [];
                for attribute in attributes.elements() {
                    var log = PathTools.join(directory, f"flake-output-{names.length}.log");
                    names.push(attribute.asString());
                    lines.push(f"exec {Checks.words(["nix", "eval", ".#" + attribute.asString()])} > /dev/null 2> {ShellWords.quote(log)} < /dev/null");
                    logs.push(log);
                }
                print(f"\nFlake outputs: {names.length} evaluations");
                var failed = self.together(lines, 4);
                for (int index = 0; index < names.length; index++) {
                    if (failed.contains(index)) { self.failures.push("Flake output " + names.get(index)); print(names.get(index) + ":\n" + self.head(logs.get(index))); }
                    else { FileSystem.removeIfExists(logs.get(index)); }
                }
            }
        }
        self.phase("");
        print("\nTime in each phase:");
        for timing in self.timings { print("  " + timing); }
        if (!self.failures.isEmpty()) { print("Failed checks: " + self.failures.join(", ")); return 1; }
        print("All compiler and workspace error checks passed."); return 0;
    }
}
