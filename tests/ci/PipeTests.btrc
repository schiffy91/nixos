import Library.Bytes;
import Library.CLI;
import Library.Process;
import Library.Strings;
import Library.Testing;
import Library.Timer;
import ./ProcessProbe.btrc;

int main(int argc, char** argv) {
    var args = CLIArgs(argc, argv);
    if (args.count() == 2 && args.get(0) == "--check-fd") {
        return ProcessProbe.descriptorClosed(Strings.toInt(args.get(1))) ? 0 : 1;
    }
    ProcessProbe.ignoreBrokenPipe();
    var child = PipeProcess("cat", []);
    var bytes = Bytes();
    bytes.append(0); bytes.append(10); bytes.append(13); bytes.append(255);
    child.write(bytes, MonotonicClock.deadlineAfter(1000));
    child.closeInput();
    var read = child.read(MonotonicClock.deadlineAfter(1000));
    if (read == null) { throw "Child returned no bytes"; }
    Expect.bytesEq(read, bytes);
    Expect.isTrue(child.read(MonotonicClock.deadlineAfter(1000)) == null);
    Expect.intEq(child.wait(MonotonicClock.deadlineAfter(1000)), 0);
    Expect.throws(() => { var missing = PipeProcess("/definitely/missing/ci-command", []); });
    var silent = PipeProcess("sleep", ["10"]);
    bool failed = false;
    try { silent.read(MonotonicClock.deadlineAfter(20)); }
    catch (string error) { failed = true; }
    Expect.isTrue(failed);
    silent.close();
    int privateDescriptor = ProcessProbe.openPrivateDescriptor();
    Expect.isTrue(privateDescriptor >= 3);
    try {
        var isolated = PipeProcess(args.program, ["--check-fd", f"{privateDescriptor}"]);
        isolated.closeInput();
        Expect.isTrue(isolated.read(MonotonicClock.deadlineAfter(1000)) == null);
        Expect.intEq(isolated.wait(MonotonicClock.deadlineAfter(1000)), 0);
    } finally {
        ProcessProbe.closeDescriptor(privateDescriptor);
    }
    print("PASS: child pipes, EOF, exit, spawn failure, deadlines and descriptor isolation");
    return 0;
}
