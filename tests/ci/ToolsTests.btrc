import Library.Testing;
import ci.lib.Checks;
import ci.lib.Lsp;
import ci.lib.Repository;
import ci.lib.Publisher;

int main() {
    var message = JSONValue.parse("{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":\"é雪\"}");
    var encoded = LspFrames.encode(message);
    var frames = LspFrames();
    for (int i = 0; i < encoded.length - 1; i++) {
        frames.append(encoded.slice(i, i + 1));
        Expect.isTrue(frames.take() == null);
    }
    frames.append(encoded.slice(encoded.length - 1, encoded.length));
    var decoded = frames.take();
    if (decoded == null) { throw "Fragmented LSP message was lost"; }
    Expect.strEq(decoded.get("result").asString(), "é雪");
    frames.append(encoded); frames.append(encoded);
    Expect.isTrue(frames.take() != null && frames.take() != null && frames.take() == null);
    for invalid in ["Content-Length: -1\r\n\r\n", "Content-Length: 4294967296\r\n\r\n", "Content-Length: 2\r\nContent-Length: 2\r\n\r\n{}", "Content-Length: 2\r\n\r\nxx"] {
        bool rejected = false;
        try { var bad = LspFrames(); bad.append(Bytes.fromString(invalid)); bad.take(); }
        catch (string error) { rejected = true; }
        Expect.isTrue(rejected);
    }
    var names = Bytes.fromString("path with spaces"); names.append(0);
    names.appendBytes(Bytes.fromString("line\nbreak")); names.append(0);
    names.appendBytes(Bytes.fromString("path with spaces")); names.append(0);
    var paths = Repository.paths(names);
    Expect.intEq(paths.length, 2);
    Expect.isTrue(paths.contains("line\nbreak") && paths.contains("path with spaces"));
    Expect.strEq(LspSession.uri("/tmp/a b#é"), "file:///tmp/a%20b%23%C3%A9");
    var targets = JSONValue.parse("{\"systems\":[{\"system\":\"x86_64-linux\",\"attrs\":[\"installer\"]}],\"local\":[\"desktop\",\"deck\"]}");
    Expect.strEq(CachePublisher.attributes(targets, "x86_64-linux", false).join(","), "installer");
    Expect.isTrue(CachePublisher.attributes(targets, "aarch64-linux", false).isEmpty());
    Expect.strEq(CachePublisher.attributes(targets, "aarch64-linux", true).join(","), "desktop,deck");

    var cleanSource = "// #include <stdio.h> in comment\n/* struct Foo in block comment */\nclass Sample {\n    public int mode = 0o755;\n    public void run(Bytes data) {\n        self.data = data;\n        reply.data(data);\n        var msg = f\"chmod 0644 {self.name(\"struct NULL\")} Values.data\";\n    }\n}\n";
    Expect.isTrue(Checks.boundaryViolations("Sample.btrc", cleanSource).isEmpty());

    var leakySource = "#include <unistd.h>\nstruct Leaky { int fd; };\nvoid bad() {\n    void* p = malloc(16);\n    if (p == NULL) { return; }\n    int m = 0755;\n    var raw = buf.data;\n}\n";
    var violations = Checks.boundaryViolations("Leaky.btrc", leakySource);
    Expect.intEq(violations.length, 6);
    Expect.contains(violations.get(0), "Leaky.btrc:1: raw C preprocessor directive");
    Expect.contains(violations.get(1), "Leaky.btrc:2: raw C token 'struct'");
    Expect.contains(violations.get(2), "Leaky.btrc:4: raw C call 'malloc(...)'");
    Expect.contains(violations.get(3), "Leaky.btrc:5: raw C token 'NULL'");
    Expect.contains(violations.get(4), "Leaky.btrc:6: legacy C octal literal");
    Expect.contains(violations.get(5), "Leaky.btrc:7: raw .data backing pointer access");

    print("PASS: fragmented/coalesced UTF-8 LSP framing, malformed frame rejection, Git path boundaries, cache target selection and BTRC native boundary checks");
    return 0;
}
