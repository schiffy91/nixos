import networking.TrustedConnections;

#include <assert.h>

JSONValue address(string device = "wlan0", string local = "192.168.50.52", int prefix = 24, string family = "inet", string scope = "global") {
    return JSONValue.parse(f"[{{\"ifname\":\"{device}\",\"addr_info\":[{{\"family\":\"{family}\",\"local\":\"{local}\",\"prefixlen\":{prefix},\"scope\":\"{scope}\"}}]}}]");
}

int main() {
    var ports = JSONValue.parse("{\"tcp\":[22,47990,22],\"udp\":[5353]}");
    var rules = TrustedRules.forAddresses(address(), [], ports, []);
    assert(rules.ipv4.len == 0 && rules.ipv6.len == 0);
    assert(TrustedRules.forAddresses(JSONValue.parse("[]"), ["wlan0"], ports, []).ipv4.len == 0);
    assert(TrustedRules.forAddresses(address(), ["wlan0"], ports, ["wlan0"]).ipv4.len == 0);
    rules = TrustedRules.forAddresses(address(), ["wlan0"], ports, []);
    assert(rules.ipv4.len == 3 && rules.ipv6.len == 0);
    assert(rules.ipv4.get(0).equals("-A nixos-trusted -i wlan0 -s 192.168.50.0/24 -p tcp --dport 22 -j nixos-fw-accept"));
    assert(rules.ipv4.get(1).contains("--dport 47990"));
    assert(rules.ipv4.get(2).contains("-p udp --dport 5353"));
    rules = TrustedRules.forAddresses(address(local="10.42.16.80", prefix=20), ["wlan0"], ports, []);
    for rule in rules.ipv4 { assert(rule.contains("-s 10.42.16.0/20 ")); }
    var transaction = TrustedRules.restore(rules.ipv4);
    assert(transaction.startsWith("*filter\n:nixos-trusted - [0:0]\n-F nixos-trusted\n"));
    assert(transaction.endsWith("COMMIT\n") && !transaction.contains("192.168.50"));
    rules = TrustedRules.forAddresses(address(local="fd00:1234::52", prefix=64, family="inet6"), ["wlan0"], ports, []);
    assert(rules.ipv4.len == 0 && rules.ipv6.len == 3);
    for rule in rules.ipv6 { assert(rule.contains("-s fd00:1234::/64 ")); }
    assert(TrustedRules.forAddresses(address(local="fe80::52", prefix=64, family="inet6", scope="link"), ["wlan0"], ports, []).ipv6.len == 0);
    for prefix in [-1, 0, 33] { assert(TrustedRules.forAddresses(address(prefix=prefix), ["wlan0"], ports, []).ipv4.len == 0); }
    assert(TrustedRules.forAddresses(address(device="wlan0 -j ACCEPT"), ["wlan0 -j ACCEPT"], ports, []).ipv4.len == 0);
    assert(TrustedRules.forAddresses(address(device="wlan+"), ["wlan+"], ports, []).ipv4.len == 0);
    assert(TrustedRules.forAddresses(address(local="not-an-address"), ["wlan0"], ports, []).ipv4.len == 0);
    assert(TrustedRules.forAddresses(address(local="fd00::1"), ["wlan0"], ports, []).ipv4.len == 0);
    var rejected = false;
    try { TrustedRules.forAddresses(JSONValue.parse("{}"), ["wlan0"], ports, []); } catch (string error) { rejected = true; }
    assert(rejected);
    rejected = false;
    try { TrustedRules.forAddresses(address(), ["wlan0"], JSONValue.parse("{\"tcp\":[0]}"), []); } catch (string error) { rejected = true; }
    assert(rejected);
    print("PASS: trusted profile, subnet, IPv6, exclusion, malformed inventory and atomic firewall rules");
    return 0;
}
