import Library.Testing;
import networking.TrustedConnections;
import networking.NetworkPrefix;

JSONValue address(string device = "wlan0", string local = "192.168.50.52", int prefix = 24, string family = "inet", string scope = "global") {
    return JSONValue.parse(f"[{{\"ifname\":\"{device}\",\"addr_info\":[{{\"family\":\"{family}\",\"local\":\"{local}\",\"prefixlen\":{prefix},\"scope\":\"{scope}\"}}]}}]");
}

int main() {
    var subnet = NetworkPrefix.fromAddress(address(local="192.168.50.255", prefix=25).at(0).get("addr_info").at(0));
    if (subnet == null) { throw "Expected a global network prefix"; }
    Expect.strEq(subnet.cidr(), "192.168.50.128/25");
    subnet = NetworkPrefix.fromAddress(address(local="fd00:1234:5678:9abc:ffff::52", prefix=73, family="inet6").at(0).get("addr_info").at(0));
    if (subnet == null) { throw "Expected a global network prefix"; }
    Expect.strEq(subnet.cidr(), "fd00:1234:5678:9abc:ff80::/73");
    for invalid in [address(local="::1", prefix=129, family="inet6"), address(local="::1", prefix=0, family="inet6"), address(family="unknown")] {
        Expect.isTrue(NetworkPrefix.fromAddress(invalid.at(0).get("addr_info").at(0)) == null);
    }
    var ports = JSONValue.parse("{\"tcp\":[22,47990,22],\"udp\":[5353]}");
    var rules = TrustedRules.forAddresses(address(), [], ports, []);
    Expect.isTrue(rules.ipv4.length == 0 && rules.ipv6.length == 0);
    Expect.intEq(TrustedRules.forAddresses(JSONValue.parse("[]"), ["wlan0"], ports, []).ipv4.length, 0);
    Expect.intEq(TrustedRules.forAddresses(address(), ["wlan0"], ports, ["wlan0"]).ipv4.length, 0);
    rules = TrustedRules.forAddresses(address(), ["wlan0"], ports, []);
    Expect.isTrue(rules.ipv4.length == 3 && rules.ipv6.length == 0);
    Expect.strEq(rules.ipv4.get(0), "-A nixos-trusted -i wlan0 -s 192.168.50.0/24 -p tcp --dport 22 -j nixos-fw-accept");
    Expect.contains(rules.ipv4.get(1), "--dport 47990");
    Expect.contains(rules.ipv4.get(2), "-p udp --dport 5353");
    rules = TrustedRules.forAddresses(address(local="10.42.16.80", prefix=20), ["wlan0"], ports, []);
    for rule in rules.ipv4 { Expect.contains(rule, "-s 10.42.16.0/20 "); }
    var transaction = TrustedRules.restore(rules.ipv4);
    Expect.startsWith(transaction, "*filter\n:nixos-trusted - [0:0]\n-F nixos-trusted\n");
    Expect.endsWith(transaction, "COMMIT\n");
    Expect.notContains(transaction, "192.168.50");
    rules = TrustedRules.forAddresses(address(local="fd00:1234::52", prefix=64, family="inet6"), ["wlan0"], ports, []);
    Expect.isTrue(rules.ipv4.length == 0 && rules.ipv6.length == 3);
    for rule in rules.ipv6 { Expect.contains(rule, "-s fd00:1234::/64 "); }
    Expect.intEq(TrustedRules.forAddresses(address(local="fe80::52", prefix=64, family="inet6", scope="link"), ["wlan0"], ports, []).ipv6.length, 0);
    for prefix in [-1, 0, 33] { Expect.intEq(TrustedRules.forAddresses(address(prefix=prefix), ["wlan0"], ports, []).ipv4.length, 0); }
    Expect.intEq(TrustedRules.forAddresses(address(device="wlan0 -j ACCEPT"), ["wlan0 -j ACCEPT"], ports, []).ipv4.length, 0);
    Expect.intEq(TrustedRules.forAddresses(address(device="wlan+"), ["wlan+"], ports, []).ipv4.length, 0);
    Expect.intEq(TrustedRules.forAddresses(address(local="not-an-address"), ["wlan0"], ports, []).ipv4.length, 0);
    Expect.intEq(TrustedRules.forAddresses(address(local="fd00::1"), ["wlan0"], ports, []).ipv4.length, 0);
    var rejected = false;
    try { TrustedRules.forAddresses(JSONValue.parse("{}"), ["wlan0"], ports, []); } catch (string error) { rejected = true; }
    Expect.isTrue(rejected);
    rejected = false;
    try { TrustedRules.forAddresses(address(), ["wlan0"], JSONValue.parse("{\"tcp\":[0]}"), []); } catch (string error) { rejected = true; }
    Expect.isTrue(rejected);

    // Trust policy: UUID defaults, WPA2/WPA3 SSID defaults, evil-twin rejection, and runtime zone overrides.
    Vector<string> uuids = ["11111111-1111-4111-8111-111111111111"];
    Vector<string> wifi = ["schi-fi", "🐻"];
    var uuidDefault = ConnectionInfo("11111111-1111-4111-8111-111111111111", "home-eth", "802-3-ethernet", "");
    Expect.isTrue(uuidDefault.isTrusted(uuids, wifi));
    Expect.strEq(uuidDefault.statusLabel(uuids, wifi), "home-eth (trusted, default)");
    Expect.strEq(uuidDefault.targetZone(false, uuids, wifi), "untrusted");
    Expect.strEq(uuidDefault.targetZone(true, uuids, wifi), "");

    var wpa3Wifi = ConnectionInfo("aaaa", "🐻", "802-11-wireless", "", "🐻", "sae");
    Expect.isTrue(wpa3Wifi.isTrusted(uuids, wifi));
    Expect.strEq(wpa3Wifi.statusLabel(uuids, wifi), "🐻 (trusted, default)");
    var wpa2Wifi = ConnectionInfo("bbbb", "schi-fi", "802-11-wireless", "", "schi-fi", "wpa-psk");
    Expect.isTrue(wpa2Wifi.isTrusted(uuids, wifi));

    // Open, WEP, and WPA-EAP networks sharing an SSID must not trigger SSID-based auto-trust.
    var openSpoof = ConnectionInfo("cccc", "🐻", "802-11-wireless", "", "🐻", "");
    Expect.isFalse(openSpoof.isTrusted(uuids, wifi));
    var eapSpoof = ConnectionInfo("dddd", "schi-fi", "802-11-wireless", "", "schi-fi", "wpa-eap");
    Expect.isFalse(eapSpoof.isTrusted(uuids, wifi));
    var ethSameName = ConnectionInfo("eeee", "🐻", "802-3-ethernet", "", "🐻", "sae");
    Expect.isFalse(ethSameName.isTrusted(uuids, wifi));

    // Runtime zone trust and untrust override.
    var hotel = ConnectionInfo("ffff", "HotelWiFi", "802-11-wireless", "", "HotelWiFi", "wpa-psk");
    Expect.isFalse(hotel.isTrusted(uuids, wifi));
    Expect.strEq(hotel.statusLabel(uuids, wifi), "HotelWiFi (untrusted)");
    Expect.strEq(hotel.targetZone(true, uuids, wifi), "trusted");
    hotel.zone = "trusted";
    Expect.isTrue(hotel.isTrusted(uuids, wifi));
    Expect.strEq(hotel.statusLabel(uuids, wifi), "HotelWiFi (trusted)");
    Expect.strEq(hotel.targetZone(false, uuids, wifi), "");

    wpa3Wifi.zone = "untrusted";
    Expect.isFalse(wpa3Wifi.isTrusted(uuids, wifi));
    Expect.strEq(wpa3Wifi.statusLabel(uuids, wifi), "🐻 (untrusted, override)");
    Expect.strEq(wpa3Wifi.targetZone(true, uuids, wifi), "");

    print("PASS: trusted profile, Wi-Fi auth, runtime overrides, subnet, IPv6, exclusion, malformed inventory and atomic firewall rules");
    return 0;
}
