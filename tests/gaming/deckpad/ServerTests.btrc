import Library.Bytes;
import Library.CLI;
import Library.Crypto;
import Library.FileSystem;
import Library.Process;
import Library.Strings;
import Library.Testing;
import Library.Timer;
import Library.USB.USBDescriptors;
import Library.USB.USBIP;
import Library.Vector;
import deckpad.Control;
import deckpad.Host;
import deckpad.PadState;
import deckpad.Protocol;
import deckpad.SteamController;
import deckpad.Wire;

// A host as the PC is one, but with the USB/IP host in this program instead
// of the kernel: the same pairing, the same encrypted tunnel, and transfers
// this test can make one at a time.
class TestHost {
    public ControllerHost machine;
    public TrustedKeys trusted;
    private ControllerTunnel? tunnel = null;
    private USBIPHost? transfers = null;

    public TestHost(string label, int port) {
        self.trusted = TrustedKeys("");
        self.machine = ControllerHost("127.0.0.1", port, SigningKey.generate(), self.trusted, label);
    }

    // What the controller answers when this host asks to attach; empty when it lets it.
    public string refusal() {
        try { self.machine.connect().close(); } catch (string error) { return error; }
        return "";
    }

    public string pairingRefusal() {
        try { self.machine.pair(true); } catch (string error) { return error; }
        return "";
    }

    public USBIPHost attach() {
        ControllerTunnel tunnel = ControllerTunnel.open(self.machine.connect());
        USBIPHost transfers = USBIPHost(tunnel.plain(), 5000);
        USBIPDevice device = transfers.importDevice("1-1");
        Expect.isTrue(device.vendor == STEAM_VENDOR && device.product == STEAM_PRODUCT && device.deviceId == NetworkProtocol.deviceId());
        self.tunnel = tunnel;
        self.transfers = transfers;
        return transfers;
    }

    public void leave() {
        ControllerTunnel? tunnel = self.tunnel;
        if (tunnel != null) { tunnel.close(); }
        self.tunnel = null;
        self.transfers = null;
    }
}

class DeckpadServerTests {
    class string control(string method, string target, string body, int port, string runtime) { return ControlClient.request(method, target, body, port, runtime + "/token"); }

    class void enumeration(USBIPHost host) {
        Bytes device = Bytes();
        Expect.isTrue(host.controlIn(USBSetup(0x80, USB_REQUEST_GET_DESCRIPTOR, 0x0100, 0, 18), device) == 18 && Wire.u16le(device, 8) == STEAM_VENDOR);
        Bytes configuration = Bytes();
        Expect.isTrue(host.controlIn(USBSetup(0x80, USB_REQUEST_GET_DESCRIPTOR, 0x0200, 0, 255), configuration) == 41 && configuration.get(14) == 3);
        Expect.intEq(host.controlIn(USBSetup(0x81, USB_REQUEST_GET_DESCRIPTOR, 0x2200, 0, 512), Bytes()), 143);
        Expect.isTrue(host.controlIn(USBSetup(0x80, USB_REQUEST_GET_DESCRIPTOR, 0x0600, 0, 10), Bytes()) < 0);
        Expect.intEq(host.controlOut(USBSetup(0x00, USB_REQUEST_SET_CONFIGURATION, 1, 0, 0), Bytes()), 0);
        Bytes raw = Wire.zeros(64);
        raw.set(0, STEAM_REPORT_FEATURE);
        raw.set(1, STEAM_GET_STRING);
        raw.set(2, 0x15);
        raw.set(3, 1);
        Expect.intEq(host.controlOut(USBSetup(0x21, 0x09, 0x0301, 0, 64), raw), 64);
        Bytes serial = Bytes();
        Expect.isTrue(host.controlIn(USBSetup(0xA1, 0x01, 0x0301, 0, 64), serial) == 64 && serial.get(1) == STEAM_GET_STRING && serial.get(4) == 'F' && serial.get(15) == '7');
    }

    // Reports arrive at the pad's pace, in order, and soon after they were
    // made: each carries the time it was encoded, on this machine's clock.
    class void reports(USBIPHost host) {
        int states = 0;
        int last = -1;
        bool pressed = false;
        bool released = false;
        bool battery = false;
        long long slowest = 0LL;
        long long total = 0LL;
        long long deadline = MonotonicClock.deadlineAfter(1500LL);
        while (MonotonicClock.before(deadline)) {
            Bytes report = Bytes();
            int length = host.transferIn(1, 64, report);
            Expect.isTrue(length > 0);
            if (report.get(0) == STEAM_REPORT_BATTERY) { battery = length == 15; continue; }
            Expect.isTrue(report.get(0) == STEAM_REPORT_STATE && length == 54);
            if (last >= 0) { Expect.intEq(report.get(1), (last + 1) & 0xFF); }
            last = report.get(1);
            if ((Wire.u16le(report, 2) & PAD_A) != 0) { pressed = true; } else { released = true; }
            long long age = ((MonotonicClock.nanoseconds() / 1000LL) & 0xFFFFFFFFLL) - Wire.u32le(report, 30);
            if (age < 0LL) { age += 0x100000000LL; }
            if (age > slowest) { slowest = age; }
            total += age;
            states++;
        }
        Expect.isTrue(states >= 150);
        Expect.isTrue(pressed && released && battery);
        Expect.isTrue(total / (long long)states < 10000LL && slowest < 100000LL);
    }

    class void outputs(USBIPHost host) {
        Bytes rumble = Bytes();
        rumble.append(STEAM_OUT_RUMBLE);
        for (int index = 0; index < 9; index++) { rumble.append(index == 3 ? 0x34 : (index == 4 ? 0x12 : 0)); }
        Expect.intEq(host.transferOut(1, rumble), 10);
        // A driver that stops polling cancels its waiting request. Whether
        // the request or its report wins that race, the export must answer
        // in turn (cancelIn throws otherwise) and stay in step afterwards.
        host.cancelIn(1, 64);
        Bytes next = Bytes();
        Expect.isTrue(host.transferIn(1, 64, next) > 0 && (next.get(0) == STEAM_REPORT_STATE || next.get(0) == STEAM_REPORT_BATTERY));
        Bytes feature = Bytes();
        Expect.isTrue(host.controlIn(USBSetup(0xA1, 0x01, 0x0301, 0, 64), feature) == 64 && feature.get(0) == STEAM_REPORT_FEATURE);
    }

    // Wait for the service to say nobody holds the controller.
    class bool unheld(int controlPort, string runtime) {
        long long deadline = MonotonicClock.deadlineAfter(5000LL);
        while (!DeckpadServerTests.control("GET", "/status", "", controlPort, runtime).contains("\"holder\": \"\"")) {
            if (!MonotonicClock.before(deadline)) { return false; }
            Timer.sleepMillis(20);
        }
        return true;
    }

    class void scenario(int port, int controlPort, string runtime) {
        var desk = TestHost("the desk", port);
        var stranger = TestHost("a stranger", port);
        string status = DeckpadServerTests.control("GET", "/status", "", controlPort, runtime);
        Expect.isTrue(status.contains("\"name\": \"network\"") && status.contains("listening on 127.0.0.1") && status.contains("\"open\": false") && status.contains("\"trusted\": []"));

        // Pairing: refused while the window is shut, then granted, then remembered.
        Expect.isTrue(desk.pairingRefusal().contains("not paired") && desk.trusted.count() == 0);
        Expect.contains(desk.refusal(), "not a paired controller");
        Expect.contains(DeckpadServerTests.control("POST", "/pairing/open?seconds=30", "", controlPort, runtime), "open for 30");
        Expect.isTrue(desk.pairingRefusal().isEmpty() && desk.trusted.count() == 1);
        status = DeckpadServerTests.control("GET", "/status", "", controlPort, runtime);
        Expect.isTrue(status.contains("\"label\": \"the desk\"") && status.contains("\"host\": \"the desk\"") && !status.contains("\"code\": \"\""));
        Expect.contains(DeckpadServerTests.control("POST", "/pairing/close", "", controlPort, runtime), "closed");

        // A host that knows the controller's key but never paired is refused.
        for entry in desk.trusted.list() { stranger.trusted.add(entry.key, "the controller"); }
        Expect.contains(stranger.refusal(), "not paired");

        // The paired host attaches through the encrypted tunnel.
        USBIPHost host = desk.attach();
        DeckpadServerTests.enumeration(host);
        DeckpadServerTests.reports(host);
        DeckpadServerTests.outputs(host);
        status = DeckpadServerTests.control("GET", "/status", "", controlPort, runtime);
        Expect.isTrue(status.contains("\"holder\": \"network\"") && status.contains("attached to the desk"));
        var second = TestHost("the desk again", port);
        for entry in desk.trusted.list() { second.trusted.add(entry.key, "the controller"); }
        Expect.isFalse(second.refusal().isEmpty());

        // The host leaves and comes back: the controller is unheld in between.
        desk.leave();
        Expect.isTrue(DeckpadServerTests.unheld(controlPort, runtime));
        USBIPHost returning = desk.attach();
        DeckpadServerTests.reports(returning);
        desk.leave();
        Expect.isTrue(DeckpadServerTests.unheld(controlPort, runtime));

        // Forgetting the host shuts it out again.
        string fingerprint = "";
        for part in Strings.split(DeckpadServerTests.control("GET", "/status", "", controlPort, runtime), "\"") {
            if (part.startsWith("SHA256:")) { fingerprint = part; }
        }
        Expect.contains(DeckpadServerTests.control("POST", "/forget?fingerprint=" + fingerprint.replace("+", "%2B"), "", controlPort, runtime), "forgotten");
        Expect.contains(desk.refusal(), "not paired");

        // The control interface asks for its token.
        bool refused = false;
        string forged = runtime + "/forged";
        Path.writeAll(forged, "not-the-token\n");
        try { ControlClient.request("GET", "/status", "", controlPort, forged); } catch (string error) { refused = error.contains("token"); }
        Expect.isTrue(refused);
    }

    class void run(string program, int port, int controlPort) {
        var dir = TestDir("deckpad-server");
        string directory = dir.path;
        var server = BackgroundProcess.start(program, ["serve", "--source", "demo", "--listen", "127.0.0.1", "--port", f"{port}", "--control-port", f"{controlPort}",
            "--state", directory + "/state", "--runtime", directory + "/run", "--serial", "FXDK00000007"]);
        long long deadline = MonotonicClock.deadlineAfter(5000LL);
        while (!FileSystem.isFile(directory + "/run/token") && MonotonicClock.before(deadline)) { Timer.sleepMillis(20); }
        try { DeckpadServerTests.scenario(port, controlPort, directory + "/run"); } catch (string error) {
            server.stop();
            throw error;
        }
        server.stop();
        Expect.intEq(server.code(), 0);
        Expect.isFalse(FileSystem.exists(directory + "/run/token"));
    }
}

int main(int argc, char** argv) {
    var args = CLIArgs(argc, argv);
    Expect.intEq(args.count(), 1);
    DeckpadServerTests.run(args.get(0), 32417, 32418);
    print("PASS: deckpad pairing, encrypted attach, enumeration, reports, latency, outputs, reconnection and forgetting over localhost");
    return 0;
}
