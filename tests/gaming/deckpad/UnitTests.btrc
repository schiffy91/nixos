#include <poll.h>

// A link whose host comes and goes when the test says so.
class SwitchedLink implements IControllerLink {
    public bool host = false;
    public bool broken;
    public bool opened = false;
    private string label;
    private ControllerPort gate;

    public SwitchedLink(string label, VirtualController controller, bool broken) {
        self.label = label;
        self.gate = ControllerPort(controller);
        self.broken = broken;
    }

    public string name() { return self.label; }

    public void open() {
        if (self.broken) { throw "not on this machine"; }
        self.opened = true;
    }

    public int watch(struct pollfd* descriptors, int capacity) { return 0; }

    public void step() {}

    public bool attached() { return self.host; }

    public ControllerPort port() { return self.gate; }

    public string status() { return self.host ? "attached" : "waiting"; }

    public void close() { self.opened = false; }
}

// A controller whose ... button never lets go.
class HeldPad implements IPadSource {
    public bool opened = false;

    public void open() { self.opened = true; }

    public bool read(struct PadState* state, int timeoutMilliseconds) {
        Timer.sleepMillis(4);
        memset(state, 0, sizeof(struct PadState));
        state->buttons = PAD_QUICK_ACCESS | PAD_B;
        return true;
    }

    public void command(struct PadCommand* command) {}
    public void close() { self.opened = false; }
}

class DeckpadUnitTests {
    class void deckSample(unsigned char* report) {
        memset(report, 0, (size_t)64);
        report[0] = (unsigned char)0x01; report[2] = (unsigned char)0x09; report[3] = (unsigned char)0x40;
        report[8] = (unsigned char)0x80;   // A
        report[9] = (unsigned char)0x80;   // L5
        report[10] = (unsigned char)0x08;  // left pad touched
        report[11] = (unsigned char)0x04;  // right stick click
        report[13] = (unsigned char)0x02;  // L4
        report[14] = (unsigned char)0x04;  // quick access
        Wire.putU16le(report, 16, 1000); Wire.putU16le(report, 18, -2000);
        Wire.putU16le(report, 28, 16384); Wire.putU16le(report, 30, -5);
        Wire.putU16le(report, 44, 12345); Wire.putU16le(report, 46, 40000);
        Wire.putU16le(report, 48, -32768); Wire.putU16le(report, 50, 32767);
        Wire.putU16le(report, 52, 100); Wire.putU16le(report, 54, -100);
        Wire.putU16le(report, 56, 500); Wire.putU16le(report, 58, 600);
    }

    class void deckReport() {
        unsigned char report[64];
        struct PadState state;
        DeckpadUnitTests.deckSample(report);
        Check.that(DeckReport.parse(report, 64, &state), "Deck state report parses");
        Check.that(state.buttons == (PAD_A | PAD_L5 | PAD_LEFT_PAD_TOUCH | PAD_RIGHT_STICK | PAD_L4 | PAD_QUICK_ACCESS), "Deck buttons map to controller bits");
        Check.that(state.leftPadX == 1000 && state.leftPadY == -2000 && state.accelZ == 16384 && state.gyroX == -5, "pads and IMU keep Deck units");
        Check.that(state.leftTrigger == 12345 && state.rightTrigger == 32767, "triggers clamp to the controller range");
        Check.that(state.leftStickX == -32767 && state.leftStickY == 32767 && state.rightStickX == 100 && state.rightStickY == -100, "sticks clamp symmetrically");
        Check.that(state.leftPadPressure == 500 && state.rightPadPressure == 600, "pad pressure");
        Check.that(!DeckReport.parse(report, 40, &state), "short report rejected");
        report[2] = (unsigned char)0x04;
        Check.that(!DeckReport.parse(report, 64, &state), "non-state report rejected");
    }

    class void stateReport() {
        unsigned char report[64];
        unsigned char out[64];
        struct PadState state;
        DeckpadUnitTests.deckSample(report);
        DeckReport.parse(report, 64, &state);
        var controller = SteamController("FXDK00000042");
        Check.that(controller.encodeState(&state, 0x01020304LL, out) == 54 && (int)out[0] == 0x42 && (int)out[1] == 0, "wired state report is 54 bytes");
        Check.that(Wire.u16le(out, 2) == (state.buttons & 0xFFFF) && Wire.u16le(out, 4) == (state.buttons >> 16), "buttons at offset 2");
        Check.that(Wire.u16le(out, 6) == 12345 && Wire.u16le(out, 8) == 32767, "triggers at 6 and 8");
        Check.that(Wire.s16le(out, 10) == -32767 && Wire.s16le(out, 12) == 32767 && Wire.s16le(out, 14) == 100 && Wire.s16le(out, 16) == -100, "sticks at 10..17");
        Check.that(Wire.s16le(out, 18) == 1000 && Wire.s16le(out, 20) == -2000 && Wire.u16le(out, 22) == 500 && Wire.u16le(out, 28) == 600, "pads at 18..29");
        Check.that((int)out[30] == 0x04 && (int)out[33] == 0x01, "IMU timestamp at 30");
        Check.that(Wire.s16le(out, 38) == 16384 && Wire.s16le(out, 40) == -5, "IMU at 34..45");
        controller.encodeState(&state, 0LL, out);
        Check.that((int)out[1] == 1, "sequence number advances");
        Check.that(controller.encodeBattery(87, true, out) == 15 && (int)out[0] == 0x43 && (int)out[1] == 2 && (int)out[2] == 87, "battery report");
        Check.that(controller.encodeBattery(100, true, out) == 15 && (int)out[1] == 4, "full battery state");
    }

    class void latch() {
        struct PadState state;
        struct PadState taken;
        var latch = PadLatch();
        Check.that(!latch.pending(), "nothing pending at start");
        memset(&state, 0, sizeof(state));
        state.buttons = PAD_A | PAD_LEFT_PAD_TOUCH;
        latch.update(&state);
        state.buttons = 0;
        latch.update(&state);
        latch.take(&taken);
        Check.that(taken.buttons == PAD_A, "a tap survives until sent; a lifted touch does not");
        Check.that(!latch.pending(), "taken state is no longer pending");
        latch.update(&state);
        latch.take(&taken);
        Check.that(taken.buttons == 0, "latched press is sent once");
    }

    class void descriptors() {
        unsigned char out[256];
        var controller = SteamController("FXDK00000042");
        int length = controller.reportDescriptor(out);
        Check.that(length == 143 && (int)out[0] == 0x06 && (int)out[2] == 0xFF && (int)out[length - 1] == 0xC0, "vendor report descriptor");
        Check.that((int)out[15] == 0x42 && (int)out[19] == 53, "state report is 53 bytes after its ID");
        Check.that((int)out[length - 8] == 0x01 && (int)out[length - 4] == 63 && (int)out[length - 3] == 0xB1, "feature report 1 is 63 bytes, as hid-steam requires");
        Check.that(controller.vendor() == 0x28DE && controller.product() == 0x1302 && controller.serial().equals("FXDK00000042"), "Steam Controller identity");
    }

    class void command(unsigned char* out, int identifier, int length) {
        memset(out, 0, (size_t)64);
        out[0] = (unsigned char)STEAM_REPORT_FEATURE; out[1] = (unsigned char)identifier; out[2] = (unsigned char)length;
    }

    class void features() {
        unsigned char request[64];
        unsigned char reply[64];
        var controller = SteamController("FXDK00000042");
        DeckpadUnitTests.command(request, STEAM_GET_STRING, 0x15);
        request[3] = (unsigned char)1;
        controller.setFeature(request, 64);
        Check.that(controller.getFeature(reply) == 64 && (int)reply[1] == STEAM_GET_STRING && (int)reply[2] == 21 && (int)reply[3] == 1, "serial reply header");
        Check.that((int)reply[4] == 'F' && (int)reply[15] == '2' && (int)reply[16] == 0, "serial reply text");
        DeckpadUnitTests.command(request, STEAM_GET_ATTRIBUTES, 0);
        controller.setFeature(request, 64);
        controller.getFeature(reply);
        Check.that((int)reply[2] == 25 && (int)reply[3] == 1 && Wire.u16le(reply, 4) == STEAM_PRODUCT && (int)reply[18] == 4 && Wire.u32le(reply, 19) == STEAM_FIRMWARE_TIME && (int)reply[23] == 9 && Wire.u32le(reply, 24) == STEAM_BOARD_REVISION && STEAM_BOARD_REVISION < 68, "attributes name the product, the current firmware and a board Steam's updater leaves alone");
        DeckpadUnitTests.command(request, STEAM_SET_SETTINGS, 6);
        request[3] = (unsigned char)9; request[4] = (unsigned char)0;
        request[6] = (unsigned char)48; request[7] = (unsigned char)0x18;
        controller.setFeature(request, 64);
        DeckpadUnitTests.command(request, STEAM_GET_SETTINGS, 6);
        request[3] = (unsigned char)48; request[6] = (unsigned char)9;
        controller.setFeature(request, 64);
        controller.getFeature(reply);
        Check.that((int)reply[2] == 6 && (int)reply[3] == 48 && Wire.u16le(reply, 4) == 0x18 && (int)reply[6] == 9 && Wire.u16le(reply, 7) == 0, "settings read back");
        DeckpadUnitTests.command(request, 0xC5, 1);
        request[3] = (unsigned char)7;
        controller.setFeature(request, 64);
        controller.getFeature(reply);
        Check.that((int)reply[1] == 0xC5 && (int)reply[3] == 7, "unknown commands echo");
    }

    class void effects() {
        struct HostEffect effect;
        unsigned char report[64];
        var controller = SteamController("FXDK00000042");
        memset(report, 0, sizeof(report));
        report[0] = (unsigned char)STEAM_OUT_RUMBLE;
        Wire.putU16le(report, 4, 0x1234); Wire.putU16le(report, 7, 0x5678);
        controller.outputEffect(report, 10, &effect);
        Check.that(effect.kind == HOST_EFFECT_RUMBLE && effect.left == 0x1234 && effect.right == 0x5678, "rumble output report");
        memset(report, 0, sizeof(report));
        report[0] = (unsigned char)STEAM_OUT_PULSE; report[1] = (unsigned char)3;
        Wire.putU16le(report, 2, 1200); Wire.putU16le(report, 6, 2);
        controller.outputEffect(report, 8, &effect);
        Check.that(effect.kind == HOST_EFFECT_HAPTIC && (int)effect.command.bytes[0] == DECK_HAPTIC_PULSE && (int)effect.command.bytes[2] == 1, "left grip pulse goes to the left pad");
        Check.that(Wire.u16le(effect.command.bytes, 3) == 1200 && Wire.u16le(effect.command.bytes, 7) == 2 && effect.command.length == 10, "pulse timing");
        memset(report, 0, sizeof(report));
        report[0] = (unsigned char)STEAM_OUT_COMMAND; report[1] = (unsigned char)1; report[2] = (unsigned char)1; report[3] = (unsigned char)0xF7;
        controller.outputEffect(report, 4, &effect);
        Check.that((int)effect.command.bytes[0] == DECK_HAPTIC && effect.command.length == 15 && (int)effect.command.bytes[2] == 1 && (int)effect.command.bytes[3] == 1 && (int)effect.command.bytes[4] == 1, "a -9 dB click is the Deck's low intensity");
        memset(report, 0, sizeof(report));
        report[0] = (unsigned char)STEAM_OUT_SWEEP; report[1] = (unsigned char)2; report[2] = (unsigned char)0xFA;
        Wire.putU16le(report, 3, 250); Wire.putU16le(report, 5, 80); Wire.putU16le(report, 7, 320);
        controller.outputEffect(report, 9, &effect);
        Check.that(effect.command.length == 21 && (int)effect.command.bytes[3] == DECK_HAPTIC_SWEEP && (int)effect.command.bytes[5] == 0xFA && Wire.u16le(effect.command.bytes, 8) == 250 && Wire.u16le(effect.command.bytes, 17) == 80 && Wire.u16le(effect.command.bytes, 19) == 320, "sweep keeps gain, duration and range");
        report[0] = (unsigned char)0x99;
        controller.outputEffect(report, 9, &effect);
        Check.that(effect.kind == HOST_EFFECT_NONE, "unknown output report ignored");
        DeckpadUnitTests.command(report, STEAM_RUMBLE, 9);
        Wire.putU16le(report, 6, 300); Wire.putU16le(report, 8, 400);
        controller.featureEffect(report, 64, &effect);
        Check.that(effect.kind == HOST_EFFECT_RUMBLE && effect.left == 300 && effect.right == 400, "rumble as a feature command");
    }

    class void setup(unsigned char* setup, int kind, int request, int value, int length) {
        setup[0] = (unsigned char)kind; setup[1] = (unsigned char)request;
        Wire.putU16le(setup, 2, value); Wire.putU16le(setup, 4, 0); Wire.putU16le(setup, 6, length);
    }

    class bool attachRefused(VirtualController controller) {
        try { controller.attach(); } catch (string error) { return true; }
        return false;
    }

    // The controller in HID terms, with no transport around it.
    class void controller() {
        unsigned char data[64];
        struct HidReport report;
        var pad = ScriptedPad();
        var controller = VirtualController(pad, SteamController("FXDK00000042"), false);
        Check.that(!controller.input(&report), "no reports before a host attaches");
        controller.attach();
        Check.that(DeckpadUnitTests.attachRefused(controller), "only one host holds the controller");
        controller.pump(8);
        Check.that(controller.input(&report) && report.length == 15 && (int)report.bytes[0] == 0x43, "battery report after attach");
        Check.that(controller.input(&report) && report.length == 54 && (int)report.bytes[0] == 0x42, "state report follows");
        Check.that(!controller.input(&report), "nothing more until the pad reports again");
        memset(data, 0, sizeof(data));
        data[0] = (unsigned char)STEAM_OUT_RUMBLE;
        Wire.putU16le(data, 4, 1000); Wire.putU16le(data, 7, 2000);
        controller.output(data, 10);
        Timer.sleepMillis(60);
        controller.pump(8);
        Check.that(pad.commands == 1 && (int)pad.last.bytes[0] == DECK_RUMBLE && Wire.u16le(pad.last.bytes, 5) == 1000 && Wire.u16le(pad.last.bytes, 7) == 2000, "rumble reaches the pad");
        Wire.putU16le(data, 4, 3000);
        controller.output(data, 10);
        controller.pump(8);
        Check.that(pad.commands == 1, "rumble is throttled to 20 Hz");
        Timer.sleepMillis(60);
        controller.pump(8);
        Check.that(pad.commands == 2 && Wire.u16le(pad.last.bytes, 5) == 3000, "the latest rumble is applied");
        Timer.sleepMillis(560);
        controller.pump(8);
        Check.that(pad.commands == 3 && Wire.u16le(pad.last.bytes, 5) == 0, "rumble stops when the host stops repeating it");
        DeckpadUnitTests.command(data, STEAM_HAPTIC_PULSE, 7);
        data[3] = (unsigned char)1;
        Check.that(controller.setFeature(data, 64) && pad.commands == 4 && (int)pad.last.bytes[0] == DECK_HAPTIC_PULSE, "feature pulse reaches the pad at once");
        Check.that(controller.feature(STEAM_REPORT_FEATURE, data) == 64 && (int)data[1] == STEAM_HAPTIC_PULSE, "the feature report reads back");
        data[0] = (unsigned char)2;
        Check.that(!controller.setFeature(data, 64) && controller.feature(2, data) < 0, "there is only feature report 1");
        controller.detach();
        Check.that(!controller.attached(), "detach releases the pad");
    }

    class Bytes feature(int command, int length, int argument) {
        unsigned char raw[64];
        DeckpadUnitTests.command(raw, command, length);
        raw[3] = (unsigned char)argument;
        return Bytes.fromRaw((char*)raw, 64);
    }

    // The same controller as a USB device: Library.USB answers enumeration from
    // the description, and the HID function carries the reports.
    class void usbDevice() {
        var pad = ScriptedPad();
        var controller = VirtualController(pad, SteamController("FXDK00000042"), false);
        var port = ControllerPort(controller);
        USBVirtualDevice device = ControllerUSB.device(port);
        Bytes descriptor = Bytes();
        Check.that(device.control(USBSetup(0x80, USB_REQUEST_GET_DESCRIPTOR, 0x0100, 0, 18), descriptor) == 18 && USBBytes.u16((unsigned char*)descriptor.data, 8) == STEAM_VENDOR && USBBytes.u16((unsigned char*)descriptor.data, 10) == STEAM_PRODUCT, "USB device identity");
        Check.that(device.control(USBSetup(0x80, USB_REQUEST_GET_DESCRIPTOR, 0x0100, 0, 8), Bytes()) == 8, "short reads are truncated");
        Bytes configuration = Bytes();
        Check.that(device.control(USBSetup(0x80, USB_REQUEST_GET_DESCRIPTOR, 0x0200, 0, 255), configuration) == 41 && configuration.get(14) == 3 && configuration.get(25) == 143, "configuration names the HID interface and its report descriptor");
        Vector<USBEndpoint> endpoints = USBEndpoint.listed(configuration);
        Check.that(endpoints.len == 2 && endpoints.get(0).address == 0x81 && endpoints.get(1).address == 0x01 && endpoints.get(0).interval == 1 && endpoints.get(0).maxPacket == 64, "interrupt IN and OUT endpoints, polled every millisecond");
        Bytes product = Bytes();
        Check.that(device.control(USBSetup(0x80, USB_REQUEST_GET_DESCRIPTOR, 0x0302, 0x0409, 255), product) == 34 && product.get(2) == 'S', "product string");
        Bytes serial = Bytes();
        Check.that(device.control(USBSetup(0x80, USB_REQUEST_GET_DESCRIPTOR, 0x0303, 0x0409, 255), serial) == 26 && serial.get(2) == 'F' && serial.get(24) == '2', "serial string");
        Check.that(device.control(USBSetup(0x81, USB_REQUEST_GET_DESCRIPTOR, 0x2200, 0, 255), Bytes()) == 143, "report descriptor over the interface");
        Check.that(device.control(USBSetup(0x80, USB_REQUEST_GET_DESCRIPTOR, 0x0600, 0, 10), Bytes()) == USB_CONTROL_STALL, "no device qualifier at full speed");
        Check.that(device.control(USBSetup(0x00, USB_REQUEST_SET_CONFIGURATION, 1, 0, 0), Bytes()) == 0 && device.configured(), "set configuration");
        controller.attach();
        Check.that(device.control(USBSetup(0x21, 0x09, 0x0301, 0, 64), DeckpadUnitTests.feature(STEAM_GET_STRING, 0x15, 1)) == 64, "SET_REPORT carries a feature command");
        Bytes reply = Bytes();
        Check.that(device.control(USBSetup(0xA1, 0x01, 0x0301, 0, 64), reply) == 64 && reply.get(1) == STEAM_GET_STRING && reply.get(4) == 'F', "GET_REPORT carries its reply");
        Check.that(device.control(USBSetup(0xA1, 0x01, 0x0302, 0, 64), Bytes()) == USB_CONTROL_STALL, "an unknown feature report stalls");
        Bytes pulse = Bytes();
        pulse.append(STEAM_OUT_PULSE);
        pulse.append(1);
        for (int index = 0; index < 6; index++) { pulse.append(0); }
        Check.that(device.control(USBSetup(0x21, 0x09, 0x0281, 0, 8), pulse) == 8 && pad.commands == 1 && (int)pad.last.bytes[0] == DECK_HAPTIC_PULSE, "SET_REPORT carries an output report");
        device.consume(0x01, pulse);
        Check.that(pad.commands == 2, "so does the interrupt OUT endpoint");
        // Reports leave only through the link that holds the controller.
        controller.pump(8);
        Check.that(!device.produce(0x81, Bytes()), "a link that does not hold the controller sends no input");
        port.hold(true);
        Bytes battery = Bytes();
        Bytes state = Bytes();
        Check.that(device.produce(0x81, battery) && battery.length() == 15 && battery.get(0) == STEAM_REPORT_BATTERY, "the holder gets the battery report");
        Check.that(device.produce(0x81, state) && state.length() == 54 && state.get(0) == STEAM_REPORT_STATE && !device.produce(0x82, Bytes()), "then the state, on the IN endpoint only");
    }

    // Over Bluetooth the same state travels as report 0x45, without the
    // trailing orientation, under the Bluetooth controller's identity.
    class void bluetoothPort() {
        var controller = VirtualController(ScriptedPad(), SteamController("FXDK00000042"), false);
        var port = ControllerPort(controller, STEAM_REPORT_STATE_BLUETOOTH, STEAM_STATE_LENGTH_BLUETOOTH);
        HIDPDevice protocol = HIDPDevice(port);
        controller.attach();
        port.hold(true);
        controller.pump(8);
        Bytes battery = Bytes();
        Bytes state = Bytes();
        Check.that(protocol.nextInput(battery) && battery.length() == 16 && battery.get(0) == 0xA1 && battery.get(1) == STEAM_REPORT_BATTERY, "the battery report is unchanged");
        Check.that(protocol.nextInput(state) && state.length() == 47 && state.get(1) == STEAM_REPORT_STATE_BLUETOOTH, "the state is report 0x45, 46 bytes");
        Bytes asked = Bytes();
        asked.append(0x43);
        asked.append(STEAM_REPORT_FEATURE);
        Check.that(protocol.control(asked).length() == 65, "feature report 1 is read over the control channel");
        BluetoothHIDRecord record = BluetoothHIDRecord("Steam Controller", port.reportDescriptor()).identified(STEAM_VENDOR, STEAM_PRODUCT_BLUETOOTH, 0x0100);
        Check.that(record.deviceID().equals("usb:28DE:1303:0100") && record.xml().contains("0600ff0901a101"), "the service record carries the identity and the report descriptor");
        Check.that(HIDReportDescriptor.numbered(port.reportDescriptor()), "the reports are numbered");
    }

    class bool missingIdentity(string path) {
        try { MachineIdentity.load(path, false); } catch (string error) { return true; }
        return false;
    }

    // Hosts are trusted by key; a new one gets in only while pairing is open.
    class void pairing() {
        string directory = FileSystem.tempDir("deckpad-pairing");
        var pairing = Pairing(directory + "/trusted");
        var desk = SigningKey.generate().publicKey();
        var other = SigningKey.generate().publicKey();
        Check.that(!pairing.admits(desk, "desk", "123456") && pairing.trusted().count() == 0, "an unknown host is refused while pairing is shut");
        pairing.window().open(60);
        Check.that(pairing.admits(desk, "desk", "123456") && pairing.code().equals("123456") && pairing.codeLabel().equals("desk"), "and taken in while it is open, with its code kept to show");
        pairing.window().close();
        Check.that(pairing.admits(desk, "desk", "654321") && !pairing.admits(other, "other", "111111") && pairing.code().equals("123456"), "a trusted host stays trusted; a new one waits for the next window");
        Check.that(Pairing(directory + "/trusted").admits(desk, "desk", ""), "trust survives a restart");
        var first = MachineIdentity.load(directory + "/identity", true);
        var again = MachineIdentity.load(directory + "/identity", false);
        Check.that(first.publicKey().equals(again.publicKey()) && DeckpadUnitTests.missingIdentity(directory + "/absent"), "a machine keeps the identity it was given");
        FileSystem.removeRecursive(directory);
    }

    class bool noLinks(VirtualController controller) {
        var service = ControllerService(controller);
        service.add(SwitchedLink("broken", controller, true));
        try { service.open(); } catch (string error) { return true; }
        return false;
    }

    // Links share one controller: the first host to attach, on any link,
    // holds it until it leaves.
    class void links() {
        var controller = VirtualController(ScriptedPad(), SteamController("FXDK00000042"), false);
        var service = ControllerService(controller);
        var first = SwitchedLink("first", controller, false);
        var second = SwitchedLink("second", controller, false);
        service.add(first);
        service.add(SwitchedLink("broken", controller, true));
        service.add(second);
        service.open();
        Check.that(service.all().len == 2 && first.opened && second.opened, "a link that cannot work here is left out; the rest serve");
        Check.that(DeckpadUnitTests.noLinks(controller), "a service with no working link does not start");
        Check.that(service.turn(5) && service.holding().isEmpty() && !controller.attached(), "nobody holds the controller before a host attaches");
        second.host = true;
        Check.that(service.turn(5) && service.holding().equals("second") && controller.attached() && second.port().holding(), "the first host to attach takes it");
        first.host = true;
        Check.that(service.turn(5) && service.holding().equals("second") && !first.port().holding() && first.port().busyElsewhere(), "a host on another link waits");
        second.host = false;
        Check.that(service.turn(5) && service.holding().equals("first") && first.port().holding() && !second.port().holding(), "and takes over when the holder leaves");
        first.host = false;
        Check.that(service.turn(5) && service.holding().isEmpty() && !controller.attached(), "the pad goes back when the last host leaves");
        service.stop();
        Check.that(!service.turn(5), "the service stops when told");
        service.close();
        Check.that(!first.opened && !second.opened, "closing the service closes its links");
    }

    class int buttons(struct HidReport* report) { return Wire.u16le(report->bytes, 2) | (Wire.u16le(report->bytes, 4) << 16); }

    class void stopChord() {
        struct HidReport report;
        var pad = HeldPad();
        var device = VirtualController(pad, SteamController("FXDK00000042"), false);
        device.attach();
        Check.that(pad.opened, "attach takes the pad");
        long long started = MonotonicClock.milliseconds();
        while (!device.stopRequested() && MonotonicClock.milliseconds() - started < 4000LL) { device.pump(8); }
        long long held = MonotonicClock.milliseconds() - started;
        Check.that(device.stopRequested() && held >= 1900LL && held < 3500LL, "holding ... for two seconds asks to stop");
        Check.that(device.input(&report) && (int)report.bytes[0] == STEAM_REPORT_BATTERY, "battery report is due first");
        Check.that(device.input(&report) && DeckpadUnitTests.buttons(&report) == PAD_B, "... is kept from the host by default");
        var forwarding = VirtualController(HeldPad(), SteamController("FXDK00000042"), true);
        forwarding.attach();
        forwarding.pump(8);
        forwarding.input(&report);
        Check.that(forwarding.input(&report) && DeckpadUnitTests.buttons(&report) == (PAD_B | PAD_QUICK_ACCESS), "... can be forwarded");
    }

    // What `deckpad check` and `deckpad measure` conclude from report times.
    class void pace() {
        // 250 reports a second for two seconds, each 3 ms in transit, on a
        // sender's clock that wraps in the middle.
        ReportPace even = ReportPace();
        long long sender = 0xFFFFFFFFLL - 1000000LL;
        for (int index = 0; index < 500; index++) {
            even.arrivedAt(5000000LL + (long long)index * 4000LL + 3000LL);
            even.sent((sender + (long long)index * 4000LL) & 0xFFFFFFFFLL);
        }
        Check.that(even.count == 500 && even.longest == 4000LL && even.late == 0, "even reports have even gaps");
        Check.that(even.jitter() == 0LL && even.steady(2), "even delivery has no jitter and is steady");

        // The same, with one report 30 ms late, the ones behind it arriving
        // in a bunch, and one report 2 ms quicker than the rest.
        ReportPace uneven = ReportPace();
        long long previous = 0LL;
        for (int index = 0; index < 500; index++) {
            long long delay = index == 100 ? 33000LL : (index == 300 ? 1000LL : 3000LL);
            long long arrival = 5000000LL + (long long)index * 4000LL + delay;
            if (arrival < previous) { arrival = previous; }
            previous = arrival;
            uneven.arrivedAt(arrival);
            uneven.sent((sender + (long long)index * 4000LL) & 0xFFFFFFFFLL);
        }
        Check.that(uneven.jitter() == 32000LL, "jitter spans the quickest and the slowest report");
        Check.that(uneven.late == 1 && uneven.longest == 34000LL && uneven.steady(2), "one late report is counted");

        // Too few reports, or a stall, is not steady.
        ReportPace slow = ReportPace();
        for (int index = 0; index < 100; index++) { slow.arrivedAt((long long)index * 20000LL); }
        Check.that(!slow.steady(2), "50 reports a second is too few");
        ReportPace stalled = ReportPace();
        for (int index = 0; index < 500; index++) { stalled.arrivedAt((long long)index * 4000LL + (index >= 250 ? 150000LL : 0LL)); }
        Check.that(!stalled.steady(2) && stalled.longest == 154000LL, "a stall of 150 ms is not steady");
    }
}

int main() {
    DeckpadUnitTests.deckReport();
    DeckpadUnitTests.stateReport();
    DeckpadUnitTests.latch();
    DeckpadUnitTests.descriptors();
    DeckpadUnitTests.features();
    DeckpadUnitTests.effects();
    DeckpadUnitTests.controller();
    DeckpadUnitTests.usbDevice();
    DeckpadUnitTests.bluetoothPort();
    DeckpadUnitTests.pairing();
    DeckpadUnitTests.links();
    DeckpadUnitTests.stopChord();
    DeckpadUnitTests.pace();
    print("PASS: deckpad reports, descriptors, feature commands, haptics, USB and Bluetooth views, pairing, shared links, stop chord and report pace");
    return 0;
}
