// A link whose host comes and goes when the test says so.
class SwitchedLink implements IControllerLink {
    public bool host = false;
    public bool broken;
    public bool opened = false;
    private string label;
    private ControllerPort gate;

    public SwitchedLink(string label, VirtualController controller, bool broken) {
        self.label = label;
        self.gate = ControllerPort(controller);
        self.broken = broken;
    }

    public string name() { return self.label; }

    public void open() {
        if (self.broken) { throw "not on this machine"; }
        self.opened = true;
    }

    public void watchIn(PollSet polls) {}

    public void step() {}

    public bool attached() { return self.host; }

    public ControllerPort port() { return self.gate; }

    public string status() { return self.host ? "attached" : "waiting"; }

    public void close() { self.opened = false; }
}

// A controller whose ... button never lets go.
class HeldPad implements IPadSource {
    public bool opened = false;

    public void open() { self.opened = true; }

    public bool read(PadState state, int timeoutMilliseconds) {
        Timer.sleepMillis(4);
        state.reset();
        state.buttons = PAD_QUICK_ACCESS | PAD_B;
        return true;
    }

    public void command(PadCommand command) {}
    public void close() { self.opened = false; }
}

class CountingPlayer implements IPadUseListener {
    public int told = 0;
    public bool closed = false;

    public void used(long long now) { self.told++; }
    public void close() { self.closed = true; }
}

class DeckpadUnitTests {
    class Bytes deckSample() {
        Bytes report = Wire.zeros(64);
        report.set(0, 0x01); report.set(2, 0x09); report.set(3, 0x40);
        report.set(8, 0x80);   // A
        report.set(9, 0x80);   // L5
        report.set(10, 0x08);  // left pad touched
        report.set(11, 0x04);  // right stick click
        report.set(13, 0x02);  // L4
        report.set(14, 0x04);  // quick access
        Wire.putU16le(report, 16, 1000); Wire.putU16le(report, 18, -2000);
        Wire.putU16le(report, 28, 16384); Wire.putU16le(report, 30, -5);
        Wire.putU16le(report, 44, 12345); Wire.putU16le(report, 46, 40000);
        Wire.putU16le(report, 48, -32768); Wire.putU16le(report, 50, 32767);
        Wire.putU16le(report, 52, 100); Wire.putU16le(report, 54, -100);
        Wire.putU16le(report, 56, 500); Wire.putU16le(report, 58, 600);
        return report;
    }

    class void deckReport() {
        Bytes report = DeckpadUnitTests.deckSample();
        PadState state = PadState();
        Expect.isTrue(DeckReport.parse(report, state));
        Expect.intEq(state.buttons, PAD_A | PAD_L5 | PAD_LEFT_PAD_TOUCH | PAD_RIGHT_STICK | PAD_L4 | PAD_QUICK_ACCESS);
        Expect.isTrue(state.leftPadX == 1000 && state.leftPadY == -2000 && state.accelZ == 16384 && state.gyroX == -5);
        Expect.isTrue(state.leftTrigger == 12345 && state.rightTrigger == 32767);
        Expect.isTrue(state.leftStickX == -32767 && state.leftStickY == 32767 && state.rightStickX == 100 && state.rightStickY == -100);
        Expect.isTrue(state.leftPadPressure == 500 && state.rightPadPressure == 600);
        Expect.isFalse(DeckReport.parse(report.slice(0, 40), state));
        report.set(2, 0x04);
        Expect.isFalse(DeckReport.parse(report, state));
    }

    class void stateReport() {
        Bytes report = DeckpadUnitTests.deckSample();
        Bytes out = Wire.zeros(64);
        PadState state = PadState();
        DeckReport.parse(report, state);
        var controller = SteamController("FXDK00000042");
        Expect.isTrue(controller.encodeState(state, 0x01020304LL, out) == 54 && out.get(0) == 0x42 && out.get(1) == 0);
        Expect.isTrue(Wire.u16le(out, 2) == (state.buttons & 0xFFFF) && Wire.u16le(out, 4) == (state.buttons >> 16));
        Expect.isTrue(Wire.u16le(out, 6) == 12345 && Wire.u16le(out, 8) == 32767);
        Expect.isTrue(Wire.s16le(out, 10) == -32767 && Wire.s16le(out, 12) == 32767 && Wire.s16le(out, 14) == 100 && Wire.s16le(out, 16) == -100);
        Expect.isTrue(Wire.s16le(out, 18) == 1000 && Wire.s16le(out, 20) == -2000 && Wire.u16le(out, 22) == 500 && Wire.u16le(out, 28) == 600);
        Expect.isTrue(out.get(30) == 0x04 && out.get(33) == 0x01);
        Expect.isTrue(Wire.s16le(out, 38) == 16384 && Wire.s16le(out, 40) == -5);
        controller.encodeState(state, 0LL, out);
        Expect.intEq(out.get(1), 1);
        Expect.isTrue(controller.encodeBattery(87, true, out) == 15 && out.get(0) == 0x43 && out.get(1) == 2 && out.get(2) == 87);
        Expect.isTrue(controller.encodeBattery(100, true, out) == 15 && out.get(1) == 4);
    }

    class void latch() {
        PadState state = PadState();
        PadState taken = PadState();
        var latch = PadLatch();
        Expect.isFalse(latch.pending());
        state.buttons = PAD_A | PAD_LEFT_PAD_TOUCH;
        latch.update(state);
        state.buttons = 0;
        latch.update(state);
        latch.take(taken);
        Expect.intEq(taken.buttons, PAD_A);
        Expect.isFalse(latch.pending());
        latch.update(state);
        latch.take(taken);
        Expect.intEq(taken.buttons, 0);
    }

    class void descriptors() {
        Bytes out = Bytes();
        var controller = SteamController("FXDK00000042");
        int length = controller.reportDescriptor(out);
        Expect.isTrue(length == 143 && out.get(0) == 0x06 && out.get(2) == 0xFF && out.get(length - 1) == 0xC0);
        Expect.isTrue(out.get(15) == 0x42 && out.get(19) == 53);
        Expect.isTrue(out.get(length - 8) == 0x01 && out.get(length - 4) == 63 && out.get(length - 3) == 0xB1);
        Expect.isTrue(controller.vendor() == 0x28DE && controller.product() == 0x1302 && controller.serial().equals("FXDK00000042"));
    }

    class void command(Bytes out, int identifier, int length) {
        Wire.resetZeros(out, 64);
        out.set(0, STEAM_REPORT_FEATURE);
        out.set(1, identifier);
        out.set(2, length);
    }

    class void features() {
        Bytes request = Wire.zeros(64);
        Bytes reply = Wire.zeros(64);
        var controller = SteamController("FXDK00000042");
        DeckpadUnitTests.command(request, STEAM_GET_STRING, 0x15);
        request.set(3, 1);
        controller.setFeature(request);
        Expect.isTrue(controller.getFeature(reply) == 64 && reply.get(1) == STEAM_GET_STRING && reply.get(2) == 21 && reply.get(3) == 1);
        Expect.isTrue(reply.get(4) == 'F' && reply.get(15) == '2' && reply.get(16) == 0);
        DeckpadUnitTests.command(request, STEAM_GET_ATTRIBUTES, 0);
        controller.setFeature(request);
        controller.getFeature(reply);
        Expect.isTrue(reply.get(2) == 25 && reply.get(3) == 1 && Wire.u16le(reply, 4) == STEAM_PRODUCT && reply.get(18) == 4 && Wire.u32le(reply, 19) == STEAM_FIRMWARE_TIME && reply.get(23) == 9 && Wire.u32le(reply, 24) == STEAM_BOARD_REVISION && STEAM_BOARD_REVISION < 68);
        DeckpadUnitTests.command(request, STEAM_SET_SETTINGS, 6);
        request.set(3, 9); request.set(4, 0);
        request.set(6, 48); request.set(7, 0x18);
        controller.setFeature(request);
        DeckpadUnitTests.command(request, STEAM_GET_SETTINGS, 6);
        request.set(3, 48); request.set(6, 9);
        controller.setFeature(request);
        controller.getFeature(reply);
        Expect.isTrue(reply.get(2) == 6 && reply.get(3) == 48 && Wire.u16le(reply, 4) == 0x18 && reply.get(6) == 9 && Wire.u16le(reply, 7) == 0);
        DeckpadUnitTests.command(request, 0xC5, 1);
        request.set(3, 7);
        controller.setFeature(request);
        controller.getFeature(reply);
        Expect.isTrue(reply.get(1) == 0xC5 && reply.get(3) == 7);
    }

    class void effects() {
        HostEffect effect = HostEffect();
        Bytes report = Wire.zeros(64);
        var controller = SteamController("FXDK00000042");
        report.set(0, STEAM_OUT_RUMBLE);
        Wire.putU16le(report, 4, 0x1234); Wire.putU16le(report, 7, 0x5678);
        controller.outputEffect(report.slice(0, 10), effect);
        Expect.isTrue(effect.kind == HOST_EFFECT_RUMBLE && effect.left == 0x1234 && effect.right == 0x5678);
        Wire.resetZeros(report, 64);
        report.set(0, STEAM_OUT_PULSE); report.set(1, 3);
        Wire.putU16le(report, 2, 1200); Wire.putU16le(report, 6, 2);
        controller.outputEffect(report.slice(0, 8), effect);
        Expect.isTrue(effect.kind == HOST_EFFECT_HAPTIC && effect.command.bytes.get(0) == DECK_HAPTIC_PULSE && effect.command.bytes.get(2) == 1);
        Expect.isTrue(Wire.u16le(effect.command.bytes, 3) == 1200 && Wire.u16le(effect.command.bytes, 7) == 2 && effect.command.length == 10);
        Wire.resetZeros(report, 64);
        report.set(0, STEAM_OUT_COMMAND); report.set(1, 1); report.set(2, 1); report.set(3, 0xF7);
        controller.outputEffect(report.slice(0, 4), effect);
        Expect.isTrue(effect.command.bytes.get(0) == DECK_HAPTIC && effect.command.length == 15 && effect.command.bytes.get(2) == 1 && effect.command.bytes.get(3) == 1 && effect.command.bytes.get(4) == 1);
        Wire.resetZeros(report, 64);
        report.set(0, STEAM_OUT_SWEEP); report.set(1, 2); report.set(2, 0xFA);
        Wire.putU16le(report, 3, 250); Wire.putU16le(report, 5, 80); Wire.putU16le(report, 7, 320);
        controller.outputEffect(report.slice(0, 9), effect);
        Expect.isTrue(effect.command.length == 21 && effect.command.bytes.get(3) == DECK_HAPTIC_SWEEP && effect.command.bytes.get(5) == 0xFA && Wire.u16le(effect.command.bytes, 8) == 250 && Wire.u16le(effect.command.bytes, 17) == 80 && Wire.u16le(effect.command.bytes, 19) == 320);
        report.set(0, 0x99);
        controller.outputEffect(report.slice(0, 9), effect);
        Expect.intEq(effect.kind, HOST_EFFECT_NONE);
        DeckpadUnitTests.command(report, STEAM_RUMBLE, 9);
        Wire.putU16le(report, 6, 300); Wire.putU16le(report, 8, 400);
        controller.featureEffect(report, effect);
        Expect.isTrue(effect.kind == HOST_EFFECT_RUMBLE && effect.left == 300 && effect.right == 400);
    }

    class bool attachRefused(VirtualController controller) {
        try { controller.attach(); } catch (string error) { return true; }
        return false;
    }

    // The controller in HID terms, with no transport around it.
    class void controller() {
        Bytes data = Wire.zeros(64);
        HidReport report = HidReport();
        var pad = ScriptedPad();
        var controller = VirtualController(pad, SteamController("FXDK00000042"), false);
        Expect.isFalse(controller.input(report));
        controller.attach();
        Expect.isTrue(DeckpadUnitTests.attachRefused(controller));
        controller.pump(8);
        Expect.isTrue(controller.input(report) && report.length == 15 && report.bytes.get(0) == 0x43);
        Expect.isTrue(controller.input(report) && report.length == 54 && report.bytes.get(0) == 0x42);
        Expect.isFalse(controller.input(report));
        Wire.resetZeros(data, 64);
        data.set(0, STEAM_OUT_RUMBLE);
        Wire.putU16le(data, 4, 1000); Wire.putU16le(data, 7, 2000);
        controller.output(data.slice(0, 10));
        Timer.sleepMillis(60);
        controller.pump(8);
        Expect.isTrue(pad.commands == 1 && pad.last.bytes.get(0) == DECK_RUMBLE && Wire.u16le(pad.last.bytes, 5) == 1000 && Wire.u16le(pad.last.bytes, 7) == 2000);
        Wire.putU16le(data, 4, 3000);
        controller.output(data.slice(0, 10));
        controller.pump(8);
        Expect.intEq(pad.commands, 1);
        Timer.sleepMillis(60);
        controller.pump(8);
        Expect.isTrue(pad.commands == 2 && Wire.u16le(pad.last.bytes, 5) == 3000);
        Timer.sleepMillis(560);
        controller.pump(8);
        Expect.isTrue(pad.commands == 3 && Wire.u16le(pad.last.bytes, 5) == 0);
        DeckpadUnitTests.command(data, STEAM_HAPTIC_PULSE, 7);
        data.set(3, 1);
        Expect.isTrue(controller.setFeature(data) && pad.commands == 4 && pad.last.bytes.get(0) == DECK_HAPTIC_PULSE);
        Expect.isTrue(controller.feature(STEAM_REPORT_FEATURE, data) == 64 && data.get(1) == STEAM_HAPTIC_PULSE);
        data.set(0, 2);
        Expect.isTrue(!controller.setFeature(data) && controller.feature(2, data) < 0);
        controller.detach();
        Expect.isFalse(controller.attached());
    }

    class Bytes feature(int command, int length, int argument) {
        Bytes raw = Wire.zeros(64);
        DeckpadUnitTests.command(raw, command, length);
        raw.set(3, argument);
        return raw;
    }

    // The same controller as a USB device: Library.USB answers enumeration from
    // the description, and the HID function carries the reports.
    class void usbDevice() {
        var pad = ScriptedPad();
        var controller = VirtualController(pad, SteamController("FXDK00000042"), false);
        var port = ControllerPort(controller);
        USBVirtualDevice device = ControllerUSB.device(port);
        Bytes descriptor = Bytes();
        Expect.isTrue(device.control(USBSetup(0x80, USB_REQUEST_GET_DESCRIPTOR, 0x0100, 0, 18), descriptor) == 18 && Wire.u16le(descriptor, 8) == STEAM_VENDOR && Wire.u16le(descriptor, 10) == STEAM_PRODUCT);
        Expect.intEq(device.control(USBSetup(0x80, USB_REQUEST_GET_DESCRIPTOR, 0x0100, 0, 8), Bytes()), 8);
        Bytes configuration = Bytes();
        Expect.isTrue(device.control(USBSetup(0x80, USB_REQUEST_GET_DESCRIPTOR, 0x0200, 0, 255), configuration) == 41 && configuration.get(14) == 3 && configuration.get(25) == 143);
        Vector<USBEndpoint> endpoints = USBEndpoint.listed(configuration);
        Expect.isTrue(endpoints.len == 2 && endpoints.get(0).address == 0x81 && endpoints.get(1).address == 0x01 && endpoints.get(0).interval == 1 && endpoints.get(0).maxPacket == 64);
        Bytes product = Bytes();
        Expect.isTrue(device.control(USBSetup(0x80, USB_REQUEST_GET_DESCRIPTOR, 0x0302, 0x0409, 255), product) == 34 && product.get(2) == 'S');
        Bytes serial = Bytes();
        Expect.isTrue(device.control(USBSetup(0x80, USB_REQUEST_GET_DESCRIPTOR, 0x0303, 0x0409, 255), serial) == 26 && serial.get(2) == 'F' && serial.get(24) == '2');
        Expect.intEq(device.control(USBSetup(0x81, USB_REQUEST_GET_DESCRIPTOR, 0x2200, 0, 255), Bytes()), 143);
        Expect.intEq(device.control(USBSetup(0x80, USB_REQUEST_GET_DESCRIPTOR, 0x0600, 0, 10), Bytes()), USB_CONTROL_STALL);
        Expect.isTrue(device.control(USBSetup(0x00, USB_REQUEST_SET_CONFIGURATION, 1, 0, 0), Bytes()) == 0 && device.configured());
        controller.attach();
        Expect.intEq(device.control(USBSetup(0x21, 0x09, 0x0301, 0, 64), DeckpadUnitTests.feature(STEAM_GET_STRING, 0x15, 1)), 64);
        Bytes reply = Bytes();
        Expect.isTrue(device.control(USBSetup(0xA1, 0x01, 0x0301, 0, 64), reply) == 64 && reply.get(1) == STEAM_GET_STRING && reply.get(4) == 'F');
        Expect.intEq(device.control(USBSetup(0xA1, 0x01, 0x0302, 0, 64), Bytes()), USB_CONTROL_STALL);
        Bytes pulse = Bytes();
        pulse.append(STEAM_OUT_PULSE);
        pulse.append(1);
        for (int index = 0; index < 6; index++) { pulse.append(0); }
        Expect.isTrue(device.control(USBSetup(0x21, 0x09, 0x0281, 0, 8), pulse) == 8 && pad.commands == 1 && pad.last.bytes.get(0) == DECK_HAPTIC_PULSE);
        device.consume(0x01, pulse);
        Expect.intEq(pad.commands, 2);
        // Reports leave only through the link that holds the controller.
        controller.pump(8);
        Expect.isFalse(device.produce(0x81, Bytes()));
        port.hold(true);
        Bytes battery = Bytes();
        Bytes state = Bytes();
        Expect.isTrue(device.produce(0x81, battery) && battery.length() == 15 && battery.get(0) == STEAM_REPORT_BATTERY);
        Expect.isTrue(device.produce(0x81, state) && state.length() == 54 && state.get(0) == STEAM_REPORT_STATE && !device.produce(0x82, Bytes()));
    }

    // Over Bluetooth the same state travels as report 0x45, without the
    // trailing orientation, under the Bluetooth controller's identity.
    class void bluetoothPort() {
        var controller = VirtualController(ScriptedPad(), SteamController("FXDK00000042"), false);
        var port = ControllerPort(controller, STEAM_REPORT_STATE_BLUETOOTH, STEAM_STATE_LENGTH_BLUETOOTH);
        HIDPDevice protocol = HIDPDevice(port);
        controller.attach();
        port.hold(true);
        controller.pump(8);
        Bytes battery = Bytes();
        Bytes state = Bytes();
        Expect.isTrue(protocol.nextInput(battery) && battery.length() == 16 && battery.get(0) == 0xA1 && battery.get(1) == STEAM_REPORT_BATTERY);
        Expect.isTrue(protocol.nextInput(state) && state.length() == 47 && state.get(1) == STEAM_REPORT_STATE_BLUETOOTH);
        Bytes asked = Bytes();
        asked.append(0x43);
        asked.append(STEAM_REPORT_FEATURE);
        Expect.intEq(protocol.control(asked).length(), 65);
        BluetoothHIDRecord record = BluetoothHIDRecord("Steam Controller", port.reportDescriptor()).identified(STEAM_VENDOR, STEAM_PRODUCT_BLUETOOTH, 0x0100);
        Expect.isTrue(record.deviceID().equals("usb:28DE:1303:0100") && record.xml().contains("0600ff0901a101"));
        Expect.isTrue(HIDReportDescriptor.numbered(port.reportDescriptor()));
    }

    class bool missingIdentity(string path) {
        try { MachineIdentity.load(path, false); } catch (string error) { return true; }
        return false;
    }

    // Hosts are trusted by key; a new one gets in only while pairing is open.
    class void pairing() {
        var dir = TestDir("deckpad-pairing");
        string directory = dir.path;
        var pairing = Pairing(directory + "/trusted");
        var desk = SigningKey.generate().publicKey();
        var other = SigningKey.generate().publicKey();
        Expect.isTrue(!pairing.admits(desk, "desk", "123456") && pairing.trusted().count() == 0);
        pairing.window().open(60);
        Expect.isTrue(pairing.admits(desk, "desk", "123456") && pairing.code().equals("123456") && pairing.codeLabel().equals("desk"));
        pairing.window().close();
        Expect.isTrue(pairing.admits(desk, "desk", "654321") && !pairing.admits(other, "other", "111111") && pairing.code().equals("123456"));
        Expect.isTrue(Pairing(directory + "/trusted").admits(desk, "desk", ""));
        var first = MachineIdentity.load(directory + "/identity", true);
        var again = MachineIdentity.load(directory + "/identity", false);
        Expect.isTrue(first.publicKey().equals(again.publicKey()) && DeckpadUnitTests.missingIdentity(directory + "/absent"));
    }

    class bool noLinks(VirtualController controller) {
        var service = ControllerService(controller);
        service.add(SwitchedLink("broken", controller, true));
        try { service.open(); } catch (string error) { return true; }
        return false;
    }

    // Links share one controller: the first host to attach, on any link,
    // holds it until it leaves.
    class void links() {
        var controller = VirtualController(ScriptedPad(), SteamController("FXDK00000042"), false);
        var service = ControllerService(controller);
        var dir = TestDir("deckpad-runtime");
        string runtime = dir.path;
        service.announceIn(runtime);
        var first = SwitchedLink("first", controller, false);
        var second = SwitchedLink("second", controller, false);
        service.add(first);
        service.add(SwitchedLink("broken", controller, true));
        service.add(second);
        service.open();
        Expect.isTrue(service.all().len == 2 && first.opened && second.opened);
        Expect.isTrue(DeckpadUnitTests.noLinks(controller));
        Expect.isTrue(service.turn(5) && service.holding().isEmpty() && !controller.attached());
        second.host = true;
        Expect.isTrue(service.turn(5) && service.holding().equals("second") && controller.attached() && second.port().holding());
        Expect.isTrue(FileSystem.isFile(runtime + "/second-host") && !FileSystem.exists(runtime + "/first-host"));
        first.host = true;
        Expect.isTrue(service.turn(5) && service.holding().equals("second") && !first.port().holding() && first.port().busyElsewhere());
        second.host = false;
        Expect.isTrue(service.turn(5) && service.holding().equals("first") && first.port().holding() && !second.port().holding());
        Expect.isTrue(FileSystem.isFile(runtime + "/first-host") && !FileSystem.exists(runtime + "/second-host"));
        first.host = false;
        Expect.isTrue(service.turn(5) && service.holding().isEmpty() && !controller.attached());
        Expect.isFalse(FileSystem.exists(runtime + "/first-host"));
        service.stop();
        Expect.isFalse(service.turn(5));
        service.close();
        Expect.isTrue(!first.opened && !second.opened);
    }

    // The Deck is told someone is playing only while the pad is in use.
    class int toldIn(IPadSource pad, int turns) {
        var controller = VirtualController(pad, SteamController("FXDK00000042"), false);
        var service = ControllerService(controller);
        var player = CountingPlayer();
        service.tell(player);
        var link = SwitchedLink("only", controller, false);
        service.add(link);
        service.open();
        link.host = true;
        for (int turn = 0; turn < turns; turn++) { service.turn(5); }
        service.close();
        return player.closed ? player.told : -1;
    }

    class void use() {
        PadState state = PadState();
        state.leftStickX = 5000;
        var use = PadUse();
        use.see(state, 100LL);
        Expect.intEq(use.usedAt(), 0LL);
        state.gyroX = 900;
        state.accelZ = 16000;
        state.leftStickX = 6000;
        use.see(state, 200LL);
        Expect.intEq(use.usedAt(), 0LL);
        state.leftStickX = 9000;
        use.see(state, 300LL);
        Expect.intEq(use.usedAt(), 300LL);
        state.buttons = PAD_A;
        use.see(state, 400LL);
        Expect.intEq(use.usedAt(), 400LL);
        Expect.isTrue(DeckpadUnitTests.toldIn(ScriptedPad(), 60) > 0);
        Expect.intEq(DeckpadUnitTests.toldIn(HeldPad(), 30), 0);
    }

    class int buttons(HidReport report) { return Wire.u16le(report.bytes, 2) | (Wire.u16le(report.bytes, 4) << 16); }

    class void stopChord() {
        HidReport report = HidReport();
        var pad = HeldPad();
        var device = VirtualController(pad, SteamController("FXDK00000042"), false);
        device.attach();
        Expect.isTrue(pad.opened);
        long long started = MonotonicClock.milliseconds();
        while (!device.stopRequested() && MonotonicClock.milliseconds() - started < 4000LL) { device.pump(8); }
        long long held = MonotonicClock.milliseconds() - started;
        Expect.isTrue(device.stopRequested() && held >= 1900LL && held < 3500LL);
        Expect.isTrue(device.input(report) && report.bytes.get(0) == STEAM_REPORT_BATTERY);
        Expect.isTrue(device.input(report) && DeckpadUnitTests.buttons(report) == PAD_B);
        var forwarding = VirtualController(HeldPad(), SteamController("FXDK00000042"), true);
        forwarding.attach();
        forwarding.pump(8);
        forwarding.input(report);
        Expect.isTrue(forwarding.input(report) && DeckpadUnitTests.buttons(report) == (PAD_B | PAD_QUICK_ACCESS));
    }

    // What `deckpad check` and `deckpad measure` conclude from report times.
    class void pace() {
        // 250 reports a second for two seconds, each 3 ms in transit, on a
        // sender's clock that wraps in the middle.
        ReportPace even = ReportPace();
        long long sender = 0xFFFFFFFFLL - 1000000LL;
        for (int index = 0; index < 500; index++) {
            even.arrivedAt(5000000LL + (long long)index * 4000LL + 3000LL);
            even.sent((sender + (long long)index * 4000LL) & 0xFFFFFFFFLL);
        }
        Expect.isTrue(even.count == 500 && even.longest == 4000LL && even.late == 0);
        Expect.isTrue(even.jitter() == 0LL && even.steady(2));

        // The same, with one report 30 ms late, the ones behind it arriving
        // in a bunch, and one report 2 ms quicker than the rest.
        ReportPace uneven = ReportPace();
        long long previous = 0LL;
        for (int index = 0; index < 500; index++) {
            long long delay = index == 100 ? 33000LL : (index == 300 ? 1000LL : 3000LL);
            long long arrival = 5000000LL + (long long)index * 4000LL + delay;
            if (arrival < previous) { arrival = previous; }
            previous = arrival;
            uneven.arrivedAt(arrival);
            uneven.sent((sender + (long long)index * 4000LL) & 0xFFFFFFFFLL);
        }
        Expect.intEq(uneven.jitter(), 32000LL);
        Expect.isTrue(uneven.late == 1 && uneven.longest == 34000LL && uneven.steady(2));

        // Too few reports, or a stall, is not steady.
        ReportPace slow = ReportPace();
        for (int index = 0; index < 100; index++) { slow.arrivedAt((long long)index * 20000LL); }
        Expect.isFalse(slow.steady(2));
        ReportPace stalled = ReportPace();
        for (int index = 0; index < 500; index++) { stalled.arrivedAt((long long)index * 4000LL + (index >= 250 ? 150000LL : 0LL)); }
        Expect.isTrue(!stalled.steady(2) && stalled.longest == 154000LL);
    }
}

int main() {
    DeckpadUnitTests.deckReport();
    DeckpadUnitTests.stateReport();
    DeckpadUnitTests.latch();
    DeckpadUnitTests.descriptors();
    DeckpadUnitTests.features();
    DeckpadUnitTests.effects();
    DeckpadUnitTests.controller();
    DeckpadUnitTests.usbDevice();
    DeckpadUnitTests.bluetoothPort();
    DeckpadUnitTests.pairing();
    DeckpadUnitTests.links();
    DeckpadUnitTests.stopChord();
    DeckpadUnitTests.use();
    DeckpadUnitTests.pace();
    print("PASS: deckpad reports, descriptors, feature commands, haptics, USB and Bluetooth views, pairing, shared links, stop chord, pad use and report pace");
    return 0;
}
