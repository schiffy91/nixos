import Library.Bytes;
import Library.CLI;
import Library.Network;
import Library.Timer;
import Library.USB;
import ../../lib/Check.btrc;

#include <poll.h>
#include <stdio.h>
#include <sys/wait.h>
#include <unistd.h>

// The Steam Deck's built-in controller, emulated: the same USB identity and
// three HID interfaces, a state report every 4 ms on the gamepad interface
// with A and d-pad up held, and a log of the feature commands it is sent.
// Attached through vhci_hcd, the kernel enumerates it like the real pad, so
// `deckpad serve --source deck` can be tested with no Deck.
class FakeDeckPad implements IUSBFunction {
    private string log;
    private long long lastReport = 0LL;
    private int sequence = 0;

    public FakeDeckPad(string log) { self.log = log; }

    // One vendor collection: a 64-byte input report and a 64-byte feature report.
    class Bytes reportDescriptor() {
        Bytes out = Bytes();
        int items[25] = {0x06, 0x00, 0xFF, 0x09, 0x01, 0xA1, 0x01, 0x15, 0x00, 0x26, 0xFF, 0x00, 0x75, 0x08, 0x95, 0x40, 0x09, 0x01, 0x81, 0x02, 0x09, 0x01, 0xB1, 0x02, 0xC0};
        for (int index = 0; index < 25; index++) { out.append(items[index]); }
        return out;
    }

    class USBDeviceDescription description() {
        int length = FakeDeckPad.reportDescriptor().length();
        return USBDeviceDescription(0x28DE, 0x1205, 0x0300).named("Valve Software", "Steam Deck Controller", "FAKEDECK0001")
            .add(USBInterface(0, 3, 0, 0).hid(length).endpoint(USBEndpoint(0x81, USB_TRANSFER_INTERRUPT, 64, 4)))
            .add(USBInterface(1, 3, 0, 0).hid(length).endpoint(USBEndpoint(0x82, USB_TRANSFER_INTERRUPT, 64, 4)))
            .add(USBInterface(2, 3, 0, 0).hid(length).endpoint(USBEndpoint(0x83, USB_TRANSFER_INTERRUPT, 64, 1)));
    }

    private void note(int number, int command) {
        FILE* file = fopen(self.log, "a");
        if (file == NULL) { return; }
        fprintf(file, "interface %d command %02x\n", number, command);
        fclose(file);
    }

    public int control(USBSetup setup, Bytes data) {
        if (setup.scope() == USB_REQUEST_STANDARD && setup.request == USB_REQUEST_GET_DESCRIPTOR && (setup.value >> 8) == USB_DESCRIPTOR_HID_REPORT) {
            Bytes descriptor = FakeDeckPad.reportDescriptor();
            data.appendBytes(descriptor);
            return descriptor.length();
        }
        if (setup.scope() != USB_REQUEST_CLASS) { return USB_CONTROL_STALL; }
        if (setup.request == 0x09) {
            if (data.length() > 0) { self.note(setup.index & 0xFF, data.get(0)); }
            return data.length();
        }
        if (setup.request == 0x01) {
            for (int index = 0; index < 64; index++) { data.append(0); }
            return 64;
        }
        return setup.request == 0x0A || setup.request == 0x0B ? 0 : USB_CONTROL_STALL;
    }

    public bool produce(int endpoint, Bytes packet) {
        long long now = MonotonicClock.milliseconds();
        if (endpoint != 0x83 || now - self.lastReport < 4LL) { return false; }
        self.lastReport = now;
        for (int index = 0; index < 64; index++) { packet.append(0); }
        packet.set(0, 0x01);
        packet.set(2, 0x09);
        packet.set(3, 0x40);
        packet.set(4, self.sequence & 0xFF);
        packet.set(8, 0x80);
        packet.set(9, 0x01);
        self.sequence++;
        return true;
    }

    public void consume(int endpoint, Bytes packet) {}
}

class FakeDeck {
    class void serve(TCPListener listener, string log, pid_t parent) {
        TCPStream? accepted = listener.accept(10000);
        if (accepted == null) { return; }
        USBIPExport exported = USBIPExport(USBVirtualDevice(FakeDeckPad.description(), FakeDeckPad(log)), accepted);
        while (exported.step() && (pid_t)getppid() == parent) {
            struct pollfd waiting;
            waiting.fd = exported.handle();
            waiting.events = POLLIN;
            waiting.revents = 0;
            poll(&waiting, (nfds_t)1, 2);
        }
    }

    // Export the pad from a child process and hand it to this machine's
    // virtual host controller; stay until that process ends.
    class void run(string log) {
        TCPListener listener = TCPListener.listen(IPv4Address.loopback(), 0);
        int port = listener.port();
        fflush(stdout);
        pid_t parent = getpid();
        pid_t child = fork();
        Check.that(child >= (pid_t)0, "the pad's process starts");
        if (child == (pid_t)0) {
            try { FakeDeck.serve(listener, log, parent); } catch (string error) {}
            _exit(0);
        }
        listener.close();
        USBIPHost host = USBIPHost(TCPStream.connect(IPv4Address.loopback(), port, 5000), 5000);
        USBIPAttachment.attach(host, host.importDevice("1-1"));
        int handed = host.connection().detach();
        if (handed >= 0) { close(handed); }
        print("the emulated Deck controller is attached");
        fflush(stdout);
        int status = 0;
        waitpid(child, &status, 0);
    }
}

int main(int argc, char** argv) {
    var args = CLIArgs(argc, argv);
    Check.that(args.count() == 1, "expected the command log's path");
    FakeDeck.run(args.get(0));
    return 0;
}
