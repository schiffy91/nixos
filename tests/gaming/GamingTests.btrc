import Library.Bytes;
import Library.CLI;
import Library.Console;
import Library.Digest;
import Library.FileSystem;
import Library.JSON;
import Library.Platform;
import Library.Process;
import ../../config/pkgs/gaming/steam/src/SteamConfiguration.btrc;
import ../../config/pkgs/gaming/steam/src/SteamShortcuts.btrc;
import ../../config/pkgs/gaming/wine/src/ActiveDisplay.btrc;
import ../../config/pkgs/gaming/wine/src/WinePrefix.btrc;
import Library.Testing;
import assetto.Assetto;
import assetto.GameSettings;
import assetto.ControlBindings;

class GamingTests {
    public string root;
    public string tools;

    public GamingTests() {
        self.root = FileSystem.tempDir("gaming-tests-");
        self.tools = Environment.get("GAMING_TOOLS", "");
        Expect.isTrue(!self.root.isEmpty());
    }

    public void vdf() {
        var text = "// comment\n\"root\" { apps { \"244210\" { LaunchOptions \"path\\\\with\\\"quote\" } } empty \"\" }";
        var parsed = SteamVdf(text).object();
        Expect.isTrue(parsed.get("root").get("apps").get("244210").get("LaunchOptions").asString().equals("path\\with\"quote"));
        Expect.isTrue(SteamVdf(SteamVdf.render(parsed)).object().stringify().equals(parsed.stringify()));
        for invalid in ["\"root\" {", "a \"unterminated", "a b }", "a b a c"] {
            var rejected = false;
            try { SteamVdf(invalid).object(); } catch (string error) { rejected = true; }
            Expect.isTrue(rejected);
        }
        print("PASS: Steam VDF parsing, escapes, and malformed input");
    }

    public void steam() {
        var steam = f"{self.root}/Steam";
        var library = f"{self.root}/Separate Library";
        ModTree.write(f"{steam}/steamapps/libraryfolders.vdf", "libraryfolders { 0 { path " + SteamVdf.quote(library) + " } }");
        for id in ["244210", "805550"] {
            ModTree.write(f"{library}/steamapps/appmanifest_{id}.acf", "AppState { name \"game\" StateFlags \"4\" installdir \"assettocorsa\" }");
        }
        var globalPath = f"{steam}/config/config.vdf";
        ModTree.write(globalPath, "InstallConfigStore { Software { Valve { Steam { CompatToolMapping { 0 { name keep-default } 805550 { name keep-acc } } } } } }");
        for user in ["1", "2"] {
            var key = user.equals("1") ? "apps" : "Apps";
            ModTree.write(f"{steam}/userdata/{user}/config/localconfig.vdf",
                "UserLocalConfigStore { Software { Valve { Steam { " + key + " { 805550 { LaunchOptions keep-acc } } } } } apps { 244210 { SteamControllerRumble -1 } 805550 { UseSteamControllerConfig 2 } } unrelated keep }");
        }
        var declaration = f"{self.root}/declared.json";
        var desired = JSONValue.makeObject();
        var app = JSONValue.makeObject();
        app.set("compatTool", JSONValue.makeString("proton-sge"));
        app.set("launchOptions", JSONValue.makeString("dpi exec -- assetto launch -- %command%"));
        desired.set("244210", app);
        for mode in ["disabled", "enabled", "default"] {
            app.set("steamInput", JSONValue.makeString(mode));
            ModTree.write(declaration, desired.stringify());
            var command = Command(f"{ShellWords.quote(self.tools)}/configure-steam-apps");
            command.flag("--steam-path", steam).flag("--default-tool", "unused").flag("--app-config", declaration).flag("--app-id", "244210");
            UnixShell().run(command.render(), throwOnFailure=true);
            var mapping = SteamVdf.at(SteamVdf.read(globalPath), ["InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping"]);
            Expect.isTrue(mapping.get("0").get("name").asString().equals("keep-default"));
            Expect.isTrue(mapping.get("805550").get("name").asString().equals("keep-acc"));
            Expect.isTrue(mapping.get("244210").get("name").asString().equals("proton-sge"));
            for user in ["1", "2"] {
                var path = f"{steam}/userdata/{user}/config/localconfig.vdf";
                var document = SteamVdf.read(path).get("UserLocalConfigStore");
                Expect.isTrue(document.get("apps").get("244210").get("UseSteamControllerConfig").asString().equals(SteamConfiguration.inputValue(mode)));
                Expect.isTrue(document.get("apps").get("244210").get("SteamControllerRumble").asString().equals("-1"));
                Expect.isTrue(document.get("apps").get("805550").get("UseSteamControllerConfig").asString().equals("2"));
                var apps = SteamVdf.at(document, ["Software", "Valve", "Steam", "apps"]);
                Expect.isTrue(apps.get("244210").get("LaunchOptions").asString().equals("dpi exec -- assetto launch -- %command%"));
                Expect.isTrue(!apps.get("244210").has("UseSteamControllerConfig"));
                Expect.isTrue(apps.get("805550").get("LaunchOptions").asString().equals("keep-acc"));
                var before = Path.readAll(path);
                UnixShell().run(command.render(), throwOnFailure=true);
                Expect.isTrue(Path.readAll(path).equals(before));
            }
        }
        Expect.isTrue(SteamLibrary(steam).game("244210").prefix().equals(f"{library}/steamapps/compatdata/244210/pfx"));
        for options in ["MODE=test %command%", "dpi exec -- assetto launch -- %command%"] {
            app.set("launchOptions", JSONValue.makeString(options));
            ModTree.write(declaration, desired.stringify());
            var command = Command(f"{ShellWords.quote(self.tools)}/configure-steam-apps");
            command.flag("--steam-path", steam).flag("--default-tool", "unused").flag("--app-config", declaration)
                .flag("--app-id", "244210").flag("--launch-wrapper", "game-run env");
            for (int attempt = 0; attempt < 2; attempt++) {
                UnixShell().run(command.render(), throwOnFailure=true);
                var apps = SteamVdf.at(SteamVdf.read(f"{steam}/userdata/1/config/localconfig.vdf"), ["UserLocalConfigStore", "Software", "Valve", "Steam", "apps"]);
                Expect.isTrue(apps.get("244210").get("LaunchOptions").asString().equals(f"game-run env {options}"));
                Expect.isTrue(apps.get("805550").get("LaunchOptions").asString().equals("keep-acc"));
            }
        }
        print("PASS: Steam CLI, separate library, account casing, controller modes, ACC isolation, idempotence");
    }

    public void shortcuts() {
        Expect.isTrue(SteamShortcuts.crc32("123456789") == 0xCBF43926L);
        var steam = f"{self.root}/Shortcuts Steam";
        ModTree.write(f"{steam}/userdata/1/config/localconfig.vdf", "UserLocalConfigStore { }");
        var foreign = SteamShortcut();
        SteamShortcuts.field(foreign.body, "appname", "Keep");
        SteamShortcuts.field(foreign.body, "exe", "\"/opt/keep\"");
        foreign.body.append(0);
        SteamShortcuts.cstring(foreign.body, "tags");
        SteamShortcuts.field(foreign.body, "0", "favorite");
        foreign.body.append(8);
        foreign.body.append(8);
        var stale = SteamShortcuts.create("Moonlight", "/usr/bin/flatpak");
        var played = SteamShortcuts.create("Chrome", "/run/current-system/sw/bin/google-chrome-stable");
        played.body.set(played.body.length() - 27, 123);
        var path = f"{steam}/userdata/1/config/shortcuts.vdf";
        ModTree.writeBytes(path, SteamShortcuts.render([foreign, stale, played]));
        var declaration = f"{self.root}/shortcuts.json";
        ModTree.write(declaration, "{\"Moonlight\":\"/run/current-system/sw/bin/moonlight\",\"Chrome\":\"/run/current-system/sw/bin/google-chrome-stable\",\"Semu\":\"/run/current-system/sw/bin/semu-es-de\"}");
        var command = Command(f"{ShellWords.quote(self.tools)}/install-steam-shortcuts");
        command.flag("--steam-path", steam).flag("--shortcuts", declaration);
        UnixShell().run(command.render(), throwOnFailure=true);
        var entries = SteamShortcuts(ModTree.read(path)).entries();
        Expect.isTrue(entries.len == 4);
        Expect.isTrue(entries.get(0).body.equals(foreign.body));
        Expect.isTrue(entries.get(1).body.equals(played.body));
        Expect.isTrue(entries.get(2).name.equals("Moonlight") && entries.get(2).exe.equals("\"/run/current-system/sw/bin/moonlight\""));
        Expect.isTrue(entries.get(3).body.equals(SteamShortcuts.create("Semu", "/run/current-system/sw/bin/semu-es-de").body));
        var before = ModTree.read(path);
        UnixShell().run(command.render(), throwOnFailure=true);
        Expect.isTrue(ModTree.read(path).equals(before));
        var icons = JSONValue.parse(Path.readAll(declaration));
        var chrome = JSONValue.makeObject();
        chrome.set("exe", JSONValue.makeString("/run/current-system/sw/bin/google-chrome-stable"));
        chrome.set("icon", JSONValue.makeString("/icons/Chrome Icon.png"));
        icons.set("Chrome", chrome);
        var newApp = JSONValue.makeObject();
        newApp.set("exe", JSONValue.makeString("/opt/new-game"));
        newApp.set("icon", JSONValue.makeString("/icons/new-game.png"));
        icons.set("New Game", newApp);
        ModTree.write(declaration, icons.stringify());
        UnixShell().run(command.render(), throwOnFailure=true);
        entries = SteamShortcuts(ModTree.read(path)).entries();
        Expect.isTrue(entries.len == 5);
        Expect.isTrue(entries.get(0).body.equals(foreign.body));
        Expect.isTrue(entries.get(1).icon.equals("/icons/Chrome Icon.png"));
        SteamShortcuts.setIcon(entries.get(1), "");
        Expect.isTrue(entries.get(1).body.equals(played.body)); // Every non-icon byte, including playtime, survived.
        Expect.isTrue(entries.get(4).name.equals("New Game") && entries.get(4).icon.equals("/icons/new-game.png"));
        before = ModTree.read(path);
        UnixShell().run(command.render(), throwOnFailure=true);
        Expect.isTrue(ModTree.read(path).equals(before));
        // Older/manual shortcuts can omit the icon field entirely.
        SteamShortcuts.setIcon(entries.get(0), "/icons/keep.png");
        var reparsed = SteamShortcuts(SteamShortcuts.render([entries.get(0)])).entries().get(0);
        Expect.isTrue(reparsed.icon.equals("/icons/keep.png") && reparsed.name.equals("Keep"));
        var artwork = f"{self.root}/Chrome Artwork";
        for filename in ["p", "landscape", "_hero", "_logo"] {
            ModTree.write(f"{artwork}/{filename}.png", filename);
        }
        chrome.set("artwork", JSONValue.makeString(artwork));
        icons.set("Chrome", chrome);
        ModTree.write(declaration, icons.stringify());
        // Steam may retain an ID that differs from the executable/name CRC.
        entries = SteamShortcuts(ModTree.read(path)).entries();
        for (int byte = 0; byte < 4; byte++) { entries.get(1).body.set(7 + byte, byte == 3 ? 128 : 0); }
        ModTree.writeBytes(path, SteamShortcuts.render(entries));
        before = ModTree.read(path);
        var grid = f"{steam}/userdata/1/config/grid";
        ModTree.write(f"{grid}/2147483648_hero.jpg", "custom-hero");
        UnixShell().run(command.render(), throwOnFailure=true);
        Expect.isTrue(ModTree.read(path).equals(before));
        Expect.isTrue(Path.readAll(f"{grid}/2147483648p.png").equals("p"));
        Expect.isTrue(Path.readAll(f"{grid}/2147483648.png").equals("landscape"));
        Expect.isTrue(Path.readAll(f"{grid}/2147483648_logo.png").equals("_logo"));
        Expect.isTrue(!FileSystem.exists(f"{grid}/2147483648_hero.png"));
        // New curated defaults replace only files still matching our ownership record.
        ModTree.write(f"{artwork}/landscape.png", "new-landscape");
        UnixShell().run(command.render(), throwOnFailure=true);
        Expect.isTrue(Path.readAll(f"{grid}/2147483648.png").equals("new-landscape"));
        // Recognize the exact old generator output even without an ownership record.
        ModTree.remove(f"{grid}/.nixos-artwork/2147483648_logo.sha256");
        var legacy = JSONValue.makeObject();
        legacy.set("_logo", JSONValue.makeString(SHA256.digestBytes(Bytes.fromString("_logo"))));
        ModTree.write(f"{artwork}/legacy.json", legacy.stringify());
        ModTree.write(f"{artwork}/_logo.png", "curated-logo");
        UnixShell().run(command.render(), throwOnFailure=true);
        Expect.isTrue(Path.readAll(f"{grid}/2147483648_logo.png").equals("curated-logo"));
        ModTree.write(f"{grid}/2147483648p.png", "custom-cover");
        ModTree.write(f"{grid}/2147483648.jpeg", "custom-landscape");
        ModTree.write(f"{artwork}/landscape.png", "third-landscape");
        UnixShell().run(command.render(), throwOnFailure=true);
        Expect.isTrue(Path.readAll(f"{grid}/2147483648p.png").equals("custom-cover"));
        Expect.isTrue(Path.readAll(f"{grid}/2147483648.jpeg").equals("custom-landscape"));
        Expect.isTrue(Path.readAll(f"{grid}/2147483648.png").equals("new-landscape"));
        // Two machines that declare one shortcut must not give it one number: Steam renumbers the local one at every start.
        var shared = SteamShortcuts.create("Chrome", "/run/current-system/sw/bin/google-chrome-stable");
        shared.body.set(shared.body.length() - 27, 123);
        var plain = SteamShortcuts.appid(shared.exe, "Chrome");  // what every machine gives it
        var chosen = SteamShortcuts.create("Moonlight", "/run/current-system/sw/bin/moonlight");
        for (int byte = 0; byte < 4; byte++) { chosen.body.set(7 + byte, byte == 3 ? 128 : 0); }  // a number Steam chose
        for machine in ["DECK", "DESKTOP"] {
            var home = f"{self.root}/Shortcuts {machine}";
            var file = f"{home}/userdata/1/config/shortcuts.vdf";
            var pictures = f"{home}/userdata/1/config/grid";
            ModTree.write(f"{home}/userdata/1/config/localconfig.vdf", "UserLocalConfigStore { }");
            ModTree.writeBytes(file, SteamShortcuts.render([foreign, shared, chosen]));
            ModTree.write(f"{pictures}/777_hero.png", "ours");  // placed for a number no shortcut has any more
            ModTree.write(f"{pictures}/.nixos-artwork/777_hero.sha256", SHA256.digestBytes(Bytes.fromString("ours")));
            ModTree.write(f"{pictures}/778_hero.png", "changed since");
            ModTree.write(f"{pictures}/.nixos-artwork/778_hero.sha256", SHA256.digestBytes(Bytes.fromString("ours")));
            var own = Command(f"{ShellWords.quote(self.tools)}/install-steam-shortcuts");
            own.flag("--steam-path", home).flag("--shortcuts", declaration).flag("--machine", machine);
            UnixShell().run(own.render(), throwOnFailure=true);
            var numbered = SteamShortcuts(ModTree.read(file)).entries();
            var number = SteamShortcuts.appid(shared.exe, "Chrome", machine);
            Expect.isTrue(numbered.len == 5 && numbered.get(0).body.equals(foreign.body));
            Expect.isTrue(numbered.get(1).id == number && number != plain);
            Expect.isTrue(numbered.get(2).id == 2147483648L);  // Steam's own choice stays
            Expect.isTrue(numbered.get(3).id == SteamShortcuts.appid(numbered.get(3).exe, numbered.get(3).name, machine));  // a new one starts with its own
            Expect.isTrue(Path.readAll(f"{pictures}/{number}_hero.png").equals("_hero"));
            Expect.isTrue(!FileSystem.exists(f"{pictures}/777_hero.png") && !FileSystem.exists(f"{pictures}/.nixos-artwork/777_hero.sha256"));
            Expect.isTrue(Path.readAll(f"{pictures}/778_hero.png").equals("changed since"));
            var settled = ModTree.read(file);
            UnixShell().run(own.render(), throwOnFailure=true);
            Expect.isTrue(ModTree.read(file).equals(settled));
            SteamShortcuts.setId(numbered.get(1), plain);
            SteamShortcuts.setIcon(numbered.get(1), "");
            Expect.isTrue(numbered.get(1).body.equals(shared.body));  // only the number and the icon changed: play time survived
        }
        Expect.isTrue(SteamShortcuts.appid(shared.exe, "Chrome", "DECK") != SteamShortcuts.appid(shared.exe, "Chrome", "DESKTOP"));
        var unknown = Bytes.fromString("not a shortcuts file");
        ModTree.writeBytes(path, unknown);
        Expect.isTrue(!UnixShell().run(command.render(), stderr=COMMAND_OUTPUT_COLLECT, logFailure=false).ok());
        Expect.isTrue(ModTree.read(path).equals(unknown));
        print("PASS: Steam shortcuts CRC, foreign entries byte for byte, stale replacement, icon updates preserve playtime, missing icon fields, idempotence, a number of the machine's own, pictures of numbers that are gone, unknown format refusal");
    }

    public void presetLinks() {
        var prefix = f"{self.root}/preset-prefix";
        var name = "Video Settings/FRACTAL-NORTH.cmpreset";
        var local = f"{prefix}/drive_c/users/steamuser/AppData/Local/AcTools Content Manager/Presets/{name}";
        var saved = f"{self.root}/Games/Assetto Corsa/FRACTAL-NORTH.cmpreset";
        var declaration = JSONValue.makeObject();
        declaration.set(name, JSONValue.makeString(saved));
        ModTree.write(local, "saved-settings");
        PresetLinks.apply(prefix, declaration);
        Expect.isTrue(FileSystem.isSymlink(local) && FileSystem.readLink(local).equals(saved));
        Expect.isTrue(Path.readAll(saved).equals("saved-settings"));
        Expect.isTrue(Path.writeAll(local, "changed-in-CM"));
        PresetLinks.apply(prefix, declaration);
        Expect.isTrue(Path.readAll(saved).equals("changed-in-CM"));
        PresetLinks.apply(prefix, JSONValue.makeObject());
        Expect.isTrue(!FileSystem.isSymlink(local) && Path.readAll(local).equals("changed-in-CM"));
        Expect.isTrue(Path.readAll(saved).equals("changed-in-CM"));
        ModTree.write(local, "different-local-settings");
        var rejected = false;
        try { PresetLinks.apply(prefix, declaration); } catch (string error) { rejected = error.contains("copies differ"); }
        Expect.isTrue(rejected && Path.readAll(saved).equals("changed-in-CM") && Path.readAll(local).equals("different-local-settings"));
        var invalid = JSONValue.makeObject();
        invalid.set("../escape.cmpreset", JSONValue.makeString(saved));
        rejected = false;
        try { PresetLinks.apply(prefix, invalid); } catch (string error) { rejected = true; }
        Expect.isTrue(rejected);
        var controls = "Controls/FRACTAL-NORTH.ini";
        var controlLocal = PresetLinks.path(prefix, controls);
        var controlSaved = f"{self.root}/Games/Assetto Corsa/Controls/FRACTAL-NORTH.ini";
        ModTree.write(controlLocal, "[STEER]\nAXLE=0\n");
        var controlDeclaration = JSONValue.makeObject();
        controlDeclaration.set(controls, JSONValue.makeString(controlSaved));
        PresetLinks.apply(prefix, controlDeclaration);
        Expect.isTrue(FileSystem.isSymlink(controlLocal) && Path.readAll(controlSaved).contains("AXLE=0"));
        Expect.isTrue(Path.writeAll(controlLocal, "[STEER]\nAXLE=1\n"));
        PresetLinks.apply(prefix, JSONValue.makeObject());
        Expect.isTrue(!FileSystem.isSymlink(controlLocal) && Path.readAll(controlLocal).contains("AXLE=1"));
        print("PASS: preset migration, writes through link, idempotence, disable, conflicts, traversal refusal");
    }

    public void contentDirectory() {
        var downloads = f"{self.root}/Games/Assetto Corsa";
        var cache = f"{self.root}/mod-cache";
        var fixture = f"{self.root}/archive-fixture";
        var game = f"{self.root}/directory-game";
        ModTree.directory(downloads);
        ModTree.write(f"{fixture}/wrapped/car/ui/ui_car.json", "{}");
        ModTree.write(f"{fixture}/wrapped/car/body.kn5", "car-model");
        ModTree.write(f"{fixture}/wrapped/track/ui/layout/ui_track.json", "{}");
        ModTree.write(f"{fixture}/wrapped/track/layout/models.ini", "track-layout");
        ModTree.write(f"{fixture}/wrapped/track/extension/ext_config.ini", "track-shaders");
        var archive = f"{downloads}/a mod.zip";
        UnixShell().run(Command("bsdtar").args(["--format=zip", "-cf", archive, "-C", fixture, "."]).render(), throwOnFailure=true);
        ModTree.copy(archive, f"{downloads}/duplicate.zip");
        var sources = ContentDirectory.sources(downloads, cache);
        Expect.isTrue(sources.len == 1);
        AssettoMods.reconcileSources(game, sources);
        Expect.isTrue(Path.readAll(f"{game}/content/cars/car/body.kn5").equals("car-model"));
        Expect.isTrue(Path.readAll(f"{game}/content/tracks/track/layout/models.ini").equals("track-layout"));
        Expect.isTrue(Path.readAll(f"{game}/content/tracks/track/extension/ext_config.ini").equals("track-shaders"));
        Expect.isTrue(!FileSystem.exists(f"{game}/a mod.zip"));
        // A loose duplicate is also harmless. A conflicting version must fail
        // before touching either the game or its ownership manifest.
        ModTree.write(f"{downloads}/content/cars/car/body.kn5", "car-model");
        AssettoMods.reconcileSources(game, ContentDirectory.sources(downloads, cache));
        var before = Path.readAll(f"{game}/.nix-assettocorsa/files.json");
        ModTree.write(f"{downloads}/content/cars/car/body.kn5", "other-version");
        var rejected = false;
        try { AssettoMods.reconcileSources(game, ContentDirectory.sources(downloads, cache)); } catch (string error) { rejected = error.contains("Conflicting mod versions"); }
        Expect.isTrue(rejected);
        Expect.isTrue(Path.readAll(f"{game}/content/cars/car/body.kn5").equals("car-model"));
        Expect.isTrue(Path.readAll(f"{game}/.nix-assettocorsa/files.json").equals(before));
        // Extraction must never follow a downloaded symlink into another tree.
        Expect.isTrue(FileSystem.symlink("/tmp", f"{fixture}/link") == 0);
        UnixShell().run(Command("bsdtar").args(["--format=zip", "-cf", f"{downloads}/unsafe.zip", "-C", fixture, "."]).render(), throwOnFailure=true);
        rejected = false;
        try { ContentDirectory.sources(downloads, cache); } catch (string error) { rejected = true; }
        Expect.isTrue(rejected);
        print("PASS: automatic archive layouts, duplicate downloads, loose content, conflict atomicity, unsafe archive refusal");
    }

    public void dpi() {
        var prefix = f"{self.root}/prefix";
        ModTree.write(f"{prefix}/user.reg", "WINE REGISTRY Version 2\n\n[Control Panel\\\\Desktop] 123\n\"LogPixels\"=dword:00000060\n\"keep\"=\"value\"\n\n[Other] 456\n\"keep\"=\"other\"\n");
        ModTree.write(f"{prefix}/system.reg", "WINE REGISTRY Version 2\n");
        WinePrefix(prefix).setDpi(240);
        Expect.isTrue(WinePrefix(prefix).dpi() == 240);
        var before = Path.readAll(f"{prefix}/user.reg");
        Expect.isTrue(before.contains("\"keep\"=\"value\""));
        Expect.isTrue(before.contains("[Other] 456"));
        WinePrefix(prefix).setDpi(240);
        Expect.isTrue(Path.readAll(f"{prefix}/user.reg").equals(before));
        var shell = UnixShell();
        var result = shell.run(f"WINEPREFIX={ShellWords.quote(prefix)} {ShellWords.quote(self.tools)}/wine-prefix-dpi exec --dpi 192 -- sh -c 'printf %s \"$1\"' sh 'argument with spaces'", throwOnFailure=true);
        Expect.isTrue(result.stdout().equals("argument with spaces"));
        Expect.isTrue(WinePrefix(prefix).dpi() == 192);
        var desk = "{\"outputs\":[{\"name\":\"DP-1\",\"enabled\":true,\"priority\":1,\"scale\":2.5},{\"name\":\"HDMI-A-1\",\"enabled\":true,\"priority\":2,\"scale\":1.75}]}";
        var stream = "{\"outputs\":[{\"name\":\"DP-1\",\"enabled\":false,\"priority\":0,\"scale\":2.5},{\"name\":\"Virtual-sunshine-vmon\",\"enabled\":true,\"priority\":1,\"scale\":1}]}";
        Expect.isTrue(ActiveDisplay.dpi(desk, 96) == 240);
        Expect.isTrue(ActiveDisplay.dpi(stream, 240) == 96);
        // Real KScreen JSON omits enabled on the active virtual output.
        Expect.isTrue(ActiveDisplay.dpi("{\"outputs\":[{\"name\":\"DP-1\",\"enabled\":false,\"priority\":2,\"scale\":2.5},{\"name\":\"Virtual-sunshine-vmon\",\"connected\":true,\"priority\":1,\"scale\":1}]}", 240) == 96);
        Expect.isTrue(ActiveDisplay.dpi("{\"outputs\":[{\"name\":\"DP-1\",\"connected\":true,\"priority\":1,\"scale\":2.5}]}", 96) == 240);
        Expect.isTrue(ActiveDisplay.dpi("{\"outputs\":[{\"enabled\":false,\"priority\":1,\"scale\":1}]}", 240) == 240);
        Expect.isTrue(ActiveDisplay.dpi("{\"outputs\":[{\"enabled\":true,\"priority\":1,\"scale\":40}]}", 240) == 240);
        Expect.isTrue(ActiveDisplay.dpi("not json", 240) == 240);
        result = shell.run(f"env -u WAYLAND_DISPLAY -u DISPLAY WINEPREFIX={ShellWords.quote(prefix)} {ShellWords.quote(self.tools)}/wine-prefix-dpi exec --dpi 144 --follow-display -- true", throwOnFailure=true);
        Expect.isTrue(WinePrefix(prefix).dpi() == 144);
        print("PASS: shared DPI CLI, registry preservation, exec arguments, live display scale with declared fallback");
    }

    public void mods() {
        Vector<string> hashPaths = [];
        for (int index = 0; index < 65; index++) {
            var path = f"{self.root}/hashes/file {index}\\\n.bin";
            ModTree.write(path, "abc");
            hashPaths.push(path);
        }
        var hashes = AssettoMods.digests(hashPaths);
        for path in hashPaths { Expect.isTrue(hashes.get(path).asString().equals("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")); }
        var game = f"{self.root}/game";
        var pack = f"{self.root}/pack";
        ModTree.write(f"{game}/font.ttf", "original");
        ModTree.write(f"{game}/unmanaged.ini", "keep");
        ModTree.write(f"{pack}/font.ttf", "mod");
        ModTree.write(f"{pack}/extension/patch.ini", "v1");
        AssettoMods.reconcile(game, pack);
        AssettoMods.reconcile(game, pack);
        ModTree.write(f"{pack}/extension/patch.ini", "v2");
        AssettoMods.reconcile(game, pack);
        Expect.isTrue(Path.readAll(f"{game}/extension/patch.ini").equals("v2"));
        ModTree.write(f"{game}/extension/patch.ini", "manual");
        ModTree.write(f"{pack}/new-file", "deploy");
        AssettoMods.reconcile(game, pack);
        Expect.isTrue(Path.readAll(f"{game}/extension/patch.ini").equals("manual"));
        Expect.isTrue(Path.readAll(f"{game}/new-file").equals("deploy"));
        var editedHash = AssettoMods.digest(f"{game}/extension/patch.ini");
        ModTree.write(f"{pack}/extension/patch.ini", "v3");
        AssettoMods.reconcile(game, pack);
        Expect.isTrue(Path.readAll(f"{game}/extension/patch.ini").equals("v3"));
        Expect.isTrue(Path.readAll(f"{game}/.nix-assettocorsa/edits/{editedHash}/extension/patch.ini").equals("manual"));
        ModTree.write(f"{game}/font.ttf", "edited-font");
        var fontHash = AssettoMods.digest(f"{game}/font.ttf");
        AssettoMods.reconcile(game, "");
        Expect.isTrue(Path.readAll(f"{game}/.nix-assettocorsa/edits/{fontHash}/font.ttf").equals("edited-font"));
        Expect.isTrue(Path.readAll(f"{game}/font.ttf").equals("original"));
        Expect.isTrue(Path.readAll(f"{game}/unmanaged.ini").equals("keep"));
        Expect.isTrue(!FileSystem.exists(f"{game}/extension/patch.ini"));
        ModTree.write(f"{game}/font.ttf", "steam-update");
        AssettoMods.reconcile(game, pack);
        AssettoMods.reconcile(game, "");
        Expect.isTrue(Path.readAll(f"{game}/font.ttf").equals("steam-update"));
        var outside = f"{self.root}/outside";
        ModTree.directory(outside);
        FileSystem.removeRecursive(f"{game}/extension");
        FileSystem.symlink(outside, f"{game}/extension");
        var rejected = false;
        try { AssettoMods.reconcile(game, pack); } catch (string error) { rejected = error.contains("symlink"); }
        Expect.isTrue(rejected && FileSystem.listDir(outside).len == 0);
        rejected = false;
        try { ModTree.inside(game, "../escape"); } catch (string error) { rejected = true; }
        Expect.isTrue(rejected);
        ModTree.write(f"{self.root}/other/FONT.ttf", "collision");
        rejected = false;
        try { AssettoMods.merge(f"{self.root}/merged", [pack, f"{self.root}/other"]); } catch (string error) { rejected = error.contains("overlap"); }
        Expect.isTrue(rejected);
        print("PASS: mod update/restore, runtime edits, upgrade/removal backups, originals, symlinks, traversal, collisions");
    }

    public void contentManager() {
        var text = "version: 2\nUserPreset\t";
        for (int i = 0; i < 50; i++) { text = text + "preserve-"; }
        var packed = ContentManager.packLzf(text);
        Expect.strEq(ContentManager.decode(packed), text);
        var deflated = ContentManager.packDeflate(text);
        Expect.strEq(ContentManager.decode(deflated), text);
        var prefix = f"{self.root}/cm-prefix";
        var folder = f"{prefix}/drive_c/users/steamuser/AppData/Local/AcTools Content Manager";
        ModTree.write(f"{folder}/Values.data", text);
        var game = f"{self.root}/cm-game";
        ModTree.write(f"{prefix}/system.reg", "WINE REGISTRY Version 2\n");
        ModTree.write(f"{game}/content/fonts/system/segoeui.ttf", "ui-font");
        ModTree.write(f"{game}/Content Manager.update.exe", "pending-update");
        ContentManager.configure(f"{self.root}/Steam", game, prefix);
        Expect.isTrue(Path.readAll(f"{prefix}/drive_c/windows/Fonts/segoeui.ttf").equals("ui-font"));
        Expect.isTrue(Path.readAll(f"{prefix}/system.reg").contains("\"dpiAwareness\"=dword:00000002"));
        var configured = ContentManager.entries(Path.readAll(f"{folder}/Values.data"));
        Expect.isTrue(configured.get("UserPreset").asString().equals(ContentManager.entries(text).get("UserPreset").asString()));
        Expect.isTrue(configured.get("Settings.CommonSettings.UpdatePeriod").asString().equals("00:00:00"));
        Expect.isTrue(configured.get("PatchUpdater.AutoUpdateMode").asString().equals("disabled"));
        Expect.isTrue(FileSystem.exists(f"{folder}/Values.before-nix"));
        Expect.isTrue(!FileSystem.exists(f"{game}/Content Manager.update.exe"));
        var command = Assetto.launchCommand(["runtime", "proton", "waitforexitandrun", f"{game}/AssettoCorsa.exe", "argument with spaces"], game);
        Expect.isTrue(command.get(0).equals("runtime") && command.get(1).equals("proton"));
        Expect.isTrue(command.get(3).equals(f"{game}/Content Manager.exe") && command.get(4).equals("argument with spaces"));
        Expect.isTrue(!Assetto.prerequisitesReady(prefix));
        ModTree.write(f"{prefix}/winetricks.log", "dotnet452\nd3dx11_43\nd3dcompiler_47\nwin10\n");
        Expect.isTrue(!Assetto.prerequisitesReady(prefix));
        ModTree.write(f"{prefix}/winetricks.log", "dotnet48\nd3dx11_43\nd3dcompiler_47\nwin10\n");
        Expect.isTrue(Assetto.prerequisitesReady(prefix));
        print("PASS: CM plain/LZF/DEFLATE, settings preservation, updater isolation, launch arguments, relay prerequisite guard");
    }

    public void launch() {
        var library = f"{self.root}/Separate Library";
        ModTree.write(f"{self.root}/Steam/steamapps/libraryfolders.vdf", "libraryfolders { 0 { path " + SteamVdf.quote(library) + " } }");
        ModTree.write(f"{library}/steamapps/appmanifest_244210.acf", "AppState { StateFlags 4 installdir assettocorsa }");
        var game = f"{library}/steamapps/common/assettocorsa";
        var prefix = f"{library}/steamapps/compatdata/244210/pfx";
        var pack = f"{self.root}/launch-pack";
        ModTree.write(f"{game}/acs.exe", "game");
        ModTree.write(f"{game}/AssettoCorsa.exe", "stock-launcher");
        ModTree.write(f"{pack}/Content Manager.exe", "cm");
        ModTree.write(f"{prefix}/user.reg", "WINE REGISTRY Version 2\n");
        ModTree.write(f"{prefix}/system.reg", "WINE REGISTRY Version 2\n");
        var capture = f"{self.root}/capture";
        ModTree.write(capture, "#!/bin/sh\nprintf '%s\\n' \"$@\" \"$PROTON_ENABLE_WAYLAND\" \"$PROTON_ENABLE_HDR\" \"$WINEDLLOVERRIDES\" \"$WINE_DBGHELP_OLD_PDB\"\n");
        FileSystem.chmod(capture, 0o755);
        var bindingFile = f"{self.root}/launch-bindings.json";
        ModTree.write(bindingFile, "[{\"action\":\"__CM_START_SESSION\",\"joystick\":0,\"button\":0,\"modifier\":null}]");
        var controls = f"{prefix}/drive_c/users/steamuser/Documents/Assetto Corsa/cfg/controls.ini";
        ModTree.write(controls, "[STEER]\nAXLE=0\n[BRAKES]\nAXLE=3\nGAMMA=2.4\n");
        var environment = f"STEAM_DIR={ShellWords.quote(self.root + "/Steam")} ASSETTO_UI_SCALE=2 ASSETTO_BRAKE_GAMMA=1 ASSETTO_CONTROL_BINDINGS={ShellWords.quote(bindingFile)} STEAM_COMPAT_DATA_PATH={ShellWords.quote(PathTools.dirname(prefix))} ASSETTO_MODS={ShellWords.quote(pack)} ASSETTO_WHEEL_LAUNCHER={ShellWords.quote(self.root + "/relay")}";
        // Steam's mixed-architecture overlay can print loader warnings on stderr.
        // Command now quotes argv[0], so an env-assignment prefix cannot go through
        // it; UnixShell.run already evaluates the string with /bin/sh -c.
        var launchPrefix = f"LD_PRELOAD=/nonexistent/nixos-gaming-test.so {environment} {ShellWords.quote(self.tools)}/wine-prefix-dpi exec --dpi 240 -- {ShellWords.quote(self.tools)}/assetto launch --";
        Vector<string> tail = [capture, "waitforexitandrun", f"{game}/AssettoCorsa.exe", "argument with spaces"];
        Vector<string> quotedTail = [];
        for value in tail { quotedTail.push(ShellWords.quote(value)); }
        var launch = launchPrefix + " " + quotedTail.join(" ");
        var result = UnixShell().run(launch, stderr=COMMAND_OUTPUT_COLLECT, throwOnFailure=true);
        Expect.isTrue(result.stdout().equals(f"waitforexitandrun\n{game}/Content Manager.exe\nargument with spaces\n0\n0\ndwrite=n,b\n1\n"));
        Expect.isTrue(WinePrefix(prefix).dpi() == 240);
        Expect.isTrue(Path.readAll(controls).contains("[__CM_START_SESSION]\n") && Path.readAll(controls).contains("BUTTON=0\n"));
        Expect.isTrue(Path.readAll(controls).contains("[BRAKES]\nAXLE=3\nGAMMA=1\n"));
        Expect.isTrue(Path.readAll(f"{prefix}/drive_c/users/steamuser/Documents/Assetto Corsa/cfg/extension/gui.ini").contains("UI_SCALE=2"));
        Expect.isTrue(Path.readAll(f"{game}/AssettoCorsa.exe").equals("stock-launcher"));
        ModTree.write(f"{game}/Content Manager.exe", "runtime-edit");
        Expect.isTrue(UnixShell().run(launch, stderr=COMMAND_OUTPUT_COLLECT, throwOnFailure=true).ok());
        Expect.isTrue(Path.readAll(f"{game}/Content Manager.exe").equals("runtime-edit"));
        ModTree.write(f"{prefix}/winetricks.log", "dotnet48\nd3dx11_43\nd3dcompiler_47\nwin10\n");
        ModTree.write(f"{self.root}/relay", "#!/bin/sh\nprintf 'relay-started\\n'\nexec \"$@\"\n");
        FileSystem.chmod(f"{self.root}/relay", 0o755);
        Expect.isTrue(UnixShell().run(launch, stderr=COMMAND_OUTPUT_COLLECT, throwOnFailure=true).stdout().startsWith("relay-started\n"));
        ModTree.write(f"{library}/steamapps/appmanifest_244210.acf", "AppState { StateFlags 1042 installdir assettocorsa }");
        Expect.isTrue(!UnixShell().run(launch, logFailure=false).ok());
        print("PASS: real DPI → Assetto CLI → Steam command, relay launch, unfinished download refusal");
    }

    public void gameSettings() {
        var prefix = f"{self.root}/settings-prefix";
        var path = f"{prefix}/drive_c/users/steamuser/Documents/Assetto Corsa/cfg/extension/gui.ini";
        var original = "; keep comment\r\n[NEW_UI]\r\n UI_SCALE = 1\r\nUI_SCALE=1.5\r\nSIMPLIFIED_RENDER=0\r\n[NEW_PAUSE_MENU]\r\nENABLED=0\r\nSHIFT_CAMERA=0\r\n[OTHER]\r\nUI_SCALE=0.7\r\n";
        ModTree.write(path, original);
        GameSettings.configure(prefix, "2");
        var updated = Path.readAll(path);
        Expect.isTrue(updated.contains("; keep comment\r\n") && updated.contains("SIMPLIFIED_RENDER=0\r\n"));
        Expect.isTrue(updated.contains("UI_SCALE=2\r\n") && updated.contains("REPLACE_MAIN_MENU=1\r\n"));
        Expect.isTrue(updated.contains("[NEW_PAUSE_MENU]\r\nENABLED=1\r\nSHIFT_CAMERA=0\r\n"));
        Expect.isTrue(updated.contains("[OTHER]\r\nUI_SCALE=0.7\r\n") && !updated.contains("UI_SCALE=1.5"));
        Expect.isTrue(Path.readAll(f"{path}.before-nix").equals(original));
        GameSettings.configure(prefix, "2");
        Expect.isTrue(Path.readAll(path).equals(updated));
        GameSettings.configure(prefix, "1.5");
        Expect.isTrue(Path.readAll(path).contains("UI_SCALE=1.5\r\n"));
        for invalid in ["0", "2.5", "invalid", "1\nBAD=1"] {
            var rejected = false;
            try { GameSettings.configure(prefix, invalid); } catch (string error) { rejected = true; }
            Expect.isTrue(rejected);
        }
        print("PASS: in-game UI scale, unrelated INI preservation, duplicates, backup, repeat application, invalid scale");
    }

    public void declaredGameSettings() {
        var prefix = f"{self.root}/declared-prefix";
        var cfg = f"{prefix}/drive_c/users/steamuser/Documents/Assetto Corsa/cfg";
        var video = "[VIDEO]\r\nVSYNC=0\r\nWIDTH=3840\r\n[POST_PROCESS]\r\nFILTER=default\r\n";
        ModTree.write(f"{cfg}/video.ini", video);
        var declared = JSONValue.parse("{\"video.ini\":{\"POST_PROCESS\":{\"FILTER\":\"PHOTOreal\"},\"VIDEO\":{\"VSYNC\":\"1\"}},\"extension/weather_fx.ini\":{\"BASIC\":{\"IMPLEMENTATION\":\"pure\"}}}");
        GameSettings.apply(prefix, declared);
        var updated = Path.readAll(f"{cfg}/video.ini");
        Expect.isTrue(updated.contains("VSYNC=1\r\nWIDTH=3840\r\n") && updated.contains("FILTER=PHOTOreal\r\n"));
        Expect.isTrue(Path.readAll(f"{cfg}/video.ini.before-nix").equals(video));
        Expect.isTrue(Path.readAll(f"{cfg}/extension/weather_fx.ini").contains("[BASIC]\nIMPLEMENTATION=pure\n"));
        GameSettings.apply(prefix, declared);
        Expect.isTrue(Path.readAll(f"{cfg}/video.ini").equals(updated));
        for invalid in ["{\"../x.ini\":{}}", "{\"/x.ini\":{}}", "{\"x.txt\":{}}", "{\"x.ini\":{\"A\":{\"K\":1}}}", "{\"x.ini\":{\"A\":{\"K\":\"1\\nBAD=1\"}}}"] {
            var rejected = false;
            try { GameSettings.apply(prefix, JSONValue.parse(invalid)); } catch (string error) { rejected = true; }
            Expect.isTrue(rejected);
        }
        print("PASS: declared video/CSP INI keys, preservation, backup, repeat application, path/value validation");
    }

    public void controlBindings() {
        var original = "[CONTROLLERS]\nCON0=Logitech PRO\n[STEER]\nAXLE=0\nFF_GAIN=0.4\n[__CM_TO_PITS]\nJOY=-1\nBUTTON=-1\nKEY=17\n";
        var bindings = JSONValue.parse("[{\"action\":\"__CM_TO_PITS\",\"joystick\":0,\"button\":2,\"modifier\":7}]");
        var updated = ControlBindings.update(original, bindings);
        Expect.isTrue(updated.contains("AXLE=0\nFF_GAIN=0.4\n") && updated.contains("KEY=17\n"));
        Expect.isTrue(updated.contains("JOY_MODIFICATOR=0") && updated.contains("BUTTON_MODIFICATOR=7"));
        Expect.isTrue(ControlBindings.update(updated, bindings).equals(updated));
        var prefix = f"{self.root}/bindings-prefix";
        var active = f"{prefix}/drive_c/users/steamuser/Documents/Assetto Corsa/cfg/controls.ini";
        var local = PresetLinks.path(prefix, "Controls/test.ini");
        var external = f"{self.root}/external-controls.ini";
        ModTree.write(active, original); ModTree.write(local, original);
        var presets = JSONValue.makeObject(); presets.set("Controls/test.ini", JSONValue.makeString(external));
        PresetLinks.apply(prefix, presets);
        ControlBindings.configure(prefix, bindings, presets);
        Expect.isTrue(FileSystem.isSymlink(local) && Path.readAll(external).equals(updated));
        Expect.isTrue(Path.readAll(active).equals(updated) && Path.readAll(f"{active}.before-nix-bindings").equals(original));
        ControlBindings.configure(prefix, bindings, presets);
        Expect.isTrue(Path.readAll(f"{external}.before-nix-bindings").equals(original));
        bindings.push(bindings.at(0));
        var rejected = false;
        try { ControlBindings.configure(prefix, bindings, presets); } catch (string error) { rejected = true; }
        Expect.isTrue(rejected && Path.readAll(active).equals(updated));
        var extended = JSONValue.parse("[{\"action\":\"ABSUP\",\"joystick\":0,\"button\":null,\"modifier\":null},{\"action\":\"ABSDN\",\"joystick\":0,\"button\":null,\"modifier\":null},{\"action\":\"__EXT_WIPERS_MORE\",\"joystick\":0,\"button\":21,\"modifier\":7},{\"action\":\"ABS\",\"joystick\":0,\"button\":24,\"modifier\":7}]");
        ControlBindings.configure(prefix, extended, presets, "1");
        var configured = Path.readAll(active);
        var compact = configured.replace("\n\n", "\n");
        Expect.isTrue(compact.contains("[ABSUP]\nJOY=-1\nBUTTON=-1") && compact.contains("[ABSDN]\nJOY=-1\nBUTTON=-1"));
        Expect.isTrue(configured.contains("[BRAKES]\nGAMMA=1") && configured.contains("AXLE=0\nFF_GAIN=0.4"));
        var general = f"{prefix}/drive_c/users/steamuser/Documents/Assetto Corsa/cfg/extension/general.ini";
        var gui = f"{prefix}/drive_c/users/steamuser/Documents/Assetto Corsa/cfg/extension/gui.ini";
        Expect.isTrue(Path.readAll(general).contains("BINARY_MODIFIERS_FILTERING2=1"));
        Expect.isTrue(Path.readAll(gui).contains("CONTROLLER_INTEGRATION_PITS=1"));
        Expect.isTrue(Path.readAll(gui).contains("CONTROLLER_INTEGRATION_REPLAY=1"));
        Expect.isTrue(Path.readAll(external).equals(configured));
        for invalid in ["0", "6", "invalid", "1\nBAD=1"] {
            rejected = false;
            try { ControlBindings.configure(prefix, extended, presets, invalid); } catch (string error) { rejected = true; }
            Expect.isTrue(rejected && Path.readAll(active).equals(configured));
        }
        // A native AC action cannot acquire a modifier just by adding INI keys.
        var nativeModifier = JSONValue.parse("[{\"action\":\"GEARUP\",\"joystick\":0,\"button\":4,\"modifier\":7}]");
        rejected = false;
        try { ControlBindings.configure(prefix, nativeModifier, presets); } catch (string error) { rejected = true; }
        Expect.isTrue(rejected && Path.readAll(active).equals(configured));
        // A modifier must not fire a standalone action when first pressed.
        var conflict = JSONValue.parse("{\"action\":\"ACTION_HORN\",\"joystick\":0,\"button\":7,\"modifier\":null}");
        extended.push(conflict);
        rejected = false;
        try { ControlBindings.configure(prefix, extended, presets); } catch (string error) { rejected = true; }
        Expect.isTrue(rejected && Path.readAll(active).equals(configured));
        print("PASS: wheel bindings, modifiers, unbinding, brake gamma, CSP navigation, axis preservation, backups, preset links, conflict refusal");
    }
}

int main(int argc, char** argv) {
    var tests = GamingTests();
    var suite = CLIArgs(argc, argv).command();
    var all = suite.isEmpty();
    if (all || suite.equals("steam")) { tests.vdf(); tests.steam(); tests.shortcuts(); }
    if (all || suite.equals("wine")) { tests.dpi(); }
    if (all || suite.equals("assetto")) {
        tests.mods(); tests.contentDirectory(); tests.presetLinks(); tests.contentManager();
        tests.gameSettings(); tests.declaredGameSettings(); tests.controlBindings();
    }
    if (all || suite.equals("integration")) { tests.launch(); }
    if (!all && !suite.equals("steam") && !suite.equals("wine") && !suite.equals("assetto") && !suite.equals("integration")) {
        print(f"Unknown gaming test suite: {suite}");
        FileSystem.removeRecursive(tests.root);
        return 1;
    }
    FileSystem.removeRecursive(tests.root);
    return 0;
}
