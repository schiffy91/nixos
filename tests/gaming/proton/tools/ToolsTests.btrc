import Library.Testing;
import proton.Capture;

int main() {
    var options = ProtonOptions(["launch", "--seconds", "3", "--env", "VALUE=a=b", "--env", "OTHER=two words"]);
    Expect.intEq(options.number("--seconds", 0), 3);
    Expect.intEq(options.environment.length, 2);
    Expect.strEq(options.environment.get(0), "VALUE=a=b");
    var inlineOptions = ProtonOptions(["launch", "--seconds=3", "--env=VALUE=a=b"]);
    Expect.intEq(inlineOptions.number("--seconds", 0), 3);
    Expect.strEq(inlineOptions.environment.get(0), "VALUE=a=b");
    Expect.throws(() => { var missing = ProtonOptions(["launch", "--seconds"]); });
    var environment = ["FIRST=old", "SECOND=kept"];
    ProtonRuntime.set(environment, "FIRST", "new=value");
    Expect.intEq(environment.length, 2);
    Expect.strEq(ProtonRuntime.value(environment, "FIRST"), "new=value");
    var bytes = Bytes.fromString("ONE=one"); bytes.append(0); bytes.appendBytes(Bytes.fromString("TWO=two words")); bytes.append(0);
    Expect.intEq(ProtonRuntime.environmentEntries(bytes).length, 2);
    // procfs reports size zero even though environ contains NUL-separated data.
    var current = ProtonRuntime.environmentEntries(ProtonRuntime.procBytes(f"/proc/{Platform.pid()}/environ"));
    Expect.isTrue(current.length > 0);
    Expect.strEq(ProtonRuntime.value(current, "PATH"), Environment.get("PATH", ""));
    Expect.intEq(ProtonRuntime.procBytes("/proc/no-such-process/environ").length, 0);
    Expect.strEq(ProtonRuntime.logDestination("/tmp/launch.wrapper.log"), "/tmp/launch.proton.log");
    Expect.strEq(ProtonRuntime.logDestination("/tmp/smoke.log"), "/tmp/smoke.proton.log");
    var artifacts = ProtonWine.artifacts(ProtonWine.targets());
    Expect.intEq(artifacts.length, 12);
    Expect.strEq(artifacts.get(0).relative, "x86_64-unix/ntdll.so");
    Expect.strEq(ProtonWine.artifacts(["dlls/winewayland.drv/all"]).get(1).buildRelative, "dlls/winewayland.drv/x86_64-windows/winewayland.drv");
    Expect.throws(() => { ProtonWine.artifacts(["unknown/all"]); });
    var window = ProtonCapture.geometry("Position: -10.2,20.8\nGeometry: 800x600\n");
    Expect.isTrue(window.x == -10 && window.y == 21 && window.width == 800 && window.height == 600);
    var screen = ProtonCapture.screen("Output: 1\n enabled\n Geometry: 1920,0 800x600\nOutput: 2\n enabled\n Geometry: 0,0 1920x1080\n");
    Expect.isTrue(screen.width == 1920 && screen.height == 1080);
    Expect.isTrue(ProtonCapture.points("battle-net").length == 11 && ProtonCapture.points("chat").length == 8);
    Expect.strEq(ProtonContext.quote("a'b"), "'a'\\''b'");
    print("PASS: Proton options, environment, log paths, artifact mapping, geometry and capture profiles");
    return 0;
}
