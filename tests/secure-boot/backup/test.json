{
  "name": "secure-boot-backup",
  "state": "secure-boot-backup",
  "stateMaterial": "secure-boot-backup:{{arch}}:drv={{derivation}}",
  "derivation": "tests/secure-boot/backup",
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "operations": [
    {
      "op": "build-derivation",
      "command": "--cores 4 --max-jobs 1",
      "timeout": 1800
    },
    {
      "op": "record-state"
    }
  ]
}
