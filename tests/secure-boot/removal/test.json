{
  "name": "secure-boot-removal",
  "state": "secure-boot-removal",
  "stateMaterial": "secure-boot-removal:{{arch}}:drv={{derivation}}",
  "derivation": "tests/secure-boot/removal",
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "operations": [
    {
      "op": "build-derivation",
      "command": "--cores 4 --max-jobs 2",
      "timeout": 1800
    },
    {
      "op": "record-state"
    }
  ]
}
