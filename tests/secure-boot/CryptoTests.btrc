import Library.CLI;
import Library.FileSystem;
import Library.Console;
import keys.Crypto;
import ../lib/Check.btrc;
import ./AlarmState.btrc;

int main(int argc, char** argv) {
    try {
        Check.equal(KeyCrypto.guid(Bytes.fromString("{AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE}\n")), "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee", "canonical GUID");
        var rejected = false;
        try { KeyCrypto.guid(Bytes.fromString("not a GUID")); } catch (string error) { rejected = true; }
        Check.that(rejected, "reject invalid GUID");
        var args = CLIArgs(argc, argv);
        if (args.count() == 1 && args.get(0).equals("--deadline")) {
            AlarmState.ignoreAndBlock();
            KeyCrypto.limitVerification(1);
            AlarmState.wait();
            return 99;
        }
        if (args.count() != 2) { throw "Usage: crypto-tests <private-key> <certificate>"; }
        print(KeyCrypto.verifyPair(FileSystem.readBytes(args.get(0)), FileSystem.readBytes(args.get(1))));
        return 0;
    } catch (string error) { Console.error(error); return 1; }
}
