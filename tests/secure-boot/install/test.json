{
  "name": "secure-boot-install",
  "state": "installed-secure-boot",
  "parentState": "installer-ssh",
  "stateMaterial": "secure-boot-install:{{arch}}:{{isoUrl}}:{{diskSize}}:boot={{bootTarget}}:secure={{secureBoot}}:tpm2={{tpm2}}:source={{sourceHash}}",
  "args": {
    "immutabilityVersion": "v2",
    "immutabilityImplementation": "immutability",
    "immutabilityMode": "reset",
    "immutabilityEnabled": "true",
    "bootTarget": "Secure-Boot",
    "secureBoot": "true",
    "tpm2": "true"
  },
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "diskSize": "30G",
  "memory": "8G",
  "cpus": 4,
  "sshPort": 2227,
  "operations": [
    { "op": "require-state" },
    { "op": "reset-state" },
    { "op": "inherit-state" },
    { "op": "validate-immutability-v2" },
    { "op": "require-tpm2" },
    { "op": "require-secure-boot" },
    { "op": "restore", "name": "live-ssh" },
    { "op": "boot-iso" },
    { "op": "wait-ssh", "timeout": 180 },
    { "op": "guest", "command": "set -e; test -d /sys/class/tpm/tpm0; cat /sys/class/tpm/tpm0/tpm_version_major", "expect": "2" },
    { "op": "copy-workspace", "local": ".", "remote": "/etc/nixos" },
    { "op": "configure-vm-host" },
    { "op": "install-nixos" },
    { "op": "prepare-secure-boot-first-boot" },
    { "op": "stop" },
    { "op": "boot-disk" },
    { "op": "sleep", "timeout": 15 },
    { "op": "serial-send", "command": "testpass123" },
    { "op": "sleep", "timeout": 7 },
    { "op": "serial-send", "command": "testpass123" },
    { "op": "sleep", "timeout": 7 },
    { "op": "serial-send", "command": "testpass123" },
    { "op": "wait-ssh", "timeout": 300 },
    { "op": "enroll-secure-boot" },
    { "op": "stop" },
    { "op": "boot-disk" },
    { "op": "sleep", "timeout": 15 },
    { "op": "serial-send", "command": "testpass123" },
    { "op": "sleep", "timeout": 7 },
    { "op": "serial-send", "command": "testpass123" },
    { "op": "sleep", "timeout": 7 },
    { "op": "serial-send", "command": "testpass123" },
    { "op": "wait-ssh", "timeout": 300 },
    { "op": "guest", "command": "bootctl status", "expect": "Secure Boot: enabled" },
    { "op": "snapshot", "name": "installed-secure-boot" },
    { "op": "record-state" },
    { "op": "stop" }
  ]
}
