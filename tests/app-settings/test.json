{
  "name": "app-settings",
  "state": "app-settings",
  "parentState": "quick",
  "stateMaterial": "app-settings:{{arch}}:source={{sourceHash}}",
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "operations": [
    { "op": "require-state" },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.settings.apps.enable",
      "expect": "true"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.settings.apps.dev.enable",
      "expect": "true"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.settings.apps.gaming.enable",
      "expect": "true"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.settings.apps.btrsmith.enable",
      "expect": "false"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.settings.apps.utils.enable",
      "expect": "true"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.settings.apps.steam.enable",
      "expect": "true"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.programs.steam.enable",
      "expect": "true"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.settings.apps.sunshine.enable",
      "expect": "true"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.services.sunshine.enable",
      "expect": "true"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.settings.apps.nixosctl.enable",
      "expect": "true"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.settings.nixosctl.configPath",
      "expect": "nixosctl.toml"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.settings.users.agent.enable",
      "expect": "true"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.users.users.agent.isNormalUser",
      "expect": "true"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.users.users.agent.group",
      "expect": "agent"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.home-manager.users.agent.programs.direnv.enable",
      "expect": "true"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.settings.disk.immutability.persist.paths",
      "expect": "/home/agent/work"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.settings.disk.immutability.nonPersistedGenerations",
      "expect": "3"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.FRACTAL-NORTH-Standard-Boot.config.settings.disk.immutability.restoreGeneration",
      "expect": "1"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.QEMU-{{arch}}-Standard-Boot.config.settings.apps.enable",
      "expect": "false"
    },
    { "op": "record-state" }
  ]
}
