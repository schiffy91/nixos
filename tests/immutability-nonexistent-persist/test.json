{
  "name": "immutability-nonexistent-persist",
  "state": "immutability-nonexistent-persist",
  "parentState": "installed-reset",
  "stateMaterial": "immutability-nonexistent-persist:{{immutabilityVersion}}:{{immutabilityImplementation}}:ram={{memory}}:cpus={{cpus}}",
  "args": {
    "immutabilityVersion": "v2",
    "immutabilityImplementation": "immutability",
    "immutabilityMode": "reset"
  },
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "memory": "8G",
  "cpus": 4,
  "sshPort": 2237,
  "operations": [
    { "op": "require-state" },
    { "op": "reset-state" },
    { "op": "inherit-state" },
    { "op": "validate-immutability-v2" },
    { "op": "restore", "name": "installed" },
    { "op": "boot-disk" },
    { "op": "wait-ssh", "timeout": 180 },
    { "op": "guest", "command": "set -e; test ! -e /opt/missing-persist-target && printf source-absent", "expect": "source-absent" },
    { "op": "guest", "command": "set -e; sed -i 's|\"/etc/nixos\"|\"/etc/nixos\" \"/opt/missing-persist-target\"|' /etc/nixos/nix/hosts/{{arch}}/VM-TEST/VM-TEST.nix; grep -q 'opt/missing-persist-target' /etc/nixos/nix/hosts/{{arch}}/VM-TEST/VM-TEST.nix && printf spec-edited", "expect": "spec-edited" },
    { "op": "guest", "command": "nixos-rebuild switch --flake /etc/nixos#VM-TEST-Standard-Boot && printf switched", "expect": "switched", "timeout": 1800 },
    { "op": "guest", "command": "grep -q 'opt/missing-persist-target' /etc/immutability/spec.tsv && printf spec-has-path", "expect": "spec-has-path" },
    { "op": "reboot-disk" },
    { "op": "guest", "command": "btrfs subvolume list / | grep -q 'dirs/opt!missing-persist-target' && printf has-subvol || printf no-subvol", "expect": "no-subvol" },
    { "op": "guest", "command": "btrfs subvolume list / | grep -E 'files/.*opt.*missing-persist-target' && printf has-file-store || printf no-file-store", "expect": "no-file-store" },
    { "op": "guest", "command": "test ! -e /opt/missing-persist-target && printf path-still-absent", "expect": "path-still-absent" },
    { "op": "guest", "command": "btrfs subvolume list / | grep -q 'dirs/etc!nixos' && printf existing-kept", "expect": "existing-kept" },
    { "op": "guest", "command": "test -e /etc/nixos && printf etc-nixos-mounted", "expect": "etc-nixos-mounted" },
    { "op": "snapshot", "name": "nonexistent-persist-tested" },
    { "op": "record-state" },
    { "op": "stop" }
  ]
}
