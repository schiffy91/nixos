{
  "name": "immutability-nonexistent-persist",
  "state": "immutability-nonexistent-persist",
  "parentState": "installed-reset",
  "stateMaterial": "immutability-nonexistent-persist:{{immutabilityVersion}}:{{immutabilityImplementation}}:ram={{memory}}:cpus={{cpus}}",
  "args": {
    "immutabilityVersion": "v2",
    "immutabilityImplementation": "immutability",
    "immutabilityMode": "reset"
  },
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "memory": "8G",
  "cpus": 4,
  "sshPort": 2237,
  "operations": [
    { "op": "require-state" },
    { "op": "reset-state" },
    { "op": "inherit-state" },
    { "op": "validate-immutability-v2" },
    { "op": "restore", "name": "installed" },
    { "op": "boot-disk" },
    { "op": "wait-ssh", "timeout": 180 },
    { "op": "guest", "command": "set -e; test ! -e /var/lib/missing-persist-target && printf source-absent", "expect": "source-absent" },
    { "op": "guest", "command": "set -e; sed -i 's|\"/var/lib/sbctl\"|\"/var/lib/sbctl\" \"/var/lib/missing-persist-target\"|' /etc/nixos/nix/hosts/{{arch}}/VM-TEST/VM-TEST.nix; grep -q 'missing-persist-target' /etc/nixos/nix/hosts/{{arch}}/VM-TEST/VM-TEST.nix && printf spec-edited", "expect": "spec-edited" },
    { "op": "guest", "command": "nixos-rebuild boot --flake /etc/nixos#VM-TEST-Standard-Boot && printf built", "expect": "built", "timeout": 1800 },
    { "op": "reboot-disk" },
    { "op": "guest", "command": "btrfs subvolume list / | grep -q 'dirs/var!lib!missing-persist-target' && printf subvol-created", "expect": "subvol-created" },
    { "op": "guest", "command": "btrfs subvolume list / | grep -q 'dirs/etc!nixos' && printf existing-kept", "expect": "existing-kept" },
    { "op": "guest", "command": "btrfs subvolume list / | grep -q 'dirs/var!lib!nixos' && printf var-nixos-kept", "expect": "var-nixos-kept" },
    { "op": "guest", "command": "set -e; if [ -e /var/lib/missing-persist-target ]; then [ -d /var/lib/missing-persist-target ] && [ \"$(ls -A /var/lib/missing-persist-target 2>/dev/null | wc -l)\" -eq 0 ] && printf mounted-empty; else printf source-still-absent; fi", "expect": "mounted-empty" },
    { "op": "snapshot", "name": "nonexistent-persist-tested" },
    { "op": "record-state" },
    { "op": "stop" }
  ]
}
