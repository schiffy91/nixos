import Library.CLI;
import ../../vm/Lab.btrc;
import ../Fixture.btrc;

// The delete brake inside a folder kept on another volume. A batch deleted there waits in that volume's own trash;
// a no brings it back onto the volume, a yes lets a second batch through, and nothing outside the batch is touched
// here or on the Drive.
class PlacedHeldScenario {
    private DriveFixture drive;
    private Guest machine;
    private string mount;
    private string library;
    private string place = "--place Games/Library=/sd/drive";
    private string engine = "--quiet 1 --machine TEST --budget-files 0 --delete-limit 3 --pin Games/Library --place Games/Library=/sd/drive";

    public PlacedHeldScenario(Guest machine) {
        self.machine = machine;
        self.drive = DriveFixture(machine);
        self.mount = self.drive.mount;
        self.library = f"{self.mount}/Games/Library";
    }

    private string held() { return self.drive.drive("held"); }

    private void waits() { self.machine.waitUntil(f"drive held --runtime {self.drive.runtime} | grep -q '  here$'"); }  // a row for something deleted here

    private string files() { return self.machine.succeed(f"cd {self.mount} && find . -type f | LC_ALL=C sort | tr '\\n' ' '").trim(); }

    private string device(string path) { return self.machine.succeed(f"stat -c %d {path}").trim(); }

    private void prepare() {
        self.drive.prepare();
        self.machine.succeed(f"head -c 100000 /dev/urandom > {self.drive.source}/rom && printf 'a save\\n' > {self.drive.source}/save");
        self.drive.startFake();
        string library = self.drive.folder(self.drive.folder("root", "Games"), "Library");
        self.drive.put(library, "rom.bin", "rom");
        for folder in ["Saves", "Old", "Stays"] {
            string id = self.drive.folder(library, folder);
            for (int number = 1; number <= 5; number++) { self.drive.put(id, f"{folder}-{number}.sav", "save"); }
        }
        self.drive.put(self.drive.folder("root", "Other"), "Other-1.sav", "save");
        self.machine.succeed("mkdir -p /sd && truncate -s 300M /var/lib/sd.img && mkfs.ext4 -q /var/lib/sd.img && mount -o loop /var/lib/sd.img /sd && mkdir /sd/drive");
        self.drive.startEngine(self.engine);
        self.drive.startDoor(self.place);
        self.drive.drive("place Games/Library");
        self.machine.waitUntil(f"drive status --runtime {self.drive.runtime} | grep -q ' 0 to download' && cmp -s /sd/drive/tree/Saves/Saves-5.sav {self.drive.source}/save && cmp -s /sd/drive/tree/rom.bin {self.drive.source}/rom");
        self.machine.waitUntil(f"cmp -s {self.library}/rom.bin {self.drive.source}/rom");  // the door looks for the volume every two seconds
        self.machine.succeed(f"cat {self.mount}/Other/Other-1.sav > /dev/null");
    }

    private void kept() {
        print("A batch of deletions inside the placed folder is held");
        string everything = self.files();
        self.drive.freeze(true);
        self.machine.succeed(f"rm -r {self.library}/Saves");
        self.drive.freeze(false);
        self.waits();
        string held = self.held();
        Check.that(held.contains("Games/Library/Saves/Saves-3.sav") && held.contains("Games/Library/Saves/ ") && held.contains("6 waiting"), f"`drive held` lists the folder and its five files by their place in the Drive:\n{held}");
        Check.equal(self.drive.trashed(), "", "nothing is trashed on the Drive");
        Check.equal(self.machine.succeed(f"ls /sd/drive/trash | wc -l; ls {self.drive.store}/trash | wc -l").trim(), "6\n0", "what was deleted waits in the volume's own trash, not on the main disk");

        print("A no brings the folder and its files back onto the volume");
        string answer = self.drive.drive("keep");
        Check.that(answer.contains("6 entries are coming back"), f"`drive keep` says what it did: {answer}");
        self.machine.waitUntil(f"test \"$(ls {self.library}/Saves | wc -l)\" = 5 && drive status --runtime {self.drive.runtime} | grep -q ' 0 to download' && cmp -s /sd/drive/tree/Saves/Saves-3.sav {self.drive.source}/save", 60);
        Check.equal(self.files(), everything, "every file is where it was");
        Check.equal(self.device("/sd/drive/tree/Saves/Saves-3.sav"), self.device("/sd"), "what came back is on the volume");
        Check.equal(self.machine.succeed(f"ls -A {self.drive.store}/tree/Games/Library | wc -l").trim(), "0", "and nothing of the folder is on the main disk");
        Check.equal(self.drive.state("Other/Other-1.sav"), "local", "a file outside the folder was not touched");
        Check.equal(self.drive.trashed(), "", "nothing was trashed on the Drive");
        Check.that(self.held().contains("No deletions are waiting") && !self.drive.drive("status").contains("deletions held"), "and nothing is held any more");
    }

    private void letThrough() {
        print("A second batch is held again, and a yes lets it through");
        self.drive.freeze(true);
        self.machine.succeed(f"rm {self.library}/Old/*.sav");
        self.drive.freeze(false);
        self.waits();
        string held = self.held();
        Check.that(held.contains("Games/Library/Old/Old-4.sav") && held.contains("5 waiting"), f"the five files are held:\n{held}");
        Check.equal(self.drive.trashed(), "", "nothing is trashed on the Drive before the yes");
        self.drive.drive("resume");
        self.machine.waitUntil(f"test \"$(curl -sS -X POST '{self.drive.fake}/__control/dump' | grep -o '\"trashed\":true' | wc -l)\" = 5 && drive status --runtime {self.drive.runtime} | grep -q ' 0 changes to send'");

        print("Nothing outside the batch was touched, here or on the Drive");
        Check.equal(self.drive.trashed(), "Old-1.sav Old-2.sav Old-3.sav Old-4.sav Old-5.sav", "the Drive's trash holds the five files and nothing more");
        Check.equal(self.files(), "./Games/Library/Saves/Saves-1.sav ./Games/Library/Saves/Saves-2.sav ./Games/Library/Saves/Saves-3.sav ./Games/Library/Saves/Saves-4.sav ./Games/Library/Saves/Saves-5.sav ./Games/Library/Stays/Stays-1.sav ./Games/Library/Stays/Stays-2.sav ./Games/Library/Stays/Stays-3.sav ./Games/Library/Stays/Stays-4.sav ./Games/Library/Stays/Stays-5.sav ./Games/Library/rom.bin ./Other/Other-1.sav", "every other file is still here");
        Check.equal(self.machine.succeed(f"ls {self.library} | LC_ALL=C sort | tr '\\n' ' '").trim(), "Old Saves Stays rom.bin", "and so is the folder the five were in");
        self.machine.succeed(f"cmp {self.library}/rom.bin {self.drive.source}/rom && cmp {self.library}/Stays/Stays-2.sav {self.drive.source}/save && cmp {self.library}/Saves/Saves-1.sav {self.drive.source}/save && cmp {self.mount}/Other/Other-1.sav {self.drive.source}/save");
        Check.that(self.drive.onDrive("Stays-2.sav", self.drive.sha(f"{self.drive.source}/save")) && self.drive.onDrive("Saves-1.sav", self.drive.sha(f"{self.drive.source}/save")) && self.drive.onDrive("rom.bin", self.drive.sha(f"{self.drive.source}/rom")), "the Drive still has the rest as it was");
        Check.that(self.held().contains("No deletions are waiting"), "and nothing is held any more");
    }

    public void check() {
        self.prepare();
        self.kept();
        self.letThrough();
    }
}

int main(Vector<string> args) {
    try {
        var lab = Lab(CLIArgs.from(args).require(0, "Supply VM descriptor"));
        PlacedHeldScenario(lab.guest("machine")).check();
        lab.close();
        print("PASS: deletions in a folder on another volume are held, come back onto it with a no and go with a yes");
        return 0;
    } catch (string error) {
        print(error);
        return 1;
    }
    return 1;
}
