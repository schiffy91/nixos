import ../vm/Lab.btrc;

// A guest running the fake Drive, the engine and the door, for the scenarios to act on.
class DriveFixture {
    public Guest machine;
    public string fake = "http://127.0.0.1:18475";
    public string store = "/var/lib/drive-test/store";
    public string mount = "/mnt/drive";
    public string source = "/var/lib/drive-test/source";
    public string runtime = "/run/drive-test";
    public string unit = "drive";  // the engine is <unit>-engine, the door <unit>-door

    public DriveFixture(Guest machine) { self.machine = machine; }

    public string control(string action) { return self.machine.succeed(f"curl -sS -H Expect: -X POST '{self.fake}/__control/{action}'"); }

    public string folder(string parent, string name) { return self.machine.succeed(f"curl -sS -X POST '{self.fake}/__control/put?parent={parent}&name={name}&type=application%2Fvnd.google-apps.folder' | grep -o '\"id\":\"[^\"]*\"' | head -1 | cut -d'\"' -f4").trim(); }

    public void change(string id, string file) { self.machine.succeed(f"curl -sS -H Expect: -X POST '{self.fake}/__control/put?id={id}' --data-binary @{self.source}/{file} -o /dev/null"); }  // another machine writes new content

    public void put(string parent, string name, string file) { self.machine.succeed(f"curl -sS -H Expect: -X POST '{self.fake}/__control/put?parent={parent}&name={name}' --data-binary @{self.source}/{file} -o /dev/null"); }

    public string asked() { return self.machine.succeed(f"curl -sS -X POST '{self.fake}/__control/log?clear=1' | grep 'bytes=' || true"); }

    public string state(string path) { return self.machine.succeed(f"getfattr --absolute-names -n user.drive.state --only-values {self.store}/tree/{path}"); }

    // What the fake Drive holds under a name: one line per entry, "id parent size sha256 trashed".
    public string remote(string name) { return self.machine.succeed(f"curl -sS -X POST '{self.fake}/__control/dump' | python3 /var/lib/drive-test/entries.py '{name}'"); }

    public bool onDrive(string name, string sha) { return self.remote(name).contains(f" {sha} False"); }

    public string sha(string path) { return self.machine.succeed(f"sha256sum < {path} | cut -d' ' -f1").trim(); }

    public string id(string path) { return self.machine.succeed(f"getfattr --absolute-names -n user.drive.id --only-values {self.store}/tree/{path} 2>/dev/null || true").trim(); }

    public void prepare() {
        self.machine.waitForUnit("multi-user.target");
        self.machine.succeed(f"mkdir -p {self.source} {self.mount} {self.runtime}");
        self.machine.succeed("printf 'import json, sys\nfor e in json.load(sys.stdin):\n    if e[\"name\"] == sys.argv[1]:\n        print(e[\"id\"], (e.get(\"parents\") or [\"-\"])[0], e.get(\"size\", \"-\"), e.get(\"sha256Checksum\", \"-\"), e[\"trashed\"])\n' > /var/lib/drive-test/entries.py");
        self.machine.succeed("echo '{\"client_id\":\"c\",\"client_secret\":\"s\",\"refresh_token\":\"refresh-ok\"}' > /var/lib/drive-test/credentials.json");
    }

    public void startFake() {
        self.machine.succeed("systemd-run --unit drive-fake --collect drive-fake 18475");
        self.machine.waitUntil(f"curl -sS -X POST '{self.fake}/__control/log' >/dev/null");
    }

    public void startEngine(string extra = "") {
        self.machine.succeed(f"systemd-run --unit {self.unit}-engine --collect drive engine --store {self.store} --runtime {self.runtime} --credentials /var/lib/drive-test/credentials.json --api {self.fake} --chunk 65536 --follow 1 {extra}");
        self.machine.waitUntil(f"test -s {self.store}/position && test -S {self.runtime}/engine.sock");
    }

    public void startDoor(string extra = "") {
        self.machine.succeed(f"systemd-run --unit {self.unit}-door --collect drive door --store {self.store} --mount {self.mount} --runtime {self.runtime} --allow-others {extra}");
        self.machine.waitUntil(f"mountpoint -q {self.mount}");
        self.connected();
    }

    public void connected() { self.machine.waitUntil(f"drive status --runtime {self.runtime} | grep -q 'door connected'"); }  // the engine has found the door

    public void stop(string unit) { self.machine.succeed(f"systemctl kill --signal=KILL {unit}.service || true; systemctl stop {unit}.service 2>/dev/null || true; systemctl reset-failed {unit}.service 2>/dev/null || true"); }

    public string drive(string command) { return self.machine.succeed(f"drive {command} --runtime {self.runtime}"); }
}
