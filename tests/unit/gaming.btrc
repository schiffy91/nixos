import Library.Bytes;
import Library.CLI;
import Library.Console;
import Library.FileSystem;
import Library.JSON;
import Library.Platform;
import Library.Process;
import ../../btrc/gaming/steam/configuration.btrc;
import ../../btrc/gaming/wine/prefix.btrc;
import assetto.launcher;

#include <assert.h>

class GamingTests {
    public string root;
    public string tools;

    public GamingTests() {
        self.root = FileSystem.tempDir("gaming-tests-");
        self.tools = Environment.get("GAMING_TOOLS", "");
        assert(!self.root.isEmpty());
    }

    public void vdf() {
        var text = "// comment\n\"root\" { apps { \"244210\" { LaunchOptions \"path\\\\with\\\"quote\" } } empty \"\" }";
        var parsed = SteamVdf(text).object();
        assert(parsed.get("root").get("apps").get("244210").get("LaunchOptions").asString().equals("path\\with\"quote"));
        assert(SteamVdf(SteamVdf.render(parsed)).object().stringify().equals(parsed.stringify()));
        for invalid in ["\"root\" {", "a \"unterminated", "a b }", "a b a c"] {
            var rejected = false;
            try { SteamVdf(invalid).object(); } catch (string error) { rejected = true; }
            assert(rejected);
        }
        print("PASS: Steam VDF parsing, escapes, and malformed input");
    }

    public void steam() {
        var steam = f"{self.root}/Steam";
        var library = f"{self.root}/Separate Library";
        GamingFiles.write(f"{steam}/steamapps/libraryfolders.vdf", "libraryfolders { 0 { path " + SteamVdf.quote(library) + " } }");
        for id in ["244210", "805550"] {
            GamingFiles.write(f"{library}/steamapps/appmanifest_{id}.acf", "AppState { name \"game\" StateFlags \"4\" installdir \"assettocorsa\" }");
        }
        var globalPath = f"{steam}/config/config.vdf";
        GamingFiles.write(globalPath, "InstallConfigStore { Software { Valve { Steam { CompatToolMapping { 0 { name keep-default } 805550 { name keep-acc } } } } } }");
        for user in ["1", "2"] {
            var key = user.equals("1") ? "apps" : "Apps";
            GamingFiles.write(f"{steam}/userdata/{user}/config/localconfig.vdf",
                "UserLocalConfigStore { Software { Valve { Steam { " + key + " { 805550 { LaunchOptions keep-acc } } } } } apps { 244210 { SteamControllerRumble -1 } 805550 { UseSteamControllerConfig 2 } } unrelated keep }");
        }
        var declaration = f"{self.root}/declared.json";
        var desired = JSONValue.makeObject();
        var app = JSONValue.makeObject();
        app.set("compatTool", JSONValue.makeString("proton-custom"));
        app.set("launchOptions", JSONValue.makeString("dpi exec -- assetto launch -- %command%"));
        desired.set("244210", app);
        for mode in ["disabled", "enabled", "default"] {
            app.set("steamInput", JSONValue.makeString(mode));
            GamingFiles.write(declaration, desired.stringify());
            var command = Command(f"{UnixShell.quote(self.tools)}/configure-steam-apps");
            command.flag("--steam-path", steam).flag("--default-tool", "unused").flag("--app-config", declaration).flag("--app-id", "244210");
            UnixShell().run(command.render(), throwOnFailure=true);
            var mapping = SteamVdf.at(SteamVdf.read(globalPath), ["InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping"]);
            assert(mapping.get("0").get("name").asString().equals("keep-default"));
            assert(mapping.get("805550").get("name").asString().equals("keep-acc"));
            assert(mapping.get("244210").get("name").asString().equals("proton-custom"));
            for user in ["1", "2"] {
                var path = f"{steam}/userdata/{user}/config/localconfig.vdf";
                var document = SteamVdf.read(path).get("UserLocalConfigStore");
                assert(document.get("apps").get("244210").get("UseSteamControllerConfig").asString().equals(SteamConfiguration.inputValue(mode)));
                assert(document.get("apps").get("244210").get("SteamControllerRumble").asString().equals("-1"));
                assert(document.get("apps").get("805550").get("UseSteamControllerConfig").asString().equals("2"));
                var apps = SteamVdf.at(document, ["Software", "Valve", "Steam", "apps"]);
                assert(apps.get("244210").get("LaunchOptions").asString().equals("dpi exec -- assetto launch -- %command%"));
                assert(!apps.get("244210").has("UseSteamControllerConfig"));
                assert(apps.get("805550").get("LaunchOptions").asString().equals("keep-acc"));
                var before = Path.readAll(path);
                UnixShell().run(command.render(), throwOnFailure=true);
                assert(Path.readAll(path).equals(before));
            }
        }
        assert(SteamLibrary(steam).game("244210").prefix().equals(f"{library}/steamapps/compatdata/244210/pfx"));
        print("PASS: Steam CLI, separate library, account casing, controller modes, ACC isolation, idempotence");
    }

    public void dpi() {
        var prefix = f"{self.root}/prefix";
        GamingFiles.write(f"{prefix}/user.reg", "WINE REGISTRY Version 2\n\n[Control Panel\\\\Desktop] 123\n\"LogPixels\"=dword:00000060\n\"keep\"=\"value\"\n\n[Other] 456\n\"keep\"=\"other\"\n");
        GamingFiles.write(f"{prefix}/system.reg", "WINE REGISTRY Version 2\n");
        WinePrefix(prefix).setDpi(240);
        assert(WinePrefix(prefix).dpi() == 240);
        var before = Path.readAll(f"{prefix}/user.reg");
        assert(before.contains("\"keep\"=\"value\""));
        assert(before.contains("[Other] 456"));
        WinePrefix(prefix).setDpi(240);
        assert(Path.readAll(f"{prefix}/user.reg").equals(before));
        var shell = UnixShell();
        var result = shell.run(f"WINEPREFIX={UnixShell.quote(prefix)} {UnixShell.quote(self.tools)}/wine-prefix-dpi exec --dpi 192 -- sh -c 'printf %s \"$1\"' sh 'argument with spaces'", throwOnFailure=true);
        assert(result.stdout().equals("argument with spaces"));
        assert(WinePrefix(prefix).dpi() == 192);
        print("PASS: shared DPI CLI, registry preservation, exec arguments");
    }

    public void mods() {
        Vector<string> hashPaths = [];
        for (int index = 0; index < 65; index++) {
            var path = f"{self.root}/hashes/file {index}\\\n.bin";
            GamingFiles.write(path, "abc");
            hashPaths.push(path);
        }
        var hashes = AssettoMods.digests(hashPaths);
        for path in hashPaths { assert(hashes.get(path).asString().equals("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")); }
        var game = f"{self.root}/game";
        var pack = f"{self.root}/pack";
        GamingFiles.write(f"{game}/font.ttf", "original");
        GamingFiles.write(f"{game}/unmanaged.ini", "keep");
        GamingFiles.write(f"{pack}/font.ttf", "mod");
        GamingFiles.write(f"{pack}/extension/patch.ini", "v1");
        AssettoMods.reconcile(game, pack);
        AssettoMods.reconcile(game, pack);
        GamingFiles.write(f"{pack}/extension/patch.ini", "v2");
        AssettoMods.reconcile(game, pack);
        assert(Path.readAll(f"{game}/extension/patch.ini").equals("v2"));
        GamingFiles.write(f"{game}/extension/patch.ini", "manual");
        GamingFiles.write(f"{pack}/new-file", "must not deploy");
        var rejected = false;
        try { AssettoMods.reconcile(game, pack); } catch (string error) { rejected = error.contains("changed outside Nix"); }
        assert(rejected && !FileSystem.exists(f"{game}/new-file"));
        GamingFiles.write(f"{game}/extension/patch.ini", "v2");
        AssettoMods.reconcile(game, "");
        assert(Path.readAll(f"{game}/font.ttf").equals("original"));
        assert(Path.readAll(f"{game}/unmanaged.ini").equals("keep"));
        assert(!FileSystem.exists(f"{game}/extension/patch.ini"));
        GamingFiles.write(f"{game}/font.ttf", "steam-update");
        AssettoMods.reconcile(game, pack);
        AssettoMods.reconcile(game, "");
        assert(Path.readAll(f"{game}/font.ttf").equals("steam-update"));
        var outside = f"{self.root}/outside";
        GamingFiles.directory(outside);
        FileSystem.removeRecursive(f"{game}/extension");
        FileSystem.symlink(outside, f"{game}/extension");
        rejected = false;
        try { AssettoMods.reconcile(game, pack); } catch (string error) { rejected = error.contains("symlink"); }
        assert(rejected && FileSystem.listDir(outside).len == 0);
        rejected = false;
        try { GamingFiles.inside(game, "../escape"); } catch (string error) { rejected = true; }
        assert(rejected);
        GamingFiles.write(f"{self.root}/other/FONT.ttf", "collision");
        rejected = false;
        try { AssettoMods.merge(f"{self.root}/merged", [pack, f"{self.root}/other"]); } catch (string error) { rejected = error.contains("overlap"); }
        assert(rejected);
        print("PASS: mod update/restore, originals, unmanaged files, edited-file refusal, symlinks, traversal, collisions");
    }

    public void contentManager() {
        var text = "version: 2\nUserPreset\t";
        for (int i = 0; i < 50; i++) { text = text + "preserve-"; }
        var raw = Bytes.fromString(text);
        char output[4096];
        unsigned int length = lzf_compress(raw.data, (unsigned int)raw.length(), output, 4096);
        assert(length > 0);
        var packed = Bytes(); packed.append(11); packed.appendRaw(output, (int)length);
        assert(ContentManager.decode(packed).equals(text));
        unsigned long compressedLength = 4096;
        assert(compress2((unsigned char*)output, &compressedLength, (unsigned char*)raw.data, (unsigned long)raw.length(), 6) == cmZlibOk);
        var deflated = Bytes(); deflated.append(0); deflated.appendRaw(output + 2, (int)compressedLength - 6);
        assert(ContentManager.decode(deflated).equals(text));
        var prefix = f"{self.root}/cm-prefix";
        var folder = f"{prefix}/drive_c/users/steamuser/AppData/Local/AcTools Content Manager";
        GamingFiles.write(f"{folder}/Values.data", text);
        var game = f"{self.root}/cm-game";
        GamingFiles.write(f"{game}/Content Manager.update.exe", "pending-update");
        ContentManager.configure(f"{self.root}/Steam", game, prefix);
        var configured = ContentManager.entries(Path.readAll(f"{folder}/Values.data"));
        assert(configured.get("UserPreset").asString().equals(ContentManager.entries(text).get("UserPreset").asString()));
        assert(configured.get("Settings.CommonSettings.UpdatePeriod").asString().equals("00:00:00"));
        assert(configured.get("PatchUpdater.AutoUpdateMode").asString().equals("disabled"));
        assert(FileSystem.exists(f"{folder}/Values.before-nix"));
        assert(!FileSystem.exists(f"{game}/Content Manager.update.exe"));
        var command = Assetto.launchCommand(["runtime", "proton", "waitforexitandrun", f"{game}/AssettoCorsa.exe", "argument with spaces"], game);
        assert(command.get(0).equals("runtime") && command.get(1).equals("proton"));
        assert(command.get(3).equals(f"{game}/Content Manager.exe") && command.get(4).equals("argument with spaces"));
        assert(!Assetto.prerequisitesReady(prefix));
        GamingFiles.write(f"{prefix}/winetricks.log", "dotnet452\nd3dx11_43\nd3dcompiler_47\nwin10\n");
        assert(!Assetto.prerequisitesReady(prefix));
        GamingFiles.write(f"{prefix}/winetricks.log", "dotnet48\nd3dx11_43\nd3dcompiler_47\nwin10\n");
        assert(Assetto.prerequisitesReady(prefix));
        print("PASS: CM plain/LZF/DEFLATE, settings preservation, updater isolation, launch arguments, relay prerequisite guard");
    }

    public void launch() {
        var library = f"{self.root}/Separate Library";
        var game = f"{library}/steamapps/common/assettocorsa";
        var prefix = f"{library}/steamapps/compatdata/244210/pfx";
        var pack = f"{self.root}/launch-pack";
        GamingFiles.write(f"{game}/acs.exe", "game");
        GamingFiles.write(f"{game}/AssettoCorsa.exe", "stock-launcher");
        GamingFiles.write(f"{pack}/Content Manager.exe", "cm");
        GamingFiles.write(f"{prefix}/user.reg", "WINE REGISTRY Version 2\n");
        GamingFiles.write(f"{prefix}/system.reg", "WINE REGISTRY Version 2\n");
        var capture = f"{self.root}/capture";
        GamingFiles.write(capture, "#!/bin/sh\nprintf '%s\\n' \"$@\" \"$PROTON_ENABLE_WAYLAND\" \"$PROTON_ENABLE_HDR\" \"$WINEDLLOVERRIDES\"\n");
        FileSystem.chmod(capture, 0755);
        var environment = f"STEAM_DIR={UnixShell.quote(self.root + "/Steam")} ASSETTO_MODS={UnixShell.quote(pack)} ASSETTO_WHEEL_LAUNCHER={UnixShell.quote(self.root + "/relay")} STEAM_COMPAT_DATA_PATH={UnixShell.quote(PathTools.dirname(prefix))}";
        // Steam's mixed-architecture overlay can print loader warnings on stderr.
        var command = Command(f"LD_PRELOAD=/nonexistent/nixos-gaming-test.so {environment} {UnixShell.quote(self.tools)}/wine-prefix-dpi exec --dpi 240 -- {UnixShell.quote(self.tools)}/assetto launch --");
        command.arg(capture).arg("waitforexitandrun").arg(f"{game}/AssettoCorsa.exe").arg("argument with spaces");
        var result = UnixShell().run(command.render(), stderr=CommandOutput.collect(), throwOnFailure=true);
        assert(result.stdout().equals(f"waitforexitandrun\n{game}/Content Manager.exe\nargument with spaces\n0\n0\ndwrite=n,b\n"));
        assert(WinePrefix(prefix).dpi() == 240);
        assert(Path.readAll(f"{game}/AssettoCorsa.exe").equals("stock-launcher"));
        GamingFiles.write(f"{prefix}/winetricks.log", "dotnet48\nd3dx11_43\nd3dcompiler_47\nwin10\n");
        GamingFiles.write(f"{self.root}/relay", "#!/bin/sh\nprintf 'relay-started\\n'\nexec \"$@\"\n");
        FileSystem.chmod(f"{self.root}/relay", 0755);
        assert(UnixShell().run(command.render(), stderr=CommandOutput.collect(), throwOnFailure=true).stdout().startsWith("relay-started\n"));
        GamingFiles.write(f"{library}/steamapps/appmanifest_244210.acf", "AppState { StateFlags 1042 installdir assettocorsa }");
        assert(!UnixShell().run(command.render(), logFailure=false).ok());
        print("PASS: real DPI → Assetto CLI → Steam command, relay launch, unfinished download refusal");
    }
}

int main() {
    var tests = GamingTests();
    tests.vdf(); tests.steam(); tests.dpi(); tests.mods(); tests.contentManager(); tests.launch();
    FileSystem.removeRecursive(tests.root);
    return 0;
}
