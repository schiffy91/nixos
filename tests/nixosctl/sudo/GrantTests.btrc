import ../../../config/system/nixos/sudo/Grant.btrc;
#include <assert.h>

int main() {
    assert(SudoGrant.duration("1s") == 1);
    assert(SudoGrant.duration("90m") == 5400);
    assert(SudoGrant.duration("24h") == 86400);
    assert(SudoGrant.duration("86400s") == 86400);
    for value in ["", "0s", "01s", "-1h", "25h", "86401s", "1d", "1 h", "999999s", "1h;id", "1.5h"] {
        var rejected = false;
        try { SudoGrant.duration(value); } catch (string error) { rejected = true; }
        assert(rejected);
    }
    assert(SudoGrant.expiry("#expires 1800000000") == 1800000000LL);
    for value in ["", "expires 1", "#expires -1", "#expires 1 extra", "#expires 9999999999999999999"] {
        var rejected = false;
        try { SudoGrant.expiry(value); } catch (string error) { rejected = true; }
        assert(rejected);
    }
    print("PASS: sudo duration bounds, units, injection rejection and expiration parsing");
    return 0;
}
