import Library.CLI;
import ../../vm/Lab.btrc;
int main(int argc, char** argv) {
    try {
        var lab = Lab(CLIArgs(argc, argv).require(0, "VM descriptor")); var machine = lab.guest("machine");
        machine.waitForUnit("multi-user.target"); machine.succeed("runuser -u operator -- op --version");
        machine.succeed("test $(stat -c %U:%G:%a /run/wrappers/bin/op) = root:onepassword-cli:2511; test $(stat -c %U:%G:%a /run/wrappers/bin/1Password-BrowserSupport) = root:onepassword:2511; test $(stat -c %U:%a /srv/operator/.config/1Password/ssh/agent.toml) = operator:600");
        machine.succeed("runuser -u operator -- grep -F 'vault = \"Private\"' /srv/operator/.config/1Password/ssh/agent.toml"); machine.fail("test -e /home/operator/.config/1Password");
        machine.succeed("grep -F unix-user:operator /run/current-system/sw/share/polkit-1/actions/com.1password.1Password.policy");
        // A real agent exercises PAM's signature exchange without a vault in CI.
        machine.succeed("runuser -u operator -- mkdir -p /srv/operator/.1password; runuser -u operator -- ssh-keygen -q -t ed25519 -N '' -f /srv/operator/key; mkdir -p /etc/ssh/authorized_keys.d; cp /srv/operator/key.pub /etc/ssh/authorized_keys.d/operator");
        machine.succeed("runuser -u operator -- ssh-agent -a /srv/operator/.1password/agent.sock; runuser -u operator -- env SSH_AUTH_SOCK=/srv/operator/.1password/agent.sock ssh-add /srv/operator/key");
        machine.fail("runuser -u operator -- env SSH_AUTH_SOCK=/missing-agent sudo -k -S true </dev/null");
        machine.succeed("runuser -u operator -- env -u __NIXOS_SET_ENVIRONMENT_DONE SSH_AUTH_SOCK=/wrong-agent bash -lc 'test \"$SSH_AUTH_SOCK\" = /srv/operator/.1password/agent.sock; sudo -k -S id -u </dev/null | grep -x 0'");
        machine.succeed("runuser --pty -u operator -- env SSH_AUTH_SOCK=/wrong-agent bash -ic 'test \"$SSH_AUTH_SOCK\" = /srv/operator/.1password/agent.sock; sudo -k -S id -u </dev/null | grep -x 0'");
        machine.succeed("runuser --pty -u operator -- env SSH_AUTH_SOCK=/wrong-agent zsh -ic 'test \"$SSH_AUTH_SOCK\" = /srv/operator/.1password/agent.sock; sudo -k -S id -u </dev/null | grep -x 0'");
        machine.succeed("runuser --pty -u operator -- env SSH_CONNECTION='192.0.2.1 1234 192.0.2.2 22' SSH_AUTH_SOCK=/forwarded-agent zsh -ic 'test \"$SSH_AUTH_SOCK\" = /forwarded-agent'");
        machine.succeed("env -u __NIXOS_SET_ENVIRONMENT_DONE SSH_AUTH_SOCK=/invoking-agent bash -lc 'test \"$SSH_AUTH_SOCK\" = /invoking-agent'");
        machine.reboot(); machine.waitForShutdown(); machine.start(); machine.waitForUnit("multi-user.target");
        machine.succeed("runuser -u operator -- op --version; test $(stat -c %U:%G:%a /run/wrappers/bin/op) = root:onepassword-cli:2511");
        machine.succeed("runuser -u operator -- env -u __NIXOS_SET_ENVIRONMENT_DONE SSH_AUTH_SOCK=/wrong-agent bash -lc 'test \"$SSH_AUTH_SOCK\" = /srv/operator/.1password/agent.sock'");
        lab.close(); print("PASS: 1Password integration and reboot"); return 0;
    } catch (string error) { print(error); return 1; }
}
