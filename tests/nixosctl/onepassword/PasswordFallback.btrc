import Library.CLI;
import ../../lib/TerminalSession.btrc;

int main(int argc, char** argv) {
    try {
        var args = CLIArgs(argc, argv);
        var socket = args.require(0, "SSH agent socket");
        var success = !(args.count() > 1 && args.get(1).equals("--wrong-password"));
        var terminal = TerminalSession("runuser", ["--pty", "-u", "operator", "--",
            "env", f"SSH_AUTH_SOCK={socket}", "sudo", "-k", "-p", "Password: ",
            "sh", "-ec", "test $(id -u) -eq 0; test -r /etc/shadow; test -t 0; touch /root/sudo-password-fallback"]);
        terminal.expect("Password: ");
        terminal.line(success ? "testpass123" : "wrong-password");
        terminal.finish(success);
        print("PASS: sudo password fallback");
        return 0;
    } catch (string error) { print(error); return 1; }
}
