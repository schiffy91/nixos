{
  "name": "sunshine-ssh-login",
  "state": "sunshine-ssh-login",
  "stateMaterial": "sunshine-ssh-login:{{arch}}:source={{sourceHash}}",
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "operations": [
    {
      "op": "host",
      "command": "mkdir -p '.vm/e2e/{{state}}-{{stateHashShort}}' && nix-build tests/nixosctl/sunshine-ssh --no-out-link --cores 2 --max-jobs 1 > '.vm/e2e/{{state}}-{{stateHashShort}}/test.log' 2>&1 || { tail -100 '.vm/e2e/{{state}}-{{stateHashShort}}/test.log'; exit 1; }",
      "timeout": 3600
    },
    { "op": "record-state" }
  ]
}
