/* VM test spec — module aggregator (one class per file under spec/).
 * btrc #include is textual, so the transpiled C is identical to the former
 * single file. Dependency order: operation -> spec -> parser.
 *
 *   operation   VmOperation    — one declarative step
 *   test_spec   VmTestSpec     — a scenario (state + operations)
 *   parser      VmSpecParser   — JSON -> VmTestSpec
 */
