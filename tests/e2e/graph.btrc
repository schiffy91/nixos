class VmGraphNode {
    public string id;
    public string specPath;
    public Vector<string> after;
    public Map<string, string> args;

    public VmGraphNode() {
        self.id = "";
        self.specPath = "";
        self.after = [];
        self.args = {};
    }
}

class VmTestGraph {
    public string name;
    public string path;
    public string baseDir;
    public string workspaceRoot;
    public Vector<string> defaults;
    public Vector<VmGraphNode> nodes;

    public VmTestGraph() {
        self.name = "e2e";
        self.path = "";
        self.baseDir = ".";
        self.workspaceRoot = "..";
        self.defaults = [];
        self.nodes = [];
    }

    public VmGraphNode node(string id) {
        for node in self.nodes {
            if (node.id.equals(id)) { return node; }
        }
        NixosLog.fatal("Unknown graph node: " + id);
        return VmGraphNode();
    }

    public string resolvedSpecPath(VmGraphNode node) {
        if (node.specPath.startsWith("/")) { return node.specPath; }
        if (FileSystem.exists(node.specPath)) { return node.specPath; }
        return PathTools.join(self.baseDir, node.specPath);
    }

    public string resolvedWorkspaceRoot() {
        if (self.workspaceRoot.startsWith("/")) { return self.workspaceRoot; }
        return PathTools.join(self.baseDir, self.workspaceRoot);
    }

    public Vector<string> defaultTargets() {
        if (!self.defaults.isEmpty()) { return self.defaults; }
        Vector<string> result = [];
        for node in self.nodes {
            result.push(node.id);
        }
        return result;
    }
}

class VmGraphParser {
    class Vector<string> stringArray(string text, string key) {
        Vector<string> result = [];
        int pos = VmSpecParser.keyPosition(text, key);
        if (pos < 0) { return result; }
        int arrayStart = Strings.find(text, "[", pos);
        if (arrayStart < 0) { return result; }
        int len = text.len();
        bool inString = false;
        bool escaped = false;
        int start = -1;
        for (int i = arrayStart + 1; i < len; i++) {
            char c = text[i];
            if (inString) {
                if (!escaped && c == (char)34) {
                    result.push(JsonObject.slice(text, start, i));
                    inString = false;
                    start = -1;
                }
                escaped = !escaped && c == '\\';
                if (c != '\\') { escaped = false; }
                continue;
            }
            if (c == (char)34) {
                inString = true;
                escaped = false;
                start = i + 1;
                continue;
            }
            if (c == ']') { break; }
        }
        return result;
    }

    class Vector<string> objectArray(string text, string key) {
        Vector<string> result = [];
        int pos = VmSpecParser.keyPosition(text, key);
        if (pos < 0) { return result; }
        int arrayStart = Strings.find(text, "[", pos);
        if (arrayStart < 0) { return result; }
        int len = text.len();
        int depth = 0;
        int start = -1;
        bool inString = false;
        bool escaped = false;
        for (int i = arrayStart + 1; i < len; i++) {
            char c = text[i];
            if (inString) {
                if (!escaped && c == (char)34) { inString = false; }
                escaped = !escaped && c == '\\';
                if (c != '\\') { escaped = false; }
                continue;
            }
            if (c == (char)34) {
                inString = true;
                escaped = false;
                continue;
            }
            if (c == '{') {
                if (depth == 0) { start = i; }
                depth++;
                continue;
            }
            if (c == '}') {
                depth--;
                if (depth == 0 && start >= 0) {
                    result.push(JsonObject.slice(text, start, i + 1));
                    start = -1;
                }
                continue;
            }
            if (c == ']' && depth == 0) { break; }
        }
        return result;
    }

    class VmGraphNode node(string objectText) {
        VmGraphNode node = VmGraphNode();
        node.id = VmSpecParser.field(objectText, "id", "");
        node.specPath = VmSpecParser.field(objectText, "spec", "");
        node.after = VmGraphParser.stringArray(objectText, "after");
        string argsText = VmSpecParser.objectField(objectText, "args");
        if (!argsText.isEmpty()) {
            JsonObject parsed = JsonObject.parse(argsText);
            for key, value in parsed.values {
                node.args.put(key, value);
            }
        }
        if (node.id.isEmpty()) { NixosLog.fatal("Graph node is missing id"); }
        if (node.specPath.isEmpty()) { NixosLog.fatal("Graph node " + node.id + " is missing spec"); }
        return node;
    }

    class VmTestGraph readFile(string path) {
        string text = Path.readAll(path);
        VmTestGraph graph = VmTestGraph();
        graph.path = path;
        graph.baseDir = PathTools.dirname(path);
        graph.name = VmSpecParser.field(text, "name", graph.name);
        graph.workspaceRoot = VmSpecParser.field(text, "workspaceRoot", graph.workspaceRoot);
        graph.defaults = VmGraphParser.stringArray(text, "default");
        for objectText in VmGraphParser.objectArray(text, "nodes") {
            graph.nodes.push(VmGraphParser.node(objectText));
        }
        if (graph.nodes.isEmpty()) { NixosLog.fatal("Graph has no nodes: " + path); }
        return graph;
    }
}

class VmGraphRunner {
    public VmTestGraph graph;
    public Map<string, string> args;
    public Vector<string> done;
    public Vector<string> visiting;
    public string sourceHashValue;

    public VmGraphRunner(VmTestGraph graph, Map<string, string> args) {
        self.graph = graph;
        self.args = args;
        self.done = [];
        self.visiting = [];
        self.sourceHashValue = "";
    }

    public string sourceHash() {
        if (!self.sourceHashValue.isEmpty()) { return self.sourceHashValue; }
        string root = self.graph.resolvedWorkspaceRoot();
        string command = "cd " + UnixShell.quote(root)
            + " && find . -type f"
            + " ! -path './.git/*'"
            + " ! -path '*/.vm/*'"
            + " ! -path '*/build/*'"
            + " ! -path '*/secrets/*'"
            + " ! -path './result/*'"
            + " ! -name '.DS_Store'"
            + " ! -name '._*'"
            + " \\( -name '*.btrc' -o -name '*.nix' -o -name '*.json' -o -name '*.toml' -o -name '*.tsv' -o -name '*.c' -o -name '*.rs' -o -name 'Makefile' -o -name 'flake.lock' \\)"
            + " -print0 | LC_ALL=C sort -z | xargs -0 shasum -a 256 | shasum -a 256 | awk '{print $1}'";
        ExecResult result = UnixShell().run(command);
        if (!result.ok()) {
            NixosLog.fatal("Failed to compute workspace source hash for " + root);
        }
        string toolPath = PathTools.join(root, "build/nixosctl");
        string toolHash = "missing";
        if (FileSystem.exists(toolPath)) {
            ExecResult tool = UnixShell().run("shasum -a 256 " + UnixShell.quote(toolPath) + " | awk '{print $1}'");
            if (!tool.ok()) {
                NixosLog.fatal("Failed to compute nixosctl hash for " + toolPath);
            }
            toolHash = tool.trimmed();
        }
        self.sourceHashValue = result.trimmed() + ":nixosctl=" + toolHash;
        return self.sourceHashValue;
    }

    public VmTestSpec specFor(VmGraphNode node) {
        VmTestSpec spec = VmSpecParser.readFile(self.graph.resolvedSpecPath(node));
        spec.setArg("graphName", self.graph.name);
        spec.setArg("nodeId", node.id);
        spec.setArg("workspaceRoot", self.graph.resolvedWorkspaceRoot());
        spec.setArg("sourceHash", self.sourceHash());
        self.applyStructuralOverrides(spec, node.args);
        self.applyStructuralOverrides(spec, self.args);
        for key, value in node.args {
            spec.setArg(key, value);
        }
        for key, value in self.args {
            spec.setArg(key, value);
        }
        spec.expandArgs();
        return spec;
    }

    public void applyStructuralOverrides(VmTestSpec spec, Map<string, string> overrides) {
        bool archChanged = overrides.has("arch");
        if (overrides.has("name")) { spec.name = overrides.get("name"); }
        if (overrides.has("workDir")) { spec.workDir = overrides.get("workDir"); }
        if (overrides.has("arch")) { spec.arch = overrides.get("arch"); }
        if (archChanged && !overrides.has("iso")) {
            spec.iso = PathTools.join(PathTools.join(".vm", "iso"), "nixos-minimal-" + spec.arch + ".iso");
        }
        if (archChanged && !overrides.has("isoUrl")) {
            spec.isoUrl = VmSpecParser.defaultIsoUrl(spec.arch);
        }
        if (overrides.has("iso")) { spec.iso = overrides.get("iso"); }
        if (overrides.has("isoUrl")) { spec.isoUrl = overrides.get("isoUrl"); }
        if (overrides.has("diskSize")) { spec.diskSize = overrides.get("diskSize"); }
        if (overrides.has("memory")) { spec.memory = overrides.get("memory"); }
        if (overrides.has("cpus")) { spec.cpus = Strings.toInt(overrides.get("cpus")); }
        if (overrides.has("sshPort")) { spec.sshPort = Strings.toInt(overrides.get("sshPort")); }
        if (overrides.has("state")) { spec.state = overrides.get("state"); }
        if (overrides.has("parentState")) { spec.parentState = overrides.get("parentState"); }
        if (overrides.has("stateRoot")) { spec.stateRoot = overrides.get("stateRoot"); }
        if (overrides.has("stateMaterial")) { spec.stateMaterial = overrides.get("stateMaterial"); }
    }

    public void list() {
        for node in self.graph.nodes {
            string parents = node.after.isEmpty() ? "root" : node.after.join(",");
            Console.log(node.id + " <- " + parents + " :: " + self.graph.resolvedSpecPath(node));
        }
    }

    public void status() {
        for node in self.graph.nodes {
            VmTestSpec spec = self.specFor(node);
            string recorded = "missing";
            if (FileSystem.exists(spec.stateHashFile())) {
                string saved = Path.readAll(spec.stateHashFile()).trim();
                recorded = saved.equals(spec.stateHash) ? "ready" : "stale";
            }
            Console.log(node.id + " " + recorded + " " + spec.stateHashShort + " " + spec.stateDir());
        }
    }

    public int operationCoverage() {
        Vector<string> covered = [];
        for node in self.graph.nodes {
            VmTestSpec spec = VmSpecParser.readFile(self.graph.resolvedSpecPath(node));
            for op in spec.operations {
                if (!op.kind.isEmpty() && !covered.contains(op.kind)) {
                    covered.push(op.kind);
                }
            }
        }

        Vector<string> missing = [];
        for kind in VmOperationCatalog.all() {
            if (!covered.contains(kind)) {
                missing.push(kind);
            }
        }
        if (!missing.isEmpty()) {
            Console.error("Missing e2e operation coverage: " + missing.join(", "));
            return 1;
        }
        Console.log("E2E operation coverage: " + Strings.fromInt(covered.len) + "/" + Strings.fromInt(VmOperationCatalog.all().len));
        return 0;
    }

    public bool force() {
        return self.args.getOrDefault("force", "false").equals("true");
    }

    public bool ready(VmTestSpec spec) {
        if (!FileSystem.exists(spec.stateHashFile())) { return false; }
        string saved = Path.readAll(spec.stateHashFile()).trim();
        return saved.equals(spec.stateHash);
    }

    public int runNode(string id) {
        if (self.done.contains(id)) { return 0; }
        if (self.visiting.contains(id)) { NixosLog.fatal("Cycle in graph at " + id); }
        self.visiting.push(id);
        VmGraphNode node = self.graph.node(id);
        for parent in node.after {
            int parentResult = self.runNode(parent);
            if (parentResult != 0) {
                self.visiting.removeAll(id);
                return parentResult;
            }
        }
        VmTestSpec spec = self.specFor(node);
        if (!self.force() && self.ready(spec)) {
            NixosLog.info("graph " + self.graph.name + ": skip " + node.id + " -> " + spec.state + "@" + spec.stateHashShort);
            self.done.push(id);
            self.visiting.removeAll(id);
            return 0;
        }
        NixosLog.info("graph " + self.graph.name + ": run " + node.id + " -> " + spec.state + "@" + spec.stateHashShort);
        VmTestRunner runner = VmTestRunner(spec);
        int result = runner.run();
        if (result != 0) {
            self.visiting.removeAll(id);
            return result;
        }
        self.done.push(id);
        self.visiting.removeAll(id);
        return 0;
    }

    public int run(Vector<string> targets) {
        Vector<string> selected = targets.isEmpty() ? self.graph.defaultTargets() : targets;
        for id in selected {
            int result = self.runNode(id);
            if (result != 0) { return result; }
        }
        return 0;
    }
}
