/* VM test graph — module aggregator (one class per file under graph/).
 * btrc #include is textual, so the transpiled C is identical to the former
 * single file. Dependency order: node -> model -> parser -> runner.
 *
 *   node     VmGraphNode     — one node (id, deps, spec ref)
 *   model    VmTestGraph     — the node set
 *   parser   VmGraphParser   — JSON -> VmTestGraph
 *   runner   VmGraphRunner   — topological run + status/coverage
 */
#include "graph/node.btrc"
#include "graph/model.btrc"
#include "graph/parser.btrc"
#include "graph/runner.btrc"
