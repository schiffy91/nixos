import std.json;
import std.map;
import std.process;
import std.strings;

class VmSpecArgs {
    class string hostArch() {
        var shell = UnixShell();
        var result = shell.run("uname -m");
        var machine = result.trimmed();
        if (machine.contains("arm64") || machine.contains("aarch64")) {
            return "aarch64";
        }
        return "x86_64";
    }

    class string defaultIsoUrl(string arch) {
        return "https://channels.nixos.org/nixos-unstable/latest-nixos-minimal-" + arch + "-linux.iso";
    }

    class string defaultIso(string arch) {
        return ".vm/e2e/iso/nixos-minimal-" + arch + ".iso";
    }

    class string expand(string text, Map<string, string> args) {
        return JsonText.expand(text, args);
    }
}
