import std.*;
import ../../../btrc/core/log.btrc;
import ./args.btrc;
import ./operation.btrc;
import ./test_spec.btrc;

class VmSpecParser {
    class int skipSpaces(string text, int i) {
        return JsonText.skipSpaces(text, i);
    }

    class int keyPosition(string text, string key) {
        return JsonText.keyPosition(text, key);
    }

    class string objectField(string text, string key) {
        return JsonText.objectField(text, key);
    }

    class Map<string, string> argsObject(string text) {
        return JsonText.argsObject(text);
    }

    class string parseStringValue(string text, int i, string fallback) {
        return JsonText.parseStringValue(text, i, fallback);
    }

    class string field(string text, string key, string fallback) {
        return JsonText.field(text, key, fallback);
    }

    class int intField(string text, string key, int fallback) {
        return JsonText.intField(text, key, fallback);
    }

    class VmOperation operation(string objectText) {
        var op = VmOperation();
        op.kind = VmSpecParser.field(objectText, "op", "");
        op.command = VmSpecParser.field(objectText, "command", "");
        op.expect = VmSpecParser.field(objectText, "expect", "");
        op.name = VmSpecParser.field(objectText, "name", "");
        op.localPath = VmSpecParser.field(objectText, "local", "");
        op.remotePath = VmSpecParser.field(objectText, "remote", "");
        op.timeout = VmSpecParser.intField(objectText, "timeout", 120);
        return op;
    }

    class Vector<VmOperation> operations(string text) {
        Vector<VmOperation> result = [];
        for objectText in JsonText.objectArray(text, "operations") {
            result.push(VmSpecParser.operation(objectText));
        }
        return result;
    }

    class VmTestSpec parse(string text) {
        var spec = VmTestSpec();
        spec.name = VmSpecParser.field(text, "name", spec.name);
        spec.state = VmSpecParser.field(text, "state", spec.name);
        spec.parentState = VmSpecParser.field(text, "parentState", spec.parentState);
        spec.stateRoot = VmSpecParser.field(text, "stateRoot", spec.stateRoot);
        spec.stateMaterial = VmSpecParser.field(text, "stateMaterial", spec.stateMaterial);
        spec.workDir = VmSpecParser.field(text, "workDir", ".vm/e2e/" + spec.name);
        spec.arch = VmSpecParser.field(text, "arch", spec.arch);
        spec.iso = VmSpecParser.field(text, "iso", PathTools.join(PathTools.join(".vm", "iso"), "nixos-minimal-" + spec.arch + ".iso"));
        spec.isoUrl = VmSpecParser.field(text, "isoUrl", VmSpecArgs.defaultIsoUrl(spec.arch));
        spec.diskSize = VmSpecParser.field(text, "diskSize", spec.diskSize);
        spec.memory = VmSpecParser.field(text, "memory", spec.memory);
        spec.cpus = VmSpecParser.intField(text, "cpus", spec.cpus);
        spec.sshPort = VmSpecParser.intField(text, "sshPort", spec.sshPort);
        spec.args = VmSpecParser.argsObject(text);
        spec.operations = VmSpecParser.operations(text);
        return spec;
    }

    class void applySpecField(VmTestSpec spec, string key, string value) {
        if (key.equals("name")) { spec.name = value; return; }
        if (key.equals("state")) { spec.state = value; return; }
        if (key.equals("parentState")) { spec.parentState = value; return; }
        if (key.equals("stateRoot")) { spec.stateRoot = value; return; }
        if (key.equals("stateMaterial")) { spec.stateMaterial = value; return; }
        if (key.equals("workDir")) { spec.workDir = value; return; }
        if (key.equals("arch")) { spec.arch = value; return; }
        if (key.equals("iso")) { spec.iso = value; return; }
        if (key.equals("isoUrl")) { spec.isoUrl = value; return; }
        if (key.equals("diskSize")) { spec.diskSize = value; return; }
        if (key.equals("memory")) { spec.memory = value; return; }
        if (key.equals("cpus")) { spec.cpus = Strings.toInt(value); return; }
        if (key.equals("sshPort")) { spec.sshPort = Strings.toInt(value); return; }
    }

    class void applyOperationField(VmOperation op, string key, string value) {
        if (key.equals("op")) { op.kind = value; return; }
        if (key.equals("kind")) { op.kind = value; return; }
        if (key.equals("command")) { op.command = value; return; }
        if (key.equals("expect")) { op.expect = value; return; }
        if (key.equals("name")) { op.name = value; return; }
        if (key.equals("local")) { op.localPath = value; return; }
        if (key.equals("remote")) { op.remotePath = value; return; }
        if (key.equals("timeout")) { op.timeout = Strings.toInt(value); return; }
    }

    class bool hasOperation(VmOperation op) {
        return !op.kind.isEmpty() || !op.command.isEmpty() || !op.name.isEmpty();
    }

    class string yamlKey(string line) {
        var pos = Strings.find(line, ":", 0);
        if (pos < 0) { return ""; }
        return Toml.unquote(line.substring(0, pos).trim());
    }

    class string yamlValue(string line) {
        var pos = Strings.find(line, ":", 0);
        if (pos < 0) { return ""; }
        return Toml.unquote(Toml.stripInlineComment(line.substring(pos + 1, line.len() - pos - 1)).trim());
    }

    class VmTestSpec parseToml(string text) {
        var spec = VmTestSpec();
        var section = "root";
        var op = VmOperation();
        var lines = Strings.split(text, "\n");
        for line in lines {
            var cleaned = Toml.stripInlineComment(line);
            if (cleaned.isEmpty()) { continue; }
            var arrayName = Toml.tableArrayName(cleaned);
            if (arrayName.equals("operations")) {
                if (VmSpecParser.hasOperation(op)) { spec.operations.push(op); }
                op = VmOperation();
                section = "operations";
                continue;
            }
            var sectionName = Toml.sectionName(cleaned);
            if (!sectionName.isEmpty()) {
                if (VmSpecParser.hasOperation(op)) {
                    spec.operations.push(op);
                    op = VmOperation();
                }
                section = sectionName;
                continue;
            }
            var key = Toml.key(cleaned);
            if (key.isEmpty()) { continue; }
            var value = Toml.value(cleaned);
            if (section.equals("args")) {
                spec.args.put(key, value);
                continue;
            }
            if (section.equals("operations")) {
                VmSpecParser.applyOperationField(op, key, value);
                continue;
            }
            VmSpecParser.applySpecField(spec, key, value);
        }
        if (VmSpecParser.hasOperation(op)) { spec.operations.push(op); }
        return spec;
    }

    class VmTestSpec parseYaml(string text) {
        var spec = VmTestSpec();
        var section = "root";
        var op = VmOperation();
        var lines = Strings.split(text, "\n");
        for raw in lines {
            var line = Toml.stripInlineComment(raw);
            if (line.trim().isEmpty()) { continue; }
            var trimmed = line.trim();
            if (trimmed.equals("args:")) {
                if (VmSpecParser.hasOperation(op)) {
                    spec.operations.push(op);
                    op = VmOperation();
                }
                section = "args";
                continue;
            }
            if (trimmed.equals("operations:")) {
                section = "operations";
                continue;
            }
            if (trimmed.startsWith("- ")) {
                if (VmSpecParser.hasOperation(op)) { spec.operations.push(op); }
                op = VmOperation();
                section = "operations";
                var rest = trimmed.substring(2, trimmed.len() - 2).trim();
                if (!rest.isEmpty()) {
                    VmSpecParser.applyOperationField(op, VmSpecParser.yamlKey(rest), VmSpecParser.yamlValue(rest));
                }
                continue;
            }
            var key = VmSpecParser.yamlKey(trimmed);
            if (key.isEmpty()) { continue; }
            var value = VmSpecParser.yamlValue(trimmed);
            if (section.equals("args")) {
                spec.args.put(key, value);
                continue;
            }
            if (section.equals("operations")) {
                VmSpecParser.applyOperationField(op, key, value);
                continue;
            }
            VmSpecParser.applySpecField(spec, key, value);
        }
        if (VmSpecParser.hasOperation(op)) { spec.operations.push(op); }
        return spec;
    }

    class VmTestSpec readFile(string path) {
        var text = Path.readAll(path);
        if (path.endsWith(".toml")) { return VmSpecParser.parseToml(text); }
        if (path.endsWith(".yaml") || path.endsWith(".yml")) { return VmSpecParser.parseYaml(text); }
        return VmSpecParser.parse(text);
    }
}
