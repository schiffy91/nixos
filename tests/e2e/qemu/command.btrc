import std.fs;
import std.process;
import std.strings;
import ../../../btrc/core/log.btrc;
import ../spec.btrc;
import ./firmware.btrc;
import ./serial.btrc;
class QemuCommandBuilder {
    public VmTestSpec spec;
    public QemuFirmware firmware;
    public QemuSerial serial;
    public UnixShell shell;

    public QemuCommandBuilder(VmTestSpec spec, QemuFirmware firmware, QemuSerial serial) {
        self.spec = spec;
        self.firmware = firmware;
        self.serial = serial;
        self.shell = UnixShell();
    }

    public string diskPath() { return PathTools.join(self.spec.workDir, "disk.qcow2"); }
    public string monitorPath() { return PathTools.join(self.spec.workDir, "monitor.sock"); }
    public string qmpPath() { return PathTools.join(self.spec.workDir, "qmp.sock"); }

    public void ensureVmLaunchBinary() {
        var command = f"set -e; bin=$(command -v {UnixShell.quote(self.firmware.qemuBinary())}); target={UnixShell.quote(self.spec.vmLaunchBinary())}; rm -f \"$target\"; cp \"$bin\" \"$target\"; chmod 755 \"$target\"";
        var result = self.shell.run(command, stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), logFailure=false);
        if (!result.ok()) {
            NixosLog.fatal(f"Failed to create isolated VM launcher {self.spec.vmLaunchBinary()}");
        }
    }

    public void addAccelerator(Command cmd) {
        if (self.firmware.isDarwin()) {
            cmd.args(["-accel", self.firmware.hostArchMatchesGuest() ? "hvf" : "tcg,thread=multi"]);
        } else if (self.firmware.hostArchMatchesGuest()) {
            cmd.args(["-enable-kvm"]);
        } else {
            cmd.args(["-accel", "tcg,thread=multi"]);
        }
    }

    public void addMachine(Command cmd) {
        if (!self.spec.arch.equals("aarch64")) { return; }
        cmd.args([
            "-machine",
            "virt",
            "-cpu",
            self.firmware.hostArchMatchesGuest() ? "host" : "max",
            "-device",
            "virtio-rng-pci"
        ]);
    }

    public void addMemoryCpus(Command cmd) {
        cmd.args([
            "-m",
            self.spec.memory,
            "-smp",
            Strings.fromInt(self.spec.cpus),
            "-name",
            self.spec.vmProcessName()
        ]);
    }

    public void addStorageAndNetwork(Command cmd) {
        cmd.args([
            "-drive",
            f"file={self.diskPath()},format=qcow2,if=virtio,cache=none",
            "-netdev",
            f"user,id=net0,hostfwd=tcp::{self.spec.sshPort}-:22",
            "-device",
            "virtio-net-pci,netdev=net0"
        ]);
    }

    public void addConsole(Command cmd) {
        cmd.args([
            "-display",
            "none",
            "-serial",
            f"pipe:{self.serial.serialBasePath()}",
            "-monitor",
            f"unix:{self.monitorPath()},server,nowait",
            "-qmp",
            f"unix:{self.qmpPath()},server,nowait"
        ]);
    }

    public void addBootMedia(Command cmd, bool fromIso) {
        if (!fromIso) { return; }
        if (self.spec.arch.equals("x86_64") && !self.firmware.shouldUseUefi(fromIso)) {
            self.serial.extractBootSerial();
            cmd.args([
                "-kernel",
                Path.readAll(self.serial.bootKernelFile()).trim(),
                "-initrd",
                Path.readAll(self.serial.bootInitrdFile()).trim(),
                "-append",
                Path.readAll(self.serial.bootAppendFile()).trim(),
                "-cdrom",
                self.spec.iso
            ]);
        } else {
            cmd.args(["-cdrom", self.spec.iso, "-boot", "d"]);
        }
    }

    public Command build(bool fromIso) {
        self.ensureVmLaunchBinary();
        var cmd = Command(self.spec.vmLaunchBinary());
        self.addAccelerator(cmd);
        self.addMachine(cmd);
        self.firmware.addFirmwareData(cmd);
        self.firmware.addFirmware(cmd, fromIso);
        self.addMemoryCpus(cmd);
        self.addStorageAndNetwork(cmd);
        self.addConsole(cmd);
        self.firmware.addTpm2(cmd);
        self.addBootMedia(cmd, fromIso);
        return cmd;
    }
}
