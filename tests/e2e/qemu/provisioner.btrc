import std.console;
import std.fs;
import std.json;
import std.process;
import ../../../btrc/core/log.btrc;
import ../spec.btrc;
import ./ssh.btrc;
import ./state.btrc;

class VmProvisioner {
    public VmTestSpec spec;
    public SshClient remote;
    public VmStateStore state;

    public VmProvisioner(VmTestSpec spec, SshClient remote, VmStateStore state) {
        self.spec = spec;
        self.remote = remote;
        self.state = state;
    }

    public string pubKey() {
        return Path.readAll(PathTools.join(self.spec.workDir, "id_ed25519.pub")).trim();
    }

    public string qemuLogPath() {
        return self.spec.vmLogPath();
    }

    public void configureVmHost() {
        var mode = self.spec.args.getOrDefault("immutabilityMode", "reset");
        var enabled = self.spec.args.getOrDefault("immutabilityEnabled", "true");
        var bootTargetName = self.spec.args.getOrDefault("bootTarget", "Standard-Boot");
        var desktop = self.spec.args.getOrDefault("desktop", "none");
        var encryption = self.spec.args.getOrDefault("encryption", "false");
        var recovery = self.spec.args.getOrDefault("recovery", "false");
        var recoverySize = self.spec.args.getOrDefault("recoverySize", "4G");
        var luksPass = "testpass123";
        var secureBootTarget = bootTargetName.equals("Secure-Boot");
        var otherArch = self.spec.arch.equals("aarch64") ? "x86_64" : "aarch64";
        var serialConsole = self.spec.arch.equals("aarch64") ? "ttyAMA0,115200n8" : "ttyS0,115200n8";
        var initrdModules = self.spec.arch.equals("aarch64")
            ? "[ \"virtio_pci\" \"virtio_blk\" \"virtio_net\" \"virtio_mmio\" \"virtio_rng\" \"tpm_tis\" \"tpm_tis_core\" ]"
            : "[ \"virtio_pci\" \"virtio_blk\" \"virtio_net\" \"tpm_tis\" ]";
        var hostDir = "/etc/nixos/nix/hosts/" + self.spec.arch + "/VM-TEST";
        var hostPath = hostDir + "/VM-TEST.nix";
        var pubkey = self.pubKey();
        var passwordHash = "$6$vmtest$zfOOVFBtEpiYVE486Cybmppi9zXd0QKYfRZ5FRLsMV26K7vK6QHIpZpUo1sxVt7liGoR9C/W1I5ih4VCt34n3.";
        var secureBootSettings = secureBootTarget
            ? "  settings.boot.pkiBundle = \"/var/lib/sbctl\";\n"
            : "";
        var secureBootModulePath = "/etc/nixos/nix/system/vm-test-secure-boot.nix";
        var secureBootModule = "{ config, lib, pkgs, ... }: {\n"
            + "  config = lib.mkIf (config.networking.hostName == \"VM-TEST\" && config.settings.boot.method == \"Secure-Boot\") {\n"
            + "    boot.loader.timeout = lib.mkForce 0;\n"
            + "    boot.lanzaboote.autoGenerateKeys.enable = true;\n"
            + "    boot.lanzaboote.autoEnrollKeys.enable = false;\n"
            + "    boot.lanzaboote.allowUnsigned = true;\n"
            + "    environment.systemPackages = [ pkgs.sbctl pkgs.sbsigntool ];\n"
            + "  };\n"
            + "}\n";
        var secureBootModuleCommand = secureBootTarget
            ? "printf %s " + UnixShell.quote(secureBootModule) + " > " + UnixShell.quote(secureBootModulePath) + "; "
            : "";
        var hostNix = "{ lib, ... }: {\n"
            + "  networking.hostName = \"VM-TEST\";\n"
            + "  networking.firewall.enable = lib.mkForce false;\n"
            + "  users.users.root.openssh.authorizedKeys.keys = [ \"" + pubkey + "\" ];\n"
            + "  boot.kernelParams = [ \"console=" + serialConsole + "\" ];\n"
            + "  boot.initrd.availableKernelModules = " + initrdModules + ";\n"
            + "  boot.plymouth.enable = lib.mkForce false;\n"
            + "  services.getty.autologinUser = lib.mkForce \"root\";\n"
            + "  services.openssh.enable = lib.mkForce true;\n"
            + "  services.openssh.settings.PermitRootLogin = lib.mkForce \"yes\";\n"
            + "  services.openssh.settings.UseDns = lib.mkForce false;\n"
            + "  settings.users.admin.authorizedKeys = lib.mkForce [ \"" + pubkey + "\" ];\n"
            + "  settings.users.admin.autoUnlockWallet.enabled = false;\n"
            + "  settings.users.admin.homeManager.enable = false;\n"
            + "  settings.users.agent.enable = lib.mkForce false;\n"
            + "  settings.users.agent.homeManager.enable = lib.mkForce false;\n"
            + "  settings.users.agent.packages = lib.mkForce [];\n"
            + "  settings.networking.identityAgent = \"none\";\n"
            + "  settings.networking.lanSubnet = \"10.0.2.0/24\";\n"
            + "  settings.disk.device = \"/dev/vda\";\n"
            + "  settings.disk.recovery.enable = " + recovery + ";\n"
            + "  settings.disk.recovery.size = \"" + recoverySize + "\";\n"
            + "  settings.disk.encryption.enable = " + encryption + ";\n"
            + "  settings.disk.immutability.enable = " + enabled + ";\n"
            + "  settings.disk.immutability.mode = \"" + mode + "\";\n"
            + "  settings.disk.immutability.persist.paths = lib.mkForce [ \"/etc/machine-id\" \"/etc/nixos\" \"/var/lib/nixos\" \"/var/lib/sbctl\" \"/var/log\" ];\n"
            + "  settings.desktop.enable = " + (desktop.equals("none") ? "false" : "true") + ";\n"
            + "  settings.disk.swap.size = \"2G\";\n"
            + secureBootSettings
            + "}\n";
        var local = JsonObject();
        local.setString("host_path", "nix/hosts/" + self.spec.arch + "/VM-TEST/VM-TEST.nix");
        local.setString("target", bootTargetName);
        var localConfig = local.stringify() + "\n";
        var luksCommand = encryption.equals("true")
            ? "printf %s " + UnixShell.quote(luksPass) + " > /tmp/plain_text_password.txt; chmod 600 /tmp/plain_text_password.txt; "
            : "";
        var command = "set -e; "
            + luksCommand
            + "rm -rf /etc/nixos/nix/hosts/" + otherArch + "; "
            + "rm -f " + UnixShell.quote(secureBootModulePath) + "; "
            + secureBootModuleCommand
            + "find /etc/nixos/nix/apps -maxdepth 1 -type f -name '*.nix' ! -name 'nixosctl.nix' -delete; "
            + "find /etc/nixos/nix/apps/home-manager -maxdepth 1 -type f -name '*.nix' -delete 2>/dev/null || true; "
            + "mkdir -p /etc/nixos/nix/apps/home-manager; "
            + "touch /etc/nixos/nix/apps/home-manager/.keep; "
            + "mkdir -p /etc/nixos/secrets; "
            + "printf %s " + UnixShell.quote(passwordHash) + " > /etc/nixos/secrets/hashed_password.txt; "
            + "chmod 600 /etc/nixos/secrets/hashed_password.txt; "
            + "mkdir -p " + UnixShell.quote(hostDir) + "; "
            + "printf %s " + UnixShell.quote(hostNix) + " > " + UnixShell.quote(hostPath) + "; "
            + "printf %s " + UnixShell.quote(localConfig) + " > /etc/nixos/config.json; "
            + "git -C /etc/nixos init; "
            + "git config --global --get-all safe.directory | grep -Fx -- /etc/nixos >/dev/null || git config --global --add safe.directory /etc/nixos; "
            + "git -C /etc/nixos add -A; "
            + "git -C /etc/nixos -c user.name=test -c user.email=test@test commit -m init --allow-empty";
        var result = self.remote.sshWithTimeout(command, false, 120);
        if (!result.ok()) {
            Console.error(result.stdout());
            NixosLog.fatal("Failed to configure VM host");
        }
    }

    public bool installNixosGuest() {
        var diskTarget = "VM-TEST-Disk-Operation";
        var bootTargetName = self.spec.args.getOrDefault("bootTarget", "Standard-Boot");
        var secureBootTarget = bootTargetName.equals("Secure-Boot");
        var bootTarget = "VM-TEST-" + bootTargetName;
        var nix = "nix --extra-experimental-features nix-command --extra-experimental-features flakes";
        var disko = nix + " run --inputs-from /etc/nixos github:nix-community/disko -- --show-trace --flake /etc/nixos#"
            + diskTarget
            + " --mode destroy,format,mount --root-mountpoint /mnt --yes-wipe-all-disks";
        var install = "mkdir -p /mnt/etc; rm -rf /mnt/etc/nixos; cp -r /etc/nixos /mnt/etc/nixos; mkdir -p /mnt/nix/tmp; TMPDIR=/mnt/nix/tmp nixos-install --flake /mnt/etc/nixos#"
            + bootTarget
            + " --root /mnt --no-channel-copy --show-trace --no-root-password --max-jobs auto --cores 0";
        var secureBootKeys = "set -ex; "
            + "mkdir -p /var/lib/sbctl; "
            + "if ! test -e /var/lib/sbctl/keys/db/db.pem || ! test -e /var/lib/sbctl/keys/db/db.key; then sbctl create-keys; fi; "
            + "sbctl enroll-keys --yes-this-might-brick-my-machine";
        var secureBootInstall = secureBootKeys
            + "; case \"$(uname -m)\" in x86_64) fallback=BOOTX64.EFI; systemd=systemd-bootx64.efi ;; aarch64) fallback=BOOTAA64.EFI; systemd=systemd-bootaa64.efi ;; *) fallback=BOOTUNKNOWN.EFI; systemd=systemd-bootunknown.efi ;; esac; "
            + "if ! test -e \"/target-boot/EFI/BOOT/$fallback\" && test -e \"/boot/EFI/BOOT/$fallback\"; then install -Dm0644 \"/boot/EFI/BOOT/$fallback\" \"/target-boot/EFI/BOOT/$fallback\"; fi; "
            + "if ! test -e \"/target-boot/EFI/systemd/$systemd\" && test -e \"/boot/EFI/systemd/$systemd\"; then install -Dm0644 \"/boot/EFI/systemd/$systemd\" \"/target-boot/EFI/systemd/$systemd\"; fi; "
            + "test -e \"/target-boot/EFI/BOOT/$fallback\"; "
            + "test -e \"/target-boot/EFI/systemd/$systemd\"; "
            + "for file in \"/target-boot/EFI/BOOT/$fallback\" \"/target-boot/EFI/systemd/$systemd\" /target-boot/EFI/Linux/*.efi; do "
            + "test -e \"$file\" || continue; "
            + "signed=$(mktemp); "
            + "sbsign --key /var/lib/sbctl/keys/db/db.key --cert /var/lib/sbctl/keys/db/db.pem --output \"$signed\" \"$file\"; "
            + "install -m 0644 \"$signed\" \"$file\"; "
            + "rm -f \"$signed\"; "
            + "sbverify --list \"$file\" | grep -q 'signature certificates'; "
            + "done; sync";
        var lanzabooteInstall = secureBootTarget
            ? "mkdir -p /mnt/target-boot\n"
                + "mount --bind /mnt/boot /mnt/target-boot\n"
                + "nixos-enter --root /mnt --command "
                + UnixShell.quote(secureBootInstall)
                + "\n"
                + "umount /mnt/target-boot\n"
                + "rmdir /mnt/target-boot"
            : "true";
        var snapshots = "nixos-enter --root /mnt --command "
            + UnixShell.quote("set -e; mkdir -p /.snapshots/@root /.snapshots/@home; rm -rf /.snapshots/@root/CLEAN /.snapshots/@home/CLEAN; btrfs subvolume snapshot -r / /.snapshots/@root/CLEAN; btrfs subvolume snapshot -r /home /.snapshots/@home/CLEAN; git config --global --get-all safe.directory | grep -Fx -- /etc/nixos >/dev/null || git config --global --add safe.directory /etc/nixos");
        var script = "set -ex\n"
            + "printf INSTALL_START > /tmp/nixos-install.status\n"
            + disko + "\n"
            + install + "\n"
            + lanzabooteInstall + "\n"
            + snapshots + "\n"
            + "printf INSTALL_OK > /tmp/nixos-install.status\n";
        var servicePath = "/run/current-system/sw/bin:/run/wrappers/bin:/nix/var/nix/profiles/default/bin:/bin:/usr/bin";
        var runner = "PATH=" + UnixShell.quote(servicePath) + "; export PATH; HOME=/root; export HOME; "
            + "rm -f /tmp/nixos-install.pipe; mkfifo /tmp/nixos-install.pipe; "
            + "tee /tmp/nixos-install.log < /tmp/nixos-install.pipe > /dev/ttyS0 & teepid=$!; "
            + "sh /tmp/nixos-install.sh > /tmp/nixos-install.pipe 2>&1 < /dev/null; "
            + "code=$?; "
            + "wait $teepid || true; rm -f /tmp/nixos-install.pipe; "
            + "if [ $code -ne 0 ]; then printf 'INSTALL_FAIL:%s\\n' \"$code\" > /tmp/nixos-install.status; fi";
        var prepare = "set -e; "
            + "rm -f /tmp/nixos-install.status /tmp/nixos-install.log /tmp/nixos-install.sh; "
            + "printf %s " + UnixShell.quote(script) + " > /tmp/nixos-install.sh; "
            + "chmod +x /tmp/nixos-install.sh";
        var launch = "set -e; "
            + "systemctl reset-failed nixos-install-e2e.service 2>/dev/null || true; "
            + "systemctl is-active --quiet nixos-install-e2e.service && exit 0; "
            + "systemd-run --unit=nixos-install-e2e --collect --property=Type=exec /bin/sh -c " + UnixShell.quote(runner);
        var timeoutSeconds = secureBootTarget ? 7200 : 3600;
        var prepared = self.sshWithRetries(prepare, 60, 3);
        if (!prepared.ok()) {
            Console.error(prepared.stdout());
            return false;
        }
        if (!self.launchInstall(launch)) {
            return false;
        }
        return self.waitForInstallStatus(timeoutSeconds);
    }

    public ExecResult sshWithRetries(string command, int timeoutSeconds, int attempts) {
        var attempt = 0;
        var last = ExecResult(1, "", "", "");
        while (attempt < attempts) {
            last = self.remote.sshWithTimeout(command, false, timeoutSeconds);
            if (last.ok()) { return last; }
            attempt = attempt + 1;
            if (attempt < attempts) { self.remote.host("sleep 3", false); }
        }
        return last;
    }

    public string installStatusText() {
        var status = self.remote.sshWithTimeout("if test -f /tmp/nixos-install.status; then cat /tmp/nixos-install.status; fi", false, 10);
        if (!status.ok()) { return ""; }
        return status.stdout();
    }

    public bool installWasLaunched() {
        var text = self.installStatusText();
        if (text.contains("INSTALL_START")) { return true; }
        if (text.contains("INSTALL_OK")) { return true; }
        if (text.contains("INSTALL_FAIL")) { return true; }
        var active = self.remote.sshWithTimeout("systemctl is-active --quiet nixos-install-e2e.service", false, 10);
        return active.ok();
    }

    public bool waitForInstallLaunch(int timeoutSeconds) {
        var elapsed = 0;
        while (elapsed < timeoutSeconds) {
            if (!self.state.isRunning()) {
                NixosLog.error("QEMU exited while launching NixOS installation; " + self.state.runningDetail() + "; QEMU log: " + self.qemuLogPath());
                return false;
            }
            if (self.installWasLaunched()) { return true; }
            self.remote.host("sleep 3", false);
            elapsed = elapsed + 3;
        }
        return false;
    }

    public bool launchInstall(string launch) {
        var attempts = 0;
        while (attempts < 3) {
            var launched = self.remote.sshWithTimeout(launch, false, 30);
            if (launched.ok()) { return true; }
            Console.error(launched.stdout());
            if (self.waitForInstallLaunch(15)) { return true; }
            attempts = attempts + 1;
        }
        return self.waitForInstallLaunch(30);
    }

    public void printInstallLog() {
        var command = "if test -f /tmp/nixos-install.log; then tail -n 240 /tmp/nixos-install.log; fi; "
            + "if test -f /tmp/nixos-install.status; then cat /tmp/nixos-install.status; fi";
        var log = self.remote.sshWithTimeout(command, false, 30);
        if (log.ok()) { Console.error(log.stdout()); }
    }

    public bool waitForInstallStatus(int timeoutSeconds) {
        var elapsed = 0;
        var unavailable = 0;
        while (elapsed < timeoutSeconds) {
            if (!self.state.isRunning()) {
                NixosLog.error("QEMU exited while NixOS installation was running; " + self.state.runningDetail() + "; QEMU log: " + self.qemuLogPath());
                self.printInstallLog();
                return false;
            }
            var status = self.remote.sshWithTimeout("if test -f /tmp/nixos-install.status; then cat /tmp/nixos-install.status; fi", false, 10);
            if (status.ok()) {
                unavailable = 0;
                var text = status.stdout();
                if (text.contains("INSTALL_OK")) { return true; }
                if (text.contains("INSTALL_FAIL")) {
                    self.printInstallLog();
                    return false;
                }
            } else {
                unavailable++;
                if (unavailable >= 20) {
                    self.printInstallLog();
                    return false;
                }
            }
            self.remote.host("sleep 15", false);
            elapsed = elapsed + 15;
        }
        self.printInstallLog();
        return false;
    }
}
