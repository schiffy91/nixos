import std.*;
import ../../../btrc/core/log.btrc;
import ../spec.btrc;
import ./ssh.btrc;
import ./state.btrc;

/* Provisions a freshly-booted installer VM: writes the VM-TEST host module +
 * local config from the scenario args (configureVmHost), then runs disko +
 * nixos-install + CLEAN-baseline snapshots (installNixosGuest). Holds the spec
 * and the SshClient; install failures are reported up so the harness can stop
 * the VM and abort.
 */
class VmProvisioner {
    public VmTestSpec spec;
    public SshClient remote;
    public VmStateStore state;

    public VmProvisioner(VmTestSpec spec, SshClient remote, VmStateStore state) {
        self.spec = spec;
        self.remote = remote;
        self.state = state;
    }

    public string pubKey() {
        return Path.readAll(PathTools.join(self.spec.workDir, "id_ed25519.pub")).trim();
    }

    public string qemuLogPath() {
        return self.spec.vmLogPath();
    }

    public void configureVmHost() {
        string mode = self.spec.args.getOrDefault("immutabilityMode", "reset");
        string enabled = self.spec.args.getOrDefault("immutabilityEnabled", "true");
        string bootTargetName = self.spec.args.getOrDefault("bootTarget", "Standard-Boot");
        string desktop = self.spec.args.getOrDefault("desktop", "none");
        string encryption = self.spec.args.getOrDefault("encryption", "false");
        string luksPass = "testpass123";
        bool secureBootTarget = bootTargetName.equals("Secure-Boot");
        string otherArch = self.spec.arch.equals("aarch64") ? "x86_64" : "aarch64";
        string serialConsole = self.spec.arch.equals("aarch64") ? "ttyAMA0,115200n8" : "ttyS0,115200n8";
        string initrdModules = self.spec.arch.equals("aarch64")
            ? "[ \"virtio_pci\" \"virtio_blk\" \"virtio_net\" \"virtio_mmio\" \"virtio_rng\" \"tpm_tis\" \"tpm_tis_core\" ]"
            : "[ \"virtio_pci\" \"virtio_blk\" \"virtio_net\" \"tpm_tis\" ]";
        string hostDir = "/etc/nixos/nix/hosts/" + self.spec.arch + "/VM-TEST";
        string hostPath = hostDir + "/VM-TEST.nix";
        string pubkey = self.pubKey();
        string passwordHash = "$6$vmtest$zfOOVFBtEpiYVE486Cybmppi9zXd0QKYfRZ5FRLsMV26K7vK6QHIpZpUo1sxVt7liGoR9C/W1I5ih4VCt34n3.";
        string secureBootSettings = secureBootTarget
            ? "  settings.boot.pkiBundle = \"/var/lib/sbctl\";\n"
            : "";
        string secureBootModulePath = "/etc/nixos/nix/system/vm-test-secure-boot.nix";
        string secureBootModule = "{ config, lib, pkgs, ... }: {\n"
            + "  config = lib.mkIf (config.networking.hostName == \"VM-TEST\" && config.settings.boot.method == \"Secure-Boot\") {\n"
            + "    boot.loader.timeout = lib.mkForce 0;\n"
            + "    boot.lanzaboote.autoGenerateKeys.enable = true;\n"
            + "    boot.lanzaboote.autoEnrollKeys.enable = true;\n"
            + "    boot.lanzaboote.allowUnsigned = true;\n"
            + "    boot.lanzaboote.autoEnrollKeys.includeMicrosoftKeys = true;\n"
            + "    boot.lanzaboote.autoEnrollKeys.autoReboot = false;\n"
            + "    environment.systemPackages = [ pkgs.sbctl ];\n"
            + "  };\n"
            + "}\n";
        string secureBootModuleCommand = secureBootTarget
            ? "printf %s " + UnixShell.quote(secureBootModule) + " > " + UnixShell.quote(secureBootModulePath) + "; "
            : "";
        string hostNix = "{ lib, ... }: {\n"
            + "  networking.hostName = \"VM-TEST\";\n"
            + "  networking.firewall.enable = lib.mkForce false;\n"
            + "  users.users.root.openssh.authorizedKeys.keys = [ \"" + pubkey + "\" ];\n"
            + "  boot.kernelParams = [ \"console=" + serialConsole + "\" ];\n"
            + "  boot.initrd.availableKernelModules = " + initrdModules + ";\n"
            + "  boot.plymouth.enable = lib.mkForce false;\n"
            + "  services.getty.autologinUser = lib.mkForce \"root\";\n"
            + "  services.openssh.enable = lib.mkForce true;\n"
            + "  services.openssh.settings.PermitRootLogin = lib.mkForce \"yes\";\n"
            + "  services.openssh.settings.UseDns = lib.mkForce false;\n"
            + "  settings.users.admin.autoUnlockWallet.enabled = false;\n"
            + "  settings.users.admin.homeManager.enable = false;\n"
            + "  settings.networking.identityAgent = \"none\";\n"
            + "  settings.networking.lanSubnet = \"10.0.2.0/24\";\n"
            + "  settings.disk.device = \"/dev/vda\";\n"
            + "  settings.disk.encryption.enable = " + encryption + ";\n"
            + "  settings.disk.immutability.enable = " + enabled + ";\n"
            + "  settings.disk.immutability.mode = \"" + mode + "\";\n"
            + "  settings.disk.immutability.persist.paths = lib.mkForce [ \"/etc/machine-id\" \"/etc/nixos\" \"/var/lib/nixos\" \"/var/lib/sbctl\" \"/var/log\" ];\n"
            + "  settings.desktop.enable = " + (desktop.equals("none") ? "false" : "true") + ";\n"
            + "  settings.disk.swap.size = \"2G\";\n"
            + secureBootSettings
            + "}\n";
        string localConfig = "{\"host_path\":\"nix/hosts/" + self.spec.arch + "/VM-TEST/VM-TEST.nix\",\"target\":\"" + bootTargetName + "\"}\n";
        string luksCommand = encryption.equals("true")
            ? "printf %s " + UnixShell.quote(luksPass) + " > /tmp/plain_text_password.txt; chmod 600 /tmp/plain_text_password.txt; "
            : "";
        string command = "set -e; "
            + luksCommand
            + "rm -rf /etc/nixos/nix/hosts/" + otherArch + "; "
            + "rm -f " + UnixShell.quote(secureBootModulePath) + "; "
            + secureBootModuleCommand
            + "find /etc/nixos/nix/apps -maxdepth 1 -type f -name '*.nix' ! -name 'nixosctl.nix' -delete; "
            + "find /etc/nixos/nix/apps/home-manager -maxdepth 1 -type f -name '*.nix' -delete 2>/dev/null || true; "
            + "mkdir -p /etc/nixos/nix/apps/home-manager; "
            + "touch /etc/nixos/nix/apps/home-manager/.keep; "
            + "mkdir -p /etc/nixos/secrets; "
            + "printf %s " + UnixShell.quote(passwordHash) + " > /etc/nixos/secrets/hashed_password.txt; "
            + "chmod 600 /etc/nixos/secrets/hashed_password.txt; "
            + "mkdir -p " + UnixShell.quote(hostDir) + "; "
            + "printf %s " + UnixShell.quote(hostNix) + " > " + UnixShell.quote(hostPath) + "; "
            + "printf %s " + UnixShell.quote(localConfig) + " > /etc/nixos/config.json; "
            + "git -C /etc/nixos init; "
            + "git config --global --add safe.directory /etc/nixos; "
            + "git -C /etc/nixos add -A; "
            + "git -C /etc/nixos -c user.name=test -c user.email=test@test commit -m init --allow-empty";
        ExecResult result = self.remote.sshWithTimeout(command, false, 120);
        if (!result.ok()) {
            Console.error(result.stdout());
            NixosLog.fatal("Failed to configure VM host");
        }
    }

    public bool installNixosGuest() {
        string diskTarget = "VM-TEST-Disk-Operation";
        string bootTargetName = self.spec.args.getOrDefault("bootTarget", "Standard-Boot");
        bool secureBootTarget = bootTargetName.equals("Secure-Boot");
        string bootTarget = "VM-TEST-" + bootTargetName;
        string nix = "nix --extra-experimental-features nix-command --extra-experimental-features flakes";
        string disko = nix + " run --inputs-from /etc/nixos github:nix-community/disko -- --show-trace --flake /etc/nixos#"
            + diskTarget
            + " --mode destroy,format,mount --root-mountpoint /mnt --yes-wipe-all-disks";
        string install = "mkdir -p /mnt/etc; rm -rf /mnt/etc/nixos; cp -r /etc/nixos /mnt/etc/nixos; mkdir -p /mnt/nix/tmp; TMPDIR=/mnt/nix/tmp nixos-install --flake /mnt/etc/nixos#"
            + bootTarget
            + " --root /mnt --no-channel-copy --show-trace --no-root-password --max-jobs auto --cores 0";
        string lanzabooteInstall = secureBootTarget
            ? "nixos-enter --root /mnt --command "
                + UnixShell.quote("set -e; mkdir -p /var/lib/sbctl; if ! test -e /var/lib/sbctl/keys/db/db.pem || ! test -e /var/lib/sbctl/keys/db/db.key; then sbctl create-keys; fi; cmd=$(nix --extra-experimental-features nix-command --extra-experimental-features flakes eval --raw /etc/nixos#nixosConfigurations.VM-TEST-Secure-Boot.config.boot.lanzaboote.installCommand); tmp=$(mktemp -d); ln -s /nix/var/nix/profiles/system \"$tmp/system-1-link\"; sh -c \"$cmd --public-key /var/lib/sbctl/keys/db/db.pem --private-key /var/lib/sbctl/keys/db/db.key /boot $tmp/system-1-link\"; rm -rf \"$tmp\"")
            : "true";
        string snapshots = "nixos-enter --root /mnt --command "
            + UnixShell.quote("set -e; mkdir -p /.snapshots/@root /.snapshots/@home; rm -rf /.snapshots/@root/CLEAN /.snapshots/@home/CLEAN; btrfs subvolume snapshot -r / /.snapshots/@root/CLEAN; btrfs subvolume snapshot -r /home /.snapshots/@home/CLEAN; git config --global --add safe.directory /etc/nixos || true");
        string script = "set -ex\n"
            + "printf INSTALL_START > /tmp/nixos-install.status\n"
            + disko + "\n"
            + install + "\n"
            + lanzabooteInstall + "\n"
            + snapshots + "\n"
            + "printf INSTALL_OK > /tmp/nixos-install.status\n";
        string servicePath = "/run/current-system/sw/bin:/run/wrappers/bin:/nix/var/nix/profiles/default/bin:/bin:/usr/bin";
        string runner = "PATH=" + UnixShell.quote(servicePath) + "; export PATH; HOME=/root; export HOME; "
            + "rm -f /tmp/nixos-install.pipe; mkfifo /tmp/nixos-install.pipe; "
            + "tee /tmp/nixos-install.log < /tmp/nixos-install.pipe > /dev/ttyS0 & teepid=$!; "
            + "sh /tmp/nixos-install.sh > /tmp/nixos-install.pipe 2>&1 < /dev/null; "
            + "code=$?; "
            + "wait $teepid || true; rm -f /tmp/nixos-install.pipe; "
            + "if [ $code -ne 0 ]; then printf 'INSTALL_FAIL:%s\\n' \"$code\" > /tmp/nixos-install.status; fi";
        string prepare = "set -e; "
            + "rm -f /tmp/nixos-install.status /tmp/nixos-install.log /tmp/nixos-install.sh; "
            + "printf %s " + UnixShell.quote(script) + " > /tmp/nixos-install.sh; "
            + "chmod +x /tmp/nixos-install.sh";
        string launch = "set -e; "
            + "systemctl reset-failed nixos-install-e2e.service 2>/dev/null || true; "
            + "systemctl is-active --quiet nixos-install-e2e.service && exit 0; "
            + "systemd-run --unit=nixos-install-e2e --collect --property=Type=exec /bin/sh -c " + UnixShell.quote(runner);
        int timeoutSeconds = secureBootTarget ? 7200 : 3600;
        ExecResult prepared = self.sshWithRetries(prepare, 60, 3);
        if (!prepared.ok()) {
            Console.error(prepared.stdout());
            return false;
        }
        if (!self.launchInstall(launch)) {
            return false;
        }
        return self.waitForInstallStatus(timeoutSeconds);
    }

    public ExecResult sshWithRetries(string command, int timeoutSeconds, int attempts) {
        int attempt = 0;
        ExecResult last = ExecResult(1, "", "", "");
        while (attempt < attempts) {
            last = self.remote.sshWithTimeout(command, false, timeoutSeconds);
            if (last.ok()) { return last; }
            attempt = attempt + 1;
            if (attempt < attempts) { self.remote.host("sleep 3", false); }
        }
        return last;
    }

    public string installStatusText() {
        ExecResult status = self.remote.sshWithTimeout("if test -f /tmp/nixos-install.status; then cat /tmp/nixos-install.status; fi", false, 10);
        if (!status.ok()) { return ""; }
        return status.stdout();
    }

    public bool installWasLaunched() {
        string text = self.installStatusText();
        if (text.contains("INSTALL_START")) { return true; }
        if (text.contains("INSTALL_OK")) { return true; }
        if (text.contains("INSTALL_FAIL")) { return true; }
        ExecResult active = self.remote.sshWithTimeout("systemctl is-active --quiet nixos-install-e2e.service", false, 10);
        return active.ok();
    }

    public bool waitForInstallLaunch(int timeoutSeconds) {
        int elapsed = 0;
        while (elapsed < timeoutSeconds) {
            if (!self.state.isRunning()) {
                NixosLog.error("QEMU exited while launching NixOS installation; " + self.state.runningDetail() + "; QEMU log: " + self.qemuLogPath());
                return false;
            }
            if (self.installWasLaunched()) { return true; }
            self.remote.host("sleep 3", false);
            elapsed = elapsed + 3;
        }
        return false;
    }

    public bool launchInstall(string launch) {
        int attempts = 0;
        while (attempts < 3) {
            ExecResult launched = self.remote.sshWithTimeout(launch, false, 30);
            if (launched.ok()) { return true; }
            Console.error(launched.stdout());
            if (self.waitForInstallLaunch(15)) { return true; }
            attempts = attempts + 1;
        }
        return self.waitForInstallLaunch(30);
    }

    public void printInstallLog() {
        string command = "if test -f /tmp/nixos-install.log; then tail -n 240 /tmp/nixos-install.log; fi; "
            + "if test -f /tmp/nixos-install.status; then cat /tmp/nixos-install.status; fi";
        ExecResult log = self.remote.sshWithTimeout(command, false, 30);
        if (log.ok()) { Console.error(log.stdout()); }
    }

    public bool waitForInstallStatus(int timeoutSeconds) {
        int elapsed = 0;
        int unavailable = 0;
        while (elapsed < timeoutSeconds) {
            if (!self.state.isRunning()) {
                NixosLog.error("QEMU exited while NixOS installation was running; " + self.state.runningDetail() + "; QEMU log: " + self.qemuLogPath());
                self.printInstallLog();
                return false;
            }
            ExecResult status = self.remote.sshWithTimeout("if test -f /tmp/nixos-install.status; then cat /tmp/nixos-install.status; fi", false, 10);
            if (status.ok()) {
                unavailable = 0;
                string text = status.stdout();
                if (text.contains("INSTALL_OK")) { return true; }
                if (text.contains("INSTALL_FAIL")) {
                    self.printInstallLog();
                    return false;
                }
            } else {
                unavailable++;
                if (unavailable >= 20) {
                    self.printInstallLog();
                    return false;
                }
            }
            self.remote.host("sleep 15", false);
            elapsed = elapsed + 15;
        }
        self.printInstallLog();
        return false;
    }
}
