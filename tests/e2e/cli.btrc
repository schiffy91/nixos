import std.*;
import std.graph;
import ../../btrc/core/log.btrc;
import ./spec.btrc;
import ./qemu_harness.btrc;
import ./runner.btrc;
import ./graph.btrc;

/* The `nixosctl vm|e2e|graph` command surface — the test-harness CLI, split out
 * of NixosCtl so the top-level tool keeps only the real NixOS commands.
 * Stateless: each method drives the e2e classes (QemuE2eHarness, VmTestRunner,
 * VmGraphRunner) from parsed CliArgs.
 */
class E2eCli {
    public string tail(CliArgs args, int startIndex) {
        Vector<string> parts = [];
        for (int i = startIndex; i < args.count(); i++) {
            parts.push(args.get(i));
        }
        return parts.join(" ");
    }

    public void applyStructuralOverrides(VmTestSpec spec) {
        var archChanged = spec.args.has("arch");
        if (spec.args.has("name")) { spec.name = spec.args.get("name"); }
        if (spec.args.has("workDir")) { spec.workDir = spec.args.get("workDir"); }
        if (spec.args.has("arch")) { spec.arch = spec.args.get("arch"); }
        if (archChanged && !spec.args.has("iso")) {
            spec.iso = PathTools.join(PathTools.join(".vm", "iso"), "nixos-minimal-" + spec.arch + ".iso");
        }
        if (archChanged && !spec.args.has("isoUrl")) {
            spec.isoUrl = VmSpecArgs.defaultIsoUrl(spec.arch);
        }
        if (spec.args.has("iso")) { spec.iso = spec.args.get("iso"); }
        if (spec.args.has("isoUrl")) { spec.isoUrl = spec.args.get("isoUrl"); }
        if (spec.args.has("diskSize")) { spec.diskSize = spec.args.get("diskSize"); }
        if (spec.args.has("memory")) { spec.memory = spec.args.get("memory"); }
        if (spec.args.has("cpus")) { spec.cpus = Strings.toInt(spec.args.get("cpus")); }
        if (spec.args.has("sshPort")) { spec.sshPort = Strings.toInt(spec.args.get("sshPort")); }
        if (spec.args.has("state")) { spec.state = spec.args.get("state"); }
        if (spec.args.has("parentState")) { spec.parentState = spec.args.get("parentState"); }
        if (spec.args.has("stateRoot")) { spec.stateRoot = spec.args.get("stateRoot"); }
        if (spec.args.has("stateMaterial")) { spec.stateMaterial = spec.args.get("stateMaterial"); }
    }

    public void applySpecArgs(VmTestSpec spec, CliArgs args, int startIndex) {
        var overrides = GraphCli.args(args, startIndex);
        for key in overrides.keys() {
            spec.setArg(key, overrides.get(key));
        }
        self.applyStructuralOverrides(spec);
        spec.expandArgs();
    }

    public int runVm(CliArgs args) {
        if (args.count() < 3) {
            NixosLog.fatal("Usage: nixosctl vm <spec.json> <status|hash|setup|up|boot-iso|boot-disk|bootstrap-ssh|wait-ssh|ssh|snapshot|restore|reboot-disk|reboot-recovery|stop|reset-state|clean-state>");
        }
        var spec = VmSpecParser.readFile(args.get(1));
        self.applySpecArgs(spec, args, 3);
        var vm = QemuE2eHarness(spec);
        var action = args.get(2);

        if (action.equals("status")) { vm.printStatus(); return 0; }
        if (action.equals("hash")) { Console.log(spec.stateHash); return 0; }
        if (action.equals("setup")) { vm.setup(); return 0; }
        if (action.equals("download-iso")) { vm.downloadIso(); return 0; }
        if (action.equals("create-key")) { vm.createSshKey(); return 0; }
        if (action.equals("create-disk")) { vm.createDisk(); return 0; }
        if (action.equals("up")) { vm.upFromIso(); return 0; }
        if (action.equals("boot-iso")) { vm.start(true); return 0; }
        if (action.equals("boot-disk")) { vm.start(false); return 0; }
        if (action.equals("bootstrap-ssh")) { vm.bootstrapSsh(); return 0; }
        if (action.equals("wait-ssh")) {
            var timeout = Strings.toInt(args.valueAfter("--timeout", "180"));
            if (!vm.waitForSsh(timeout)) { return 1; }
            return 0;
        }
        if (action.equals("ssh")) {
            var command = self.tail(args, 3);
            if (command.isEmpty()) { NixosLog.fatal("Usage: nixosctl vm <spec.json> ssh <command>"); }
            var result = vm.ssh(command, false);
            Console.log(result.trimmed());
            return result.code;
        }
        if (action.equals("host")) {
            var command = self.tail(args, 3);
            if (command.isEmpty()) { NixosLog.fatal("Usage: nixosctl vm <spec.json> host <command>"); }
            var result = vm.host(command, false);
            Console.log(result.trimmed());
            return result.code;
        }
        if (action.equals("copy-workspace")) {
            vm.copyWorkspace(args.valueAfter("--local", ".."), args.valueAfter("--remote", "/etc/nixos"));
            return 0;
        }
        if (action.equals("configure-vm-host")) { vm.configureVmHost(); return 0; }
        if (action.equals("install-nixos")) { vm.installNixosGuest(); return 0; }
        if (action.equals("reboot-disk")) { vm.rebootDisk(); return 0; }
        if (action.equals("reboot-recovery")) { vm.rebootRecovery(); return 0; }
        if (action.equals("snapshot")) { vm.snapshot(args.valueAfter("--name", "manual")); return 0; }
        if (action.equals("restore")) { vm.restore(args.valueAfter("--name", "manual")); return 0; }
        if (action.equals("record-state")) { vm.recordState(); return 0; }
        if (action.equals("stop")) { vm.stop(); return 0; }
        if (action.equals("reset-state")) { vm.resetState(); return 0; }
        if (action.equals("clean-state")) { vm.resetState(); vm.cleanStateRecord(); return 0; }

        NixosLog.fatal("Unknown vm action: " + action);
        return 1;
    }

    public Map<string, string> graphArgs(CliArgs args, int startIndex) {
        return GraphCli.args(args, startIndex);
    }

    public Vector<string> graphTargets(CliArgs args, int startIndex) {
        return GraphCli.targets(args, startIndex);
    }

    public int runGraph(CliArgs args) {
        if (args.count() < 3) {
            NixosLog.fatal("Usage: nixosctl graph <graph.json> <list|status|coverage|run> [node ...] [--arg key=value]");
        }
        var graph = GraphParser.readFile(args.get(1));
        var action = args.get(2);
        var overrides = self.graphArgs(args, 3);
        var runner = VmGraphRunner(graph, overrides);
        if (action.equals("list")) {
            runner.list();
            return 0;
        }
        if (action.equals("status")) {
            runner.status();
            return 0;
        }
        if (action.equals("coverage")) {
            var code = runner.operationCoverage();
            return code;
        }
        if (action.equals("run")) {
            var code = runner.run(self.graphTargets(args, 3));
            return code;
        }
        NixosLog.fatal("Usage: nixosctl graph <graph.json> <list|status|coverage|run> [node ...] [--arg key=value]");
        return 1;
    }

    public int runE2e(CliArgs args) {
        if (args.count() < 2) { NixosLog.fatal("Usage: nixosctl e2e <spec.json>"); }
        var spec = VmSpecParser.readFile(args.get(1));
        self.applySpecArgs(spec, args, 2);
        var runner = VmTestRunner(spec);
        return runner.run();
    }
}
