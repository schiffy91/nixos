import std.*;
import ../spec/*;
import ./*;
import ../../../btrc/core/*;
import ../runner.btrc;
import ../qemu_harness.btrc;

class VmTestGraph {
    public string name;
    public string path;
    public string baseDir;
    public string workspaceRoot;
    public Vector<string> defaults;
    public Vector<VmGraphNode> nodes;

    public VmTestGraph() {
        self.name = "e2e";
        self.path = "";
        self.baseDir = ".";
        self.workspaceRoot = "..";
        self.defaults = [];
        self.nodes = [];
    }

    public VmGraphNode node(string id) {
        for node in self.nodes {
            if (node.id.equals(id)) { return node; }
        }
        NixosLog.fatal("Unknown graph node: " + id);
        return VmGraphNode();
    }

    public string resolvedSpecPath(VmGraphNode node) {
        if (node.specPath.startsWith("/")) { return node.specPath; }
        if (FileSystem.exists(node.specPath)) { return node.specPath; }
        return PathTools.join(self.baseDir, node.specPath);
    }

    public string resolvedWorkspaceRoot() {
        if (self.workspaceRoot.startsWith("/")) { return self.workspaceRoot; }
        return PathTools.join(self.baseDir, self.workspaceRoot);
    }

    public Vector<string> defaultTargets() {
        if (!self.defaults.isEmpty()) { return self.defaults; }
        Vector<string> result = [];
        for node in self.nodes {
            result.push(node.id);
        }
        return result;
    }
}

