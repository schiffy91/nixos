class VmGraphParser {
    class Vector<string> stringArray(string text, string key) {
        Vector<string> result = [];
        int pos = VmSpecParser.keyPosition(text, key);
        if (pos < 0) { return result; }
        int arrayStart = Strings.find(text, "[", pos);
        if (arrayStart < 0) { return result; }
        int len = text.len();
        bool inString = false;
        bool escaped = false;
        int start = -1;
        for (int i = arrayStart + 1; i < len; i++) {
            char c = text[i];
            if (inString) {
                if (!escaped && c == (char)34) {
                    result.push(JsonObject.slice(text, start, i));
                    inString = false;
                    start = -1;
                }
                escaped = !escaped && c == '\\';
                if (c != '\\') { escaped = false; }
                continue;
            }
            if (c == (char)34) {
                inString = true;
                escaped = false;
                start = i + 1;
                continue;
            }
            if (c == ']') { break; }
        }
        return result;
    }

    class Vector<string> objectArray(string text, string key) {
        Vector<string> result = [];
        int pos = VmSpecParser.keyPosition(text, key);
        if (pos < 0) { return result; }
        int arrayStart = Strings.find(text, "[", pos);
        if (arrayStart < 0) { return result; }
        int len = text.len();
        int depth = 0;
        int start = -1;
        bool inString = false;
        bool escaped = false;
        for (int i = arrayStart + 1; i < len; i++) {
            char c = text[i];
            if (inString) {
                if (!escaped && c == (char)34) { inString = false; }
                escaped = !escaped && c == '\\';
                if (c != '\\') { escaped = false; }
                continue;
            }
            if (c == (char)34) {
                inString = true;
                escaped = false;
                continue;
            }
            if (c == '{') {
                if (depth == 0) { start = i; }
                depth++;
                continue;
            }
            if (c == '}') {
                depth--;
                if (depth == 0 && start >= 0) {
                    result.push(JsonObject.slice(text, start, i + 1));
                    start = -1;
                }
                continue;
            }
            if (c == ']' && depth == 0) { break; }
        }
        return result;
    }

    class VmGraphNode node(string objectText) {
        VmGraphNode node = VmGraphNode();
        node.id = VmSpecParser.field(objectText, "id", "");
        node.specPath = VmSpecParser.field(objectText, "spec", "");
        node.after = VmGraphParser.stringArray(objectText, "after");
        string argsText = VmSpecParser.objectField(objectText, "args");
        if (!argsText.isEmpty()) {
            JsonObject parsed = JsonObject.parse(argsText);
            for key, value in parsed.values {
                node.args.put(key, value);
            }
        }
        if (node.id.isEmpty()) { NixosLog.fatal("Graph node is missing id"); }
        if (node.specPath.isEmpty()) { NixosLog.fatal("Graph node " + node.id + " is missing spec"); }
        return node;
    }

    class VmTestGraph readFile(string path) {
        string text = Path.readAll(path);
        VmTestGraph graph = VmTestGraph();
        graph.path = path;
        graph.baseDir = PathTools.dirname(path);
        graph.name = VmSpecParser.field(text, "name", graph.name);
        graph.workspaceRoot = VmSpecParser.field(text, "workspaceRoot", graph.workspaceRoot);
        graph.defaults = VmGraphParser.stringArray(text, "default");
        for objectText in VmGraphParser.objectArray(text, "nodes") {
            graph.nodes.push(VmGraphParser.node(objectText));
        }
        if (graph.nodes.isEmpty()) { NixosLog.fatal("Graph has no nodes: " + path); }
        return graph;
    }
}

