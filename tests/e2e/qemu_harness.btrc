#include "qemu/ssh.btrc"
#include "qemu/serial.btrc"
#include "qemu/firmware.btrc"

class QemuE2eHarness {
    public VmTestSpec spec;
    public UnixShell shell;
    public SshClient remote;
    public QemuSerial serial;
    public QemuFirmware firmware;

    public QemuE2eHarness(VmTestSpec spec) {
        self.spec = spec;
        self.shell = UnixShell();
        self.remote = SshClient(spec);
        self.serial = QemuSerial(spec);
        self.firmware = QemuFirmware(spec);
    }

    public string diskPath() { return PathTools.join(self.spec.workDir, "disk.qcow2"); }
    public string pidPath() { return PathTools.join(self.spec.workDir, "qemu.pid"); }
    public string monitorPath() { return PathTools.join(self.spec.workDir, "monitor.sock"); }
    public string qmpPath() { return PathTools.join(self.spec.workDir, "qmp.sock"); }
    public string sshKeyPath() { return PathTools.join(self.spec.workDir, "id_ed25519"); }
    public string sshPubKeyPath() { return self.sshKeyPath() + ".pub"; }
    public string parentStateDir() { return PathTools.join(self.spec.stateRoot, self.spec.parentState); }
    public string parentWorkDirFile() { return PathTools.join(self.parentStateDir(), "workDir"); }
    public string backingDiskFile() { return PathTools.join(self.spec.workDir, "backing-disk"); }

    public string absolutePath(string path) {
        Command command = Command("sh")
            .arg("-c")
            .arg("cd " + UnixShell.quote(PathTools.dirname(path)) + " && printf '%s/%s' \"$PWD\" " + UnixShell.quote(PathTools.basename(path)));
        ExecResult result = self.shell.runCommand(command);
        if (!result.ok()) { NixosLog.fatal("Failed to resolve path " + path); }
        return result.trimmed();
    }

    public void ensureWorkDir() {
        FileSystem.mkdirp(self.spec.workDir);
        FileSystem.mkdirp(PathTools.dirname(self.spec.iso));
    }

    public void downloadIso() {
        self.ensureWorkDir();
        if (FileSystem.exists(self.spec.iso)) { return; }
        if (self.spec.isoUrl.isEmpty()) {
            NixosLog.fatal("No iso or isoUrl in VM spec");
        }
        string tmp = f"{self.spec.iso}.tmp";
        Command curl = Command("curl")
            .arg("-L")
            .arg("-o")
            .arg(tmp)
            .arg(self.spec.isoUrl)
            .capture(false);
        ExecResult result = self.shell.runCommand(curl);
        if (!result.ok()) { NixosLog.fatal("Failed to download installer ISO"); }
        Command mv = Command("mv")
            .arg(tmp)
            .arg(self.spec.iso)
            .capture(false);
        self.shell.runCommand(mv);
    }

    public void createSshKey() {
        self.ensureWorkDir();
        if (FileSystem.exists(self.sshKeyPath())) { return; }
        Command cmd = Command("ssh-keygen")
            .arg("-t")
            .arg("ed25519")
            .arg("-N")
            .arg("")
            .arg("-f")
            .arg(self.sshKeyPath())
            .arg("-q")
            .capture(false);
        ExecResult result = self.shell.runCommand(cmd);
        if (!result.ok()) { NixosLog.fatal("Failed to create VM SSH key"); }
    }

    public string sshPubKey() {
        return Path.readAll(self.sshPubKeyPath()).trim();
    }

    public void createDisk() {
        self.ensureWorkDir();
        if (FileSystem.exists(self.diskPath())) { return; }
        Command cmd = Command("qemu-img")
            .arg("create")
            .arg("-f")
            .arg("qcow2")
            .arg(self.diskPath())
            .arg(self.spec.diskSize)
            .capture(false);
        ExecResult result = self.shell.runCommand(cmd);
        if (!result.ok()) { NixosLog.fatal("Failed to create VM disk"); }
    }

    public void setup() {
        self.downloadIso();
        self.createSshKey();
        self.createDisk();
        self.serial.extractBootSerial();
    }

    public void resetState() {
        self.stop();
        FileSystem.removeRecursive(self.spec.workDir);
        self.ensureWorkDir();
    }

    public void cleanStateRecord() {
        FileSystem.removeRecursive(self.spec.stateDir());
    }

    public void requireParentState() {
        if (self.spec.parentState.equals("root") || self.spec.parentState.isEmpty()) { return; }
        if (!FileSystem.exists(self.spec.parentHashFile())) {
            NixosLog.fatal(f"Missing parent state {self.spec.parentState}; run its test first");
        }
    }

    public void copyIfExists(string source, string target) {
        if (!FileSystem.exists(source)) { return; }
        Command cp = Command("cp").arg(source).arg(target).capture(false);
        ExecResult result = self.shell.runCommand(cp);
        if (!result.ok()) { NixosLog.fatal(f"Failed to copy state artifact {source}"); }
    }

    public void copyTreeIfExists(string source, string target) {
        if (!FileSystem.exists(source)) { return; }
        FileSystem.removeRecursive(target);
        Command cp = Command("cp").arg("-R").arg(source).arg(target).capture(false);
        ExecResult result = self.shell.runCommand(cp);
        if (!result.ok()) { NixosLog.fatal(f"Failed to copy state tree {source}"); }
    }

    public void inheritState() {
        self.requireParentState();
        if (self.spec.parentState.equals("root") || self.spec.parentState.isEmpty()) { return; }
        if (!FileSystem.exists(self.parentWorkDirFile())) {
            NixosLog.fatal(f"Parent state {self.spec.parentState} has no workDir record");
        }
        string parentWorkDir = Path.readAll(self.parentWorkDirFile()).trim();
        self.ensureWorkDir();
        string parentDisk = PathTools.join(parentWorkDir, "disk.qcow2");
        if (!FileSystem.exists(self.diskPath()) && FileSystem.exists(parentDisk)) {
            string backing = self.absolutePath(parentDisk);
            Command create = Command("qemu-img")
                .arg("create")
                .arg("-f")
                .arg("qcow2")
                .arg("-F")
                .arg("qcow2")
                .arg("-b")
                .arg(backing)
                .arg(self.diskPath())
                .capture(false);
            ExecResult result = self.shell.runCommand(create);
            if (!result.ok()) { NixosLog.fatal("Failed to create qcow2 state delta for " + self.spec.state); }
            Path.writeAll(self.backingDiskFile(), backing + "\n");
        }
        self.copyIfExists(PathTools.join(parentWorkDir, "id_ed25519"), self.sshKeyPath());
        self.copyIfExists(PathTools.join(parentWorkDir, "id_ed25519.pub"), self.sshPubKeyPath());
        self.copyIfExists(PathTools.join(parentWorkDir, "edk2-vars.fd"), self.firmware.firmwareVarsPath());
        self.copyTreeIfExists(PathTools.join(parentWorkDir, "tpm"), self.firmware.tpmDir());
    }

    public void recordState() {
        FileSystem.mkdirp(self.spec.stateDir());
        Path.writeAll(self.spec.stateHashFile(), self.spec.stateHash + "\n");
        Path.writeAll(PathTools.join(self.spec.stateDir(), "workDir"), self.spec.workDir + "\n");
        JsonObject metadata = JsonObject();
        metadata.setString("state", self.spec.state);
        metadata.setString("parentState", self.spec.parentState);
        metadata.setString("parentHash", self.spec.parentHash);
        metadata.setString("hash", self.spec.stateHash);
        metadata.setString("hashShort", self.spec.stateHashShort);
        metadata.setString("workDir", self.spec.workDir);
        metadata.setString("iso", self.spec.iso);
        metadata.setString("isoUrl", self.spec.isoUrl);
        metadata.setString("disk", self.diskPath());
        metadata.setString("uefi", self.firmware.uefiEnabled() ? "true" : "false");
        metadata.setString("secureBoot", self.firmware.secureBootEnabled() ? "true" : "false");
        metadata.setString("tpm2", self.firmware.tpm2Enabled() ? "true" : "false");
        if (FileSystem.exists(self.backingDiskFile())) {
            metadata.setString("delta", "qcow2-backing");
            metadata.setString("backingDisk", Path.readAll(self.backingDiskFile()).trim());
        } else {
            metadata.setString("delta", "base");
        }
        metadata.writeFile(PathTools.join(self.spec.stateDir(), "metadata.json"));
    }

    public bool isRunning() {
        if (!FileSystem.exists(self.pidPath())) { return false; }
        ExecResult result = self.shell.runRaw("kill -0 $(cat " + UnixShell.quote(self.pidPath()) + ") 2>/dev/null", false, false, "");
        return result.ok();
    }

    public bool hasSnapshot(string name) {
        if (!FileSystem.exists(self.diskPath())) { return false; }
        ExecResult result = self.shell.runUnchecked("qemu-img snapshot -l " + UnixShell.quote(self.diskPath()) + " | awk '{print $2}'");
        if (!result.ok()) { return false; }
        Vector<string> lines = Strings.split(result.stdout(), "\n");
        for line in lines {
            if (line.trim().equals(name)) { return true; }
        }
        return false;
    }

    public bool hasBackingDisk() {
        return FileSystem.exists(self.backingDiskFile());
    }

    public void printStatus() {
        string recorded = "no";
        if (FileSystem.exists(self.spec.stateHashFile())) {
            string savedHash = Path.readAll(self.spec.stateHashFile()).trim();
            recorded = savedHash.equals(self.spec.stateHash) ? "yes" : "stale";
        }
        Console.log("State:     " + self.spec.state);
        Console.log("Hash:      " + self.spec.stateHash);
        Console.log("Parent:    " + self.spec.parentState + " (" + self.spec.parentHash + ")");
        Console.log("Work dir:  " + self.spec.workDir);
        Console.log("Arch:      " + self.spec.arch);
        Console.log("ISO:       " + (FileSystem.exists(self.spec.iso) ? "yes" : "no") + " " + self.spec.iso);
        Console.log("Disk:      " + (FileSystem.exists(self.diskPath()) ? "yes" : "no") + " " + self.diskPath());
        Console.log("SSH key:   " + (FileSystem.exists(self.sshKeyPath()) ? "yes" : "no") + " " + self.sshKeyPath());
        Console.log("Running:   " + (self.isRunning() ? "yes" : "no"));
        Console.log("Recorded:  " + recorded + " " + self.spec.stateDir());
    }

    public void addAccelerator(Command cmd) {
        if (self.firmware.isDarwin()) {
            cmd.arg("-accel");
            cmd.arg(self.firmware.hostArchMatchesGuest() ? "hvf" : "tcg");
        } else if (self.firmware.hostArchMatchesGuest()) {
            cmd.arg("-enable-kvm");
        } else {
            cmd.arg("-accel");
            cmd.arg("tcg");
        }
    }

    public void addMachine(Command cmd) {
        if (!self.spec.arch.equals("aarch64")) { return; }
        cmd.arg("-machine");
        cmd.arg("virt");
        cmd.arg("-cpu");
        cmd.arg(self.firmware.hostArchMatchesGuest() ? "host" : "max");
        cmd.arg("-device");
        cmd.arg("virtio-rng-pci");
    }

    public void addMemoryCpus(Command cmd) {
        cmd.arg("-m");
        cmd.arg(self.spec.memory);
        cmd.arg("-smp");
        cmd.arg(Strings.fromInt(self.spec.cpus));
    }

    public void addStorageAndNetwork(Command cmd) {
        cmd.arg("-drive");
        cmd.arg("file=" + self.diskPath() + ",format=qcow2,if=virtio,cache=none");
        cmd.arg("-netdev");
        cmd.arg("user,id=net0,hostfwd=tcp::" + Strings.fromInt(self.spec.sshPort) + "-:22");
        cmd.arg("-device");
        cmd.arg("virtio-net-pci,netdev=net0");
    }

    public void addConsole(Command cmd) {
        cmd.arg("-display");
        cmd.arg("none");
        cmd.arg("-serial");
        cmd.arg("pipe:" + self.serial.serialBasePath());
        cmd.arg("-monitor");
        cmd.arg("unix:" + self.monitorPath() + ",server,nowait");
        cmd.arg("-qmp");
        cmd.arg("unix:" + self.qmpPath() + ",server,nowait");
    }

    public void addBootMedia(Command cmd, bool fromIso) {
        if (!fromIso) { return; }
        if (self.spec.arch.equals("x86_64") && !self.firmware.shouldUseUefi(fromIso)) {
            self.serial.extractBootSerial();
            cmd.arg("-kernel");
            cmd.arg(Path.readAll(self.serial.bootKernelFile()).trim());
            cmd.arg("-initrd");
            cmd.arg(Path.readAll(self.serial.bootInitrdFile()).trim());
            cmd.arg("-append");
            cmd.arg(Path.readAll(self.serial.bootAppendFile()).trim());
            cmd.arg("-cdrom");
            cmd.arg(self.spec.iso);
        } else {
            cmd.arg("-cdrom");
            cmd.arg(self.spec.iso);
            cmd.arg("-boot");
            cmd.arg("d");
        }
    }

    public void start(bool fromIso) {
        self.ensureWorkDir();
        if (FileSystem.exists(self.pidPath())) {
            NixosLog.info("QEMU pidfile exists; assuming VM is already running");
            return;
        }
        Command cmd = Command(self.firmware.qemuBinary());
        self.addAccelerator(cmd);
        self.addMachine(cmd);
        self.firmware.addFirmware(cmd, fromIso);
        self.addMemoryCpus(cmd);
        self.addStorageAndNetwork(cmd);
        self.addConsole(cmd);
        self.firmware.addTpm2(cmd);
        self.addBootMedia(cmd, fromIso);
        self.serial.prepareSerialPipe();
        self.serial.startSerialReader();
        cmd.arg("-daemonize");
        cmd.arg("-pidfile");
        cmd.arg(self.pidPath());
        cmd.capture(false);
        ExecResult result = self.shell.runCommand(cmd);
        if (!result.ok()) {
            self.serial.stopSerialReader();
            self.firmware.stopSwtpm();
            NixosLog.fatal("Failed to start QEMU");
        }
    }

    public void stop() {
        self.serial.stopSerialReader();
        if (FileSystem.exists(self.pidPath())) {
            string quotedPid = UnixShell.quote(self.pidPath());
            self.shell.runRaw("pid=$(cat " + quotedPid + "); kill $pid 2>/dev/null || true; sleep 2; kill -0 $pid 2>/dev/null && kill -9 $pid 2>/dev/null || true", false, false, "");
            FileSystem.removeRecursive(self.pidPath());
        }
        FileSystem.removeRecursive(self.monitorPath());
        FileSystem.removeRecursive(self.qmpPath());
        FileSystem.removeRecursive(self.serial.serialInPath());
        FileSystem.removeRecursive(self.serial.serialOutPath());
        self.firmware.stopSwtpm();
    }

    public void sleepSeconds(int seconds) {
        self.shell.runRaw("sleep " + Strings.fromInt(seconds), false, false, "");
    }

    public void bootstrapSsh() {
        self.createSshKey();
        string key = self.sshPubKey();
        self.serial.serialSend("");
        self.serial.serialSend("sudo install -d -m 700 /root/.ssh; echo " + UnixShell.quote(key) + " | sudo tee /root/.ssh/authorized_keys > /dev/null; sudo chmod 600 /root/.ssh/authorized_keys; sudo systemctl restart sshd");
        self.sleepSeconds(5);
    }

    public void upFromIso() {
        self.setup();
        self.start(true);
        self.sleepSeconds(20);
        self.bootstrapSsh();
        if (!self.waitForSsh(180)) {
            NixosLog.fatal("SSH was not ready after booting installer ISO");
        }
    }

    public void rebootDisk() {
        self.ssh("reboot", false);
        self.sleepSeconds(5);
        self.stop();
        self.start(false);
        if (!self.waitForSsh(180)) {
            NixosLog.fatal("SSH was not ready after disk reboot");
        }
    }

    // Remote execution lives in SshClient (qemu/ssh.btrc); these delegate.
    public ExecResult ssh(string command, bool checkStatus) { return self.remote.ssh(command, checkStatus); }
    public ExecResult sshWithTimeout(string command, bool checkStatus, int timeoutSeconds) { return self.remote.sshWithTimeout(command, checkStatus, timeoutSeconds); }
    public ExecResult host(string command, bool checkStatus) { return self.remote.host(command, checkStatus); }
    public ExecResult nixEval(string attribute, int timeoutSeconds) { return self.remote.nixEval(attribute, timeoutSeconds); }
    public ExecResult qmp(string command, int timeoutSeconds) { return self.remote.qmp(command, timeoutSeconds); }
    public ExecResult workspaceFileExists(string relativePath) { return self.remote.workspaceFileExists(relativePath); }
    public void copyWorkspace(string localPath, string remotePath) { self.remote.copyWorkspace(localPath, remotePath); }
    public void copyTo(string localPath, string remotePath) { self.remote.copyTo(localPath, remotePath); }
    public void copyFrom(string remotePath, string localPath) { self.remote.copyFrom(remotePath, localPath); }

    // Serial console lives in QemuSerial (qemu/serial.btrc); these delegate.
    public string serialLogPath() { return self.serial.serialLogPath(); }
    public void serialSend(string command) { self.serial.serialSend(command); }

    // Capability checks live in QemuFirmware (qemu/firmware.btrc); these delegate.
    public void requireCommand(string name) { self.firmware.requireCommand(name); }
    public void requireTpm2Capability() { self.firmware.requireTpm2Capability(); }
    public void requireUefiCapability() { self.firmware.requireUefiCapability(); }
    public void requireSecureBootCapability() { self.firmware.requireSecureBootCapability(); }
    public string secureBootCapabilityReport() { return self.firmware.secureBootCapabilityReport(); }

    public bool waitForSsh(int timeout) {
        int elapsed = 0;
        while (elapsed < timeout) {
            ExecResult result = self.ssh("true", false);
            if (result.ok()) { return true; }
            self.sleepSeconds(3);
            elapsed = elapsed + 8;
            if (elapsed > 0 && elapsed % 24 == 0) {
                self.bootstrapSsh();
            }
        }
        return false;
    }

    public void configureVmHost() {
        string mode = self.spec.args.getOrDefault("immutabilityMode", "reset");
        string enabled = self.spec.args.getOrDefault("immutabilityEnabled", "true");
        string bootTargetName = self.spec.args.getOrDefault("bootTarget", "Standard-Boot");
        string desktop = self.spec.args.getOrDefault("desktop", "none");
        string encryption = self.spec.args.getOrDefault("encryption", "false");
        string luksPass = "testpass123";
        bool secureBootTarget = bootTargetName.equals("Secure-Boot");
        string otherArch = self.spec.arch.equals("aarch64") ? "x86_64" : "aarch64";
        string serialConsole = self.spec.arch.equals("aarch64") ? "ttyAMA0,115200n8" : "ttyS0,115200n8";
        string initrdModules = self.spec.arch.equals("aarch64")
            ? "[ \"virtio_pci\" \"virtio_blk\" \"virtio_net\" \"virtio_mmio\" \"virtio_rng\" \"tpm_tis\" \"tpm_tis_core\" ]"
            : "[ \"virtio_pci\" \"virtio_blk\" \"virtio_net\" \"tpm_tis\" ]";
        string hostDir = "/etc/nixos/modules/hosts/" + self.spec.arch + "/VM-TEST";
        string hostPath = hostDir + "/VM-TEST.nix";
        string pubkey = self.sshPubKey();
        string passwordHash = "$6$vmtest$zfOOVFBtEpiYVE486Cybmppi9zXd0QKYfRZ5FRLsMV26K7vK6QHIpZpUo1sxVt7liGoR9C/W1I5ih4VCt34n3.";
        string secureBootSettings = secureBootTarget
            ? "  settings.boot.pkiBundle = \"/var/lib/sbctl\";\n"
            : "";
        string secureBootModulePath = "/etc/nixos/modules/system/vm-test-secure-boot.nix";
        string secureBootModule = "{ config, lib, pkgs, ... }: {\n"
            + "  config = lib.mkIf (config.networking.hostName == \"VM-TEST\" && config.settings.boot.method == \"Secure-Boot\") {\n"
            + "    boot.loader.timeout = lib.mkForce 0;\n"
            + "    boot.lanzaboote.autoGenerateKeys.enable = true;\n"
            + "    boot.lanzaboote.autoEnrollKeys.enable = true;\n"
            + "    boot.lanzaboote.allowUnsigned = true;\n"
            + "    boot.lanzaboote.autoEnrollKeys.includeMicrosoftKeys = true;\n"
            + "    boot.lanzaboote.autoEnrollKeys.autoReboot = false;\n"
            + "    environment.systemPackages = [ pkgs.sbctl ];\n"
            + "  };\n"
            + "}\n";
        string secureBootModuleCommand = secureBootTarget
            ? "printf %s " + UnixShell.quote(secureBootModule) + " > " + UnixShell.quote(secureBootModulePath) + "; "
            : "";
        string hostNix = "{ lib, ... }: {\n"
            + "  networking.hostName = \"VM-TEST\";\n"
            + "  networking.firewall.enable = lib.mkForce false;\n"
            + "  users.users.root.openssh.authorizedKeys.keys = [ \"" + pubkey + "\" ];\n"
            + "  boot.kernelParams = [ \"console=" + serialConsole + "\" ];\n"
            + "  boot.initrd.availableKernelModules = " + initrdModules + ";\n"
            + "  boot.plymouth.enable = lib.mkForce false;\n"
            + "  services.getty.autologinUser = lib.mkForce \"root\";\n"
            + "  services.openssh.enable = lib.mkForce true;\n"
            + "  services.openssh.settings.PermitRootLogin = lib.mkForce \"yes\";\n"
            + "  services.openssh.settings.UseDns = lib.mkForce false;\n"
            + "  settings.user.admin.autoUnlockWallet.enabled = false;\n"
            + "  settings.user.admin.homeManager.enable = false;\n"
            + "  settings.networking.identityAgent = \"none\";\n"
            + "  settings.networking.lanSubnet = \"10.0.2.0/24\";\n"
            + "  settings.disk.device = \"/dev/vda\";\n"
            + "  settings.disk.encryption.enable = " + encryption + ";\n"
            + "  settings.disk.immutability.enable = " + enabled + ";\n"
            + "  settings.disk.immutability.mode = \"" + mode + "\";\n"
            + "  settings.disk.immutability.persist.paths = lib.mkForce [ \"/etc/machine-id\" \"/etc/nixos\" \"/var/lib/nixos\" \"/var/lib/sbctl\" \"/var/log\" ];\n"
            + "  settings.disk.immutability.semipermeable_membrane.mode = \"" + mode + "\";\n"
            + "  settings.desktop.enable = " + (desktop.equals("none") ? "false" : "true") + ";\n"
            + "  settings.disk.swap.size = \"2G\";\n"
            + secureBootSettings
            + "}\n";
        string localConfig = "{\"host_path\":\"modules/hosts/" + self.spec.arch + "/VM-TEST/VM-TEST.nix\",\"target\":\"" + bootTargetName + "\"}\n";
        string luksCommand = encryption.equals("true")
            ? "printf %s " + UnixShell.quote(luksPass) + " > /tmp/plain_text_password.txt; chmod 600 /tmp/plain_text_password.txt; "
            : "";
        string command = "set -e; "
            + luksCommand
            + "rm -rf /etc/nixos/modules/hosts/" + otherArch + "; "
            + "rm -f " + UnixShell.quote(secureBootModulePath) + "; "
            + secureBootModuleCommand
            + "find /etc/nixos/modules/apps -maxdepth 1 -type f -name '*.nix' ! -name 'nixosctl.nix' -delete; "
            + "find /etc/nixos/modules/apps/home-manager -maxdepth 1 -type f -name '*.nix' -delete 2>/dev/null || true; "
            + "mkdir -p /etc/nixos/modules/apps/home-manager; "
            + "touch /etc/nixos/modules/apps/home-manager/.keep; "
            + "mkdir -p /etc/nixos/secrets; "
            + "printf %s " + UnixShell.quote(passwordHash) + " > /etc/nixos/secrets/hashed_password.txt; "
            + "chmod 600 /etc/nixos/secrets/hashed_password.txt; "
            + "mkdir -p " + UnixShell.quote(hostDir) + "; "
            + "printf %s " + UnixShell.quote(hostNix) + " > " + UnixShell.quote(hostPath) + "; "
            + "printf %s " + UnixShell.quote(localConfig) + " > /etc/nixos/config.json; "
            + "git -C /etc/nixos init; "
            + "git config --global --add safe.directory /etc/nixos; "
            + "git -C /etc/nixos add -A; "
            + "git -C /etc/nixos -c user.name=test -c user.email=test@test commit -m init --allow-empty";
        ExecResult result = self.sshWithTimeout(command, false, 120);
        if (!result.ok()) {
            Console.error(result.stdout());
            NixosLog.fatal("Failed to configure VM host");
        }
    }

    public void installNixosGuest() {
        string diskTarget = "VM-TEST-Disk-Operation";
        string bootTargetName = self.spec.args.getOrDefault("bootTarget", "Standard-Boot");
        bool secureBootTarget = bootTargetName.equals("Secure-Boot");
        string bootTarget = "VM-TEST-" + bootTargetName;
        string nix = "nix --extra-experimental-features nix-command --extra-experimental-features flakes";
        string disko = nix + " run --inputs-from /etc/nixos github:nix-community/disko -- --show-trace --flake /etc/nixos#"
            + diskTarget
            + " --mode destroy,format,mount --root-mountpoint /mnt --yes-wipe-all-disks";
        string install = "mkdir -p /mnt/etc; rm -rf /mnt/etc/nixos; cp -r /etc/nixos /mnt/etc/nixos; mkdir -p /mnt/nix/tmp; TMPDIR=/mnt/nix/tmp nixos-install --flake /mnt/etc/nixos#"
            + bootTarget
            + " --root /mnt --no-channel-copy --show-trace --no-root-password --cores 0";
        string lanzabooteInstall = secureBootTarget
            ? "nixos-enter --root /mnt --command "
                + UnixShell.quote("set -e; cmd=$(nix --extra-experimental-features nix-command --extra-experimental-features flakes eval --raw /etc/nixos#nixosConfigurations.VM-TEST-Secure-Boot.config.boot.lanzaboote.installCommand); tmp=$(mktemp -d); ln -s /nix/var/nix/profiles/system \"$tmp/system-1-link\"; sh -c \"$cmd --public-key /var/lib/sbctl/keys/db/db.pem --private-key /var/lib/sbctl/keys/db/db.key /boot $tmp/system-1-link\"; rm -rf \"$tmp\"")
            : "true";
        string snapshots = "nixos-enter --root /mnt --command "
            + UnixShell.quote("set -e; mkdir -p /.snapshots/@root /.snapshots/@home; rm -rf /.snapshots/@root/CLEAN /.snapshots/@home/CLEAN; btrfs subvolume snapshot -r / /.snapshots/@root/CLEAN; btrfs subvolume snapshot -r /home /.snapshots/@home/CLEAN; git config --global --add safe.directory /etc/nixos || true");
        string command = "set -e; " + disko + "; " + install + "; " + lanzabooteInstall + "; " + snapshots + "; echo INSTALL_OK";
        int timeoutSeconds = secureBootTarget ? 7200 : 3600;
        ExecResult result = self.sshWithTimeout(command, false, timeoutSeconds);
        if (!result.ok() || !result.stdout().contains("INSTALL_OK")) {
            Console.error(result.stdout());
            self.stop();
            NixosLog.fatal("NixOS installation failed");
        }
    }

    public void snapshot(string name) {
        self.stop();
        Command cmd = Command("qemu-img")
            .arg("snapshot")
            .arg("-c")
            .arg(name)
            .arg(self.diskPath())
            .capture(false);
        ExecResult result = self.shell.runCommand(cmd);
        if (!result.ok()) { NixosLog.fatal("Failed to create VM snapshot " + name); }
        if (FileSystem.exists(self.firmware.firmwareVarsPath())) {
            Command cp = Command("cp")
                .arg(self.firmware.firmwareVarsPath())
                .arg(self.firmware.firmwareVarsSnapshotPath(name))
                .capture(false);
            self.shell.runCommand(cp);
        }
    }

    public void restore(string name) {
        self.stop();
        if (!self.hasSnapshot(name) && self.hasBackingDisk()) {
            NixosLog.info("Snapshot " + name + " is inherited through qcow2 backing; restore is a no-op");
            return;
        }
        Command cmd = Command("qemu-img")
            .arg("snapshot")
            .arg("-a")
            .arg(name)
            .arg(self.diskPath())
            .capture(false);
        ExecResult result = self.shell.runCommand(cmd);
        if (!result.ok()) { NixosLog.fatal("Failed to restore VM snapshot " + name); }
        if (FileSystem.exists(self.firmware.firmwareVarsSnapshotPath(name))) {
            Command cp = Command("cp")
                .arg(self.firmware.firmwareVarsSnapshotPath(name))
                .arg(self.firmware.firmwareVarsPath())
                .capture(false);
            self.shell.runCommand(cp);
            self.firmware.makeFirmwareVarsWritable();
        }
    }

}
