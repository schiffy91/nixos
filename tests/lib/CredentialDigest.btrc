import ./Check.btrc;

class CredentialDigest {
    class string hash(string password, string salt) {
        var result = Check.exited(ChildProcess.run("openssl", ["dgst", "-sha256"], stdinData=password + salt, timeoutMilliseconds=5000));
        var fields = Strings.split(result.trimmed(), " ");
        var digest = fields.get(fields.len - 1);
        Check.that(digest.len() == 64, "SHA-256 fixture digest");
        var reversed = "";
        for (int index = digest.len() - 2; index >= 0; index -= 2) { reversed = reversed + digest.substring(index, 2); }
        return reversed.toUpper();
    }
}
