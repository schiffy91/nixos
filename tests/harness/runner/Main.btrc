import Library.CLI;
import Library.Network;
import Library.Platform;
import testkit.OwnedProcess;
import testkit.TestDirectory;

// What the graph runner keeps, reports and clears beyond pass or fail.
class GraphRunnerTests {
    private TestDirectory fixture;
    private string root;

    public GraphRunnerTests(string root) {
        self.fixture = TestDirectory("nixos-graph-runner"); self.root = root;
        Check.that(FileSystem.mkdirp(self.fixture.path(".vm")) == 0, "create state directory");
    }

    // A node keyed on the workspace's sources, or, with a parent, on its parent's state alone.
    private void node(string name, string command, string parent = "", string memory = "") {
        var material = parent.isEmpty() ? f"{name}:{{{{sourceHash}}}}" : name;
        var spec = JSONValue.parse(f"{{\"name\":\"{name}\",\"state\":\"{name}\",\"operations\":[]}}");
        spec.set("stateMaterial", JSONValue.makeString(material));
        spec.set("stateRoot", JSONValue.makeString(self.fixture.path(".vm/chain")));
        spec.set("workDir", JSONValue.makeString(self.fixture.path(f".vm/{name}-{{{{stateHashShort}}}}")));
        if (!parent.isEmpty()) { spec.set("parentState", JSONValue.makeString(parent)); }
        if (!memory.isEmpty()) { spec.set("memory", JSONValue.makeString(memory)); }
        var host = JSONValue.parse("{\"op\":\"host\"}");
        host.set("command", JSONValue.makeString(command));
        spec.get("operations").push(host); spec.get("operations").push(JSONValue.parse("{\"op\":\"record-state\"}"));
        self.fixture.json(f"{name}.json", spec);
    }

    private void graph(string nodes) {
        self.fixture.write("graph.json", "{\"name\":\"graph-runner\",\"workspaceRoot\":\".\",\"nodes\":[" + nodes + "]}");
    }

    private Vector<string> command(Vector<string> arguments) {
        Vector<string> command = ["graph", self.fixture.path("graph.json")];
        for argument in arguments { command.push(argument); }
        return command;
    }

    private ExecResult run(Vector<string> arguments) {
        return ChildProcess.run(PathTools.join(self.root, "build/nixosctl"), self.command(arguments), cwd=self.fixture.path(), environment=[f"NIXOS_CONFIG_ROOT={self.root}"], timeoutMilliseconds=60000);
    }

    private string said(ExecResult result) { return result.stdout() + result.stderr(); }

    // The last field of a node's status line: how long its last pass took.
    private string duration(string id) {
        for line in Strings.split(Check.exited(self.run(["status"])).stdout(), "\n") {
            if (!line.startsWith(f"{id} ")) { continue; }
            var fields = Strings.split(line.trim(), " ");
            return fields.get(fields.length - 1);
        }
        throw f"FAIL: no status line for {id}";
    }

    public void durations() {
        self.node("slow", "sleep 2"); self.node("fast", "true");
        self.graph("{\"id\":\"slow\",\"spec\":\"slow.json\"},{\"id\":\"fast\",\"spec\":\"fast.json\"}");
        Check.equal(self.duration("slow"), "-", "a node that has not passed has no duration");
        var first = Check.exited(self.run(["run", "slow", "fast"]));
        Check.that(self.said(first).contains("pass slow in "), "the run says how long a node took");
        var slow = self.duration("slow");
        Check.that(slow.endsWith("s"), f"a duration is in seconds: {slow}");
        int seconds = Strings.toInt(slow.substring(0, slow.length - 1));
        Check.that(seconds >= 2 && seconds < 20, f"the slow node's two seconds are kept: {slow}");
        var fast = self.duration("fast");
        Check.that(fast == "0s" || fast == "1s", f"the fast node took no time: {fast}");
        Check.exited(self.run(["run", "slow", "fast"]));
        Check.equal(self.duration("slow"), slow, "a skipped node keeps the duration of its last pass");
    }

    // The work directories under .vm, by name.
    private Vector<string> workDirs() {
        Vector<string> found = [];
        for name in FileSystem.listDir(self.fixture.path(".vm")).sorted() {
            if (name.startsWith("base-") || name.startsWith("delta-")) { found.push(name); }
        }
        return found;
    }

    private string recorded(string state) { return Path.readAll(self.fixture.path(f".vm/chain/{state}/workDir")).trim(); }

    private void base(string marker) {
        self.node("base", f"mkdir -p {{{{workDirShell}}}} && printf 'base\\n' >> {ShellWords.quote(self.fixture.path(marker))}");
    }

    public void collection() {
        var executions = self.fixture.path(".vm/executions");
        self.base(".vm/executions");
        // The delta's disk is recorded as backed by the base's, the way inherit-state records it.
        self.node("delta", f"mkdir -p {{{{workDirShell}}}} && printf '%s/disk.qcow2\\n' \"$(cat {ShellWords.quote(self.fixture.path(".vm/chain/base/workDir"))})\" > {{{{workDirShell}}}}/backing-disk && printf 'delta\\n' >> {ShellWords.quote(executions)}", "base");
        self.graph("{\"id\":\"base\",\"spec\":\"base.json\"},{\"id\":\"delta\",\"spec\":\"delta.json\",\"after\":[\"base\"]}");
        self.fixture.write(".vm/iso/installer.iso", "an image, not a state\n");
        self.fixture.write("Source.btrc", "int revision = 1;\n");

        Check.exited(self.run(["run", "delta"]));
        var first = self.workDirs();
        Check.that(first.length == 2, f"a base and a delta directory: {first.join(" ")}");
        Check.that(self.said(Check.exited(self.run(["gc"]))).contains("deleted 0 state directories"), "nothing to collect while every directory is current");
        Check.equal(self.workDirs().join(" "), first.join(" "), "current directories are kept");

        self.fixture.write("Source.btrc", "int revision = 2;\n");
        Check.exited(self.run(["run", "delta"]));
        Check.that(self.workDirs().length == 4, "a changed source leaves the replaced directories behind");
        var listed = Check.exited(self.run(["gc", "--dry-run"]));
        for name in first { Check.that(listed.stdout().contains(self.fixture.path(f".vm/{name}") + "\n"), f"the listing names {name}"); }
        Check.that(listed.stdout().contains("2 state directories that no current node references; nothing deleted"), "a dry run counts and deletes nothing");
        Check.that(self.workDirs().length == 4, "a dry run deletes nothing");

        Check.that(self.said(Check.exited(self.run(["gc"]))).contains("deleted 2 state directories"), "the replaced directories are collected");
        var current = self.workDirs();
        Check.that(current.length == 2 && !current.contains(first.get(0)) && !current.contains(first.get(1)), "only the current directories are left");
        Check.that(FileSystem.exists(self.fixture.path(".vm/iso/installer.iso")), "what is not a state directory is left alone");
        Check.exited(self.run(["run", "delta"]));
        Check.equal(Path.readAll(executions), "base\ndelta\nbase\ndelta\n", "collection leaves the current states ready");

        // The base's inputs change and it is not run again: no node's current state names its
        // directory any more, but the delta's disk is still a delta of it.
        var backing = self.recorded("base");
        self.base(".vm/other-executions");
        var retained = self.said(Check.exited(self.run(["gc"])));
        Check.that(retained.contains("deleted 0 state directories"), f"a directory another disk is backed by is kept: {retained}");
        Check.that(FileSystem.isDir(backing), "the backing directory is still there");
        Check.that(FileSystem.removeIfExists(PathTools.join(self.recorded("delta"), "backing-disk")), "drop the backing record");
        Check.that(self.said(Check.exited(self.run(["gc"]))).contains("deleted 1 state directories"), "without the backing record it is collected");
        Check.that(!FileSystem.exists(backing), "the stale directory is gone");
    }

    public void oneAtATime() {
        self.node("held", "sleep 12");
        self.graph("{\"id\":\"held\",\"spec\":\"held.json\"}");
        var running = OwnedProcess(PathTools.join(self.root, "build/nixosctl"), self.command(["run", "held"]), self.fixture.path("held.log"), self.fixture.path(), [f"NIXOS_CONFIG_ROOT={self.root}"]);
        try {
            var deadline = MonotonicClock.deadlineAfter(3000);
            while (!Path.readAll(self.fixture.path("held.log")).contains("run held") && MonotonicClock.before(deadline)) { Timer.sleepMillis(50); }
            for action in ["gc", "run"] {
                var refused = self.run([action, "held"]);
                Check.that(running.running(), f"the holding run ended before {action} could be tried against it");
                Check.that(refused.code != 0 && self.said(refused).contains("while another graph run or collection holds"), f"{action} is refused while a run holds the workspace: {self.said(refused)}");
            }
            Check.that(running.wait(MonotonicClock.deadlineAfter(40000)) == 0, "the run that held the workspace passes");
        } finally { running.close(); }
        Check.exited(self.run(["gc"]));
    }

    private string entry(string id, string after = "") {
        var parents = after.isEmpty() ? "" : f",\"after\":[\"{after}\"]";
        return f"{{\"id\":\"{id}\",\"spec\":\"{id}.json\"{parents}}}";
    }

    private long long elapsed(Vector<string> arguments, int code = 0) {
        var started = MonotonicClock.milliseconds();
        Check.exited(self.run(arguments), code);
        return MonotonicClock.milliseconds() - started;
    }

    public void together() {
        Vector<string> entries = [];
        for name in ["w1", "w2", "w3", "w4"] { self.node(name, "sleep 2"); entries.push(self.entry(name)); }
        self.graph(entries.join(","));
        var together = self.elapsed(["run", "w1", "w2", "w3", "w4", "--arg", "jobs=4", "--arg", "force=true"]);
        Check.that(together < 7000, f"four two-second nodes run together: {together} ms");
        var inTurn = self.elapsed(["run", "w1", "w2", "w3", "w4", "--arg", "jobs=1", "--arg", "force=true"]);
        Check.that(inTurn >= 8000, f"with one job they run in turn: {inTurn} ms");
        var again = Check.exited(self.run(["run", "w1", "w2", "w3", "w4"]));
        Check.that(again.stdout().contains("0 passed, 4 skipped, 0 failed, 0 blocked"), f"neither the job count nor force is part of a state: {self.said(again)}");

        var marker = self.fixture.path("parent-done");
        self.node("first", f"sleep 1 && touch {ShellWords.quote(marker)}");
        self.node("second", f"test -e {ShellWords.quote(marker)}", "first");
        self.graph(self.entry("first") + "," + self.entry("second", "first"));
        Check.exited(self.run(["run", "second", "--arg", "jobs=4"]));

        var survivor = self.fixture.path("survivor");
        self.node("bad", "sleep 1; printf 'the reason\\n'; exit 1");
        self.node("dependent", "true", "bad");
        self.node("independent", f"sleep 2 && touch {ShellWords.quote(survivor)}");
        self.graph(self.entry("bad") + "," + self.entry("dependent", "bad") + "," + self.entry("independent"));
        var broken = Check.exited(self.run(["run", "dependent", "independent", "--arg", "jobs=4"]), 1);
        Check.that(FileSystem.exists(survivor), "a failure does not stop a node that does not depend on it");
        Check.that(broken.stdout().contains("1 passed, 0 skipped, 1 failed, 1 blocked"), f"the summary counts every outcome: {self.said(broken)}");
        Check.that(broken.stdout().contains("  failed: bad (") && broken.stdout().contains("  blocked: dependent (waits on bad)"), "the summary names what failed and what it blocked");
        Check.that(self.said(broken).contains("the reason"), "the failed node's own output is shown");

        var ports = self.fixture.path("ports");
        entries = [];
        for name in ["p1", "p2", "p3"] { self.node(name, f"printf '%s\\n' {{{{sshPort}}}} >> {ShellWords.quote(ports)}; sleep 2"); entries.push(self.entry(name)); }
        self.graph(entries.join(","));
        Check.exited(self.run(["run", "p1", "p2", "p3", "--arg", "jobs=3"]));
        var given = Strings.split(Path.readAll(ports).trim(), "\n");
        Check.that(given.length == 3 && given.get(0) != given.get(1) && given.get(0) != given.get(2) && given.get(1) != given.get(2), f"nodes running together are given different ports: {given.join(" ")}");
        Check.that(Check.exited(self.run(["run", "p1", "p2", "p3", "--arg", "jobs=1"])).stdout().contains("0 passed, 3 skipped"), "the port a node was given is not part of its state");

        var busy = self.fixture.path("busy");
        var alone = f"test ! -e {ShellWords.quote(busy)} && touch {ShellWords.quote(busy)} && sleep 1 && rm {ShellWords.quote(busy)}";
        self.node("m1", alone, "", "8G"); self.node("m2", alone, "", "8G");
        self.graph(self.entry("m1") + "," + self.entry("m2"));
        Check.exited(self.run(["run", "m1", "m2", "--arg", "jobs=4", "--arg", "memoryBudget=8G"]));
        Check.exited(self.run(["run", "m1", "m2", "--arg", "jobs=4", "--arg", "memoryBudget=16G", "--arg", "force=true"]), 1);
    }

    // A state built on another takes over its SSH key; ssh will not use a private key that others can read.
    public void inheritedKey() {
        self.node("keyholder", "mkdir -p {{workDirShell}} && printf 'private\\n' > {{workDirShell}}/id_ed25519 && chmod 600 {{workDirShell}}/id_ed25519 && printf 'public\\n' > {{workDirShell}}/id_ed25519.pub");
        var heir = JSONValue.parse("{\"name\":\"heir\",\"state\":\"heir\",\"stateMaterial\":\"heir\",\"parentState\":\"keyholder\",\"operations\":[{\"op\":\"inherit-state\"},{\"op\":\"host\",\"command\":\"stat -c '%a %n' {{workDirShell}}/id_ed25519 {{workDirShell}}/id_ed25519.pub | cut -d/ -f1 | tr -d '\\\\n'\",\"expect\":\"600 644 \"},{\"op\":\"record-state\"}]}");
        heir.set("stateRoot", JSONValue.makeString(self.fixture.path(".vm/chain")));
        heir.set("workDir", JSONValue.makeString(self.fixture.path(".vm/heir-{{stateHashShort}}")));
        heir.set("iso", JSONValue.makeString(self.fixture.path(".vm/iso/none.iso")));
        self.fixture.json("heir.json", heir);
        self.graph(self.entry("keyholder") + "," + self.entry("heir", "keyholder"));
        var inherited = self.run(["run", "heir", "--arg", "jobs=1"]);
        Check.that(inherited.code == 0, f"an inherited private key stays private: {self.said(inherited)}");
    }

    private TCPListener heldPort() {
        for (int port = 22300; port < 22600; port++) {
            try { return TCPListener.listen(IPv4Address.any(), port); } catch (string busy) {}
        }
        throw "FAIL: no port to hold";
    }

    // A port something else listens on is passed over without a connection to whatever holds it.
    public void occupiedPort() {
        var held = self.heldPort();
        var given = self.fixture.path("given-port");
        self.node("porter", f"printf '%s' {{{{sshPort}}}} > {ShellWords.quote(given)}");
        self.graph(self.entry("porter"));
        Check.exited(self.run(["run", "porter", "--arg", "jobs=2"]));
        Check.that(Strings.toInt(Path.readAll(given)) != held.port() && Strings.toInt(Path.readAll(given)) >= 22300, f"the node is given another port than the one in use: {Path.readAll(given)}, held {held.port()}");
        Check.that(held.accept(300) == null, "nothing connected to the port in use");
        held.close();
    }

    // A node keyed on a derivation: its expression, and a node that builds it and counts its runs.
    private void derived(string name, string expression) {
        self.fixture.write(f"{name}.nix", expression);
        var spec = JSONValue.parse(f"{{\"name\":\"{name}\",\"state\":\"{name}\",\"derivation\":\"{name}.nix\",\"operations\":[{{\"op\":\"build-derivation\"}}]}}");
        spec.set("stateMaterial", JSONValue.makeString(name + ":{{derivation}}"));
        spec.set("stateRoot", JSONValue.makeString(self.fixture.path(".vm/chain")));
        spec.set("workDir", JSONValue.makeString(self.fixture.path(".vm/" + name + "-{{stateHashShort}}")));
        var count = JSONValue.parse("{\"op\":\"host\"}");
        count.set("command", JSONValue.makeString(f"printf '{name}\\n' >> {ShellWords.quote(self.fixture.path("builds"))}"));
        spec.get("operations").push(count); spec.get("operations").push(JSONValue.parse("{\"op\":\"record-state\"}"));
        self.fixture.json(f"{name}.json", spec);
    }

    private string reading(string input) {
        return "derivation { name = \"probe\"; system = builtins.currentSystem; builder = \"/bin/sh\"; args = [ \"-c\" \"echo ${builtins.hashString \"sha256\" (builtins.readFile ./" + input + ")} > $out\" ]; }\n";
    }

    public void derivations() {
        self.fixture.write("left.txt", "one\n"); self.fixture.write("right.txt", "one\n");
        self.derived("left", self.reading("left.txt")); self.derived("right", self.reading("right.txt"));
        self.graph(self.entry("left") + "," + self.entry("right"));
        var builds = self.fixture.path("builds");
        Check.exited(self.run(["run", "left", "right"]));
        Check.equal(Path.readAll(builds).trim().replace("\n", " ").length == 10 ? "both" : Path.readAll(builds), "both", "both derivations are built once");

        self.fixture.write("Unrelated.btrc", "int unrelated = 1;\n");
        self.fixture.write("secrets/key", "not for any build\n");
        Check.that(FileSystem.chmod(self.fixture.path("secrets"), 0o000) == 0, "close the secrets directory");
        var untouched = self.run(["run", "left", "right"]);
        Check.that(FileSystem.chmod(self.fixture.path("secrets"), 0o700) == 0, "reopen the secrets directory");
        Check.exited(untouched);
        Check.that(untouched.stdout().contains("0 passed, 2 skipped"), f"a source neither derivation reads reruns nothing: {self.said(untouched)}");

        self.fixture.write("left.txt", "two\n");
        var one = Check.exited(self.run(["run", "left", "right"]));
        Check.that(one.stdout().contains("1 passed, 1 skipped"), f"an input one derivation reads reruns that node alone: {self.said(one)}");
        Check.that(Path.readAll(builds).endsWith("left\n"), "and it is the node whose input changed");
        Check.that(Check.exited(self.run(["status"])).stdout().contains("left ready "), "status reads the same key");

        self.derived("broken", "derivation { name = ");
        self.graph(self.entry("left") + "," + self.entry("broken"));
        var failed = Check.exited(self.run(["run", "left", "broken", "--arg", "jobs=2"]), 1);
        Check.that(failed.stdout().contains("0 passed, 1 skipped, 1 failed") && self.said(failed).contains("syntax error"), f"an expression that does not evaluate fails its node with nix's reason: {self.said(failed)}");
    }

    // A node keyed on the files its host-side steps read.
    public void declaredInputs() {
        var runs = self.fixture.path("reader-runs");
        var spec = JSONValue.parse("{\"name\":\"reader\",\"state\":\"reader\",\"stateMaterial\":\"reader:{{inputs}}\",\"inputs\":\"tools helper.sh\",\"operations\":[]}");
        spec.set("stateRoot", JSONValue.makeString(self.fixture.path(".vm/chain")));
        spec.set("workDir", JSONValue.makeString(self.fixture.path(".vm/reader-{{stateHashShort}}")));
        var host = JSONValue.parse("{\"op\":\"host\"}");
        host.set("command", JSONValue.makeString(f"printf 'run\\n' >> {ShellWords.quote(runs)}"));
        spec.get("operations").push(host); spec.get("operations").push(JSONValue.parse("{\"op\":\"record-state\"}"));
        self.fixture.json("reader.json", spec);
        self.fixture.write("tools/probe.sh", "echo one\n"); self.fixture.write("helper.sh", "echo one\n"); self.fixture.write("elsewhere.sh", "echo one\n");
        self.graph(self.entry("reader"));
        Check.exited(self.run(["run", "reader"]));
        self.fixture.write("elsewhere.sh", "echo two\n");
        Check.exited(self.run(["run", "reader"]));
        Check.equal(Path.readAll(runs), "run\n", "a file the node does not name reruns nothing");
        self.fixture.write("tools/probe.sh", "echo two\n");
        Check.exited(self.run(["run", "reader"]));
        self.fixture.write("helper.sh", "echo two\n");
        Check.exited(self.run(["run", "reader"]));
        Check.equal(Path.readAll(runs), "run\nrun\nrun\n", "a change in a named directory or file reruns the node");
    }

    // A spec may be TOML or YAML as well as JSON: the same scenario in each reads the same.
    public void formats() {
        self.fixture.write("quick.json", "{\"name\":\"quick\",\"state\":\"quick\",\"stateMaterial\":\"quick\",\"operations\":[{\"op\":\"host\",\"command\":\"true\"},{\"op\":\"record-state\"}]}");
        for format in ["toml", "yaml"] {
            self.fixture.write(f"spec.{format}", Path.readAll(PathTools.join(self.root, f"tests/harness/runner/formats/{format}.{format}")));
        }
        self.graph("{\"id\":\"quick\",\"spec\":\"quick.json\"},{\"id\":\"spec-toml\",\"spec\":\"spec.toml\",\"after\":[\"quick\"]},{\"id\":\"spec-yaml\",\"spec\":\"spec.yaml\",\"after\":[\"spec-toml\"]}");
        var read = self.run(["run", "spec-yaml", "--arg", "jobs=1"]);
        Check.that(read.code == 0 && read.stdout().contains("3 passed"), f"a TOML and a YAML spec run like a JSON one: {self.said(read)}");
        Check.equal(Path.readAll(self.fixture.path(".vm/e2e/spec-toml/format.txt")), "toml-ok", "the TOML spec's arguments reach its commands");
        Check.equal(Path.readAll(self.fixture.path(".vm/e2e/spec-yaml/format.txt")), "yaml-ok", "the YAML spec's arguments reach its commands");
    }

    // With durations known, the node the longest chain waits behind goes first.
    public void longestChainFirst() {
        var sequence = self.fixture.path("sequence");
        for name in ["brief", "short", "head", "follower"] {
            var seconds = name == "follower" ? "3" : "1";
            self.node(name, f"printf '{name}\\n' >> {ShellWords.quote(sequence)}; sleep {seconds}", name == "follower" ? "head" : "");
        }
        self.graph(self.entry("brief") + "," + self.entry("short") + "," + self.entry("head") + "," + self.entry("follower", "head"));
        Check.exited(self.run(["run", "brief", "short", "follower", "--arg", "jobs=1"]));
        Check.equal(Path.readAll(sequence), "head\nbrief\nshort\nfollower\n", "with no duration known, a node others wait on goes first and the rest keep the graph's order");
        Check.exited(self.run(["run", "brief", "short", "follower", "--arg", "jobs=1", "--arg", "force=true"]));
        Check.equal(Path.readAll(sequence), "head\nbrief\nshort\nfollower\nhead\nfollower\nbrief\nshort\n", "once durations are known, the three-second follower outranks the one-second nodes");
    }

    // A node that needs much memory becomes ready while small ones run. It must get the room that frees
    // next, not watch small nodes behind it take that room one after another until none are left. A node
    // known to be brief may still run in the meantime, because it is gone before the room frees.
    public void largeNodeKeepsItsTurn() {
        var sequence = self.fixture.path("large-sequence");
        self.node("gate", f"printf 'gate\\n' >> {ShellWords.quote(sequence)}", "", "1G");
        self.node("large", f"printf 'large\\n' >> {ShellWords.quote(sequence)}; sleep 4", "gate", "3G");
        Vector<string> entries = [self.entry("gate"), self.entry("large", "gate")];
        for name in ["s1", "s2", "s3", "s4", "s5", "s6"] {
            self.node(name, f"printf '{name}\\n' >> {ShellWords.quote(sequence)}; sleep 3", "", "1G");
            entries.push(self.entry(name));
        }
        self.node("brief", f"printf 'brief\\n' >> {ShellWords.quote(sequence)}", "", "1G");
        entries.push(self.entry("brief"));
        self.graph(entries.join(","));
        Vector<string> command = ["run", "large", "s1", "s2", "s3", "s4", "s5", "s6", "brief", "--arg", "jobs=5", "--arg", "memoryBudget=4G"];
        Check.exited(self.run(command));
        var started = Strings.split(Path.readAll(sequence).trim(), "\n");
        Check.that(started.indexOf("large") >= 0 && started.indexOf("large") < started.indexOf("s4"), f"the large node starts before the small ones that were behind it: {started.join(" ")}");
        FileSystem.removeIfExists(sequence);
        command.push("--arg"); command.push("force=true");
        Check.exited(self.run(command));  // every duration is known now: the small nodes take three seconds, the brief one none
        started = Strings.split(Path.readAll(sequence).trim(), "\n");
        Check.that(started.indexOf("brief") < started.indexOf("large") && started.indexOf("large") < started.indexOf("s4"), f"a brief node runs in the room the large one is waiting for, and a three-second one does not: {started.join(" ")}");
    }

    public void namedSets() {
        var ran = self.fixture.path("set-ran");
        self.node("inside", f"printf 'inside\\n' >> {ShellWords.quote(ran)}");
        self.node("outside", f"printf 'outside\\n' >> {ShellWords.quote(ran)}");
        var nodes = self.entry("inside") + "," + self.entry("outside");
        self.fixture.write("graph.json", "{\"name\":\"graph-runner\",\"workspaceRoot\":\".\",\"sets\":{\"slow\":[\"inside\"]},\"nodes\":[" + nodes + "]}");
        Check.exited(self.run(["run-set", "slow"]));
        Check.equal(Path.readAll(ran).trim(), "inside", "a set runs its own nodes and no others");
        var unknown = Check.exited(self.run(["run-set", "fast"]), 1);
        Check.that(self.said(unknown).contains("no set named fast; its sets: slow"), f"an unknown set is refused by name: {self.said(unknown)}");
        self.fixture.write("graph.json", "{\"name\":\"graph-runner\",\"workspaceRoot\":\".\",\"sets\":{\"slow\":[\"gone\"]},\"nodes\":[" + nodes + "]}");
        var stale = Check.exited(self.run(["coverage"]), 1);
        Check.that(self.said(stale).contains("Set slow names a node the graph does not have: gone"), f"a set naming a missing node fails coverage: {self.said(stale)}");
    }

    public void close() { self.fixture.close(); }
}

int main() {
    try {
        var tests = GraphRunnerTests(Platform.currentDirectory());
        tests.durations();
        tests.collection();
        tests.oneAtATime();
        tests.together();
        tests.inheritedKey();
        tests.occupiedPort();
        tests.derivations();
        tests.formats();
        tests.declaredInputs();
        tests.longestChainFirst();
        tests.namedSets();
        tests.largeNodeKeepsItsTurn();
        tests.close();
        print("PASS: the graph keeps durations, collects only unreferenced state, holds its workspace, and runs nodes together within its budget"); return 0;
    } catch (string error) { print(error); return 1; }
}
