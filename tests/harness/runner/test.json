{
  "name": "graph-runner",
  "state": "graph-runner",
  "stateMaterial": "graph-runner:source={{sourceHash}}",
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "operations": [
    {
      "op": "host",
      "command": "make build/graph-runner-test && ./build/graph-runner-test",
      "timeout": 300,
      "expect": "PASS: the graph keeps durations, collects only unreferenced state, holds its workspace, and runs nodes together within its budget"
    },
    { "op": "record-state" }
  ]
}
