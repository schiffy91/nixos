import Library.Testing;
import Library.Vector;
import ../../config/pkgs/utils/nixosctl/lib/simulator/qemu/VmProvisioner.btrc;

int main() {
    /* every character must become a key, or the passphrase arrives truncated and
       the disk stays locked. Splitting on "" yields nothing, which is how this
       first shipped: only Enter was ever sent. */
    var codes = VmProvisioner.keyCodesFor("testpass123");
    Expect.intEq(codes.length, 11);
    Expect.strEq(codes.get(0), "t");
    Expect.strEq(codes.get(4), "p");
    Expect.strEq(codes.get(8), "1");
    Expect.strEq(codes.get(10), "3");

    Expect.intEq(VmProvisioner.keyCodesFor("").length, 0);
    Expect.strEq(VmProvisioner.keyCodeFor("a"), "a");
    Expect.strEq(VmProvisioner.keyCodeFor("7"), "7");
    Expect.strEq(VmProvisioner.keyCodeFor("-"), "minus");
    Expect.strEq(VmProvisioner.keyCodeFor(" "), "spc");

    /* a character with no key code must be refused, never silently dropped */
    Expect.isTrue(VmProvisioner.keyCodeFor("%").isEmpty());
    Expect.intEq(VmProvisioner.keyCodesFor("ab%cd").length, 0);

    print("PASS: every passphrase character becomes a key event");
    return 0;
}
