{
  "name": "tpm2-enroll",
  "state": "tpm2-enroll",
  "parentState": "installed-encrypted",
  "stateMaterial": "tpm2-enroll:encryption=true:tpm2=true:cryptenroll:ram={{memory}}:cpus={{cpus}}",
  "args": { "encryption": "true", "tpm2": "true", "immutabilityMode": "reset" },
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "memory": "8G",
  "cpus": 4,
  "sshPort": 2236,
  "operations": [
    { "op": "require-state" },
    { "op": "reset-state" },
    { "op": "inherit-state" },
    { "op": "restore", "name": "installed" },
    { "op": "boot-disk" },
    { "op": "sleep", "timeout": 15 },
    { "op": "serial-send", "command": "testpass123" },
    { "op": "sleep", "timeout": 7 },
    { "op": "serial-send", "command": "testpass123" },
    { "op": "sleep", "timeout": 7 },
    { "op": "serial-send", "command": "testpass123" },
    { "op": "sleep", "timeout": 7 },
    { "op": "serial-send", "command": "testpass123" },
    { "op": "wait-ssh", "timeout": 300 },
    { "op": "guest", "command": "P=$(blkid -t TYPE=crypto_LUKS -o device | head -1); printf %s \"$P\" > /tmp/luks; test -n \"$P\" && printf found || printf nopart", "expect": "found" },
    { "op": "guest", "command": "systemd-cryptenroll $(cat /tmp/luks) 2>/dev/null | grep -qiw tpm2 && printf pre-has || printf pre-clean", "expect": "pre-clean" },
    { "op": "guest", "command": "PASSWORD=testpass123 systemd-cryptenroll $(cat /tmp/luks) --tpm2-device=auto --tpm2-pcrs=7+12 && printf enabled", "expect": "enabled", "timeout": 120 },
    { "op": "guest", "command": "systemd-cryptenroll $(cat /tmp/luks) 2>/dev/null | grep -qiw tpm2 && printf post-has || printf post-clean", "expect": "post-has" },
    { "op": "guest", "command": "systemd-cryptenroll $(cat /tmp/luks) --wipe-slot=tpm2 && printf wiped-ok", "expect": "wiped-ok" },
    { "op": "guest", "command": "systemd-cryptenroll $(cat /tmp/luks) 2>/dev/null | grep -qiw tpm2 && printf still || printf wiped", "expect": "wiped" },
    { "op": "snapshot", "name": "tpm2-tested" },
    { "op": "record-state" },
    { "op": "stop" }
  ]
}
