{
  "name": "kernel-trust",
  "state": "kernel-trust",
  "stateMaterial": "kernel-trust:{{arch}}:source={{sourceHash}}",
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "operations": [
    {
      "op": "host",
      "command": "mkdir -p '.vm/e2e/{{state}}-{{stateHashShort}}' && nix-instantiate --eval --strict --expr 'import ./tests/kernel-trust/eval.nix { }' > '.vm/e2e/{{state}}-{{stateHashShort}}/eval.log' 2>&1 || { cat '.vm/e2e/{{state}}-{{stateHashShort}}/eval.log'; exit 1; }",
      "timeout": 180
    },
    {
      "op": "host",
      "command": "mkdir -p '.vm/e2e/{{state}}-{{stateHashShort}}' && nix-build tests/kernel-trust --no-out-link --cores 4 --max-jobs 1 > '.vm/e2e/{{state}}-{{stateHashShort}}/test.log' 2>&1 || { tail -100 '.vm/e2e/{{state}}-{{stateHashShort}}/test.log'; exit 1; }",
      "timeout": 3600
    },
    { "op": "record-state" }
  ]
}
