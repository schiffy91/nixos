{
  "name": "aarch64-QEMU-host",
  "state": "aarch64-QEMU-host",
  "parentState": "quick",
  "arch": "aarch64",
  "stateMaterial": "aarch64-QEMU-host:source={{sourceHash}}",
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "operations": [
    { "op": "require-state" },
    { "op": "require-uefi" },
    {
      "op": "workspace-file",
      "command": "nix/hosts/aarch64/QEMU/QEMU.nix",
      "expect": "exists"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.QEMU-Standard-Boot.pkgs.stdenv.hostPlatform.system",
      "expect": "aarch64-linux"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.QEMU-Standard-Boot.config.networking.hostName",
      "expect": "QEMU"
    },
    {
      "op": "nix-eval",
      "command": "diskoConfigurations.QEMU-Disk-Operation.disk.main.device",
      "expect": "/dev/vda"
    },
    {
      "op": "nix-eval",
      "command": "diskoConfigurations.QEMU-Disk-Operation.disk.main.content.partitions.root.content.type",
      "expect": "btrfs"
    },
    {
      "op": "nix-eval",
      "command": "nixosConfigurations.QEMU-Standard-Boot.config.system.build.toplevel.drvPath",
      "expect": "nixos-system-QEMU"
    },
    { "op": "record-state" }
  ]
}
