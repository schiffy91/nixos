{
  "name": "recovery-touch-keyboard",
  "state": "recovery-touch-keyboard",
  "stateMaterial": "recovery-touch-keyboard:drv={{derivation}}",
  "derivation": "tests/recovery/keyboard",
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "operations": [
    {
      "op": "build-derivation",
      "command": "--cores 4 --max-jobs 2",
      "timeout": 1800
    },
    {
      "op": "record-state"
    }
  ]
}
