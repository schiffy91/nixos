import Library.Testing;
import recovery.Mount;

int main() {
    var mount = JSONValue.parse("{\"source\":\"/dev/root[/root]\",\"options\":\"rw,subvol=/root,compress=zstd\"}");
    Expect.isTrue(RecoveryMount.subvolume(mount, "root"));
    Expect.isFalse(RecoveryMount.subvolume(mount, "roo"));
    Expect.isFalse(RecoveryMount.subvolume(mount, "other"));
    Expect.strEq(RecoveryMount.device("/dev/root[/root]"), "/dev/root");
    Expect.strEq(RecoveryMount.device("/dev/root"), "/dev/root");
    Expect.isTrue(RecoveryMount.option("ro,subvolid=5,noatime", "subvolid=5"));
    Expect.isFalse(RecoveryMount.option("ro,subvolid=50", "subvolid=5"));
    Expect.isTrue(RecoveryMount.covered(["/mnt/home"], "/mnt/home/alex"));
    Expect.isFalse(RecoveryMount.covered(["/mnt/home"], "/mnt/home-other"));
    Expect.isFalse(RecoveryMount.covered(["/mnt/home"], "/mnt/home"));
    Expect.isTrue(RecoveryMount.covered(["/"], "/home"));
    var recovery = RecoveryMount(JSONValue.makeObject(), "/mnt///");
    Expect.strEq(recovery.path("/"), "/mnt");
    Expect.strEq(recovery.path("/home"), "/mnt/home");
    Expect.strEq(RecoveryMount(JSONValue.makeObject(), "/").path("/home"), "/home");
    Expect.throws(() => { RecoveryMount(JSONValue.makeObject(), "relative"); });
    print("PASS: recovery mount identity, subvolume matching, persistence coverage and target paths");
    return 0;
}
