import Library.CLI;
import Library.Console;
import Library.JSON;
import recovery.Mount;

int main(int argc, char** argv) {
    try {
        var args = CLIArgs(argc, argv);
        var recovery = RecoveryMount(JSONValue.readFile(args.get(0)), args.get(1));
        recovery.top = args.get(2);
        recovery.run();
        return 0;
    } catch (string error) { Console.error(error); return 1; }
}
