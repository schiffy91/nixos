{
  "name": "immutability-files",
  "state": "immutability-files",
  "parentState": "installed-reset",
  "stateMaterial": "immutability-files:{{immutabilityVersion}}:{{immutabilityImplementation}}:{{immutabilityMode}}:ram={{memory}}:cpus={{cpus}}",
  "args": {
    "immutabilityVersion": "v2",
    "immutabilityImplementation": "immutability",
    "immutabilityMode": "reset"
  },
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "memory": "8G",
  "cpus": 4,
  "sshPort": 2231,
  "operations": [
    { "op": "require-state" },
    { "op": "reset-state" },
    { "op": "inherit-state" },
    { "op": "validate-immutability-v2" },
    { "op": "restore", "name": "installed" },
    { "op": "boot-disk" },
    { "op": "wait-ssh", "timeout": 180 },
    { "op": "guest", "command": "set -e; for i in $(seq 1 500); do echo x > /root/eph-$i; echo x > /etc/nixos/keep-$i; done; dd if=/dev/zero of=/root/ephbig bs=1M count=50; dd if=/dev/zero of=/etc/nixos/keepbig bs=1M count=50; sync; printf created", "expect": "created" },
    { "op": "guest", "command": "[ \"$(ls /root/eph-[0-9]* 2>/dev/null | wc -l)\" -eq 500 ] && printf eph-count-ok", "expect": "eph-count-ok" },
    { "op": "guest", "command": "[ \"$(ls /etc/nixos/keep-[0-9]* 2>/dev/null | wc -l)\" -eq 500 ] && printf keep-count-ok", "expect": "keep-count-ok" },
    { "op": "reboot-disk" },
    { "op": "guest", "command": "[ \"$(ls /root/eph-[0-9]* 2>/dev/null | wc -l)\" -eq 0 ] && printf eph-wiped", "expect": "eph-wiped" },
    { "op": "guest", "command": "test ! -e /root/ephbig && printf bigeph-wiped", "expect": "bigeph-wiped" },
    { "op": "guest", "command": "[ \"$(ls /etc/nixos/keep-[0-9]* 2>/dev/null | wc -l)\" -eq 500 ] && printf keep-kept", "expect": "keep-kept" },
    { "op": "guest", "command": "test -s /etc/nixos/keepbig && printf bigkeep-kept", "expect": "bigkeep-kept" },
    { "op": "snapshot", "name": "files-tested" },
    { "op": "record-state" },
    { "op": "stop" }
  ]
}
