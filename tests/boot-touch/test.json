{
  "name": "initrd-touch-unlock",
  "state": "initrd-touch-unlock",
  "stateMaterial": "initrd-touch-unlock:drv={{derivation}}:rotate={{rotate}}:layout={{layout}}:light={{light}}:multi={{multi}}:scale={{scale}}",
  "derivation": "tests/boot-touch --arg rotate {{rotate}} --argstr layout {{layout}} --arg light {{light}} --arg multi {{multi}} --arg scale {{scale}}",
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "args": {
    "rotate": "false",
    "layout": "us",
    "light": "false",
    "multi": "false",
    "scale": "1"
  },
  "operations": [
    {
      "op": "build-derivation",
      "command": "--cores 4 --max-jobs 1",
      "timeout": 3600
    },
    {
      "op": "record-state"
    }
  ]
}
