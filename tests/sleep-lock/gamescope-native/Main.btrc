import Library.CLI;
import ./Scenario.btrc;
int main(int argc, char** argv) {
    try {
        var lab = Lab(CLIArgs(argc, argv).require(0, "VM descriptor")); var scenario = GamescopeScenario(lab);
        try {
            scenario.start(); var mode = lab.settings().get("mode").asString();
            if (mode.equals("lock")) { scenario.lock(lab.settings().get("realSuspend").asBool()); }
            else if (mode.equals("suspend")) { scenario.suspendControl(); }
        } finally { scenario.diagnostics(); }
        lab.close(); print("PASS: real native Gamescope framebuffer and input"); return 0;
    } catch (string error) { print(error); return 1; }
}
