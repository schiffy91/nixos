import Library.CLI;
import Library.Testing;
import helpers.Authentication;
import helpers.Display;

bool checkPassword(string label, string executable, string expected, int expectedLength) {
    PasswordResponse? maybeResponse = PasswordPrompt(executable, label).read();
    if (maybeResponse == null) { return false; }
    PasswordResponse response = maybeResponse;
    bool ok = false;
    if (expectedLength >= 0) {
        ok = response.length() == expectedLength;
    } else {
        ok = response.matches(expected);
    }
    response.close();
    // Explicit close is idempotent when the owner leaves scope.
    response.close();
    return ok;
}

int main(int argc, char** argv) {
    var args = CLIArgs(argc, argv);
    Expect.intEq(args.count(), 1);
    var promptBinary = args.get(0);
    testResetWipeCount();
    Expect.isTrue(checkPassword("success", promptBinary, "fixture-password", -1));
    Expect.intEq(testReadWipeCount(), 1);
    Expect.isFalse(checkPassword("empty", promptBinary, "", -1));
    Expect.isFalse(checkPassword("nul", promptBinary, "", -1));
    Expect.isFalse(checkPassword("failed", promptBinary, "", -1));
    Expect.isFalse(checkPassword("overflow", promptBinary, "", -1));
    Expect.isFalse(checkPassword("success", "/nonexistent-plymouth", "", -1));
    Expect.intEq(testReadWipeCount(), 6);
    Expect.intEq(PasswordPrompt.maxResponseSize(), 512);
    Expect.isTrue(checkPassword("maximum", promptBinary, "", 512));
    Expect.intEq(testReadWipeCount(), 7);

    Expect.isTrue(testPamConversationContracts(promptBinary));
    Expect.isTrue(testDrmBlankPredicates());
    print("sleep helper contracts passed");
    return 0;
}
