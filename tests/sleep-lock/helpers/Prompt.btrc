import Library.Bytes;
import Library.CLI;
import Library.FileSystem;

int main(int argc, char** argv) {
    var args = CLIArgs(argc, argv);
    if (args.count() != 2 || args.get(0) != "ask-for-password") { return 1; }
    var mode = args.get(1);
    if (mode == "success") {
        return FileSystem.writeBytes("/proc/self/fd/1", Bytes.fromString("fixture-password")) ? 0 : 1;
    }
    if (mode == "empty") { return 0; }
    if (mode == "failed") {
        FileSystem.writeBytes("/proc/self/fd/1", Bytes.fromString("fixture-password"));
        return 1;
    }
    if (mode == "nul") {
        var nulBytes = Bytes();
        nulBytes.append('a');
        nulBytes.append(0);
        nulBytes.append('b');
        return FileSystem.writeBytes("/proc/self/fd/1", nulBytes) ? 0 : 1;
    }
    if (mode == "maximum" || mode == "overflow") {
        int count = mode == "maximum" ? 512 : 4096;
        var payload = Bytes();
        for (int index = 0; index < count; index++) { payload.append('x'); }
        return FileSystem.writeBytes("/proc/self/fd/1", payload) ? 0 : 1;
    }
    return 1;
}
