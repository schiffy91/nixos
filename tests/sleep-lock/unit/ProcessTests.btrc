import Library.CLI;
import Library.FileSystem;
import Library.Platform;
import Library.Process;
import Library.Strings;
import Library.Testing;
import Library.Timer;

class ProcessTests {
    private string executable;
    public ProcessTests(string executable) { self.executable = executable; }

    public void descriptors() {
        int descriptor = sleepTestOpenHighDescriptor();
        Expect.isTrue(descriptor >= 100 && sleepTestDescriptorInheritable(descriptor));
        try {
            var child = BackgroundProcess.start(self.executable, ["--check-descriptor", f"{descriptor}"]);
            Expect.isTrue(child.waitUntil(MonotonicClock.deadlineAfter(5000)) && child.code() == 0);
            Expect.isTrue(sleepTestDescriptorInheritable(descriptor));
        } finally {
            sleepTestCloseDescriptor(descriptor);
        }
    }

    public void arguments() {
        var child = BackgroundProcess.start(self.executable, ["--arguments", "", "spaces ' quotes $() ;"], ["BACKGROUND_PROCESS_TEST=literal value"]);
        Expect.isTrue(child.waitUntil(MonotonicClock.deadlineAfter(5000)) && child.code() == 37);
        child.stop(); child.stop();
        Expect.isTrue(!child.running() && child.code() == 37);
        Expect.isTrue(sleepTestChildReaped(child.pid()));
    }

    public void stopping(bool ignoreTerm) {
        var directory = TestDir("background-process-tests-");
        var ready = directory.join("ready");
        var child = BackgroundProcess.start(self.executable, [ignoreTerm ? "--ignore-term" : "--term", ready]);
        var deadline = MonotonicClock.deadlineAfter(5000);
        while (!FileSystem.isFile(ready) && child.running() && MonotonicClock.before(deadline)) { Timer.sleepMillis(10); }
        Expect.isTrue(FileSystem.isFile(ready) && child.running() && child.code() == -1);
        Expect.isFalse(child.waitUntil(MonotonicClock.deadlineAfter(0)));
        child.stop(ignoreTerm ? 20 : 2000);
        Expect.isTrue(!child.running() && child.code() == (ignoreTerm ? 137 : 42));
        child.stop();
        Expect.isTrue(sleepTestChildReaped(child.pid()));
    }

    public void failedLaunches() {
        var directory = TestDir("background-process-failures-");
        var invalid = directory.writeFile("invalid", "not an executable image\n", 0o700);
        for command in [directory.join("missing"), invalid] {
            bool failed = false;
            try { BackgroundProcess.start(command, []); }
            catch (string error) { failed = true; }
            Expect.isTrue(failed);
        }
        bool failed = false;
        try { BackgroundProcess.start(self.executable, [], ["invalid"]); }
        catch (string error) { failed = true; }
        Expect.isTrue(failed);
    }
}

int main(int argc, char** argv) {
    var args = CLIArgs(argc, argv);
    if (args.count() == 2 && args.get(0) == "--check-descriptor") {
        return sleepTestVerifyChildDescriptors(Strings.toInt(args.get(1)));
    }
    if (args.count() == 3 && args.get(0) == "--arguments") {
        Expect.strEq(args.get(1), "");
        Expect.strEq(args.get(2), "spaces ' quotes $() ;");
        Expect.strEq(Environment.get("BACKGROUND_PROCESS_TEST", ""), "literal value");
        return 37;
    }
    if (args.count() == 2) {
        sleepTestConfigureTermSignal(args.get(0) == "--ignore-term");
        Path.writeAll(args.get(1), "ready");
        while (!sleepTestWasTerminated()) { Timer.sleepMillis(10); }
        return 42;
    }
    var tests = ProcessTests(args.program);
    tests.descriptors();
    tests.arguments();
    tests.stopping(false);
    tests.stopping(true);
    tests.failedLaunches();
    print("PASS: background process streams, descriptor isolation, literal arguments, environment, exit status, deadlines, termination, reaping and launch failures");
    return 0;
}
