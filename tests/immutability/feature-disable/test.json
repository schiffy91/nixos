{
  "name": "immutability-feature-disable",
  "state": "immutability-feature-disable",
  "stateMaterial": "immutability-feature-disable:{{arch}}:source={{sourceHash}}",
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "operations": [
    {
      "op": "host",
      "command": "mkdir -p '.vm/e2e/{{state}}-{{stateHashShort}}' && nix-build tests/immutability/feature-disable --no-out-link --cores 4 --max-jobs 2 > '.vm/e2e/{{state}}-{{stateHashShort}}/test.log' 2>&1 || { tail -80 '.vm/e2e/{{state}}-{{stateHashShort}}/test.log'; exit 1; }",
      "timeout": 1800
    },
    { "op": "record-state" }
  ]
}
