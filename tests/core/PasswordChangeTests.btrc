#include <assert.h>

import Library.Bytes;
import Library.Platform;
import Library.Process;
import Library.Strings;
import Library.Terminal.PTYProcess;
import Library.Timer;
import Library.Vector;
import nixosctl.lib.PasswordPrompts;
import nixosctl.lib.PasswordChange;
import nixosctl.lib.accounts.UserAccount;

Vector<string> env() { return ["PATH=/run/current-system/sw/bin:/usr/bin:/bin", "LC_ALL=C"]; }

PTYProcess fakeChild(string script) {
    var child = PTYProcess.start("/bin/sh", ["/bin/sh", "-c", script], env());
    if (child == null) { throw "Cannot start PTY fixture"; }
    return child;
}

int drive(string script, Vector<string> responses) {
    var child = fakeChild(script);
    var deadline = MonotonicClock.deadlineAfter(10000);
    var answered = PasswordChange.answer(child, responses, deadline);
    if (!answered) { return -1; }
    return child.waitExitUntil(deadline);
}

void accountLookup() {
    var identity = ChildProcess.run("id", ["-un"]);
    assert(identity.ok());
    var account = UserAccount.find(identity.trimmed());
    if (account == null) { throw "Current account lookup failed"; }
    assert(account.current);
    var entry = ChildProcess.run("getent", ["passwd", account.name]);
    assert(entry.ok());
    var fields = Strings.split(entry.trimmed(), ":");
    assert(fields.len == 7);
    assert(account.name.equals(fields.get(0)));
    assert(account.homeDirectory.equals(fields.get(5)));

    // find() has already released the native record. Returned strings must
    // remain owned BTRC values across subsequent NSS lookups and releases.
    for (int i = 0; i < 32; i++) {
        var root = UserAccount.find("root");
        if (root == null) { throw "Root account lookup failed"; }
        assert(root.name.equals("root"));
        assert(root.current == Platform.isRoot());
    }
    assert(account.name.equals(fields.get(0)));
    assert(account.homeDirectory.equals(fields.get(5)));
    assert(UserAccount.find("") == null);
    assert(UserAccount.find("nixosctl:no-such-account") == null);
}

bool acceptText(PasswordPrompts prompts, string text) {
    prompts.feed(Bytes.fromString(text));
    return prompts.advance();
}

void promptBoundaries() {
    Vector<string> valid = ["New password:", "New Password: \t", "Enter new UNIX password: ",
        "\x1b[1;32mNew password:\x1b[0m ", "New \x1b[1mpassword:\x1b[0m",
        "New password:\x1b[123456789012345m"];
    for text in valid {
        var bytes = Bytes.fromString(text);
        for (int split = 0; split <= bytes.length(); split++) {
            var prompts = PasswordPrompts(false);
            prompts.feed(bytes.slice(0, split));
            prompts.feed(bytes.slice(split, bytes.length()));
            assert(prompts.ready());
            assert(prompts.advance());
            assert(!prompts.advance());
            assert(acceptText(prompts, "Retype new password: "));
            assert(prompts.complete());
        }
    }
    Vector<string> invalid = [" New password:", "New password: spoof", "New password:\x1b[m",
        "New password:\x1b[;1m", "New password:\x1b[1;m", "New password:\x1b[1;;2m",
        "New password:\x1b[1234567890123456m", "New password:\x1b[1J",
        "New password:\x1b]title", "New password:\x1b", "New password:\x1b[1"];
    for text in invalid {
        var prompts = PasswordPrompts(false);
        for (int i = 0; i < text.len(); i++) {
            prompts.feed(Bytes.fromString(text.substring(i, 1)));
        }
        assert(!prompts.ready());
        assert(!prompts.advance());
        assert(acceptText(prompts, "\r\nNew password: "));
    }
    for (int value = 0; value <= 127; value++) {
        if (value >= 32 && value != 127) { continue; }
        if (value == '\t' || value == '\r' || value == '\n') { continue; }
        var prompts = PasswordPrompts(false);
        var bytes = Bytes.fromString("New password:");
        bytes.append(value);
        prompts.feed(bytes);
        assert(!prompts.ready());
        assert(!prompts.advance());
    }
    var visible = Bytes.fromString("New password:");
    while (visible.length() < 128) { visible.append(' '); }
    var visibleLimit = PasswordPrompts(false);
    visibleLimit.feed(visible);
    assert(visibleLimit.ready());
    visibleLimit.feed(Bytes.fromString(" "));
    assert(!visibleLimit.ready());

    var decorated = Bytes();
    for (int i = 0; i < 44; i++) { decorated.appendBytes(Bytes.fromString("\x1b[1m")); }
    decorated.appendBytes(Bytes.fromString("New password:   "));
    assert(decorated.length() == 192);
    var rawLimit = PasswordPrompts(false);
    rawLimit.feed(decorated);
    assert(rawLimit.ready());
    rawLimit.feed(Bytes.fromString(" "));
    assert(!rawLimit.ready());
}

int main() {
    accountLookup();
    promptBoundaries();
    /* Classifier: 2-prompt (root) and 3-prompt (self-service) order, SGR decoration, rejects. */
    var root = PasswordPrompts(false);
    assert(acceptText(root, "New password: "));
    assert(acceptText(root, "Retype new password: "));
    assert(root.complete());
    var selfService = PasswordPrompts(true);
    assert(acceptText(selfService, "Current password: "));
    assert(acceptText(selfService, "\x1b[1mNew password:\x1b[0m "));
    assert(acceptText(selfService, "Retype new password: "));
    assert(selfService.complete());
    var wrongOrder = PasswordPrompts(true);
    assert(!acceptText(wrongOrder, "New password: "));
    var osc = PasswordPrompts(false);
    assert(!acceptText(osc, "\x1b]0;title\x07New password: "));
    var spoof = PasswordPrompts(false);
    assert(!acceptText(spoof, "Password for you: New password: x"));
    var split = PasswordPrompts(false);
    assert(!acceptText(split, "New pass"));
    assert(acceptText(split, "word: "));

    /* Password changes against fake passwd children on a real pty. */
    assert(drive("stty -echo; printf 'New password: '; read a; printf '\\nRetype new password: '; read b; [ \"$a\" = s3cret ] && [ \"$b\" = s3cret ]", ["s3cret", "s3cret"]) == 0);
    // SGR can arrive in a separate read after the visible prompt.
    assert(drive("stty -echo; printf 'New password:\\033['; sleep 0.05; printf '1m '; read a; printf '\\nRetype new password: '; read b; [ \"$a\" = secret ] && [ \"$b\" = secret ]", ["secret", "secret"]) == 0);
    assert(drive("stty -echo; printf 'Current password: '; read o; printf '\\nNew password: '; read a; printf '\\nRetype new password: '; read b; [ \"$o\" = old ] && [ \"$a\" = new ] && exit 7", ["old", "new", "new"]) == 7);
    /* A child that rejects the current password and exits is a failed change. */
    assert(drive("stty -echo; printf 'Current password: '; read o; exit 9", ["bad", "new", "new"]) == -1);
    /* Echo left on: the secret must never be sent. */
    assert(drive("printf 'New password: '; sleep 5", ["s3cret", "s3cret"]) == -1);
    /* Trailing bytes must be classified before any response, including NUL. */
    assert(drive("stty -echo; printf 'New password: '; sleep 0.05; printf 'spoof'; sleep 2", ["secret", "secret"]) == -1);
    assert(drive("stty -echo; printf 'New password: \\000'; sleep 2", ["secret", "secret"]) == -1);
    /* A prompt that never comes, and a stalled child, are bounded and reaped. */
    var silent = fakeChild("sleep 60");
    assert(!PasswordChange.answer(silent, ["x", "x"], MonotonicClock.deadlineAfter(1500)));
    silent.close();
    assert(silent.readUntil(MonotonicClock.deadlineAfter(10)) == null);
    var stalled = fakeChild("sleep 60");
    var started = MonotonicClock.milliseconds();
    assert(stalled.waitExitUntil(MonotonicClock.deadlineAfter(800)) == -1);
    assert(MonotonicClock.milliseconds() - started < 5000LL);
    assert(stalled.readUntil(MonotonicClock.deadlineAfter(10)) == null);
    /* Secrets with newlines are refused before they touch the pty. */
    var guard = fakeChild("sleep 5");
    assert(!PasswordChange.answer(guard, ["a\nb", "a\nb"], MonotonicClock.deadlineAfter(500)));
    assert(!PasswordChange.safeResponse("a\rb"));
    assert(!PasswordChange.safeResponse(null));
    assert(!PasswordChange.answer(guard, ["only-one-response"], MonotonicClock.deadlineAfter(500)));
    guard.close();

    print("PASS: password change prompts and PTY conversation (2/3 prompts, echo guard, deadlines, reaping)");
    return 0;
}
