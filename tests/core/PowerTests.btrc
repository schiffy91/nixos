import Library.Testing;
import ../../config/pkgs/utils/nixosctl/lib/desktop/PowerManager.btrc;

int main() {
    var profiles = PowerManager.parseProfiles("{\"type\":\"aa{sv}\",\"data\":[{\"Profile\":{\"type\":\"s\",\"data\":\"balanced\"}},{\"Profile\":{\"type\":\"s\",\"data\":\"power-saver\"}}]}");
    Expect.intEq(profiles.length, 2);
    Expect.isTrue(profiles.contains("balanced") && profiles.contains("power-saver"));
    Expect.isFalse(profiles.contains("performance"));
    for invalid in ["", "not json", "{}", "{\"data\":null}", "{\"data\":[{}]}"] {
        Expect.intEq(PowerManager.parseProfiles(invalid).length, 0);
    }
    Expect.strEq(PowerManager.label("performance"), "Performance");
    print("PASS: power profile availability and missing backend data");
    return 0;
}
