#include <assert.h>
#include <string.h>

import Library.Terminal.PTYProcess;
import Library.Timer;
import Library.Vector;
import ../../btrc/nixosctl/PasswdPromptClassifier.btrc;
import ../../btrc/nixosctl/PasswdDriver.btrc;

Vector<string> env() { return ["PATH=/run/current-system/sw/bin:/usr/bin:/bin", "LC_ALL=C"]; }

PTYProcess fakeChild(string script) {
    var child = PTYProcess.start("/bin/sh", ["/bin/sh", "-c", script], env());
    if (child == null) { throw "Cannot start PTY fixture"; }
    return child;
}

bool drive(string script, Vector<string> responses, int* exitCode) {
    var child = fakeChild(script);
    long long deadline = MonotonicClock.deadlineAfter(10000);
    bool answered = PasswdDriver.answer(child, responses, deadline);
    if (!answered) { child.close(); *exitCode = -1; return false; }
    *exitCode = child.waitExitUntil(deadline);
    return true;
}

int main() {
    /* Classifier: 2-prompt (root) and 3-prompt (self-service) order, SGR decoration, rejects. */
    var root = PasswdPromptClassifier(2);
    assert(root.feedText("New password: "));
    assert(root.feedText("Retype new password: "));
    assert(root.complete());
    var selfService = PasswdPromptClassifier(3);
    assert(selfService.feedText("Current password: "));
    assert(selfService.feedText("\x1b[1mNew password:\x1b[0m "));
    assert(selfService.feedText("Retype new password: "));
    assert(selfService.complete());
    var wrongOrder = PasswdPromptClassifier(3);
    assert(!wrongOrder.feedText("New password: "));
    var osc = PasswdPromptClassifier(2);
    assert(!osc.feedText("\x1b]0;title\x07New password: "));
    var spoof = PasswdPromptClassifier(2);
    assert(!spoof.feedText("Password for you: New password: x"));
    var split = PasswdPromptClassifier(2);
    assert(!split.feedText("New pass"));
    assert(split.feedText("word: "));

    /* Driver against fake passwd children on a real pty. */
    int code = 0;
    assert(drive("stty -echo; printf 'New password: '; read a; printf '\\nRetype new password: '; read b; [ \"$a\" = s3cret ] && [ \"$b\" = s3cret ]", ["s3cret", "s3cret"], &code));
    assert(code == 0);
    assert(drive("stty -echo; printf 'Current password: '; read o; printf '\\nNew password: '; read a; printf '\\nRetype new password: '; read b; [ \"$o\" = old ] && [ \"$a\" = new ] && exit 7", ["old", "new", "new"], &code));
    assert(code == 7);
    /* A child that rejects the current password and exits is a failed change. */
    assert(!drive("stty -echo; printf 'Current password: '; read o; exit 9", ["bad", "new", "new"], &code));
    /* Echo left on: the secret must never be sent. */
    int echoed = 0;
    assert(!drive("printf 'New password: '; sleep 5", ["s3cret", "s3cret"], &echoed));
    /* Trailing bytes must be classified before any response, including NUL. */
    assert(!drive("stty -echo; printf 'New password: '; sleep 0.05; printf 'spoof'; sleep 2", ["secret", "secret"], &code));
    assert(!drive("stty -echo; printf 'New password: \\000'; sleep 2", ["secret", "secret"], &code));
    /* A prompt that never comes, and a stalled child, are bounded and reaped. */
    var silent = fakeChild("sleep 60");
    assert(!PasswdDriver.answer(silent, ["x", "x"], MonotonicClock.deadlineAfter(1500)));
    silent.close();
    assert(silent.readUntil(MonotonicClock.deadlineAfter(10)) == null);
    var stalled = fakeChild("sleep 60");
    long long started = MonotonicClock.milliseconds();
    assert(stalled.waitExitUntil(MonotonicClock.deadlineAfter(800)) == -1);
    assert(MonotonicClock.milliseconds() - started < 5000LL);
    assert(stalled.readUntil(MonotonicClock.deadlineAfter(10)) == null);
    /* Secrets with newlines are refused before they touch the pty. */
    var guard = fakeChild("sleep 5");
    assert(!PasswdDriver.answer(guard, ["a\nb", "a\nb"], MonotonicClock.deadlineAfter(500)));
    assert(!PasswdDriver.safeResponse("a\rb"));
    assert(!PasswdDriver.safeResponse(null));
    guard.close();

    print("PASS: passwd prompt classifier and pty driver (2/3 prompts, echo guard, deadlines, reaping)");
    return 0;
}
