#include <assert.h>

import Library.FileSystem;

import ../../config/pkgs/utils/nixosctl/lib/NixosConfig.btrc;
import ../../config/pkgs/utils/nixosctl/lib/Installer.btrc;
import ../../config/pkgs/utils/nixosctl/lib/PasswordManager.btrc;

void expectHost(string hostPath, string host, string architecture) {
    assert(NixosConfig.hostOf(hostPath).equals(host));
    assert(NixosConfig.architectureOf(hostPath).equals(architecture));
}

int main() {
    expectHost("config/hosts/x86_64/FRACTAL-NORTH.nix", "FRACTAL-NORTH", "x86_64");
    expectHost("config/hosts/aarch64/VM-TEST.nix", "VM-TEST", "aarch64");
    expectHost("/etc/nixos/config/hosts/x86_64/VM-TEST.nix", "VM-TEST", "x86_64");

    /* a host may own a directory named after itself */
    expectHost("config/hosts/x86_64/VM-TEST/VM-TEST.nix", "VM-TEST", "x86_64");
    expectHost("config/hosts/aarch64/VM-TEST/VM-TEST.nix", "VM-TEST", "aarch64");

    /* a directory that merely resembles the host name is still the arch */
    expectHost("config/hosts/x86_64/VM-TEST-2/VM-TEST.nix", "VM-TEST", "VM-TEST-2");

    expectHost("config/hosts/x86_64/FRACTAL-NORTH/default.nix", "FRACTAL-NORTH", "x86_64");
    expectHost("config/hosts/aarch64/QEMU/default.nix", "QEMU", "aarch64");
    expectHost("nix/hosts/x86_64/FRACTAL-NORTH/FRACTAL-NORTH.nix", "FRACTAL-NORTH", "x86_64");

    /* locked and malformed shadow entries must never match a password */
    assert(PasswordManager.hashUsable("$6$salt$hash"));
    assert(PasswordManager.hashUsable("$y$j9T$salt$hash"));
    for locked in ["!", "*", "", "!!", "!$6$salt$hash", "x", "6$salt$hash"] {
        assert(!PasswordManager.hashUsable(locked));
    }

    var hostsRoot = "/tmp/nixosctl-naming-test";
    FileSystem.removeRecursive(hostsRoot);
    FileSystem.mkdirp(f"{hostsRoot}/x86_64/QEMU");
    FileSystem.writeText(f"{hostsRoot}/x86_64/QEMU/QEMU.nix", "{}");
    FileSystem.mkdirp(f"{hostsRoot}/aarch64/QEMU");
    FileSystem.writeText(f"{hostsRoot}/aarch64/QEMU/QEMU.nix", "{}");
    FileSystem.writeText(f"{hostsRoot}/x86_64/FRACTAL-NORTH.nix", "{}");

    assert(NixosConfig.outputNameOf(hostsRoot, f"{hostsRoot}/x86_64/QEMU/QEMU.nix").equals("QEMU-x86_64"));
    assert(NixosConfig.outputNameOf(hostsRoot, f"{hostsRoot}/aarch64/QEMU/QEMU.nix").equals("QEMU-aarch64"));
    assert(NixosConfig.outputNameOf(hostsRoot, f"{hostsRoot}/x86_64/FRACTAL-NORTH.nix").equals("FRACTAL-NORTH"));
    FileSystem.removeRecursive(hostsRoot);
    FileSystem.mkdirp(f"{hostsRoot}/x86_64/QEMU");
    FileSystem.mkdirp(f"{hostsRoot}/aarch64/QEMU");
    FileSystem.writeText(f"{hostsRoot}/x86_64/QEMU/default.nix", "{}");
    FileSystem.writeText(f"{hostsRoot}/aarch64/QEMU/default.nix", "{}");
    assert(NixosConfig.outputNameOf(hostsRoot, "nix/hosts/x86_64/QEMU/QEMU.nix").equals("QEMU-x86_64"));
    assert(NixosConfig.outputNameOf(hostsRoot, f"{hostsRoot}/aarch64/QEMU/default.nix").equals("QEMU-aarch64"));
    FileSystem.removeRecursive(hostsRoot);

    assert(Installer.memoryGigabytesIn("MemTotal:       16316884 kB\nSwapTotal: 0 kB") == 15);
    assert(Installer.memoryGigabytesIn("MemTotal:      131726068 kB") == 125);
    assert(Installer.memoryGigabytesIn("MemFree: 123 kB") == 0);
    assert(Installer.memoryGigabytesIn("") == 0);
    assert(Installer.jobsForMemory(15) == 1);
    assert(Installer.jobsForMemory(0) == 1);
    assert(Installer.jobsForMemory(125) == 15);
    assert(Installer.jobsForMemory(64) == 8);

    print("PASS: host/arch derivation from host paths, locked shadow entries rejected, install jobs bounded by RAM");
    return 0;
}
