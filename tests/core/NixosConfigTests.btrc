import Library.FileSystem;
import Library.Testing;

import ../../config/pkgs/utils/nixosctl/lib/NixosConfig.btrc;
import ../../config/pkgs/utils/nixosctl/lib/Installer.btrc;
import ../../config/pkgs/utils/nixosctl/lib/PasswordManager.btrc;

void expectHost(string hostPath, string host, string architecture) {
    Expect.strEq(NixosConfig.hostOf(hostPath), host);
    Expect.strEq(NixosConfig.architectureOf(hostPath), architecture);
}

int main() {
    expectHost("config/hosts/x86_64/FRACTAL-NORTH.nix", "FRACTAL-NORTH", "x86_64");
    expectHost("config/hosts/aarch64/VM-TEST.nix", "VM-TEST", "aarch64");
    expectHost("/etc/nixos/config/hosts/x86_64/VM-TEST.nix", "VM-TEST", "x86_64");

    /* a host may own a directory named after itself */
    expectHost("config/hosts/x86_64/VM-TEST/VM-TEST.nix", "VM-TEST", "x86_64");
    expectHost("config/hosts/aarch64/VM-TEST/VM-TEST.nix", "VM-TEST", "aarch64");

    /* a directory that merely resembles the host name is still the arch */
    expectHost("config/hosts/x86_64/VM-TEST-2/VM-TEST.nix", "VM-TEST", "VM-TEST-2");

    expectHost("config/hosts/x86_64/FRACTAL-NORTH/default.nix", "FRACTAL-NORTH", "x86_64");
    expectHost("config/hosts/aarch64/QEMU/default.nix", "QEMU", "aarch64");
    expectHost("nix/hosts/x86_64/FRACTAL-NORTH/FRACTAL-NORTH.nix", "FRACTAL-NORTH", "x86_64");

    /* locked and malformed shadow entries must never match a password */
    Expect.isTrue(PasswordManager.hashUsable("$6$salt$hash"));
    Expect.isTrue(PasswordManager.hashUsable("$y$j9T$salt$hash"));
    for locked in ["!", "*", "", "!!", "!$6$salt$hash", "x", "6$salt$hash"] {
        Expect.isFalse(PasswordManager.hashUsable(locked));
        Expect.isFalse(PasswordManager.verifyHash(locked, "testpass123"));
    }
    var knownHash = "$6$vmtest$R1jdYquxXuZE.kHaZb1YrcvsTVODhhOlZdmxLRBJaAcVvhF79ZCGL4vnxluk.OLQFZW.xXgHj.1HDRFmm5cdB.";
    Expect.isTrue(PasswordManager.verifyHash(knownHash, "testpass123"));
    Expect.isFalse(PasswordManager.verifyHash(knownHash, "wrongpass"));
    Expect.isFalse(PasswordManager.verifyHash(knownHash, ""));

    var firstTree = TestDir("nixosctl-naming-");
    firstTree.writeFile("x86_64/QEMU/QEMU.nix", "{}");
    firstTree.writeFile("aarch64/QEMU/QEMU.nix", "{}");
    firstTree.writeFile("x86_64/FRACTAL-NORTH.nix", "{}");
    Expect.strEq(NixosConfig.outputNameOf(firstTree.path, firstTree.join("x86_64/QEMU/QEMU.nix")), "QEMU-x86_64");
    Expect.strEq(NixosConfig.outputNameOf(firstTree.path, firstTree.join("aarch64/QEMU/QEMU.nix")), "QEMU-aarch64");
    Expect.strEq(NixosConfig.outputNameOf(firstTree.path, firstTree.join("x86_64/FRACTAL-NORTH.nix")), "FRACTAL-NORTH");

    var defaultTree = TestDir("nixosctl-default-naming-");
    defaultTree.writeFile("x86_64/QEMU/default.nix", "{}");
    defaultTree.writeFile("aarch64/QEMU/default.nix", "{}");
    Expect.strEq(NixosConfig.outputNameOf(defaultTree.path, "nix/hosts/x86_64/QEMU/QEMU.nix"), "QEMU-x86_64");
    Expect.strEq(NixosConfig.outputNameOf(defaultTree.path, defaultTree.join("aarch64/QEMU/default.nix")), "QEMU-aarch64");

    Expect.intEq(Installer.memoryGigabytesIn("MemTotal:       16316884 kB\nSwapTotal: 0 kB"), 15);
    Expect.intEq(Installer.memoryGigabytesIn("MemTotal:      131726068 kB"), 125);
    Expect.intEq(Installer.memoryGigabytesIn("MemFree: 123 kB"), 0);
    Expect.intEq(Installer.memoryGigabytesIn(""), 0);
    Expect.intEq(Installer.jobsForMemory(15), 1);
    Expect.intEq(Installer.jobsForMemory(0), 1);
    Expect.intEq(Installer.jobsForMemory(125), 15);
    Expect.intEq(Installer.jobsForMemory(64), 8);

    print("PASS: host/arch derivation from host paths, locked shadow entries rejected, install jobs bounded by RAM");
    return 0;
}
