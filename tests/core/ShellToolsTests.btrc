import ../../config/pkgs/dev/shell/Tools.btrc;
#include <assert.h>

int main() {
    assert(ShellTools.extract("[", "]", "[one]\nignored\n[two]\n").equals("one\ntwo"));
    assert(ShellTools.extract("[", "]", "before[one]after").equals("beforeoneafter"));
    assert(ShellTools.extract("[", "]", "[one][two]").equals("one][two"));
    assert(ShellTools.extract("a.b", "(end)", "a.bhello(end)").equals("hello"));
    var rejected = false;
    try { ShellTools.extract("[", "]", "missing"); } catch (string error) { rejected = true; }
    assert(rejected);
    assert(Pattern.matches("*.nix", "default.nix"));
    assert(!Pattern.matches("*.nix", "default.btrc"));
    print("PASS: literal substring delimiters, multiline and greedy matching, missing input and file patterns");
    return 0;
}
