import Library.CLI;
import ../../config/pkgs/utils/nixosctl/lib/core/Interactive.btrc;

int main(int argc, char** argv) {
    var args = CLIArgs(argc, argv);
    var hosts = args.require(0, "Supply the hosts directory");
    var selected = Interactive().askHostPath(hosts);
    print(f"SELECTED={selected}");
    return 0;
}
