import Library.CLI;
import unlock.LuksVolume;

int main(int argc, char** argv) {
    var arguments = CLIArgs(argc, argv);
    if (arguments.count() != 2) { return 2; }
    var unlocked = false;
    try {
        var volume = LuksVolume(arguments.get(0));
        var passphrase = BootPassphrase();
        try {
            const char* fixture = "fixture-password";
            passphrase.length = (int)strlen(fixture);
            memcpy(passphrase.secret.borrow(), fixture, passphrase.length);
            var key = volume.verifiedKey(passphrase);
            unlocked = key.capacity > 0;
            key.close();
        } finally { passphrase.close(); volume.close(); }
    } catch (string error) {}
    return unlocked == arguments.get(1).equals("1") ? 0 : 1;
}
