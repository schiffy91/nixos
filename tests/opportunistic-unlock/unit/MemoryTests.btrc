import Library.Console;
import unlock.Worker;

#include <assert.h>

class MemoryFixture {
    class void fill(LockedSecret secret, int value) { memset(secret.borrow(), value, secret.capacity); }
    class void expect(LockedSecret secret, int value) {
        var bytes = secret.borrow();
        for (int index = 0; index < secret.capacity; index++) { assert((unsigned char)bytes[index] == value); }
    }
    class long lockedKiB() {
        for line in Strings.split(Path.readAll("/proc/self/status"), "\n") {
            if (!line.startsWith("VmLck:")) { continue; }
            for field in Strings.split(line.replace("\t", " "), " ") {
                if (field.isDigit()) { return field.toLong(); }
            }
        }
        throw "Missing locked-memory accounting";
    }
    class void failWithSecret(LockedSecret secret) {
        try { throw "fixture failure"; }
        finally { secret.erase(); }
    }
    class void expectExceptionWipe(LockedSecret secret) {
        var failed = false;
        try { MemoryFixture.failWithSecret(secret); }
        catch (string error) { failed = true; }
        assert(failed);
        MemoryFixture.expect(secret, 0);
    }
}

int main() {
    assert(ProcessLimits.singleThreaded());
    assert(ProcessLimits.protectSecrets());
    var passphrase = BootPassphrase();
    passphrase.length = 16;
    MemoryFixture.fill(passphrase.secret, 0x5a);
    assert(MemoryFixture.lockedKiB() >= 4);
    var metadata = VolumeInventory.names("/proc/self/fd");
    assert(!metadata.isEmpty());
    var child = (int)fork();
    assert(child >= 0);
    if (child == 0) {
        assert(MemoryFixture.lockedKiB() == 0);
        assert(passphrase.secret.lockAfterFork());
        assert(MemoryFixture.lockedKiB() >= 4);
        // Exercise actual managed allocation, iteration and filesystem access
        // after fork; no parent-owned descriptors or runtime threads survive it.
        var names = VolumeInventory.names("/proc/self/fd");
        for name in names { assert(!f"/proc/self/fd/{name}".isEmpty()); }
        assert(names.len == metadata.len);
        var key = LockedSecret(64);
        MemoryFixture.fill(key, 0xa5);
        passphrase.secret.erase();
        MemoryFixture.expect(passphrase.secret, 0);
        MemoryFixture.expect(key, 0xa5);
        key.close();
        passphrase.close();
        assert(MemoryFixture.lockedKiB() == 0);
        _exit(0);
    }
    int status;
    assert((int)waitpid((pid_t)child, &status, 0) == child && WIFEXITED(status) && WEXITSTATUS(status) == 0);
    MemoryFixture.expect(passphrase.secret, 0x5a);
    assert(passphrase.length == 16);
    MemoryFixture.expectExceptionWipe(passphrase.secret);
    passphrase.close();
    passphrase.close();
    assert(passphrase.secret.borrow() == NULL);
    assert(MemoryFixture.lockedKiB() == 0);
    Console.log("PASS: locked ownership, exception wipe, independent key lifetime, managed metadata after fork and child relocking");
    return 0;
}
