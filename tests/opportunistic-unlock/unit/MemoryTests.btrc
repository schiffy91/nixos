import unlock.Native;
import unlock.Secrets;
import unlock.Devices;

#include <assert.h>

int main() {
    char* secret = SecretMemory.allocate();
    assert(secret != NULL);
    memset(secret, 0x5a, secretBytes);
    pid_t child = fork();
    assert(child >= (pid_t)0);
    if (child == (pid_t)0) {
        // mlock is not inherited across fork. Re-lock before touching the copy.
        assert(mlock(secret, secretBytes) == 0);
        SecretMemory.forgetPassword(secret);
        for (int i = 0; i < passwordLimit; i++) { assert(secret[i] == 0); }
        for (int i = passwordLimit; i < secretBytes; i++) { assert(secret[i] == 0x5a); }
        SecretMemory.wipe(secret);
        for (int i = 0; i < secretBytes; i++) { assert(secret[i] == 0); }
        SecretMemory.dispose(secret);
        _exit(0);
    }
    int status;
    assert(waitpid(child, &status, 0) == child && WIFEXITED(status) && WEXITSTATUS(status) == 0);
    for (int i = 0; i < secretBytes; i++) { assert(secret[i] == 0x5a); }
    SecretMemory.wipe(secret);
    for (int i = 0; i < secretBytes; i++) { assert(secret[i] == 0); }
    SecretMemory.dispose(secret);
    struct BlockDevice first;
    memset(&first, 0, sizeof(first));
    first.disk = (dev_t)1; first.sequence = 10; first.start = 100; first.size = 100;
    struct BlockDevice second = first;
    second.start = 199; assert(overlaps(&first, &second));
    second.start = 200; assert(!overlaps(&first, &second));
    second.start = 100; second.sequence = 11; assert(!overlaps(&first, &second));
    second.sequence = 10; second.disk = (dev_t)2; assert(!overlaps(&first, &second));
    printf("PASS: locked raw secret, password/key wipe boundary, fork isolation and device generation ranges\n");
    return 0;
}
