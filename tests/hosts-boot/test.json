{
  "name": "host-boot-{{hostName}}-{{target}}",
  "state": "host-booted-{{hostName}}-{{target}}",
  "stateMaterial": "host-boot:{{hostName}}:{{target}}:ram={{memory}}:cpus={{cpus}}",
  "args": {
    "arch": "x86_64",
    "hostName": "STEAM-DECK-OLED-VM",
    "target": "Standard-Boot",
    "password": "testpass123",
    "secureBoot": "false",
    "requireEnforced": "false",
    "assertPanel": "true"
  },
  "iso": "build/iso/iso/nixos-installer-{{arch}}-linux-{{hostName}}.iso",
  "isoUrl": "",
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "diskSize": "64G",
  "diskInterface": "nvme",
  "graphics": "virtio",
  "memory": "8G",
  "cpus": 4,
  "sshPort": 2256,
  "operations": [
    {
      "op": "require-state"
    },
    {
      "op": "reset-state"
    },
    {
      "op": "inherit-state"
    },
    {
      "op": "restore",
      "name": "installed"
    },
    {
      "op": "boot-disk"
    },
    {
      "op": "sleep",
      "timeout": 50
    },
    {
      "op": "qmp",
      "command": "{\"execute\":\"screendump\",\"arguments\":{\"filename\":\".vm/e2e/{{state}}-{{stateHashShort}}/panel-0.ppm\"}}",
      "timeout": 60
    },
    {
      "op": "host",
      "command": "if [ \"{{assertPanel}}\" != \"true\" ]; then echo \"panel pixels not asserted for this agent\"; printf panel-graphical; else python3 tests/hosts-boot/assert_panel.py '.vm/e2e/{{state}}-{{stateHashShort}}/panel-0.ppm'; fi",
      "expect": "panel-graphical",
      "timeout": 120
    },
    {
      "op": "host",
      "command": "bash tests/hosts-boot/unlock_and_wait.sh '.vm/e2e/{{state}}-{{stateHashShort}}' '{{password}}' 900 && printf boot0-reported",
      "expect": "boot0-reported",
      "timeout": 1000
    },
    {
      "op": "host",
      "command": "cp \".vm/e2e/{{state}}-{{stateHashShort}}/serial.log\" \".vm/e2e/{{state}}-{{stateHashShort}}/boot-0.log\" && printf saved",
      "expect": "saved",
      "timeout": 60
    },
    {
      "op": "host",
      "command": "python3 tests/hosts-boot/assert_health.py '.vm/e2e/{{state}}-{{stateHashShort}}/boot-0.log' 0 {{secureBoot}} false",
      "expect": "host-healthy",
      "timeout": 120
    },
    {
      "op": "stop"
    },
    {
      "op": "boot-disk"
    },
    {
      "op": "sleep",
      "timeout": 50
    },
    {
      "op": "qmp",
      "command": "{\"execute\":\"screendump\",\"arguments\":{\"filename\":\".vm/e2e/{{state}}-{{stateHashShort}}/panel-1.ppm\"}}",
      "timeout": 60
    },
    {
      "op": "host",
      "command": "if [ \"{{assertPanel}}\" != \"true\" ]; then echo \"panel pixels not asserted for this agent\"; printf panel-graphical; else python3 tests/hosts-boot/assert_panel.py '.vm/e2e/{{state}}-{{stateHashShort}}/panel-1.ppm'; fi",
      "expect": "panel-graphical",
      "timeout": 120
    },
    {
      "op": "host",
      "command": "bash tests/hosts-boot/unlock_and_wait.sh '.vm/e2e/{{state}}-{{stateHashShort}}' '{{password}}' 900 && printf boot1-reported",
      "expect": "boot1-reported",
      "timeout": 1000
    },
    {
      "op": "host",
      "command": "cp \".vm/e2e/{{state}}-{{stateHashShort}}/serial.log\" \".vm/e2e/{{state}}-{{stateHashShort}}/boot-1.log\" && printf saved",
      "expect": "saved",
      "timeout": 60
    },
    {
      "op": "host",
      "command": "python3 tests/hosts-boot/assert_health.py '.vm/e2e/{{state}}-{{stateHashShort}}/boot-1.log' 0 {{secureBoot}} {{requireEnforced}}",
      "expect": "host-healthy",
      "timeout": 120
    },
    {
      "op": "host",
      "command": "for b in 0 1; do grep -aE '^E2E-(STATE|FAILED|REFUSED|HOMEMANAGER|SNAPSHOTS|SWAP|UNLOCKAGENT)' \".vm/e2e/{{state}}-{{stateHashShort}}/boot-$b.log\" | sed -E 's/^(E2E-UNLOCKAGENT [a-z0-9]+).*/\\\\1/' | sort > \".vm/e2e/{{state}}-{{stateHashShort}}/norm-$b.txt\"; done; diff \".vm/e2e/{{state}}-{{stateHashShort}}/norm-0.txt\" \".vm/e2e/{{state}}-{{stateHashShort}}/norm-1.txt\" > /dev/null && printf boots-identical || { echo 'boots differ'; diff \".vm/e2e/{{state}}-{{stateHashShort}}/norm-0.txt\" \".vm/e2e/{{state}}-{{stateHashShort}}/norm-1.txt\"; exit 1; }",
      "expect": "boots-identical",
      "timeout": 120
    },
    {
      "op": "stop"
    }
  ],
  "parentState": "host-installed-{{hostName}}-{{target}}"
}
