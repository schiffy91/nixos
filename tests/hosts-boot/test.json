{
  "name": "host-boot-{{hostName}}-{{target}}",
  "state": "host-booted-{{hostName}}-{{target}}",
  "stateMaterial": "host-boot:{{hostName}}:{{target}}:ram={{memory}}:cpus={{cpus}}",
  "args": {
    "arch": "x86_64",
    "hostName": "STEAM-DECK-OLED-VM",
    "target": "Standard-Boot",
    "password": "testpass123",
    "secureBoot": "false",
    "requireEnforced": "false",
    "assertPanel": "true",
    "unlockAgent": "unl0kr",
    "enablesSecureBoot": "false",
    "reenrollsKeys": "false"
  },
  "iso": "build/iso/iso/nixos-installer-{{arch}}-linux-{{hostName}}.iso",
  "isoUrl": "",
  "workDir": ".vm/e2e/{{state}}-{{stateHashShort}}",
  "diskSize": "64G",
  "diskInterface": "nvme",
  "graphics": "virtio",
  "memory": "8G",
  "cpus": 4,
  "sshPort": 2256,
  "operations": [
    {
      "op": "require-state"
    },
    {
      "op": "reset-state"
    },
    {
      "op": "inherit-state"
    },
    {
      "op": "restore",
      "name": "installed"
    },
    {
      "op": "boot-disk"
    },
    {
      "op": "sleep",
      "timeout": 50
    },
    {
      "op": "qmp",
      "command": "{\"execute\":\"screendump\",\"arguments\":{\"filename\":\".vm/e2e/{{state}}-{{stateHashShort}}/panel-0.ppm\"}}",
      "timeout": 60
    },
    {
      "op": "host",
      "command": "./build/boot-evidence panel '.vm/e2e/{{state}}-{{stateHashShort}}/panel-0.ppm' {{unlockAgent}}",
      "expect": "panel-graphical",
      "timeout": 120
    },
    {
      "op": "qmp",
      "command": "{\"execute\":\"send-key\",\"arguments\":{\"keys\":[{\"type\":\"qcode\",\"data\":\"a\"}],\"hold-time\":100}}",
      "timeout": 60
    },
    {
      "op": "sleep",
      "timeout": 5
    },
    {
      "op": "qmp",
      "command": "{\"execute\":\"screendump\",\"arguments\":{\"filename\":\".vm/e2e/{{state}}-{{stateHashShort}}/panel-0-typed.ppm\"}}",
      "timeout": 60
    },
    {
      "op": "host",
      "command": "./build/boot-evidence responds '.vm/e2e/{{state}}-{{stateHashShort}}/panel-0.ppm' '.vm/e2e/{{state}}-{{stateHashShort}}/panel-0-typed.ppm' '{{unlockAgent}}'",
      "expect": "panel-responds",
      "timeout": 120
    },
    {
      "op": "qmp",
      "command": "{\"execute\":\"send-key\",\"arguments\":{\"keys\":[{\"type\":\"qcode\",\"data\":\"backspace\"}],\"hold-time\":100}}",
      "timeout": 60
    },
    {
      "op": "sleep",
      "timeout": 3
    },
    {
      "op": "host",
      "command": "bash tests/hosts-boot/unlock_and_wait.sh '.vm/e2e/{{state}}-{{stateHashShort}}' '{{password}}' 900 && printf boot0-reported",
      "expect": "boot0-reported",
      "timeout": 1000
    },
    {
      "op": "qmp",
      "command": "{\"execute\":\"screendump\",\"arguments\":{\"filename\":\".vm/e2e/{{state}}-{{stateHashShort}}/panel-0-unlocked.ppm\"}}",
      "timeout": 60
    },
    {
      "op": "host",
      "command": "./build/boot-evidence panel '.vm/e2e/{{state}}-{{stateHashShort}}/panel-0-unlocked.ppm' console-silent",
      "expect": "panel-graphical",
      "timeout": 120
    },
    {
      "op": "host",
      "command": "cp \".vm/e2e/{{state}}-{{stateHashShort}}/serial.log\" \".vm/e2e/{{state}}-{{stateHashShort}}/boot-0.log\" && printf saved",
      "expect": "saved",
      "timeout": 60
    },
    {
      "op": "host",
      "command": "./build/boot-evidence health '.vm/e2e/{{state}}-{{stateHashShort}}/boot-0.log' 0 {{secureBoot}} false",
      "expect": "host-healthy",
      "timeout": 120
    },
    {
      "op": "qmp",
      "command": "{\"execute\":\"screendump\",\"arguments\":{\"filename\":\".vm/e2e/{{state}}-{{stateHashShort}}/panel-0-session.ppm\"}}",
      "timeout": 60
    },
    {
      "op": "host",
      "command": "./build/boot-evidence panel '.vm/e2e/{{state}}-{{stateHashShort}}/panel-0-session.ppm' console-silent",
      "expect": "panel-graphical",
      "timeout": 120
    },
    {
      "op": "host",
      "command": "if [ \"{{enablesSecureBoot}}\" != \"true\" ]; then printf enable-done; else timeout 1800 bash -c 'until grep -qa \"E2E-SECURE-BOOT-ENABLE sign=0 enroll=0\" \".vm/e2e/{{state}}-{{stateHashShort}}/serial.log\"; do sleep 10; done' || { echo 'secure boot enable did not succeed'; grep -a 'E2E-SB-LOG\\|E2E-SECURE-BOOT-ENABLE' \".vm/e2e/{{state}}-{{stateHashShort}}/serial.log\" | tail -16; exit 1; }; printf enable-done; fi",
      "expect": "enable-done",
      "timeout": 1900
    },
    {
      "op": "stop"
    },
    {
      "op": "boot-disk"
    },
    {
      "op": "sleep",
      "timeout": 50
    },
    {
      "op": "qmp",
      "command": "{\"execute\":\"screendump\",\"arguments\":{\"filename\":\".vm/e2e/{{state}}-{{stateHashShort}}/panel-1.ppm\"}}",
      "timeout": 60
    },
    {
      "op": "host",
      "command": "./build/boot-evidence panel '.vm/e2e/{{state}}-{{stateHashShort}}/panel-1.ppm' {{unlockAgent}}",
      "expect": "panel-graphical",
      "timeout": 120
    },
    {
      "op": "qmp",
      "command": "{\"execute\":\"send-key\",\"arguments\":{\"keys\":[{\"type\":\"qcode\",\"data\":\"a\"}],\"hold-time\":100}}",
      "timeout": 60
    },
    {
      "op": "sleep",
      "timeout": 5
    },
    {
      "op": "qmp",
      "command": "{\"execute\":\"screendump\",\"arguments\":{\"filename\":\".vm/e2e/{{state}}-{{stateHashShort}}/panel-1-typed.ppm\"}}",
      "timeout": 60
    },
    {
      "op": "host",
      "command": "./build/boot-evidence responds '.vm/e2e/{{state}}-{{stateHashShort}}/panel-1.ppm' '.vm/e2e/{{state}}-{{stateHashShort}}/panel-1-typed.ppm' '{{unlockAgent}}'",
      "expect": "panel-responds",
      "timeout": 120
    },
    {
      "op": "qmp",
      "command": "{\"execute\":\"send-key\",\"arguments\":{\"keys\":[{\"type\":\"qcode\",\"data\":\"backspace\"}],\"hold-time\":100}}",
      "timeout": 60
    },
    {
      "op": "sleep",
      "timeout": 3
    },
    {
      "op": "host",
      "command": "bash tests/hosts-boot/unlock_and_wait.sh '.vm/e2e/{{state}}-{{stateHashShort}}' '{{password}}' 900 && printf boot1-reported",
      "expect": "boot1-reported",
      "timeout": 1000
    },
    {
      "op": "qmp",
      "command": "{\"execute\":\"screendump\",\"arguments\":{\"filename\":\".vm/e2e/{{state}}-{{stateHashShort}}/panel-1-unlocked.ppm\"}}",
      "timeout": 60
    },
    {
      "op": "host",
      "command": "./build/boot-evidence panel '.vm/e2e/{{state}}-{{stateHashShort}}/panel-1-unlocked.ppm' console-silent",
      "expect": "panel-graphical",
      "timeout": 120
    },
    {
      "op": "host",
      "command": "cp \".vm/e2e/{{state}}-{{stateHashShort}}/serial.log\" \".vm/e2e/{{state}}-{{stateHashShort}}/boot-1.log\" && printf saved",
      "expect": "saved",
      "timeout": 60
    },
    {
      "op": "host",
      "command": "./build/boot-evidence health '.vm/e2e/{{state}}-{{stateHashShort}}/boot-1.log' 0 {{secureBoot}} {{requireEnforced}}",
      "expect": "host-healthy",
      "timeout": 120
    },
    {
      "op": "qmp",
      "command": "{\"execute\":\"screendump\",\"arguments\":{\"filename\":\".vm/e2e/{{state}}-{{stateHashShort}}/panel-1-session.ppm\"}}",
      "timeout": 60
    },
    {
      "op": "host",
      "command": "./build/boot-evidence panel '.vm/e2e/{{state}}-{{stateHashShort}}/panel-1-session.ppm' console-silent",
      "expect": "panel-graphical",
      "timeout": 120
    },
    {
      "op": "host",
      "command": "for b in 0 1; do grep -aE '^E2E-(STATE|FAILED|REFUSED|HOMEMANAGER|SNAPSHOTS|SWAP|UNLOCKAGENT)' \".vm/e2e/{{state}}-{{stateHashShort}}/boot-$b.log\" | sed -E 's/^(E2E-UNLOCKAGENT [a-z0-9]+).*/\\\\1/' | sort > \".vm/e2e/{{state}}-{{stateHashShort}}/norm-$b.txt\"; done; diff \".vm/e2e/{{state}}-{{stateHashShort}}/norm-0.txt\" \".vm/e2e/{{state}}-{{stateHashShort}}/norm-1.txt\" > /dev/null && printf boots-identical || { echo 'boots differ'; diff \".vm/e2e/{{state}}-{{stateHashShort}}/norm-0.txt\" \".vm/e2e/{{state}}-{{stateHashShort}}/norm-1.txt\"; exit 1; }",
      "expect": "boots-identical",
      "timeout": 120
    },
    {
      "op": "stop"
    },
    {
      "op": "host",
      "command": "if [ \"{{reenrollsKeys}}\" != \"true\" ]; then printf flash-cleared-skipped; else pristine=\"$(readlink -f .vm/e2e/{{state}}-{{stateHashShort}}/firmware-data)/edk2-i386-vars.fd\"; cp \"$pristine\" .vm/e2e/{{state}}-{{stateHashShort}}/edk2-vars.fd && printf flash-cleared; fi",
      "expect": "flash-cleared",
      "timeout": 120
    },
    {
      "op": "boot-disk"
    },
    {
      "op": "sleep",
      "timeout": 50
    },
    {
      "op": "host",
      "command": "if [ \"{{reenrollsKeys}}\" != \"true\" ]; then printf reenroll-skipped; else bash tests/hosts-boot/unlock_and_wait.sh '.vm/e2e/{{state}}-{{stateHashShort}}' '{{password}}' 900 && cp \".vm/e2e/{{state}}-{{stateHashShort}}/serial.log\" \".vm/e2e/{{state}}-{{stateHashShort}}/boot-2.log\" && printf reenroll-done; fi",
      "expect": "reenroll",
      "timeout": 960
    },
    {
      "op": "host",
      "command": "if [ \"{{reenrollsKeys}}\" != \"true\" ]; then printf enroll-skipped; else ./build/boot-evidence health '.vm/e2e/{{state}}-{{stateHashShort}}/boot-2.log' 2 true true; fi",
      "expect": "enroll",
      "timeout": 300
    },
    {
      "op": "stop"
    }
  ],
  "parentState": "host-installed-{{hostName}}-{{target}}"
}
